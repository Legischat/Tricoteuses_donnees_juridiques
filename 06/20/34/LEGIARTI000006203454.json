        {
          "#text": "Arrêté du 15 septembre 1972 REGLEMENTATION DES AGENCES MOBILIERES ET IMMOBILIERES, REPERTOIRE DES AGENTS",
          "@c_titre_court": "Arrêté du 15 septembre 1972",
          "@debut": "2999-01-01",

    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Arrêté du 21 août 1970 FIXANT LES MODALITES D'APPLICATION DES DISPOSITIONS LEGISLATIVES ET REGLEMENTAIRES RELATIVES A L'EXERCICE DES ACTIVITES AMBULANTES ET AU REGIME APPLICABLE AUX PERSONNES CIRCULANT EN FRANCE SANS DOMICILE NI RESIDENCE FIXE",
          "@c_titre_court": "Arrêté du 21 août 1970",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000279864"
        },
        {
          "#text": "Arrêté du 21 août 1970 relatif aux modalités d'application des dispositions législatives et réglementaires relatives à l'exercice des activités ambulantes et au régime applicable aux personnes circulant en France sans domicile ni résidence fixe",
          "@c_titre_court": "Arrêté du 21 août 1970",
          "@debut": "1970-10-02",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000005625868"
        }
      ],

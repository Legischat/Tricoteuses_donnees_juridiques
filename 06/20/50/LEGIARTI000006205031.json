        {
          "#text": "Décret n°79-923 du 16 octobre 1979 INSTITUANT UN CAHIER DES CLAUSES TECHNIQUES GENERALES APPLICABLES AUX MARCHES PUBLICS DE TRAVAUX ET APPROUVANT OU MODIFIANT DIVERS FASCICULES",
          "@c_titre_court": "Décret n°79-923 du 16 octobre 1979",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000335359"
        },
        {
          "#text": "Décret n°79-923 du 16 octobre 1979 instituant un cahier des clauses techniques générales applicables aux marchés publics de travaux et approuvant ou modifiant divers fascicules",
          "@c_titre_court": "Décret n°79-923 du 16 octobre 1979",

          }
        ],
        "TM": {
          "TITRE_TM": [
            {
              "#text": "Fascicules interministériels du cahier des prescriptions communes applicables aux marchés de travaux publics passés au nom de l'Etat, tels qu'ils ont été modifiés par le décret n° 76-1069 du 5 novembre 1976, maintenus en vigueur en vertu de l'article 33 du décret n° 76-88 du 21 janvier 1976",
              "@debut": "1980-04-01",
              "@fin": "1982-09-01",
              "@id": "LEGISCTA000006113616"
            }
          ],

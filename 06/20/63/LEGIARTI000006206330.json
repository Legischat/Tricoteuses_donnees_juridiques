  "NOTA": {
    "CONTENU": "Loi 92-125 1992-02-06 art. 3 : la référence à \" services extérieurs \" est remplacée par \" services déconcentrés \". <br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Sont désignés en qualité de représentants du secrétariat d'Etat chargé de la jeunesse et des sports, au comité consultatif auprès du Premier ministre de règlement amiable des litiges nés à l'occasion des marchés publics :<br/>\n<br/>   - le directeur de l'administration et des services déconcentrés ou son représentant ;<br/>\n<br/>   - le chef de la mission technique de l'équipement ou son représentant.<br/>"
  },

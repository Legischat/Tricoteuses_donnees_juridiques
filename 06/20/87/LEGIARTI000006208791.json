  "NOTA": {
    "CONTENU": "<br/>  L'article 13 de la loi n° 2003-516 a reporté au 1er janvier 2005 la date initiale du 1er septembre 2003, prévue par l'article 25 de la loi n° 2002-304.<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les articles 57, 60 à 61-4, 329, 331, 331-2, 332-1, 334-2, 354, 361 et 363 du code civil sont applicables à Mayotte.<br/>\n<br/>"
  },

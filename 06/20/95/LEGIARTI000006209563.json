  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   La direction des Archives de France comprend :<br/>\n<br/>   - l'inspection générale des Archives de France ;<br/>\n<br/>   - la délégation aux célébrations nationales ;<br/>\n<br/>   - le département du réseau institutionnel et professionnel ;<br/>\n<br/>   - le département de la politique archivistique et de la coordination interministérielle ;<br/>\n<br/>   - le département de l'innovation technologique et de la normalisation ;<br/>\n<br/>   - le département des publics ;<br/>\n<br/>   - le bureau des affaires générales et de la documentation.<br/>\n<br/>   Le directeur des Archives de France est assisté d'un adjoint.<br/>"
  }

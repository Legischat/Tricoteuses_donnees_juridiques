  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   La sous-direction de la modernisation de la gestion des carrières comprend :<br/>\n<br/>   - le bureau des personnels administratifs et des agents non titulaires ;<br/>\n<br/>   - le bureau des personnels de conservation, de documentation, de recherche et d'enseignement ;<br/>\n<br/>   - le bureau des personnels d'accueil, de surveillance et de magasinage ;<br/>\n<br/>   - le bureau des personnels ouvriers et techniciens ;<br/>\n<br/>   - le bureau des traitements ;<br/>\n<br/>   - le bureau des pensions.<br/>"
  }

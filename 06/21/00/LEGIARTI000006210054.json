  "NOTA": {
    "CONTENU": "<br/>   NOTA : L'article 8 de la loi 84-610 du 16 juillet 1984 a été abrogé et codifié aux articles L. 111-1, L. 121-4 et L. 321-9 du code du sport.<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les groupements sportifs mentionnés aux articles L. 121-1 et L. 121-2 du code du sport sont agréés par le préfet du département de leur siège.<br/>\n<br/>"
  },

  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Il est créé au ministère de la culture :<br/>\n<br/>   1. Une commission d'appel d'offres et d'ouverture des plis pour l'ensemble des marchés publics passés au nom de l'Etat par les directions et services centraux ;<br/>\n<br/>   2. Une commission d'ouverture des plis et d'appels d'offres pour les marchés publics passés par le service national des travaux.<br/>"
  }

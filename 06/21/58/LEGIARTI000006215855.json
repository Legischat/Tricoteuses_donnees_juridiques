  "NOTA": {
    "CONTENU": "<br/>  Le décret n° 96-238 du 19 mars 1996 a été abrogé par le décret n° 2003-851 du 1er septembre 2003, article 4.<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les poirés de l'appellation d'origine contrôlée \"Domfront\" ne peuvent être mis en circulation sans un certificat d'agrément délivré par l'Institut national de l'origine et de la qualité dans les conditions prévues par le décret du 19 mars 1996 susvisé.<br/>\n<br/>"
  },

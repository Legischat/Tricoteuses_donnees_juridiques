  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   La direction de l'administration pénitentiaire comprend :<br/>\n<br/>   - le département de l'état-major de sécurité ;<br/>\n<br/>   - la sous-direction des personnes placées sous main de justice ;<br/>\n<br/>   - la sous-direction de l'organisation et du fonctionnement des services déconcentrés ;<br/>\n<br/>   - la sous-direction des ressources humaines et des relations sociales ;<br/>\n<br/>   - le service de la communication et des relations internationales ;<br/>\n<br/>   - l'inspection des services pénitentiaires.<br/>"
  }

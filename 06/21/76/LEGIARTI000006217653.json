  "NOTA": {
    "CONTENU": "<p>Conformément aux dispositions de l'article 8 de l'arrêté du 31 décembre 2019, ces dispositions sont abrogées pour les demandes ou déclarations présentées à compter du 1er avril 2020.</p>"
  },
  "BLOC_TEXTUEL": {

  "NOTA": {
    "CONTENU": "<br/>   Lire <<décret n° 95-29 du 10 janvier 1995>> en attente d'un rectificatif au journal officiel.<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les deux examens professionnels d'accès par voie de promotion interne au cadre d'emplois des techniciens supérieurs territoriaux, prévus par l'article 5 du décret du 10 janvier 1995 susvisé, sont organisés conformément aux articles 2 à 8 du présent arrêté.<br/>\n<br/>"
  },

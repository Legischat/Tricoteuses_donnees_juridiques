  "BLOC_TEXTUEL": {
    "CONTENU": "<p>L'échelonnement indiciaire du corps des greffiers des services judiciaires est fixé comme suit :</p>\n<table>\n<tbody>\n<tr>\n<td>-</td>\n<td>\n<p align=\"center\">INDICES BRUTS</p>\n</td>\n</tr>\n<tr>\n<td>\n<p align=\"center\">Greffier du premier grade</p>\n</td>\n<td>\n<pre> </pre>\n</td>\n</tr>\n<tr>\n<td>\n<p>7e échelon</p>\n</td>\n<td>\n<p align=\"center\">638</p>\n</td>\n</tr>\n<tr>\n<td>\n<p>6e échelon</p>\n</td>\n<td>\n<p align=\"center\">595</p>\n</td>\n</tr>\n<tr>\n<td>\n<p>5e échelon</p>\n</td>\n<td>\n<p align=\"center\">557</p>\n</td>\n</tr>\n<tr>\n<td>\n<p>4e échelon</p>\n</td>\n<td>\n<p align=\"center\">531</p>\n</td>\n</tr>\n<tr>\n<td>\n<p>3e échelon</p>\n</td>\n<td>\n<p align=\"center\">501</p>\n</td>\n</tr>\n<tr>\n<td>\n<p>2e échelon</p>\n</td>\n<td>\n<p align=\"center\">487</p>\n</td>\n</tr>\n<tr>\n<td>\n<p>1er échelon</p>\n</td>\n<td>\n<p align=\"center\">471</p>\n</td>\n</tr>\n<tr>\n<td>\n<p align=\"center\">Greffier du deuxième grade</p>\n</td>\n<td>\n<pre> </pre>\n</td>\n</tr>\n<tr>\n<td>\n<p>13e échelon</p>\n</td>\n<td>\n<p align=\"center\">593</p>\n</td>\n</tr>\n<tr>\n<td>\n<p>12e échelon</p>\n</td>\n<td>\n<p align=\"center\">570</p>\n</td>\n</tr>\n<tr>\n<td>\n<p>11e échelon</p>\n</td>\n<td>\n<p align=\"center\">541</p>\n</td>\n</tr>\n<tr>\n<td>\n<p>10e échelon</p>\n</td>\n<td>\n<p align=\"center\">512</p>\n</td>\n</tr>\n<tr>\n<td>\n<p>9e échelon</p>\n</td>\n<td>\n<p align=\"center\">493</p>\n</td>\n</tr>\n<tr>\n<td>\n<p>8e échelon</p>\n</td>\n<td>\n<p align=\"center\">469</p>\n</td>\n</tr>\n<tr>\n<td>\n<p>7e échelon</p>\n</td>\n<td>\n<p align=\"center\">449</p>\n</td>\n</tr>\n<tr>\n<td>\n<p>6e échelon</p>\n</td>\n<td>\n<p align=\"center\">422</p>\n</td>\n</tr>\n<tr>\n<td>\n<p>5e échelon</p>\n</td>\n<td>\n<p align=\"center\">404</p>\n</td>\n</tr>\n<tr>\n<td>\n<p>4e échelon</p>\n</td>\n<td>\n<p align=\"center\">381</p>\n</td>\n</tr>\n<tr>\n<td>\n<p>3e échelon</p>\n</td>\n<td>\n<p align=\"center\">362</p>\n</td>\n</tr>\n<tr>
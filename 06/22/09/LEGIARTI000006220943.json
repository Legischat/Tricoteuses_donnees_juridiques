  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   La direction centrale de l'infrastructure de l'air comprend, outre la cellule de pilotage des affaires d'infrastructure :<br/>\n<br/>   1. La sous-direction prospective et logistique ;<br/>\n<br/>   2. La sous-direction opérationnelle et technique ;<br/>\n<br/>   3. La sous-direction administrative et financière ;<br/>\n<br/>   4. La sous-direction du génie de l'air et de l'infrastructure en opération ;<br/>\n<br/>   5. Le bureau informatique ;<br/>\n<br/>   6. Le bureau soutien.<br/>"
  }

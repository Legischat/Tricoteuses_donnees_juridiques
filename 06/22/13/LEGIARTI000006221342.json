  "BLOC_TEXTUEL": {
    "CONTENU": "<p>L'échelonnement indiciaire applicable au cadre d'emplois des cadres territoriaux de santé infirmiers, rééducateurs et assistants médico-techniques est fixé ainsi qu'il suit :</p>\n<table align=\"center\" border=\"1\" cellpadding=\"0\" cellspacing=\"0\" width=\"378\">\n<tbody>\n<tr>\n<td width=\"307\">\n<p align=\"center\">ECHELONS</p>\n</td>\n<td width=\"307\">\n<p align=\"center\">INDICES BRUTS</p>\n</td>\n</tr>\n<tr>\n<td width=\"307\">\n<p>Cadre de santé : </p>\n</td>\n<td width=\"307\">\n<p align=\"center\"> </p>\n</td>\n</tr>\n<tr>\n<td width=\"307\">\n<p>8e échelon</p>\n</td>\n<td width=\"307\">\n<p align=\"center\">740</p>\n</td>\n</tr>\n<tr>\n<td width=\"307\">\n<p>7e échelon</p>\n</td>\n<td width=\"307\">\n<p align=\"center\">664</p>\n</td>\n</tr>\n<tr>\n<td width=\"307\">\n<p>6e échelon</p>\n</td>\n<td width=\"307\">\n<p align=\"center\">627</p>\n</td>\n</tr>\n<tr>\n<td width=\"307\">\n<p>5e échelon</p>\n</td>\n<td width=\"307\">\n<p align=\"center\">589</p>\n</td>\n</tr>\n<tr>\n<td width=\"307\">\n<p>4e échelon</p>\n</td>\n<td width=\"307\">\n<p align=\"center\">558</p>\n</td>\n</tr>\n<tr>\n<td width=\"307\">\n<p>3e échelon</p>\n</td>\n<td width=\"307\">\n<p align=\"center\">520</p>\n</td>\n</tr>\n<tr>\n<td width=\"307\">\n<p>2e échelon</p>\n</td>\n<td width=\"307\">\n<p align=\"center\">480</p>\n</td>\n</tr>\n<tr>\n<td width=\"307\">\n<p>1er échelon</p>\n</td>\n<td width=\"307\">\n<p align=\"center\">430</p>\n</td>\n</tr>\n</tbody>\n</table>"
  }
}
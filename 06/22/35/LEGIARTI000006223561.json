  "BLOC_TEXTUEL": {
    "CONTENU": "<p>Les contrôleurs du travail sont reclassés dans le nouveau corps conformément au tableau de correspondance ci-après :</p>\n<br/>\n<table>\n<tbody>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">SITUATION <br/>\n<br/>ancienne</p>\n</td>\n<td align=\"left\" colspan=\"2\" valign=\"middle\">\n<p align=\"center\">SITUATION NOUVELLE</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">Grades et échelons</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">Grades et échelons</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">Ancienneté conservée dans la limite de la durée d'échelon</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">\n<i>Contrôleurs du travail de classe <br/>\n<br/>exceptionnelle</i>\n</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">\n<i>Contrôleurs du travail de classe <br/>\n<br/>exceptionnelle</i>\n</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<pre> </pre>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">7e </p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">5e </p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">Ancienneté acquise</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">6e </p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">4e </p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">5/8 de l'ancienneté acquise</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">5e </p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">3e </p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">5/6 de l'ancienneté acquise</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">4e </p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">2e </p>\n</t
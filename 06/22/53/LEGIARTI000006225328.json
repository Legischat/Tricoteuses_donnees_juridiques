  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   La sous-direction des affaires financières comprend :<br/>\n<br/>   - le bureau des programmes du secrétariat général pour l'administration ;<br/>\n<br/>   - le bureau de la gestion des crédits du service auquel est rattachée la régie d'avances et de recettes de l'administration centrale ;<br/>\n<br/>   - le bureau de la comptabilité des ressources ;<br/>\n<br/>   - le bureau de l'analyse de la gestion.<br/>"
  },

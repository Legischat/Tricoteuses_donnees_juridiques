  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   La sous-direction des systèmes d'information d'administration et de gestion comprend :<br/>\n<br/>   - le bureau de la réglementation et du budget informatique ;<br/>\n<br/>   - le bureau de conception et de réalisation des systèmes d'information ;<br/>\n<br/>   - le bureau de l'ingénierie des systèmes d'information et de communication ;<br/>\n<br/>   - le bureau de la formation et du management informatique ;<br/>\n<br/>   - le bureau de la qualité, de la sécurité et des méthodes ;<br/>\n<br/>   - l'observatoire de l'informatique d'administration et de gestion.<br/>"
  },

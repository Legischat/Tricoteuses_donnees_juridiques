  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Pour l'exercice de ses attributions, la sous-direction \"plans et études\" comprend :<br/>\n<br/>   - le bureau \"évolution des réseaux\" ;<br/>\n<br/>   - le bureau \"évolution des systèmes d'information\" ;<br/>\n<br/>   - le bureau \"organisation et ressources humaines\" ;<br/>\n<br/>   - le bureau \"fréquences\" ;<br/>\n<br/>   - le bureau \"outre-mer\".<br/>"
  },

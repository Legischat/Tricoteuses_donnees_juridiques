  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Le secrétaire général dirige les activités des directions et services suivants :<br/>\n<br/>   1. La direction de la modernisation et de l'action territoriale ;<br/>\n<br/>   2. La direction des ressources humaines ;<br/>\n<br/>   3. La direction de l'évaluation de la performance, et des affaires financières et immobilières ;<br/>\n<br/>   4. La direction des systèmes d'information et de communication ;<br/>\n<br/>   5. Le centre d'études et de prospective ;<br/>\n<br/>   6. Le service de la communication.<br/>"
  }

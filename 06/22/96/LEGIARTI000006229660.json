  "NOTA": {
    "CONTENU": "<br/>  Décret n° 2005-1611 du 20 décembre 2005, art. 37 : <br/>Spécificités d'application.<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Le comité directeur est présidé alternativement par le président du gouvernement de la Polynésie française ou son représentant et par le président du gouvernement de la Nouvelle-Calédonie ou son représentant.<br/>\n<br/>   La durée du mandat du président est de deux ans à compter du 1er janvier.<br/>"
  },

  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   L'état-major de la direction centrale de la police aux frontières comprend :<br/>\n<br/>   - le centre d'information et de commandement ;<br/>\n<br/>   - l'unité des liaisons opérationnelles ;<br/>\n<br/>   - l'unité de recueil et de l'exploitation de l'information ;<br/>\n<br/>   - l'unité de la documentation générale, des archives et du courrier ;<br/>\n<br/>   - le fichier national transfrontière.<br/>"
  },

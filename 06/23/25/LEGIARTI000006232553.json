  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>L'appellation \" musée de France \" est attribuée aux musées ci-après : <br/>\n<br/>Musée d'art moderne de la ville de Paris ; <br/>\n<br/>Maison de Balzac ; <br/>\n<br/>Musée Bourdelle ; <br/>\n<br/>Musée Carnavalet-histoire de Paris ; <br/>\n<br/>Musée Cernuschi, musée des arts de l'Asie de la ville de Paris ; <br/>\n<br/>Musée Cognacq-Jay, musée du XVIIIe siècle de la ville de Paris ; <br/>\n<br/>Musée Galliera, musée de la mode de la ville de Paris ; <br/>\n<br/>Mémorial du maréchal Leclerc de Hauteclocque et de la Libération de Paris-musée Jean Moulin ; <br/>\n<br/>Petit Palais, musée des beaux-arts de la ville de Paris ; <br/>\n<br/>Maison de Victor Hugo ; <br/>\n<br/>Musée de la vie romantique ; <br/>\n<br/>Musée Zadkine.<br/>"
  },

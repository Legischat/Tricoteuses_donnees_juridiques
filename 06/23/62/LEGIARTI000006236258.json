  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les territoires des secteurs sanitaires prévus à l'article L. 5511-6 du code de la santé publique correspondent à ceux des communes suivantes :<br/>\n<br/>    1° Dzaoudzi ;<br/>\n<br/>    2° Pamandzi ;<br/>\n<br/>    3° Dembeni et Bandrele ;<br/>\n<br/>    4° Kani-Keli ;<br/>\n<br/>    5° Chirongui et Boueni ;<br/>\n<br/>    6° Sada et Chiconi ;<br/>\n<br/>    7° Ouangani ;<br/>\n<br/>    8° Tsingoni ;<br/>\n<br/>    9° Mtsangamouji et Bandraboua ;<br/>\n<br/>   10° Acoua ;<br/>\n<br/>   11° Mtzamboro.<br/>"
  },

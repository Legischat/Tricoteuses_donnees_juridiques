  "BLOC_TEXTUEL": {
    "CONTENU": "<p>L'échelonnement indiciaire applicable au cadre d'emplois des ouvriers territoriaux de Mayotte est fixé ainsi qu'il suit :</p>\n<br/>\n<table>\n<tbody>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">\n<strong>ÉCHELONS</strong>\n</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">\n<strong>INDICES BRUTS</strong>\n</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">Ouvrier territorial qualifié de Mayotte</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<pre> </pre>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">5<sup>ème</sup> échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">250</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">4<sup>ème</sup> échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">222</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">3<sup>ème</sup> échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">190</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">2<sup>ème</sup> échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">169</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">1<sup>er</sup> échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">128</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">Ouvrier territorial de Mayotte</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<pre> </pre>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">8<sup>ème</sup> échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">237</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">7<sup>ème</sup> échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">209</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">6<sup>ème</sup> échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">178</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">5<sup>ème</sup> échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">149</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">4<sup>ème</sup> échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">127</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">3<sup>ème</sup> échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">117</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">2<sup>ème</sup> échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">108</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">1<sup>er</sup> échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">100</p>\n</td>\n</tr>\n</tbody>\n</table>"

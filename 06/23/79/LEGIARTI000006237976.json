  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   La fermeture de la chasse aux oiseaux de passage et au gibier d'eau est fixée comme suit :<br/>\n<br/>   ESPECES :<br/>\n<br/>   Caille des prés.<br/>\n<br/>   Bécasse des bois.<br/>\n<br/>   Tourterelle turque.<br/>\n<br/>   Tourterelle des bois.<br/>\n<br/>   DATE DE FERMETURE : 20 février.<br/>\n<br/>   ESPECES :<br/>\n<br/>   Pigeon biset.<br/>\n<br/>   Pigeon colombin.<br/>\n<br/>   Pigeon ramier.<br/>\n<br/>   Merle noir.<br/>\n<br/>   Grive litorne.<br/>\n<br/>   Grive musicienne.<br/>\n<br/>   Grive mauvis.<br/>\n<br/>   Grive draine.<br/>\n<br/>   DATE DE FERMETURE : 10 février.    AUTRES ESPECES :<br/>\n<br/>   DATE DE FERMETURE : 31 janvier.<br/>"
  }

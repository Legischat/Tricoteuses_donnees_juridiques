  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   La sous-direction du contrôle de gestion comprend :<br/>\n<br/>   1. Le bureau du pilotage et de l'orientation ;<br/>\n<br/>   2. Le bureau des méthodes de contrôle de gestion ;<br/>\n<br/>   3. Le bureau du contrôle de gestion des organismes fonctionnels ;<br/>\n<br/>   4. Le bureau de la comptabilité et de l'analyse des coûts ;<br/>\n<br/>   5. Le bureau des audits et des synthèses.<br/>"
  },

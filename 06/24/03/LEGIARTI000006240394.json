  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>La formation de jugement est présidée par le président du tribunal de commerce ou par un juge de ce tribunal ayant exercé des fonctions judiciaires pendant au moins trois ans, sous réserve de l'application des dispositions de l'article L. 722-15.\n<br/>\n<br/>"
  },

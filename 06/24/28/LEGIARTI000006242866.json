  "BLOC_TEXTUEL": {
    "CONTENU": "<p>   Le taux d'augmentation du coefficient de majoration prévu à l'article 1er est fixé ainsi qu'il suit :</p>\n<br/>\n<br/>\n<br/>\n<table>\n<tbody>\n<tr>\n<td align=\"center\">\n<p>ANNEE DE DEPART AU TITRE</p>\n<p> des travaux insalubres</p>\n</td>\n<td align=\"center\">\n<p> AUGMENTATION DU COEFFICIENT</p>\n<p> de majoration</p>\n</td>\n</tr>\n<tr>\n<td align=\"center\"> 2009</td>\n<td align=\"center\"> 1 point</td>\n</tr>\n<tr>\n<td align=\"center\">2010 <br/>\n</td>\n<td align=\"center\"> 1 point</td>\n</tr>\n<tr>\n<td align=\"center\">       2011</td>\n<td align=\"center\">     2 points <br/>\n</td>\n</tr>\n<tr>\n<td align=\"center\">       2012</td>\n<td align=\"center\">     2 points <br/>\n</td>\n</tr>\n<tr>\n<td align=\"center\"> 2013</td>\n<td align=\"center\"> 3 points</td>\n</tr>\n<tr>\n<td align=\"center\"> 2014</td>\n<td align=\"center\">     3 points <br/>\n</td>\n</tr>\n<tr>\n<td align=\"center\">       2015</td>\n<td align=\"center\"> 4 points</td>\n</tr>\n<tr>\n<td align=\"center\">2016 et suivantes <br/>\n</td>\n<td align=\"center\"> 5 points</td>\n</tr>\n</tbody>\n</table>\n<br/>"
  },

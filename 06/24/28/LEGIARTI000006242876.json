  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Ne sont pas applicables à Saint-Pierre-et-Miquelon les articles :<br/>\n<br/>   1° L. 125-3, L. 126-1 ;<br/>\n<br/>   2° L. 225-245-1, L. 229-1 à L. 229-15, L. 238-6, L. 244-5 et L. 252-1 à L. 252-13 ;<br/>\n<br/>   3° L. 470-6 ;<br/>\n<br/>   4° L. 522-1 à L. 522-40 et L. 524-20 ;<br/>\n<br/>   5° L. 711-5, L. 711-9, L. 713-6 à L. 713-10, L. 713-11 à L. 713-17 en tant qu'ils concernent les délégués consulaires ; L. 720-1 à L. 730-17.<br/>"
  },

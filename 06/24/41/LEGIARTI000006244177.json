    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret n° 2005-1012 du 22 août 2005 abrogeant les dispositions relatives à l'utilisation des listes complémentaires d'admission pour le recrutement par concours des ingénieurs et des personnels techniques et d'administration de la recherche des établissements publics scientifiques et technologiques",
          "@c_titre_court": "Décret n°2005-1012 du 22 août 2005",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000631623"
        },
        {
          "#text": "Décret n°2005-1012 du 22 août 2005 abrogeant les dispositions relatives à l'utilisation des listes complémentaires d'admission pour le recrutement par concours des ingénieurs et des personnels techniques et d'administration de la recherche des établissements publics scientifiques et technologiques.",

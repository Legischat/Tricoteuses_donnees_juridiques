  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   La sous-direction de la justice pénale générale comprend cinq bureaux :<br/>\n<br/>   - le bureau de la législation pénale générale ;<br/>\n<br/>   - le bureau des politiques pénales générales et de la protection des libertés individuelles ;<br/>\n<br/>   - le bureau de la police judiciaire ;<br/>\n<br/>   - le bureau de la prévention et des politiques partenariales ;<br/>\n<br/>   - le bureau de l'exécution des peines et des grâces.<br/>"
  },

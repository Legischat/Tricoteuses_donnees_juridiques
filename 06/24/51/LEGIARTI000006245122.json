  "BLOC_TEXTUEL": {
    "CONTENU": "<p>Le programme national de prévention, d'éducation et d'information sanitaires des professions agricoles pour 2005 est financé dans la limite des dotations réparties comme suit :</p>\n<table>\n<tbody>\n<tr>\n<td rowspan=\"2\" width=\"302\">\n<p align=\"center\">ACTIONS</p>\n</td>\n<td colspan=\"2\" width=\"227\">\n<p align=\"center\">VENTILATION PAR RÉGIME<br/>de protection sociale intéressé</p>\n</td>\n<td rowspan=\"2\" width=\"151\">\n<p align=\"center\">TOTAL<br/>(en euros)</p>\n</td>\n</tr>\n<tr>\n<td width=\"113\">\n<p align=\"center\">Salariés (en euros)</p>\n</td>\n<td width=\"113\">\n<p align=\"center\">Non-salariés (en euros)</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"302\">\n<p>Examens de santé et actions de suite</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p align=\"center\">6 096 000</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p align=\"center\">7 450 000</p>\n</td>\n<td valign=\"top\" width=\"151\">\n<p align=\"center\">13 546 000</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"302\">\n<p>Dépistage des cancers</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p align=\"center\">1 310 000</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p align=\"center\">2 740 000</p>\n</td>\n<td valign=\"top\" width=\"151\">\n<p align=\"center\">4 050 000</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"302\">\n<p>Vaccinations</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p align=\"center\">626 000</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p align=\"center\">1 874 000</p>\n</td>\n<td valign=\"top\" width=\"151\">\n<p align=\"center\">2 500 000</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"302\">\n<p>Actions particulières d'origine légale ou conventionnelle</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p align=\"center\">738 300</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p align=\"center\">771 700</p>\n</td>\n<td valign=\"top\" width=\"151\">\n<p align=\"center\">1 510 000</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"302\">\n<p>Actions thématiques</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p align=\"center\">1 074 530</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p align=\"center\">954 920</p>\n</td>\n<td valign=\"top\" width=\"151\">\n<p align=\"center\">2 029 450</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"302\">\n<p>Actions d'accompagnement</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p align=\"center\">368 550</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p align=\"center\">368 550</p>\n</td>\n<td valign=\"top\" width=\"151\">\n<p align=\"center\">737 100</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"302\">\n<p>Total</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p align=\"center\">10 213 380</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p align=\"center\">14 159 170</p>\n</td>\n<td valign=\"top\" width=\"151\">\n<p align=\"center\">24 372 550</p>\n</td>\n</tr>\n</tbody>\n</table>"
  }

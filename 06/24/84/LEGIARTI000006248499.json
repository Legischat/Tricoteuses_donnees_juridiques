  "BLOC_TEXTUEL": {
    "CONTENU": "<p align=\"left\">Les montants de base annuels de la prime spéciale et de résultats prévue aux articles 3 et suivants du décret du 30 décembre 2005 susvisé sont fixés comme suit :</p>\n<br/>\n<p align=\"left\"> </p>\n<table>\n<tbody>\n<tr>\n<td width=\"449\">\n<p align=\"center\">GRADE OU CLASSEMENT DU POSTE</p>\n</td>\n<td width=\"225\">\n<p align=\"center\">MONTANT<br/>(en €)</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"449\">\n<p align=\"left\">A6</p>\n</td>\n<td valign=\"top\" width=\"225\">\n<p align=\"center\">34 777</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"449\">\n<p align=\"left\">A5 bis</p>\n</td>\n<td valign=\"top\" width=\"225\">\n<p align=\"center\">34 777</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"449\">\n<p>A5</p>\n</td>\n<td valign=\"top\" width=\"225\">\n<p align=\"center\">31 750</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"449\">\n<p align=\"left\">A4 bis</p>\n</td>\n<td valign=\"top\" width=\"225\">\n<p align=\"center\">22 418</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"449\">\n<p>A4</p>\n</td>\n<td valign=\"top\" width=\"225\">\n<p align=\"center\">20 864</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"449\">\n<p align=\"left\">A3</p>\n</td>\n<td valign=\"top\" width=\"225\">\n<p align=\"center\">17 777</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"449\">\n<p>A2</p>\n</td>\n<td valign=\"top\" width=\"225\">\n<p align=\"center\">14 754</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"449\">\n<p align=\"left\">A1 bis</p>\n</td>\n<td valign=\"top\" width=\"225\">\n<p align=\"center\">11 835</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"449\">\n<p>A1</p>\n</td>\n<td valign=\"top\" width=\"225\">\n<p align=\"center\">10 200</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"449\">\n<p align=\"left\">A0</p>\n</td>\n<td valign=\"top\" width=\"225\">\n<p align=\"center\">10 200</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"449\">\n<p align=\"left\">B4</p>\n</td>\n<td valign=\"top\" width=\"225\">\n<p align=\"center\">7 313</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"449\">\n<p>B3</p>\n</td>\n<td valign=\"top\" width=\"225\">\n<p align=\"center\">7 313</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"449\">\n<p align=\"left\">Technicien opérationnel (tous grades)</p>\n</td>\n<td valign=\"top\" width=\"225\">\n<p align=\"center\">5 065</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"449\">\n<p>Chef de district forestier principal</p>\n</td>\n<td valign=\"top\" width=\"225\">\n<p align=\"center\">3 563</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"449\">\n<p align=\"left\">Chef de district forestier</p>\n</td>\n<td valign=\"top\" width=\"225\">\n<p align=\"center\">3 608</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"449\">\n<p align=\"left\">Agent technique forestier principal</p>\n</td>\n<td valign=\"top\" width=\"225\">\n<p align=\"center\">3 708</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"449\">\n<p align=\"left\">Agent technique forestier</p>\n</td>\n<td valign=\"top\" width=\"225\">\n<p align=\"center\">3 715</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"449\">\n<p>Secrétaire administratif classe exceptionnelle</p>\n</td>\n<td valign=\"top\" width=\"225\">\n<p align=\"center\">7 313</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"449\">\n<p align=\"left\">Secrétaire administratif classe supérieure</p>\n</td>\n<td valign=\"top\" width=\"225\">\n<p align=\"center\">7 337</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"449\">\n<p>Secrétaire administratif classe normale</p>\n</td>\n<td valign=\"top\" width=\"225\">\n<p align=\"center\">7 442</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"449\">\n<p align=\"left\">Adjoint administratif principal</p>\n</td>\n<td valign=\"top\" width=\"225\">\n<p align=\"center\">3 529</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"449\">\n<p>Adjoint administratif</p>\n</td>\n<td valign=\"top\" width=\"225\">\n<p align=\"center\">3 545</p>\n</td>\n</tr>\n</tbody>\n</table>\n<p align=\"left\"> </p>\n<br/>\n<p align=\"left\">Lorsque des postes classés A0 ou A1 sont tenus par des techniciens supérieurs forestiers, le montant de base de la prime spéciale et de résultats est de 8 600 Euros.</p>"
  },

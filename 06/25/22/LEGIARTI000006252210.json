  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   La direction générale des systèmes d'information et de communication comprend les sous-directions suivantes :<br/>\n<br/>   - la sous-direction de la stratégie ;<br/>\n<br/>   - la sous-direction de l'architecture et de l'ingénierie ;<br/>\n<br/>   - la sous-direction de la sécurité des systèmes d'information ;<br/>\n<br/>   - la sous-direction des communications électroniques et des fréquences ;<br/>\n<br/>   - le bureau des affaires générales.<br/>\n<br/>   Elle comprend également, relevant directement du directeur général :<br/>\n<br/>   - le fonctionnaire de sécurité des systèmes d'information du ministère de la défense ;<br/>\n<br/>   - l'officier général chargé des fréquences ;<br/>\n<br/>   - des chargés de mission et des conseillers.<br/>"
  },

  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   La direction centrale de la police aux frontières comprend :<br/>\n<br/>   - un état-major ;<br/>\n<br/>   - trois sous-directions :<br/>\n<br/>      - la sous-direction de l'immigration irrégulière et des services territoriaux ;<br/>\n<br/>      - la sous-direction des ressources ;<br/>\n<br/>      - la sous-direction des affaires internationales, transfrontières et de la sûreté ;<br/>\n<br/>   - le service national de la police ferroviaire.<br/>"
  },

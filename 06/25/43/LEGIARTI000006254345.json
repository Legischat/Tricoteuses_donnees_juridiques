  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les bureaux suivants, relevant de l'ensemble des membres du comité exécutif de la marine, oeuvrent plus particulièrement dans le domaine fonctionnel des soutiens et des finances :<br/>\n<br/>   - le bureau \"administration\" ;<br/>\n<br/>   - le bureau \"finances\" ;<br/>\n<br/>   - le bureau \"infrastructure\" ;<br/>\n<br/>   - le bureau \"logistique générale\" ;<br/>\n<br/>   - le bureau \"organisation, réglementation et affaires juridiques\" ;<br/>\n<br/>   - le bureau \"soutiens de l'aéronautique navale\" ;<br/>\n<br/>   - le bureau \"soutiens navals\".<br/>"
  }

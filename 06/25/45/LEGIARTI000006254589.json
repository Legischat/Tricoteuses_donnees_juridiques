  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Agrément.<br/>\n<br/>   Pour bénéficier de l'appellation d'origine contrôlée \"Fin Gras\" ou \"Fin Gras du Mézenc\", la viande doit avoir satisfait aux dispositions du décret du 1er septembre 2006 relatif à l'agrément de la viande d'appellation d'origine contrôlée \"Fin Gras\" ou \"Fin Gras du Mézenc\".<br/>"
  },

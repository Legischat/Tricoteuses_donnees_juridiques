p\" width=\"76\">\n<br/>\n</td>\n<td valign=\"top\" width=\"95\">\n<br/>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"95\">\n<p align=\"left\">a) Dans les sociétés françaises (ensemble)</p>\n</td>\n<td valign=\"top\" width=\"57\">\n<br/>\n</td>\n<td valign=\"top\" width=\"57\">\n<br/>\n</td>\n<td valign=\"top\" width=\"57\">\n<br/>\n</td>\n<td valign=\"top\" width=\"57\">\n<br/>\n</td>\n<td valign=\"top\" width=\"57\">\n<br/>\n</td>\n<td valign=\"top\" width=\"57\">\n<br/>\n</td>\n<td valign=\"top\" width=\"57\">\n<br/>\n</td>\n<td valign=\"top\" width=\"57\">\n<br/>\n</td>\n<td valign=\"top\" width=\"76\">\n<br/>\n</td>\n<td valign=\"top\" width=\"95\">\n<br/>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"95\">\n<p align=\"left\">b) Dans les sociétés étrangères (ensemble)</p>\n</td>\n<td valign=\"top\" width=\"57\">\n<br/>\n</td>\n<td valign=\"top\" width=\"57\">\n<br/>\n</td>\n<td valign=\"top\" width=\"57\">\n<br/>\n</td>\n<td valign=\"top\" width=\"57\">\n<br/>\n</td>\n<td valign=\"top\" width=\"57\">\n<br/>\n</td>\n<td valign=\"top\" width=\"57\">\n<br/>\n</td>\n<td valign=\"top\" width=\"57\">\n<br/>\n</td>\n<td valign=\"top\" width=\"57\">\n<br/>\n</td>\n<td valign=\"top\" width=\"76\">\n<br/>\n</td>\n<td valign=\"top\" width=\"95\">\n<br/>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"95\">\n<p align=\"left\">II. - RENSEIGNEMENTS À FOURNIR LORSQUE LA SOCIÉTÉ A ANNEXÉ À SON BILAN UN BILAN ET DES COMPTES CONSOLIDÉS ÉTABLIS CONFORMÉMENT À L'ARTICLE R. 233-3</p>\n</td>\n<td valign=\"top\" width=\"57\">\n<br/>\n</td>\n<td valign=\"top\" width=\"57\">\n<br/>\n</td>\n<td valign=\"top\" width=\"57\">\n<br/>\n</td>\n<td valign=\"top\" width=\"57\">\n<br/>\n</td>\n<td valign=\"top\" width=\"57\">\n<br/>\n</td>\n<td valign=\"top\" width=\"57\">\n<br/>\n</td>\n<td valign=\"top\" width=\"57\">\n<br/>\n</td>\n<td valign=\"top\" width=\"57\">\n<br/>\n</td>\n<td valign=\"top\" width=\"76\">\n<br/>\n</td>\n<td valign=\"top\" width=\"95\">\n<br/>\n</td>\n</tr>\n<tr>\n<
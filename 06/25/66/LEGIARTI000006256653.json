  "BLOC_TEXTUEL": {
    "CONTENU": "<p>L'échelonnement indiciaire applicable au cadre d'emplois des directeurs de police municipale est fixé ainsi qu'il suit :<br/>\n</p>\n<table align=\"center\" border=\"1\" cellpadding=\"0\" cellspacing=\"0\">\n<tbody>\n<tr>\n<td width=\"469\">\n<p align=\"center\">GRADES ET ÉCHELONS</p>\n</td>\n<td width=\"197\">\n<p align=\"center\">INDICES BRUTS</p>\n</td>\n</tr>\n<tr>\n<td width=\"469\">\n<p align=\"center\">Directeur de police municipale</p>\n</td>\n<td width=\"197\">\n<p align=\"center\"> </p>\n</td>\n</tr>\n<tr>\n<td width=\"469\">\n<p>11e échelon</p>\n</td>\n<td width=\"197\">\n<p align=\"center\">740</p>\n</td>\n</tr>\n<tr>\n<td width=\"469\">\n<p>10e échelon</p>\n</td>\n<td width=\"197\">\n<p align=\"center\">703</p>\n</td>\n</tr>\n<tr>\n<td width=\"469\">\n<p>9e échelon</p>\n</td>\n<td width=\"197\">\n<p align=\"center\">665</p>\n</td>\n</tr>\n<tr>\n<td width=\"469\">\n<p>8e échelon</p>\n</td>\n<td width=\"197\">\n<p align=\"center\">630</p>\n</td>\n</tr>\n<tr>\n<td width=\"469\">\n<p>7e échelon</p>\n</td>\n<td width=\"197\">\n<p align=\"center\">592</p>\n</td>\n</tr>\n<tr>\n<td width=\"469\">\n<p>6e échelon</p>\n</td>\n<td width=\"197\">\n<p align=\"center\">562</p>\n</td>\n</tr>\n<tr>\n<td width=\"469\">\n<p>5e échelon</p>\n</td>\n<td width=\"197\">\n<p align=\"center\">524</p>\n</td>\n</tr>\n<tr>\n<td width=\"469\">\n<p>4e échelon</p>\n</td>\n<td width=\"197\">\n<p align=\"center\">491</p>\n</td>\n</tr>\n<tr>\n<td width=\"469\">\n<p>3e échelon</p>\n</td>\n<td width=\"197\">\n<p align=\"center\">453</p>\n</td>\n</tr>\n<tr>\n<td width=\"469\">\n<p>2e échelon</p>\n</td>\n<td width=\"197\">\n<p align=\"center\">417</p>\n</td>\n</tr>\n<tr>\n<td width=\"469\">\n<p>1er échelon</p>\n</td>\n<td width=\"197\">\n<p align=\"center\">379</p>\n</td>\n</tr>\n</tbody>\n</table>"
  }

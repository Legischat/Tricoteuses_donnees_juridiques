  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret n° 2007-102 du 26 janvier 2007 modifiant les dispositions relatives au comité des carrières, aux praticiens-conseils chargés du service du contrôle médical du régime général de sécurité sociale et du régime social des indépendants et modifiant le code de la sécurité sociale (deuxième partie : Décrets en Conseil d'Etat)",
          "@c_titre_court": "Décret n°2007-102 du 26 janvier 2007",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000644154"
        },
        {

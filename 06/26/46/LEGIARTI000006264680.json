  "BLOC_TEXTUEL": {
    "CONTENU": "<p>Les moniteurs d'atelier en fonctions à la date de publication du présent décret sont reclassés conformément au tableau ci-dessous :</p>\n<br/>\n<table>\n<tbody>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">\n<strong>SITUATION ANTÉRIEURE DANS L'ÉCHELLE</strong>\n<br/>\n<br/>dotée de 10 échelons</p>\n</td>\n<td align=\"left\" colspan=\"2\" valign=\"middle\">\n<p align=\"center\">\n<strong>SITUATION DANS L'ÉCHELLE DOTÉE DE 11 ÉCHELONS</strong>\n</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<pre> </pre>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">Échelons</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">Ancienneté conservée dans la limite de durée de l'échelon</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">1er échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">1er échelon </p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">ancienneté acquise </p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">2e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">2e échelon </p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">Ancienneté acquise </p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">3e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">3e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">Ancienneté acquise </p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">4e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">4e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">Ancienneté acquise </p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">5e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">5e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">Ancienneté acquise </p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">6e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">6e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">Ancienneté acquise </p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">7e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">7e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">Ancienneté acquise </p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">8e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">8e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">Ancienneté acquise</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">9e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">9e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">Ancienneté acquise</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">10e échelon avec moins de 3 ans d'ancienneté </p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">10e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">Ancienneté acquise</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">10e échelon avec 3 ans et plus d'ancienneté </p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">11e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">Sans ancienneté</p>\n</td>\n</tr>\n</tbody>\n</table>"
  }

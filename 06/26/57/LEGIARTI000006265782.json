  "BLOC_TEXTUEL": {
    "CONTENU": "<p>La composition des commissions administratives paritaires instituées à l'article 1er est fixée comme suit :</p>\n<table>\n<tbody>\n<tr>\n<td rowspan=\"3\" width=\"266\">\n<p align=\"center\">CORPS ET GRADES</p>\n</td>\n<td colspan=\"4\" width=\"377\">\n<p align=\"center\">NOMBRE DE REPRÉSENTANTS</p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" width=\"202\">\n<p align=\"center\">du personnel</p>\n</td>\n<td colspan=\"2\" width=\"174\">\n<p align=\"center\">de l'administration</p>\n</td>\n</tr>\n<tr>\n<td width=\"126\">\n<p align=\"center\">Titulaires</p>\n</td>\n<td width=\"76\">\n<p align=\"center\">Suppléants</p>\n</td>\n<td width=\"98\">\n<p align=\"center\">Titulaires</p>\n</td>\n<td width=\"76\">\n<p align=\"center\">Suppléants</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"266\">\n<p align=\"center\">1. Ministres plénipotentiaires</p>\n</td>\n<td valign=\"top\" width=\"126\">\n<p align=\"center\"> </p>\n</td>\n<td valign=\"top\" width=\"76\">\n<p align=\"center\"> </p>\n</td>\n<td valign=\"top\" width=\"98\">\n<p align=\"center\"> </p>\n</td>\n<td valign=\"top\" width=\"76\">\n<p align=\"center\"> </p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"266\">\n<p>Ministre plénipotentiaire hors classe</p>\n</td>\n<td valign=\"top\" width=\"126\">\n<p align=\"center\">2</p>\n</td>\n<td valign=\"top\" width=\"76\">\n<p align=\"center\">2</p>\n</td>\n<td rowspan=\"3\" width=\"98\">\n<p align=\"center\">6</p>\n</td>\n<td rowspan=\"3\" width=\"76\">\n<p align=\"center\">6</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"266\">\n<p>Ministre plénipotentiaire de 1re classe</p>\n</td>\n<td valign=\"top\" width=\"126\">\n<p align=\"center\">2</p>\n</td>\n<td valign=\"top\" width=\"76\">\n<p align=\"center\">2</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"266\">\n<p>Ministre plénipotentiaire de 2e classe</p>\n</td>\n<td valign=\"top\" width=\"126\">\n<p align=\"center\">2</p>\n</td>\n<td valign=\"top\" width=\"76\">\n<p align=\"center\">2</p>\n</td
>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"266\">\n<p>Assistant de service social</p>\n</td>\n<td valign=\"top\" width=\"126\">\n<p align=\"center\">1</p>\n</td>\n<td valign=\"top\" width=\"76\">\n<p align=\"center\">1</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"266\">\n<p align=\"center\">7. Secrétaires de chancellerie</p>\n</td>\n<td valign=\"top\" width=\"126\">\n<p align=\"center\"> </p>\n</td>\n<td valign=\"top\" width=\"76\">\n<p align=\"center\"> </p>\n</td>\n<td valign=\"top\" width=\"98\">\n<p align=\"center\"> </p>\n</td>\n<td valign=\"top\" width=\"76\">\n<p align=\"center\"> </p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"266\">\n<p>Secrétaire de chancellerie de classe exceptionnelle</p>\n</td>\n<td valign=\"top\" width=\"126\">\n<p align=\"center\">2</p>\n</td>\n<td valign=\"top\" width=\"76\">\n<p align=\"center\">2</p>\n</td>\n<td rowspan=\"3\" width=\"98\">\n<p align=\"center\">6</p>\n</td>\n<td rowspan=\"3\" width=\"76\">\n<p align=\"center\">6</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"266\">\n<p>Secrétaire de chancellerie de classe supérieure</p>\n</td>\n<td valign=\"top\" width=\"126\">\n<p align=\"center\">2</p>\n</td>\n<td valign=\"top\" width=\"76\">\n<p align=\"center\">2</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"266\">\n<p>Secrétaire de chancellerie de classe normale</p>\n</td>\n<td valign=\"top\" width=\"126\">\n<p align=\"center\">2</p>\n</td>\n<td valign=\"top\" width=\"76\">\n<p align=\"center\">2</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"266\">\n<p align=\"center\">8. Secrétaires des systèmes d'information et de communication</p>\n</td>\n<td valign=\"top\" width=\"126\">\n<p align=\"center\"> </p>\n</td>\n<td valign=\"top\" width=\"76\">\n<p align=\"center\"> </p>\n</td>\n<td valign=\"top\" width=\"98\">\n<p align=\"center\"> </p>\n</td>\n<td valign=\"top\" width=\"76\">\n<p align=\"center\"> </p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"266\">\n<p>Secrétaire des systèmes d'informa
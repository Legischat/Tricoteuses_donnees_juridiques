  "NOTA": {
    "CONTENU": "<p>L'Agence unique de paiement est devenue l'Agence de services et de paiement par le décret n° 2009-340 du 27 mars 2009 art. 10.</p>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Le présent décret prend effet à la date d'entrée en vigueur de l'arrêté portant agrément de l'Agence unique de paiement en tant qu'organisme payeur des aides prévues à l'article 1er, en application de l'article R. 621-33.<br/>\n<br/>"
  },

  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret n°80-560 du 11 juillet 1980 PORTANT REVISION DU CODE RURAL EN CE QUI CONCERNE LES DISPOSITIONS LEGISLATIVES RELATIVES A L'ENSEIGNEMENT,LA FORMATION PROFESSIONNELLE ET AU DEVELOPPEMENT AGRICOLE,AINSI QU'A LA RECHERCHE AGRONOMIQUE",
          "@c_titre_court": "Décret n°80-560 du 11 juillet 1980",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000517057"
        },
        {
          "#text": "Décret n°80-560 du 11 juillet 1980 portant révision du code rural en ce qui concerne les dispositions législatives relatives à l'enseignement, à la formation professionnelle et au développement agricoles ainsi qu'à la recherche agronomique",
          "@c_titre_court": "Décret n°80-560 du 11 juillet 1980",
          "@debut": "1980-07-20",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006063281"
        }
      ],
      "@cid": "JORFTEXT000000517057",
      "@date_publi": "1980-07-20",
      "@date_signature": "1980-07-11",
      "@nature": "DECRET",
      "@num": "80-560"
    }
  },

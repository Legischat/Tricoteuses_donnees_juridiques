  "NOTA": {
    "CONTENU": "<br/>  La loi n° 70-1318 a été abrogée par l'article 7 III de la loi n° 91-1406 du 31 décembre 1991.<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les praticiens statutaires des établissements d'hospitalisation publics qui n'exercent pas l'activité libérale définie par les articles 25-1 à 25-6 de la loi du 31 décembre 1970 susvisée bénéficient des dispositions statutaires prévues par les articles 4 à 6.<br/>\n<br/>"
  },

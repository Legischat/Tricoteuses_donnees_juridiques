  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   LE LOCATAIRE D'UN VEHICULE FAISANT L'OBJET SOIT D'UN CONTRAT DE CREDIT-BAIL, SOIT D'UN CONTRAT DE LOCATION DE DEUX ANS OU PLUS ET COMPORTANT UNE FACULTE D'ACHAT, EST REDEVABLE DE LA TAXE SPECIALE SUR CERTAINS VEHICULES ROUTIERS AU LIEU ET PLACE DU PROPRIETAIRE.<br/>\n<br/>   TOUTEFOIS, CE DERNIER EST SOLIDAIREMENT RESPONSABLE DU PAIEMENT DE LA TAXE AINSI QUE, LE CAS ECHEANT, DE LA MAJORATION DE RETARD APPLICABLE.<br/>\n<br/>   LES DISPOSITIONS CI-DESSUS SONT ETENDUES A LA TAXE DIFFERENTIELLE SUR LES VEHICULES AUTOMOBILES.<br/>\n<br/>"
  },

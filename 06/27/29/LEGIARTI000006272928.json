  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   I. LE TARIF DU DROIT DE TIMBRE APPLICABLE AUX PASSEPORTS EST PORTE A 100 F.<br/>\n<br/>\n<br/>   II. LES TAUX DE LA TAXE PREVUE A L' ARTICLE 1010 DU CODE GENERAL DES IMPOTS SONT PORTES A 1 600 F ET 2 300 F A COMPTER DE LA PERIODE D' IMPOSITION S' OUVRANT LE 1ER OCTOBRE 1974 .<br/>\n CETTE TAXE EST DUE A RAISON DE TOUTES LES VOITURES PARTICULIERES POSSEDEES OU UTILISEES PAR LES SOCIETES .<br/>\n LA TAXE N' EST TOUTEFOIS PAS APPLICABLE AUX VEHICULES DESTINES EXCLUSIVEMENT SOIT A LA VENTE, SOIT A LA LOCATION DE COURTE DUREE OU A L' EXECUTION D' UN SERVICE DE TRANSPORT A LA DISPOSITION DU PUBLIC LORSQUE CES OPERATIONS CORRESPONDENT A L' ACTIVITE NORMALE DE LA SOCIETE PROPRIETAIRE .<br/>"
  },

  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   A COMPTER DU 1ER JANVIER 1974, LES CONTRIBUABLES AGES DE PLUS DE SOIXANTE-QUINZE ANS QUI NE SONT PAS PASSIBLES DE L' IMPOT SUR LE REVENU AU TITRE DES REVENUS DE L' ANNEE PRECEDENTE, SONT DEGREVES D'OFFICE DE LA TAXE D' HABITATION AFFERENTE A LEUR RESIDENCE PRINCIPALE LORSQU' ILS OCCUPENT CELLE-CI DANS LES CONDITIONS PREVUES A L'ARTICLE 1398 DU CODE GENERAL DES IMPOTS.<br/>\n<br/>"
  },

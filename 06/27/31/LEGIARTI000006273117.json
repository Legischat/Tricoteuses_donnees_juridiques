      "TITRE_TXT": [
        {
          "#text": "Loi n°77-774 du 12 juillet 1977 TENDANT A ACCORDER AUX FEMMES ASSUREES AU REGIME GENERAL DE SECURITE SOCIALE,ATTEIGNANT L'AGE DE 60 ANS,LA PENSION DE VIEILLESSE AU TAUX NORMALEMENT APPLICABLE A 65 ANS",
          "@c_titre_court": "Loi n°77-774 du 12 juillet 1977",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000522844"
        },
        {
          "#text": "Loi n° 77-774 du 12 juillet 1977 tendant à accorder aux femmes assurées au régime général de sécurité sociale, atteignant l'âge de soixante ans, la pension de vieillesse au taux normalement applicable à soixante-cinq ans.",
          "@c_titre_court": "Loi n° 77-774 du 12 juillet 1977",
          "@debut": "1977-07-13",

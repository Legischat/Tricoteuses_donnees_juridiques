    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Loi n°82-1021 du 3 décembre 1982 RELATIVE AU REGLEMENT DE CERTAINES SITUATIONS RESULTANT DES EVENEMENTS D'AFRIQUE DU NORD,DE LA GUERRE D'INDOCHINE OU DE LA SECONDE GUERRE MONDIALE",
          "@c_titre_court": "Loi n°82-1021 du 3 décembre 1982",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000503957"
        },
        {
          "#text": "Loi n° 82-1021 du 3 décembre 1982 relative au règlement de certaines situations résultant des évènements d'Afrique du Nord, de la guerre d'Indochine ou de la seconde guerre mondiale.",
          "@c_titre_court": "Loi n° 82-1021 du 3 décembre 1982",

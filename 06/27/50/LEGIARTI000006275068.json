  "NOTA": {
    "CONTENU": "<br/>  Les dispositions initiales de l'article 21 de la loi 86-897 avaient été déclarées non conformes à la Constitution par décision du Conseil constitutionnel n° 86-210 DC du 29 juillet 1986.<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "Sont abrogées :<br/>\n<br/>   1° L'ordonnance du 26 août 1944 sur l'organisation de la presse française;<br/>\n<br/>   2° La loi n° 84-937 du 23 octobre 1984 précitée.<br/>"
  },

    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Arrêté du 14 décembre 1989 MODIFIANT L'ARRETE DU 13-01-1978 MODIFIE RELATIF AU RENOUVELLEMENT DE L'EPREUVE DES BOUTEILLES EN ACIER UTILISEES A L'EMMAGASINAGE DE L'HYDROGENE OU D'UN GAZ DE L'AIR",
          "@c_titre_court": "Arrêté du 14 décembre 1989",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000499751"
        },
        {
          "#text": "Arrêté du 14 décembre 1989 modifiant l'arrêté du 13 janvier 1978 modifié relatif au renouvellement de l'épreuve des bouteilles en acier utilisées à l'emmagasinage de l'hydrogène ou d'un gaz de l'air",
          "@c_titre_court": "Arrêté du 14 décembre 1989",
          "@debut": "1989-12-23",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006059360"
        },
        {
          "#text": "Arrêté du 13 janvier 1978 relatif au renouvellement de l'épreuve de bouteilles en alliage d'aluminium sans soudure utilisées à l'emmagasinage de gaz comprimés ou liquéfiés",
          "@c_titre_court": "Arrêté du 13 janvier 1978",
          "@debut": "1993-06-11",
          "@fin": "1996-08-09",
          "@id_txt": "LEGITEXT000006059361"

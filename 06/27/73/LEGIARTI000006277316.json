  "NOTA": {
    "CONTENU": "<br/>    L'abrogation a lieu sans préjudice de l'article 22 et, le cas échéant, du dernier alinéa de l'article 20 du décret n° 2006-447 du 12 avril 2006.<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   On appelle cycle de pesage la séquence des opérations suivantes :<br/>\n<br/>   - la délivrance d'une charge dans le récepteur de charge ;<br/>\n<br/>   - la pesée de cette charge ;<br/>\n<br/>   - le déchargement en vrac de cette charge.<br/>"
  },

  "NOTA": {
    "CONTENU": "<br/>  La liste des fonctionnaires et agents auteurs d'une invention est annexée à l'article R. 611-14-1 de ce code.<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>Le fonctionnaire ou agent public auteur d'une invention en fait immédiatement la déclaration à l'autorité habilitée par la personne publique dont il relève. <br/>\n<br/>Les dispositions des articles R. 611-1 à R. 611-10 relatives aux obligations du salarié et de l'employeur sont applicables aux fonctionnaires et agents publics et aux personnes publiques intéressées.<br/>"
  },

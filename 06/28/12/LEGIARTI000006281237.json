      "TITRE_TXT": [
        {
          "#text": "Loi n°78-742 du 13 juillet 1978 MODIFIANT ET COMPLETANT LA LOI 681 DU 02-01-1968 TENDANT A VALORISER L'ACTIVITE INVENTIVE ET A MODIFIER LE REGIME DES BREVETS D'INVENTION",
          "@c_titre_court": "Loi n°78-742 du 13 juillet 1978",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000339240"
        },
        {
          "#text": "Loi n°78-742 du 13 juillet 1978 modifiant et complétant la loi n° 68-1 du 2 janvier 1968 tendant à valoriser l'activité inventive et à modifier le régime des brevets d'invention",
          "@c_titre_court": "Loi n°78-742 du 13 juillet 1978",
          "@debut": "1979-07-01",
          "@fin": "1992-07-03",
          "@id_txt": "LEGITEXT000006068642"
        }

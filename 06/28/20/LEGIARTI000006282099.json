  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret n°71-765 du 9 septembre 1971 FIXANT LA LISTE DES ESPECES VEGETALES POUR LESQUELLES PEUVENT ETRE DELIVRES DES CERTIFICATS D'OBTENTION AINSI QUE POUR CHACUNE D'ELLES LA PORTEE ET LA DUREE DU DROIT DE L'OBTENTEUR",
          "@c_titre_court": "Décret n°71-765 du 9 septembre 1971",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000336379"
        },
        {
          "#text": "Décret n°71-765 du 9 septembre 1971 fixant la liste des espèces végétales pour lesquelles peuvent être délivrés des certificats d'obtention ainsi que pour chacune d'elles la portée et la durée du droit de l'obtenteur",
          "@c_titre_court": "Décret n°71-765 du 9 septembre 1971",
          "@debut": "1971-09-18",
          "@fin": "1995-04-13",
          "@id_txt": "LEGITEXT000006061862"
        }
      ],
      "@cid": "JORFTEXT000000336379",
      "@date_publi": "1971-09-18",
      "@date_signature": "1971-09-09",
      "@nature": "DECRET",
      "@num": "71-765"
    }
  },
  "VERSIONS": {
    "VERSION": [
      {
        "LIEN_ART": {
          "@debut": "1982-03-18",
          "@etat": "ABROGE",

  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Arrêté du 26 mars 1992 FIXANT LES CONDITIONS DE PRESENTATION A L'ADMINISTRATION DES DOUANES DE LA DEMANDE ECRITE D'INTERVENTION DU PROPRIETAIRE D'UNE MARQUE ENREGISTREE OU DU BENEFICIAIRE D'UN DROIT EXCLUSIF D'EXPLOITATION",
          "@c_titre_court": "Arrêté du 26 mars 1992",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000505768"
        },
        {
          "#text": "Arrêté du 26 mars 1992 fixant les conditions de présentation à l'administration des douanes de la demande écrite d'intervention du propriétaire d'une marque enregistrée ou du bénéficiaire d'un droit exclusif d'exploitation",
          "@c_titre_court": "Arrêté du 26 mars 1992",
          "@debut": "1992-04-03",
          "@fin": "1995-02-15",
          "@id_txt": "LEGITEXT000006060035"
        }
      ],
      "@cid": "JORFTEXT000000505768",
      "@date_publi": "1992-04-03",
      "@date_signature": "1992-03-26",
      "@nature": "ARRETE",
      "@nor": "BUDD9250003A"
    }
  },

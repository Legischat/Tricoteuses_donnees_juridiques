  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les achats et les ventes se constatent :<br/>\n<br/>   Par actes publics,<br/>\n<br/>   Par actes sous signature privée,<br/>\n<br/>   Par le bordereau ou arrêté d'un agent de change ou courtier, dûment signé par les parties,<br/>\n<br/>   Par une facture acceptée,<br/>\n<br/>   Par la correspondance,<br/>\n<br/>   Par les livres des parties,<br/>\n<br/>   Par la preuve testimoniale, dans le cas où le tribunal croira devoir l'admettre.<br/>"
  },

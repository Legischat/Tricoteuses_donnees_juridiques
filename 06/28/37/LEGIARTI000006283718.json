  "BLOC_TEXTUEL": {
    "CONTENU": "<p>A modifié les dispositions suivantes :</p>\n<blockquote>-Code de la nationalité française <blockquote>\nSct. Section 2 : Acquisition de la nationalité française à raison du mariage, Art. 37, Art. 38, Art. 39, Art. 40, Art. 42, Art. 43 \n</blockquote>\n</blockquote>\n<br/>\n<p>A créé les dispositions suivantes :</p>\n<blockquote>-Code de la nationalité française <blockquote>\nArt. 37-1 \n</blockquote>\n</blockquote>\n<br/>\n<br/>\n<p>A abrogé les dispositions suivantes :</p>\n<blockquote>-Code de la nationalité française <blockquote>\nArt. 41\n</blockquote>\n</blockquote>\n<br/>\n<br/>"
  },

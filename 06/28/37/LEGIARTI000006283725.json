  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>\n<p>I.-A abrogé les dispositions suivantes :</p>\n<blockquote>-Code de la nationalité française <blockquote>\nArt. 72, Art. 73, Art. 74, Art. 75, Art. 76, Art. 77 \n</blockquote>\n</blockquote>\n<p>III.-A abrogé les dispositions suivantes :</p>\n<blockquote>-Code de la nationalité française <blockquote>\nSct. Paragraphe 1er : Naturalisation, Sct. Paragraphe 2 : Réintégration \n</blockquote>\n</blockquote>\n<p>A modifié les dispositions suivantes :</p>\n<blockquote>-Code de la nationalité française <blockquote>\nArt. 59, Art. 61, Art. 62, Art. 63, Art. 64, Art. 64-1, Art. 65, Art. 66, Art. 67, Art. 68, Art. 69, Art. 71\n</blockquote>\n</blockquote>\n<br/>"
  },

  "BLOC_TEXTUEL": {
    "CONTENU": "<p>A modifié les dispositions suivantes :</p>\n<blockquote>-Code de la nationalité française <blockquote>\nArt. 124, Art. 128, Art. 129, Art. 131, Art. 136 \n</blockquote>\n</blockquote>\n<div>\n<p>A abrogé les dispositions suivantes :</p>\n</div>\n<blockquote>-Code de la nationalité française <blockquote>\nArt. 125, Art. 126, Art. 127, Art. 130, Art. 132, Art. 133, Art. 134, Art. 135, Art. 137\n</blockquote>\n</blockquote>"
  },

          "@id_txt": "JORFTEXT000000322317"
        },
        {
          "#text": "Loi n° 72-964 du 25 octobre 1972 relative à la francisation des noms et prénoms des personnes qui acquièrent, recouvrent ou se font reconnaître la nationalité française",
          "@c_titre_court": "Loi n° 72-964 du 25 octobre 1972",

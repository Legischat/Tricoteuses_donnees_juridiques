      "TITRE_TXT": [
        {
          "#text": "Loi  du 22 juillet 1922 supprimant dans les actes de naissance des enfants naturels les mentions relatives au père ou à la mère, lorsque ceux-ci sont inconnus ou non dénommés.",
          "@c_titre_court": "Loi du 22 juillet 1922",
          "@debut": "1922-07-25",
          "@fin": "2007-12-22",
          "@id_txt": "LEGITEXT000006069449"
        }
      ],
      "@cid": "LEGITEXT000006069449",

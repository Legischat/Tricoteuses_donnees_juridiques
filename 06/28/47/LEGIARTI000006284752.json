    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Loi du 20 juin 1920 AYANT POUR OBJET DE SUPPLEER PAR DES ACTES DE NOTORIETE A L'IMPOSSIBILITE DE SE PROCURER DES EXPEDITIONS DES ACTES DE L'ETAT-CIVIL DONT LES ORIGINAUX ONT ETE DETRUITS OU SONT DISPARUS PAR SUITE DES FAITS DE GUERRE",
          "@c_titre_court": "Loi du 20 juin 1920",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000869394"
        },
        {
          "#text": "Loi du 20 juin 1920 ayant pour objet de suppléer par des actes de notoriété à l'impossibilité de se procurer des expéditions des actes de l'état civil dont les originaux ont été détruits ou sont disparus par suite de faits de guerre.",
          "@c_titre_court": "Loi du 20 juin 1920",
          "@debut": "1920-06-20",
          "@fin": "2019-03-25",
          "@id_txt": "LEGITEXT000006069451"
        }

      "TITRE_TXT": [
        {
          "#text": "Loi n°70-1323 du 31 décembre 1970 ABROGEANT L'ART. 337 DU CODE CIVIL RELATIF A LA RECONNAISSANCE FAITE,DURANT LE MARIAGE,PAR UN EPOUX,D'UN ENFANT NATUREL NE AVANT LE MARIAGE,D'UN AUTRE QUE DE SON CONJOINT",
          "@c_titre_court": "Loi n°70-1323 du 31 décembre 1970",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000321404"
        },
        {
          "#text": "Loi n° 70-1323 du 31 décembre 1970 abrogeant l'article 337 du Code civil relatif à la reconnaissance faite, durant le mariage, par un époux, d'un enfant naturel né avant le mariage, d'un autre que de son conjoint.",

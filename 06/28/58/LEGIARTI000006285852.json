      "TITRE_TXT": [
        {
          "#text": "Décret n°80-308 du 25 avril 1980 PORTANT APPLICATION DES ARTICLES 98 A 98-4 ET 99-1 DU CODE CIVIL RELATIFS A L'ETAT-CIVIL DES PERSONNES NEES A L'ETRANGER QUI ACQUIERENT OU RECOUVRENT LA NATIONALITE FRANCAISE ET DES ARTICLES 115 ET 116 DU CODE DE LA NATIONALITE RELATIFS AUX MENTIONS INTERESSANT LA NATIONALITE PORTEES EN MARGE DES ACTES DE NAISSANCE",
          "@c_titre_court": "Décret n°80-308 du 25 avril 1980",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000878132"
        },
        {
          "#text": "Décret n°80-308 du 25 avril 1980 portant application des articles 98 à 98-4 et 99-1 du code civil relatifs à l'état civil des personnes nées à l'étranger qui acquièrent ou recouvrent la nationalité française et des articles 115 et 116 du code de la nationalité relatifs aux mentions intéressant la nationalité portées en marge des actes de naissance",
          "@c_titre_court": "Décret n°80-308 du 25 avril 1980",
          "@debut": "1980-05-03",
          "@fin": "2999-01-01",

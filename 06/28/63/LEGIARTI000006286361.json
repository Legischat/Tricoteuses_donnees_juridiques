  "NOTA": {
    "CONTENU": "<br/>  Décret 2005-1678 2005-12-28 art 87 : Le présent décret entre en vigueur le 1er mars 2006 à l'exception de son article 84. Il est applicable aux procédures en cours.<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Le créancier d'aliments qui, de mauvaise foi, aura fait usage de la procédure de paiement direct sera condamné par le tribunal d'instance à une amende civile d'un maximum de 3 000 euros.<br/>\n<br/>"
  },

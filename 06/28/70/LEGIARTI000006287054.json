  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret n°83-765 du 26 août 1983 L'ETAT EST AUTORISE A EMETTRE UN EMPRUNT A DEUX TRANCHES REPRESENTE POUR LA PREMIERE TRANCHE PAR DES OBLIGATIONS 13,70% SEPTEMBRE 1983 ET POUR LA SECONDE TRANCHE PAR DES OBLIGATIONS ECHANGEABLES 13,20% SEPTEMBRE 1983 D'UNE VALEUR NOMINALE DE 2000FRS ET EMISES AU PAIR",
          "@c_titre_court": "Décret n°83-765 du 26 août 1983",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000860629"
        },
        {
          "#text": "Décret n°83-765 du 26 août 1983 relatif à l'émission de l'emprunt d'Etat septembre 1983",
          "@c_titre_court": "Décret n°83-765 du 26 août 1983",
          "@debut": "1983-08-27",
          "@fin": "2999-01-01",

  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret n°83-1026 du 2 décembre 1983 AUTORISATION DE L'EMISSION D'UN EMPRUNT A DEUX TRANCHES REPRESENTE POUR LA PREMIERE TRANCHE PAR DES OBLIGATIONS DE 13,40% décembre 1983 ET POUR LA SECONDE TRANCHE PAR DES OBLIGATIONS ECHANGEABLES 12,90% décembre 1983 D'UNE VALEUR NOMINALE DE 2000FRS ET EMISES AU PAIR",
          "@c_titre_court": "Décret n°83-1026 du 2 décembre 1983",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000698608"
        },
        {
          "#text": "Décret n°83-1026 du 2 décembre 1983 relatif à l'émission de l'emprunt d'Etat Décembre 1983",
          "@c_titre_court": "Décret n°83-1026 du 2 décembre 1983",

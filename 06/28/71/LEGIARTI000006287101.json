  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret n°84-871 du 1 octobre 1984 RELATIF A L'EMISSION DE L'EMPRUNT D'ETAT OCTOBRE 1984 A DEUX TRANCHES REPRESENTE POUR LA PREMIERE TRANCHE PAR DES OBLIGATIONS 12,20% OCTOBRE 1984 ET POUR LA SECONDE TRANCHE PAR DES OBLIGATIONS ECHANGEABLES 11,60% OCTOBRE 1984,D'UNE VALEUR NOMINALE DE 2000FRS EMISES AU PAIR",
          "@c_titre_court": "Décret n°84-871 du 1 octobre 1984",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000328386"
        },
        {
          "#text": "Décret n°84-871 du 1 octobre 1984 relatif à l'émission de l'emprunt d'Etat octobre 1984",
          "@c_titre_court": "Décret n°84-871 du 1 octobre 1984",
          "@debut": "1984-10-02",
          "@fin": "2999-01-01",

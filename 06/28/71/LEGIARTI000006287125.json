      "TITRE_TXT": [
        {
          "#text": "Décret n°85-629 du 31 mai 1985 RELATIF A L'EMISSION DE L'EMPRUNT D'ETAT JUIN 1985 ET AUTORISANT L'EMISSION D'OBLIGATIONS ASSIMILABLES DU TRESOR",
          "@c_titre_court": "Décret n°85-629 du 31 mai 1985",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000508385"
        },
        {
          "#text": "Décret n°85-629 du 31 mai 1985 relatif à l'émission de l'emprunt d'Etat Juin 1985 et autorisant l'émission d'obligations assimilables du Trésor",
          "@c_titre_court": "Décret n°85-629 du 31 mai 1985",

  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret n°85-1119 du 25 septembre 1985 RELATIF A L'EMISSION DE L'EMPRUNT D'ETAT SEPTEMBRE 1985 ET AUTORISANT L'EMISSION D'OBLIGATIONS ASSIMILABLES DU TRESOR",
          "@c_titre_court": "Décret n°85-1119 du 25 septembre 1985",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000502824"
        },
        {
          "#text": "Décret n°85-1119 du 25 septembre 1985 relatif à l'émission de l'emprunt d'Etat Septembre 1985 et autorisant l'émission d'obligations assimilables du Trésor",
          "@c_titre_court": "Décret n°85-1119 du 25 septembre 1985",
          "@debut": "1985-10-22",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006064725"
        }
      ],
      "@cid": "JORFTEXT000000502824",

  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret n°87-1 du 5 janvier 1987 RELATIF A L'EMISSION DE L'EMPRUNT D'ETAT JANVIER 1987 ET AUTORISANT L'EMISSION D'OBLIGATIONS ASSIMILABLES DU TRESOR",
          "@c_titre_court": "Décret n°87-1 du 5 janvier 1987",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000882425"
        },
        {
          "#text": "Décret n°87-1 du 5 janvier 1987 relatif à l'émission de l'emprunt d'Etat Janvier 1987 et autorisant l'émission d'obligations assimilables du Trésor",
          "@c_titre_court": "Décret n°87-1 du 5 janvier 1987",
          "@debut": "1987-01-07",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006065747"
        }
      ],

      "TITRE_TXT": [
        {
          "#text": "Décret n°89-4 du 4 janvier 1989 RELATIF A L'EMISSION DE L'EMPRUNT D'ETAT JANVIER 1989 ET AUTORISANT L'EMISSION D'OBLIGATIONS ASSIMILABLES DU TRESOR",
          "@c_titre_court": "Décret n°89-4 du 4 janvier 1989",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000523097"
        },
        {
          "#text": "Décret n°89-4 du 4 janvier 1989 relatif à l'émission de l'emprunt d'Etat Janvier 1989 et autorisant l'émission d'obligations assimilables du Trésor",
          "@c_titre_court": "Décret n°89-4 du 4 janvier 1989",
          "@debut": "1989-01-05",
          "@fin": "2999-01-01",

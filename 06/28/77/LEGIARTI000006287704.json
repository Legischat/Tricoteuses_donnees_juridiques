      "TITRE_TXT": [
        {
          "#text": "Arrêté du 4 mai 1987 FIXANT LA VALEUR D'ECHANGE DES TITRES DE L'EMPRUNT D'ETAT 7% 1973 REMIS EN REGLEMENT DES OBLIGATIONS ASSIMILABLES A CELLES DE L'EMPRUNT D'ETAT JANVIER 1987 EMISES EN MAI 1987",

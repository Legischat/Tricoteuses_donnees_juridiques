      "TITRE_TXT": [
        {
          "#text": "Arrêté du 28 août 1987 FIXANT LA LIMITE DE REMISE PAR PAIEMENT DES TITRES DE L'EMPRUNT D'ETAT 7% 1973 EN SOUSCRIPTION DES OBLIGATIONS ASSIMILABLES DE L'EMPRUNT D'ETAT JANVIER 1987 DE LA SERIE SEPTEMBRE 1987",

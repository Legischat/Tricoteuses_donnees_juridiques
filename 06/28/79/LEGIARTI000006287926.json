      "TITRE_TXT": [
        {
          "#text": "Arrêté du 28 septembre 1988 FIXANT LA VALEUR DU COUPON A ECHEANCE DU 08-10-1989 POUR LES OBLIGATIONS A TAUX VARIABLE OCTOBRE 1984 DE L'EMPRUNT D'ETAT OCTOBRE 1984 (CODE SICOVAM N0 10186)",

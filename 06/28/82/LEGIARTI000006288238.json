      "TITRE_TXT": [
        {
          "#text": "Arrêté du 4 février 1991 FIXANT LA VALEUR DU COUPON A ECHEANCE DU 21-02-1992 POUR LES OBLIGATIONS A TAUX REVISABLE ET A OPTION D'ECHANGE DE LA DEUXIEME TRANCHE DE L'EMPRUNT D'ETAT février 1985 (CODE SICOVAM N0 4193)",

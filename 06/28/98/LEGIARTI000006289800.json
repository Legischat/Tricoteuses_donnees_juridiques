d>\n<td valign=\"top\" width=\"116\">\n<p align=\"center\">212-658-8</p>\n</td>\n<td valign=\"top\" width=\"291\">\n<p>4,4'-méthylènedi-o-toluidine.</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"40\">\n<p align=\"center\">14</p>\n</td>\n<td valign=\"top\" width=\"116\">\n<p align=\"center\">120-71-8</p>\n</td>\n<td valign=\"top\" width=\"117\">\n<p align=\"center\"> </p>\n</td>\n<td valign=\"top\" width=\"116\">\n<p align=\"center\">204-419-1</p>\n</td>\n<td valign=\"top\" width=\"291\">\n<p>6-méthoxy-m-toluidine.</p>\n<p>p-crésidine.</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"40\">\n<p align=\"center\">15</p>\n</td>\n<td valign=\"top\" width=\"116\">\n<p align=\"center\">101-14-4</p>\n</td>\n<td valign=\"top\" width=\"117\">\n<p align=\"center\">612-078-00-9</p>\n</td>\n<td valign=\"top\" width=\"116\">\n<p align=\"center\">202-918-9</p>\n</td>\n<td valign=\"top\" width=\"291\">\n<p>4,4'-méthylène-bis-(2-chloro-aniline).</p>\n<p>2,2'-dichloro-4,4'-méthylène-dialinine.</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"40\">\n<p align=\"center\">16</p>\n</td>\n<td valign=\"top\" width=\"116\">\n<p align=\"center\">101-80-4</p>\n</td>\n<td valign=\"top\" width=\"117\">\n<p align=\"center\"> </p>\n</td>\n<td valign=\"top\" width=\"116\">\n<p align=\"center\">202-977-0</p>\n</td>\n<td valign=\"top\" width=\"291\">\n<p>4,4'-oxydialinine.</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"40\">\n<p align=\"center\">17</p>\n</td>\n<td valign=\"top\" width=\"116\">\n<p align=\"center\">139-65-1</p>\n</td>\n<td valign=\"top\" width=\"117\">\n<p align=\"center\"> </p>\n</td>\n<td valign=\"top\" width=\"116\">\n<p align=\"center\">205-370-9</p>\n</td>\n<td valign=\"top\" width=\"291\">\n<p>4,4'-thiodianiline.</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"40\">\n<p align=\"center\">18</p>\n</td>\n<td valign=\"top\" width=\"116\">\n<p align=\"center\">95-53-4</p>\n</td>\n<td valign=\"top\" width=\"117\">\n<p align=\"center\">612-091-00-X</p>\n</td>\n<td v
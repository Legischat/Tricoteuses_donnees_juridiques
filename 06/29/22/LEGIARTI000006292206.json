  "NOTA": {
    "CONTENU": "<br/>  Ordonnance 2005-136 2005-02-17 art. 5 : Les dispositions de la présente ordonnance s'appliquent aux contrats conclus postérieurement à son entrée en vigueur.<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Elles ne sont applicables ni aux biens vendus par autorité de justice ni à ceux vendus aux enchères publiques.<br/>\n<br/>   Elles ne s'appliquent pas non plus à l'électricité.<br/>"
  },

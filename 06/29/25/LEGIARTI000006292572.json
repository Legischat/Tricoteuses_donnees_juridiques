  "BLOC_TEXTUEL": {
    "CONTENU": "<p>La saisine du juge aux fins de rétablissement personnel emporte suspension des voies d'exécution, y compris des mesures d'expulsion du logement du débiteur, jusqu'au jugement d'ouverture.</p>\n<br/>"
  },

  "NOTA": {
    "CONTENU": "<br/>   [*Nota - article relevant de l'ordre public économique de protection sociale par avis de la Cour de cassation n° 09420028P du 16 décembre 1994*].<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Un règlement du comité de la réglementation bancaire, pris après avis de la Commission nationale de l'informatique et des libertés et du comité consultatif institué par l'article 59 de la loi n° 84-46 du 24 janvier 1984 précitée, fixe notamment les modalités de collecte, d'enregistrement, de conservation et de consultation de ces informations.<br/>\n<br/>"
  },

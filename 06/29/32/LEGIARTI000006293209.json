  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   L'Institut national de la consommation a pour objet de :<br/>\n<br/>   a) Fournir un appui technique aux organisations de consommateurs ;<br/>\n<br/>   b) Regrouper, produire, analyser et diffuser des informations, études, enquêtes et essais ;<br/>\n<br/>   c) Mettre en oeuvre des actions de formation et d'éducation sur les questions de consommation.<br/>"
  },

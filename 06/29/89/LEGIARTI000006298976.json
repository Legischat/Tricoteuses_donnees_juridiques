  "NOTA": {
    "CONTENU": "<br/>  Loi 2003-239 2003-03-18 art. 131 : Le présent article est applicable à Mayotte.<br/>\n<br/>  La présente version de cet article est en vigueur jusqu'au 7 mars 2009.<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Tout agent employé pour exercer une activité mentionnée au 2° de l'article 1er doit être titulaire d'un agrément délivré par le préfet du département ou, à Paris, par le préfet de police, qui s'assure que l'intéressé ne tombe pas sous le coup des dispositions des 2° à 5° de l'article 6.<br/>\n<br/>"
  },

  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   LE BENEFICE DE LA PROVISION PREVUE A L'ARTICLE 4 QUATER EST LIMITE AUX OPERATIONS QUI FONT L'OBJET D'UNE OUVERTURE DE CREDIT AU COURS DES ANNEES 1966 A 1980.<br/>\n<br/>   SON MONTANT NE PEUT EXCEDER 20 % DU MONTANT DU RISQUE PROPRE AUX CREDITS DEFINIS CI-DESSUS QUI N'EST PAS COUVERT EFFECTIVEMENT PAR LA COMPAGNIE FRANCAISE POUR LE COMMERCE EXTERIEUR (COFACE) OU PAR TOUTE BANQUE OU ETABLISSEMENT FINANCIER, NI 1 % DU MONTANT DE CES MEMES CREDITS QUI FIGURE AU BILAN DE CLOTURE DE L'EXERCICE.<br/>"
  },

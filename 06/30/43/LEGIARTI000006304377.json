  "NOTA": {
    "CONTENU": "<br/>   (1) Abrogation en vigueur le 1er janvier 1993, loi 91-716.<br/>\n<br/>   (2) Abrogation en vigueur le 13 avril 1992, loi 92-655 1992-07-15 art. 1, par dérogation à la loi 91-716.<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Sont soumises au taux majoré de la taxe sur la valeur ajoutée :<br/>\n<br/>   1° Les publications qui ont fait l'objet d'au moins deux des interdictions prévues par l'article 14 de la loi n° 49-956 du 16 juillet 1949 modifié (1) ;<br/>\n<br/>   2° Les opérations d'achat, d'importation, de vente, de livraison, de commission, de courtage ou de façon portant sur le caviar (2).<br/>"
  },

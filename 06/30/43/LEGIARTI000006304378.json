  "NOTA": {
    "CONTENU": "<br/>   Nota : Loi 92-655 1992-07-15 art. 1 c.<br/>\n<br/>   (1) Disposition applicable à compter du 1er janvier 1979.<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Sont soumises au taux majoré de la taxe sur la valeur ajoutée (1) les représentations théâtrales à caractère pornographique, désignées par le ministre chargé de la culture après avis d'une commission dont la composition est fixée par arrêté du même ministre. Les réclamations et recours contentieux relatifs à ces décisions sont instruits par le ministre chargé de la culture.<br/>\n<br/>"
  },

  "NOTA": {
    "CONTENU": "<br/>   NOTA : La section 01 a été modifiée par le décret 96-556.<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   I Le taux des contributions sociales mentionnées aux articles 1600-0 C et 1600-0 D est fixé à 2,40 p. 100.<br/>\n<br/>   II Le produit de ces contributions est versé à la Caisse nationale des allocations familiales pour la part correspondant à un taux de 1,1 p. 100 et au fonds de solidarité vieillesse institué par l'article L. 135-1 du code de la sécurité sociale pour la part correspondant à un taux de 1,3 p. 100.<br/>"
  },

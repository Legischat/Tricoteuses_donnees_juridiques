  "BLOC_TEXTUEL": {
    "CONTENU": "Le tarif de l'impôt est fixé à :<br/>\n  ============================================================<br/>\n<table>\n<tr>\n<td> :  Fraction de la valeur nette taxable  :       Tarif      :</td>\n</tr>\n<tr>\n<td> :             du patrimoine             :     applicable   :</td>\n</tr>\n<tr>\n<td> :---------------------------------------:------------------:</td>\n</tr>\n<tr>\n<td> :                                       :        %         :</td>\n</tr>\n<tr>\n<td> : N'excédant pas 3.600.000 F            :        0         :</td>\n</tr>\n<tr>\n<td> : Comprise entre 3.600.000 F            :                  :</td>\n</tr>\n<tr>\n<td> :  et 6.000.000 F                       :        0,5       :</td>\n</tr>\n<tr>\n<td> : Comprise entre 6.000.000 F            :                  :</td>\n</tr>\n<tr>\n<td> :  et 11.900.000 F                      :        1         :</td>\n</tr>\n<tr>\n<td> : Comprise entre 11.900.000 F et        :                  :</td>\n</tr>\n<tr>\n<td> :  20.600.000 F                         :        1,5       :</td>\n</tr>\n<tr>\n<td> : Supérieure à 20.600.000 F             :        2         :</td>\n</tr>\n</table>\n<br/>\n ============================================================"
  },

        {
          "#text": "Loi n°86-912 du 6 août 1986 RELATIVE AUX MODALITES D'APPLICATION DES PRIVATISATIONS DECIDEES PAR LA LOI 86793 DU 02-07-1986 AUTORISANT LE GOUVERNEMENT A PRENDRE DIVERSES MESURES D'ORDRE ECONOMIQUE ET SOCIAL",
          "@c_titre_court": "Loi n°86-912 du 6 août 1986",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000317767"
        },

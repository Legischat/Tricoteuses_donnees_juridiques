  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Toute personne qui effectue des prestations de services, assorties ou non de vente, en infraction aux dispositions de l'article 290 quinquies est passible d'une amende égale à 25 % du montant, toutes taxes comprises, des transactions en cause.<br/>\n<br/>"
  },

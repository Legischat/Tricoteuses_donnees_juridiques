    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Loi n°89-460 du 6 juillet 1989 TENDANT A MODIFIER JUSQU'AU 31-12-1991 LE REGIME DES SANCTIONS PREVUES PAR L'ART. 55 DE LA LOI 84148 DU 01-03-1984 RELATIVE A LA PREVENTION ET AU REGLEMENT AMIABLE DES DIFFICULTES DES ENTREPRISES",
          "@c_titre_court": "Loi n°89-460 du 6 juillet 1989",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000684311"
        },
        {
          "#text": "Loi n° 89-460 du 6 juillet 1989 tendant à modifier jusqu'au 31 décembre 1991 le régime des sanctions prévues par l'article 55 de la loi n° 84-148 du 1er mars 1984 relative à la prévention et au règlement amiable des difficultés des entreprises",
          "@c_titre_court": "Loi n° 89-460 du 6 juillet 1989",
          "@debut": "1989-07-08",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006069106"
        }
      ],

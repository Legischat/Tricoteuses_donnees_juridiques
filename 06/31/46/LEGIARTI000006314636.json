        {
          "#text": "Loi n°54-782 du 2 août 1954 DITE DU MOUSTIER RELATIVE AU TRANSFERT ET A LA DEVOLUTION DE BIENS ET D'ELEMENTS D'ACTIF DES ENTREPRISES DE PRESSE ET D'INFORMATION",
          "@c_titre_court": "Loi n°54-782 du 2 août 1954",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000503691"
        },
        {
          "#text": "Loi n° 54-782 du 2 août 1954 modifiant certaines dispositions de la loi n° 46-994 du 11 mai 1946 portant transfert et dévolution de biens et d'éléments d'actif d'entreprises de presse et d'information (1).",
          "@c_titre_court": "Loi n° 54-782 du 2 août 1954",
          "@debut": "1954-08-05",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006068134"
        }

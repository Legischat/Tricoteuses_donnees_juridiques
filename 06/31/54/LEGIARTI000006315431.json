  "NOTA": {
    "CONTENU": "<br/>  Ces dispositions s'appliquent aux procédures de contrôle engagées à compter du 1er juin 2008.<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Dans tous les cas où il n'est pas prévu un délai de prescription plus court, le droit de reprise de l'administration s'exerce jusqu'à l'expiration de la sixième année suivant celle du fait générateur de l'impôt.<br/>\n<br/>"
  },

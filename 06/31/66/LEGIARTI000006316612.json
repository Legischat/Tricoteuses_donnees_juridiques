  "NOTA": {
    "CONTENU": "<p>\n<em>Modification effectuée en conséquence de l'article 11 I de la loi n° 2007-1822 du 24 décembre 2007.<br clear=\"none\"/>\n</em>\n</p>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>En application de l'article L. 94, toute personne qui fait commerce habituel de recueillir les offres et les demandes de valeurs mobilières doit, à toute demande des agents de l'administration, représenter les bordereaux des prestataires de services d'investissement ou faire connaître les numéros et les dates des bordereaux ainsi que les noms des prestataires de services d'investissement de qui ils émanent.<br/>\n<br/>"
  },

  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   I. LE DROIT DE TIMBRE DES AFFICHES PREVU A L'ARTICLE 944-I DU CODE GENERAL DES IMPOTS EST DOUBLE. LE PRODUIT DE CETTE MAJORATION EST AFFECTE AUX BUDGETS DES COMMUNES INTERESSEES .<br/>\n<br/>   II. LES TAUX DE LA TAXE SUR LA PUBLICITE PREVUS A L'ARTICLE 207 DU CODE DE L'ADMINISTRATION COMMUNALE SONT DOUBLES .<br/>\n<br/>   LES MODIFICATIONS DE FORME CONSECUTIVES A CETTE AUGMENTATION SERON APPORTEES AU CODE DE L'ADMINISTRATION COMMUNALE PAR DECRET .<br/>"
  },

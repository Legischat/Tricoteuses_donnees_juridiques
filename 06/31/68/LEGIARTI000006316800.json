  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>    LE TAUX DE LA TAXE DONT LES EMPLOYEURS SONT REDEVABLES AU TITRE DU FINANCEMENT D'ACTIONS DE LA FORMATION PROFESSIONNELLE CONTINUE EST FIXE A 1 % DU MONTANT, ENTENDU AU SENS DE L'ARTICLE 231-I DU CODE GENERAL DES IMPOTS, DES SALAIRES PAYES PENDANT L'ANNEE EN COURS.<br/>\n<br/>"
  },

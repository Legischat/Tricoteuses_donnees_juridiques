  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   LES ENTREPRISES DE PRESSE VISEES AU I DE L'ARTICLE 39 BIS DU CODE GENERAL DES IMPOTS SONT AUTORISEES A CONSTITUER EN FRANCHISE D'IMPOTS, PAR PRELEVEMENT SUR LES RESULTATS DE L'EXERCICE 1973, UNE PROVISION POUR ACQUISITION D'ELEMENTS D'ACTIF NECESSAIRES A L'EXPLOITATION DU JOURNAL OU A DEDUIRE DE CES RESULTATS LES DEPENSES D'EQUIPEMENT EXPOSEES EN VUE DU MEME OBJET, DANS DES CONDITIONS ET LIMITES IDENTIQUES A CELLES PREVUES POUR L'EXERCICE 1972 .<br/>\n<br/>"
  },

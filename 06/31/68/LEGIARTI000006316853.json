  "BLOC_TEXTUEL": {
    "CONTENU": ". SOUS RESERVE DES DISPOSITIONS DES ARTICLES 6 A 10 ET 12 A 15, LE  PRELEVEMENT EST ETABLI ET RECOUVRE COMME EN MATIERE DE TAXES SUR LE  CHIFFRE D' AFFAIRES ET AVEC LES SANCTIONS APPLICABLES A CES TAXES .<br/>\n<br/> LES RECLAMATIONS SONT PRESENTEES, INSTRUITES ET JUGEES COMME POUR  CES IMPOTS .<br/>"
  },

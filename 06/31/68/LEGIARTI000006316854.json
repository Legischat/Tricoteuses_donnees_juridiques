  "BLOC_TEXTUEL": {
    "CONTENU": ". L' ADMINISTRATION PEUT S' ASSURER DE LA CONFORMITE MATERIELLE DE LA  DECLARATION PREVUE A L' ARTICLE 14 AVEC LES ELEMENTS DE LA  COMPTABILITE DE L' ENTREPRISE .  CELLE-CI NE PEUT SE PREVALOIR DE CE  CONTROLE POUR S' OPPOSER A UNE VERIFICATION ULTERIEURE DE SA  COMPTABILITE EN INVOQUANT LES DISPOSITIONS DE L' ARTICLE 1649  SEPTIES B DU CODE GENERAL DES IMPOTS .<br/>\n<br/>"
  },

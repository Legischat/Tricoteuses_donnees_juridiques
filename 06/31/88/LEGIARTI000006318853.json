    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret n°86-407 du 11 mars 1986 FIXANT LES SEUILS AU DELA DESQUELS LES GROUPEMENTS SPORTIFS SONT TENUS DE CONSTITUER UNE SOCIETE A OBJET SPORTIF OU UNE SOCIETE D'ECONOMIE MIXTE LOCALE",
          "@c_titre_court": "Décret n°86-407 du 11 mars 1986",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000703886"
        },
        {
          "#text": "Décret n°86-407 du 11 mars 1986 fixant les seuils au-delà desquels les groupements sportifs sont tenus de constituer une société commerciale.",
          "@c_titre_court": "Décret n°86-407 du 11 mars 1986",
          "@debut": "2000-10-22",

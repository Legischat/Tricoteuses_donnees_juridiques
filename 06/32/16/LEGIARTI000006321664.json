  "NOTA": {
    "CONTENU": "<br/>   Les Etats Législatifs annexés à la présente Loi ne sont pas reproduits, voir JO du 31 décembre 2002, pages 22092 et suivantes.<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   I. et II. - Paragraphes modificateurs.<br/>\n<br/>   III. - Les membres du Conseil de la politique monétaire en fonction à la date de publication de la présente loi exercent leur mandat jusqu'à son terme.<br/>\n<br/>   IV. - Le dividende versé par la Banque de France à l'Etat est accru à due concurrence du montant des économies résultant du I.<br/>"
  },

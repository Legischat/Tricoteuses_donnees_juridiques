  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret n°63-684 du 13 juillet 1963 CONDITIONS D'AGREMENT DES PROGRAMMES DE CONSTRUCTION ENTREPRIS PAR LES SOCIETES IMMOBILIERES D'INVESTISSEMENT ET LES SOCIETES IMMOBILIERES DE GESTION ET AUX CONDITIONS DANS LESQUELLES CES SOCIETES POURRONT RECEVOIR DES APPORTS EN NATURE OU ACQUERIR DES IMMEUBLES DEJA CONSTRUITS",
          "@c_titre_court": "Décret n°63-684 du 13 juillet 1963",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000870013"
        },
        {
          "#text": "Décret n°63-684 du 13 juillet 1963 relatif aux conditions d'agrément des programmes de construction entrepris par les sociétés immobilières d'investissement et les sociétés immobilières de gestion et aux conditions dans lesquelles ces sociétés pourront recevoir des apports en nature ou acquérir des immeubles déjà construits",
          "@c_titre_court": "Décret n°63-684 du 13 juillet 1963",
          "@debut": "1963-07-14",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006061142"
        }
      ],
      "@cid": "JORFTEXT000000870013",
      "@date_publi": "1963-07-14",
      "@date_signature": "1963-07-13",
      "@nature": "DECRET",
      "@num": "63-684"
    }
  },
  "VERSIONS": {
    "VERSION": [
      {
        "LIEN_ART": {

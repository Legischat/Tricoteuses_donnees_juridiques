      "TITRE_TXT": [
        {
          "#text": "Décret n°80-393 du 2 juin 1980 PORTANT A 500FRS LA LIMITE JUSQU'A LAQUELLE LES FOURNISSEURS SONT DISPENSES DE PRODUIRE DES MEMOIRES OU DES FACTURES",
          "@c_titre_court": "Décret n°80-393 du 2 juin 1980",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000515941"
        },
        {
          "#text": "Décret n°80-393 du 2 juin 1980 n° 80-393 du 2 juin 1980 portant à 500 f la limite jusqu'à laquelle les fournisseurs sont dispensés de produire des mémoires ou des factures",
          "@c_titre_court": "Décret n°80-393 du 2 juin 1980",
          "@debut": "1980-06-05",
          "@fin": "2999-01-01",

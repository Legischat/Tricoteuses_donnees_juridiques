      "TITRE_TXT": [
        {
          "#text": "Décret n°80-1086 du 29 décembre 1980 EXONERATIONS TOTALES OU PARTIELLES DE DROITS DE MUTATION A TITRE GRATUIT APPLICABLES AUX BIENS VISES A L'ART. 793-1 (2EME) OU 2 (1ER):ACTIONS DE SOCIETES IMMOBILIERES D'INVESTISSEMENT,IMMEUBLES DE CONSTRUCTION RECENTE PRINCIPALEMENT AFFECTES A L'HABITATION",
          "@c_titre_court": "Décret n°80-1086 du 29 décembre 1980",

      "TITRE_TXT": [
        {
          "#text": "Décret n°77-348 du 28 mars 1977 CREANT UNE TAXE PARAFISCALE COMMUNE A L'ASSOCIATION DITE COMITE PROFESSIONNEL INTERREGIONAL DE L'HORLOGERIE (CIH) ET AU CENTRE TECHNIQUE DE L'INDUSTRIE HORLOGERE (CETEHOR)",

  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret n°82-586 du 2 juillet 1982 FIXATION DES CONDITIONS ET DELAIS DANS LESQUELS DOIT ETRE FAITE LA DECLARATION DES NOMS,ADRESSES ET MONTANT DES SOMMES VERSEES EFFECTUEE PAR LES PERSONNES FAISANT DES VERSEMENTS AU TITRE DES CONTRATS DE LOUAGES D'EMPLACEMENTS PRIVES AUX FINS DE PUBLICITE",
          "@c_titre_court": "Décret n°82-586 du 2 juillet 1982",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000336749"
        },
        {
          "#text": "Décret n°82-586 du 2 juillet 1982 n° 82-586 du 2 juillet 1982 portant application de l'article 93 de la loi de finances pour 1982 (n° 81-1160 du 30 décembre 1981).",
          "@c_titre_court": "Décret n°82-586 du 2 juillet 1982",
          "@debut": "1982-07-08",
          "@fin": "2999-01-01",

      "TITRE_TXT": [
        {
          "#text": "Décret n°83-80 du 7 février 1983 EN VUE DE PERMETTRE L'EXECUTION PAR LE BUREAU NATIONAL INTERPROFESSIONNEL DE L'ARMAGNAC (BNIA) DES MISSIONS QUI LUI SONT DEVOLUES,IL EST INSTITUE A COMPTER DU 01-01-1983 ET AU PLUS TARD LE 10-02-1983 ET DANS LA LIMITE DE CERTAINS TAUX,UNE TAXE PARAFISCALE SUR LES VINS ET EAUX-DE-VIE PRODUITS DANS LA REGION DELIMITEE \"ARMAGNAC\"",
          "@c_titre_court": "Décret n°83-80 du 7 février 1983",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000508127"
        },
        {
          "#text": "Décret n°83-80 du 7 février 1983 n° 83-80 du 7 février 1983 relatif à la taxe parafiscale sur les vins et eaux-de-vie produits dans la région délimitée \"Armagnac\".",
          "@c_titre_court": "Décret n°83-80 du 7 février 1983",

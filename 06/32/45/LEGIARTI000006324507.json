      "TITRE_TXT": [
        {
          "#text": "Décret n°84-1018 du 19 novembre 1984 CREANT UNE TAXE PARAFISCALE COMMUNE AU COMITE PROFESSIONNEL DE DEVELOPPEMENT DE L'HORLOGERIE (CPDH) ET AU CENTRE TECHNIQUE DE L'INDUSTRIE HORLOGERE (CETEHOR) JUSQU'AU 31-12-1985",
          "@c_titre_court": "Décret n°84-1018 du 19 novembre 1984",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000518355"
        },
        {
          "#text": "Décret n°84-1018 du 19 novembre 1984 du 19 novembre 1984 créant une taxe parafiscale commune au comité professionnel de développement de l'horlogerie et au centre technique de l'industrie horlogère.",
          "@c_titre_court": "Décret n°84-1018 du 19 novembre 1984",

  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret n°84-1090 du 7 décembre 1984 FIXANT LES CONDITIONS ET MODALITES DE L'AGREMENT DES ETABLISSEMENTS DANS LESQUELS LES CONCERTS SONT SOUMIS AU TAUX REDUIT DE LA TAXE SUR LA VALEUR AJOUTEE (TVA) SUR UNE PARTIE DU PRIX D'ENTREE",
          "@c_titre_court": "Décret n°84-1090 du 7 décembre 1984",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000699378"
        },
        {
          "#text": "Décret n°84-1090 du 7 décembre 1984 n° 84-1090 du 7 décembre 1984 fixant les conditions et modalités de l'agrément des établissements dans lesquels les concerts sont soumis au taux réduit de la taxe sur la valeur ajoutée *TVA* sur une partie du prix d'entrée, en application de l'article 16 de la loi de finances pour 1984.",
          "@c_titre_court": "Décret n°84-1090 du 7 décembre 1984",
          "@debut": "1984-12-08",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006064320"
        }
      ],
      "@cid": "JORFTEXT000000699378",
      "@date_publi": "1984-12-08",
      "@date_signature": "1984-12-07",
      "@nature": "DECRET",
      "@num": "84-1090"
    }
  },

    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret n°85-1011 du 24 septembre 1985 CREANT SUR LES CEREALES ET LE RIZ UNE TAXE PARAFISCALE AU PROFIT DE L'ASSOCIATION NATIONALE POUR LE DEVELOPPEMENT AGRICOLE (ANDA)",
          "@c_titre_court": "Décret n°85-1011 du 24 septembre 1985",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000520038"
        },
        {
          "#text": "Décret n°85-1011 du 24 septembre 1985 n° 85-1011 du 24 septembre 1985 créant sur les céréales et le riz une taxe parafiscale au profit de l'Association nationale pour le développement agricole.",
          "@c_titre_court": "Décret n°85-1011 du 24 septembre 1985",
          "@debut": "1985-09-25",
          "@fin": "1987-12-31",
          "@id_txt": "LEGITEXT000006064667"
        }
      ],
      "@cid": "JORFTEXT000000520038",

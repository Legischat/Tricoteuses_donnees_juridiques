  "BLOC_TEXTUEL": {
    "CONTENU": "En ce qui concerne le blé tendre, l'orge et le maïs, il sera perçu par la direction générale des impôts, dans les conditions fixées à l'article 5 du décret n° 82-733 du 23 août 1982, les compléments de taxes suivantes (en francs par tonne) :<br/>\n<br/>\n ----------------------------------<br/>\n<br/>\n<table>\n<tr>\n<td> :                      :  TAXE   :</td>\n</tr>\n<tr>\n<td> : QUANTITES TOTALES    :---------:</td>\n</tr>\n<tr>\n<td> :       LIVREES        : F.A.S.C :</td>\n</tr>\n<tr>\n<td> :----------------------:---------:</td>\n</tr>\n<tr>\n<td> : Excédant 100 tonnes  :         :</td>\n</tr>\n<tr>\n<td> :                      :         :</td>\n</tr>\n<tr>\n<td> : Blé                  :  1,60   :</td>\n</tr>\n<tr>\n<td> : Orge                 :  1,60   :</td>\n</tr>\n<tr>\n<td> : Maïs                 :  1,60   :</td>\n</tr>\n<tr>\n<td> :                      :         :</td>\n</tr>\n<tr>\n<td> : Excédant 300 tonnes  :         :</td>\n</tr>\n<tr>\n<td> : Blé                  :  3,15   :</td>\n</tr>\n<tr>\n<td> : Orge                 :  3,15   :</td>\n</tr>\n<tr>\n<td> : Maïs                 :  3,15   :</td>\n</tr>\n<tr>\n<td> ----------------------------------</td>\n</tr>\n<tr>\n<td> </td>\n</tr>\n<tr>\n<td> ----------------------------------</td>\n</tr>\n<tr>\n<td> :                      :  TAXE   :</td>\n</tr>\n<tr>\n<td> : QUANTITES TOTALES    :---------:</td>\n</tr>\n<tr>\n<td> :       LIVREES        : A.N.D.A :</td>\n</tr>\n<tr>\n<td> :----------------------:---------:</td>\n</tr>\n<tr>\n<td> : Excédant 100 tonnes  :         :</td>\n</tr>\n<tr>\n<td> :                      :         :</td>\n</tr>\n<tr>\n<td> : Blé                  :  2,20   :</td>\n</tr>\n<tr>\n<td> : Orge                 :  2,20   :</td>\n</tr>\n<tr>\n<td> : Maïs                 :  2,00   :</td>\n</tr>\n<tr>\n<td> :                      :         :</td>\n</tr>\n<tr>\n<td> : Excédant 300 tonnes  :         :</td>\n</tr>\n<tr>\n<td> : Blé                  :  4,40   :</td>\n</tr>\n<tr>\n<td> : Orge                 :  4,40   :</td>\n</tr>\n<tr>\n<td> : Maïs                 :  4,00   :</td>\n</tr>\n</table>\n<br/>\n ----------------------------------"
  },

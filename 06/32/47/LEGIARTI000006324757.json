      "TITRE_TXT": [
        {
          "#text": "Décret n°85-983 du 17 septembre 1985 PRIS EN APPLICATION DE L'ART. 40 DE LA LOI 85695 DU 11-07-1985 PORTANT DIVERSES DISPOSITIONS D'ORDRE ECONOMIQUE ET FINANCIER ET RELATIF A L'AGREMENT DES OEUVRES CINEMATOGRAPHIQUES ET AUDIOVISUELLES",
          "@c_titre_court": "Décret n°85-983 du 17 septembre 1985",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000872252"
        },
        {
          "#text": "Décret n°85-983 du 17 septembre 1985 n° 85-983 du 17 septembre 1985 pris en application de l'article 40 de la loi du 11 juillet 1985 portant diverses dispositions d'ordre économique et financier et relatif à l'agrément des oeuvres cinématographiques et audiovisuelles",
          "@c_titre_court": "Décret n°85-983 du 17 septembre 1985",
          "@debut": "1985-09-18",

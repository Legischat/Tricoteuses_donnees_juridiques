      "TITRE_TXT": [
        {
          "#text": "Décret n°79-254 du 29 mars 1979 APPLICATION DE L'ARTICLE 5 DE LA LOI 7915 DU 3 JANVIER 1979. CONDITIONS D'APPLICATION DE LA REFORME DES IMPOTS LOCAUX AUX DEPARTEMENTS DE LA GUADELOUPE, GUYANE, MARTINIQUE ET REUNION",
          "@c_titre_court": "Décret n°79-254 du 29 mars 1979",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000874645"
        },
        {
          "#text": "Décret n°79-254 du 29 mars 1979 n° 79-254 du 29 mars 1979 fixant les conditions d'application aux départements de la Guadeloupe, de la Guyane, de la Martinique et de la Réunion de la réforme des impôts locaux.",
          "@c_titre_court": "Décret n°79-254 du 29 mars 1979",
          "@debut": "1979-03-30",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006063008"
        }

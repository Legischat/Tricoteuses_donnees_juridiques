        {
          "#text": "Décret n°85-1102 du 9 octobre 1985 PRIS POUR L'APPLICATION DE L'ART. 1 DE LA LOI 85695 DU 11-07-1985 RELATIF AU REGIME FISCAL DES SOCIETES DE CAPITAL-RISQUE ET DE LEURS ACTIONNAIRES",
          "@c_titre_court": "Décret n°85-1102 du 9 octobre 1985",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000323801"
        },
        {
          "#text": "Décret n°85-1102 du 9 octobre 1985 n° 85-1102 du 9 octobre 1985 pris pour l'application de l'article 1er de la loi n° 85-695 du 11 juillet 1985 relatif au régime fiscal des sociétés de capital-risque *SCR* et de leurs actionnaires",
          "@c_titre_court": "Décret n°85-1102 du 9 octobre 1985",
          "@debut": "1985-10-17",
          "@fin": "2999-01-01",

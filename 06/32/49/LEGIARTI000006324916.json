      "TITRE_TXT": [
        {
          "#text": "Décret n°84-1297 du 31 décembre 1984 INSTITUANT DES TAXES PARAFISCALES AU PROFIT DU COMITE CENTRAL DES PECHES MARITIMES,DES COMITES LOCAUX DES PECHES MARITIMES ET DE L'INSTITUT FRANCAIS DE RECHERCHE POUR L'EXPLOITATION DE LA MER (IFREMER)",
          "@c_titre_court": "Décret n°84-1297 du 31 décembre 1984",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000868584"
        },
        {
          "#text": "Décret n°84-1297 du 31 décembre 1984 n° 84-1297 du 31 décembre 1984 instituant des taxes parafiscales au profit du comité central des pêches maritimes, des comités locaux des pêches maritimes et de l'Institut français de recherche pour l'exploitation de la mer",
          "@c_titre_court": "Décret n°84-1297 du 31 décembre 1984",
          "@debut": "1985-01-12",
          "@fin": "1988-12-31",
          "@id_txt": "LEGITEXT000006064369"

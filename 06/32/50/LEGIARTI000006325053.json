      "TITRE_TXT": [
        {
          "#text": "Décret n°86-549 du 14 mars 1986 PORTANT CREATION D'UNE TAXE PARAFISCALE SUR LES HUILES DE BASE AU PROFIT DE L'AGENCE NATIONALE POUR LA RECUPERATION ET L'ELIMINATION DES DECHETS (ANRED)",
          "@c_titre_court": "Décret n°86-549 du 14 mars 1986",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000332717"
        },
        {
          "#text": "Décret n°86-549 du 14 mars 1986 n° 86-549 du 14 mars 1986 portant création d'une taxe parafiscale sur les huiles de base au profit de l'Agence nationale pour la récupération et l'élimination des déchets.",

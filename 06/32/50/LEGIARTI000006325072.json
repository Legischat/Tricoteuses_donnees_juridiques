      "TITRE_TXT": [
        {
          "#text": "Décret n°86-323 du 3 mars 1986 MODIFIANT LE DECRET 85260 DU 22-02-1985 RELATIF AUX MODALITES DE REPARTITION DES RESSOURCES DU FONDS NATIONAL DE PEREQUATION DE LA TAXE PROFESSIONNELLE (FNPTP)",
          "@c_titre_court": "Décret n°86-323 du 3 mars 1986",

      "TITRE_TXT": [
        {
          "#text": "Décret n°86-323 du 3 mars 1986 MODIFIANT LE DECRET 85260 DU 22-02-1985 RELATIF AUX MODALITES DE REPARTITION DES RESSOURCES DU FONDS NATIONAL DE PEREQUATION DE LA TAXE PROFESSIONNELLE (FNPTP)",
          "@c_titre_court": "Décret n°86-323 du 3 mars 1986",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000333425"
        },
        {
          "#text": "Décret n°86-323 du 6 mars 1986 n° 86-323 du 6 mars 1986 modifiant le décret n° 85-260 du 22 février 1985 relatif aux modalités de répartition des ressources du Fonds national de péréquation de la taxe professionnelle.",
          "@c_titre_court": "Décret n°86-323 du 6 mars 1986",

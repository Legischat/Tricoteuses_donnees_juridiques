    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret n°86-1365 du 31 décembre 1986 RELATIF A LA FIXATION DES TAUX DE BASE,APPLICABLES A COMPTER DU 01-01-1987,DE LA REDEVANCE POUR DROIT D'USAGE DES APPAREILS RECEPTEURS DE TELEVISION ET A LA SUPPRESSION DE LA REDEVANCE POUR DROIT D'USAGE DES APPAREILS D'ENREGISTREMENTS ET DE REPRODUCTION DES IMAGES ET DU SON EN TELEVISION",
          "@c_titre_court": "Décret n°86-1365 du 31 décembre 1986",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000332061"
        },
        {
          "#text": "Décret n°86-1365 du 31 décembre 1986 relatif à la fixation des taux de base, applicables à compter du 1er janvier 1987, de la redevance pour droit d'usage des appareils récepteurs de télévision et à la suppression de la redevance pour droit d'usage des appareils d'enregistrement et de reproduction des images et du son en télévision *magnétoscopes*",
          "@c_titre_court": "Décret n°86-1365 du 31 décembre 1986",
          "@debut": "1987-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006065354"
        }

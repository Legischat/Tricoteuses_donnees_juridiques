        {
          "#text": "Décret n°91-150 du 7 février 1991 PRIS POUR L'APPLICATION DU DEUXIEME ALINEA DE L'ARTICLE 1649-A DU CODE GENERAL DES IMPOTS RELATIF A L'OBLIGATION DE DECLARER LES COMPTES DETENUS A L'ETRANGER",
          "@c_titre_court": "Décret n°91-150 du 7 février 1991",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000334575"
        },
        {
          "#text": "Décret n°91-150 du 7 février 1991 pris pour l'application du deuxième alinéa de l'article 1649 A du code général des impôts relatif à l'obligation de déclarer les comptes détenus à l'étranger",
          "@c_titre_court": "Décret n°91-150 du 7 février 1991",
          "@debut": "1991-02-09",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006067585"

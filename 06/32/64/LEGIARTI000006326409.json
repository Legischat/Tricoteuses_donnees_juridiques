        {
          "#text": "Décret n°91-879 du 6 septembre 1991 PRIS POUR L'APPLICATION DE L'ART. 39 DE LA LOI DE FINANCES POUR 1991 (901168 DU 29-12-1990) RELATIF A L'INSTITUTION D'UNE PROVISION POUR EGALISATION EN MATIERE D'ASSURANCE-CREDIT",
          "@c_titre_court": "Décret n°91-879 du 6 septembre 1991",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000515151"
        },
        {
          "#text": "Décret n°91-879 du 6 septembre 1991 pris pour application de l'article 39 de la loi de finances pour 1991 (n° 90-1168 du 29 décembre 1990) relatif à l'institution d'une provision pour égalisation en matière d'assurance-crédit",
          "@c_titre_court": "Décret n°91-879 du 6 septembre 1991",
          "@debut": "1991-09-08",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006067734"
        }
      ],

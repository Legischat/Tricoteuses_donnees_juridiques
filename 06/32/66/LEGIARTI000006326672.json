      "TITRE_TXT": [
        {
          "#text": "Arrêté du 24 novembre 1980 Délimitation des zones d'application de l'exonération temporaire de taxe professionnelle et de l'amortissement exceptionnel prévus dans le cadre de la politique d'aménagement du territoire.",
          "@c_titre_court": "Arrêté du 24 novembre 1980",
          "@debut": "1980-12-07",
          "@fin": "1990-06-29",
          "@id_txt": "LEGITEXT000006069651"
        }
      ],
      "@cid": "LEGITEXT000006069651",

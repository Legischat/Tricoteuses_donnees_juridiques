  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Arrêté du 3 mai 1982 APPLICATION DE L'ART. 4 DU DECRET 80-854 DU 30-10-1980: LES ORGANISMES AU PROFIT DESQUELS SONT INSTITUEES DES TAXES PARAFISCALES DOIVENT, AVANT TOUTE PROROGATION OU MODIFICATION DE TAXES OU DE SON TAUX, FOURNIR AUX MINISTERES DE TUTELLE UN COMPTE RENDU D'ACTIVITE",
          "@c_titre_court": "Arrêté du 3 mai 1982",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000323879"
        },
        {
          "#text": "Arrêté du 3 mai 1982 Modalités d'application du décret N° 80-854 du 30 octobre 1980 relatif aux taxes parafiscales.",

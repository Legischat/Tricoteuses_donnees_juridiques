      "TITRE_TXT": [
        {
          "#text": "Arrêté du 4 mars 1983 LIEU D'IMPOSITION DES PERSONNES MORALES SOUMISES A LA TAXE ANNUELLE DE 3% INSTITUEE PAR L'ART. 4-II DE LA LOI DE FINANCES POUR 1983 (LOI 821126 DU 29-12-1982)",

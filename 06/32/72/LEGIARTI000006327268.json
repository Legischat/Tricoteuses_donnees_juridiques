  "BLOC_TEXTUEL": {
    "CONTENU": "Le montant de la majoration du tarif de la taxe intérieure de consommation sur les produits pétroliers, prévu à l'article 4 de l'ordonnance n° 83-392 du 18 mai 1983, est fixé comme suit à compter du 21 mai 1983 à zéro heure :<br/>\n<br/>\n<table>\n<tr>\n<td> :-------------------------------------------------------------:</td>\n</tr>\n<tr>\n<td> :    PRODUITS        :        INDICES        :      TAUX      :</td>\n</tr>\n<tr>\n<td> :                    :  d'identification     :   (en F/hl)    :</td>\n</tr>\n<tr>\n<td> :                    :    du tableau B       :                :</td>\n</tr>\n<tr>\n<td> :                    :   de l'article 265    :                :</td>\n</tr>\n<tr>\n<td> :                    :  du code des douanes  :                :</td>\n</tr>\n<tr>\n<td> :-------------------------------------------------------------:</td>\n</tr>\n<tr>\n<td> : Supercarburant     :         1 et 10       :       5,99     :</td>\n</tr>\n<tr>\n<td> : Essence            :    1 et 5 et 11       :       7,76     :</td>\n</tr>\n<tr>\n<td> : Gazole             :        19 et 24       :      11,16     :</td>\n</tr>\n<tr>\n<td> : Fioul [*fuel*]       :        18 et 23       :      11,16     :</td>\n</tr>\n<tr>\n<td> :  domestique        :                       :                :</td>\n</tr>\n<tr>\n<td> :-------------------------------------------------------------:</td>\n</tr>\n</table>\n<br/>"
  },

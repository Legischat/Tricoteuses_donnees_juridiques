      "TITRE_TXT": [
        {
          "#text": "Arrêté du 4 février 1985 du 4 février 1985 fixant les montants et la répartition de la taxe parafiscale perçue pour le financement des actions du secteur céréalier et montants de la taxe parafiscale de stockage du secteur céréalier pour la campagne 1984-1985",
          "@c_titre_court": "Arrêté du 4 février 1985",
          "@debut": "1985-02-07",

      "TITRE_TXT": [
        {
          "#text": "Arrêté du 15 mai 1985 du 15 mai 1985 fixant la répartition du taux du prélèvement pour frais d'assiette, de recouvrement, de dégrèvement et de non-valeurs sur le produit des taxes différentielle et spéciale sur les véhicules à moteur, droits d'enregistrement et taxe de publicité foncière transférés aux départements et à la région Corse",
          "@c_titre_court": "Arrêté du 15 mai 1985",

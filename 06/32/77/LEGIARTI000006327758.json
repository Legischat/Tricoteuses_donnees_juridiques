      "TITRE_TXT": [
        {
          "#text": "Arrêté du 24 septembre 1985 du 24 septembre 1985 fixant les montants et répartition de la taxe parafiscale perçue pour le financement des actions du secteur céréalier et montants de la taxe parafiscale de stockage du secteur céréalier, pour la campagne 1985-1986",
          "@c_titre_court": "Arrêté du 24 septembre 1985",
          "@debut": "1985-09-25",
          "@fin": "1986-09-24",
          "@id_txt": "LEGITEXT000006069920"
        }
      ],
      "@cid": "LEGITEXT000006069920",

  "BLOC_TEXTUEL": {
    "CONTENU": "<p align=\"left\">Le montant effectif de la part proportionnelle de la taxe instituée par le décret susvisé est fixé, pour chacune des sections régionales de la conchyliculture, conformément au tableau ci-après :</p>\n<br/>\n<table>\n<tbody>\n<tr>\n<td>\n<p align=\"center\"> SECTIONS REGIONALES de la conchyliculture</p>\n</td>\n<td>\n<p align=\"center\">TAXE à la superficie du terrain occupé (en francs par are)</p>\n</td>\n<td>\n<p align=\"center\">TAXE à la longueur des installations (en francs par mètre)</p>\n<p align=\"center\"> </p>\n</td>\n</tr>\n<tr>\n<td>\n<p align=\"left\"> Normandie - mer du Nord</p>\n</td>\n<td>\n<p align=\"center\"> 0,74</p>\n</td>\n<td>\n<p align=\"center\"> 0,08</p>\n</td>\n</tr>\n<tr>\n<td>\n<p align=\"left\"> Bretagne-Nord</p>\n</td>\n<td>\n<p align=\"center\"> 2,25</p>\n</td>\n<td>\n<p align=\"center\"> 0,85</p>\n</td>\n</tr>\n<tr>\n<td>\n<p align=\"left\"> Bretagne-Sud</p>\n</td>\n<td>\n<p align=\"center\"> 0,70</p>\n</td>\n<td>\n<p align=\"center\"> 0,15</p>\n</td>\n</tr>\n<tr>\n<td>\n<p align=\"left\"> Ré - Centre-Ouest</p>\n</td>\n<td>\n<p align=\"center\"> 0,01</p>\n</td>\n<td>\n<p align=\"center\"> 0,01</p>\n</td>\n</tr>\n<tr>\n<td>\n<p align=\"left\">  Marennes - Oléron</p>\n</td>\n<td>\n<p align=\"center\"> 3,40</p>\n</td>\n<td>\n<p align=\"center\"> 0,15</p>\n</td>\n</tr>\n<tr>\n<td>\n<p align=\"left\"> Arcachon - Aquitaine</p>\n</td>\n<td>\n<p align=\"center\"> 2,30</p>\n</td>\n<td>\n<p align=\"center\"> -</p>\n</td>\n</tr>\n<tr>\n<td>\n<p align=\"left\">  Méditerranée</p>\n</td>\n<td>\n<p align=\"center\"> 1,60</p>\n</td>\n<td>\n<p align=\"center\"> -</p>\n</td>\n</tr>\n</tbody>\n</table>\n<br/>\n<br/>\n<br/>\n<br/>\n<br/>\n<br/>"
  },

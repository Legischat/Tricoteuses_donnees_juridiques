  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Arrêté du 9 octobre 1987 FIXANT LE TAUX DE PRELEVEMENT PREVU A L'ART. 11 DU DECRET 87826 DU 09-10-1987 PORTANT CREATION D'UNE TAXE PARAFISCALE AU PROFIT D'UN FONDS DE SOUTIEN A L'EXPRESSION RADIOPHONIQUE",
          "@c_titre_court": "Arrêté du 9 octobre 1987",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000689827"
        },
        {
          "#text": "Arrêté du 9 octobre 1987 fixant le taux du prélèvement prévu à l'article 11 du décret n° 87-826 du 9 octobre 1987 portant création d'une taxe parafiscale au profit d'un fonds de soutien à l'expression radiophonique",
          "@c_titre_court": "Arrêté du 9 octobre 1987",
          "@debut": "1987-10-10",
          "@fin": "1992-10-01",
          "@id_txt": "LEGITEXT000006057779"
        }
      ],
      "@cid": "JORFTEXT000000689827",
      "@date_publi": "1987-10-10",
      "@date_signature": "1987-10-09",
      "@nature": "ARRETE",
      "@nor": "MCCX8798500A"
    }
  },
  "VERSIONS": {
    "VERSION": [
      {
        "LIEN_ART": {
          "@debut": "1987-10-10",

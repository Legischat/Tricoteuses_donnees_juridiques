      "TITRE_TXT": [
        {
          "#text": "Arrêté du 24 décembre 1987 FIXANT LE MONTANT DE LA TAXE PARAFISCALE SUR LES PRODUITS DE L'HORTICULTURE FLORALE,ORNEMENTALE ET DES PEPINIERES AU PROFIT DE L'ASSOCIATION NATIONALE POUR LE DEVELOPPEMENT AGRICOLE",
          "@c_titre_court": "Arrêté du 24 décembre 1987",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000321363"
        },
        {
          "#text": "Arrêté du 24 décembre 1987 fixant le montant de la taxe parafiscale sur les produits de l'horticulture florale, ornementale et des pépinières au profit de l'Association nationale pour le développement agricole *ANDA*",
          "@c_titre_court": "Arrêté du 24 décembre 1987",

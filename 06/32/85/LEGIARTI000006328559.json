  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Arrêté du 24 décembre 1987 fixant le montant de la taxe parafiscale applicable à la betterave destinée à la production de sucre et d'alcool pour la campagne 1987-1988 au profit de l'Association nationale pour le développement agricole *ANDA*",
          "@c_titre_court": "Arrêté du 24 décembre 1987",
          "@debut": "1987-12-31",
          "@fin": "1988-12-31",
          "@id_txt": "LEGITEXT000006070042"
        }
      ],
      "@cid": "LEGITEXT000006070042",
      "@date_publi": "2999-01-01",

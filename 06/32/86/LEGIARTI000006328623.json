    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Arrêté du 1 avril 1988 PRIS POUR L'APPLICATION DE L'ART. 1 DU DECRET 88255 DU 15-03-1988 MODIFIANT LES MODALITES DE REMBOURSEMENT DE LA TAXE SUR LA VALEUR AJOUTEE (TVA) AUX ASSUJETTIS ETABLIS HORS DE LA COMMUNAUTE ECONOMIQUE EUROPEENNE (CEE)",
          "@c_titre_court": "Arrêté du 1 avril 1988",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000840619"
        },
        {
          "#text": "Arrêté du 1 avril 1988 pris pour l'application de l'article 1er du décret n° 88-255 du 15 mars 1988 modifiant les modalités de remboursement de la taxe sur la valeur ajoutée aux assujettis établis hors de la Communauté économique européenne *CEE*",

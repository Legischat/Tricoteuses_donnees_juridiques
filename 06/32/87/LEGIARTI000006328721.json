          "@id_txt": "JORFTEXT000000863782"
        },
        {
          "#text": "Arrêté du 30 décembre 1988 portant application du décret n° 88-1226 du 30 décembre 1988 instituant une taxe parafiscale au profit de l'Institut français de recherche pour l'exploitation de la mer *IFREMER* et du comité interprofessionnel de la conchyliculture",
          "@c_titre_court": "Arrêté du 30 décembre 1988",
          "@debut": "1989-01-01",
          "@fin": "2999-01-01",

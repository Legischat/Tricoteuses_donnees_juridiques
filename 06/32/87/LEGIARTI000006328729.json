  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Arrêté du 31 décembre 1988 FIXANT LE TAUX DE LA TAXE PARAFISCALE SUR CERTAINS PRODUITS PETROLIERS PERCU AU PROFIT DE LA CAISSE NATIONALE DE L'ENERGIE (CNE) ET PORTANT CREATION D'UN FONDS D'AMENAGEMENT DU RESEAU DES DETAILLANTS EN CARBURANTS (FMDC)",
          "@c_titre_court": "Arrêté du 31 décembre 1988",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000688403"
        },
        {
          "#text": "Arrêté du 31 décembre 1988 fixant le taux de la taxe parafiscale sur certains produits pétroliers perçue au profit de la Caisse nationale de l'énergie et portant création d'un fonds d'aménagement du réseau des détaillants en carburants",
          "@c_titre_court": "Arrêté du 31 décembre 1988",
          "@debut": "1989-01-07",
          "@fin": "1989-12-31",
          "@id_txt": "LEGITEXT000006058707"
        }
      ],
      "@cid": "JORFTEXT000000688403",

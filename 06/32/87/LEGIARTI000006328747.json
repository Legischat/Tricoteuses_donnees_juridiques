      "TITRE_TXT": [
        {
          "#text": "Arrêté du 30 décembre 1988 FIXANT LE MONTANT DE LA TAXE PARAFISCALE SUR LES PRODUITS DE L'HORTICULTURE FLORALE ORNEMENTALE ET DES PEPINIERES AU PROFIT DE L'ASSOCIATION NATIONALE POUR LE DEVELOPPEMENT AGRICOLE",

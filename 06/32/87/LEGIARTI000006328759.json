    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Arrêté du 30 décembre 1988 FIXANT POUR LES PRODUITS ALIMENTAIRES IMPORTES,LES CONDITIONS D'APPLICATION DE LA TAXE SPECIALE SUR LES HUILES INSTITUEE PAR L'ART. 1618-QUINQUIES DU CODE GENERAL DES IMPOTS",
          "@c_titre_court": "Arrêté du 30 décembre 1988",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000476533"
        },
        {
          "#text": "Arrêté du 30 décembre 1988 fixant, pour les produits alimentaires importés, les conditions d'application de la taxe spéciale sur les huiles instituée par l'article 1618 quinquies du code général des impôts",
          "@c_titre_court": "Arrêté du 30 décembre 1988",
          "@debut": "1989-02-04",
          "@fin": "1990-01-16",

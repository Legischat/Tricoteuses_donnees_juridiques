          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000866136"
        },
        {
          "#text": "Arrêté du 8 novembre 1989 fixant le montant de la taxe parafiscale sur les graines oléagineuses et protéagineuses au profit de l'Association nationale pour le développement agricole *ANDA*",
          "@c_titre_court": "Arrêté du 8 novembre 1989",

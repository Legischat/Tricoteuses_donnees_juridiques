        {
          "#text": "Décret n°89-649 du 31 août 1989 PORTANT CREATION D'UNE TAXE PARAFISCALE SUR LES HUILES DE BASE AU PROFIT DE L'AGENCE NATIONALE POUR LA RECUPERATION ET L'ELIMINATION DES DECHETS (ANRED)",
          "@c_titre_court": "Décret n°89-649 du 31 août 1989",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000700029"
        },
        {
          "#text": "Décret n°89-649 du 31 août 1989 portant création d'une taxe parafiscale sur les huiles de base au profit de l'Agence nationale pour la récupération et l'élimination des déchets",
          "@c_titre_court": "Décret n°89-649 du 31 août 1989",
          "@debut": "1989-09-14",

  "BLOC_TEXTUEL": {
    "CONTENU": "<p>Le nombre des représentants de l'Etat au conseil d'administration ou de surveillance des sociétés mentionnées à l'article 51 de la loi du 12 avril 1996 susvisée est fixé ainsi qu'il suit :</p>\n<table>\n<tbody>\n<tr>\n<td>\n<p align=\"center\">NOM DE LA SOCIETE</p>\n</td>\n<td>\n<p align=\"center\">NOMBRE de représentants</p>\n<p align=\"center\">de l'Etat au conseil</p>\n<p align=\"center\">d'administration</p>\n<p align=\"center\">ou de surveillance</p>\n</td>\n<td>\n<p align=\"center\">REPARTITION PAR MINISTERE</p>\n</td>\n</tr>\n<tr>\n<td>\n<p>Compagnie générale de matières nucléaires (Cogéma)</p>\n<br/>\n</td>\n<td>\n<p align=\"center\">4</p>\n</td>\n<td>\n<p>Affaires étrangères.</p>\n<p>Défense.</p>\n<p>Economie.</p>\n<p>Industrie.</p>\n<br/>\n</td>\n</tr>\n<tr>\n<td>\n<p>EMC SA</p>\n</td>\n<td>\n<p align=\"center\">2</p>\n</td>\n<td>\n<p>Economie.</p>\n<p>Industrie.</p>\n<br/>\n</td>\n</tr>\n<tr>\n<td>\n<p>Société financière de gestion de fonds de garantie d'outre-mer (SOGECOM).</p>\n<br/>\n</td>\n<td>\n<p align=\"center\">2</p>\n</td>\n<td>\n<p>Economie.</p>\n<p>Outre-mer.</p>\n<br/>\n</td>\n</tr>\n<tr>\n<td>\n<p>Société financière pour favoriser l'industrialisation des régions minières (Sofirem)</p>\n</td>\n<td>\n<p align=\"center\">4</p>\n</td>\n<td>\n<p>Aménagement du territoire.</p>\n<p>Budget.</p>\n<p>Economie.</p>\n<p>Industrie.</p>\n<br/>\n</td>\n</tr>\n<tr>\n<td>\n<p>Société française du tunnel routier du Fréjus</p>\n<br/>\n</td>\n<td>\n<p align=\"center\">6</p>\n</td>\n<td>\n<p>Affaires étrangères.</p>\n<p>Budget.</p>\n<p>Collectivités territoriales.</p>\n<p>Economie.</p>\n<p>Transport (x 2).</p>\n<br/>\n</td>\n</tr>\n<tr>\n<td>\n<p>Société nationale maritime Corse-Méditerranée</p>\n<br/>\n</td>\n<td>\n<p align=\"center\">3</p>\n</td>\n<td>\n<p>Budget.</p>\n<p>Economie.</p>\n<p>Transports.</p>\n<br/>\n</td>\n</tr>\n<tr>\n<td>\n<p>OSEO SOFARIS</p>\n</td>\n<td>\n<p align=\"center\">3</p>\n</td>\n<td>\n<p>Economie.</p>\n<p>Industrie.</p>\n<p>Petites et moyennes entreprises.</p>\n<br/>\n</td>\n</tr>\n<tr>\n<td>\n<p>SNCF Participations</p>\n</td>\n<td>\n<p align=\"center\">2</p>\n</td>\n<td>\n<p>Transports (x 2).</p>\n<br/>\n</td>\n</tr>\n<tr>\n<td>\n<p>Société des participations du CEA</p>\n</td>\n<td>\n<p align=\"center\">4</p>\n</td>\n<td>\n<p>Industrie (X 2)</p>\n<p>Economie.</p>\n<p>Affaires étrangères.</p>\n<br/>\n</td>\n</tr>\n<tr>\n<td>\n<p>France 4</p>\n<br/>\n</td>\n<td>\n<p align=\"center\">3</p>\n</td>\n<td>\n<p>Premier ministre.</p>\n<p>Communication.</p>\n<p>Economie.</p>\n<br/>\n</td>\n</tr>\n<tr>\n<td>\n<p>OSEO BDPME</p>\n</td>\n<td>\n<p align=\"center\">3</p>\n</td>\n<td>\n<p>Economie (X 2).</p>\n<p>Petites et moyennes entreprises.</p>\n<br/>\n</td>\n</tr>\n<tr>\n<td>\n<p>LFB-BioMédicaments</p>\n</td>\n<td>\n<p align=\"center\">4</p>\n</td>\n<td>\n<p>Santé (X 2).</p>\n<p>Economie</p>\n<p>Recherche</p>\n<br/>\n</td>\n</tr>\n</tbody>\n</table>\n<br/>"
  },

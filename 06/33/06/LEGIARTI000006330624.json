      "TITRE_TXT": [
        {
          "#text": "Décret no 97-1030 du 13 novembre 1997 portant renouvellement de la taxe    parafiscale instituée par le décret no 92-1053 du 30 septembre 1992 portant    renouvellement d'une taxe parafiscale au profit d'un fonds de soutien à    l'expression radiophonique",
          "@c_titre_court": "Décret n°97-1030 du 13 novembre 1997",

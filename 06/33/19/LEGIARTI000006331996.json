  "BLOC_TEXTUEL": {
    "CONTENU": "<p>A compter du 1er janvier 1986, le tarif de la taxe intérieure de consommation sur les produits pétroliers et assimilés s'établit comme suit :</p>\n<br/>\n<table>\n<tbody>\n<tr>\n<td>:----------------------------:</td>\n</tr>\n<tr>\n<td>: Désignation du produit :</td>\n</tr>\n<tr>\n<td>:----------------------------:</td>\n</tr>\n<tr>\n<td>: Goudrons de houille :</td>\n</tr>\n<tr>\n<td>:----------------------------:</td>\n</tr>\n<tr>\n<td>: Unité : Taux :</td>\n</tr>\n<tr>\n<td>: de perception :(en francs):</td>\n</tr>\n<tr>\n<td>:----------------:-----------:</td>\n</tr>\n<tr>\n<td>: 100 kg net : 5,57 :</td>\n</tr>\n<tr>\n<td>:----------------------------:</td>\n</tr>\n<tr>\n<td/>\n</tr>\n<tr>\n<td>:----------------------------:</td>\n</tr>\n<tr>\n<td>: Désignation du produit :</td>\n</tr>\n<tr>\n<td>:----------------------------:</td>\n</tr>\n<tr>\n<td>: Carburéacteurs :</td>\n</tr>\n<tr>\n<td>:----------------------------:</td>\n</tr>\n<tr>\n<td>: Unité : Taux :</td>\n</tr>\n<tr>\n<td>: de perception :(en francs):</td>\n</tr>\n<tr>\n<td>:----------------:-----------:</td>\n</tr>\n<tr>\n<td>: Hectolitre : 7,22 :</td>\n</tr>\n<tr>\n<td>:----------------------------:</td>\n</tr>\n<tr>\n<td/>\n</tr>\n<tr>\n<td>:----------------------------:</td>\n</tr>\n<tr>\n<td>: Désignation du produit :</td>\n</tr>\n<tr>\n<td>:----------------------------:</td>\n</tr>\n<tr>\n<td>: Essences d'aviation :</td>\n</tr>\n<tr>\n<td>:----------------------------:</td>\n</tr>\n<tr>\n<td>: Unité : Taux :</td>\n</tr>\n<tr>\n<td>: de perception :(en francs):</td>\n</tr>\n<tr>\n<td>:----------------:-----------:</td>\n</tr>\n<tr>\n<td>: Hectolitre : 147,27 :</td>\n</tr>\n<tr>\n<td>:----------------------------:</td>\n</tr>\n<tr>\n<td/>\n</tr>\n<tr>\n<td>:----------------------------:</td>\n</tr>\n<tr>\n<td>: Désignation du produit :</td>\n</tr>\n<tr>\n<td>:----------------------------:</td>\n</tr>\n<tr>\n<td>: Pétrole lampant :</td>\n</tr>\n<tr>\n<td>:-------------------------
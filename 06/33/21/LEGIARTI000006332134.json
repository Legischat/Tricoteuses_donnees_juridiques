    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Arrêté du 18 mai 1992 FIXANT LE MONTANT DE LA TAXE PARAFISCALE SUR LES PRODUITS DE L'HORTICULTURE FLORALE,ORNEMENTALE ET DES PEPINIERES AU PROFIT DE L'ASSOCIATION NATIONALE POUR LE DEVELOPPEMENT AGRICOLE (ANDA)",
          "@c_titre_court": "Arrêté du 18 mai 1992",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000326712"
        },
        {
          "#text": "Arrêté du 18 mai 1992 fixant le montant de la taxe parafiscale sur les produits de l'horticulture florale, ornementale et des pépinières au profit de l'Association nationale pour le développement agricole *ANDA*",
          "@c_titre_court": "Arrêté du 18 mai 1992",

    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Arrêté du 21 janvier 1991 FIXANT LE MONTANT DE LA REDEVANCE A VERSER A L'OFFICE DES MIGRATIONS INTERNATIONALES (OMI) A L'OCCASION DE L'EXAMEN MEDICAL SUVI PAR LES ETRANGERS DEMANDANT UN TITRE DE SEJOUR",
          "@c_titre_court": "Arrêté du 21 janvier 1991",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000326207"
        },
        {
          "#text": "Arrêté du 21 janvier 1991 fixant le montant de la redevance à verser à l'Office des migrations internationales à l'occasion de l'examen médical subi par les étrangers demandant un titre de séjour",
          "@c_titre_court": "Arrêté du 21 janvier 1991",
          "@debut": "1991-02-09",
          "@fin": "1992-01-30",
          "@id_txt": "LEGITEXT000006059524"
        }
      ],

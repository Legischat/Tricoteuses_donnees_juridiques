      "TITRE_TXT": [
        {
          "#text": "Arrêté du 17 janvier 1992 FIXANT LE MONTANT DE LA REDEVANCE A VERSER A L'OFFICE DES MIGRATIONS INTERNATIONALES A L'OCCASION DE L'EXAMEN MEDICAL SUBI PAR LES ETRANGERS DEMANDANT UN TITRE DE SEJOUR",
          "@c_titre_court": "Arrêté du 17 janvier 1992",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000298711"
        },
        {
          "#text": "Arrêté du 17 janvier 1992 fixant le montant de la redevance à verser à l'Office des migrations internationales à l'occasion de l'examen médical subi par les étrangers demandant un titre de séjour",
          "@c_titre_court": "Arrêté du 17 janvier 1992",

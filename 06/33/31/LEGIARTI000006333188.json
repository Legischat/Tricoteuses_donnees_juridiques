  "BLOC_TEXTUEL": {
    "CONTENU": "<p>Le contingent d'exportation de rhum de la Guadeloupe de 5 350 hectolitres d'alcool pur de rhum traditionnel agricole et de 25 650 hectolitres d'alcool pur de rhum traditionnel de sucrerie produit à partir de mélasse est réparti entre les producteurs de rhum ainsi qu'il suit :</p>\n<br/>\n<table>\n<tbody>\n<tr>\n<td>\n<p align=\"center\">NOM OU RAISON SOCIALE de la distillerie </p>\n</td>\n<td>\n<p align=\"center\">CONTINGENT DE RHUM traditionnel agricole </p>\n</td>\n<td>\n<p align=\"center\">CONTINGENT DE RHUM traditionnel de sucrerie</p>\n</td>\n</tr>\n<tr>\n<td>\n<p>Distillerie Bielle, à Grand-Bourg (Marie-Galante)</p>\n</td>\n<td>\n<p align=\"center\"> 150,00 </p>\n</td>\n<td>\n<p align=\"center\"> -</p>\n</td>\n</tr>\n<tr>\n<td>\n<p>Distillerie Bologne, à Basse-Terre</p>\n</td>\n<td>\n<p align=\"center\"> 974,90 </p>\n</td>\n<td>\n<p align=\"center\"> -</p>\n</td>\n</tr>\n<tr>\n<td>\n<p>Distillerie Bellevue, au Moule</p>\n</td>\n<td>\n<p align=\"center\"> 1 420,90</p>\n</td>\n<td>\n<p align=\"center\"> -</p>\n</td>\n</tr>\n<tr>\n<td> Distillerie Espérance, à Capesterre-Belle-Eau</td>\n<td>\n<p align=\"center\"> 216,90 </p>\n</td>\n<td>\n<p align=\"center\"> -</p>\n</td>\n</tr>\n<tr>\n<td> Distillerie Montebello, à Petit-Bourg</td>\n<td>\n<p align=\"center\"> 435,10 </p>\n</td>\n<td>\n<p align=\"center\"> -</p>\n</td>\n</tr>\n<tr>\n<td>\n<p>Distillerie Poisson, à Grand-Bourg (Marie-Galante)</p>\n</td>\n<td>\n<p align=\"center\"> 191,70 </p>\n</td>\n<td>\n<p align=\"center\"> -</p>\n</td>\n</tr>\n<tr>\n<td>\n<p>Distillerie Bellevue, à Sainte-Rose</p>\n</td>\n<td>\n<p align=\"center\"> 379,20 </p>\n</td>\n<td>\n<p align=\"center\"> -</p>\n</td>\n</tr>\n<tr>\n<td> Distillerie Severin, à Sainte-Rose</td>\n<td>\n<p align=\"center\"> 287,00 </p>\n</td>\n<td>\n<p align=\"center\"> -</p>\n</td>\n</tr>\n<tr>\n<td> Distillerie de Bellevue - Marie-Galante, à Capesterre</td>\n<td>\n<p align=\"center\"> 1 294,30 </p>\n</td>\n<td>\n<p align=\"center\"> -</p>\n</td>\n</tr>\n<tr>\n<td> SA des sucreries et rhumeries de Marie-Galante, à Grand-Bourg</td>\n<td>\n<p align=\"center\"> -</p>\n</td>\n<td>\n<p align=\"center\"> 5 056,10 </p>\n</td>\n</tr>\n<tr>\n<td> Sucrerie de Gardel, au Moule</td>\n<td>\n<p align=\"center\"> -</p>\n</td>\n<td>\n<p align=\"center\"> 5 440,30 </p>\n</td>\n</tr>\n<tr>\n<td> Société industrielle de sucrerie à Bonne-Mère</td>\n<td>\n<p align=\"center\"> -</p>\n</td>\n<td>\n<p align=\"center\"> 15 153,60 </p>\n</td>\n</tr>\n</tbody>\n</table>\n<br/>\n<br/>\n<br/>\n<br/>\n<br/>\n<br/>"
  },

      "TITRE_TXT": [
        {
          "#text": "Arrêté du 16 juin 1975 Surfaces minima d'installation et coefficients d'équivalence en matière de cumuls d'exploitations ou de fonds agricoles dans les départements de France métropolitaine (application de l'art. 188-3 du Code rural)-GERS",
          "@c_titre_court": "Arrêté du 16 juin 1975",
          "@debut": "1975-09-03",
          "@fin": "1993-07-23",
          "@id_txt": "LEGITEXT000006070091"

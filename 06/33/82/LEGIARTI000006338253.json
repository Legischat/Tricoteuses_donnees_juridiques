  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>       Au [*code des communes*] livre III \"Administration et services communaux\", titre Ier \"Administration de la commune\", sont applicables :<br/>\n<br/>       Au chapitre Ier \"Biens communaux\" :<br/>\n<br/>       L'article L. 311-1 ;<br/>\n<br/>       Au chapitre II \"Dons et legs\" :<br/>\n<br/>       Les articles L. 312-1 à L. 312-5 ;<br/>\n<br/>       Les articles L. 312-8 à L. 312-10 ;<br/>\n<br/>       L'article L. 312-12 ;<br/>\n<br/>       Au chapitre III \"Adjudications publiques en matière de biens communaux\" :<br/>\n<br/>       Les articles L. 313-1 et L. 313-3 ;<br/>\n<br/>       Au chapitre IV \"Marchés\" :<br/>\n<br/>       Les articles L. 314-1 et L. 314-3 ;<br/>\n<br/>       Au chapitre V \"Travaux communaux\" :<br/>\n<br/>       Les articles L. 315-1 et L. 315-2 ;<br/>\n<br/>       Au chapitre VI \"Actions judiciaires\" :<br/>\n<br/>       Les articles L. 316-1 à L. 316-13.<br/>"
  },

      "TITRE_TXT": [
        {
          "#text": "Loi n°79-15 du 3 janvier 1979 INSTITUANT UNE DOTATION GLOBALE DE FONCTIONNEMENT VERSEE PAR L'ETAT AUX COLLECTIVITES LOCALES ET A CERTAINS DE LEURS GROUPEMENTS ET AMENAGEANT LE REGIME DES IMPOTS DIRECTS LOCAUX POUR 1979",
          "@c_titre_court": "Loi n°79-15 du 3 janvier 1979",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000886671"
        },
        {
          "#text": "Loi n° 79-15 du 3 janvier 1979 instituant une dotation globale de fonctionnement versée par l'Etat aux collectivités locales et à certains de leurs groupements et aménageant le régime des impôts directs locaux pour 1979.",
          "@c_titre_court": "Loi n° 79-15 du 3 janvier 1979",

          "@id_txt": "JORFTEXT000000687085"
        },
        {
          "#text": "Décret n°64-1183 du 27 novembre 1964 relatif au remplacement ou au remboursement des titres d'emprunts émis par l'Etat, détériorés, détruits, perdus ou volés",
          "@c_titre_court": "Décret n°64-1183 du 27 novembre 1964",

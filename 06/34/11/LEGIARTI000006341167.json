    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret n°80-282 du 22 avril 1980 FIXANT LES MODALITES DE REPARTITION ENTRE LES COMMUNES DES DEPARTEMENTS D'OUTRE-MER (DOM) DE LA QUOTE-PART QUI LEUR EST RESERVEE AU TITRE DES CONCOURS PARTICULIERS PAR L'ART. L262-5 DU CODE DES COMMUNES (ISSU DE L'ART. 12 DE LA LOI 7915 DU 03-01-1979)",
          "@c_titre_court": "Décret n°80-282 du 22 avril 1980",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000520151"
        },
        {
          "#text": "Décret n°80-282 du 22 avril 1980 fixant les modalités de répartition entre les communes des départements d'outre-mer de la quote-part qui leur est réservée au titre des concours particuliers par l'article L. 262-5 du code des communes et modifiant le code des communes.",
          "@c_titre_court": "Décret n°80-282 du 22 avril 1980",
          "@debut": "1980-04-23",
          "@fin": "1986-03-15",
          "@id_txt": "LEGITEXT000006063224"
        }

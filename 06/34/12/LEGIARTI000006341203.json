        {
          "#text": "Décret n°82-1132 du 29 décembre 1982 CONCERNANT LA LISTE DES INFORMATIONS INDISPENSABLES A COMMUNIQUER AU CONSEIL GENERAL PAR LE COMMISSAIRE DE LA REPUBLIQUE DU DEPARTEMENT",
          "@c_titre_court": "Décret n°82-1132 du 29 décembre 1982",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000334844"
        },
        {
          "#text": "Décret n°82-1132 du 29 décembre 1982 concernant la liste des informations indispensables à communiquer au conseil général par application de l'article 51 de la loi n° 82-213 du 2 mars 1982 relative aux droits et libertés des communes, des départements et des régions.",
          "@c_titre_court": "Décret n°82-1132 du 29 décembre 1982",
          "@debut": "1982-12-30",
          "@fin": "2000-04-09",
          "@id_txt": "LEGITEXT000006063661"
        }
      ],

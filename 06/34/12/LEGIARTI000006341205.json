        {
          "#text": "Décret n°83-16 du 13 janvier 1983 PORTANT ETABLISSEMENT DE LA LISTE DES PIECES JUSTIFICATIVES DES PAIEMENTS DES COMMUNES,DES DEPARTEMENTS,DES REGIONS ET DES ETABLISSEMENTS PUBLICS LOCAUX",
          "@c_titre_court": "Décret n°83-16 du 13 janvier 1983",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000877239"
        },
        {
          "#text": "Décret n° 83-16 du 13 janvier 1983 portant établissement de la liste des pièces justificatives des paiements des communes, des départements, des régions et des établissements publics locaux.",
          "@c_titre_court": "Décret n° 83-16 du 13 janvier 1983",

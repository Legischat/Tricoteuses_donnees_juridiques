        {
          "#text": "Décret n°83-787 du 6 septembre 1983 RELATIF A L'ATTRIBUTION DE LOGEMENTS A PARIS,LYON ET MARSEILLE ET DANS CERTAINES COMMUNES ISSUES D'UNE FUSION",
          "@c_titre_court": "Décret n°83-787 du 6 septembre 1983",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000858519"
        },
        {
          "#text": "Décret n°83-787 du 6 septembre 1983 pris en application de la loi n° 82-1169 du 31 décembre 1982 et relatif à l'attribution des logements à Paris, Marseille et Lyon et dans certaines communes issues d'une fusion.",
          "@c_titre_court": "Décret n°83-787 du 6 septembre 1983",
          "@debut": "1983-09-07",
          "@fin": "2000-04-09",
          "@id_txt": "LEGITEXT000006064234"
        }

    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret n°83-1122 du 22 décembre 1983 PRIS POUR L'APPLICATION DE L'ART. 95 DE LA LOI 838 DU 07-01-1983 ET RELATIVE AU CONCOURS PARTICULIER CREE AU SEIN DE LA DOTATION GENERALE DE DECENTRALISATION AU TITRE DE L'ETABLISSEMENT ET DE LA MISE EN OEUVRE DES DOCUMENTS D'URBANISME",
          "@c_titre_court": "Décret n°83-1122 du 22 décembre 1983",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000885089"
        },
        {
          "#text": "Décret n°83-1122 du 22 décembre 1983 pris pour l'application de l'article 95 de la loi n° 83-8 du 7 janvier 1983 modifiée et relatif au concours particulier créé au sein de la dotation générale de décentralisation au titre de l'établissement et de la mise en oeuvre des documents d'urbanisme.",
          "@c_titre_court": "Décret n°83-1122 du 22 décembre 1983",
          "@debut": "1983-12-24",
          "@fin": "2000-04-09",
          "@id_txt": "LEGITEXT000006064002"
        }
      ],

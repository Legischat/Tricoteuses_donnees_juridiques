  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret n°83-1124 du 23 décembre 1983 PORTANT SUR LES CONDITIONS PREALABLES AUX TRANSFERTS DE COMPETENCE EN MATIERE D'AIDE SOCIALE ET DE SANTE,PRIS EN APPLICATION DE L'ART. 93 DE LA LOI 838 DU 07-01-1983 RELATIVE A LA REPARTITION DE COMPETENCES ENTRE LES COMMUNES,LES DEPARTEMENTS,LES REGIONS ET L'ETAT",
          "@c_titre_court": "Décret n°83-1124 du 23 décembre 1983",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000334867"
        },
        {
          "#text": "Décret n°83-1124 du 23 décembre 1983 portant sur les conditions préalables aux transferts de compétences en matière d'aide sociale et de santé, pris en application de l'article 93 de la loi n° 83-8 du 7 janvier 1983 modifiée relative à la répartition de compétences entre les communes, les départements, les régions et l'Etat.",
          "@c_titre_court": "Décret n°83-1124 du 23 décembre 1983",
          "@debut": "1983-12-24",
          "@fin": "2004-10-26",
          "@id_txt": "LEGITEXT000006064004"
        }
      ],
      "@cid": "JORFTEXT000000334867",

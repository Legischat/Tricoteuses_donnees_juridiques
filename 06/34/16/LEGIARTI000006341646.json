        {
          "#text": "Décret n°84-221 du 29 mars 1984 RELATIF A LA DOTATION GENERALE DE DECENTRALISATION VERSEE AUX COMMUNES ET AUX ETABLISSEMENTS PUBLICS DE COOPERATION INTERCOMMUNALE AU TITRE DES CONTRATS D'ASSURANCE DESTINES A LES GARANTIR CONTRE LES RISQUES DECOULANT DE LA DELIVRANCE DES AUTORISATIONS D'UTILISATION DU SOL",
          "@c_titre_court": "Décret n°84-221 du 29 mars 1984",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000336081"
        },
        {
          "#text": "Décret n°84-221 du 29 mars 1984 relatif à la dotation générale de décentralisation au titre des contrats d'assurance destinés à garantir les communes contre les risques découlant de la délivrance des autorisations d'utilisation du sol.",
          "@c_titre_court": "Décret n°84-221 du 29 mars 1984",
          "@debut": "1984-03-31",
          "@fin": "2000-04-09",

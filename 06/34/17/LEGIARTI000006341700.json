      "TITRE_TXT": [
        {
          "#text": "Décret n°84-478 du 19 juin 1984 FIXANT LES CONDITIONS D'APPLICATION DE L'ART. 29 DE LA LOI 83663 DU 22-07- 1983 EN CE QUI CONCERNE LE TRANSPORT DES ELEVES ET ETUDIANTS GRAVEMENT HANDICAPES",
          "@c_titre_court": "Décret n°84-478 du 19 juin 1984",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000884988"
        },
        {
          "#text": "Décret n°84-478 du 19 juin 1984 fixant les conditions d'application de l'article 29 de la loi 663 du 22 juillet 1983 en ce qui concerne le transport des élèves et étudiants gravement handicapés.",
          "@c_titre_court": "Décret n°84-478 du 19 juin 1984",
          "@debut": "1984-06-22",
          "@fin": "2004-07-17",
          "@id_txt": "LEGITEXT000006064516"
        }
      ],

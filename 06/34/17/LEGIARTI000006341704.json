        {
          "#text": "Décret n°84-478 du 19 juin 1984 FIXANT LES CONDITIONS D'APPLICATION DE L'ART. 29 DE LA LOI 83663 DU 22-07- 1983 EN CE QUI CONCERNE LE TRANSPORT DES ELEVES ET ETUDIANTS GRAVEMENT HANDICAPES",
          "@c_titre_court": "Décret n°84-478 du 19 juin 1984",
          "@debut": "2999-01-01",

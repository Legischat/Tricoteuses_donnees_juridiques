      "TITRE_TXT": [
        {
          "#text": "Décret n°85-491 du 9 mai 1985 PRIS POUR L'APPLICATION DE L'ART. 8 DE LA LOI 83597 DU 07-07-1983 ET RELATIF AUX MODALITES DE REPRESENTATION DES COMMUNES,DES DEPARTEMENTS,DES REGIONS ET DE LEURS GROUPEMENTS AU CONSEIL D'ADMINISTRATION OU AU CONSEIL DE SURVEILLANCE DES SOCIETES D'ECONOMIE MIXTE LOCALES",
          "@c_titre_court": "Décret n°85-491 du 9 mai 1985",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000516772"
        },
        {
          "#text": "Décret n°85-491 du 9 mai 1985 relatif aux modalités de représentation des communes, des départements, des régions et de leurs groupements au conseil d'administration ou au conseil de surveillance des sociétés d'économie mixte locales.",
          "@c_titre_court": "Décret n°85-491 du 9 mai 1985",
          "@debut": "1985-05-10",

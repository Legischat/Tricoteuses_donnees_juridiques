        {
          "#text": "Décret n°87-228 du 27 mars 1987 PRIS POUR L'APPLICATION DE L'ART. L234-13 DU CODE DES COMMUNES ET RELATIF A LA DOTATION PARTICULIERE DES COMMUNES CONNAISSANT UNE FORTE FREQUENTATION TOURISTIQUE JOURNALIERE",
          "@c_titre_court": "Décret n°87-228 du 27 mars 1987",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000700160"
        },
        {
          "#text": "Décret n°87-228 du 27 mars 1987 pris pour l'application de l'article L. 234-13 du code des communes et relatif à la dotation particulière des communes connaissant une forte fréquentation touristique journalière",
          "@c_titre_court": "Décret n°87-228 du 27 mars 1987",

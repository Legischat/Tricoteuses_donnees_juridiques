  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret n°75-60 du 30 janvier 1975 RELATIF AUX PRESTATAIRES AUXQUELS PEUVENT FAIRE APPEL LES COLLECTIVITES LOCALES ET LEURS ETABLISSEMENTS PUBLICS POUR LA REALISATION DE LEURS TRAVAUX D'INGENIERIE ET D'ARCHITECTURE",
          "@c_titre_court": "Décret n°75-60 du 30 janvier 1975",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000520720"
        },
        {
          "#text": "Décret n°75-60 du 30 janvier 1975 relatif aux prestataires auxquels peuvent faire appel les collectivités locales et leurs établissements publics pour la réalisation de leurs travaux d'ingénierie et d'architecture",
          "@c_titre_court": "Décret n°75-60 du 30 janvier 1975",
          "@debut": "1975-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006062339"
        }
      ],
      "@cid": "JORFTEXT000000520720",
      "@date_publi": "1975-02-02",
      "@date_signature": "1975-01-30",
      "@nature": "DECRET",
      "@num": "75-60"
    }
  },

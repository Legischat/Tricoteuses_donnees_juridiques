    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Arrêté du 23 novembre 1984 FIXANT LA MOYENNE NATIONALE DE PARTICIPATION DES COMMUNES AUX DEPENSES LEGALES D'AIDE SOCIALE ET DE SANTE DES DEPARTEMENTS: 15,3% AU TITRE DE L'EXERCICE 1985",
          "@c_titre_court": "Arrêté du 23 novembre 1984",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000494010"
        },
        {
          "#text": "Arrêté du 23 novembre 1984 relatif à la moyenne nationale de participation des communes aux dépenses légales d'aide sociale et de santé des départements",
          "@c_titre_court": "Arrêté du 23 novembre 1984",

      "TITRE_TXT": [
        {
          "#text": "Arrêté du 31 décembre 1986 PRIS POUR L'APPLICATION AU TITRE DE L'EXERCICE 1986 DE L'ART. 95 DE LA LOI 838 DU 07-01-1983 RELATIVE A LA REPARTITION DE COMPETENCES ENTRE LES COMMUNES,DEPARTEMENTS,REGIONS ET L'ETAT",
          "@c_titre_court": "Arrêté du 31 décembre 1986",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000500479"
        },
        {
          "#text": "Arrêté du 31 décembre 1986 pris pour l'application au titre de l'exercice 1986 de l'article 95 de la loi n° 83-8 du 7 janvier 1983 relative à la répartition de compétences entre les communes, les départements, les régions et l'Etat",
          "@c_titre_court": "Arrêté du 31 décembre 1986",
          "@debut": "1987-02-19",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006057286"
        }
      ],
      "@cid": "JORFTEXT000000500479",

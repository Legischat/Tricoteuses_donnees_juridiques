  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Le nombre des membres du conseil municipal est fixé conformément au tableau ci-après :<br/>\n<br/>   Communes, nombre des membres du conseil municipal.<br/>\n<br/>   de moins de 100 habitants, 9.<br/>\n<br/>   de 100 à 499 habitants, 11.<br/>\n<br/>   de 500 à 1499 habitants, 15.<br/>\n<br/>   de 1500 à 2499 habitants, 19.<br/>\n<br/>   de 2500 à 3499 habitants, 23.<br/>\n<br/>   de 3500 à 4999 habitants, 27.<br/>\n<br/>   de 5000 à 9999 habitants, 29.<br/>\n<br/>   de 10000 à 19999 habitants, 33.<br/>\n<br/>   de 20000 à 29999 habitants, 35.<br/>\n<br/>   de 30000 à 39999 habitants, 39.<br/>\n<br/>   de 40000 à 49999 habitants, 43.<br/>\n<br/>   de 50000 à 59999 habitants, 45.<br/>\n<br/>   de 60000 à 79999 habitants, 49.<br/>\n<br/>   de 80000 à 99999 habitants, 53.<br/>\n<br/>   de 100000 à 149999 habitants, 55.<br/>\n<br/>   de 150000 à 199999 habitants, 59.<br/>\n<br/>   de 200000 à 249999 habitants, 61.<br/>\n<br/>   de 250000 à 299999 habitants, 65.<br/>\n<br/>   de 300000 habitants et au-dessus, 69.<br/>"
  },

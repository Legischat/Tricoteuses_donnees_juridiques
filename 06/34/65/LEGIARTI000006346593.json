  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>       Il ne peut être institué aucune foire, ni aucun marché, même de simple approvisionnement, sur un emplacement compris, en tout ou partie, dans les emprises d'une route nationale classée comme route à grande circulation.<br/>\n<br/>"
  },

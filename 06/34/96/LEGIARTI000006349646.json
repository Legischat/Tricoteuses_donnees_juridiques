  "NOTA": {
    "CONTENU": "<br/>\n<br/>Voir les décrets : <br/>\n<br/>N° 77-185 du 1er mars 1977 relatif aux règles de nomination aux emplois de secrétaire général, secrétaire général adjoint, directeur général et directeur de la commune de Paris ; <br/>\n<br/>N° 77-186 du 1er mars 1977 relatif aux règles de nomination aux emplois d'ingénieur général de la commune de Paris ; <br/>\n<br/>N° 77-187 du 1er mars 1977 relatif aux conditions d'accès dans les emplois de sous-directeur de la commune de Paris.<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Un décret en conseil d'Etat détermine les conditions de nomination aux emplois de secrétaire général, secrétaire général adjoint, directeur général, directeur, sous-directeur et d'ingénieur général.<br/>\n<br/>"
  },

  "NOTA": {
    "CONTENU": "Décret 88-199 1988-02-29 article 1 : Les termes \"commissaire de la République\" et \"commissaire adjoint de la République\" sont remplacés par les termes \"préfet\" et \"sous-préfet\".<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les dispositions du présent décret ne sont applicables ni aux organismes ou missions à caractère juridictionnel, ni aux organismes chargés d'une mission de contrôle des comptes, ni aux services relevant du garde des sceaux, ministre de la justice, sous réserve des attributions dévolues au préfet pour les investissements et la comptabilité publique et des dispositions des articles 24-1 et 24-2..<br/>\n<br/>"
  },

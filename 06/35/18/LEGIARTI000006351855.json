  "NOTA": {
    "CONTENU": "Décret 88-199 1988-02-29 article 1 : Les termes \"commissaire de la République\" et \"commissaire adjoint de la République\" sont remplacés par les termes \"préfet\" et \"sous-préfet\".<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Le schéma départemental des implantations de l'Etat est transmis au préfet de région, aux ministres concernés et à la commission interministérielle de la politique immobilière de l'Etat prévue à l'article 18 du décret n° 92-604 du 1er juillet 1992 portant charte de la déconcentration.<br/>\n<br/>"
  },

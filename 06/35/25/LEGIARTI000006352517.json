        {
          "#text": "Décret n°73-172 du 21 février 1973 DETERMINANT LES SERVICES COMMUNS QUI DONNENT LIEU A UNE CONTRIBUTION DES DEPARTEMENTS DES HAUTS-DE-SEINE, DE LA SEINE-SAINT-DENIS ET DU VAL-DE-MARNE VERSEE A LA VILLE DE PARIS",
          "@c_titre_court": "Décret n°73-172 du 21 février 1973",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000875719"
        },
        {
          "#text": "Décret n°73-172 du 21 février 1973 déterminant les services communs qui donnent lieu à une contribution des départements des Hauts-de-Seine, de la Seine-Saint-Denis et du Val-de-Marne versée à la ville de Paris",
          "@c_titre_court": "Décret n°73-172 du 21 février 1973",
          "@debut": "1973-01-01",
          "@fin": "2000-04-09",
          "@id_txt": "LEGITEXT000006062049"

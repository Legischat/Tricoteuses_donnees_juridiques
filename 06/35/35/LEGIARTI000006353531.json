        "TM": {
          "TITRE_TM": [
            {
              "#text": "LIVRE I : ELECTION DES DEPUTES, DES CONSEILLERS GENERAUX ET DES CONSEILLERS MUNICIPAUX DES DEPARTEMENTS",
              "@debut": "1964-10-28",
              "@fin": "2009-01-15",
              "@id": "LEGISCTA000006115455"
            },
            {
              "#text": "Livre Ier : Election des députés, des conseillers généraux et des conseillers municipaux",
              "@debut": "2009-01-15",
              "@fin": "2014-03-23",
              "@id": "LEGISCTA000020103140"
            },
            {
              "#text": "Livre Ier : Election des députés, des conseillers départementaux, des conseillers municipaux et des conseillers communautaires",
              "@debut": "2014-03-23",
              "@fin": "2020-03-01",
              "@id": "LEGISCTA000027433908"
            },
            {
              "#text": "Livre Ier : Election des députés,   des conseillers départementaux, des conseillers métropolitains de Lyon, des conseillers municipaux et des conseillers communautaires",
              "@debut": "2020-03-01",
              "@fin": "2999-01-01",
              "@id": "LEGISCTA000029930685"
            }
          ],
          "TM": {
            "TITRE_TM": [
              {
                "#text": "Titre IV : Dispositions spéciales à l'élection des conseillers municipaux et des membres du Conseil de Paris",
                "@debut": "1964-10-28",
                "@fin": "2999-01-01",
                "@id": "LEGISCTA000006134756"
              }
            ],
            "TM": {
              "TITRE_TM": [
                {
                  "#text": "Chapitre Ier : Dispositions applicables à toutes les communes",
                  "@debut": "1964-10-28",
                  "@fin": "2999-01-01",
                  "@id": "LEGISCTA000006148486"
                }
              ],
              "TM": {
                "TITRE_TM": [
                  {
                    "#text": "Section 1 bis : Dispositions spéciales à l'exercice par les ressortissants d'un Etat membre de l'Union européenne autre que la France du droit de vote pour l'élection des conseillers municipaux et des membres du Conseil de Paris",
                    "@debut": "1998-05-26",
                    "@fin": "2999-01-01",
                    "@id": "LEGISCTA000006164063"
                  }
                ]
              }
            }
          }
        }

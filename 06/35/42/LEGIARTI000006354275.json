  "BLOC_TEXTUEL": {
    "CONTENU": "<p>   Pour l'application du présent code à Saint-Pierre-et-Miquelon, il y a lieu de lire :</p>\n<br/>\n<p>   1° \" collectivité territoriale \" au lieu de : \" département \" ;</p>\n<br/>\n<p>   2° \" représentant de l'Etat \" et \" services du représentant de l'Etat \" au lieu respectivement de : \" préfet \" et \" préfecture \".</p>\n<br/>"

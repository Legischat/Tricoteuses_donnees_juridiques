  "BLOC_TEXTUEL": {
    "CONTENU": "<div>\n<table>\n<tbody>\n<tr>\n<td width=\"216\">\n<br/>\n<p align=\"center\">DESIGNATION DES SECTEURS</p>\n</td>\n<td width=\"216\">\n<br/>\n<p align=\"center\">ARRONDISSEMENT <br/> constituant les secteurs</p>\n</td>\n<td width=\"217\">\n<br/>\n<p align=\"center\">NOMBRE DE SIEGES</p>\n</td>\n</tr>\n<tr>\n<td width=\"216\">\n<p>1er secteur</p>\n</td>\n<td width=\"216\">\n<p align=\"center\">1er</p>\n</td>\n<td width=\"217\">\n<p align=\"center\">4</p>\n</td>\n</tr>\n<tr>\n<td width=\"216\">\n<p>2e secteur</p>\n</td>\n<td width=\"216\">\n<p align=\"center\">2e</p>\n</td>\n<td width=\"217\">\n<p align=\"center\">5</p>\n</td>\n</tr>\n<tr>\n<td width=\"216\">\n<p>3e secteur</p>\n</td>\n<td width=\"216\">\n<p align=\"center\">3e</p>\n</td>\n<td width=\"217\">\n<p align=\"center\">12</p>\n</td>\n</tr>\n<tr>\n<td width=\"216\">\n<p>4e secteur</p>\n</td>\n<td width=\"216\">\n<p align=\"center\">4e</p>\n</td>\n<td width=\"217\">\n<p align=\"center\">5</p>\n</td>\n</tr>\n<tr>\n<td width=\"216\">\n<p>5e secteur</p>\n</td>\n<td width=\"216\">\n<p align=\"center\">5e</p>\n</td>\n<td width=\"217\">\n<p align=\"center\">8</p>\n</td>\n</tr>\n<tr>\n<td width=\"216\">\n<p>6e secteur</p>\n</td>\n<td width=\"216\">\n<p align=\"center\">6e</p>\n</td>\n<td width=\"217\">\n<p align=\"center\">9</p>\n</td>\n</tr>\n<tr>\n<td width=\"216\">\n<p>7e secteur</p>\n</td>\n<td width=\"216\">\n<p align=\"center\">7e</p>\n</td>\n<td width=\"217\">\n<p align=\"center\">9</p>\n</td>\n</tr>\n<tr>\n<td width=\"216\">\n<p>8e secteur</p>\n</td>\n<td width=\"216\">\n<p align=\"center\">8e</p>\n</td>\n<td width=\"217\">\n<p align=\"center\">12</p>\n</td>\n</tr>\n<tr>\n<td width=\"216\">\n<p>9e secteur</p>\n</td>\n<td width=\"216\">\n<p align=\"center\">9e</p>\n</td>\n<td width=\"217\">\n<p align=\"center\">9</p>\n</td>\n</tr>\n<tr>\n<td width=\"216\">\n<p>Total</p>\n</td>\n<td width=\"216\">\n<p align=\"center\"> </p>\n<br/>\n</td>\n<td width=\"217\">\n<p align=\"center\">73</p>\n</td>\n</
  "BLOC_TEXTUEL": {
    "CONTENU": "<div>\n<table>\n<tbody>\n<tr>\n<td width=\"216\">\n<br/>\n<p align=\"center\">DESIGNATION DES SECTEURS</p>\n</td>\n<td width=\"216\">\n<br/>\n<p align=\"center\">ARRONDISSEMENT <br/> constituant les secteurs</p>\n</td>\n<td width=\"217\">\n<br/>\n<p align=\"center\">NOMBRE DE SIEGES</p>\n</td>\n</tr>\n<tr>\n<td width=\"216\">\n<p>1er secteur</p>\n</td>\n<td width=\"216\">\n<p align=\"center\">1er, 7e</p>\n</td>\n<td width=\"217\">\n<p align=\"center\">11</p>\n</td>\n</tr>\n<tr>\n<td width=\"216\">\n<p>2e secteur</p>\n</td>\n<td width=\"216\">\n<p align=\"center\">2e, 3e</p>\n</td>\n<td width=\"217\">\n<p align=\"center\">8</p>\n</td>\n</tr>\n<tr>\n<td width=\"216\">\n<p>3e secteur</p>\n</td>\n<td width=\"216\">\n<p align=\"center\">4e, 5e</p>\n</td>\n<td width=\"217\">\n<p align=\"center\">11</p>\n</td>\n</tr>\n<tr>\n<td width=\"216\">\n<p>4e secteur</p>\n</td>\n<td width=\"216\">\n<p align=\"center\">6e, 8e</p>\n</td>\n<td width=\"217\">\n<p align=\"center\">15</p>\n</td>\n</tr>\n<tr>\n<td width=\"216\">\n<p>5e secteur</p>\n</td>\n<td width=\"216\">\n<p align=\"center\">9e, 10e</p>\n</td>\n<td width=\"217\">\n<p align=\"center\">15</p>\n</td>\n</tr>\n<tr>\n<td width=\"216\">\n<p>6e secteur</p>\n</td>\n<td width=\"216\">\n<p align=\"center\">11e, 12e</p>\n</td>\n<td width=\"217\">\n<p align=\"center\">13</p>\n</td>\n</tr>\n<tr>\n<td width=\"216\">\n<p>7e secteur</p>\n</td>\n<td width=\"216\">\n<p align=\"center\">13e, 14e</p>\n</td>\n<td width=\"217\">\n<p align=\"center\">16</p>\n</td>\n</tr>\n<tr>\n<td width=\"216\">\n<p>8e secteur</p>\n</td>\n<td width=\"216\">\n<p align=\"center\">15e, 16e</p>\n</td>\n<td width=\"217\">\n<p align=\"center\">12</p>\n</td>\n</tr>\n<tr>\n<td width=\"216\">\n<p>Total</p>\n</td>\n<td width=\"216\">\n<p align=\"center\"> </p>\n<br/>\n</td>\n<td width=\"217\">\n<p align=\"center\">101</p>\n</td>\n</tr>\n</tbody>\n</table>\n</div>"

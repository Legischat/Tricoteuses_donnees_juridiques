  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>Pour l'application de l'article R. 39-1 : <br/>\n<br/>1° La référence au 2 bis de l'article 200 du code général des impôts est remplacée par la référence aux dispositions correspondantes applicables localement ; <br/>\n<br/>2° La somme de 3 000 euros est remplacée par la somme de 363 636 F CFP.<br/>"
  },

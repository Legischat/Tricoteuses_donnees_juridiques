      "TITRE_TXT": [
        {
          "#text": "Décret n°80-935 du 26 novembre 1980 FIXANT LES MODALITES D'APPLICATION DE LA LOI 80-834 DU 24-10-1980 CREANT UNE DISTRIBUTION D'ACTIONS EN FAVEUR DES SALARIES DES ENTREPRISES INDUSTRIELLES ET COMMERCIALES",
          "@c_titre_court": "Décret n°80-935 du 26 novembre 1980",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000507379"
        },
        {
          "#text": "Décret n°80-935 du 26 novembre 1980 fixant les modalités d'application de la loi n° 80-834 du 24 octobre 1980 créant une distribution d'actions en faveur des salariés des entreprises industrielles et commerciales",
          "@c_titre_court": "Décret n°80-935 du 26 novembre 1980",
          "@debut": "1980-11-27",

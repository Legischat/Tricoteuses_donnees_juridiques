  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   La Cour est composée comme suit :<br/>\n<br/>   - le premier président de la Cour des comptes, président ;<br/>\n<br/>   - le président de la section des finances du Conseil d'Etat, vice-président ;<br/>\n<br/>   - deux conseillers d'Etat ;<br/>\n<br/>   - deux conseillers maîtres à la Cour des comptes.<br/>\n<br/>   La présidence de la Cour est assurée par son vice-président en cas d'absence ou d'empêchement de son président.<br/>\n<br/>   Elle siège à la Cour des comptes.<br/>"
  },

        {
          "#text": "Décret n°82-321 du 6 avril 1982 FIXANT LES CONDITIONS DE NOMINATION DES MEMBRES DES CONSEILS D'ADMINISTRATION DES BANQUES ET COMPAGNIES FINANCIERES NATIONALISEES",
          "@c_titre_court": "Décret n°82-321 du 6 avril 1982",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000335579"
        },
        {
          "#text": "Décret n°82-321 du 6 avril 1982 fixant, pour l'application de la loi de nationalisation du 11 février 1982, les conditions de nomination des membres des conseils d'administration des banques et compagnies financières nationalisées",
          "@c_titre_court": "Décret n°82-321 du 6 avril 1982",
          "@debut": "1982-04-10",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006063746"
        }
      ],

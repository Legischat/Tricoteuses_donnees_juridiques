  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret n°85-838 du 6 août 1985 DETERMINANT LES MODALITES DE MISE EN OEUVRE DES DISPOSITIONS TRANSITOIRES POUR L'APPLICATION DE LA SECTION 2 DU TITRE II (ART. 2 A 27) DE LA LOI 83663 DU 22-07-1983 MODIFIEE CONCERNANT LES OPERATIONS EN COURS,CONFORMEMENT A L'ART. 21 DE LA LOI 8597 DU 25-01-1985",
          "@c_titre_court": "Décret n°85-838 du 6 août 1985",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000682294"
        },
        {
          "#text": "Décret n°85-838 du 6 août 1985 déterminant les modalités de mise en oeuvre des dispositions transitoires pour l'application de la section 2 du titre II de la loi n° 83-663 du 22 juillet 1983 modifiée concernant les opérations en cours, conformément à l'article 21 de la loi n° 85-97 du 25 janvier 1985.",
          "@c_titre_court": "Décret n°85-838 du 6 août 1985",
          "@debut": "1985-08-08",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006065105"
        }
      ],
      "@cid": "JORFTEXT000000682294",
      "@date_publi": "1985-08-08",
      "@date_signature": "1985-08-06",
      "@nature": "DECRET",
      "@num": "85-838"
    }
  },

  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret n°86-429 du 14 mars 1986 FIXANT EN APPLICATION DES ART. 12-1 ET 53-1 DE LA LOI 82213 DU 02-03-1982 MODIFIEE,LE SEUIL AU-DELA DUQUEL LES INTERETS MORATOIRES RESTES DUS PAR LES COLLECTIVITES LOCALES SERONT MANDATES D'OFFICE",
          "@c_titre_court": "Décret n°86-429 du 14 mars 1986",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000522135"
        },
        {
          "#text": "Décret n°86-429 du 14 mars 1986 fixant, en application des articles 12-1 et 53-1 de la loi n° 82-213 du 2 mars 1982 modifiée, le seuil au-delà duquel les intérêts moratoires restés dus par les collectivités locales sont mandatés d'office",
          "@c_titre_court": "Décret n°86-429 du 14 mars 1986",
          "@debut": "1986-03-15",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006065523"
        }

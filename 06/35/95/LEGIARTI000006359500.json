  "NOTA": {
    "CONTENU": "Décret 91-814 1991-08-25 art. 11<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les trésoriers-payeurs généraux communiquent au ministère public près la chambre régionale des comptes les opérations présumées constitutives de gestion de fait concernant les communes, les groupements de communes et les établissements publics dont les comptes font l'objet d'un apurement administratif.<br/>\n<br/>"
  },

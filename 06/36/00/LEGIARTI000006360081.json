      "TITRE_TXT": [
        {
          "#text": "Décret n°85-1298 du 4 décembre 1985 FIXANT LES CONDITIONS DANS LESQUELLES LES ETABLISSEMENTS PUBLICS A CARACTERE SCIENTIFIQUE,CULTUREL ET PROFESSIONNEL (EPCSCP) PEUVENT PRENDRE DES PARTICIPATIONS ET CREER DES FILIALES",
          "@c_titre_court": "Décret n°85-1298 du 4 décembre 1985",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000507694"
        },
        {
          "#text": "Décret n°85-1298 du 4 décembre 1985 fixant les conditions dans lesquelles les établissements publics à caractère scientifique, culturel et professionnel peuvent prendre des participations et créer des filiales",
          "@c_titre_court": "Décret n°85-1298 du 4 décembre 1985",

        }
      ],
      "TM": {
        "TITRE_TM": [
          {
            "#text": "§ I. - Dispositions communes au caissier général, aux comptables préposés de la Caisse des dépôts et consignations et à l'agent comptable chargé de la conservation de valeurs.",
            "@debut": "1970-08-13",
            "@fin": "2000-04-16",

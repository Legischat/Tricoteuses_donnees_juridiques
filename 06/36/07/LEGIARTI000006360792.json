      "TITRE_TXT": [
        {
          "#text": "Arrêté du 31 décembre 1985 pris pour l'application de l'article 95 de la loi n° 83-8 du 7 janvier 1983 modifiée, relative à la répartition de compétences entre les communes, les départements, les régions et l'Etat.",
          "@c_titre_court": "Arrêté du 31 décembre 1985",
          "@debut": "1986-01-17",

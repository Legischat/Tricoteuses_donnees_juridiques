      "TITRE_TXT": [
        {
          "#text": "Arrêté du 17 juin 1987 FIXANT LA COMPENSATION A VERSER AUX DEPARTEMENTS EN CONTREPARTIE DE LA SUPPRESSION PAR LA LOI DU 11-07-1985 DE LA TAXE SPECIALE SUR LES VOITURES PARTICULIERES DE PLUS DE 16CV",
          "@c_titre_court": "Arrêté du 17 juin 1987",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000471700"
        },
        {
          "#text": "Arrêté du 17 juin 1987 fixant la compensation à verser aux départements en contrepartie de la suppression par la loi du 11 juillet 1985 de la taxe spéciale sur les voitures particulières de plus de 16 CV",
          "@c_titre_court": "Arrêté du 17 juin 1987",

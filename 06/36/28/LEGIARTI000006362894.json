  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>Les grandes écoles militaires mentionnées à l'article L. 8 sont celles destinées au recrutement des officiers de carrière et dont l'énumération suit : <br/>\n<br/>Ecole polytechnique ; <br/>\n<br/>Ecole spéciale militaire de Saint-Cyr ; <br/>\n<br/>Ecole du service de santé militaire ; <br/>\n<br/>Ecole navale ; <br/>\n<br/>Ecole du service de santé de la marine ; <br/>\n<br/>Ecole du commissariat de la marine ; <br/>\n<br/>Ecole d'administration de l'inscription maritime ; <br/>\n<br/>Ecole des élèves ingénieurs mécaniciens ; <br/>\n<br/>Ecole de l'air ; <br/>\n<br/>Ecole du commissariat de l'air.<br/>"
  },

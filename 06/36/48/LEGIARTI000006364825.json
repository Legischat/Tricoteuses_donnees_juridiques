        {
          "#text": "Décret n°82-390 du 10 mai 1982 RELATIF AUX POUVOIRS DES COMMISSAIRES DE LA REPUBLIQUE DE REGION,A L'ACTION DES SERVICES ET ORGANISMES PUBLICS DE L'ETAT DANS LA REGION ET AUX DECISIONS DE L'ETAT EN MATIERE D'INVESTISSEMENT PUBLIC",
          "@c_titre_court": "Décret n°82-390 du 10 mai 1982",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000698706"
        },
        {
          "#text": "Décret n°82-390 du 10 mai 1982 relatif aux pouvoirs des préfets de région, à l'action des services et organismes publics de l'Etat dans la région et aux décisions de l'Etat en matière d'investissement public.",
          "@c_titre_court": "Décret n°82-390 du 10 mai 1982",
          "@debut": "1982-05-11",
          "@fin": "2004-04-30",
          "@id_txt": "LEGITEXT000006063762"
        }
      ],

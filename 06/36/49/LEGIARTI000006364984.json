      "TITRE_TXT": [
        {
          "#text": "Décret n°82-807 du 22 septembre 1982 RELATIF A LA PRIME REGIONALE A L'EMPLOI. ELLE PEUT ETRE ACCORDEE PAR LES REGIONS ET EST DESTINEE A ENCOURAGER LA CREATION OU LE MAINTIEN D'ACTIVITES ECONOMIQUES. ELLE A LE CARACTERE DE SUBVENTION D'EQUIPEMENT",

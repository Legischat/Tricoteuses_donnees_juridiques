  "NOTA": {
    "CONTENU": "Décret 91-814 1991-08-25 art. 11<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Peuvent être inscrits au tableau d'avancement :<br/>\n<br/>   1° Pour l'accès au grade de président de section, les conseillers hors classe ayant atteint au moins le 4° échelon ;<br/>\n<br/>   2° Pour l'accès au grade de conseiller hors classe, les conseillers de 1re classe ayant atteint au moins le 2° échelon ;<br/>\n<br/>   3° Pour l'accès au grade de conseiller de 1re classe, les conseillers de 2° classe ayant atteint au moins le 6° échelon.<br/>\n<br/>   Les intéressés doivent en outre justifier de deux années de service effectif dans le corps.<br/>"
  },

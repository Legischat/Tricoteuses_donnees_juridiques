          "@id_txt": "JORFTEXT000000884728"
        },
        {
          "#text": "Décret n°82-970 du 16 novembre 1982 pris pour l'application de la loi n° 82-595 du 10 juillet 1982 relative aux présidents des chambres régionales des comptes et au statut des membres des chambres régionales des comptes.",
          "@c_titre_court": "Décret n°82-970 du 16 novembre 1982",
          "@debut": "1982-11-18",
          "@fin": "2000-04-16",
          "@id_txt": "LEGITEXT000006063959"
        }
      ],
      "TM": {
        "TITRE_TM": [
          {
            "#text": "Désignation des membres du conseil supérieur des chambres régionales des comptes et des membres élus de la commission prévue à l'article 16 de la loi n° 82-595 du 10 juillet 1982.",

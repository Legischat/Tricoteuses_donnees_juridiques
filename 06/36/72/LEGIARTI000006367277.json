      "TITRE_TXT": [
        {
          "#text": "Loi n°85-1098 du 11 octobre 1985 RELATIVE A LA PRISE EN CHARGE PAR L'ETAT,LES DEPARTEMENTS ET LES REGIONS DES DEPENSES DE PERSONNEL,DE FONCTIONNEMENT ET D'EQUIPEMENT DES SERVICES PLACES SOUS LEUR AUTORITE",
          "@c_titre_court": "Loi n°85-1098 du 11 octobre 1985",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000317283"
        },
        {
          "#text": "Loi n° 85-1098 du 11 octobre 1985 relative à la prise en charge par l'Etat, les départements et les régions des dépenses de personnel, de fonctionnement et d'équipement des services placés sous leur autorité.",
          "@c_titre_court": "Loi n° 85-1098 du 11 octobre 1985",

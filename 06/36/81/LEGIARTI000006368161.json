      "TITRE_TXT": [
        {
          "#text": "Décret n°51-1445 du 12 décembre 1951 INSTITUANT UN REGIME DE RETRAITES COMPLEMENTAIRE DES ASSURANCES SOCIALES POUR CERTAINES CATEGORIES D'AGENT DE L'ETAT NON TITULAIRES",
          "@c_titre_court": "Décret n°51-1445 du 12 décembre 1951",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000691041"
        },
        {
          "#text": "Décret n°51-1445 du 12 décembre 1951 instituant un régime de retraites complémentaire des assurances sociales pour certaines catégories d'agents de l'Etat non titulaires.",
          "@c_titre_court": "Décret n°51-1445 du 12 décembre 1951",

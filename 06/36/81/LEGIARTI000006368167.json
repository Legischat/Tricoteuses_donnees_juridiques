          "@id_txt": "JORFTEXT000000486546"
        },
        {
          "#text": "Décret n°59-1569 du 31 décembre 1959 portant création d'un régime de retraites complémentaire des assurances sociales pour certaines catégories d'agents de l'Etat non titulaires.",
          "@c_titre_court": "Décret n°59-1569 du 31 décembre 1959",

  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>       Le droit à pension est acquis :<br/>\n<br/>       1° Aux agents après quinze années accomplies de services civils et militaires effectifs ;<br/>\n<br/>       2° Sans condition de durée de services aux agents rayés des cadres pour invalidité résultant ou non de l'exercice des fonctions.<br/>"
  },

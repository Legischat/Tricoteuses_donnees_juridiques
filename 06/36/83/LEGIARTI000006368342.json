      "TITRE_TXT": [
        {
          "#text": "Décret n°47-1846 du 19 septembre 1947 PORTANT REGLEMENT D'ADMINISTRATION PUBLIQUE POUR LA CONSTITUTION DE LA CAISSE NATIONALE DE RETRAITES DES AGENTS ET EMPLOYES DES COLLECTIVITES, LOCALES, PREVUE A L'ART. 3 DE L'ORDONNANCE 45993 DU 17-05-1945",
          "@c_titre_court": "Décret n°47-1846 du 19 septembre 1947",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000669841"
        },
        {
          "#text": "Décret n°47-1846 du 19 septembre 1947 portant règlement d'administration publique pour la constitution de la caisse nationale de retraites prévue à l'article 3 de l'ordonnance n° 45-993 du 17 mai 1945 relative aux services publics des départements et des communes et de leurs établissements publics.",
          "@c_titre_court": "Décret n°47-1846 du 19 septembre 1947",
          "@debut": "1947-09-20",
          "@fin": "2007-03-01",
          "@id_txt": "LEGITEXT000006060478"

      "TITRE_TXT": [
        {
          "#text": "Décret n°85-1141 du 23 octobre 1985 RELATIF A LA PROCEDURE DISCIPLINAIRE APPLICABLE AUX FONCTIONNAIRES RELEVANT DE LA LOI 8453 DU 26-01-1984 MODIFIEE PORTANT DISPOSITIONS STATUTAIRES RELATIVES A LA FONCTION PUBLIQUE TERRITORIALE",
          "@c_titre_court": "Décret n°85-1141 du 23 octobre 1985",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000503067"
        },
        {
          "#text": "Décret n°85-1141 du 23 octobre 1985 relatif à la procédure disciplinaire applicable aux fonctionnaires relevant de la loi n° 84-53 du 26 janvier 1984 modifiée portant dispositions statutaires relatives à la fonction publique territoriale.",
          "@c_titre_court": "Décret n°85-1141 du 23 octobre 1985",

      "TITRE_TXT": [
        {
          "#text": "Décret n°86-552 du 14 mars 1986 PRIS POUR L'APPLICATION DE L'ART. 26 (AL. 2) DE LA LOI 8453 DU 26-01-1984 ET RELATIF AUX CONTRATS D'ASSURANCES SOUSCRITS PAR LES CENTRES DEPARTEMENTAUX DE GESTION POUR LE COMPTE DES COLLECTIVITES LOCALES ET ETABLISSEMENTS TERRITORIAUX",
          "@c_titre_court": "Décret n°86-552 du 14 mars 1986",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000522301"
        },
        {
          "#text": "Décret n°86-552 du 14 mars 1986 pris pour l'application du deuxième alinéa de l'article 26 de la loi n° 84-53 du 26 janvier 1984 et relatif aux contrats d'assurances souscrits par les centres de gestion pour le compte des collectivités locales et établissements territoriaux",
          "@c_titre_court": "Décret n°86-552 du 14 mars 1986",
          "@debut": "1988-05-07",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006065581"
        },
        {

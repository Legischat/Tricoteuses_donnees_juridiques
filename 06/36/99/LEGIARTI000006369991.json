        {
          "#text": "Décret n°87-355 du 27 mai 1987 RELATIF AUX MODALITES D'ATTRIBUTION AUX AGENTS DES DIRECTIONS DEPARTEMENTALES DES AFFAIRES SANITAIRES ET SOCIALES DES COMPLEMENTS DE REMUNERATION PRIS EN CHARGE PAR L'ETAT AU TITRE DE L'ART. 2 DE LA LOI 851098 DU 11-10-1985",
          "@c_titre_court": "Décret n°87-355 du 27 mai 1987",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000518004"
        },
        {
          "#text": "Décret n°87-355 du 27 mai 1987 relatif aux modalités d'attribution aux agents des directions départementales des affaires sanitaires et sociales des compléments de rémunération pris en charge par l'Etat au titre de l'article 2 de la loi n° 85-1098 du 11 octobre 1985",
          "@c_titre_court": "Décret n°87-355 du 27 mai 1987",
          "@debut": "1987-05-30",
          "@fin": "2999-01-01",

  "BLOC_TEXTUEL": {
    "CONTENU": "<p>Les membres du cadre d'emplois des administrateurs territoriaux sont reclassés, à la date d'entrée en vigueur du présent décret dans sa rédaction issue du décret n° 2003-666 du 21 juillet 2003, conformément au tableau de correspondance ci-après :</p>\n<table>\n<tbody>\n<tr>\n<td align=\"left\" colspan=\"2\" valign=\"middle\">\n<p align=\"center\">\n<strong>SITUATION</strong>\n</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">\n<strong>ANCIENNETE</strong>\n</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">Ancienne</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">Nouvelle</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\"> </p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">\n<i>Hors classe</i>\n</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">\n<i>Hors classe</i>\n</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<pre> </pre>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">7e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">7e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">Ancienneté conservée dans la limite de la durée maximale d'échelon</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">6e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">6e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<pre> </pre>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">5e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">5e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<pre> </pre>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">4e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">4e échelon</p>\n</td>\n<td align
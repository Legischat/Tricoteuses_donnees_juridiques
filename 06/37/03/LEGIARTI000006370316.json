  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>Les attachés territoriaux constituent un cadre d'emplois administratif de catégorie A au sens de l'article 5 de la loi n° 84-53 du 26 janvier 1984 susvisée. <br/>\n<br/>Ce cadre d'emplois comprend les grades d'attaché, d'attaché principal, de directeur territorial.<br/>"
  },

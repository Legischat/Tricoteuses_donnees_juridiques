  "NOTA": {
    "CONTENU": "<br/>  Décret 2006-1460 2006-11-28 : Ce décret réorganise les grades des attachés principaux territoriaux (suppression des 1ère et des 2ème classes).<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "L'échelonnement indiciaire applicable au cadre d'emplois des attachés territoriaux est fixé ainsi qu'il suit :<br/>\n<br/>\n<br/>\n<table border=\"1\" cellpadding=\"0\" cellspacing=\"0\">\n<tbody>\n<tr>\n<td colspan=\"2\" valign=\"top\" width=\"324\">\n<br/>\n</td>\n<td valign=\"top\" width=\"357\">\n<p align=\"center\">Indices bruts</p>\n</td>\n</tr>\n<tr>\n<td colspan=\"3\" valign=\"top\" width=\"680\">\n<p align=\"center\">Directeur territorial</p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" valign=\"top\" width=\"324\">\n<p>7e échelon </p>\n</td>\n<td valign=\"top\" width=\"357\">\n<p align=\"right\">985</p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" valign=\"top\" width=\"324\">\n<p>6e échelon </p>\n</td>\n<td valign=\"top\" width=\"357\">\n<p align=\"right\">935</p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" valign=\"top\" width=\"324\">\n<p>5e échelon </p>\n</td>\n<td valign=\"top\" width=\"357\">\n<p align=\"right\">881</p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" valign=\"top\" width=\"324\">\n<p>4e échelon </p>\n</td>\n<td valign=\"top\" width=\"357\">\n<p align=\"right\">830</p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" valign=\"top\" width=\"324\">\n<p>3e échelon </p>\n</td>\n<td valign=\"top\" width=\"357\">\n<p align=\"right\">780</p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" valign=\"top\" width=\"324\">\n<p>2e échelon </p>\n</td>\n<td valign=\"top\" width=\"357\">\n<p align=\"right\">741</p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" valign=\"top\" width=\"324\">\n<p>1er échelon </p>\n</td>\n<td valign=\"top\" width=\"357\">\n<p align=\"right\">701</p>\n</td>\n</tr>\n<tr>\n<td colspan=\"3\" valign=\"top\" width=\"680\">\n<p align=\"center\">Attaché principal</p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" valign=\"top\" width=\"324\">\n<p>10e échelon </p>\n</td>\n<td valign=\"top\" width=\"357\">\n<p align=\"right\">966</p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" valign=\"top\" width=\"324\">\n<p>9e échelon </p>\n</td>\n<td valign=\"top\" width=\"357\">\n<p align=\"right\">916</p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" valign=\"top\" width=\"324\">\n<p>8e échelon </p>\n</td>\n<td valign=\"top\" width=\"357\">\n<p align=\"right\">864</p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" valign=\"top\" width=\"324\">\n<p>7e échelon </p>\n</td>\n<td valign=\"top\" width=\"357\">\n<p align=\"right\">821</p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" valign=\"top\" width=\"324\">\n<p>6e échelon </p>\n</td>\n<td valign=\"top\" width=\"357\">\n<p align=\"right\">759</p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" valign=\"top\" width=\"324\">\n<p>5e échelon </p>\n</td>\n<td valign=\"top\" width=\"357\">\n<p align=\"right\">712</p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" valign=\"top\" width=\"324\">\n<p>4e échelon</p>\n</td>\n<td valign=\"top\" width=\"357\">\n<p align=\"right\">660</p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" valign=\"top\" width=\"324\">\n<p>3e échelon</p>\n</td>\n<td valign=\"top\" width=\"357\">\n<p align=\"right\">616</p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" valign=\"top\" width=\"324\">\n<p>2e échelon</p>\n</td>\n<td valign=\"top\" width=\"357\">\n<p align=\"right\">572</p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" valign=\"top\" width=\"324\">\n<p>1er échelon</p>\n</td>\n<td valign=\"top\" width=\"357\">\n<p align=\"right\">504</p>\n</td>\n</tr>\n<tr>\n<td colspan=\"3\" valign=\"top\" width=\"680\">\n<p align=\"center\">Attaché</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"321\">\n<p>12e échelon</p>\n</td>\n<td colspan=\"2\" valign=\"top\" width=\"359\">\n<p align=\"right\">801</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"321\">\n<p>11e échelon</p>\n</td>\n<td colspan=\"2\" valign=\"top\" width=\"359\">\n<p align=\"right\">759</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"321\">\n<p>10e échelon </p>\n</td>\n<td colspan=\"2\" valign=\"top\" width=\"359\">\n<p align=\"right\">703</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"321\">\n<p>9e échelon </p>\n</td>\n<td colspan=\"2\" valign=\"top\" width=\"359\">\n<p
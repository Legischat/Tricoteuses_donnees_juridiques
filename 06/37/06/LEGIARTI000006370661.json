  "BLOC_TEXTUEL": {
    "CONTENU": "<p>La durée maximale et la durée minimale du temps passé dans chacun des échelons sont fixées ainsi qu'il suit :</p>\n<table>\n<tbody>\n<tr>\n<td rowspan=\"2\" width=\"343\">\n<p align=\"center\">ÉCHELONS</p>\n</td>\n<td colspan=\"2\" width=\"337\">\n<p align=\"center\">DURÉES</p>\n</td>\n</tr>\n<tr>\n<td width=\"180\">\n<p align=\"center\">Maximale</p>\n</td>\n<td width=\"157\">\n<p align=\"center\">Minimale</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"343\">\n<p>12e échelon</p>\n</td>\n<td valign=\"top\" width=\"180\">\n<p align=\"center\">-</p>\n</td>\n<td valign=\"top\" width=\"157\">\n<p align=\"center\">-</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"343\">\n<p>11e échelon</p>\n</td>\n<td valign=\"top\" width=\"180\">\n<p align=\"center\">3 ans 6 mois</p>\n</td>\n<td valign=\"top\" width=\"157\">\n<p align=\"center\">3 ans</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"343\">\n<p>10e échelon</p>\n</td>\n<td valign=\"top\" width=\"180\">\n<p align=\"center\">3 ans 6 mois</p>\n</td>\n<td valign=\"top\" width=\"157\">\n<p align=\"center\">3 ans</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"343\">\n<p>9e échelon</p>\n</td>\n<td valign=\"top\" width=\"180\">\n<p align=\"center\">3 ans</p>\n</td>\n<td valign=\"top\" width=\"157\">\n<p align=\"center\">2 ans 6 mois</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"343\">\n<p>8e échelon</p>\n</td>\n<td valign=\"top\" width=\"180\">\n<p align=\"center\">2 ans 6 mois</p>\n</td>\n<td valign=\"top\" width=\"157\">\n<p align=\"center\">2 ans</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"343\">\n<p>7e échelon</p>\n</td>\n<td valign=\"top\" width=\"180\">\n<p align=\"center\">2 ans 6 mois</p>\n</td>\n<td valign=\"top\" width=\"157\">\n<p align=\"center\">2 ans</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"343\">\n<p>6e échelon</p>\n</td>\n<td valign=\"top\" width=\"180\">\n<p align=\"center\">2 ans 6 mois</p>\n</td>\n<td valign=\"top\" width=\"157\">\n<p align=\"center\">2 ans</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"343\">\n<p>5e échelon</p>\n</td>\n<td valign=\"top\" width=\"180\">\n<p align=\"center\">2 ans</p>\n</td>\n<td valign=\"top\" width=\"157\">\n<p align=\"center\">1 an 6 mois</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"343\">\n<p>4e échelon</p>\n</td>\n<td valign=\"top\" width=\"180\">\n<p align=\"center\">2 ans</p>\n</td>\n<td valign=\"top\" width=\"157\">\n<p align=\"center\">1 an 6 mois</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"343\">\n<p>3e échelon</p>\n</td>\n<td valign=\"top\" width=\"180\">\n<p align=\"center\">2 ans</p>\n</td>\n<td valign=\"top\" width=\"157\">\n<p align=\"center\">1 an 6 mois</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"343\">\n<p>2e échelon</p>\n</td>\n<td valign=\"top\" width=\"180\">\n<p align=\"center\">2 ans</p>\n</td>\n<td valign=\"top\" width=\"157\">\n<p align=\"center\">1 an 6 mois</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"343\">\n<p>1er échelon</p>\n</td>\n<td valign=\"top\" width=\"180\">\n<p align=\"center\">1 an</p>\n</td>\n<td valign=\"top\" width=\"157\">\n<p align=\"center\">1 an</p>\n</td>\n</tr>\n</tbody>\n</table>"

  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   La durée maximale et la durée minimale du temps passé dans chacun des échelons des grades mentionnés au deuxième alinéa de l'article 11 sont fixées ainsi qu'il suit :<br/>\n<table>\n<tr>\n<td> :-----------------------------:</td>\n</tr>\n<tr>\n<td> : GRADES    :      DUREES     :</td>\n</tr>\n<tr>\n<td> :   ET      :-----------------:</td>\n</tr>\n<tr>\n<td> : ECHELONS  :  (1)   :   (2)  :</td>\n</tr>\n<tr>\n<td> :-----------:--------:--------:</td>\n</tr>\n<tr>\n<td> : Agent de  :        :        :</td>\n</tr>\n<tr>\n<td> : maîtrise :        :        :</td>\n</tr>\n<tr>\n<td> : principal :        :        :</td>\n</tr>\n<tr>\n<td> : 5e éch.   : 4 ans  : 3 ans  :</td>\n</tr>\n<tr>\n<td> : 4e éch.   : 3 ans  : 2 ans  :</td>\n</tr>\n<tr>\n<td> :           :        : 3 mois :</td>\n</tr>\n<tr>\n<td> : 3e éch.   : 3 ans  : 2 ans  :</td>\n</tr>\n<tr>\n<td> :           :        : 3 mois :</td>\n</tr>\n<tr>\n<td> : 2e éch.   : 3 ans  : 2 ans  :</td>\n</tr>\n<tr>\n<td> :           :        : 3 mois :</td>\n</tr>\n<tr>\n<td> : 1er éch.  : 3 ans  : 2 ans  :</td>\n</tr>\n<tr>\n<td> :           :        : 3 mois :</td>\n</tr>\n<tr>\n<td> :                             :</td>\n</tr>\n</table>\n<br/>\n (1) Maximale. (2) Minimale.<table>\n<tr>\n<td>:-----------------------------:</td>\n</tr>\n<tr>\n<td> : GRADES    :      DUREES     :</td>\n</tr>\n<tr>\n<td> :   ET      :-----------------:</td>\n</tr>\n<tr>\n<td> : ECHELONS  :  (1)   :   (2)  :</td>\n</tr>\n<tr>\n<td> :-----------:--------:--------:</td>\n</tr>\n<tr>\n<td> : Agent de  :        :        :</td>\n</tr>\n<tr>\n<td> : maîtrise :        :        :</td>\n</tr>\n<tr>\n<td> : qualifié  :        :        :</td>\n</tr>\n<tr>\n<td> : 4e éch.   : 3 ans  : 2 ans  :</td>\n</tr>\n<tr>\n<td> :           : 6 mois : 9 mois :</td>\n</tr>\n<tr>\n<td> : 3e éch.   : 3 ans  : 2 ans  :</td>\n</tr>\n<tr>\n<td> :           : 6 mois : 9 mois :</td>\n</tr>\n<tr>\n<td> : 2e éch.   : 2 ans  : 2 ans  :</td>\n</tr>\n<tr>\n<td> :           : 6 mois :        :</td>\n</tr>\n<tr>\n<td> : 1er éch.  : 2 ans  : 2 ans  :</td>\n</tr>\n<tr>\n<td> :           : 6 mois :        :</td>\n</tr>\n<tr>\n<td> :                             :</td>\n</tr>\n</table>\n<br/>\n (1) Maximale. (2) Minimale."
  },

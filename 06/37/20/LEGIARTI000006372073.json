      "TITRE_TXT": [
        {
          "#text": "Décret n°89-227 du 17 avril 1989 MODIFIANT LE DECRET 871107 DU 30-12-1987 PORTANT ORGANISATION DES CARRIERES DES FONCTIONNAIRES TERRITORIAUX DE CATEGORIES C ET D ET CERTAINES DISPOSITIONS STATUTAIRES APPLICABLES A LA FONCTION PUBLIQUE TERRITORIALE",
          "@c_titre_court": "Décret n°89-227 du 17 avril 1989",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000522645"
        },
        {
          "#text": "Décret n°89-227 du 17 avril 1989 modifiant le décret n° 87-1107 du 30 décembre 1987 portant organisation des carrières des fonctionnaires territoriaux de catégories C et D et certaines dispositions statutaires applicables à la fonction publique territoriale",
          "@c_titre_court": "Décret n°89-227 du 17 avril 1989",
          "@debut": "1989-04-18",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006067030"

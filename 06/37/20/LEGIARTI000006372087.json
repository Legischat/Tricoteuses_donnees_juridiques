    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret n°89-230 du 17 avril 1989 FIXANT LA REPARTITION DES FONCTIONNAIRES TERRITORIAUX EN GROUPES HIERARCHIQUES EN APPLICATION DE L'ART. 90 DE LA LOI DU 26-01-1984 MODIFIEE PORTANT DISPOSITIONS STATUTAIRES RELATIVES A LA FONCTION PUBLIQUE TERRITORIALE",
          "@c_titre_court": "Décret n°89-230 du 17 avril 1989",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000705157"
        },
        {
          "#text": "Décret n°89-230 du 17 avril 1989 fixant la répartition des fonctionnaires territoriaux en groupes hiérarchiques en application de l'article 90 de la loi du 26 janvier 1984 modifiée portant dispositions statutaires relatives à la fonction publique territoriale",
          "@c_titre_court": "Décret n°89-230 du 17 avril 1989",
          "@debut": "1989-04-18",
          "@fin": "1995-09-15",

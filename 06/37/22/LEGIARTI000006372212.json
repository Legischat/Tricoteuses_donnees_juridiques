    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret n°89-537 du 3 août 1989 INSTITUANT UNE INDEMNITE COMPENSATOIRE POUR FRAIS DE TRANSPORT EN FAVEUR DES FONCTIONNAIRES ET AGENTS DE LA FONCTION PUBLIQUE TERRITORIALE EN SERVICE DANS LES DEPARTEMENTS DE LA HAUTE-CORSE ET DE LA CORSE-DU-SUD",
          "@c_titre_court": "Décret n°89-537 du 3 août 1989",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000517463"
        },
        {
          "#text": "Décret n°89-537 du 3 août 1989 instituant une indemnité compensatoire pour frais de transport en faveur des fonctionnaires et agents de la fonction publique territoriale en service dans les départements de la Haute-Corse et de la Corse-du-Sud",
          "@c_titre_court": "Décret n°89-537 du 3 août 1989",
          "@debut": "1989-08-04",

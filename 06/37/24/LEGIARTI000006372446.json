  "BLOC_TEXTUEL": {
    "CONTENU": "<p>L'échelonnement indiciaire applicable au cadre d'emplois des ingénieurs territoriaux est fixé ainsi qu'il suit :</p>\n<table>\n<tbody>\n<tr>\n<td width=\"340\">\n<p align=\"center\">ECHELONS</p>\n</td>\n<td width=\"340\">\n<p align=\"center\">INDICES BRUTS</p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" width=\"680\">\n<p align=\"center\">Ingénieur en chef de classe exceptionnelle</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"340\">\n<p>7e échelon</p>\n</td>\n<td width=\"340\">\n<p align=\"right\">HEB </p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"340\">\n<p>6e échelon</p>\n</td>\n<td width=\"340\">\n<p align=\"right\">HEA </p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"340\">\n<p>5e échelon </p>\n</td>\n<td width=\"340\">\n<p align=\"right\">1015 </p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"340\">\n<p>4e échelon </p>\n</td>\n<td width=\"340\">\n<p align=\"right\">966 </p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"340\">\n<p>3e échelon </p>\n</td>\n<td width=\"340\">\n<p align=\"right\">901 </p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"340\">\n<p>2e échelon </p>\n</td>\n<td width=\"340\">\n<p align=\"right\">830 </p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"340\">\n<p>1er échelon </p>\n</td>\n<td width=\"340\">\n<p align=\"right\">750 </p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" width=\"680\">\n<p align=\"center\">Ingénieur en chef de classe normale</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"340\">\n<p>10e échelon </p>\n</td>\n<td width=\"340\">\n<p align=\"right\">966 </p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"340\">\n<p>9e échelon </p>\n</td>\n<td width=\"340\">\n<p align=\"right\">901 </p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"340\">\n<p>8e échelon </p>\n</td>\n<td width=\"340\">\n<p align=\"right\">852 </p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"340\">\n<p>7e échelon </p>\n</td>\n<td width=\"340\">\n<p align=\"right\">772 </p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" w
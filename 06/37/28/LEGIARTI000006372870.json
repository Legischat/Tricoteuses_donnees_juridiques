  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les lieutenants classés du 1er au 5e échelon de leur grade sont, par dérogation aux dispositions des articles 28 et 29, reclassés conformément au tableau suivant :<br/>\n<table>\n<tr>\n<td> :---------------------:-------------:</td>\n</tr>\n<tr>\n<td> :      Situation      :             :</td>\n</tr>\n<tr>\n<td> :     de grade et     :  Ancienneté :</td>\n</tr>\n<tr>\n<td> :      d'échelon      :             :</td>\n</tr>\n<tr>\n<td> :-----------:---------:  d'échelon  :</td>\n</tr>\n<tr>\n<td> :     A     :   N     :             :</td>\n</tr>\n<tr>\n<td> :-----------:---------:-------------:</td>\n</tr>\n<tr>\n<td> :    5e     :   3e    :  Sans anc.  :</td>\n</tr>\n<tr>\n<td> :-----------:---------:-------------:</td>\n</tr>\n<tr>\n<td> :    4e     :   2e    : Anc. cons.  :</td>\n</tr>\n<tr>\n<td> :-----------:---------:-------------:</td>\n</tr>\n<tr>\n<td> :    3e     :   1er   : Anc. cons.  :</td>\n</tr>\n<tr>\n<td> :-----------:---------:-------------:</td>\n</tr>\n<tr>\n<td> :    2e     :   1er   :  Sans anc.  :</td>\n</tr>\n<tr>\n<td> :-----------:---------:-------------:</td>\n</tr>\n<tr>\n<td> :    1er    : Echelon : Anc. cons.  :</td>\n</tr>\n<tr>\n<td> :           : proviso :             :</td>\n</tr>\n<tr>\n<td> :-----------:---------:-------------:</td>\n</tr>\n</table>\n<br/>\n A Ancienne) N (Nouvelle)"
  },

  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les conservateurs territoriaux du patrimoine constituent un cadre d'emplois culturel et scientifique de catégorie A au sens de l'article 5 de la loi n° 84-53 du 26 janvier 1984 susvisée. \"<br/>\n<br/>   Ce cadre d'emplois comprend les grades de conservateur de 2e classe, conservateur de 1re classe et conservateur en chef.<br/>"
  },

  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   L'échelonnement indiciaire applicable au cadre d'emplois des conservateurs territoriaux du patrimoine est fixé ainsi qu'il suit :<br/>\n<br/>\n<table>\n<tr>\n<td> :----------------------------:</td>\n</tr>\n<tr>\n<td> : Conservateur  :   Indices  :</td>\n</tr>\n<tr>\n<td> :   en chef     :    bruts   :</td>\n</tr>\n<tr>\n<td> :----------------------------:</td>\n</tr>\n<tr>\n<td> : 6e  échelon   :     HEA    :</td>\n</tr>\n<tr>\n<td> : 5e  échelon   :    1015    :</td>\n</tr>\n<tr>\n<td> : 4e  échelon   :     966    :</td>\n</tr>\n<tr>\n<td> : 3e  échelon   :     871    :</td>\n</tr>\n<tr>\n<td> : 2e  échelon   :     780    :</td>\n</tr>\n<tr>\n<td> : 1er échelon   :     701    :</td>\n</tr>\n<tr>\n<td> :               :            :</td>\n</tr>\n<tr>\n<td> :---------------:            :</td>\n</tr>\n<tr>\n<td> : Conservateur  :            :</td>\n</tr>\n<tr>\n<td> : de 1re classe :            :</td>\n</tr>\n<tr>\n<td> :---------------:            :</td>\n</tr>\n<tr>\n<td> : 5e  échelon   :     852    :</td>\n</tr>\n<tr>\n<td> : 4e  échelon   :     777    :</td>\n</tr>\n<tr>\n<td> : 3e  échelon   :     701    :</td>\n</tr>\n<tr>\n<td> : 2e  échelon   :     661    :</td>\n</tr>\n<tr>\n<td> : 1er échelon   :     616    :</td>\n</tr>\n<tr>\n<td> :----------------------------:</td>\n</tr>\n<tr>\n<td> : Conservateur  :            :</td>\n</tr>\n<tr>\n<td> : de 2e classe  :            :</td>\n</tr>\n<tr>\n<td> :---------------:            :</td>\n</tr>\n<tr>\n<td> : 5e  échelon   :     593    :</td>\n</tr>\n<tr>\n<td> : 4e  échelon   :     540    :</td>\n</tr>\n<tr>\n<td> : 3e  échelon   :     499    :</td>\n</tr>\n<tr>\n<td> :----------------------------:</td>\n</tr>\n<tr>\n<td> :    Echelons   :            :</td>\n</tr>\n<tr>\n<td> :    de stage   :            :</td>\n</tr>\n<tr>\n<td> :---------------:            :</td>\n</tr>\n<tr>\n<td> :    échelon    :            :</td>\n</tr>\n<tr>\n<td> :    unique     :     459    :</td>\n</tr>\n<tr>\n<td
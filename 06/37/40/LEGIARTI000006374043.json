  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les professeurs territoriaux d'enseignement artistique constituent un cadre d'emplois culturel de catégorie A au sens de l'article 5 de la loi n° 84-53 du 26 janvier 1984 susvisée.<br/>\n<br/>   Ce cadre d'emplois comprend les grades de professeur d'enseignement artistique de classe normale et de professeur d'enseignement artistique hors classe.<br/>"
  },

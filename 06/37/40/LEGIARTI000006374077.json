  "BLOC_TEXTUEL": {
    "CONTENU": "<p>La durée maximale et la durée minimale du temps passé dans chacun des échelons des grades sont fixées ainsi qu'il suit :</p>\n<table align=\"center\" border=\"1\" cellpadding=\"0\" cellspacing=\"0\" width=\"378\">\n<tbody>\n<tr>\n<td rowspan=\"2\" width=\"139\">\n<p align=\"center\">GRADE ET ECHELONS</p>\n</td>\n<td colspan=\"2\" width=\"239\">\n<p align=\"center\">DUREE</p>\n</td>\n</tr>\n<tr>\n<td width=\"121\">\n<p align=\"center\">Maximale</p>\n</td>\n<td width=\"119\">\n<p align=\"center\">Minimale</p>\n</td>\n</tr>\n<tr>\n<td colspan=\"3\" valign=\"top\" width=\"378\">\n<p align=\"center\">Professeur d'enseignement artistique hors classe</p>\n</td>\n</tr>\n<tr>\n<td width=\"139\">\n<p>7e échelon </p>\n</td>\n<td width=\"121\">\n<p align=\"center\">-</p>\n</td>\n<td width=\"119\">\n<p align=\"center\">-</p>\n</td>\n</tr>\n<tr>\n<td width=\"139\">\n<p>6e échelon</p>\n</td>\n<td width=\"121\">\n<p align=\"center\">3 ans 1 mois</p>\n</td>\n<td width=\"119\">\n<p align=\"center\">2 ans 11 mois</p>\n</td>\n</tr>\n<tr>\n<td width=\"139\">\n<p>5e échelon</p>\n</td>\n<td width=\"121\">\n<p align=\"center\">3 ans 1 mois</p>\n</td>\n<td width=\"119\">\n<p align=\"center\">2 ans 11 mois</p>\n</td>\n</tr>\n<tr>\n<td width=\"139\">\n<p>4e échelon</p>\n</td>\n<td width=\"121\">\n<p align=\"center\">2 ans 7 mois</p>\n</td>\n<td width=\"119\">\n<p align=\"center\">2 ans 5 mois</p>\n</td>\n</tr>\n<tr>\n<td width=\"139\">\n<p>3e échelon</p>\n</td>\n<td width=\"121\">\n<p align=\"center\">2 ans 7 mois</p>\n</td>\n<td width=\"119\">\n<p align=\"center\">2 ans 5 mois</p>\n</td>\n</tr>\n<tr>\n<td width=\"139\">\n<p>2e échelon</p>\n</td>\n<td width=\"121\">\n<p align=\"center\">2 ans 7 mois</p>\n</td>\n<td width=\"119\">\n<p align=\"center\">2 ans 5 mois</p>\n</td>\n</tr>\n<tr>\n<td width=\"139\">\n<p>1er échelon</p>\n</td>\n<td width=\"121\">\n<p align=\"center\">2 ans 7 mois</p>\n</td>\n<td width=\"119\">\n<p align=\"center\">2 ans 5 mois</p>\n</td>\n</tr>\n</tbody>\n</table>\n<p>.</p>\n<p>.</p>\n<table align=\"center\" border=\"1\" cellpadding=\"0\" cellspacing=\"0\" width=\"378\">\n<tbody>\n<tr>\n<td rowspan=\"2\" width=\"139\">\n<p align=\"center\">GRADE ET ECHELONS</p>\n</td>\n<td colspan=\"2\" width=\"239\">\n<p align=\"center\">DUREE</p>\n</td>\n</tr>\n<tr>\n<td width=\"121\">\n<p align=\"center\">Maximale</p>\n</td>\n<td width=\"119\">\n<p align=\"center\">Minimale</p>\n</td>\n</tr>\n<tr>\n<td colspan=\"3\" valign=\"top\" width=\"378\">\n<p align=\"center\">Professeur d'enseignement artistique de classe normale</p>\n</td>\n</tr>\n<tr>\n<td width=\"139\">\n<p>9e échelon</p>\n</td>\n<td width=\"121\">\n<p align=\"center\">-</p>\n</td>\n<td width=\"119\">\n<p align=\"center\">-</p>\n</td>\n</tr>\n<tr>\n<td width=\"139\">\n<p>8e échelon</p>\n</td>\n<td width=\"121\">\n<p align=\"center\">3 ans 6 mois</p>\n</td>\n<td width=\"119\">\n<p align=\"center\">3 ans</p>\n</td>\n</tr>\n<tr>\n<td width=\"139\">\n<p>7e échelon </p>\n</td>\n<td width=\"121\">\n<p align=\"center\">3 ans 6 mois </p>\n</td>\n<td width=\"119\">\n<p align=\"center\">3 ans </p>\n</td>\n</tr>\n<tr>\n<td width=\"139\">\n<p>6e échelon</p>\n</td>\n<td width=\"121\">\n<p align=\"center\">3 ans 6 mois</p>\n</td>\n<td width=\"119\">\n<p align=\"center\">3 ans</p>\n</td>\n</tr>\n<tr>\n<td width=\"139\">\n<p>5e échelon</p>\n</td>\n<td width=\"121\">\n<p align=\"center\">3 ans</p>\n</td>\n<td width=\"119\">\n<p align=\"center\">2 ans 6 mois</p>\n</td>\n</tr>\n<tr>\n<td width=\"139\">\n<p>4e échelon</p>\n</td>\n<td width=\"121\">\n<p align=\"center\">3 ans</p>\n</td>\n<td width=\"119\">\n<p align=\"center\">2 ans 6 mois</p>\n</td>\n</tr>\n<tr>\n<td width=\"139\">\n<p>3e échelon</p>\n</td>\n<td width=\"121\">\n<p align=\"center\">3 ans</p>\n</td>\n<td width=\"119\">\n<p align=\"center\">2 ans 6 mois</p>\n</td>\n</tr>\n<tr>\n<td width=\"139\">\n<p>2e échelon</p>\n</td>\n<td width=\"121\">\n<p align=\"center\">2 ans 6 mois</p>\n</td>\n<td width=\"119\">\n<p align=\"center\">2 ans</p>\n</td>\n</tr>\n<tr>\n<td width=\"139\">\n<p>1er échelon</p>\n</td>\n<td width=\"121\">\n<p align=\"center\">1 an 6 mois</p>\n</td>\n<td width=\"119\">\n<p align=\"center\">1 an</p>\n</td>\n</tr>\n</tbody>\n</table>"

  "BLOC_TEXTUEL": {
    "CONTENU": "<p>L'échelonnement indiciaire applicable aux professeurs territoriaux d'enseignement artistique est fixé ainsi qu'il suit :</p>\n<table align=\"center\" border=\"1\" cellpadding=\"0\" cellspacing=\"0\">\n<tbody>\n<tr>\n<td>\n<br/>\n</td>\n<td>\n<p align=\"center\">Indices bruts</p>\n</td>\n</tr>\n<tr>\n<td>\n<p>Professeurs hors classe :</p>\n</td>\n<td>\n<p align=\"center\"> </p>\n</td>\n</tr>\n<tr>\n<td>\n<p>7e échelon</p>\n</td>\n<td>\n<p align=\"center\">966</p>\n</td>\n</tr>\n<tr>\n<td>\n<p>6e échelon</p>\n</td>\n<td>\n<p align=\"center\">910</p>\n</td>\n</tr>\n<tr>\n<td>\n<p>5e échelon</p>\n</td>\n<td>\n<p align=\"center\">850</p>\n</td>\n</tr>\n<tr>\n<td>\n<p>4e échelon</p>\n</td>\n<td>\n<p align=\"center\">780</p>\n</td>\n</tr>\n<tr>\n<td>\n<p>3e échelon</p>\n</td>\n<td>\n<p align=\"center\">726</p>\n</td>\n</tr>\n<tr>\n<td>\n<p>2e échelon</p>\n</td>\n<td>\n<p align=\"center\">672</p>\n</td>\n</tr>\n<tr>\n<td>\n<p>1er échelon</p>\n</td>\n<td>\n<p align=\"center\">587</p>\n</td>\n</tr>\n<tr>\n<td>\n<p>Professeurs de classe normale :</p>\n</td>\n<td>\n<p align=\"center\"> </p>\n</td>\n</tr>\n<tr>\n<td>\n<p>9e échelon</p>\n</td>\n<td>\n<p align=\"center\">801</p>\n</td>\n</tr>\n<tr>\n<td>\n<p>8e échelon</p>\n</td>\n<td>\n<p align=\"center\">741</p>\n</td>\n</tr>\n<tr>\n<td>\n<p>7e échelon</p>\n</td>\n<td>\n<p align=\"center\">681</p>\n</td>\n</tr>\n<tr>\n<td>\n<p>6e échelon</p>\n</td>\n<td>\n<p align=\"center\">633</p>\n</td>\n</tr>\n<tr>\n<td>\n<p>5e échelon</p>\n</td>\n<td>\n<p align=\"center\">583</p>\n</td>\n</tr>\n<tr>\n<td>\n<p>4e échelon</p>\n</td>\n<td>\n<p align=\"center\">534</p>\n</td>\n</tr>\n<tr>\n<td>\n<p>3e échelon</p>\n</td>\n<td>\n<p align=\"center\">499</p>\n</td>\n</tr>\n<tr>\n<td>\n<p>2e échelon</p>\n</td>\n<td>\n<p align=\"center\">466</p>\n</td>\n</tr>\n<tr>\n<td>\n<p>1er échelon</p>\n</td>\n<td>\n<p align=\"center\">433</p>\n</td>\n</tr>\n</tbody>\n</table>"
  },

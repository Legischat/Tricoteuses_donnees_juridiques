  "BLOC_TEXTUEL": {
    "CONTENU": "<p>La durée maximale et la durée minimale du temps passé dans chacun des échelons sont fixées ainsi qu'il suit :<br/>\n<br/>\n<br/>\n</p>\n<table>\n<tbody>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">\n<strong>ECHELONS</strong>\n</p>\n</td>\n<td align=\"left\" colspan=\"2\" valign=\"middle\">\n<p align=\"center\">\n<strong>DUREES</strong>\n</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<pre> </pre>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">Maximale</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">Minimale</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">8e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">-</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">-</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">7e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">4 ans</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">3 ans </p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">6e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">4 ans</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">3 ans </p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">5e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">2 ans</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">1 an 6 mois</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">4e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">2 ans</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">1 an 6 mois</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">3e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">2 ans</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">1 an 6 mois</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">2e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">2 ans</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">1 an 6 mois</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">1er échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">2 ans</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">1 an 6 mois</p>\n</td>\n</tr>\n</tbody>\n</table>"

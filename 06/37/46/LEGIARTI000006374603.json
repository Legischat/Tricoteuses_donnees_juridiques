  "BLOC_TEXTUEL": {
    "CONTENU": "<p>L'échelonnement indiciaire applicable au cadre d'emplois des conseillers territoriaux socio-éducatifs est fixé ainsi qu'il suit :</p>\n<table>\n<tbody>\n<tr>\n<td valign=\"top\" width=\"454\">\n<p align=\"center\">ÉCHELONS</p>\n</td>\n<td valign=\"top\" width=\"151\">\n<p align=\"center\">INDICES BRUTS</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"454\">\n<p>8e échelon</p>\n</td>\n<td valign=\"top\" width=\"151\">\n<p align=\"center\">660</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"454\">\n<p>7e échelon</p>\n</td>\n<td valign=\"top\" width=\"151\">\n<p align=\"center\">628</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"454\">\n<p>6e échelon</p>\n</td>\n<td valign=\"top\" width=\"151\">\n<p align=\"center\">597</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"454\">\n<p>5e échelon</p>\n</td>\n<td valign=\"top\" width=\"151\">\n<p align=\"center\">566</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"454\">\n<p>4e échelon</p>\n</td>\n<td valign=\"top\" width=\"151\">\n<p align=\"center\">535</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"454\">\n<p>3e échelon</p>\n</td>\n<td valign=\"top\" width=\"151\">\n<p align=\"center\">504</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"454\">\n<p>2e échelon</p>\n</td>\n<td valign=\"top\" width=\"151\">\n<p align=\"center\">481</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"454\">\n<p>1er échelon</p>\n</td>\n<td valign=\"top\" width=\"151\">\n<p align=\"center\">461</p>\n</td>\n</tr>\n</tbody>\n</table>"
  },

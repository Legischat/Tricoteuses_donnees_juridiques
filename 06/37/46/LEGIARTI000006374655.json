  "BLOC_TEXTUEL": {
    "CONTENU": "<p>L'échelonnement indiciaire applicable au cadre d'emplois des assistants territoriaux socio-éducatifs est fixé ainsi qu'il suit :</p>\n<p align=\"center\">Assistant socio-éducatif principal</p>\n<table>\n<tbody>\n<tr>\n<td width=\"454\">\n<p align=\"center\">ÉCHELONS</p>\n</td>\n<td width=\"151\">\n<p align=\"center\">INDICES BRUTS</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"454\">\n<p>7e échelon</p>\n</td>\n<td valign=\"top\" width=\"151\">\n<p align=\"center\">638</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"454\">\n<p>6e échelon</p>\n</td>\n<td valign=\"top\" width=\"151\">\n<p align=\"center\">593</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"454\">\n<p>5e échelon</p>\n</td>\n<td valign=\"top\" width=\"151\">\n<p align=\"center\">559</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"454\">\n<p>4e échelon</p>\n</td>\n<td valign=\"top\" width=\"151\">\n<p align=\"center\">527</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"454\">\n<p>3e échelon</p>\n</td>\n<td valign=\"top\" width=\"151\">\n<p align=\"center\">498</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"454\">\n<p>2e échelon</p>\n</td>\n<td valign=\"top\" width=\"151\">\n<p align=\"center\">461</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"454\">\n<p>1er échelon</p>\n</td>\n<td valign=\"top\" width=\"151\">\n<p align=\"center\">422</p>\n</td>\n</tr>\n</tbody>\n</table>\n<p align=\"center\">Assistant socio-éducatif</p>\n<table>\n<tbody>\n<tr>\n<td width=\"427\">\n<p align=\"center\">ÉCHELONS</p>\n</td>\n<td width=\"178\">\n<p align=\"center\">INDICES BRUTS</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"427\">\n<p>10e échelon</p>\n</td>\n<td valign=\"top\" width=\"178\">\n<p align=\"center\">593</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"427\">\n<p>9e échelon</p>\n</td>\n<td valign=\"top\" width=\"178\">\n<p align=\"center\">551</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"427\">\n<p>8e échelon</p>\n</td>\n<td valign=\"top\" width=\"178\">\n<p align=\"center\">520</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"427\">\n<p>7e échelon</p>\n</td>\n<td valign=\"top\" width=\"178\">\n<p align=\"center\">485</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"427\">\n<p>6e échelon</p>\n</td>\n<td valign=\"top\" width=\"178\">\n<p align=\"center\">453</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"427\">\n<p>5e échelon</p>\n</td>\n<td valign=\"top\" width=\"178\">\n<p align=\"center\">422</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"427\">\n<p>4e échelon</p>\n</td>\n<td valign=\"top\" width=\"178\">\n<p align=\"center\">384</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"427\">\n<p>3e échelon</p>\n</td>\n<td valign=\"top\" width=\"178\">\n<p align=\"center\">362</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"427\">\n<p>2e échelon</p>\n</td>\n<td valign=\"top\" width=\"178\">\n<p align=\"center\">334</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"427\">\n<p>1er échelon</p>\n</td>\n<td valign=\"top\" width=\"178\">\n<p align=\"center\">322</p>\n</td>\n</tr>\n</tbody>\n</table>"

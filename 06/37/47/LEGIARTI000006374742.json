  "BLOC_TEXTUEL": {
    "CONTENU": "<p>L'échelonnement indiciaire applicable au cadre d'emplois des moniteurs-éducateurs territoriaux est fixé ainsi qu'il suit :</p>\n<table>\n<tbody>\n<tr>\n<td width=\"454\">\n<p align=\"center\">ÉCHELONS</p>\n</td>\n<td width=\"227\">\n<p align=\"center\">INDICES BRUTS</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"454\">\n<p>11e échelon</p>\n</td>\n<td valign=\"top\" width=\"227\">\n<p align=\"center\">465</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"454\">\n<p>10e échelon</p>\n</td>\n<td valign=\"top\" width=\"227\">\n<p align=\"center\">440</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"454\">\n<p>9e échelon</p>\n</td>\n<td valign=\"top\" width=\"227\">\n<p align=\"center\">410</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"454\">\n<p>8e échelon</p>\n</td>\n<td valign=\"top\" width=\"227\">\n<p align=\"center\">396</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"454\">\n<p>7e échelon</p>\n</td>\n<td valign=\"top\" width=\"227\">\n<p align=\"center\">381</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"454\">\n<p>6e échelon</p>\n</td>\n<td valign=\"top\" width=\"227\">\n<p align=\"center\">363</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"454\">\n<p>5e échelon</p>\n</td>\n<td valign=\"top\" width=\"227\">\n<p align=\"center\">345</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"454\">\n<p>4e échelon</p>\n</td>\n<td valign=\"top\" width=\"227\">\n<p align=\"center\">333</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"454\">\n<p>3e échelon</p>\n</td>\n<td valign=\"top\" width=\"227\">\n<p align=\"center\">310</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"454\">\n<p>2e échelon</p>\n</td>\n<td valign=\"top\" width=\"227\">\n<p align=\"center\">296</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"454\">\n<p>1er échelon</p>\n</td>\n<td valign=\"top\" width=\"227\">\n<p align=\"center\">272</p>\n</td>\n</tr>\n</tbody>\n</table>"
  },

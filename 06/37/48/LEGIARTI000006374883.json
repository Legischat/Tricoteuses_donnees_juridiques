  "BLOC_TEXTUEL": {
    "CONTENU": "<p>La durée maximale et la durée minimale du temps passé dans chacun des échelons des grades sont fixées ainsi qu'il suit :</p>\n<br/>\n<br/>\n<table border=\"2\" cellpadding=\"2\">\n<tbody>\n<tr>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">GRADES ET ECHELONS</p>\n</td>\n<td align=\"left\" colspan=\"2\" valign=\"top\">\n<p align=\"center\">DUREES</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"top\">\n<pre> </pre>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">Maximale</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">Minimale</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"top\">\n<p align=\"left\">Médecin hors-classe</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<pre> </pre>\n</td>\n<td align=\"left\" valign=\"top\">\n<pre> </pre>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"top\">\n<p align=\"left\">5e échelon</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">-</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">-</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"top\">\n<p align=\"left\">4e échelon</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">3 ans</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">2 ans</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"top\">\n<p align=\"left\">3e échelon</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">3ans</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">2 ans</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"top\">\n<p align=\"left\">2e échelon</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">2 ans</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">1 an 6 mois</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"top\">\n<p align=\"left\">1er échelon</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">2 ans</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center
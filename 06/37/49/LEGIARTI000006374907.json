  "BLOC_TEXTUEL": {
    "CONTENU": "<p>L'échelonnement indiciaire applicable au cadre d'emplois des médecins territoriaux est fixé ainsi qu'il suit :</p>\n<p align=\"center\">Médecin territorial hors classe</p>\n<p align=\"center\"> </p>\n<table>\n<tbody>\n<tr>\n<td width=\"454\">\n<p align=\"center\">ÉCHELONS</p>\n</td>\n<td width=\"227\">\n<p align=\"center\">INDICES BRUTS</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"454\">\n<p>5e échelon</p>\n</td>\n<td valign=\"top\" width=\"227\">\n<p align=\"center\">HEB</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"454\">\n<p>4e échelon</p>\n</td>\n<td valign=\"top\" width=\"227\">\n<p align=\"center\">HEA</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"454\">\n<p>3e échelon</p>\n</td>\n<td valign=\"top\" width=\"227\">\n<p align=\"center\">1 015</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"454\">\n<p>2e échelon</p>\n</td>\n<td valign=\"top\" width=\"227\">\n<p align=\"center\">966</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"454\">\n<p>1er échelon</p>\n</td>\n<td valign=\"top\" width=\"227\">\n<p align=\"center\">901</p>\n</td>\n</tr>\n</tbody>\n</table>\n<p align=\"center\"> </p>\n<p align=\"center\"> </p>\n<p align=\"center\">Médecin territorial de 1re classe</p>\n<p align=\"center\"> </p>\n<table>\n<tbody>\n<tr>\n<td width=\"454\">\n<p align=\"center\">ÉCHELONS</p>\n</td>\n<td width=\"227\">\n<p align=\"center\">INDICES BRUTS</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"454\">\n<p>5e échelon</p>\n</td>\n<td valign=\"top\" width=\"227\">\n<p align=\"center\">1 015</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"454\">\n<p>4e échelon</p>\n</td>\n<td valign=\"top\" width=\"227\">\n<p align=\"center\">966</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"454\">\n<p>3e échelon</p>\n</td>\n<td valign=\"top\" width=\"227\">\n<p align=\"center\">901</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"454\">\n<p>2e échelon</p>\n</td>\n<td valign=\"top\" width=\"227\">\n<p align=\"center\">830</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"454\">\n<p>1er échelon</p>\n</td>\n<td valign=\"top\" width=\"227\">\n<p align=\"center\">750</p>\n</td>\n</tr>\n</tbody>\n</table>\n<p align=\"center\"> </p>\n<p align=\"center\">Médecin territorial de 2e classe</p>\n<p align=\"center\"> </p>\n<table>\n<tbody>\n<tr>\n<td width=\"454\">\n<p align=\"center\">ÉCHELONS</p>\n</td>\n<td width=\"227\">\n<p align=\"center\">INDICES BRUTS</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"454\">\n<p>11e échelon</p>\n</td>\n<td valign=\"top\" width=\"227\">\n<p align=\"center\">852</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"454\">\n<p>10e échelon</p>\n</td>\n<td valign=\"top\" width=\"227\">\n<p align=\"center\">821</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"454\">\n<p>9e échelon</p>\n</td>\n<td valign=\"top\" width=\"227\">\n<p align=\"center\">772</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"454\">\n<p>8e échelon</p>\n</td>\n<td valign=\"top\" width=\"227\">\n<p align=\"center\">750</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"454\">\n<p>7e échelon</p>\n</td>\n<td valign=\"top\" width=\"227\">\n<p align=\"center\">701</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"454\">\n<p>6e échelon</p>\n</td>\n<td valign=\"top\" width=\"227\">\n<p align=\"center\">655</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"454\">\n<p>5e échelon</p>\n</td>\n<td valign=\"top\" width=\"227\">\n<p align=\"center\">612</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"454\">\n<p>4e échelon</p>\n</td>\n<td valign=\"top\" width=\"227\">\n<p align=\"center\">563</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"454\">\n<p>3e échelon</p>\n</td>\n<td valign=\"top\" width=\"227\">\n<p align=\"center\">513</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"454\">\n<p>2e échelon</p>\n</td>\n<td valign=\"top\" width=\"227\">\n<p align=\"center\">480</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"454\">\n<p>1er échelon</p>\n</td>\n<td valign=\"top\" width=\"227\">\n<p a
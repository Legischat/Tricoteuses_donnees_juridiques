  "BLOC_TEXTUEL": {
    "CONTENU": "<p>L'échelonnement indiciaire applicable au cadre d'emplois des psychologues territoriaux est fixé ainsi qu'il suit :</p>\n<p align=\"center\">Psychologue hors classe</p>\n<p align=\"center\"> </p>\n<p align=\"center\"> </p>\n<table align=\"center\" border=\"1\" cellpadding=\"0\" cellspacing=\"0\">\n<tbody>\n<tr>\n<td width=\"454\">\n<p align=\"center\">ÉCHELONS</p>\n</td>\n<td width=\"227\">\n<p align=\"center\">INDICES BRUTS</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"454\">\n<p>7e échelon</p>\n</td>\n<td valign=\"top\" width=\"227\">\n<p align=\"center\">966</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"454\">\n<p>6e échelon</p>\n</td>\n<td valign=\"top\" width=\"227\">\n<p align=\"center\">910</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"454\">\n<p>5e échelon</p>\n</td>\n<td valign=\"top\" width=\"227\">\n<p align=\"center\">850</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"454\">\n<p>4e échelon</p>\n</td>\n<td valign=\"top\" width=\"227\">\n<p align=\"center\">780</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"454\">\n<p>3e échelon</p>\n</td>\n<td valign=\"top\" width=\"227\">\n<p align=\"center\">726</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"454\">\n<p>2e échelon</p>\n</td>\n<td valign=\"top\" width=\"227\">\n<p align=\"center\">672</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"454\">\n<p>1er échelon</p>\n</td>\n<td valign=\"top\" width=\"227\">\n<p align=\"center\">587</p>\n</td>\n</tr>\n</tbody>\n</table>\n<p align=\"center\"> </p>\n<p align=\"center\">\n<br/>Psychologue de classe normale</p>\n<p align=\"center\"> </p>\n<p align=\"center\"> </p>\n<p align=\"center\"> </p>\n<p align=\"center\"> </p>\n<table align=\"center\" border=\"1\" cellpadding=\"0\" cellspacing=\"0\">\n<tbody>\n<tr>\n<td width=\"454\">\n<p align=\"center\">ÉCHELONS</p>\n</td>\n<td width=\"227\">\n<p align=\"center\">INDICES BRUTS</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"454\">\n<p>11e échelon</p>\n</td>\n<td valig
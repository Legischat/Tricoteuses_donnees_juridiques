  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   L'échelonnement indiciaire applicable au cadre d'emplois des sages-femmes territoriales est fixé ainsi qu'il suit :<br/>\n<br/>\n   Sage-femme hors classe <br/>\n<br/>\n<table>\n<tr>\n<td> :-----------------------------:</td>\n</tr>\n<tr>\n<td> :    ECHELONS       : INDICES :</td>\n</tr>\n<tr>\n<td> :                   :  BRUTS  :</td>\n</tr>\n<tr>\n<td> :-----------------------------:</td>\n</tr>\n<tr>\n<td> :  Echelon          :   720   :</td>\n</tr>\n<tr>\n<td> :  exceptionnel     :         :</td>\n</tr>\n<tr>\n<td> :  6e échelon       :   701   :</td>\n</tr>\n<tr>\n<td> :  5e échelon       :   640   :</td>\n</tr>\n<tr>\n<td> :  4e échelon       :   606   :</td>\n</tr>\n<tr>\n<td> :  3e échelon       :   574   :</td>\n</tr>\n<tr>\n<td> :  2e échelon       :   544   :</td>\n</tr>\n<tr>\n<td> : 1er échelon       :   514   :</td>\n</tr>\n<tr>\n<td> :-----------------------------:</td>\n</tr>\n<tr>\n<td>   Sage-femme de 1re classe     </td>\n</tr>\n<tr>\n<td> :-----------------------------:</td>\n</tr>\n<tr>\n<td> :    ECHELONS       : INDICES :</td>\n</tr>\n<tr>\n<td> :                   :  BRUTS  :</td>\n</tr>\n<tr>\n<td> :-----------------------------:</td>\n</tr>\n<tr>\n<td> :  6e échelon       :   660   :</td>\n</tr>\n<tr>\n<td> :  5e échelon       :   610   :</td>\n</tr>\n<tr>\n<td> :  4e échelon       :   577   :</td>\n</tr>\n<tr>\n<td> :  3e échelon       :   546   :</td>\n</tr>\n<tr>\n<td> :  2e échelon       :   516   :</td>\n</tr>\n<tr>\n<td> : 1er échelon       :   490   :</td>\n</tr>\n<tr>\n<td> :-----------------------------:</td>\n</tr>\n<tr>\n<td>   Sage-femme de 2e classe     </td>\n</tr>\n<tr>\n<td> :-----------------------------:</td>\n</tr>\n<tr>\n<td> :    ECHELONS       : INDICES :</td>\n</tr>\n<tr>\n<td> :                   :  BRUTS  :</td>\n</tr>\n<tr>\n<td> :-----------------------------:</td>\n</tr>\n<tr>\n<td> :  9e échelon       :   625   :</td>\n</tr>\n<tr>\n<td> :  8e échelon       :   571   :</td>\n</tr>\n<tr>\n<
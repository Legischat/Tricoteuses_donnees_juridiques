  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   L'échelonnement indiciaire applicable au cadre d'emplois des coordinatrices de crèches territoriales est fixé ainsi qu'il suit :<br/>\n<br/>\n<br/>\n<table>\n<tr>\n<td> :-----------------------------:</td>\n</tr>\n<tr>\n<td> :    ECHELONS       : INDICES :</td>\n</tr>\n<tr>\n<td> :                   :  BRUTS  :</td>\n</tr>\n<tr>\n<td> :-----------------------------:</td>\n</tr>\n<tr>\n<td> :  8e échelon       :   660   :</td>\n</tr>\n<tr>\n<td> :  7e échelon       :   628   :</td>\n</tr>\n<tr>\n<td> :  6e échelon       :   597   :</td>\n</tr>\n<tr>\n<td> :  5e échelon       :   566   :</td>\n</tr>\n<tr>\n<td> :  4e échelon       :   535   :</td>\n</tr>\n<tr>\n<td> :  3e échelon       :   504   :</td>\n</tr>\n<tr>\n<td> :  2e échelon       :   481   :</td>\n</tr>\n<tr>\n<td> : 1er échelon       :   461   :</td>\n</tr>\n<tr>\n<td> :-----------------------------:</td>\n</tr>\n</table>\n<br/>"

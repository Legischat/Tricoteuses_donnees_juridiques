  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   L'échelonnement indiciaire applicable au cadre d'emplois des infirmiers territoriaux est fixé ainsi qu'il suit :<br/>\n<br/>\n    Infirmier hors classe<br/>\n<br/>\n<table>\n<tr>\n<td> :-----------------------------:</td>\n</tr>\n<tr>\n<td> :    ECHELONS       : INDICES :</td>\n</tr>\n<tr>\n<td> :                   :  BRUTS  :</td>\n</tr>\n<tr>\n<td> :-----------------------------:</td>\n</tr>\n<tr>\n<td> :  7e échelon       :   638   :</td>\n</tr>\n<tr>\n<td> :  6e échelon       :   595   :</td>\n</tr>\n<tr>\n<td> :  5e échelon       :   557   :</td>\n</tr>\n<tr>\n<td> :  4e échelon       :   522   :</td>\n</tr>\n<tr>\n<td> :  3e échelon       :   485   :</td>\n</tr>\n<tr>\n<td> :  2e échelon       :   422   :</td>\n</tr>\n<tr>\n<td> : 1er échelon       :   384   :</td>\n</tr>\n<tr>\n<td> :-----------------------------:</td>\n</tr>\n<tr>\n<td> Infirmier de classe supérieure</td>\n</tr>\n<tr>\n<td> :-----------------------------:</td>\n</tr>\n<tr>\n<td> :    ECHELONS       : INDICES :</td>\n</tr>\n<tr>\n<td> :                   :  BRUTS  :</td>\n</tr>\n<tr>\n<td> :-----------------------------:</td>\n</tr>\n<tr>\n<td> :  5e échelon       :   533   :</td>\n</tr>\n<tr>\n<td> :  4e échelon       :   501   :</td>\n</tr>\n<tr>\n<td> :  3e échelon       :   473   :</td>\n</tr>\n<tr>\n<td> :  2e échelon       :   441   :</td>\n</tr>\n<tr>\n<td> : 1er échelon       :   418   :</td>\n</tr>\n<tr>\n<td> :-----------------------------:</td>\n</tr>\n</table>\n<br/>\n  Infirmier de classe normale<br/>\n<br/>\n<table>\n<tr>\n<td> :-----------------------------:</td>\n</tr>\n<tr>\n<td> :                   : INDICES :</td>\n</tr>\n<tr>\n<td> :    ECHELONS       :  BRUTS  :</td>\n</tr>\n<tr>\n<td> :                   :    à    :</td>\n</tr>\n<tr>\n<td> :                   : compter :</td>\n</tr>\n<tr>\n<td> :-----------------------------:</td>\n</tr>\n<tr>\n<td> :                   :   du    :</td>\n</tr>\n<tr>\n<td> :                   : 01/08/91:</td>\n</tr>
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   L'échelonnement indiciaire applicable au cadre d'emplois des rééducateurs territoriaux est fixé ainsi qu'il suit :<br/>\n<br/>\n    Rééducateur hors classe<br/>\n<br/>\n<table>\n<tr>\n<td> :-----------------------------:</td>\n</tr>\n<tr>\n<td> :    ECHELONS       : INDICES :</td>\n</tr>\n<tr>\n<td> :                   :  BRUTS  :</td>\n</tr>\n<tr>\n<td> :-----------------------------:</td>\n</tr>\n<tr>\n<td> :  7e échelon       :   579   :</td>\n</tr>\n<tr>\n<td> :  6e échelon       :   547   :</td>\n</tr>\n<tr>\n<td> :  5e échelon       :   510   :</td>\n</tr>\n<tr>\n<td> :  4e échelon       :   479   :</td>\n</tr>\n<tr>\n<td> :  3e échelon       :   448   :</td>\n</tr>\n<tr>\n<td> :  2e échelon       :   423   :</td>\n</tr>\n<tr>\n<td> : 1er échelon       :   384   :</td>\n</tr>\n<tr>\n<td> :-----------------------------:</td>\n</tr>\n<tr>\n<td> Rééducateur de classe supérieure</td>\n</tr>\n<tr>\n<td> :-----------------------------:</td>\n</tr>\n<tr>\n<td> :    ECHELONS       : INDICES :</td>\n</tr>\n<tr>\n<td> :                   :  BRUTS  :</td>\n</tr>\n<tr>\n<td> :-----------------------------:</td>\n</tr>\n<tr>\n<td> :  5e échelon       :   533   :</td>\n</tr>\n<tr>\n<td> :  4e échelon       :   501   :</td>\n</tr>\n<tr>\n<td> :  3e échelon       :   473   :</td>\n</tr>\n<tr>\n<td> :  2e échelon       :   441   :</td>\n</tr>\n<tr>\n<td> : 1er échelon       :   418   :</td>\n</tr>\n<tr>\n<td> :-----------------------------:</td>\n</tr>\n</table>\n<br/>\n  Rééducateur de classe normale<br/>\n<br/>\n<table>\n<tr>\n<td> :-----------------------------:</td>\n</tr>\n<tr>\n<td> :                   : INDICES :</td>\n</tr>\n<tr>\n<td> :    ECHELONS       :  BRUTS  :</td>\n</tr>\n<tr>\n<td> :                   :    à    :</td>\n</tr>\n<tr>\n<td> :                   : compter :</td>\n</tr>\n<tr>\n<td> :-----------------------------:</td>\n</tr>\n<tr>\n<td> :                   :   du    :</td>\n</tr>\n<tr>\n<td> :                   : 01/08/91:</td>\n</tr>\n<tr>\n<td> :                   :---------:</td>\n</tr>\n<tr>\n<td> :  Echelon          :         :</td>\n</tr>\n<tr>\n<td> :  exceptionnel     :   493   :</td>\n</tr>\n<tr>\n<td> :  7e échelon       :   487   :</td>\n</tr>\n<tr>\n<td> :  6e échelon       :   460   :</td>\n</tr>\n<tr>\n<td> :  5e échelon       :   425   :</td>\n</tr>\n<tr>\n<td> :  4e échelon       :   382   :</td>\n</tr>\n<tr>\n<td> :  3e échelon       :   348   :</td>\n</tr>\n<tr>\n<td> :  2e échelon       :   317   :</td>\n</tr>\n<tr>\n<td> : 1er échelon       :   291   :</td>\n</tr>\n<tr>\n<td> :-----------------------------:</td>\n</tr>\n<tr>\n<td> :                   : INDICES :</td>\n</tr>\n<tr>\n<td> :    ECHELONS       :  BRUTS  :</td>\n</tr>\n<tr>\n<td> :                   :    à    :</td>\n</tr>\n<tr>\n<td> :                   : compter :</td>\n</tr>\n<tr>\n<td> :-----------------------------:</td>\n</tr>\n<tr>\n<td> :                   :   du    :</td>\n</tr>\n<tr>\n<td> :                   : 01/08/92:</td>\n</tr>\n<tr>\n<td> :                   :---------:</td>\n</tr>\n<tr>\n<td> :  Echelon          :         :</td>\n</tr>\n<tr>\n<td> :  exceptionnel     :   493   :</td>\n</tr>\n<tr>\n<td> :  7e échelon       :   487   :</td>\n</tr>\n<tr>\n<td> :  6e échelon       :   460   :</td>\n</tr>\n<tr>\n<td> :  5e échelon       :   425   :</td>\n</tr>\n<tr>\n<td> :  4e échelon       :   390   :</td>\n</tr>\n<tr>\n<td> :  3e échelon       :   356   :</td>\n</tr>\n<tr>\n<td> :  2e échelon       :   326   :</td>\n</tr>\n<tr>\n<td> : 1er échelon       :   301   :</td>\n</tr>\n<tr>\n<td> :-----------------------------:</td>\n</tr>\n</table>\n<br/>"

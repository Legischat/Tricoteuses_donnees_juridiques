  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   L'échelonnement indiciaire applicable au cadre d'emplois des rééducateurs territoriaux est fixé ainsi qu'il suit :<br/>\n<br/>\n    Rééducateur hors classe<br/>\n<br/>\n<table>\n<tr>\n<td> :-----------------------------:</td>\n</tr>\n<tr>\n<td> :    ECHELONS       : INDICES :</td>\n</tr>\n<tr>\n<td> :                   :  BRUTS  :</td>\n</tr>\n<tr>\n<td> :-----------------------------:</td>\n</tr>\n<tr>\n<td> :  7e échelon       :   638   :</td>\n</tr>\n<tr>\n<td> :  6e échelon       :   595   :</td>\n</tr>\n<tr>\n<td> :  5e échelon       :   557   :</td>\n</tr>\n<tr>\n<td> :  4e échelon       :   522   :</td>\n</tr>\n<tr>\n<td> :  3e échelon       :   485   :</td>\n</tr>\n<tr>\n<td> :  2e échelon       :   455   :</td>\n</tr>\n<tr>\n<td> : 1er échelon       :   422   :</td>\n</tr>\n<tr>\n<td> :-----------------------------:</td>\n</tr>\n<tr>\n<td>     Rééducateur de classe</td>\n</tr>\n<tr>\n<td>           supérieure</td>\n</tr>\n<tr>\n<td> :-----------------------------:</td>\n</tr>\n<tr>\n<td> :    ECHELONS       : INDICES :</td>\n</tr>\n<tr>\n<td> :                   :  BRUTS  :</td>\n</tr>\n<tr>\n<td> :-----------------------------:</td>\n</tr>\n<tr>\n<td> :  5e échelon       :   593   :</td>\n</tr>\n<tr>\n<td> :  4e échelon       :   565   :</td>\n</tr>\n<tr>\n<td> :  3e échelon       :   530   :</td>\n</tr>\n<tr>\n<td> :  2e échelon       :   499   :</td>\n</tr>\n<tr>\n<td> : 1er échelon       :   471   :</td>\n</tr>\n<tr>\n<td> :-----------------------------:</td>\n</tr>\n<tr>\n<td>  Rééducateur de classe normale </td>\n</tr>\n<tr>\n<td> :-----------------------------:</td>\n</tr>\n<tr>\n<td> :    ECHELONS       : INDICES :</td>\n</tr>\n<tr>\n<td> :                   :  BRUTS  :</td>\n</tr>\n<tr>\n<td> :-----------------------------:</td>\n</tr>\n<tr>\n<td> :  8e échelon       :   558   :</td>\n</tr>\n<tr>\n<td> :  7e échelon       :   519   :</td>\n</tr>\n<tr>\n<td> :  6e échelon       :   480   :</td>\n</tr>\n<tr>\n<td> :  5e échelon       :   443   :</td>\n</tr>\n<tr>\n<td> :  4e échelon       :   407   :</td>\n</tr>\n<tr>\n<td> :  3e échelon       :   372   :</td>\n</tr>\n<tr>\n<td> :  2e échelon       :   346   :</td>\n</tr>\n<tr>\n<td> : 1er échelon       :   322   :</td>\n</tr>\n<tr>\n<td> :-----------------------------:</td>\n</tr>\n</table>\n<br/>"

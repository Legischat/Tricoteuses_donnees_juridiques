  "BLOC_TEXTUEL": {
    "CONTENU": "<p>L'échelonnement indiciaire applicable au cadre d'emplois des rééducateurs territoriaux est fixé ainsi qu'il suit :</p>\n<table>\n<tbody>\n<tr>\n<td width=\"340\">\n<p align=\"center\">ÉCHELONS</p>\n</td>\n<td width=\"340\">\n<p align=\"center\">INDICES BRUTS</p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" width=\"680\">\n<p align=\"center\">Rééducateur de classe supérieure</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"340\">\n<p>6e échelon</p>\n</td>\n<td width=\"340\">\n<p align=\"right\">638 </p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"340\">\n<p>5e échelon</p>\n</td>\n<td width=\"340\">\n<p align=\"right\">613 </p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"340\">\n<p>4e échelon</p>\n</td>\n<td width=\"340\">\n<p align=\"right\">580 </p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"340\">\n<p>3e échelon</p>\n</td>\n<td width=\"340\">\n<p align=\"right\">548 </p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"340\">\n<p>2e échelon</p>\n</td>\n<td width=\"340\">\n<p align=\"right\">514 </p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"340\">\n<p>1er échelon</p>\n</td>\n<td width=\"340\">\n<p align=\"right\">471 </p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" width=\"680\">\n<p align=\"center\">Rééducateur de classe normale</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"340\">\n<p>8e échelon</p>\n</td>\n<td width=\"340\">\n<p align=\"right\">568 </p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"340\">\n<p>7e échelon</p>\n</td>\n<td width=\"340\">\n<p align=\"right\">519 </p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"340\">\n<p>6e échelon</p>\n</td>\n<td width=\"340\">\n<p align=\"right\">480 </p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"340\">\n<p>5e échelon</p>\n</td>\n<td width=\"340\">\n<p align=\"right\">443 </p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"340\">\n<p>4e échelon</p>\n</td>\n<td width=\"340\">\n<p align=\"right\">407 </p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"340\">\n<p>3e échelon</p>\n</td>\n<td width=\"340\">\n<p align=\"right\">372 </p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"340\">\n<p>2e échelon</p>\n</td>\n<td width=\"340\">\n<p align=\"right\">346 </p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"340\">\n<p>1er échelon</p>\n</td>\n<td width=\"340\">\n<p align=\"right\">322 </p>\n</td>\n</tr>\n</tbody>\n</table>."

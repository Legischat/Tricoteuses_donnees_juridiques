  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   La durée maximale et la durée minimale du temps passé dans chacun des échelons des grades sont fixées ainsi qu'il suit :<br/>\n<br/>\n<br/>\n<table>\n<tr>\n<td> :-----------------------------:</td>\n</tr>\n<tr>\n<td> :   GRADES   :      DUREES    :</td>\n</tr>\n<tr>\n<td> :     ET     :----------------:</td>\n</tr>\n<tr>\n<td> :  ECHELONS  :  Max. :  Min.  :</td>\n</tr>\n<tr>\n<td> :-----------------------------:</td>\n</tr>\n<tr>\n<td> :        Manipulateur         :</td>\n</tr>\n<tr>\n<td> :     d'électroradiologie     :</td>\n</tr>\n<tr>\n<td> :         hors classe         :</td>\n</tr>\n<tr>\n<td> :-----------------------------:</td>\n</tr>\n<tr>\n<td> : 7e échelon :   -   :   -    :</td>\n</tr>\n<tr>\n<td> :            :       :        :</td>\n</tr>\n<tr>\n<td> : 6e échelon : 3 ans : 2 ans  :</td>\n</tr>\n<tr>\n<td> :            : 6 mois: 6 mois :</td>\n</tr>\n<tr>\n<td> :            :       :        :</td>\n</tr>\n<tr>\n<td> : 5e échelon : 3 ans : 2 ans  :</td>\n</tr>\n<tr>\n<td> :            : 6 mois: 6 mois :</td>\n</tr>\n<tr>\n<td> :            :       :        :</td>\n</tr>\n<tr>\n<td> : 4e échelon : 3 ans : 2 ans  :</td>\n</tr>\n<tr>\n<td> :            : 6 mois: 6 mois :</td>\n</tr>\n<tr>\n<td> :            :       :        :</td>\n</tr>\n<tr>\n<td> : 3e échelon : 2 ans : 1 an   :</td>\n</tr>\n<tr>\n<td> :            : 6 mois: 6 mois :</td>\n</tr>\n<tr>\n<td> :            :       :        :</td>\n</tr>\n<tr>\n<td> : 2e échelon : 2 ans : 1 an   :</td>\n</tr>\n<tr>\n<td> :            : 2 mois: 6 mois :</td>\n</tr>\n<tr>\n<td> :            :       :        :</td>\n</tr>\n<tr>\n<td> :1er échelon : 1 an  : 1 an   :</td>\n</tr>\n<tr>\n<td> :            :       :        :</td>\n</tr>\n<tr>\n<td> :-----------------------------:</td>\n</tr>\n<tr>\n<td> : Manipulateur                :</td>\n</tr>\n<tr>\n<td> : d'électroradiologie         :</td>\n</tr>\n<tr>\n<td> : de classe supérieure        :</td>\n</tr>\n<tr>\n<td> :----------------------
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   La durée maximale et la durée minimale du temps passé dans chacun des échelons des grades sont fixées ainsi qu'il suit :<br/>\n<br/>\n<br/>\n<table>\n<tr>\n<td> :-----------------------------:</td>\n</tr>\n<tr>\n<td> : GRADES : DUREES :</td>\n</tr>\n<tr>\n<td> : ET :----------------:</td>\n</tr>\n<tr>\n<td> : ECHELONS : Max. : Min. :</td>\n</tr>\n<tr>\n<td> :-----------------------------:</td>\n</tr>\n<tr>\n<td> : Assistant qualifié de :</td>\n</tr>\n<tr>\n<td> : laboratoire hors classe :</td>\n</tr>\n<tr>\n<td> :-----------------------------:</td>\n</tr>\n<tr>\n<td> : 7e échelon : - : - :</td>\n</tr>\n<tr>\n<td> : : : :</td>\n</tr>\n<tr>\n<td> : 6e échelon : 3 ans : 2 ans :</td>\n</tr>\n<tr>\n<td> : : 6 mois: 6 mois :</td>\n</tr>\n<tr>\n<td> : : : :</td>\n</tr>\n<tr>\n<td> : 5e échelon : 3 ans : 2 ans :</td>\n</tr>\n<tr>\n<td> : : 6 mois: 6 mois :</td>\n</tr>\n<tr>\n<td> : : : :</td>\n</tr>\n<tr>\n<td> : 4e échelon : 3 ans : 2 ans :</td>\n</tr>\n<tr>\n<td> : : 6 mois: 6 mois :</td>\n</tr>\n<tr>\n<td> : : : :</td>\n</tr>\n<tr>\n<td> : 3e échelon : 2 ans : 1 an :</td>\n</tr>\n<tr>\n<td> : : 6 mois: 6 mois :</td>\n</tr>\n<tr>\n<td> : : : :</td>\n</tr>\n<tr>\n<td> : 2e échelon : 2 ans : 1 an :</td>\n</tr>\n<tr>\n<td> : : 6 mois: 6 mois :</td>\n</tr>\n<tr>\n<td> : : : :</td>\n</tr>\n<tr>\n<td> :1er échelon : 1 an : 1 an :</td>\n</tr>\n<tr>\n<td> : : : :</td>\n</tr>\n<tr>\n<td> :-----------------------------:</td>\n</tr>\n</table>\n<br/>\n<br/>\n<table>\n<tr>\n<td>:-----------------------------:</td>\n</tr>\n<tr>\n<td> : GRADES : DUREES :</td>\n</tr>\n<tr>\n<td> : ET :----------------:</td>\n</tr>\n<tr>\n<td> : ECHELONS : Max. : Min. :</td>\n</tr>\n<tr>\n<td> :-----------------------------:</td>\n</tr>\n<tr>\n<td> : Assistant qualifié de :</td>\n</tr>\n<tr>\n<td> : laboratoire de classe :</td>\n</tr>\n<tr>\n<td> : supérieure :</td>\n</tr>\n<tr>\n<td> :-----------------------------:</td>\n</tr>\n<tr>\n<td> : 5e échelon : - : - :</td>\n</tr>\n<tr>\n<td> : : : :</td>\n</tr>\n<tr>\n<td> : 4e échelon : 4 ans : 4 ans :</td>\n</tr>\n<tr>\n<td> : : 3 mois: :</td>\n</tr>\n<tr>\n<td> : : : :</td>\n</tr>\n<tr>\n<td> : 3e échelon : 3 ans : 3 ans :</td>\n</tr>\n<tr>\n<td> : : 3 mois: :</td>\n</tr>\n<tr>\n<td> : : : :</td>\n</tr>\n<tr>\n<td> : 2e échelon : 3 ans : 3 ans :</td>\n</tr>\n<tr>\n<td> : : 3 mois: :</td>\n</tr>\n<tr>\n<td> : : : :</td>\n</tr>\n<tr>\n<td> :1er échelon : 3 ans : 3 ans :</td>\n</tr>\n<tr>\n<td> : : 3 mois: :</td>\n</tr>\n<tr>\n<td> :-----------------------------:</td>\n</tr>\n</table>\n<br/>\n<br/>\n<table>\n<tr>\n<td>:-----------------------------:</td>\n</tr>\n<tr>\n<td> : Assistant qualifié de :</td>\n</tr>\n<tr>\n<td> : laboratoire de classe :</td>\n</tr>\n<tr>\n<td> : normale :</td>\n</tr>\n<tr>\n<td> :-----------------------------:</td>\n</tr>\n<tr>\n<td> : 8e échelon : - : - :</td>\n</tr>\n<tr>\n<td> : : : :</td>\n</tr>\n<tr>\n<td> : 7e échelon : 4 ans : 4 ans :</td>\n</tr>\n<tr>\n<td> : : 6 mois: :</td>\n</tr>\n<tr>\n<td> : : : :</td>\n</tr>\n<tr>\n<td> : 6e échelon : 4 ans : 4 ans :</td>\n</tr>\n<tr>\n<td> : : 6 mois: :</td>\n</tr>\n<tr>\n<td> : : : :</td>\n</tr>\n<tr>\n<td> : 5e échelon : 4 ans : 4 ans :</td>\n</tr>\n<tr>\n<td> : : 6 mois: :</td>\n</tr>\n<tr>\n<td> : : : :</td>\n</tr>\n<tr>\n<td> : 4e échelon : 3 ans : 3 ans :</td>\n</tr>\n<tr>\n<td> : : 6 mois: :</td>\n</tr>\n<tr>\n<td> : : : :</td>\n</tr>\n<tr>\n<td> : 3e échelon : 3 ans : 3 ans :</td>\n</tr>\n<tr>\n<td> : : 6 mois: :</td>\n</tr>\n<tr>\n<td> : : : :</td>\n</tr>\n<tr>\n<td> : 2e échelon : 2 ans : 2 ans :</td>\n</tr>\n<tr>\n<td> : : 6 mois: :</td>\n</tr>\n<tr>\n<td> : : : :</td>\n</tr>\n<tr>\n<td> :1er échelon : 2 ans : 1 an :</td>\n</tr>\n<tr>\n<td> : : : :</td>\n</tr>\n<tr>\n<td> :-----------------------------:</td>\n</tr>\n</table>\n<br/>"

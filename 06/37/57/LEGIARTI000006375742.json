  "BLOC_TEXTUEL": {
    "CONTENU": "<p>L'échelonnement indiciaire applicable au cadre d'emplois des assistants territoriaux qualifiés de laboratoire est fixé ainsi qu'il suit :</p>\n<p align=\"center\">Assistant qualifié de laboratoire hors classe</p>\n<p align=\"center\"> </p>\n<table>\n<tbody>\n<tr>\n<td width=\"454\">\n<p align=\"center\">ÉCHELONS</p>\n</td>\n<td width=\"227\">\n<p align=\"center\">INDICES BRUTS</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"454\">\n<p>7e échelon</p>\n</td>\n<td valign=\"top\" width=\"227\">\n<p align=\"center\">638</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"454\">\n<p>6e échelon</p>\n</td>\n<td valign=\"top\" width=\"227\">\n<p align=\"center\">595</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"454\">\n<p>5e échelon</p>\n</td>\n<td valign=\"top\" width=\"227\">\n<p align=\"center\">557</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"454\">\n<p>4e échelon</p>\n</td>\n<td valign=\"top\" width=\"227\">\n<p align=\"center\">522</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"454\">\n<p>3e échelon</p>\n</td>\n<td valign=\"top\" width=\"227\">\n<p align=\"center\">485</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"454\">\n<p>2e échelon</p>\n</td>\n<td valign=\"top\" width=\"227\">\n<p align=\"center\">455</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"454\">\n<p>1er échelon</p>\n</td>\n<td valign=\"top\" width=\"227\">\n<p align=\"center\">422</p>\n</td>\n</tr>\n</tbody>\n</table>\n<p align=\"center\">Assistant qualifié de laboratoire de classe supérieure</p>\n<table>\n<tbody>\n<tr>\n<td width=\"454\">\n<p align=\"center\">ÉCHELONS</p>\n</td>\n<td width=\"227\">\n<p align=\"center\">INDICES BRUTS</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"454\">\n<p>5e échelon</p>\n</td>\n<td valign=\"top\" width=\"227\">\n<p align=\"center\">533</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"454\">\n<p>4e échelon</p>\n</td>\n<td valign=\"top\" width=\"227\">\n<p align=\"center\">501</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"454\">\n<p>3e échelon</p>\n</td>\n<td valign=\"top\" width=\"227\">\n<p align=\"center\">473</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"454\">\n<p>2e échelon</p>\n</td>\n<td valign=\"top\" width=\"227\">\n<p align=\"center\">441</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"454\">\n<p>1er échelon</p>\n</td>\n<td valign=\"top\" width=\"227\">\n<p align=\"center\">418</p>\n</td>\n</tr>\n</tbody>\n</table>\n<p align=\"center\">Assistant qualifié de laboratoire de classe normale</p>\n<table>\n<tbody>\n<tr>\n<td rowspan=\"2\" width=\"454\">\n<p align=\"center\">ÉCHELONS</p>\n</td>\n<td colspan=\"2\" width=\"227\">\n<p align=\"center\">INDICES BRUTS<br/>à compter</p>\n</td>\n</tr>\n<tr>\n<td width=\"113\">\n<p align=\"center\">Du 1er-08-91</p>\n</td>\n<td width=\"113\">\n<p align=\"center\">Du 1er-08-92</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"454\">\n<p>8e échelon</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p align=\"center\">493</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p align=\"center\">493</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"454\">\n<p>7e échelon</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p align=\"center\">487</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p align=\"center\">487</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"454\">\n<p>6e échelon</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p align=\"center\">460</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p align=\"center\">460</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"454\">\n<p>5e échelon</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p align=\"center\">425</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p align=\"center\">425</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"454\">\n<p>4e échelon</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p align=\"center\">382</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p align=\"center\">390</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"454\">\n<p>3e échelon</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p align=\"center\">348</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p align=\"center\">356</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"454\">\n<p>2e échelon</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p align=\"center\">317</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p align=\"center\">326</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"454\">\n<p>1er échelon</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p align=\"center\">291</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p align=\"center\">301</p>\n</td>\n</tr>\n</tbody>\n</table>"

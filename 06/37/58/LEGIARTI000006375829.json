  "BLOC_TEXTUEL": {
    "CONTENU": "<p>L'échelonnement indiciaire applicable au cadre d'emplois des secrétaires médico-sociaux territoriaux est fixé ainsi qu'il suit :</p>\n<p align=\"center\">Secrétaire médico-social en chef</p>\n<table>\n<tbody>\n<tr>\n<td width=\"307\">\n<p align=\"center\">ECHELONS</p>\n</td>\n<td width=\"307\">\n<p align=\"center\">INDICES BRUTS</p>\n</td>\n</tr>\n<tr>\n<td width=\"307\">\n<p>7e échelon</p>\n</td>\n<td width=\"307\">\n<p align=\"center\">579</p>\n</td>\n</tr>\n<tr>\n<td width=\"307\">\n<p>6e échelon</p>\n</td>\n<td width=\"307\">\n<p align=\"center\">547</p>\n</td>\n</tr>\n<tr>\n<td width=\"307\">\n<p>5e échelon</p>\n</td>\n<td width=\"307\">\n<p align=\"center\">510</p>\n</td>\n</tr>\n<tr>\n<td width=\"307\">\n<p>4e échelon</p>\n</td>\n<td width=\"307\">\n<p align=\"center\">479</p>\n</td>\n</tr>\n<tr>\n<td width=\"307\">\n<p>3e échelon</p>\n</td>\n<td width=\"307\">\n<p align=\"center\">448</p>\n</td>\n</tr>\n<tr>\n<td width=\"307\">\n<p>2e échelon</p>\n</td>\n<td width=\"307\">\n<p align=\"center\">423</p>\n</td>\n</tr>\n<tr>\n<td width=\"307\">\n<p>1er échelon</p>\n</td>\n<td width=\"307\">\n<p align=\"center\">384</p>\n</td>\n</tr>\n</tbody>\n</table>\n<p align=\"center\"> </p>\n<p align=\"center\">Secrétaire médico-social principal</p>\n<p align=\"center\"> </p>\n<table>\n<tbody>\n<tr>\n<td width=\"193\">\n<p align=\"center\">ECHELONS</p>\n</td>\n<td width=\"185\">\n<p align=\"center\">INDICES BRUTS</p>\n</td>\n</tr>\n<tr>\n<td width=\"193\">\n<p>5e échelon</p>\n</td>\n<td width=\"185\">\n<p align=\"center\">533</p>\n</td>\n</tr>\n<tr>\n<td width=\"193\">\n<p>4e échelon</p>\n</td>\n<td width=\"185\">\n<p align=\"center\">501</p>\n</td>\n</tr>\n<tr>\n<td width=\"193\">\n<p>3e échelon</p>\n</td>\n<td width=\"185\">\n<p align=\"center\">473</p>\n</td>\n</tr>\n<tr>\n<td width=\"193\">\n<p>2e échelon</p>\n</td>\n<td width=\"185\">\n<p align=\"center\">441</p>\n</td>\n</tr>\n<tr>\n<td width=\"193\">\n<p>1er échelon</p>\n</td>\n<td width=\"185\">\n<p align=\"center\">418</p>\n</td>\n</tr>\n</tbody>\n</table>\n<p align=\"center\">Secrétaire médico-social</p>\n<table>\n<tbody>\n<tr>\n<td width=\"307\">\n<p align=\"center\">ECHELONS</p>\n</td>\n<td width=\"307\">\n<p align=\"center\">INDICES BRUTS</p>\n</td>\n</tr>\n<tr>\n<td width=\"307\">\n<p>12e échelon</p>\n</td>\n<td width=\"307\">\n<p align=\"center\">474</p>\n</td>\n</tr>\n<tr>\n<td width=\"307\">\n<p>11e échelon</p>\n</td>\n<td width=\"307\">\n<p align=\"center\">453</p>\n</td>\n</tr>\n<tr>\n<td width=\"307\">\n<p>10e échelon</p>\n</td>\n<td width=\"307\">\n<p align=\"center\">430</p>\n</td>\n</tr>\n<tr>\n<td width=\"307\">\n<p>9e échelon</p>\n</td>\n<td width=\"307\">\n<p align=\"center\">395</p>\n</td>\n</tr>\n<tr>\n<td width=\"307\">\n<p>8e échelon</p>\n</td>\n<td width=\"307\">\n<p align=\"center\">389</p>\n</td>\n</tr>\n<tr>\n<td width=\"307\">\n<p>7e échelon</p>\n</td>\n<td width=\"307\">\n<p align=\"center\">379</p>\n</td>\n</tr>\n<tr>\n<td width=\"307\">\n<p>6e échelon</p>\n</td>\n<td width=\"307\">\n<p align=\"center\">360</p>\n</td>\n</tr>\n<tr>\n<td width=\"307\">\n<p>5e échelon</p>\n</td>\n<td width=\"307\">\n<p align=\"center\">345</p>\n</td>\n</tr>\n<tr>\n<td width=\"307\">\n<p>4e échelon</p>\n</td>\n<td width=\"307\">\n<p align=\"center\">336</p>\n</td>\n</tr>\n<tr>\n<td width=\"307\">\n<p>3e échelon</p>\n</td>\n<td width=\"307\">\n<p align=\"center\">321</p>\n</td>\n</tr>\n<tr>\n<td width=\"307\">\n<p>2e échelon</p>\n</td>\n<td width=\"307\">\n<p align=\"center\">309</p>\n</td>\n</tr>\n<tr>\n<td width=\"307\">\n<p>1er échelon</p>\n</td>\n<td width=\"307\">\n<p align=\"center\">298</p>\n</td>\n</tr>\n</tbody>\n</table>"

  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les candidats au concours d'accès aux cadres d'emplois des :<br/>\n<br/>   - médecins territoriaux ;<br/>\n<br/>   - psychologues territoriaux ;<br/>\n<br/>   - sages-femmes territoriales ;<br/>\n<br/>   - biologistes, vétérinaires et pharmaciens territoriaux,<br/>\n doivent être titulaires des titres ou diplômes prévus au titre II des décrets du 28 août 1992 susvisés.<br/>"
  },

  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les candidats au concours externe d'accès au cadre d'emplois des éducateurs territoriaux des activités physiques et sportives doivent être titulaires :<br/>\n<br/>   1° Du baccalauréat de l'enseignement général,<br/>\n<br/>         ou<br/>\n<br/>   2° D'un titre ou diplôme homologué au moins au niveau IV en application de l'article 8 de la loi du 16 juillet 1971 susvisée.<br/>"
  },

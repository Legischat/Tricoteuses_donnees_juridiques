 an.</p>\n</td>\n</tr>\n<tr>\n<td width=\"298\">\n<p>- avant 1 an</p>\n</td>\n<td width=\"97\">\n<p align=\"center\">3e échelon</p>\n</td>\n<td width=\"340\">\n<p>Ancienneté acquise majorée de 1 an.</p>\n</td>\n</tr>\n<tr>\n<td width=\"298\">\n<p>3e échelon :</p>\n</td>\n<td width=\"97\">\n<p align=\"center\"> </p>\n</td>\n<td width=\"340\"/>\n</tr>\n<tr>\n<td width=\"298\">\n<p>- après 1 an</p>\n</td>\n<td width=\"97\">\n<p align=\"center\">3e échelon</p>\n</td>\n<td width=\"340\">\n<p>Ancienneté acquise moins 1 an.</p>\n</td>\n</tr>\n<tr>\n<td width=\"298\">\n<p>- avant 1 an</p>\n</td>\n<td width=\"97\">\n<p align=\"center\">2e échelon</p>\n</td>\n<td width=\"340\">\n<p>Ancienneté acquise majorée de 1 an.</p>\n</td>\n</tr>\n<tr>\n<td width=\"298\">\n<p>2° échelon :</p>\n</td>\n<td width=\"97\">\n<p align=\"center\"> </p>\n</td>\n<td width=\"340\"/>\n</tr>\n<tr>\n<td width=\"298\">\n<p>- après 1 an</p>\n</td>\n<td width=\"97\">\n<p align=\"center\">2e échelon</p>\n</td>\n<td width=\"340\">\n<p>Ancienneté acquise moins 1 an.</p>\n</td>\n</tr>\n<tr>\n<td width=\"298\">\n<p>- avant 1 an</p>\n</td>\n<td width=\"97\">\n<p align=\"center\">1er échelon</p>\n</td>\n<td width=\"340\">\n<p>Ancienneté acquise.</p>\n</td>\n</tr>\n<tr>\n<td width=\"378\">\n<p>1er échelon</p>\n</td>\n<td width=\"97\">\n<p align=\"center\">1er échelon</p>\n</td>\n<td width=\"340\">\n<p>Sans ancienneté.</p>\n</td>\n</tr>\n</tbody>\n</table>."

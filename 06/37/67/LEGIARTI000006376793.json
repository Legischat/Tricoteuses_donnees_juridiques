  "BLOC_TEXTUEL": {
    "CONTENU": "<p>L'échelonnement indiciaire applicable au grade de chef de police municipale est le suivant :</p>\n<table align=\"center\" border=\"1\" cellpadding=\"0\" cellspacing=\"0\" width=\"378\">\n<tbody>\n<tr>\n<td width=\"189\">\n<p align=\"center\">ECHELONS</p>\n</td>\n<td width=\"189\">\n<p align=\"center\">INDICES BRUTS</p>\n</td>\n</tr>\n<tr>\n<td width=\"189\">\n<p>6e échelon</p>\n</td>\n<td width=\"189\">\n<p align=\"center\">499</p>\n</td>\n</tr>\n<tr>\n<td width=\"189\">\n<p>5e échelon</p>\n</td>\n<td width=\"189\">\n<p align=\"center\">453</p>\n</td>\n</tr>\n<tr>\n<td width=\"189\">\n<p>4e échelon</p>\n</td>\n<td width=\"189\">\n<p align=\"center\">430</p>\n</td>\n</tr>\n<tr>\n<td width=\"189\">\n<p>3e échelon</p>\n</td>\n<td width=\"189\">\n<p align=\"center\">395</p>\n</td>\n</tr>\n<tr>\n<td width=\"189\">\n<p>2e échelon</p>\n</td>\n<td width=\"189\">\n<p align=\"center\">377</p>\n</td>\n</tr>\n<tr>\n<td width=\"189\">\n<p>1er échelon</p>\n</td>\n<td width=\"189\">\n<p align=\"center\">358</p>\n</td>\n</tr>\n</tbody>\n</table>"

  "BLOC_TEXTUEL": {
    "CONTENU": "<p>A titre transitoire, du 1er août 1995 au 31 décembre 1996, l'échelonnement indiciaire applicable au grade provisoire de rédacteur-chef est fixé ainsi qu'il suit :</p>\n<br/>\n<table>\n<tbody>\n<tr>\n<td width=\"191\">\n<p align=\"center\">ECHELONS</p>\n</td>\n<td width=\"187\">\n<p align=\"center\">INDICES BRUTS</p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" width=\"378\">\n<p align=\"center\">Rédacteur-chef</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"191\">\n<p>7<sup>e</sup> échelon </p>\n</td>\n<td width=\"187\">\n<p align=\"center\">579</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"191\">\n<p>6<sup>e</sup> échelon </p>\n</td>\n<td width=\"187\">\n<p align=\"center\">547</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"191\">\n<p>5<sup>e</sup> échelon </p>\n</td>\n<td width=\"187\">\n<p align=\"center\">510</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"191\">\n<p>4<sup>e</sup> échelon </p>\n</td>\n<td width=\"187\">\n<p align=\"center\">479</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"191\">\n<p>3<sup>e</sup> échelon </p>\n</td>\n<td width=\"187\">\n<p align=\"center\">448</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"191\">\n<p>2<sup>e</sup> échelon </p>\n</td>\n<td width=\"187\">\n<p align=\"center\">423</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"191\">\n<p>1<sup>er</sup> échelon </p>\n</td>\n<td width=\"187\">\n<p align=\"center\">384</p>\n</td>\n</tr>\n</tbody>\n</table>"
  },

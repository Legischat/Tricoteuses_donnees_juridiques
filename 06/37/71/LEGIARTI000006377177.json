  "BLOC_TEXTUEL": {
    "CONTENU": "A titre transitoire, du 1er août 1995 au 31 décembre 1996, l'échelonnement indiciaire applicable au grade provisoire de technicien-chef est fixé ainsi qu'il suit :<br/>\n<br/>\n<br/>\n<table>\n<tbody>\n<tr>\n<td align=\"left\" valign=\"middle\"/>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">\n<strong>INDICES BRUTS</strong>\n</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">\n<i>Technicien chef :</i>\n</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<pre> </pre>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">8e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">579</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">7e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">547</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">6e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">510</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">5e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">474</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">4e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">438</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">3e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">392</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">2e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">359</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">1er échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">324</p>\n</td>\n</tr>\n</tbody>\n</table>\n<br/>"
  },

  "BLOC_TEXTUEL": {
    "CONTENU": "<p>Sont créés à la base du grade d'éducateur principal de jeunes enfants, pour le reclassement au 1er août 1997 des éducateurs principaux de jeunes enfants qui se trouvent au 1er et au 2e échelon, des 1er et 2e échelons provisoires dotés respectivement des indices bruts 414 et 440, affectés des durées maximale et minimale suivantes :</p>\n<br/>\n<table border=\"2\" cellpadding=\"2\">\n<tbody>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">\n<strong>ECHELONS</strong>\n</p>\n</td>\n<td align=\"left\" colspan=\"2\" valign=\"middle\">\n<p align=\"center\">DUREES</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<pre> </pre>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">Maximale</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">Minimale</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">2e échelon provisoire</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">1 an 3 mois</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">1 an</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">1er échelon provisoire</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">1 an 3 mois</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">1 an</p>\n</td>\n</tr>\n</tbody>\n</table>"
  },

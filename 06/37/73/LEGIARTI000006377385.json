  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les conseillers territoriaux principaux des activités physiques et sportives sont reclassés dans le nouveau grade de conseiller principal des activités physiques et sportives dans les conditions suivantes :<br/>\n<br/>\n<table>\n<tr>\n<td> :------------------------------------------------------------:</td>\n</tr>\n<tr>\n<td> :             SITUATION               :      ANCIENNETE      :</td>\n</tr>\n<tr>\n<td> :-------------------------------------:      D'ECHELON       :</td>\n</tr>\n<tr>\n<td> :     ANCIENNE     :      NOUVELLE    :                      :</td>\n</tr>\n<tr>\n<td> :------------------------------------------------------------:</td>\n</tr>\n<tr>\n<td> :                  :    Conseiller    :                      :</td>\n</tr>\n<tr>\n<td> :                  :    principal     :                      :</td>\n</tr>\n<tr>\n<td> :                  :  de 1re classe   :                      :</td>\n</tr>\n<tr>\n<td> : 6e échelon :     :                  :                      :</td>\n</tr>\n<tr>\n<td> : - après 1 an     :                  :                      :</td>\n</tr>\n<tr>\n<td> :         6 mois   :   1er échelon    :  Sans ancienneté     :</td>\n</tr>\n<tr>\n<td> :                  :                  :                      :</td>\n</tr>\n<tr>\n<td> :                  :   Conseiller     :                      :</td>\n</tr>\n<tr>\n<td> :                  :    principal     :                      :</td>\n</tr>\n<tr>\n<td> :                  :   de 2e classe   :                      :</td>\n</tr>\n<tr>\n<td> :                  :                  :                      :</td>\n</tr>\n<tr>\n<td> : - avant 1 an     :                  :                      :</td>\n</tr>\n<tr>\n<td> :         6 mois   :    6e échelon    :  Ancienneté acquise  :</td>\n</tr>\n<tr>\n<td> :                  :                  :  majorée de 6 mois   :</td>\n</tr>\n<tr>\n<td> : 5e échelon :     :                  :                      :</td>\n</tr>\n<tr>\n<td> : - après 2 ans    :                  :                      :</td>\n</tr>\n<tr>\n<td> :         6 mois   :    6e échelon    :      6 mois          :</td>\n</tr>\n<tr>\n<td> : - avant 2 ans    :                  :                      :</td>\n</tr>\n<tr>\n<td> :         6 mois   :    5e échelon    :  Ancienneté acquise  :</td>\n</tr>\n<tr>\n<td> :                  :                  :                      :</td>\n</tr>\n<tr>\n<td> :  4e échelon      :    4e échelon    :  Ancienneté acquise  :</td>\n</tr>\n<tr>\n<td> :                  :                  :                      :</td>\n</tr>\n<tr>\n<td> :  3e échelon      :    3e échelon    :  Ancienneté acquise  :</td>\n</tr>\n<tr>\n<td> :                  :                  :                      :</td>\n</tr>\n<tr>\n<td> :  2e échelon      :    2e échelon    :  Ancienneté acquise  :</td>\n</tr>\n<tr>\n<td> :                  :                  :                      :</td>\n</tr>\n<tr>\n<td> : 1er échelon      :   1er échelon    :  Ancienneté acquise  :</td>\n</tr>\n<tr>\n<td> :                  :                  :  majorée de 6 mois   :</td>\n</tr>\n<tr>\n<td> :                  :                  :                      :</td>\n</tr>\n<tr>\n<td> :------------------------------------------------------------:</td>\n</tr>\n</table>\n<br/>"
  },

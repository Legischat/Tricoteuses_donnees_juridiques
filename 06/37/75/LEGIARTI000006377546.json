  "BLOC_TEXTUEL": {
    "CONTENU": "<p>Sont intégrés dans le cadre d'emplois, après avoir satisfait à un examen professionnel organisé par les délégations régionales ou interdépartementales du Centre national de la fonction publique territoriale, les agents de maîtrise comptant au moins huit années de services effectifs dans le grade d'agent de maîtrise qualifié.</p>\n<p>Le programme des épreuves de l'examen professionnel est fixé par arrêté du ministre chargé des collectivités locales.</p>\n<p>Les fonctionnaires sont intégrés dans les conditions suivantes :<br/>\n<br/>\n<br/>\n</p>\n<table>\n<tbody>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">\n<strong>SITUATION ACTUELLE</strong>\n</p>\n</td>\n<td align=\"left\" colspan=\"2\" valign=\"middle\">\n<p align=\"center\">\n<strong>SITUATION NOUVELLE</strong>\n</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">Agent de maîtrise qualifié</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">Contrôleur</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">Ancienneté d'échelon </p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">5e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">11e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">Sans ancienneté</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">4e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">10e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">Ancienneté acquise</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">3e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">9e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">Ancienneté acquise</p>\n</td>\n</tr>\n</tbody>\n</table>\n<br/>"
  },

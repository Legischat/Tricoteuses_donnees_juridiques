  "BLOC_TEXTUEL": {
    "CONTENU": "<p>La durée maximale et la durée minimale du temps passé dans chacun des échelons des grades sont fixées ainsi qu'il suit :</p>\n<br/>\n<table>\n<tbody>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">GRADES ET ECHELONS</p>\n</td>\n<td align=\"left\" colspan=\"2\" valign=\"middle\">\n<p align=\"center\">DUREES</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<pre> </pre>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">Maximale</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">Minimale</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">\n<i>Chef de service de police de classe exceptionnelle</i>\n</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<pre> </pre>\n</td>\n<td align=\"left\" valign=\"middle\">\n<pre> </pre>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">8e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">-</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">-</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">7e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">4 ans 3 mois</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">3 ans 9 mois</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">6e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">3 ans 3 mois</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">2 ans 9 mois</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">5e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">3 ans 3 mois</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">2 ans 9 mois</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">4e échelon</p>\n</td>\n<td align=\"l
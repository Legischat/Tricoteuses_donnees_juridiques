  "BLOC_TEXTUEL": {
    "CONTENU": "<p>Le grade provisoire de lieutenant comprend huit échelons.</p>\n<p>L'échelonnement indiciaire et la durée maximale et minimale du temps passé dans chacun des échelons du grade provisoire de lieutenant sont fixés ainsi qu'il suit : </p>\n<p align=\"justify\"> </p>\n<table border=\"2\" cellpadding=\"2\">\n<tbody>\n<tr>\n<td align=\"left\" valign=\"middle\">GRADES et échelons</td>\n<td align=\"left\" valign=\"middle\">INDICES bruts</td>\n<td align=\"left\" colspan=\"2\" valign=\"middle\">DUREES</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\"> </td>\n<td align=\"left\" valign=\"middle\"> </td>\n<td align=\"left\" valign=\"middle\">Maximale</td>\n<td align=\"left\" valign=\"middle\">Minimale</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">8e échelon</td>\n<td align=\"left\" valign=\"middle\">593</td>\n<td align=\"left\" valign=\"middle\">-</td>\n<td align=\"left\" valign=\"middle\">-</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">7e échelon</td>\n<td align=\"left\" valign=\"middle\">560</td>\n<td align=\"left\" valign=\"middle\">4 ans</td>\n<td align=\"left\" valign=\"middle\">3 ans</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">6e échelon</td>\n<td align=\"left\" valign=\"middle\">525</td>\n<td align=\"left\" valign=\"middle\">3 ans</td>\n<td align=\"left\" valign=\"middle\">2 ans 6 mois</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">5e échelon</td>\n<td align=\"left\" valign=\"middle\">490</td>\n<td align=\"left\" valign=\"middle\">3 ans</td>\n<td align=\"left\" valign=\"middle\">2 ans 6 mois</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">4e échelon</td>\n<td align=\"left\" valign=\"middle\">455</td>\n<td align=\"left\" valign=\"middle\">2 ans</td>\n<td align=\"left\" valign=\"middle\">1 an 6 mois</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">3e échelon</td>\n<td align=\"left\" valign=\"middle\">420</td>\n<td align=\"left\" valign=\"middle\">1 an 9 mois</td>\n<td align=\"left\" valign=\"middle\">1 an 3 mois</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">2e échelon</td>\n<td align=\"left\" valign=\"middle\">379</td>\n<td align=\"left\" valign=\"middle\">1 an 9 mois</td>\n<td align=\"left\" valign=\"middle\">1 an 3 mois</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">1er échelon</td>\n<td align=\"left\" valign=\"middle\">341</td>\n<td align=\"left\" valign=\"middle\">1 an 9 mois</td>\n<td align=\"left\" valign=\"middle\">1 an 3 mois</td>\n</tr>\n</tbody>\n</table>"
  },

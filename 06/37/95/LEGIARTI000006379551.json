  "BLOC_TEXTUEL": {
    "CONTENU": "<p>Les colonels de sapeurs-pompiers professionnels relevant des dispositions du décret n° 90-853 du 25 septembre 1990 susmentionné sont classés dans les conditions fixées par le tableau ci-après :<br/>\n</p>\n<table border=\"2\" cellpadding=\"2\">\n<tbody>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">\n<strong>SITUATION<br/>\n</strong>ancienne</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">\n<strong>SITUATION<br/>\n</strong>nouvelle</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">\n<strong>ANCIENNETE<br/>\n</strong>d'échelon</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">\n<i>Colonel</i>\n</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">\n<i>Colonel</i>\n</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<pre> </pre>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">8e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">6e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">Ancienneté conservée.</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">7e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">5e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">Ancienneté conservée.</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">6e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">5e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">Sans ancienneté.</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">5e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">4e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">Ancienneté conservée.</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">4e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">4e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">Sans ancienneté.</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">3e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">3e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">Ancienneté conservée.</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">2e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">2e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">Ancienneté conservée.</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">1er échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">1er échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">Ancienneté conservée.</p>\n</td>\n</tr>\n</tbody>\n</table>\n<br/>"
  },

  "NOTA": {
    "CONTENU": "<br/>  Décret 2007-1629 du 19 novembre 2007 art. 6 : Le décret n° 2005-1021 du 25 août 2005 est abrogé à compter de la dissolution de l'Agence de l'innovation industrielle.<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les ressources de l'établissement sont constituées par :<br/>\n<br/>   1° Des concours financiers de l'Etat ;<br/>\n<br/>   2° Les sommes versées par les industriels en contrepartie des financements octroyés ;<br/>\n<br/>   3° Des dons et legs ;<br/>\n<br/>   4° Tous autres concours financiers.<br/>"
  },

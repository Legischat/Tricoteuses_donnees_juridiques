  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Arrêté du 28 mai 1968 CONDITIONS ET MODALITES DE REGLEMENT DES FRAIS OCCASIONNES PAR LES DEPLACEMENTS DES PERSONNELS DES COLLECTIVITES LOCALES ET DE LEURS ETABLISSEMENTS PUBLICS SUR LE TERRITOIRE METROPOLITAIN. (INTERIEUR)",
          "@c_titre_court": "Arrêté du 28 mai 1968",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000482078"
        },
        {
          "#text": "Arrêté du 28 mai 1968 fixant les conditions et les modalités de règlement des frais occasionnés par les déplacements des personnels des collectivités locales et de leurs établissements publics sur le territoire métropolitain.",
          "@c_titre_court": "Arrêté du 28 mai 1968",
          "@debut": "1967-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006070410"
        }
      ],

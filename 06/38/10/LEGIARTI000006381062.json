        {
          "#text": "Arrêté du 9 juin 1980 PRIMES ET INDEMNITES DU PERSONNEL COMMUNAL DONT LES TAUX ET LE MONTANT SONT DETERMINES PAR DES TEXTES APPLICABLES AUX AGENTS DE L'ETAT",
          "@c_titre_court": "Arrêté du 9 juin 1980",
          "@debut": "2999-01-01",

  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les taux de base de l'indemnité de stage sont fixés comme suit :<br/>\n ------------------------------------------------------------- :   GROUPES   :  PERSONNELS CIVILS  : PERSONNELS MILITAIRES :<br/>\n<br/>\n<table>\n<tr>\n<td> :-------------:---------------------:-----------------------:</td>\n</tr>\n<tr>\n<td> :             :        Francs.      :         Francs.       :</td>\n</tr>\n<tr>\n<td> : I ...       :         23          :          23           :</td>\n</tr>\n<tr>\n<td> : II ...      :         20,50       :          20,50        :</td>\n</tr>\n<tr>\n<td> : III ...     :         19,50       :          19,90        :</td>\n</tr>\n<tr>\n<td> : IV ...      :           \"         :          19,40        :</td>\n</tr>\n</table>\n<br/>\n -------------------------------------------------------------"

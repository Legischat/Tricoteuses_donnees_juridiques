      "TITRE_TXT": [
        {
          "#text": "Arrêté du 19 avril 1973 relatif aux modalités de règlement des frais occasionnés par les déplacements des membres des commissions départementales ou interdépartementales chargées d'établir les listes d'aptitudes à certains emplois communaux.",
          "@c_titre_court": "Arrêté du 19 avril 1973",

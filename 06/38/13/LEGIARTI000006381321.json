  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>                         EMPLOI.<br/>\n<br/>   Secrétaire général des villes de 2.000 habitants à 10.000 habitants. <br/>\n<br/>            Durée d'ancienneté dans chaque échelon. :============================================================:<br/>\n<br/>\n<table>\n<tr>\n<td> :    ECHELONS    :    DUREE MAXIMUM    :    DUREE MINIMUM    :</td>\n</tr>\n<tr>\n<td> :----------------:---------------------:---------------------:</td>\n</tr>\n<tr>\n<td> : 1er échelon    :    1 an 6 mois      :    1 an.            :</td>\n</tr>\n<tr>\n<td> :                :                     :                     :</td>\n</tr>\n<tr>\n<td> : 2ème échelon   :    3 ans            :    2 ans 6 mois.    :</td>\n</tr>\n<tr>\n<td> :                :                     :                     :</td>\n</tr>\n<tr>\n<td> : 3ème échelon   :    3 ans            :    2 ans 6 mois.    :</td>\n</tr>\n<tr>\n<td> :                :                     :                     :</td>\n</tr>\n<tr>\n<td> : 4ème échelon   :    3 ans            :    2 ans 6 mois.    :</td>\n</tr>\n<tr>\n<td> :                :                     :                     :</td>\n</tr>\n<tr>\n<td> : 5ème échelon   :    3 ans.           :    2 ans 6 mois.    :</td>\n</tr>\n<tr>\n<td> :                :                     :                     :</td>\n</tr>\n<tr>\n<td> : 6ème échelon   :    3 ans 6 mois     :    3 ans.           :</td>\n</tr>\n<tr>\n<td> :                :                     :                     :</td>\n</tr>\n<tr>\n<td> : 7ème échelon   :    3 ans 6 mois     :    3 ans.           :</td>\n</tr>\n<tr>\n<td> :                :                     :                     :</td>\n</tr>\n<tr>\n<td> : 8ème échelon   :                     :                     :</td>\n</tr>\n<tr>\n<td> :                :  ---------------    :  -----------------  :</td>\n</tr>\n<tr>\n<td> :                :                     :                     :</td>\n</tr>\n<tr>\n<td> :      TOTAL     :   20 ans 6 mois     :   17 ans.           :</td>\n</tr>\n<tr>\n<td> :============================================================:</td>\n</tr>\n</table>\n<br/>"
  },

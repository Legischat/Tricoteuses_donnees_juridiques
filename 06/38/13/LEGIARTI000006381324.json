  "BLOC_TEXTUEL": {
    "CONTENU": "Emplois.<br/>\n    Secrétaire général des villes de 5.000 habitants à 80.000 habitants.<br/>\n    Secrétaire général adjoint des villes de 20.000 à 400.000 habitants.<br/>\n    Directeur des services administratifs.<br/>\n              Durée d'ancienneté dans chaque échelon.<br/>\n ==============================================================<br/>\n<br/>\n<table>\n<tr>\n<td> :    ECHELONS    :    DUREE MAXIMUM    :    DUREE MINIMUM    :</td>\n</tr>\n<tr>\n<td> :----------------:---------------------:---------------------:</td>\n</tr>\n<tr>\n<td> : 1er échelon    :    1 an 6 mois      :    1 an.            :</td>\n</tr>\n<tr>\n<td> :                :                     :                     :</td>\n</tr>\n<tr>\n<td> : 2ème échelon   :    2 ans            :    1 an 6 mois.     :</td>\n</tr>\n<tr>\n<td> :                :                     :                     :</td>\n</tr>\n<tr>\n<td> : 3ème échelon   :    2 ans            :    1 an 6 mois.     :</td>\n</tr>\n<tr>\n<td> :                :                     :                     :</td>\n</tr>\n<tr>\n<td> : 4ème échelon   :    2 ans 6 mois     :    2 ans.           :</td>\n</tr>\n<tr>\n<td> :                :                     :                     :</td>\n</tr>\n<tr>\n<td> : 5ème échelon   :    2 ans 6 mois     :    2 ans.           :</td>\n</tr>\n<tr>\n<td> :                :                     :                     :</td>\n</tr>\n<tr>\n<td> : 6ème échelon   :    2 ans 6 mois     :    2 ans.           :</td>\n</tr>\n<tr>\n<td> :                :                     :                     :</td>\n</tr>\n<tr>\n<td> : 7ème échelon   :    3 ans 6 mois     :    3 ans.           :</td>\n</tr>\n<tr>\n<td> :                :                     :                     :</td>\n</tr>\n<tr>\n<td> : 8ème échelon   :                     :                     :</td>\n</tr>\n<tr>\n<td> :                :   -------------     :   --------------    :</td>\n</tr>\n<tr>\n<td> :      TOTAL     :   16 ans 6 mois     
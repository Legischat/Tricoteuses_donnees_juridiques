      "TITRE_TXT": [
        {
          "#text": "Arrêté du 28 juin 1972 EXTENSION A CERTAINES CATEGORIES D'AGENTS EMPLOYES A TEMPS PARTIEL DES DISPOSITIONS RELATIVES A L'IRCANTEC",
          "@c_titre_court": "Arrêté du 28 juin 1972",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000283333"
        },
        {
          "#text": "Arrêté du 28 juin 1972 portant extension à certaines catégories d'agents employés à temps partiel des dispositions du décret n° 70-1277 du 23 décembre 1970 portant création d'un régime de retraite complémentaire des assurances sociales en faveur des agents non titulaires de l'Etat et des collectivités publiques.",
          "@c_titre_court": "Arrêté du 28 juin 1972",
          "@debut": "1972-07-08",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006070467"
        }
      ],

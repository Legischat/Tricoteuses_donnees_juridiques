  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Conformément aux dispositions de l'article 1er du décret n° 48-606 du 2 avril 1948, les emplois des agents des collectivités locales sont divisés en emplois de la catégorie A et emplois de la catégorie B.<br/>\n<br/>"
  },
  "LIENS": {
    "LIEN": [

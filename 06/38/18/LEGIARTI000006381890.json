      "TITRE_TXT": [
        {
          "#text": "Arrêté du 25 février 1982 CONDITIONS ET MODALITES DE REGLEMENT DES FRAIS OCCASIONNES PAR LES DEPLACEMENTS DES PERSONNELS DES COMMUNES ET DE LEURS ETABLISSEMENTS PUBLICS SUR LE TERRITOIRE METROPOLITAIN",
          "@c_titre_court": "Arrêté du 25 février 1982",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000675137"
        },
        {
          "#text": "Arrêté du 25 février 1982 relatif aux conditions et modalités de règlement des frais occasionnés par les déplacements des personnels des communes et de leurs établissements publics sur le territoire métropolitain.",
          "@c_titre_court": "Arrêté du 25 février 1982",
          "@debut": "1982-03-07",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006070523"
        }
      ],
      "TM": {
        "TITRE_TM": [
          {
            "#text": "Indemnités particulières",
            "@debut": "1982-03-07",
            "@fin": "2999-01-01",
            "@id": "LEGISCTA000006087526"
          }
        ],
        "TM": {
          "TITRE_TM": [
            {
              "#text": "Indemnité exceptionnelle pour l'agent victime d'un accident aérien ou maritime dans l'exécution d'une mission.",

      "TITRE_TXT": [
        {
          "#text": "Arrêté du 29 mars 1982 TAUX DES INDEMNITES FORFAITAIRES DE CHANGEMENT DE RESIDENCE PREVUES PAR LES ART. 21 ET 22 DU DECRET 66619 DU 10-08-1966 (FRANCE METROPOLITAINE, ILES COTIERES ET CORSE), A COMPTER DU 01-04-1982",
          "@c_titre_court": "Arrêté du 29 mars 1982",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000493358"
        },
        {
          "#text": "Arrêté du 29 mars 1982 relatif aux taux des indemnités forfaitaires de changement de résidence prévues par les articles 21 et 22 du décret n° 66-619 du 10 août 1966 modifié.",
          "@c_titre_court": "Arrêté du 29 mars 1982",

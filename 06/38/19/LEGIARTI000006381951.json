      "TITRE_TXT": [
        {
          "#text": "Arrêté du 29 mars 1982 RELEVEMENT DU TAUX DES INDEMNITES FORFAITAIRES DE DEPLACEMENT PREVUES AUX ART. 9 (INDEMNITE DE MISSION), 13 (INDEMNITE DE TOURNEE), 33 (INDEMNITE DE PREMIERE MISE ET D'ENTRETIEN DE BICYCLETTE), 23 (INDEMNITE DU MUTATION) DU DECRET 66619 DU 10-08-1966 (FRANCE METROPOLITAINE)",
          "@c_titre_court": "Arrêté du 29 mars 1982",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000677034"
        },
        {
          "#text": "Arrêté du 29 mars 1982 relatif aux taux des indemnités forfaitaires de déplacement prévues aux articles 9, 13, 23 et 33 du décret n° 66-619 du 10 août 1966 modifié.",

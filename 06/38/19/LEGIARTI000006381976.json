      "TITRE_TXT": [
        {
          "#text": "Arrêté du 26 février 1982 TAUX DES INDEMNITES KILOMETRIQUES POUR L'USAGE DE LA VOITURE AUTOMOBILE PERSONNELLE SUR LE TERRITOIRE METROPOLITAIN DE LA FRANCE",
          "@c_titre_court": "Arrêté du 26 février 1982",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000864642"
        },
        {
          "#text": "Arrêté du 26 février 1982 fixant les taux des indemnités forfaitaires de déplacement prévues aux articles 28 et 29 du décret n° 66-619 du 10 août 1966 modifié.",
          "@c_titre_court": "Arrêté du 26 février 1982",

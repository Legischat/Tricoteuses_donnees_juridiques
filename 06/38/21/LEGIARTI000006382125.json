  "BLOC_TEXTUEL": {
    "CONTENU": "A compter du 1er juillet 1985, l'échelonnement indiciaire applicable aux grades et emplois de l'échelle I de rémunération instituée par l'arrêté du 5 novembre 1959 modifié précité est fixé ainsi qu'il suit en ce qui concerne les dix échelons de l'échelle I : <br/>\n<br/>\n<table>\n<tbody>\n<tr>\n<td rowspan=\"2\" valign=\"top\" width=\"207\"/>\n<td colspan=\"10\" valign=\"top\" width=\"451\">\n<p align=\"center\">ECHELONS</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"45\">\n<p align=\"center\">1</p>\n</td>\n<td valign=\"top\" width=\"45\">\n<p align=\"center\">2</p>\n</td>\n<td valign=\"top\" width=\"45\">\n<p align=\"center\">3</p>\n</td>\n<td valign=\"top\" width=\"45\">\n<p align=\"center\">4</p>\n</td>\n<td valign=\"top\" width=\"45\">\n<p align=\"center\">5</p>\n</td>\n<td valign=\"top\" width=\"45\">\n<p align=\"center\">6</p>\n</td>\n<td valign=\"top\" width=\"45\">\n<p align=\"center\">7</p>\n</td>\n<td valign=\"top\" width=\"45\">\n<p align=\"center\">8</p>\n</td>\n<td valign=\"top\" width=\"45\">\n<p align=\"center\">9</p>\n</td>\n<td valign=\"top\" width=\"46\">\n<p align=\"center\">10</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"207\">\n<p>Indices bruts</p>\n</td>\n<td valign=\"top\" width=\"45\">\n<p align=\"center\">209</p>\n</td>\n<td valign=\"top\" width=\"45\">\n<p align=\"center\">217</p>\n</td>\n<td valign=\"top\" width=\"45\">\n<p align=\"center\">226</p>\n</td>\n<td valign=\"top\" width=\"45\">\n<p align=\"center\">235</p>\n</td>\n<td valign=\"top\" width=\"45\">\n<p align=\"center\">241</p>\n</td>\n<td valign=\"top\" width=\"45\">\n<p align=\"center\">252</p>\n</td>\n<td valign=\"top\" width=\"45\">\n<p align=\"center\">262</p>\n</td>\n<td valign=\"top\" width=\"45\">\n<p align=\"center\">267</p>\n</td>\n<td valign=\"top\" width=\"45\">\n<p align=\"center\">274</p>\n</td>\n<td valign=\"top\" width=\"46\">\n<p align=\"center\">282</p>\n</td>\n</tr>\n</tbody>\n</table>"

      "TITRE_TXT": [
        {
          "#text": "Arrêté du 6 mai 1988 FIXANT LES MODALITES D'ORGANISATION,LA NATURE ET LE PROGRAMME DES EPREUVES DES EXAMENS PROFESSIONNELS POUR L'ACCES AU GRADE DE CONDUCTEUR SPECIALISE DE PREMIER NIVEAU,DE CONDUCTEUR SPECIALISE DE SECOND NIVEAU ET DE CHEF DE GARAGE",
          "@c_titre_court": "Arrêté du 6 mai 1988",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000479447"
        },
        {
          "#text": "Arrêté du 6 mai 1988 fixant les modalités d'organisation, la nature et le programme des épreuves des examens professionnels pour l'accès aux grades de conducteur spécialisé de premier niveau, de conducteur spécialisé de second niveau et de chef de garage",

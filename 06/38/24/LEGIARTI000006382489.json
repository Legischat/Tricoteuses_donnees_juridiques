  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Arrêté du 5 mai 1988 FIXANT LA LISTE DES TITRES OU DIPLOMES PREVUS AU 2EMEMENT DE L'ART. 8 DU DECRET 871010 DU 30-12-1987 AINSI QUE LES MODALITES D'ORGANISATION,LA NATURE ET LE PROGRAMME DES EPREUVES DES EXAMENS D'APTITUDE AUX FONCTIONS DE DACTYLOGRAPHE ET DE STENODACTYLOGRAPHE",
          "@c_titre_court": "Arrêté du 5 mai 1988",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000478980"
        },
        {
          "#text": "Arrêté du 5 mai 1988 fixant la liste des titres ou diplômes prévus au 2° de l'article 8 du décret n° 87-1110 du 30 décembre 1987 ainsi que les modalités d'organisation, la nature et le programme des épreuves des examens d'aptitude aux fonctions de dactylographe et de sténodactylographe",
          "@c_titre_court": "Arrêté du 5 mai 1988",
          "@debut": "1988-05-06",
          "@fin": "2999-01-01",

  "BLOC_TEXTUEL": {
    "CONTENU": "Sapeur de 2e classe, sapeur de 1re classe, caporal, caporal-chef, sergent, sergent-chef<br/>\n Durée d'ancienneté dans chaque échelon<br/>\n<br/>\n<br/>\n<table>\n<tr>\n<td> :-----------------------------:</td>\n</tr>\n<tr>\n<td> : ECHELONS      :   DUREE     :</td>\n</tr>\n<tr>\n<td> :               :  MAXIMUM    :</td>\n</tr>\n<tr>\n<td> :---------------:-------------:</td>\n</tr>\n<tr>\n<td> :  1er échelon  :   1 an      :</td>\n</tr>\n<tr>\n<td> :  2e  échelon  :   2 ans     :</td>\n</tr>\n<tr>\n<td> :  3e  échelon  :   2 ans     :</td>\n</tr>\n<tr>\n<td> :  4e  échelon  :   2 ans     :</td>\n</tr>\n<tr>\n<td> :  5e  échelon  :   3 ans     :</td>\n</tr>\n<tr>\n<td> :  6e  échelon  :   3 ans     :</td>\n</tr>\n<tr>\n<td> :  7e  échelon  :   3 ans     :</td>\n</tr>\n<tr>\n<td> :  8e  échelon  :   4 ans     :</td>\n</tr>\n<tr>\n<td> :  9e  échelon  :   4 ans     :</td>\n</tr>\n<tr>\n<td> : 10e  échelon  :             :</td>\n</tr>\n<tr>\n<td> :               :-------------:</td>\n</tr>\n<tr>\n<td> :  Total        :  24 ans     :</td>\n</tr>\n<tr>\n<td> :-----------------------------:</td>\n</tr>\n<tr>\n<td> </td>\n</tr>\n<tr>\n<td> :-----------------------------:</td>\n</tr>\n<tr>\n<td> : ECHELONS      :   DUREE     :</td>\n</tr>\n<tr>\n<td> :               :  MINIMUM    :</td>\n</tr>\n<tr>\n<td> :---------------:-------------:</td>\n</tr>\n<tr>\n<td> :  1er échelon  :   1 an      :</td>\n</tr>\n<tr>\n<td> :  2e  échelon  : 1 an 6 mois :</td>\n</tr>\n<tr>\n<td> :  3e  échelon  : 1 an 6 mois :</td>\n</tr>\n<tr>\n<td> :  4e  échelon  : 1 an 6 mois :</td>\n</tr>\n<tr>\n<td> :  5e  échelon  :   2 ans     :</td>\n</tr>\n<tr>\n<td> :  6e  échelon  :   2 ans     :</td>\n</tr>\n<tr>\n<td> :  7e  échelon  :   2 ans     :</td>\n</tr>\n<tr>\n<td> :  8e  échelon  :   3 ans     :</td>\n</tr>\n<tr>\n<td> :  9e  échelon  :   3 ans     :</td>\n</tr>\n<tr>\n<td> : 10e  échelon  :     -       :</td>\n</tr>\n<tr>\n<td> :               :-------------:</td>\n</tr>\n<tr>
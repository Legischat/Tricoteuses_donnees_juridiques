  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Loi n°84-820 du 6 septembre 1984 PORTANT STATUT DU TERRITOIRE DE LA POLYNESIE FRANCAISE",
          "@c_titre_court": "Loi n°84-820 du 6 septembre 1984",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000320666"
        },
        {
          "#text": "Loi n°84-820 du 6 septembre 1984 portant statut du territoire de la Polynésie française",
          "@c_titre_court": "Loi n°84-820 du 6 septembre 1984",
          "@debut": "1984-09-07",
          "@fin": "1996-04-13",
          "@id_txt": "LEGITEXT000006068864"
        }
      ],
      "TM": {
        "TITRE_TM": [
          {
            "#text": "TITRE I - Des institutions du territoire",
            "@debut": "1984-09-07",
            "@fin": "2004-03-02",
            "@id": "LEGISCTA000006087671"
          }
        ],
        "TM": {
          "TITRE_TM": [
            {
              "#text": "CHAPITRE I - Du gouvernement du territoire",
              "@debut": "1984-09-07",
              "@fin": "1996-04-13",
              "@id": "LEGISCTA000006116448"
            }
          ],
          "TM": {
            "TITRE_TM": [
              {
                "#text": "SECTION III - Attributions du gouvernement du territoire.",
                "@debut": "1990-07-14",
                "@fin": "1996-04-13",
                "@id": "LEGISCTA000006135400"
              }
            ],
            "TM": {
              "TITRE_TM": [
                {
                  "#text": "peut décider de suspendre ou de réduire, à titre provisoire, tous droits fiscaux d'entrée et de sortie et tous droits indirects frappant les articles à la production, à la circulation ou à la consommation",
                  "@debut": "1990-07-14",
                  "@fin": "1996-04-13",
                  "@id": "LEGISCTA000006149180"
                }
              ],
              "TM": {
                "TITRE_TM": [
                  {
                    "#text": "Ces décisions sont immédiatement soumises à la ratification de l'assemblée territoriale lorsque celle-ci est en session",
                    "@debut": "1990-07-14",
                    "@fin": "1996-04-13",
                    "@id": "LEGISCTA000006164461"
                  }
                ],
                "TM": {
                  "TITRE_TM": [
                    {
                      "#text": "Dans le cas contraire, la commission permanente en est saisie et fait rapport à l'assemblée territoriale dès la session suivante",
                      "@debut": "1990-07-14",
                      "@fin": "1996-04-13",
                      "@id": "LEGISCTA000006180924"
                    }
                  ],
                  "TM": {
                    "TITRE_TM": [
                      {
                        "#text": "La délibération de l'assemblée territoriale prend effet à compter de la date à laquelle a été prise la décision du conseil des ministres du territoire",
                        "@debut": "1990-07-14",
                        "@fin": "1996-04-13",
                        "@id": "LEGISCTA000006192242"
                      }
                    ],
                    "TM": {
                      "TITRE_TM": [
                        {
                          "#text": "Si la décision de suspension ou de réduction n'est pas ratifiée par l'assemblée territoriale, son application cesse à compter de la décision de l'assemblée.",
                          "@debut": "1990-07-14",
                          "@fin": "1996-04-13",
                          "@id": "LEGISCTA000006197540"
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      },

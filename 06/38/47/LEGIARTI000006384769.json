  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Loi n°84-820 du 6 septembre 1984 PORTANT STATUT DU TERRITOIRE DE LA POLYNESIE FRANCAISE",
          "@c_titre_court": "Loi n°84-820 du 6 septembre 1984",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000320666"
        },
        {
          "#text": "Loi n°84-820 du 6 septembre 1984 portant statut du territoire de la Polynésie française",
          "@c_titre_court": "Loi n°84-820 du 6 septembre 1984",
          "@debut": "1984-09-07",
          "@fin": "1996-04-13",
          "@id_txt": "LEGITEXT000006068864"
        }
      ],
      "TM": {
        "TITRE_TM": [
          {
            "#text": "TITRE V - Du comptable du territoire et du contrôle financier    \" Le comptable du territoire est nommé et exerce ses fonctions dans les conditions définies aux articles L. 274-1 à L. 274-3 du code des juridictions financières ci-après reproduits :    \" Art. L. 274-1. -     Le ministre chargé du budget nomme, après que le président du gouvernement du territoire en a été informé, le comptable du territoire",
            "@debut": "1994-12-06",
            "@fin": "1996-04-13",
            "@id": "LEGISCTA000006087686"
          }
        ],
        "TM": {
          "TITRE_TM": [
            {
              "#text": "Celui-ci est un comptable direct du Trésor ayant la qualité de comptable principal",
              "@debut": "1994-12-06",
              "@fin": "1996-04-13",
              "@id": "LEGISCTA000006116453"
            }
          ],
          "TM": {
            "TITRE_TM": [
              {
                "#text": "\" Art. L. 274-2. -     Les fonctions de comptable de l'Etat dans le territoire et celles de comptable du territoire ne peuvent être exercées par une même personne",
                "@debut": "1994-12-06",
                "@fin": "1996-04-13",
                "@id": "LEGISCTA000006135403"
              }
            ],
            "TM": {
              "TITRE_TM": [
                {
                  "#text": "\" Art. L. 274-3. -     Le comptable du territoire prête serment devant la chambre territoriale des comptes. \"",
                  "@debut": "1994-12-06",
                  "@fin": "1996-04-13",
                  "@id": "LEGISCTA000006149181"
                }
              ]
            }
          }
        }
      },
      "@cid": "JORFTEXT000000320666",
      "@date_publi": "1984-09-07",
      "@date_signature": "1984-09-06",
      "@nature": "LOI",
      "@num": "84-820"
    }
  },

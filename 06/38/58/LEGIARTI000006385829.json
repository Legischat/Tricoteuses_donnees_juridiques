    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Arrêté du 8 juillet 1991 ETABLISSANT LA LISTE DES AGENCES DE NOTATION VISEES PAR L'ART. 2 DU DECRET 91605 DU 27-06-1991 MODIFIANT LE DECRET 89623 DU 06-09-1989 RELATIF AUX ORGANISMES DE PLACEMENT COLLECTIF EN VALEURS MOBILIERES",
          "@c_titre_court": "Arrêté du 8 juillet 1991",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000339546"
        },
        {
          "#text": "Arrêté du 8 juillet 1991 établissant la liste des agences de notation visées par l'article 2 du décret n° 91-605 du 27 juin 1991 modifiant le décret n° 89-623 du 6 septembre 1989 relatif aux organismes de placement collectif en valeurs mobilières",
          "@c_titre_court": "Arrêté du 8 juillet 1991",

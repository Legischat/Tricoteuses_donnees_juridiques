          "@id_txt": "JORFTEXT000000688159"
        },
        {
          "#text": "Décret n°46-2377 du 25 octobre 1946 portant réorganisation du Conseil général de la Nouvelle-Calédonie et dont les articles suivants ont été rendus applicables dans le territoire des îles Wallis et Futuna par l'article 12 de la loi n° 61-814 du 28 juillet 1961 : articles 2, 7, 9, 15 à 23",
          "@c_titre_court": "Décret n°46-2377 du 25 octobre 1946",
          "@debut": "1946-10-27",
          "@fin": "2999-01-01",

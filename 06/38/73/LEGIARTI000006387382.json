          "#text": "Décret n°46-2377 du 25 octobre 1946 ORGANISATION DES POUVOIRS PUBLICS EN NOUVELLE-CALEDONIE",
          "@c_titre_court": "Décret n°46-2377 du 25 octobre 1946",
          "@debut": "2999-01-01",

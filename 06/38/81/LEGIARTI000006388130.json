      "TITRE_TXT": [
        {
          "#text": "Décret no 94-704 du 17 août 1994 fixant les modalités de répartition de la    dotation globale de fonctionnement entre les communes des départements    d'outre-mer et de la collectivité territoriale de Saint-Pierre-et-Miquelon,    entre les circonscriptions territoriales des îles Wallis et Futuna et entre    les communes des territoires d'outre-mer et de la collectivité territoriale    de Mayotte",
          "@c_titre_court": "Décret n°94-704 du 17 août 1994",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000549366"
        },

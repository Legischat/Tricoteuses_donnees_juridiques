  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   L'article 3 du décret du 22 novembre 1978 susvisé est modifié ainsi qu'il suit :<br/>\n<br/>\n<table>\n<tr>\n<td> :----------------------------------------------------:</td>\n</tr>\n<tr>\n<td> :                    : Indemnités  :   Indemnités    :</td>\n</tr>\n<tr>\n<td> :                    : des maires  :  des adjoints   :</td>\n</tr>\n<tr>\n<td> : POPULATION TOTALE  : (en francs) :  (pourcentage   :</td>\n</tr>\n<tr>\n<td> :                    :             :       de        :</td>\n</tr>\n<tr>\n<td> :                    :             :   l'indemnité   :</td>\n</tr>\n<tr>\n<td> :                    :             :   des maires)   :</td>\n</tr>\n<tr>\n<td> :----------------------------------------------------:</td>\n</tr>\n<tr>\n<td> : Moins de           :             :                 :</td>\n</tr>\n<tr>\n<td> :  3500 habitants    :   1908,72   :       50        :</td>\n</tr>\n<tr>\n<td> :                    :             :                 :</td>\n</tr>\n<tr>\n<td> : de 3500 à          :             :                 :</td>\n</tr>\n<tr>\n<td> :    9999 habitants  :   2171      :       45        :</td>\n</tr>\n<tr>\n<td> :                    :             :                 :</td>\n</tr>\n<tr>\n<td> : de 10000 à         :             :                 :</td>\n</tr>\n<tr>\n<td> :    20000 habitants :   2433,60   :       45        :</td>\n</tr>\n<tr>\n<td> :                    :             :                 :</td>\n</tr>\n<tr>\n<td> : Plus de            :             :                 :</td>\n</tr>\n<tr>\n<td> :    20000 habitants :   2815      :       45        :</td>\n</tr>\n<tr>\n<td> :                    :             :                 :</td>\n</tr>\n<tr>\n<td> :----------------------------------------------------:</td>\n</tr>\n</table>\n<br/>"

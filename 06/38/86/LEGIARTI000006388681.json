  "NOTA": {
    "CONTENU": "<p>La partie Législative et la partie Réglementaire du code des communes de la Nouvelle-Calédonie annexées au présent décret font l'objet d'une pagination spéciale annexée au Journal officiel de ce jour.</p>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Est publiée en annexe I au présent décret la partie Législative du code des communes de la Nouvelle-Calédonie, créée par l'article 4 de la loi n° 99-210 du 19 mars 1999 susvisée.<br/>\n<br/>"
  },

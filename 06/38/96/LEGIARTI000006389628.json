      "TITRE_TXT": [
        {
          "#text": "Arrêté du 22 janvier 1981 TAUX D'INTERET ALLOUE A LA CREANCE SUR L'ETAT DONT BENEFICIENT LES SOCIETES INDUSTRIELLES ET COMMERCIALES QUI PROCEDENT A LA CREATION D'ACTIONS EN FAVEUR DE LEURS SALARIES EN APPLICATION DE LA LOI 80-834 DU 24-10-1980:12,83%",
          "@c_titre_court": "Arrêté du 22 janvier 1981",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000458232"
        },
        {
          "#text": "Arrêté du 22 janvier 1981 relatif au taux d'intérêt alloué à la créance sur l'Etat dont bénéficient les sociétés industrielles et commerciales qui procèdent à la création d'actions en faveur de leurs salariés en application de la loi n° 80-834 du 24 octobre 1980",
          "@c_titre_court": "Arrêté du 22 janvier 1981",
          "@debut": "1981-01-29",
          "@fin": "1982-01-11",
          "@id_txt": "LEGITEXT000006070637"
        }
      ],
      "@cid": "JORFTEXT000000458232",

  "NOTA": {
    "CONTENU": "<br/>   Code général des collectivités territoriales art. L1781-2.<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les articles L. 1612-1, L. 1612-2, L. 1612-4 à L. 1612-6, L. 1612-8 à L. 1612-19 sont applicables à la collectivité départementale de Mayotte et à ses établissements publics, sous réserve des dispositions du 2° de l'article L. 1781-1 et du 6° de l'article L. 1781-2.<br/>\n<br/>"
  },

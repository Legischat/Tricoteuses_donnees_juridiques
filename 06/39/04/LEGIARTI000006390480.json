    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Arrêté du 6 janvier 1982 TAUX D'INTERET ALLOUE A LA CREANCE SUR L'ETAT DONT BENEFICIENT LES SOCIETES INDUSTRIELLES ET COMMERCIALES QUI PROCEDENT A LA CREATION D'ACTIONS EN FAVEUR DE LEURS SALARIES",
          "@c_titre_court": "Arrêté du 6 janvier 1982",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000463701"
        },
        {
          "#text": "Arrêté du 6 janvier 1982 relatif au taux d'intérêt alloué à la créance sur l'Etat dont bénéficient les sociétés industrielles et commerciales qui procèdent à la création d'actions en faveur de leurs salariés en application de la loi n° 80-834 du 24 octobre 1980",
          "@c_titre_court": "Arrêté du 6 janvier 1982",
          "@debut": "1982-01-10",
          "@fin": "1983-01-06",
          "@id_txt": "LEGITEXT000006070643"
        }
      ],
      "@cid": "JORFTEXT000000463701",
      "@date_publi": "1982-01-10",
      "@date_signature": "1982-01-06",
      "@nature": "ARRETE"
    }
  },

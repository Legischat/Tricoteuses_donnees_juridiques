  "NOTA": {
    "CONTENU": "<br/>  Ordonnance 2005-1027 du 26 août 2005 art. 27 : Les dispositions de la présente ordonnance entrent en vigueur à compter de l'exercice 2006.<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>Les recettes d'investissement prévues aux 1° et 2° de l'article L. 2331-5, aux 1° et 6° de l'article L. 2331-6 et au 9° de l'article L. 2331-8 peuvent être utilisées au financement des dotations aux amortissements prévus aux 27° et 28° de l'article L. 2321-2.<br/>\n<br/>"
  },

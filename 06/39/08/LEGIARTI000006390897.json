  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Arrêté du 28 décembre 1982 TAUX D'INTERET ALLOUE A LA CREANCE SUR L'ETAT DONT BENEFICIENT LES SOCIETES INDUSTRIELLES ET COMMERCIALES QUI PROCEDENT A LA CREATION D'ACTIONS EN FAVEUR DE LEURS SALARIES EN APPLICATION DE LA LOI 80-834 DU 24-10-1980: 15,75% L'AN POUR LES ACTIONS DISTRIBUEES EN 1983",
          "@c_titre_court": "Arrêté du 28 décembre 1982",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000674264"
        },
        {
          "#text": "Arrêté du 28 décembre 1982 relatif au taux d'intérêt alloué à la créance sur l'Etat dont bénéficient les sociétés industrielles et commerciales qui procèdent à la création d'actions en faveur de leurs salariés en application de la loi n° 80-834 du 24 octobre 1980",
          "@c_titre_court": "Arrêté du 28 décembre 1982",
          "@debut": "1983-01-05",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006070646"
        }
      ],
      "@cid": "JORFTEXT000000674264",

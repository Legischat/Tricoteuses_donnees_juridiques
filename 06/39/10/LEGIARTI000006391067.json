      "TITRE_TXT": [
        {
          "#text": "Arrêté du 31 décembre 1982 MODALITES DE TRANSFERT DE BIENS,DROITS ET OBLIGATIONS DE L'INSTITUT NATIONAL DE L'AUDIOVISUEL (CREE PAR LA LOI 74-696 DU 07-08-1974) A L'INSTITUT NATIONAL DE LA COMMUNICATION AUDIOVISUELLE (CREE PAR LA LOI 82-652 DU 29-07-1982)",

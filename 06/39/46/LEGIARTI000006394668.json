  "NOTA": {
    "CONTENU": "<br/>   Les intitulés propres à la partie réglementaire sont signalés par (R).<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Sont soumis aux dispositions de la présente section les groupements d'intérêt public visés à l'article L. 1112-2, dont l'objet relève de la mise en oeuvre et de la gestion des actions requises par les projets et programmes de coopération interrégionale et transfrontalière intéressant des collectivités locales des Etats membres de l'Union européenne.<br/>\n<br/>"
  },

  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Le préfet de Paris exerce les attributions de police administrative suivantes :<br/>\n<br/>   1° La délivrance de la carte de qualification professionnelle de coiffeur ;<br/>\n<br/>   2° L'autorisation de tenir les foires commerciales ;<br/>\n<br/>   3° L'agrément pour l'exploitation ou la cession d'un magasin général ;<br/>\n<br/>   4° La surveillance des bureaux de placement ;<br/>\n<br/>   5° Les dérogations au repos hebdomadaire ;<br/>\n<br/>   6° Les autorisations de commerce ou de distribution d'objets dans les cours ou bâtiments des gares.<br/>"
  },

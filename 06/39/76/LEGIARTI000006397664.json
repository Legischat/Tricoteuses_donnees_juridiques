  "NOTA": {
    "CONTENU": "<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les redevances dues aux départements pour l'occupation de leur domaine public par les ouvrages de transport et de distribution de gaz, ainsi que par les canalisations particulières de gaz, sont fixées par le conseil général dans les conditions prévues aux articles R. 2333-114 et R. 2333-117.<br/>\n<br/>"
  },

          "@id_txt": "JORFTEXT000000304056"
        },
        {
          "#text": "Décret n° 70-415 du 8 mai 1970 relatif à l'organisation sanitaire dans la ville de Paris et dans les départements des Hauts-de-Seine, de la Seine-Saint-Denis et du Val-de-Marne.",
          "@c_titre_court": "Décret n° 70-415 du 8 mai 1970",
          "@debut": "1970-07-01",

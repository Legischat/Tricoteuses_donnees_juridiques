  "BLOC_TEXTUEL": {
    "CONTENU": "<p>La durée maximale et la durée minimale du temps passé dans chacun des échelons des grades d'ouvrier territorial et d'ouvrier territorial qualifié de Mayotte sont fixées ainsi qu'il suit :</p>\n<table border=\"2\" cellpadding=\"2\">\n<tbody>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">\n<strong>GRADES</strong>\n</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">\n<strong>ÉCHELONS</strong>\n</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">\n<strong>DURÉE MAXIMALE</strong>\n</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">\n<strong>DURÉE MINIMALE</strong>\n</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">Ouvrier territorial qualifié de Mayotte</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">5<sup>ème</sup> échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<pre> </pre>\n</td>\n<td align=\"left\" valign=\"middle\">\n<pre> </pre>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">-</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">4<sup>ème</sup> échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">2 ans</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">1 an 6 mois</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">-</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">3<sup>ème</sup> échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">2 ans</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">1 an 6 mois</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">-</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">2<sup>ème</sup> échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">2 ans</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">1 an 6 mois</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">-</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">1<sup>er</sup> échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">1 an 6 mois</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">1 an</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">Ouvrier territorial de Mayotte</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">8<sup>ème</sup> échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<pre> </pre>\n</td>\n<td align=\"left\" valign=\"middle\">\n<pre> </pre>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">-</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">7<sup>ème</sup> échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">1 an 6 mois</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">1 an</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">-</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">6<sup>ème</sup> échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">1 an 6 mois</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">1 an</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">-</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">5<sup>ème</sup> échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">1 an 6 mois</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">1 an</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">-</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">4<sup>ème</sup> échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">1 an 6 mois</p>\n</td>\n<td
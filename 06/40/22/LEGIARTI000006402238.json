  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>\n<br/>\n<table>\n<tbody>\n<tr>\n<td align=\"center\">BIENS TRANSFÉRÉS <br/>\n</td>\n<td align=\"center\">\n<p>PÉRIODE</p>\n<p>à prendre </p>\n<p> en considération</p>\n</td>\n</tr>\n<tr>\n<td align=\"center\">\n<p> Routes classées dans le domaine routier national </p>\n<p>Article 18 </p>\n</td>\n<td align=\"center\"> 5 ans </td>\n</tr>\n<tr>\n<td align=\"center\">\n<p> Aérodromes civils </p>\n<p>Article 28</p>\n</td>\n<td align=\"center\"> 10 ans </td>\n</tr>\n<tr>\n<td align=\"center\">\n<p> Ports maritimes </p>\n<p>Article 30</p>\n</td>\n<td align=\"center\"> 10 ans </td>\n</tr>\n<tr>\n<td align=\"center\">\n<p> Etablissements d'enseignement agricole </p>\n<p>Article 84</p>\n</td>\n<td align=\"center\"> 10 ans </td>\n</tr>\n<tr>\n<td align=\"center\">\n<p> Collèges et lycées à sections binationales</p>\n<p>ou internationales </p>\n<p>Article 84</p>\n</td>\n<td align=\"center\">10 ans  <br/>\n</td>\n</tr>\n<tr>\n<td align=\"center\">\n<p> Ecoles de la marine marchande </p>\n<p>Article 94</p>\n</td>\n<td align=\"center\"> 10 ans </td>\n</tr>\n</tbody>\n</table>\n<br/>"

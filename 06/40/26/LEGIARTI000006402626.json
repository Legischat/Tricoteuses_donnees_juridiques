  "BLOC_TEXTUEL": {
    "CONTENU": "Le grade de brigadier-chef principal comprend huit échelons. La durée maximale et la durée minimale du temps passé dans chacun des échelons sont fixées ainsi qu'il suit :<br/>\n<div>\n<br/>\n<table align=\"center\" border=\"1\" cellpadding=\"0\" cellspacing=\"0\">\n<tbody>\n<tr>\n<td rowspan=\"2\" width=\"352\">\n<p align=\"center\">GRADES ET ÉCHELONS</p>\n</td>\n<td colspan=\"2\" width=\"313\">\n<p align=\"center\">DURÉES</p>\n</td>\n</tr>\n<tr>\n<td width=\"157\">\n<p align=\"center\">Minimale</p>\n</td>\n<td width=\"157\">\n<p align=\"center\">Maximale</p>\n</td>\n</tr>\n<tr>\n<td width=\"352\">\n<p>8e échelon</p>\n</td>\n<td width=\"157\">\n<p align=\"center\"> </p>\n<br/>\n</td>\n<td width=\"157\">\n<p align=\"center\"> </p>\n<br/>\n</td>\n</tr>\n<tr>\n<td width=\"352\">\n<p>7e échelon</p>\n</td>\n<td width=\"157\">\n<p align=\"center\">1 an 9 mois</p>\n</td>\n<td width=\"157\">\n<p align=\"center\">2 ans 1 mois</p>\n</td>\n</tr>\n<tr>\n<td width=\"352\">\n<p>6e échelon</p>\n</td>\n<td width=\"157\">\n<p align=\"center\">1 an 9 mois</p>\n</td>\n<td width=\"157\">\n<p align=\"center\">2 ans 1 mois</p>\n</td>\n</tr>\n<tr>\n<td width=\"352\">\n<p>5e échelon</p>\n</td>\n<td width=\"157\">\n<p align=\"center\">2 ans</p>\n</td>\n<td width=\"157\">\n<p align=\"center\">2 ans 3 mois</p>\n</td>\n</tr>\n<tr>\n<td width=\"352\">\n<p>4e échelon</p>\n</td>\n<td width=\"157\">\n<p align=\"center\">2 ans</p>\n</td>\n<td width=\"157\">\n<p align=\"center\">2 ans 3 mois</p>\n</td>\n</tr>\n<tr>\n<td width=\"352\">\n<p>3e échelon</p>\n</td>\n<td width=\"157\">\n<p align=\"center\">2 ans</p>\n</td>\n<td width=\"157\">\n<p align=\"center\">2 ans 3 mois</p>\n</td>\n</tr>\n<tr>\n<td width=\"352\">\n<p>2e échelon</p>\n</td>\n<td width=\"157\">\n<p align=\"center\">2 ans 6 mois</p>\n</td>\n<td width=\"157\">\n<p align=\"center\">3 ans</p>\n</td>\n</tr>\n<tr>\n<td width=\"352\">\n<p>1er échelon</p>\n</td>\n<td width=\"157\">\n<p align=\"center\">2 ans 6 mois</p>\n</td>\n<td width=\"157\">\n<p align=\"center\">3 ans</p>\n</td>\n</tr>\n</tbody>\n</table>\n</div>\n<p align=\"justify\">\n<b/>\n</p>"
  },

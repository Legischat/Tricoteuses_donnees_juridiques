        {
          "#text": "Loi n°70-4 du 2 janvier 1970 MODIFICATION DES ART. 2, 6 (3E), 21 DERNIER ALINEA DE LA LOI 67-1115 DU 21- 12-1967 RELATIVE AUX CORPS MILITAIRES DES INGENIEURS DE L'ARMEMENT ET DES INGENIEURS DES ETUDES ET TECHNIQUES D'ARMEMENT",
          "@c_titre_court": "Loi n°70-4 du 2 janvier 1970",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000874459"
        },
        {
          "#text": "Loi n°70-4 du 2 janvier 1970 modifiant la loi n° 67-1115 du 21 décembre 1967 relative aux corps militaires des ingénieurs de l'armement et des ingénieurs des études et techniques d'armement (1).",
          "@c_titre_court": "Loi n°70-4 du 2 janvier 1970",
          "@debut": "1970-01-04",

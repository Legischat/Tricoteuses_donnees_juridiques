  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   La gendarmerie nationale comprend :<br/>\n<br/>   - la direction générale de la gendarmerie nationale ;<br/>\n<br/>   - la garde républicaine ;<br/>\n<br/>   - les formations territoriales constituant la gendarmerie départementale ;<br/>\n<br/>   - les formations constituant la gendarmerie mobile ;<br/>\n<br/>   - les formations spécialisées ;<br/>\n<br/>   - les formations prévôtales ;<br/>\n<br/>   - les organismes d'administration et de soutien ;<br/>\n<br/>   - les organismes de formation du personnel.<br/>"
  },

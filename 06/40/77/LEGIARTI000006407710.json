      "TITRE_TXT": [
        {
          "#text": "Décret n°63-892 du 28 août 1963 PORTANT RAP RELATIF AUX RENSEIGNEMENTS ET DECLARATIONS A FOURNIR EN MATIERE DE DEFENSE ECONOMIQUE PAR LES ENTREPRISES PARTICIPANT A LA PRODUCTION, LA REUNION OU L'UTILISATION DES RESSOURCES",
          "@c_titre_court": "Décret n°63-892 du 28 août 1963",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000299129"
        },
        {
          "#text": "Décret n°63-892 du 28 août 1963 portant règlement d'administration publique relatif aux renseignements et déclarations à fournir en matière de défense économique par les entreprises participant à la production, la réunion ou l'utilisation des ressources.",
          "@c_titre_court": "Décret n°63-892 du 28 août 1963",
          "@debut": "1963-09-01",
          "@fin": "2007-04-24",
          "@id_txt": "LEGITEXT000006061158"
        }
      ],
      "@cid": "JORFTEXT000000299129",
      "@date_publi": "1963-09-01",
      "@date_signature": "1963-08-28",
      "@nature": "DECRET",
      "@num": "63-892"
    }
  },
  "VERSIONS": {

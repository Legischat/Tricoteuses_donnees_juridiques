      "TITRE_TXT": [
        {
          "#text": "Décret n°79-348 du 2 mai 1979 RELATIF AU FONCTIONNEMENT DES STATIONS RADIO-ELECTRIQUES DANS LES CIRCONSTANCES PREVUES AUX ART. 2 ET 6 DE L'ORDONNANCE 59147 DU 07-01-1959 PORTANT ORGANISATION GENERALE DE LA DEFENSE",
          "@c_titre_court": "Décret n°79-348 du 2 mai 1979",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000516264"
        },
        {
          "#text": "Décret n°79-348 du 2 mai 1979 relatif au fonctionnement des stations radio-électriques dans les circonstances prévues aux articles 2 et 6 de l'ordonnance n° 59-147 du 7 janvier 1959 portant organisation générale de la défense.",
          "@c_titre_court": "Décret n°79-348 du 2 mai 1979",
          "@debut": "1979-05-05",
          "@fin": "2007-04-24",
          "@id_txt": "LEGITEXT000006063032"

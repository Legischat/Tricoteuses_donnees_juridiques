        {
          "#text": "Décret n°79-845 du 26 septembre 1979 PRIS POUR L'APPLICATION DE LA LOI 771408 DU 23-12-1977 ACCORDANT UNE PROTECTION PARTICULIERE AUX ENFANTS DE CERTAINS MILITAIRES TUES OU BLESSES ACCIDENTELLEMENT EN TEMPS DE PAIX",
          "@c_titre_court": "Décret n°79-845 du 26 septembre 1979",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000331162"
        },
        {
          "#text": "Décret n°79-845 du 26 septembre 1979 pris pour l'application de la loi n° 77-1408 du 23 décembre 1977 accordant une protection particulière aux enfants de certains militaires tués ou blessés accidentellement en temps de paix.",
          "@c_titre_court": "Décret n°79-845 du 26 septembre 1979",
          "@debut": "1979-10-02",
          "@fin": "2008-04-26",
          "@id_txt": "LEGITEXT000006063123"
        }

  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   La hiérarchie des maîtres ouvriers des armées comporte les grades suivants :<br/>\n<br/>   Maître ouvrier de 2e classe ;<br/>\n<br/>   Maître ouvrier de 1re classe ;<br/>\n<br/>   Maître ouvrier principal,<br/>\n qui correspondent respectivement aux grades de sergent-chef ou maître, d'adjudant ou premier maître et d'adjudant chef ou maître principal de la hiérarchie militaire générale.<br/>"
  },

  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   La gestion administrative de l'établissement comprend notamment :<br/>\n<br/>   1° L'encaissement des cotisations ;<br/>\n<br/>   2° La liquidation des droits et le versement des prestations ;<br/>\n<br/>   3° La tenue des comptes courants retraçant les opérations rendues nécessaires par le fonctionnement du régime ;<br/>\n<br/>   4° La tenue de la comptabilité du régime ;<br/>\n<br/>   5° Le régime de la conservation défini au 1 de l'article L. 321-2 du code monétaire et financier.<br/>"
  },

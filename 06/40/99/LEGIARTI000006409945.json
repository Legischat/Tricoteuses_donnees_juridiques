  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Relèvent du chef d'état-major des armées les organismes et autorités suivants :<br/>\n<br/>   - le service de santé des armées ;<br/>\n<br/>   - le service des essences des armées ;<br/>\n<br/>   - la direction du renseignement militaire ;<br/>\n<br/>   - la direction interarmées des réseaux d'infrastructure et des systèmes d'information de la défense ;<br/>\n<br/>   - le service de la poste interarmées ;<br/>\n<br/>   - le centre interarmées de concepts, de doctrines et d'expérimentations ;<br/>\n<br/>   - l'inspecteur des forces en opérations et de la défense du territoire ;<br/>\n<br/>   - le directeur de l'enseignement militaire supérieur ;<br/>\n<br/>   - le secrétaire général du secrétariat permanent du conseil des systèmes de forces.<br/>"
  },

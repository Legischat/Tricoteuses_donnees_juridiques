  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>Le président de la juridiction peut dans l'intérêt d'une bonne administration de la justice désigner un juge spécialement chargé de contrôler l'exécution des mesures d'instruction confiées à un technicien en application de l'article 232.<br/>\n<br/>"
  },

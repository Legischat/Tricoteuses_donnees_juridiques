  "BLOC_TEXTUEL": {
    "CONTENU": "<p>Les anciens agents titulaires de la collectivité départementale de Mayotte intégrés sur leur demande en qualité de brigadier de police en application du décret du 29 juillet 2004 susvisé sont reclassés dans le grade de brigadier-chef de police, en conservant l'ancienneté acquise, conformément au tableau suivant :</p>\n<table>\n<tbody>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">\n<strong>SITUATION ANCIENNE</strong>\n</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">\n<strong>SITUATION NOUVELLE</strong>\n</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">\n<i>Brigadier de police</i>\n</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">\n<i>Brigadier-chef de police</i>\n</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">Echelons</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">Echelons</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">4e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">4e échelon provisoire</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">3e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">3e échelon provisoire</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">2e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">2e échelon provisoire</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">1er échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">1er échelon provisoire</p>\n</td>\n</tr>\n</tbody>\n</table>"
  },

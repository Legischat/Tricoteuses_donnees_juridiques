  "BLOC_TEXTUEL": {
    "CONTENU": "<p align=\"center\">TABLEAU DE CORRESPONDANCE</p>\n<p align=\"center\"> </p>\n<table align=\"center\" border=\"1\" cellpadding=\"0\" cellspacing=\"0\">\n<tbody>\n<tr>\n<td width=\"227\">\n<p align=\"center\">CATÉGORIES D'AGENTS <br/>non titulaires</p>\n</td>\n<td width=\"227\">\n<p align=\"center\">FONCTIONS EXERCÉES</p>\n</td>\n<td width=\"227\">\n<p align=\"center\">CORPS D'ACCUEIL</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"227\">\n<p>Agents non titulaires recrutés sur le fondement d'un contrat individuel du niveau de la catégorie A. </p>\n</td>\n<td valign=\"top\" width=\"227\">\n<p>Fonctions administratives de conception ou d'encadrement. </p>\n</td>\n<td valign=\"top\" width=\"227\">\n<p>Attachés d'administration centrale du ministère de la défense. </p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"227\">\n<p>Agents non titulaires recrutés sur le fondement d'un contrat individuel du niveau de la catégorie A. </p>\n</td>\n<td valign=\"top\" width=\"227\">\n<p>Fonctions d'ingénieur. </p>\n</td>\n<td valign=\"top\" width=\"227\">\n<p>Ingénieurs d'études et de fabrications du ministère de la défense. </p>\n</td>\n</tr>\n</tbody>\n</table>"

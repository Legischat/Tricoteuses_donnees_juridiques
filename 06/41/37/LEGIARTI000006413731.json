n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">Sans ancienneté</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">1er échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">6e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">Ancienneté acquise</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">\n<i>Commissaire contrôleur <br/>\n<br/>de deuxième classe</i>\n</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<pre> </pre>\n</td>\n<td align=\"left\" valign=\"middle\">\n<pre> </pre>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">8e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">5e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">Ancienneté acquise</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">7e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">4e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">Un demi de l'ancienneté acquise</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">6e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">3e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">Un quart de l'ancienneté acquise majoré de six mois</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">5e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">3e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">Un tiers de l'ancienneté acquise</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">4e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">2e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">Deux tiers 
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000304574"
        },
        {
          "#text": "Décret n°74-705 du 6 août 1974 pris en application de l'article 17 de la loi du 13 juillet 1972 portant statut général des militaires et relatif à la responsabilité pécuniaire de certains militaires.",
          "@c_titre_court": "Décret n°74-705 du 6 août 1974",

  "NOTA": {
    "CONTENU": "<br/>   NOTA : L'article L. 622-2 a été abrogé par la loi n° 2005-845, annexe et remplacé par l'article L. 641-1.<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Le liquidateur désigné en application des dispositions de l'article L. 641-1 du code de commerce perçoit pour l'ensemble de la procédure de liquidation judiciaire le droit fixe prévu à l'article 2.<br/>\n<br/>   Les dispositions des articles 13, 14 et 16 lui sont applicables.<br/>"
  },

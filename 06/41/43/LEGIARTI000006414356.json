  "BLOC_TEXTUEL": {
    "CONTENU": "Les nominations au grade d'ingénieur divisionnaire de l'agriculture et de l'environnement sont prononcées conformément au tableau de correspondance ci-après : <table border=\"2\" cellpadding=\"2\">\n<tbody>\n<tr>\n<td align=\"left\" colspan=\"2\" valign=\"middle\">\n<p align=\"center\">INGÉNIEURS DE L'AGRICULTURE ET DE L'ENVIRONNEMENT</p>\n</td>\n<td align=\"left\" colspan=\"2\" valign=\"middle\">\n<p align=\"center\">INGÉNIEURS DIVISIONNAIRES DE L'AGRICULTURE ET DE L'ENVIRONNEMENT</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">Échelons</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">Ancienneté</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">Échelons</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">Ancienneté conservée</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">11e</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">Avec ancienneté égale ou supérieure à 4 ans.</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">7e</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">Sans ancienneté.</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">11e</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">Avec ancienneté inférieure à 4 ans.</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">6e</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">7/8 de l'ancienneté acquise.</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">10e</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<pre> </pre>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">5e</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">3/4 de l'ancienneté acquise.</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">9e</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<pre> </pre>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">4e</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">3/4 de l'ancienneté acquise.</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">8e</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<pre> </pre>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">3e</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">3/4 de l'ancienneté acquise.</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">7e</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<pre> </pre>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">2e</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">5/8 de l'ancienneté acquise.</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">6e</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<pre> </pre>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">1er</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">2/3 de l'ancienneté acquise.</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">5e</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<pre> </pre>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">1er</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">Sans ancienneté.</p>\n</td>\n</tr>\n</tbody>\n</table>"

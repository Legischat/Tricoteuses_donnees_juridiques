  "BLOC_TEXTUEL": {
    "CONTENU": "<p>Jusqu'au 31 décembre 2008, par dérogation aux dispositions prévues au 1° de l'article 14, la condition de services effectifs requise pour être promu au grade de premier surveillant est fixée comme suit :</p>\n<table border=\"2\" cellpadding=\"2\">\n<tbody>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">\n<strong>ANNEE AU TITRE DE LAQUELLE LE CONCOURS PROFESSIONNEL</strong>\n<br/>\n<br/>est organisé</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">\n<strong>DUREE EXIGEE DE SERVICES EFFECTIFS</strong>\n<br/>\n<br/>dans le corps</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">2006</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">5 ans 3 mois</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">2007</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">5 ans 6 mois</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">2008</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">5 ans 9 mois</p>\n</td>\n</tr>\n</tbody>\n</table>"
  },

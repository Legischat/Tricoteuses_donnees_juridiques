        {
          "#text": "Décret n°74-1205 du 31 décembre 1974 RELATIF AUX INDEMNITES SUSCEPTIBLES D'ETRE ALLOUEES AUX PERSONNALITES APPORTANT LEUR CONCOURS AU COMITE CENTRAL D'ENQUETE SUR LE COUT ET LE RENDEMENT DES SERVICES PUBLICS",
          "@c_titre_court": "Décret n°74-1205 du 31 décembre 1974",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000703527"
        },
        {
          "#text": "Décret n°74-1205 du 31 décembre 1974 relatif aux indemnités susceptibles d'être allouées aux personnalités apportant leur concours au comité central d'enquête sur le coût et le rendement des services publics.",
          "@c_titre_court": "Décret n°74-1205 du 31 décembre 1974",
          "@debut": "1974-07-01",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006062166"
        }

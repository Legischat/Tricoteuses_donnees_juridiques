  "BLOC_TEXTUEL": {
    "CONTENU": "<p>Les inspecteurs principaux et les inspecteurs sont reclassés conformément au tableau ci-après :</p>\n<table>\n<tbody>\n<tr>\n<td align=\"left\" colspan=\"2\" valign=\"middle\">\n<p align=\"center\">GRADE D'ORIGINE</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">EMPLOI D'INTÉGRATION</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">ANCIENNETÉ CONSERVÉE<br/>dans la limite de la durée moyenne de l'échelon</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" colspan=\"2\" valign=\"middle\">\n<p align=\"center\">Inspecteur principal de 1re classe</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">Inspecteur principal de 1re classe</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<pre> </pre>\n</td>\n</tr>\n<tr>\n<td align=\"left\" colspan=\"2\" valign=\"middle\">\n<p align=\"left\">3e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">2e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">Ancienneté conservée.</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" colspan=\"2\" valign=\"middle\">\n<p align=\"left\">2e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">Echelon provisoire</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">Ancienneté conservée.</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" colspan=\"2\" valign=\"middle\">\n<p align=\"left\">1er échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">3e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">Ancienneté conservée.</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" colspan=\"2\" valign=\"middle\">\n<p align=\"center\">Inspecteur principal de 2e classe</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">Inspecteur principal de 2e classe</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<pre> </pre>\n</td>\n</tr>\n<tr>\n<td align=\"left\" colspan=\"2\" valign=\"middle\">\n<p align
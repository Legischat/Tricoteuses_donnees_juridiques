  "BLOC_TEXTUEL": {
    "CONTENU": "<p>L'avancement d'échelon a lieu à l'ancienneté.</p>\n<p>L'ancienneté requise pour accéder aux divers échelons de la hors-classe et de la classe normale est fixée comme suit :</p>\n<table border=\"2\" cellpadding=\"2\">\n<tbody>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">\n<strong>CLASSES ET AVANCEMENT D'ÉCHELON</strong>\n</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">\n<strong>ANCIENNETÉ REQUISE POUR L'ACCÈS À L'ÉCHELON SUPÉRIEUR</strong>\n</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">Hors-classe</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<pre> </pre>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">6e</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<pre> </pre>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">5e</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">5e</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">4e</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">1 an</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">3e</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">1 an</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">2e</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">1 an</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">1er</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">1 an</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">Classe normale</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<pre> </pre>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">9e</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<pre> </pre>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">8e</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">2 ans et 10 mois</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">7e</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">2 ans et 10 mois</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">6e</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">3 ans et 6 mois</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">5e</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">2 ans et 10 mois</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">4e</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">2 ans et 10 mois</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">3e</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">2 ans et 10 mois</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">2e</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">2 ans et 10 mois</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">1er</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">2 ans</p>\n</td>\n</tr>\n</tbody>\n</table>"

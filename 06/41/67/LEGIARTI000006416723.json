  "BLOC_TEXTUEL": {
    "CONTENU": "<p>Les fonctionnaires promus en application des dispositions de l'article 12 sont reclassés conformément au tableau suivant :</p>\n<table border=\"2\" cellpadding=\"2\">\n<tbody>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">ANCIENNE SITUATION</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">NOUVELLE SITUATION</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">ANCIENNETÉ CONSERVÉE</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">\n<i>Directeurs des services pénitentiaires</i>\n</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">\n<i>Directeurs des services pénitentiaires hors classe</i>\n</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<pre> </pre>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">10e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">5e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">Ancienneté conservée dans la limite de deux ans.</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">9e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">4e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">Ancienneté conservée.</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">8e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">3e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">Ancienneté conservée.</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">7e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">2e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">Ancienneté conservée.</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">6e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">1er échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">Ancienneté conservée.</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">5e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">1er échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">Sans ancienneté.</p>\n</td>\n</tr>\n</tbody>\n</table>"
  },

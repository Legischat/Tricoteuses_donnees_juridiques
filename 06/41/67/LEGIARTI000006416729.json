align=\"center\">3e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">Ancienneté conservée.</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">3e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">2e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">Ancienneté conservée.</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">2e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">1er échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">1/2 ancienneté conservée.</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">1er échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">Stagiaire</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">Ancienneté conservée.</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">Elève</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">Elève</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">Ancienneté conservée.</p>\n</td>\n</tr>\n</tbody>\n</table>\n<p>Les services accomplis par les intéressés dans leur ancien grade sont assimilés à des services accomplis dans leur grade de reclassement.</p>"

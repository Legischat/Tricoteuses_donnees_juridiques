  "BLOC_TEXTUEL": {
    "CONTENU": "<p>La durée du temps passé dans chacun des échelons du grade du corps des cadres supérieurs de La Poste régi par le présent décret, pour accéder à l'échelon supérieur, est fixée ainsi qu'il suit :</p>\n<br/>\n<div>\n<table border=\"2\" cellpadding=\"2\">\n<tbody>\n<tr>\n<td align=\"left\">\n<p align=\"center\">\n<strong>GRADES ET ECHELONS</strong>\n</p>\n</td>\n<td align=\"left\">\n<p align=\"center\">\n<strong>DUREE</strong>\n</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\">\n<p align=\"center\">\n<em>Cadre supérieur de La Poste</em>\n</p>\n</td>\n<td align=\"left\">\n<br/>\n</td>\n</tr>\n<tr>\n<td align=\"left\">\n<p align=\"left\">15e, 14e, 13e, 12e et 11e échelons</p>\n</td>\n<td align=\"left\">\n<p align=\"center\">3 ans</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\">\n<p align=\"left\">10e et 9e échelons</p>\n</td>\n<td align=\"left\">\n<p align=\"center\">2 ans</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\">\n<p align=\"left\">8e, 7e, 6e, 5e, 4e, 3e, 2e et 1er échelons</p>\n</td>\n<td align=\"left\">\n<p align=\"center\">1 an</p>\n</td>\n</tr>\n</tbody>\n</table>\n</div>"
  },

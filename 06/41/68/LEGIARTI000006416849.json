  "BLOC_TEXTUEL": {
    "CONTENU": "La durée du temps passé dans chacun des échelons des grades du corps régi par le présent décret, pour accéder à l'échelon supérieur, est fixée ainsi qu'il suit :<br/>\n<br/>\n<br/>\n<table>\n<tbody>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">\n<strong>GRADES ET ECHELONS</strong>\n</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">\n<strong>DUREE</strong>\n</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">\n<i>Agent technique et de gestion de niveau supérieur de La Poste</i>\n</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<pre> </pre>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">11e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">3 ans</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">10e, 9e, 8e, 7e, 6e, 5e et 4e échelons</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">2 ans</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">3e, 2e et 1er échelons</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">1 an</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">\n<i>Agent technique et de gestion de second niveau de La Poste</i>\n</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<pre> </pre>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">15e, 14e, 13e, 12e, 11e, 10e et 9e échelons</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">2 ans</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">8e et 7e échelons</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">3 ans</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">6e, 5e, 4e, 3e, 2e et 1er échelons</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">1 an</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">\n<i>Agent technique et de gestion de premier niveau de La Poste</i>\n</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<pre> </pre>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">17e, 16e, 15e, 14e, 13e, 12e et 11e échelons</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">2 ans</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">10e et 9e échelons</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">3 ans</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">8e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">2 ans</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">7e, 6e, 5e, 4e, 3e, 2e et 1er échelons</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">1 an</p>\n</td>\n</tr>\n</tbody>\n</table>\n<br/>"
  },

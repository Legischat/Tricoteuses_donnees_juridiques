        {
          "#text": "Décret n°83-31 du 20 janvier 1983 FIXANT LES MODALITES D'ATTRIBUTION DE L'AIDE FINANCIERE AUX ASSOCIATIONS TITULAIRES D'UNE AUTORISATION EN MATIERE DE SERVICES LOCAUX DE RADIODIFFUSION PAR VOIE HERTZIENNE",
          "@c_titre_court": "Décret n°83-31 du 20 janvier 1983",
          "@debut": "2999-01-01",

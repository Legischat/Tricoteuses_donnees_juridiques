      "TITRE_TXT": [
        {
          "#text": "Décret n°84-1061 du 1 décembre 1984 FIXANT LE CAHIER DES CHARGES APPLICABLES AUX TITULAIRES D'UNE AUTORISATION EN MATIERE DE SERVICES LOCAUX DE RADIODIFFUSION SONORE PAR VOIE HERTZIENNE",
          "@c_titre_court": "Décret n°84-1061 du 1 décembre 1984",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000515848"
        },
        {
          "#text": "Décret n°84-1061 du 1 décembre 1984 fixant le cahier des charges applicables aux titulaires d'une autorisation en matière de services locaux de radiodiffusion sonore par voie hertzienne.",
          "@c_titre_court": "Décret n°84-1061 du 1 décembre 1984",

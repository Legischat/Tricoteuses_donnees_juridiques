  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Le divorce peut être prononcé en cas :<br/>\n<br/>   - soit de consentement mutuel ;<br/>\n<br/>   - soit d'acceptation du principe de la rupture du mariage ;<br/>\n<br/>   - soit d'altération définitive du lien conjugal ;<br/>\n<br/>   - soit de faute.<br/>"
  },

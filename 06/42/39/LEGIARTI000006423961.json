  "NOTA": {
    "CONTENU": "Loi 2000-596 2000-06-30 art. 23<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Dans la détermination des besoins et des ressources, le juge prend en considération notamment :<br/>\n<br/>   - l'âge et l'état de santé des époux ;<br/>\n<br/>   - la durée du mariage ;<br/>\n<br/>   - le temps déjà consacré ou qu'il leur faudra consacrer à l'éducation des enfants ;<br/>\n<br/>   - leur qualification et leur situation professionnelles au regard du marché du travail ;<br/>\n<br/>   - leur disponibilité pour de nouveaux emplois ;<br/>\n<br/>   - leurs droits existants et prévisibles ;<br/>\n<br/>   - leur situation respective en matière de pensions de retraite ;<br/>\n<br/>   - leur patrimoine, tant en capital qu'en revenu, après la liquidation du régime matrimonial.<br/>"
  },

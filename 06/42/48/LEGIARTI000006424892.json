  "NOTA": {
    "CONTENU": "<br/>   NOTA : L'article 2-1 de la loi n° 2002-304 créant l'article 311-23 du code civil a été inséré par l'article 4 de la loi n° 2003-516.<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   La faculté de choix ouverte en application des articles 311-21 et 334-2 ne peut être exercée qu'une seule fois.<br/>\n<br/>"
  },

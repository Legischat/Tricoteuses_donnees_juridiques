  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les dépenses de l'établissement comprennent :<br/>\n<br/>   - les frais de personnel de l'établissement ;<br/>\n<br/>   - les frais de fonctionnement, de restauration, d'équipement ;<br/>\n<br/>   - les frais de travaux d'aménagement, d'entretien et de grosses réparations ;<br/>\n<br/>    - les subventions éventuelles aux organismes associés ;<br/>\n<br/>   - les acquisitions de biens culturels mentionnées au 1° de l'article 2 et, de façon générale, toutes dépenses nécessaires à l'activité de l'établissement.<br/>"
  },

  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   L'école reçoit des élèves français ou étrangers, fonctionnaires ou non, notamment :<br/>\n<br/>   - en formation initiale :<br/>\n<br/>      - des élèves ingénieurs ;<br/>\n<br/>      - des élèves stagiaires ;<br/>\n<br/>      - des auditeurs libres ;<br/>\n<br/>   - en formation continue :<br/>\n<br/>      - des élèves ;<br/>\n<br/>      - des auditeurs libres ;<br/>\n<br/>      - des stagiaires et des participants à des actions de formation continue ;<br/>\n<br/>   - en formation postscolaire et en formation par la recherche :<br/>\n<br/>      - des élèves en mastère ;<br/>\n<br/>      - des élèves et des stagiaires en diplôme d'études approfondies ;<br/>\n<br/>      - des élèves en doctorat ;<br/>\n<br/>      - des élèves chercheurs ;<br/>\n<br/>      - des stagiaires.<br/>"
  },

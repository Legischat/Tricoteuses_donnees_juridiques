  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>Peut être placé sous la sauvegarde de justice le majeur qui, pour l'une des causes prévues à l'article 490, a besoin d'être protégé dans les actes de la vie civile.<br/>\n<br/>"
  },

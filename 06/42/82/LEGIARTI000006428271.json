  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>Tous les actes passés, postérieurement au jugement d'ouverture de la tutelle, par la personne protégée, seront nuls de droit, sous réserve des dispositions de l'article 493-2.<br/>\n<br/>"
  },

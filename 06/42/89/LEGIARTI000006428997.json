      "TITRE_TXT": [
        {
          "#text": "Arrêté du 8 août 1983 portant application des dispositions des articles 5 ter et 5 quater du décret du 16 juin 1959 modifié relatives aux taux majorés de soutien financier de l'Etat aux distributeurs d'oeuvres cinématographiques.",
          "@c_titre_court": "Arrêté du 8 août 1983",

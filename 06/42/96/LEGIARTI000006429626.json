  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   En fonction de la configuration du système, les prix mensuels de location entretien sont fixés, en francs hors taxes, comme suit :<br/>\n<br/>\n -------------------------------<br/>\n INTERFACE   l         l<br/>\n T+S         l         l<br/>\n INTERFACE Z l 1 à 8   l 9 à 16<br/>\n ------------l---------l--------<br/>\n<br/> 0......... l 2222,22 l 2611,11<br/>\n<br/> 1 à 8..... l 2611,11 l 3000<br/>\n<br/> 9 à 16.... l 3000    l 3388,89<br/>\n<br/> 17 à 24... l 3388,89 l<br/>\n -------------------------------<br/>\n<br/>\n -------------------------------<br/>\n INTERFACE   l         l<br/>\n T+S         l         l<br/>\n INTERFACE Z l 17 à 24 l 25 à 32<br/>\n ------------l---------l--------<br/>\n<br/> 0......... l 3000    l 3388,89<br/>\n<br/> 1 à 8..... l 3388,89 l<br/>\n -------------------------------<br/>"
  },

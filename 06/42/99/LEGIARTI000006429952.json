  "BLOC_TEXTUEL": {
    "CONTENU": "<p>Les taxes d'affranchissement de Colissimo sont les suivantes :</p>\n<table>\n<tbody>\n<tr>\n<td rowspan=\"2\" width=\"127\">\n<p align=\"center\">ÉCHELONS DE<br/>poids</p>\n</td>\n<td colspan=\"2\" width=\"251\">\n<p align=\"center\">TAXE (en francs)</p>\n</td>\n</tr>\n<tr>\n<td width=\"132\">\n<p align=\"center\">Colissimo départemental</p>\n</td>\n<td width=\"119\">\n<p align=\"center\">Colissimo régional</p>\n</td>\n</tr>\n<tr>\n<td width=\"127\">\n<p>De 0 à 100 g</p>\n</td>\n<td width=\"132\">\n<p align=\"center\">6,20</p>\n</td>\n<td width=\"119\">\n<p align=\"center\">11,00</p>\n</td>\n</tr>\n<tr>\n<td width=\"127\">\n<p>De 100 g à 250 g</p>\n</td>\n<td width=\"132\">\n<p align=\"center\">13,00</p>\n</td>\n<td width=\"119\">\n<p align=\"center\">17,00</p>\n</td>\n</tr>\n<tr>\n<td width=\"127\">\n<p>De 250 g à 500 g</p>\n</td>\n<td width=\"132\">\n<p align=\"center\">16,00</p>\n</td>\n<td width=\"119\">\n<p align=\"center\">22,00</p>\n</td>\n</tr>\n<tr>\n<td width=\"127\">\n<p>De 500 g à 1 kg</p>\n</td>\n<td width=\"132\">\n<p align=\"center\">21,50</p>\n</td>\n<td width=\"119\">\n<p align=\"center\">29,00</p>\n</td>\n</tr>\n<tr>\n<td width=\"127\">\n<p>De 1 kg à 2 kg</p>\n</td>\n<td width=\"132\">\n<p align=\"center\">29,00</p>\n</td>\n<td width=\"119\">\n<p align=\"center\">37,00</p>\n</td>\n</tr>\n<tr>\n<td width=\"127\">\n<p>De 2 kg à 3 kg</p>\n</td>\n<td width=\"132\">\n<p align=\"center\">36,00</p>\n</td>\n<td width=\"119\">\n<p align=\"center\">44,00</p>\n</td>\n</tr>\n<tr>\n<td width=\"127\">\n<p>De 3 kg à 5 kg</p>\n</td>\n<td width=\"132\">\n<p align=\"center\">41,00</p>\n</td>\n<td width=\"119\">\n<p align=\"center\">52,00</p>\n</td>\n</tr>\n<tr>\n<td width=\"127\">\n<p>De 5 kg à 7 kg</p>\n</td>\n<td width=\"132\">\n<p align=\"center\">55,00</p>\n</td>\n<td width=\"119\">\n<p align=\"center\">60,00</p>\n</td>\n</tr>\n<tr>\n<td width=\"127\">\n<p>De 7 kg à 15 kg</p>\n</td>\n<td width=\"132\">\n<p align=\"center\">65,00</p>\n</td>\n<td width=\"119\">\n<p align=\"center\">70,00</p>\n</td>\n</tr>\n<tr>\n<td width=\"127\">\n<p>De 15 kg à 25 kg</p>\n</td>\n<td width=\"132\">\n<p align=\"center\">95,00</p>\n</td>\n<td width=\"119\">\n<p align=\"center\">102,00</p>\n</td>\n</tr>\n</tbody>\n</table>"
  }

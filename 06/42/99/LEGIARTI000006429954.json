  "BLOC_TEXTUEL": {
    "CONTENU": "<p>Il est proposé aux expéditeurs réguliers de Colissimo de bénéficier d'une tarification préférentielle, dans les conditions habituelles définies par l'arrêté du 16 mai 1989 modifié susvisé.</p>\n<p>Les taxes d'affranchissement sont les suivantes :</p>\n<table>\n<tbody>\n<tr>\n<td rowspan=\"2\" width=\"215\">\n<p align=\"center\">ÉCHELONS DE POIDS</p>\n</td>\n<td colspan=\"4\" width=\"230\">\n<p align=\"center\">COLISSIMO DÉPARTEMENTAL</p>\n</td>\n<td colspan=\"4\" width=\"235\">\n<p align=\"center\">COLISSIMO RÉGIONAL</p>\n</td>\n</tr>\n<tr>\n<td width=\"58\">\n<p align=\"center\">TP1</p>\n</td>\n<td width=\"58\">\n<p align=\"center\">TP2</p>\n</td>\n<td width=\"57\">\n<p align=\"center\">TP3</p>\n</td>\n<td width=\"57\">\n<p align=\"center\">TP4</p>\n</td>\n<td width=\"58\">\n<p align=\"center\">TP1</p>\n</td>\n<td width=\"57\">\n<p align=\"center\">TP2</p>\n</td>\n<td width=\"57\">\n<p align=\"center\">TP3</p>\n</td>\n<td width=\"63\">\n<p align=\"center\">TP4</p>\n</td>\n</tr>\n<tr>\n<td width=\"215\">\n<p>De 0 à 100 g</p>\n</td>\n<td width=\"58\">\n<p align=\"center\">6,00</p>\n</td>\n<td width=\"58\">\n<p align=\"center\">5,80</p>\n</td>\n<td width=\"57\">\n<p align=\"center\">5,60</p>\n</td>\n<td width=\"57\">\n<p align=\"center\">5,00</p>\n</td>\n<td width=\"58\">\n<p align=\"center\">10,75</p>\n</td>\n<td width=\"57\">\n<p align=\"center\">10,50</p>\n</td>\n<td width=\"57\">\n<p align=\"center\">10,00</p>\n</td>\n<td width=\"63\">\n<p align=\"center\">9,00</p>\n</td>\n</tr>\n<tr>\n<td width=\"215\">\n<p>De 100 g à 250 g</p>\n</td>\n<td width=\"58\">\n<p align=\"center\">12,60</p>\n</td>\n<td width=\"58\">\n<p align=\"center\">12,20</p>\n</td>\n<td width=\"57\">\n<p align=\"center\">11,80</p>\n</td>\n<td width=\"57\">\n<p align=\"center\">10,50</p>\n</td>\n<td width=\"58\">\n<p align=\"center\">16,50</p>\n</td>\n<td width=\"57\">\n<p align=\"center\">16,00</p>\n</td>\n<td width=\"57\">\n<p align=\"center\">15,50</p>\n</td>\n<td width=\"63\">\n<p align=\"center\">14,00</p>\n</td>\n</tr>\n<tr>\n<td width=\"215\">\n<p>De 250 g à 500 g</p>\n</td>\n<td width=\"58\">\n<p align=\"center\">15,50</p>\n</td>\n<td width=\"58\">\n<p align=\"center\">15,00</p>\n</td>\n<td width=\"57\">\n<p align=\"center\">14,50</p>\n</td>\n<td width=\"57\">\n<p align=\"center\">13,00</p>\n</td>\n<td width=\"58\">\n<p align=\"center\">21,50</p>\n</td>\n<td width=\"57\">\n<p align=\"center\">21,00</p>\n</td>\n<td width=\"57\">\n<p align=\"center\">20,00</p>\n</td>\n<td width=\"63\">\n<p align=\"center\">18,00</p>\n</td>\n</tr>\n<tr>\n<td width=\"215\">\n<p>De 500 g à 1 kg</p>\n</td>\n<td width=\"58\">\n<p align=\"center\">21,00</p>\n</td>\n<td width=\"58\">\n<p align=\"center\">20,50</p>\n</td>\n<td width=\"57\">\n<p align=\"center\">20,00</p>\n</td>\n<td width=\"57\">\n<p align=\"center\">18,00</p>\n</td>\n<td width=\"58\">\n<p align=\"center\">28,50</p>\n</td>\n<td width=\"57\">\n<p align=\"center\">27,50</p>\n</td>\n<td width=\"57\">\n<p align=\"center\">26,50</p>\n</td>\n<td width=\"63\">\n<p align=\"center\">24,00</p>\n</td>\n</tr>\n<tr>\n<td width=\"215\">\n<p>De 1 kg à 2 kg</p>\n</td>\n<td width=\"58\">\n<p align=\"center\">28,20</p>\n</td>\n<td width=\"58\">\n<p align=\"center\">27,40</p>\n</td>\n<td width=\"57\">\n<p align=\"center\">26,60</p>\n</td>\n<td width=\"57\">\n<p align=\"center\">24,00</p>\n</td>\n<td width=\"58\">\n<p align=\"center\">36,00</p>\n</td>\n<td width=\"57\">\n<p align=\"center\">35,00</p>\n</td>\n<td width=\"57\">\n<p align=\"center\">34,00</p>\n</td>\n<td width=\"63\">\n<p align=\"center\">31,00</p>\n</td>\n</tr>\n<tr>\n<td width=\"215\">\n<p>De 2 kg à 3 kg</p>\n</td>\n<td width=\"58\">\n<p align=\"center\">35,00</p>\n</td>\n<td width=\"58\">\n<p align=\"center\">34,00</p>\n</td>\n<td width=\"57\">\n<p align=\"center\">33,00</p>\n</td>\n<td width=\"57\">\n<p align=\"center\">29,50</p>\n</td>\n<td width=\"58\">\n<p align=\"center\">43,00</p>\n</td>\n<td width=\"57\">\n<p align=\"center\">41,50</p>\n</td>\n<td width=\"57\">\n<p align=\"center\">40,00</p>\n</td>\n<td width=\"63\">\n<p align=\"center\">36,00</p>\n</td>\n</tr>\n<tr>\n<td width=\"215\">\n<p>De 3 kg à 5 kg</p>\n</td>\n<td width=\"58\">\n<p align=\"center\">40,00</p>\n</td>\n<td width=\"58\">\n<p align=\"center\">39,00</p>\n</td>\n<td width=\"57\">\n<p align=\"center\">38,00</p>\n</td>\n<td width=\"57\">\n<p align=\"center\">34,00</p>\n</td>\n<td width=\"58\">\n<p align=\"center\">50,50</p>\n</td>\n<td width=\"57\">\n<p align=\"center\">49,00</p>\n</td>\n<td width=\"57\">\n<p align=\"center\">47,50</p>\n</td>\n<td width=\"63\">\n<p align=\"center\">42,50</p>\n</td>\n</tr>\n<tr>\n<td width=\"215\">\n<p>De 5 kg à 7 kg</p>\n</td>\n<td width=\"58\">\n<p align=\"center\">53,50</p>\n</td>\n<td width=\"58\">\n<p align=\"center\">52,00</p>\n</td>\n<td width=\"57\">\n<p align=\"center\">50,50</p>\n</td>\n<td width=\"57\">\n<p align=\"center\">45,50</p>\n</td>\n<td width=\"58\">\n<p align=\"center\">58,00</p>\n</td>\n<td width=\"57\">\n<p align=\"center\">56,50</p>\n</td>\n<td width=\"57\">\n<p align=\"center\">55,00</p>\n</td>\n<td width=\"63\">\n<p align=\"center\">49,50</p>\n</td>\n</tr>\n<tr>\n<td width=\"215\">\n<p>De 7 kg à 15 kg</p>\n</td>\n<td width=\"58\">\n<p align=\"center\">63,00</p>\n</td>\n<td width=\"58\">\n<p align=\"center\">61,00</p>\n</td>\n<td width=\"57\">\n<p align=\"center\">59,00</p>\n</td>\n<td width=\"57\">\n<p align=\"center\">52,00</p>\n</td>\n<td width=\"58\">\n<p align=\"center\">68,00</p>\n</td>\n<td width=\"57\">\n<p align=\"center\">66,00</p>\n</td>\n<td width=\"57\">\n<p align=\"center\">64,00</p>\n</td>\n<td width=\"63\">\n<p align=\"center\">56,00</p>\n</td>\n</tr>\n<tr>\n<td width=\"215\">\n<p>De 15 kg à 25 kg</p>\n</td>\n<td width=\"58\">\n<p align=\"center\">92,50</p>\n</td>\n<td width=\"58\">\n<p align=\"center\">89,50</p>\n</td>\n<td width=\"57\">\n<p align=\"center\">86,50</p>\n</td>\n<td width=\"57\">\n<p align=\"center\">76,00</p>\n</td>\n<td width=\"58\">\n<p align=\"center\">99,00</p>\n</td>\n<td width=\"57\">\n<p align=\"center\">96,00</p>\n</td>\n<td width=\"57\">\n<p align=\"center\">93,00</p>\n</td>\n<td width=\"63\">\n<p align=\"center\">82,00</p>\n</td>\n</tr>\n</tbody>\n</table>"
  },

  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Le jury appréciera :<br/>\n<br/>   - l'esthétique des bâtiments ;<br/>\n<br/>   - l'aspect novateur de leur conception ;<br/>\n<br/>   - l'insertion dans l'environnement ;<br/>\n<br/>   - la qualité de la fonction d'accueil ;<br/>\n<br/>   - l'adéquation à la demande des usagers ;<br/>\n<br/>   - les coûts d'investissement et de fonctionnement.<br/>\n<br/>   Il pourra se rendre sur place et se faire assister d'une commission technique.<br/>"
  }

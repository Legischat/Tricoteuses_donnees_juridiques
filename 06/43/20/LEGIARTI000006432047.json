  "NOTA": {
    "CONTENU": "<br/>   NOTA : Le registre public institué par le présent article prend le nom de << Registre public de la cinématographie et de l'audiovisuel >>, Décret n° 87-348 du 22 mai 1987.<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Il est tenu à Paris, au centre national de la cinématographie, un registre public destiné à assurer la publicité des conventions visées aux articles 32 et 33 et intervenues à l'occasion de la production, de la distribution et de l'exploitation des films cinématographiques produits, distribués ou exploités en France.<br/>\n<br/>"
  },

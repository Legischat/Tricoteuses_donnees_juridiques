  "NOTA": {
    "CONTENU": "<br/>  Décret 2006-1706 du 22 décembre 2006 art. 20 : <br/>Les dispositions du présent décret entrent en vigueur à compter de la session d'examen organisée en 2008.<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Le diplôme de comptabilité et de gestion est également délivré aux candidats dispensés de certaines épreuves en application de l'article 10 et qui ont satisfait aux autres épreuves du diplôme.<br/>\n<br/>"
  },

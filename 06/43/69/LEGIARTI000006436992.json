  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les obligations s'éteignent :<br/>\n<br/>   Par le paiement,<br/>\n<br/>   Par la novation,<br/>\n<br/>   Par la remise volontaire,<br/>\n<br/>   Par la compensation,<br/>\n<br/>   Par la confusion,<br/>\n<br/>   Par la perte de la chose,<br/>\n<br/>   Par la nullité ou la rescision,<br/>\n<br/>   Par l'effet de la condition résolutoire, qui a été expliquée au chapitre précédent,<br/>\n<br/>   Et par la prescription, qui fera l'objet d'un titre particulier.<br/>"
  },

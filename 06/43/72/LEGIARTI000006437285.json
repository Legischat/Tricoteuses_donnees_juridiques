  "NOTA": {
    "CONTENU": "<br/>   NOTA : Décret 2005-1010 du 22 août 2005, art. 3 : Les dispositions du présent décret entrent en vigueur à compter de la session 2006.<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les diplômes délivrés aux candidats admis peuvent porter les mentions suivantes :<br/>\n<br/>   - la mention \"assez bien\", quand le candidat a obtenu une note moyenne au moins égale à 12 et inférieure à 14 ;<br/>\n<br/>   - la mention \"bien\", quand le candidat a obtenu une note moyenne au moins égale à 14 et inférieure à 16 ;<br/>\n<br/>   - la mention \"très bien\", quand le candidat a obtenu une note moyenne au moins égale à 16.<br/>"
  },

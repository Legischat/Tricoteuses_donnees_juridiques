    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret n°88-115 du 1 février 1988 FIXANT LES CONDITIONS D'APPLICATION AUX MAITRES DES ETABLISSEMENTS DES ENSEIGNEMENTS PRIVES SOUS CONTRAT DE LA NOUVELLE-CALEDONIE ET DEPENDANCES DES DISPOSITIONS DE DECRET PRIS POUR L'APPLICATION DE LA LOI 591557 DU 31-12-1959 MODIFIE",
          "@c_titre_court": "Décret n°88-115 du 1 février 1988",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000867160"
        },
        {
          "#text": "Décret n°88-115 du 1 février 1988 fixant les conditions d'application aux maîtres des établissements d'enseignement privés sous contrat de la Nouvelle-Calédonie des dispositions de décrets pris pour l'application de la loi n° 59-1557 du 31 décembre 1959 modifiée",
          "@c_titre_court": "Décret n°88-115 du 1 février 1988",
          "@debut": "1988-02-04",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006066361"
        }
      ],

        {
          "#text": "Décret n°88-922 du 14 septembre 1988 PRIS POUR L'APPLICATION DE LA LOI 841285 DU 31-12-1984 PORTANT REFORME DES RELATIONS ENTRE L'ETAT ET LES ETABLISSEMENTS D'ENSEIGNEMENT AGRICOLE PRIVES(ART. 3,4,5,7 ET 13)",
          "@c_titre_court": "Décret n°88-922 du 14 septembre 1988",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000314811"
        },
        {
          "#text": "Décret n°88-922 du 14 septembre 1988 pris pour l'application de la loi n° 84-1285 du 31 décembre 1984 portant réforme des relations entre l'Etat et les établissements d'enseignement agricole privés",
          "@c_titre_court": "Décret n°88-922 du 14 septembre 1988",
          "@debut": "1988-09-15",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006066915"

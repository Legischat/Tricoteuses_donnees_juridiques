      "TITRE_TXT": [
        {
          "#text": "Décret n°60-386 du 22 avril 1960 RELATIF AUX TITRES DE CAPACITE DONT DOIVENT JUSTIFIER LES DIRECTEURS ET MAITRES DES ETABLISSEMENTS D'ENSEIGNEMENT PRIVES PLACES SOUS CONTRAT",
          "@c_titre_court": "Décret n°60-386 du 22 avril 1960",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000685296"
        },
        {
          "#text": "Décret n°60-386 du 22 avril 1960 relatif aux titres de capacité dont doivent justifier les directeurs et maîtres des établissements d'enseignement privés placés sous contrat.",
          "@c_titre_court": "Décret n°60-386 du 22 avril 1960",
          "@debut": "1960-04-24",
          "@fin": "2008-12-29",
          "@id_txt": "LEGITEXT000006060959"
        }
      ],

      "TITRE_TXT": [
        {
          "#text": "Décret n°85-900 du 21 août 1985 FIXANT LES CONDITIONS D'APPLICATION AUX ETABLISSEMENTS D'ENSEIGNEMENT PRIVES SOUS CONTRAT DE LA NOUVELLE-CALEDONIE ET DEPENDANCES DES DISPOSITIONS DES DECRETS PRIS POUR L'APPLICATION DE LA LOI 591557 DU 31-12-1959 MODIFIEE",
          "@c_titre_court": "Décret n°85-900 du 21 août 1985",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000688808"
        },
        {
          "#text": "Décret n°85-900 du 21 août 1985 fixant les conditions d'application aux établissements d'enseignement privés sous contrat de la Nouvelle-Calédonie des dispositions de décrets pris pour l'application de la loi n° 59-1557 du 31 décembre 1959 modifiée",
          "@c_titre_court": "Décret n°85-900 du 21 août 1985",
          "@debut": "1985-08-27",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006065131"
        }
      ],

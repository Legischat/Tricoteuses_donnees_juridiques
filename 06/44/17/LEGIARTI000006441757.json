    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret n°66-665 du 3 septembre 1966 RELATIF A LA SITUATION DES MAITRES DE L'ENSEIGNEMENT PRIVE QUI ONT OU AURONT EXERCE HORS DU TERRITOIRE METROPOLITAIN ET DES DEPARTEMENTS D'OUTRE-MER",
          "@c_titre_court": "Décret n°66-665 du 3 septembre 1966",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000702436"
        },
        {
          "#text": "Décret n°66-665 du 3 septembre 1966 relatif à la situation des maîtres de l'enseignement privé qui ont ou auront exercé hors du territoire métropolitain et des départements d'outre-mer",
          "@c_titre_court": "Décret n°66-665 du 3 septembre 1966",
          "@debut": "1966-09-13",
          "@fin": "2008-12-29",
          "@id_txt": "LEGITEXT000006061372"
        }
      ],

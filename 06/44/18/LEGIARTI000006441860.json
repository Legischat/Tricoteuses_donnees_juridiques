      "TITRE_TXT": [
        {
          "#text": "Décret n°78-252 du 8 mars 1978 FIXANT LES REGLES GENERALES DETERMINANT LES CONDITIONS DE SERVICE DE CERTAINS MAITRES CONTRACTUELS OU AGREES DES ETABLISSEMENTS D'ENSEIGNEMENT PRIVES SOUS CONTRAT ET LES MESURES SOCIALES APPLICABLES A CES PERSONNELS",
          "@c_titre_court": "Décret n°78-252 du 8 mars 1978",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000702304"
        },
        {
          "#text": "Décret n° 78-252 du 8 mars 1978 fixant les règles générales déterminant les conditions de service de certains maîtres contractuels ou agréés des établissements d'enseignement privés sous contrat et des mesures sociales applicables à ces personnels",
          "@c_titre_court": "Décret n° 78-252 du 8 mars 1978",
          "@debut": "1978-01-01",
          "@fin": "2008-12-29",
          "@id_txt": "LEGITEXT000006062825"
        }
      ],

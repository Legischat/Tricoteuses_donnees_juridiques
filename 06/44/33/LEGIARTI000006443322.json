  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   L'Ecole polytechnique de l'université de Nantes a notamment pour mission :<br/>\n<br/>   - la formation d'ingénieurs, initiale, en alternance ou par apprentissage ;<br/>\n<br/>   - la formation continue ;<br/>\n<br/>   - le développement de la recherche et de la technologie ;<br/>\n<br/>   - l'aide au développement industriel ;<br/>\n<br/>   - la valorisation des résultats obtenus au plan national et international.<br/>"
  },

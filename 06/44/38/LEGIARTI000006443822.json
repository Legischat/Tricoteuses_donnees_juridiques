  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   L'Ecole polytechnique universitaire de Marseille a notamment pour mission :<br/>\n<br/>   - la formation initiale, en alternance ou par apprentissage, d'ingénieurs ;<br/>\n<br/>   - la formation continue ;<br/>\n<br/>   - le développement des technologies de l'information et de la communication appliquées à la formation ;<br/>\n<br/>   - le développement de la recherche et de l'innovation technologique ;<br/>\n<br/>   - la valorisation des résultats obtenus au plan national et international ;<br/>\n<br/>   - l'aide au développement économique et industriel.<br/>"
  },

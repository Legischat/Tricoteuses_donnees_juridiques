  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Sont créés les instituts du travail suivants :<br/>\n<br/>   Institut des sciences du travail, Lille-II ;<br/>\n<br/>   Institut d'éducation ouvrière, Lyon-II ;<br/>\n<br/>   Institut d'études du travail et de la Sécurité sociale, Lyon-II ;<br/>\n<br/>   Institut régional du travail, Nancy-II ;<br/>\n<br/>   Institut des sciences sociales du travail, Paris-I ;<br/>\n<br/>   Institut des sciences sociales du travail, Rennes-II ;<br/>\n<br/>   Institut du travail, Strasbourg-III ;<br/>\n<br/>   Institut du travail, Saint-Etienne ;<br/>\n<br/>   Institut régional du travail, Aix-Marseille-II.<br/>"
  },

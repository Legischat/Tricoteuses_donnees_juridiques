  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Sont créées les écoles internes suivantes :<br/>\n<br/>   Aix-Marseille-II :<br/>\n<br/>   Ecole de journalisme et de la communication.<br/>\n<br/>   Lille-III :<br/>\n<br/>   Ecole de formation des conseillers d'orientation.<br/>\n<br/>   Lyon-I :<br/>\n<br/>   Institut de science financière et d'assurances (ISFA).<br/>\n<br/>   Paris-III :<br/>\n<br/>   Ecole supérieure d'interprètes et de traducteurs.<br/>\n<br/>   Paris-IV :<br/>\n<br/>   Centre d'études littéraires et scientifiques appliquées.<br/>\n<br/>   Paris-VI :<br/>\n<br/>   Institut Henri-Poincaré.<br/>\n<br/>   Toulouse-II :<br/>\n<br/>   Ecole supérieure d'audiovisuel (ESAV).<br/>"
  },

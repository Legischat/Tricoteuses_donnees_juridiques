      "TITRE_TXT": [
        {
          "#text": "Arrêté du 17 janvier 1989 FIXANT LES MODALITES D'APPLICATION DU DECRET 84913 DU 12-10-1984 APPLICABLES AUX ETUDIANTS RELEVANT DU REGIME D'ETUDES DEFINI PAR LE DECRET 88996 DU 19-10-1988",
          "@c_titre_court": "Arrêté du 17 janvier 1989",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000873980"
        },
        {
          "#text": "Arrêté du 17 janvier 1989 fixant les modalités d'application du décret n° 84-913 du 12 octobre 1984 applicables aux étudiants relevant du régime d'études défini par le décret n° 88-996 du 19 octobre 1988",
          "@c_titre_court": "Arrêté du 17 janvier 1989",

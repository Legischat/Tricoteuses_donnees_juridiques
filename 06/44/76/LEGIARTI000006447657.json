  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   La prescription ne court point :<br/>\n<br/>   A l'égard d'une créance qui dépend d'une condition, jusqu'à ce que la condition arrive ;<br/>\n<br/>   A l'égard d'une action en garantie, jusqu'à ce que l'éviction ait lieu ;<br/>\n<br/>   A l'égard d'une créance à jour fixe, jusqu'à ce que ce jour soit arrivé.<br/>"
  },

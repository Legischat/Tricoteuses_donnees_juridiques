  "NOTA": {
    "CONTENU": "<br/>  Ordonnance 2006-346 du 6 mars 2006 art. 57 : Spécificités d'application.<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>Entre les créanciers, les privilèges ne produisent d'effet à l'égard des immeubles qu'autant qu'ils sont rendus publics par une inscription à la conservation des hypothèques, de la manière déterminée par les articles suivants et par les articles 2426 et 2428.<br/>\n<br/>"
  },

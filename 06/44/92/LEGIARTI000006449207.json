  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les sanctions disciplinaires applicables aux membres du Conseil d'Etat sont :<br/>\n<br/>   1° L'avertissement ;<br/>\n<br/>   2° Le blâme ;<br/>\n<br/>   3° L'exclusion temporaire de fonctions dans la limite de six mois ;<br/>\n<br/>   4° La mise à la retraite d'office ;<br/>\n<br/>   5° La révocation.<br/>"
  },

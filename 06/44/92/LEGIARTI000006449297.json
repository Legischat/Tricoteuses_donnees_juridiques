  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les dispositions de l'article L. 231-3 ne sont pas applicables lorsque les membres du corps des tribunaux administratifs et cours administratives d'appel font l'objet d'un déplacement d'office pour raison disciplinaire.<br/>\n<br/>"
  },

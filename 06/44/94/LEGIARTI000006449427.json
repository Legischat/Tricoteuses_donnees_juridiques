  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Saisi par toute partie qui fait état de la durée excessive d'une procédure engagée devant un tribunal administratif ou une cour administrative d'appel, le chef de la mission permanente d'inspection des juridictions administratives a la faculté de faire des recommandations visant à remédier à cette situation.<br/>\n<br/>"
  },

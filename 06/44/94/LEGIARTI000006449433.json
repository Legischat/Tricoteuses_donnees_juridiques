  "NOTA": {
    "CONTENU": "<br/>  Ordonnance 2006-346 du 6 mars 2006 art. 57 : Spécificités d'application.<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>Les jugements pris en application des deux articles précédents sont rendus dans les formes réglées par le code de procédure civile. <br/>\n<br/>Sous réserve des dispositions de l'article 2403, l'hypothèque légale des époux est soumise, pour le renouvellement des inscriptions, aux règles de l'article 2434.<br/>"
  },

  "NOTA": {
    "CONTENU": "<br/>  La loi du 19 octobre 1946 étant abrogée, cf loi 84-16 du 11 janvier 1984.<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Il est créé un emploi de secrétaire général.<br/>\n<br/>   Le secrétaire général est nommé dans les conditions prévues à l'article 3 (alinéa 2) de la loi du 19 octobre 1946 relative au statut général des fonctionnaires, par décret, sur présentation du bureau du Conseil économique.<br/>"
  },

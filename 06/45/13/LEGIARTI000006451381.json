          "#text": "Loi n°70-2 du 2 janvier 1970 TENDANT A FACILITER L'ACCES DES OFFICIERS A DES EMPLOIS CIVILS",
          "@c_titre_court": "Loi n°70-2 du 2 janvier 1970",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000693658"
        },
        {
          "#text": "Loi n°70-2 du 2 janvier 1970 tendant à faciliter l'accès des militaires à des emplois civils (1).",
          "@c_titre_court": "Loi n°70-2 du 2 janvier 1970",
          "@debut": "1985-07-03",
          "@fin": "2005-07-01",

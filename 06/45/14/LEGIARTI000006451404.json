  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Loi n°50-772 du 30 juin 1950 FIXANT LES CONDITIONS D'ATTRIBUTION DES SOLDES ET INDEMNITES DES FONCTIONNAIRES CIVILS ET MILITAIRES RELEVANT DU MINISTERE DE LA FRANCE D'OUTRE-MER, LES CONDITIONS DE RECRUTEMENT, DE MISE EN CONGE OU A LA RETRAITE DE CES MEMES FONCTIONNAIRES",
          "@c_titre_court": "Loi n°50-772 du 30 juin 1950",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000886443"
        },
        {
          "#text": "Loi n° 50-772 du 30 juin 1950 fixant les conditions d'attribution des soldes et indemnités des fonctionnaires civils et militaires relevant du ministère de la France d'outre-mer, les conditions de recrutement, de mise en congé ou à la retraite de ces mêmes fonctionnaires.",
          "@c_titre_court": "Loi n° 50-772 du 30 juin 1950",
          "@debut": "1950-07-01",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006068078"
        }
      ],
      "@cid": "JORFTEXT000000886443",
      "@date_publi": "1950-07-01",

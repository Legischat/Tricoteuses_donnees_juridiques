  "NOTA": {
    "CONTENU": "<br/>  Ordonnance 2004-545 du 11 juin 2004 art. 7 I : L'article 6 n'est abrogé qu'à compter de la publication des dispositions réglementaires du code de la recherche.<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {

      "TITRE_TXT": [
        {
          "#text": "Décret n°48-1018 du 16 juin 1948 FIXANT LE STATUT DES AGENTS SUR CONTRAT DU MINISTERE DES TRAVAUX PUBLICS DES TRANSPORTS ET DU TOURISME (SECRETARIAT GENERAL A L'AVIATION CIVILE ET COMMERCIALE)",
          "@c_titre_court": "Décret n°48-1018 du 16 juin 1948",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000669364"
        },
        {
          "#text": "Décret n°48-1018 du 16 juin 1948 fixant le statut des agents sur contrat du ministère des travaux publics, des transports et du tourisme (secrétariat général à l'aviation civile et commerciale).",
          "@c_titre_court": "Décret n°48-1018 du 16 juin 1948",

  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>\n<p>Dans chaque catégorie de personnel technique, les échelons et l'ancienneté requise pour accéder à l'échelon supérieur sont fixés comme suit :</p>\n<p>\n<br clear=\"none\"/>\n\n</p>\n<br/>\n<div>\n<table>\n<tbody>\n<tr>\n<td align=\"center\">ECHELONS <br clear=\"none\"/>\n</td>\n<td align=\"center\">\n<p> 1re</p>\n<p>catégorie.  </p>\n</td>\n<td align=\"center\">\n<p>2e</p>\n<p>catégorie. </p>\n</td>\n<td align=\"center\">\n<p>3e </p>\n<p>catégorie. </p>\n</td>\n</tr>\n<tr>\n<td>Du 11e au 12e échelon <br clear=\"none\"/>\n</td>\n<td align=\"center\"> </td>\n<td align=\"center\"> </td>\n<td align=\"center\">2 ans. <br clear=\"none\"/>\n</td>\n</tr>\n<tr>\n<td>Du 10e au 11e échelon <br clear=\"none\"/>\n</td>\n<td align=\"center\"> </td>\n<td align=\"center\"> </td>\n<td align=\"center\"> 2 ans. </td>\n</tr>\n<tr>\n<td>Du 9e au 10e échelon <br clear=\"none\"/>\n</td>\n<td align=\"center\"> </td>\n<td align=\"center\"> </td>\n<td align=\"center\"> 2 ans. </td>\n</tr>\n<tr>\n<td>Du 8e au 9e échelon <br clear=\"none\"/>\n</td>\n<td align=\"center\"> </td>\n<td align=\"center\"> 2 ans. </td>\n<td align=\"center\"> 2 ans. </td>\n</tr>\n<tr>\n<td>Du 7e au 8e échelon <br clear=\"none\"/>\n</td>\n<td align=\"center\"> </td>\n<td align=\"center\"> 2 ans. </td>\n<td align=\"center\"> 2 ans. </td>\n</tr>\n<tr>\n<td>Du 6e au 7e échelon <br clear=\"none\"/>\n</td>\n<td align=\"center\"> </td>\n<td align=\"center\"> 2 ans. </td>\n<td align=\"center\"> 2 ans. </td>\n</tr>\n<tr>\n<td>Du 5e au 6e échelon <br clear=\"none\"/>\n</td>\n<td align=\"center\"> </td>\n<td align=\"center\"> 2 ans. </td>\n<td align=\"center\"> 2 ans. </td>\n</tr>\n<tr>\n<td>Du 4e au 5e échelon <br clear=\"none\"/>\n</td>\n<td align=\"center\"> 2 ans. </td>\n<td align=\"center\"> 2 ans. </td>\n<td align=\"center\">2 ans. </td>\n</tr>\n<tr>\n<td>Du 3e au 4e échelon <br clear=\"none\"/>\n</td>\n<td align=\"center\"> 2 ans. </td>\n<td align=\"center\"> 2 ans. </td>\n<td align=\"center\">\n<p> 1 an et </p>\n<p>6 mois. </p>\n</td>\n</tr>\n<tr>\n<td>Du 2e au 3e échelon <br clear=\"none\"/>\n</td>\n<td align=\"center\"> 2 ans. </td>\n<td align=\"center\"> 2 ans. </td>\n<td align=\"center\">\n<p> 1 an et </p>6 mois.</td>\n</tr>\n<tr>\n<td>Du 1er au 2e échelon <br clear=\"none\"/>\n</td>\n<td align=\"center\"> 2 ans. </td>\n<td align=\"center\"> 2 ans. </td>\n<td align=\"center\">\n<p> 1 an.</p>\n</td>\n</tr>\n</tbody>\n</table>\n</div>"
  },

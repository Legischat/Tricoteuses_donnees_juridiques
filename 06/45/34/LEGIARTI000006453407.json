  "BLOC_TEXTUEL": {
    "CONTENU": "<p>L'avancement d'échelon des inspecteurs de la jeunesse et des sports de 2e classe prend effet du jour où les intéressés remplissent les conditions d'ancienneté dans l'échelon fixées ci-après :</p>\n<table border=\"2\" cellpadding=\"2\">\n<tbody>\n<tr>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">\n<strong>ECHELONS</strong>\n</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">\n<strong>DUREE D'ECHELON</strong>\n</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">7 e échelon</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">-</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">6 e échelon</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">3 ans</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">5 e échelon</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">3 ans</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">4e échelon</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">3 ans</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">3 e échelon</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">2 ans</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">2 e échelon</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">2 ans</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">1<sup>er</sup> échelon</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">1 an</p>\n</td>\n</tr>\n</tbody>\n</table>"
  }
}
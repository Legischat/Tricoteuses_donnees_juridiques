  "BLOC_TEXTUEL": {
    "CONTENU": "La durée du temps passé dans chacun des échelons des grades du corps régi par le présent décret, pour accéder à l'échelon supérieur, est fixée ainsi qu'il suit :<br/>\n<br/>\n<br/>\n<table border=\"2\" cellpadding=\"2\">\n<tbody>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">\n<strong>GRADES et ECHELONS</strong>\n</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">\n<strong>DUREE</strong>\n</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">\n<i>Cadre de second niveau</i>\n</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<pre> </pre>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">13e et 13e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">2 ans</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">12e, 11e, 10e et 9e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">3 ans</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">8e, 7e, 6e, 5e, 4e et 3e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">1 an</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">2e et 1er échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">6 mois</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">\n<i>Cadre de premier niveau</i>\n</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<pre> </pre>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">12e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">3 ans</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">11e et 10e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">2 ans</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">9e, 8e, 7e, et 6e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">3 ans</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">5e, 4e ,3e, 2e et 1er échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">1 an</p>\n</td>\n</tr>\n</tbody>\n</table>\n<br/>\n<br/>"
  }

r>\n<td colspan=\"2\" valign=\"top\" width=\"121\">\n<p>- avant 1 an 6 mois</p>\n</td>\n<td valign=\"top\" width=\"86\">\n<p align=\"center\"> </p>\n</td>\n<td valign=\"top\" width=\"69\">\n<p align=\"center\">7<sup>e</sup>\n</p>\n</td>\n<td valign=\"top\" width=\"224\">\n<p>Ancienneté acquise majorée de 1 an et 6 mois</p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" valign=\"top\" width=\"121\">\n<p>6<sup>e</sup> :</p>\n</td>\n<td valign=\"top\" width=\"86\">\n<p align=\"center\"> </p>\n</td>\n<td valign=\"top\" width=\"69\">\n<p align=\"center\"> </p>\n</td>\n<td valign=\"top\" width=\"224\"/>\n</tr>\n<tr>\n<td colspan=\"2\" valign=\"top\" width=\"121\">\n<p>- après 6 mois</p>\n</td>\n<td valign=\"top\" width=\"86\">\n<p align=\"center\"> </p>\n</td>\n<td valign=\"top\" width=\"69\">\n<p align=\"center\">7<sup>e</sup>\n</p>\n</td>\n<td valign=\"top\" width=\"224\">\n<p>Ancienneté acquise minorée de 6 mois</p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" valign=\"top\" width=\"121\">\n<p>- avant 6 mois</p>\n</td>\n<td valign=\"top\" width=\"86\">\n<p align=\"center\"> </p>\n</td>\n<td valign=\"top\" width=\"69\">\n<p align=\"center\">6<sup>e</sup>\n</p>\n</td>\n<td valign=\"top\" width=\"224\">\n<p>Ancienneté acquise majorée de 2 ans</p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" valign=\"top\" width=\"121\">\n<p>5<sup>e</sup>\n</p>\n</td>\n<td valign=\"top\" width=\"86\">\n<p align=\"center\"> </p>\n</td>\n<td valign=\"top\" width=\"69\">\n<p align=\"center\">6<sup>e</sup>\n</p>\n</td>\n<td valign=\"top\" width=\"224\">\n<p>Ancienneté acquise</p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" valign=\"top\" width=\"121\">\n<p>4<sup>e</sup>\n</p>\n</td>\n<td valign=\"top\" width=\"86\">\n<p align=\"center\"> </p>\n</td>\n<td valign=\"top\" width=\"69\">\n<p align=\"center\">5<sup>e</sup>\n</p>\n</td>\n<td valign=\"top\" width=\"224\">\n<p>Ancienneté acquise</p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" valign=\"top\" width=\"121\">\n<p>3<sup>e</sup>\n</p>\n</td>\n<td valign=\"top\" width=\"8
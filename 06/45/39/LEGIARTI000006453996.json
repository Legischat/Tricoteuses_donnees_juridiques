  "BLOC_TEXTUEL": {
    "CONTENU": "<p>ANNEXE</p>\n<p>Tableau</p>\n<table>\n<tbody>\n<tr>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">- 1 - <br/>\n<br/>\n<strong>CORPS</strong>\n</p>\n</td>\n<td align=\"left\" colspan=\"2\" valign=\"top\">\n<p align=\"center\">- 2 - <br/>\n<br/>\n<strong>POURCENTAGE <br/>\n</strong>\n<br/>autorisé pour le recours à la liste complémentaire</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">- 3 - <br/>\n<br/>\n<strong>PROPORTION STATUTAIRE</strong>\n<br/>\n<br/>concours externe/concours interne</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<pre> </pre>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">Concours externe</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">Concours interne</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<pre> </pre>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">Délégués des services déconcentrés</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">150 %</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">100 %</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">50 % - 50 % <br/>\n<br/>(art. 3 du décret n° 73-1237 du 28-12-73)</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">Secrétaires administratifs d'administration centrale</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">100 %</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">75 %</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">50 % - 50 % <br/>\n<br/>(art. 6 du décret n° 55-1649 du 16-12-55)</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">Secrétaires administratifs des services déconcentrés</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">150 %</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">100 %</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">50 % - 50 % <br/>\n<br/>(art. 6 du décret n° 75-814 du 22-08-75)</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">Experts-vérificateurs et agents de maîtrise du service de l'appareillage des mutilés</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">100 %</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">100 %</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">50 % - 50 % <br/>\n<br/>(art. 6 du décret n° 58-1026 du 28-10-58)</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">Adjoints administratifs</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">100 %</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">75 %</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">50 % - 50 % <br/>\n<br/>(art. 13 du décret n° 58-651 du 30-07-58)</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">Commis</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">100 %</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">100 %</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">50 % - 50 % <br/>\n<br/>(art. 13 du décret n° 58-651 du 30-07-58)</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">Sténodactylographes d'administration centrale</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">Concours</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">unique 50 %</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">-</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">Sténodactylographes des services déconcentrés</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">Concours</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">unique 75 %</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">-</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">Préposés téléphonistes</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">Examen</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">professionnels 50 %</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">-</p>\n</td>\n</tr>\n</tbody>\n</table>"

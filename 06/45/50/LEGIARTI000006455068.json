  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret n°82-887 du 18 octobre 1982 INSTITUANT UNE PRISE EN CHARGE PARTIELLE DU PRIX DES TITRES D'ABONNEMENT CORRESPONDANT AUX DEPLACEMENTS EFFECTUES A L'INTERIEUR DE LA ZONE DE COMPETENCE DE L'AUTORITE ORGANISATRICE DES TRANSPORTS PARISIENS PAR LES FONCTIONNAIRES ET AGENTS DE L'ETAT ET DES ETABLISSEMENTS PUBLICS DE L'ETAT A CARACTERE ADMINISTRATIF ENTRE LEUR RESIDENCE HABITUELLE ET LEUR LIEU DE TRAVAIL",
          "@c_titre_court": "Décret n°82-887 du 18 octobre 1982",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000334850"
        },
        {
          "#text": "Décret n°82-887 du 18 octobre 1982 instituant une prise en charge partielle du prix des titres d'abonnement correspondant aux déplacements effectués à l'intérieur de la zone de compétence de l'autorité organisatrice des transports parisiens par les fonctionnaires et agents de l'Etat et des établissements publics de l'Etat à caractère administratif entre leur résidence habituelle et leur lieu de travail.",
          "@c_titre_court": "Décret n°82-887 du 18 octobre 1982",
          "@debut": "1982-10-19",
          "@fin": "2010-07-01",
          "@id_txt": "LEGITEXT000006063925"
        }
      ],
      "@cid": "JORFTEXT000000334850",
      "@date_publi": "1982-10-19",
      "@date_signature": "1982-10-18",
      "@nature": "DECRET",
      "@num": "82-887"
    }
  },

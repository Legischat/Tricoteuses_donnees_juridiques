    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret n°87-334 du 13 mai 1987 FIXANT LES MODALITES D'INTEGRATION DES FONCTIONNAIRES APPARTENANT AUX CORPS DE FONCTIONNAIRES DE L'ETAT POUR L'ADMINISTRATION DE SAINT-PIERRE-ET-MIQUELON DANS LES CORPS METROPOLITAINS DES SERVICES EXTERIEURS DES DOUANES",
          "@c_titre_court": "Décret n°87-334 du 13 mai 1987",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000517873"
        },
        {
          "#text": "Décret n°87-334 du 13 mai 1987 fixant les modalités d'intégration des fonctionnaires appartenant aux corps de fonctionnaires de l'Etat pour l'administration de Saint-Pierre-et-Miquelon dans les corps métropolitains des services extérieurs des douanes",
          "@c_titre_court": "Décret n°87-334 du 13 mai 1987",
          "@debut": "1992-02-08",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006065956"
        }
      ],
      "@cid": "JORFTEXT000000517873",

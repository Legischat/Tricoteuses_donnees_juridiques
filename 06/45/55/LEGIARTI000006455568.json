      "TITRE_TXT": [
        {
          "#text": "Décret n°87-751 du 10 septembre 1987 FIXANT LES CONDITIONS EXCEPTIONNELLES D'ACCES DE CERTAINS MAITRES CONTRACTUELS OU AGREES DES ETABLISSEMENTS D'ENSEIGNEMENT PRIVES SOUS CONTRAT A L'ECHELLE DE REMUNERATION DES INSTITUTEURS",
          "@c_titre_court": "Décret n°87-751 du 10 septembre 1987",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000501401"
        },
        {
          "#text": "Décret n°87-751 du 10 septembre 1987 fixant les conditions exceptionnelles d'accès de certains maîtres contractuels ou agréés des établissements d'enseignement privés sous contrat à l'échelle de rémunération des instituteurs",
          "@c_titre_court": "Décret n°87-751 du 10 septembre 1987",
          "@debut": "1987-09-13",
          "@fin": "2006-09-15",
          "@id_txt": "LEGITEXT000006066164"

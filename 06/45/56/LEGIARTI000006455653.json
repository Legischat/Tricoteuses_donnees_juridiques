        {
          "#text": "Décret n°87-823 du 8 octobre 1987 PORTANT ATTRIBUTION D'UNE INDEMNITE DE SUJETIONS SPECIALES A CERTAINS PERSONNELS EXTERIEURS A L'EDUCATION NATIONALE INTERVENANT EN QUALITE DE COLLABORATEUR BENEVOLE DU SERVICE PUBLIC",
          "@c_titre_court": "Décret n°87-823 du 8 octobre 1987",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000333175"
        },
        {
          "#text": "Décret n°87-823 du 8 octobre 1987 portant attribution d'une indemnité de sujétions spéciales à certaines personnes extérieures à l'éducation nationale intervenant en qualité de collaborateur bénévole du service public",
          "@c_titre_court": "Décret n°87-823 du 8 octobre 1987",
          "@debut": "1987-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006066204"
        }

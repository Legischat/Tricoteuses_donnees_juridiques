        {
          "#text": "Décret n°88-68 du 21 janvier 1988 PORTANT ATTRIBUTION D'UNE INDEMNITE SPECIFIQUE AUX PERSONNES INTERVENANT DANS LES ECOLES PRIMAIRES DANS LE CADRE DU PLAN POUR LA REUSSITE SCOLAIRE",
          "@c_titre_court": "Décret n°88-68 du 21 janvier 1988",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000313142"
        },
        {
          "#text": "Décret n°88-68 du 21 janvier 1988 portant attribution d'une indemnité spécifique aux personnes intervenant dans les écoles primaires dans le cadre du Plan pour la réussite scolaire",
          "@c_titre_court": "Décret n°88-68 du 21 janvier 1988",

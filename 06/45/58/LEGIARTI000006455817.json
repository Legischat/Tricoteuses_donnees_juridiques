      "TITRE_TXT": [
        {
          "#text": "Décret n°88-99 du 28 janvier 1988 PORTANT ATTRIBUTION D'UNE INDEMNITE DE SUJETIONS SPECIALES AUX CHARGES D'EDUCATION POPULAIRE ET DE JEUNESSE RELEVANT DU SECRETARIAT D'ETAT AUPRES DU PREMIER MINISTRE CHARGE DE LA JEUNESSE ET DES SPORTS",
          "@c_titre_court": "Décret n°88-99 du 28 janvier 1988",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000508949"
        },
        {
          "#text": "Décret n°88-99 du 28 janvier 1988 portant attribution d'une indemnité de sujétions spéciales aux chargés d'éducation populaire et de jeunesse relevant du secrétariat d'Etat auprès du Premier ministre, chargé de la jeunesse et des sports",
          "@c_titre_court": "Décret n°88-99 du 28 janvier 1988",
          "@debut": "1988-01-30",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006066961"
        }

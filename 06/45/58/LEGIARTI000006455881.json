      "TITRE_TXT": [
        {
          "#text": "Décret n°88-304 du 28 mars 1988 RELATIF A L'UTILISATION DES LISTES COMPLEMENTAIRES D'ADMISSION POUR LE RECRUTEMENT PAR VOIE DE CONCOURS DES PERSONNELS APPARTENANT AUX CORPS D'INGENIEURS,DE PERSONNELS TECHNIQUES ET D'ADMINISTRATION DE LA RECHERCHE DE L'INSTITUT NATIONAL DE RECHERCHE EN INFORMATIQUE ET EN AUTOMATIQUE",
          "@c_titre_court": "Décret n°88-304 du 28 mars 1988",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000509375"
        },
        {
          "#text": "Décret n°88-304 du 28 mars 1988 relatif à l'utilisation des listes complémentaires d'admission pour le recrutement par voie de concours des personnels appartenant aux corps d'ingénieurs, de personnels techniques et d'administration de la recherche de l'Institut national de recherche en informatique et en automatique",
          "@c_titre_court": "Décret n°88-304 du 28 mars 1988",
          "@debut": "1988-04-01",
          "@fin": "2005-08-25",
          "@id_txt": "LEGITEXT000006066516"
        }
      ],
      "@cid": "JORFTEXT000000509375",

        {
          "#text": "Décret n°88-342 du 11 avril 1988 FIXANT LE REGIME DE REMUNERATION APPLICABLE A CERTAINS EMPLOIS DE DIRECTION D'ETABLISSEMENTS D'ENSEIGNEMENT OU DE FORMATION RELEVANT DU MINISTRE DE L'EDUCATION NATIONALE",
          "@c_titre_court": "Décret n°88-342 du 11 avril 1988",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000315723"
        },
        {
          "#text": "Décret n°88-342 du 11 avril 1988 fixant le régime de rémunération applicable à certains emplois de direction d'établissements d'enseignement ou de formation relevant du ministre de l'éducation nationale",
          "@c_titre_court": "Décret n°88-342 du 11 avril 1988",

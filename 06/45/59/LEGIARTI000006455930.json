        {
          "#text": "Décret n°88-343 du 11 avril 1988 PORTANT STATUTS PARTICULIERS DES CORPS DE PERSONNELS DE DIRECTION D'ETABLISSEMENTS D'ENSEIGNEMENT OU DE FORMATION RELEVANT DU MINISTRE DE L'EDUCATION NATIONALE ET FIXANT LES DISPOSITIONS RELATIVES AUX EMPLOIS DE DIRECTION ET A LA NOMINATION DANS CES EMPLOIS",
          "@c_titre_court": "Décret n°88-343 du 11 avril 1988",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000315724"
        },
        {
          "#text": "Décret n°88-343 du 11 avril 1988 portant statuts particuliers des corps de personnels de direction d'établissements d'enseignement ou de formation relevant du ministre de l'éducation nationale et fixant les dispositions relatives aux emplois de direction et à la nomination dans ces emplois",
          "@c_titre_court": "Décret n°88-343 du 11 avril 1988",
          "@debut": "1988-09-01",
          "@fin": "2001-09-01",
          "@id_txt": "LEGITEXT000006066536"
        }
      ],

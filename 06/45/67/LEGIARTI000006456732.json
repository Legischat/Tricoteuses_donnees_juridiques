  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret n°88-895 du 24 août 1988 INSTITUANT UNE INDEMNITE PARTICULIERE AUX PERSONNELS A STATUT OUVRIER AFFILIES AU FONDS SPECIAL DES PENSIONS DES OUVRIERS DES ETABLISSEMENTS INDUSTRIELS DE L'ETAT ET AUX OUVRIERS AUXILIAIRES DU MINISTERE DE LA DEFENSE RECRUTES ET EMPLOYES DANS LES DEPARTEMENTS D'OUTRE-MER",
          "@c_titre_court": "Décret n°88-895 du 24 août 1988",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000512339"
        },
        {
          "#text": "Décret n°88-895 du 24 août 1988 instituant une indemnité particulière aux personnels à statut ouvrier affiliés au fonds spécial des pensions des ouvriers des établissements industriels de l'Etat et aux ouvriers auxiliaires du ministère de la défense recrutés et employés dans les départements d'outre-mer",
          "@c_titre_court": "Décret n°88-895 du 24 août 1988",
          "@debut": "1988-08-01",
          "@fin": "2016-07-01",
          "@id_txt": "LEGITEXT000006066900"
        }
      ],
      "@cid": "JORFTEXT000000512339",

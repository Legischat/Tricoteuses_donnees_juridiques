      "TITRE_TXT": [
        {
          "#text": "Décret n°88-1267 du 30 décembre 1988 PORTANT ATTRIBUTION D'UNE INDEMNITE SPECIFIQUE AUX PERSONNES INTERVENANT DANS LES ECOLES PRIMAIRES DANS LE CADRE DES ACTIONS DE SOUTIEN AUX ELEVES EN DIFFICULTE",
          "@c_titre_court": "Décret n°88-1267 du 30 décembre 1988",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000868144"
        },
        {
          "#text": "Décret n°88-1267 du 30 décembre 1988 portant attribution d'une indemnité spécifique aux personnes intervenant dans les écoles primaires dans le cadre des actions de soutien aux élèves en difficulté",
          "@c_titre_court": "Décret n°88-1267 du 30 décembre 1988",
          "@debut": "1989-09-01",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006066403"
        }
      ],
      "@cid": "JORFTEXT000000868144",
      "@date_publi": "1989-01-05",

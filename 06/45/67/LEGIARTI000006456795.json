      "TITRE_TXT": [
        {
          "#text": "Décret n°89-59 du 31 janvier 1989 FIXANT LES MODALITES D'ACCES TEMPORAIRE AU GRADE DE PREMIER SURVEILLANT DU CORPS DU PERSONNEL DE SURVEILLANCE DES SERVICES EXTERIEURS DE L'ADMINISTRATION PENITENTIAIRE",
          "@c_titre_court": "Décret n°89-59 du 31 janvier 1989",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000700020"
        },
        {
          "#text": "Décret n°89-59 du 31 janvier 1989 fixant des modalités temporaires d'accès au grade de premier surveillant du corps du personnel de surveillance des services extérieurs de l'administration pénitentiaire",
          "@c_titre_court": "Décret n°89-59 du 31 janvier 1989",

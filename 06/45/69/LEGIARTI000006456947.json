  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les titres suivants :<br/>\n<br/>    assistant ou spécialiste des hôpitaux des armées ;<br/>\n<br/>    assistant ou spécialiste de recherches ;<br/>\n<br/>    assistant ou spécialiste des techniques médico-militaires ;<br/>\n<br/>    professeur agrégé du Val de Grâce ;<br/>\n<br/>    maître de recherches,<br/>\n sont attribués, avec mention de la discipline ou de la spécialité, par décision du ministre de la défense.<br/>"
  },

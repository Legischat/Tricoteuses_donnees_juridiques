      "TITRE_TXT": [
        {
          "#text": "Décret n°89-271 du 12 avril 1989 FIXANT LES CONDITIONS ET LES MODALITES DE REGLEMENT DES FRAIS DE DEPLACEMENT DES PERSONNELS CIVILS A L'INTERIEUR DES DEPARTEMENTS D'OUTRE-MER,ENTRE LA METROPOLE DE CES DEPARTEMENTS,ET POUR SE RENDRE D'UN DEPARTEMENT D'OUTRE-MER A UN AUTRE",
          "@c_titre_court": "Décret n°89-271 du 12 avril 1989",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000885074"
        },
        {
          "#text": "Décret n°89-271 du 12 avril 1989 fixant les conditions et les modalités de règlement des frais de changements de résidence des personnels civils à l'intérieur des départements d'outre-mer, entre la métropole et ces départements, et pour se rendre d'un département d'outre-mer à un autre",
          "@c_titre_court": "Décret n°89-271 du 12 avril 1989",
          "@debut": "2006-11-01",

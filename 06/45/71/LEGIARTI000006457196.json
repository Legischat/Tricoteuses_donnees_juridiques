  "BLOC_TEXTUEL": {
    "CONTENU": "<p>Les conservateurs en chef de classe exceptionnelle, les conservateurs de 1re classe de classe exceptionnelle et les conservateurs de 1re classe de classe normale, 5e échelon, en fonctions à la date de publication du présent décret sont reclassés conformément au tableau ci-après :</p>\n<table>\n<tbody>\n<tr>\n<td rowspan=\"2\" width=\"135\">\n<p align=\"center\">SITUATION ACTUELLE</p>\n</td>\n<td colspan=\"2\" width=\"243\">\n<p align=\"center\">SITUATION NOUVELLE</p>\n</td>\n</tr>\n<tr>\n<td width=\"135\">\n<p align=\"center\">Grades et échelons</p>\n</td>\n<td width=\"107\">\n<p align=\"center\">Ancienneté dans l'échelon</p>\n</td>\n</tr>\n<tr>\n<td width=\"135\">\n<p>Conservateur en chef :</p>\n</td>\n<td width=\"135\">\n<p align=\"center\">Conservateur en chef :</p>\n</td>\n<td width=\"107\">\n<p align=\"center\"> </p>\n</td>\n</tr>\n<tr>\n<td width=\"135\">\n<p>- classe exceptionnelle, échelon unique</p>\n</td>\n<td width=\"135\">\n<p align=\"center\">5e échelon</p>\n</td>\n<td width=\"107\">\n<p align=\"center\">Ancienneté conservée</p>\n</td>\n</tr>\n<tr>\n<td width=\"135\">\n<p>Conservateur de 1re classe</p>\n</td>\n<td width=\"135\">\n<p align=\"center\">Conservateur de 1re classe :</p>\n</td>\n<td width=\"107\">\n<p align=\"center\">Ancienneté conservée</p>\n</td>\n</tr>\n<tr>\n<td width=\"135\">\n<p>- classe exceptionnelle, échelon unique</p>\n</td>\n<td width=\"135\">\n<p align=\"center\">6e échelon</p>\n</td>\n<td width=\"107\">\n<p align=\"center\"> </p>\n</td>\n</tr>\n<tr>\n<td width=\"135\">\n<p>- classe normale, 5e échelon</p>\n</td>\n<td width=\"135\">\n<p align=\"center\">5e échelon</p>\n</td>\n<td width=\"107\">\n<p align=\"center\">Ancienneté majorée d'un quart</p>\n</td>\n</tr>\n</tbody>\n</table>"
  }

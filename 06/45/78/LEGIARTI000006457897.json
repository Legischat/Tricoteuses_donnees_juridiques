  "BLOC_TEXTUEL": {
    "CONTENU": "<p>L'avancement d'échelon des conseillers principaux d'éducation de classe normale a lieu partie au grand choix, partie au choix, partie à l'ancienneté. Il a effet du jour où les intéressés remplissent les conditions fixées au tableau ci-dessous :</p>\n<table align=\"center\" border=\"1\" cellpadding=\"0\" cellspacing=\"0\" width=\"454\">\n<tbody>\n<tr>\n<td valign=\"top\" width=\"113\">\n<p align=\"center\">ECHELONS</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p align=\"center\">GRAND CHOIX</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p align=\"center\">CHOIX</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p align=\"center\">ANCIENNETE</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"113\">\n<p>Du 1er au 2e</p>\n</td>\n<td valign=\"top\" width=\"113\"/>\n<td valign=\"top\" width=\"113\"/>\n<td valign=\"top\" width=\"113\">\n<p>3 mois</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"113\">\n<p>Du 2e au 3e</p>\n</td>\n<td valign=\"top\" width=\"113\"/>\n<td valign=\"top\" width=\"113\"/>\n<td valign=\"top\" width=\"113\">\n<p>9 mois</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"113\">\n<p>Du 3e au 4e</p>\n</td>\n<td valign=\"top\" width=\"113\"/>\n<td valign=\"top\" width=\"113\"/>\n<td valign=\"top\" width=\"113\">\n<p>1 an</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"113\">\n<p>Du 4e au 5e</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p>2 ans</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p>2 ans 6 mois</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p>2 ans 6 mois</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"113\">\n<p>Du 5e au 6e</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p>2 ans 6 mois</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p>3 ans</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p>3 ans 6 mois</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"113\">\n<p>Du 6e au 7e</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p>2 ans 6 mois </p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p>3 ans</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p>3 ans 6 mois</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"113\">\n<p>Du 7e au 8e</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p>2 ans 6 mois</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p>3 ans</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p>3 ans 6 mois</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"113\">\n<p>Du 8e au 9e</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p>2 ans 6 mois</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p>4 ans </p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p>4 ans 6 mois</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"113\">\n<p>Du 9e au 10e</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p>3 ans</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p>4 ans</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p>5 ans</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"113\">\n<p>Du 10e au 11e</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p>3 ans </p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p>4 ans 6 mois</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p>5 ans 6 mois</p>\n</td>\n</tr>\n</tbody>\n</table>"
  },

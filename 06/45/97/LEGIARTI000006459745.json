  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret n°86-442 du 14 mars 1986 RELATIF A LA DESIGNATION DE MEDECINS AGREES,A L'ORGANISATION DES COMITES MEDICAUX ET DES COMMISSIONS DE REFORME,AUX CONDITIONS D'APTITUDE PHYSIQUE POUR L'ADMISSION AUX EMPLOIS PUBLICS ET AU REGIME DE CONGES DE MALADIE DES FONCTIONNAIRES",
          "@c_titre_court": "Décret n°86-442 du 14 mars 1986",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000884830"
        },
        {
          "#text": "Décret n°86-442 du 14 mars 1986 relatif à la désignation des médecins agréés, à l'organisation des conseils médicaux, aux conditions d'aptitude physique pour l'admission aux emplois publics et au régime de congés de maladie des fonctionnaires.",
          "@c_titre_court": "Décret n°86-442 du 14 mars 1986",
          "@debut": "2022-03-14",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000045350869"
        },
        {
          "#text": "Décret n°86-442 du 14 mars 1986 relatif à la désignation des médecins agréés, à l'organisation des comités médicaux et des commissions de réforme, aux conditions d'aptitude physique pour l'admission aux emplois publics et au régime de congés de maladie des fonctionnaires.",
          "@c_titre_court": "Décret n°86-442 du 14 mars 1986",
          "@debut": "1986-03-16",
          "@fin": "2022-03-14",
          "@id_txt": "LEGITEXT000006065530"
        }
      ],
      "TM": {
        "TITRE_TM": [
          {
            "#text": "Titre II : Des conditions d'aptitude physique pour l'admission aux emplois publics.",
            "@debut": "1986-03-16",
            "@fin": "2022-03-14",
            "@id": "LEGISCTA000006092241"
          },
          {
            "#text": "Titre II : Conditions de santé particulières exigées pour l'exercice de certaines fonctions",
            "@debut": "2022-03-14",
            "@fin": "2999-01-01",
            "@id": "LEGISCTA000045351034"
          }
        ]

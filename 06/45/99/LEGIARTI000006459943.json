  "BLOC_TEXTUEL": {
    "CONTENU": "<p>La durée moyenne et la durée minimale du temps passé dans chacun des échelons du corps des ingénieurs du génie sanitaire sont fixées conformément au tableau ci-après :</p>\n<br/>\n<table>\n<tbody>\n<tr>\n<td align=\"left\" colspan=\"2\" valign=\"middle\">\n<p align=\"center\">GRADES ET ÉCHELONS</p>\n</td>\n<td align=\"left\" colspan=\"4\" valign=\"middle\">\n<p align=\"center\">DURÉE</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" colspan=\"2\" valign=\"middle\">\n<pre> </pre>\n</td>\n<td align=\"left\" colspan=\"2\" valign=\"middle\">\n<p align=\"center\">Moyenne</p>\n</td>\n<td align=\"left\" colspan=\"2\" valign=\"middle\">\n<p align=\"center\">Minimale</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" colspan=\"2\" valign=\"middle\">\n<p align=\"center\">\n<i>Ingénieur général</i>\n</p>\n</td>\n<td align=\"left\" colspan=\"2\" valign=\"middle\">\n<pre> </pre>\n</td>\n<td align=\"left\" colspan=\"2\" valign=\"middle\">\n<pre> </pre>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">2e échelon</p>\n</td>\n<td align=\"left\" colspan=\"2\" valign=\"middle\">\n<p align=\"center\">3 ans</p>\n</td>\n<td align=\"left\" colspan=\"3\" valign=\"middle\">\n<p align=\"center\">2 ans 6 mois</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">1er échelon</p>\n</td>\n<td align=\"left\" colspan=\"2\" valign=\"middle\">\n<p align=\"center\">3 ans</p>\n</td>\n<td align=\"left\" colspan=\"3\" valign=\"middle\">\n<p align=\"center\">2 ans 6 mois</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">\n<i>Ingénieur en chef</i>\n</p>\n</td>\n<td align=\"left\" colspan=\"2\" valign=\"middle\">\n<pre> </pre>\n</td>\n<td align=\"left\" colspan=\"3\" valign=\"middle\">\n<pre> </pre>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">4e échelon</p>\n</td>\n<td align=\"left\" colspan=\"2\" valign=\"middle\">\n<p align=\"center\">4 ans</p>\n</td>\n<td align=\"left\" colspan=\"3\" valign=\"middle\">\n<p align=\"center\">3 ans 6 mois</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">3e échelon</p>\n</td>\n<td align=\"left\" colspan=\"2\" valign=\"middle\">\n<p align=\"center\">3 ans</p>\n</td>\n<td align=\"left\" colspan=\"3\" valign=\"middle\">\n<p align=\"center\">2 ans 6 mois</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">2e échelon</p>\n</td>\n<td align=\"left\" colspan=\"2\" valign=\"middle\">\n<p align=\"center\">2 ans</p>\n</td>\n<td align=\"left\" colspan=\"3\" valign=\"middle\">\n<p align=\"center\">1 an 6 mois</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">1er échelon</p>\n</td>\n<td align=\"left\" colspan=\"2\" valign=\"middle\">\n<p align=\"center\">2 ans</p>\n</td>\n<td align=\"left\" colspan=\"3\" valign=\"middle\">\n<p align=\"center\">1 an 6 mois</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">\n<i>Ingénieur</i>\n</p>\n</td>\n<td align=\"left\" colspan=\"2\" valign=\"middle\">\n<pre> </pre>\n</td>\n<td align=\"left\" colspan=\"3\" valign=\"middle\">\n<pre> </pre>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">9e échelon</p>\n</td>\n<td align=\"left\" colspan=\"2\" valign=\"middle\">\n<p align=\"center\">3 ans</p>\n</td>\n<td align=\"left\" colspan=\"3\" valign=\"middle\">\n<p align=\"center\">2 ans 6 mois</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">8e échelon</p>\n</td>\n<td align=\"left\" colspan=\"2\" valign=\"middle\">\n<p align=\"center\">3 ans</p>\n</td>\n<td align=\"left\" colspan=\"3\" valign=\"middle\">\n<p align=\"center\">2 ans 6 mois</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">7e échelon</p>\n</td>\n<td align=\"left\" colspan=\"2\" valign=\"middle\">\n<p align=\"center\">2 ans 6 mois</p>\n</td>\n<td align=\"left\" colspan=\"3\" valign=\"middle\">\n<p align=\"center\"
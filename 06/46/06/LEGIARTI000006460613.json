  "BLOC_TEXTUEL": {
    "CONTENU": "<p>La durée moyenne et la durée minimale du temps passé dans chacun des échelons des trois grades d'ingénieur électronicien des systèmes de la sécurité aérienne sont fixées comme suit :</p>\n<br/>\n<p>I = GRADE ET ÉCHELON : </p>\n<p>Ingénieur électronicien divisionnaire des systèmes de la sécurité aérienne</p>\n<p>II = DUREE Moyenne</p>\n<br/>\n<p>III = DUREE Minimale</p>\n<br/>\n<br/>\n<table>\n<tbody>\n<tr>\n<td>:---:-------:--------------:</td>\n</tr>\n<tr>\n<td>: I : II : III :</td>\n</tr>\n<tr>\n<td>:---:-------:--------------:</td>\n</tr>\n<tr>\n<td>:11e: : :</td>\n</tr>\n<tr>\n<td>:10e: 3 ans : 2 ans 3 mois :</td>\n</tr>\n<tr>\n<td>:9e : 3 ans : 2 ans 3 mois :</td>\n</tr>\n<tr>\n<td>:8e : 3 ans : 2 ans 3 mois :</td>\n</tr>\n<tr>\n<td>:7e : 3 ans : 2 ans 3 mois :</td>\n</tr>\n<tr>\n<td>:6e : 2 ans : 1 an 6 mois :</td>\n</tr>\n<tr>\n<td>:5e : 2 ans : 1 an 6 mois :</td>\n</tr>\n<tr>\n<td>:4e : 2 ans : 1 an 6 mois :</td>\n</tr>\n<tr>\n<td>:3e : 2 ans : 1 an 6 mois :</td>\n</tr>\n<tr>\n<td>:2e : 2 ans : 1 an 6 mois :</td>\n</tr>\n<tr>\n<td>:1e : 2 ans : 1 an 6 mois :</td>\n</tr>\n<tr>\n<td>:---:-------:--------------:</td>\n</tr>\n</tbody>\n</table>\n<p>I = GRADE ET ÉCHELON : </p>\n<p>Ingénieur électronicien principal des systèmes de la sécurité aérienne</p>\n<p>II = DUREE Moyenne</p>\n<p>III = DUREE Minimale</p>\n<br/>\n<br/>\n<table>\n<tbody>\n<tr>\n<td>:---:-------:--------------:</td>\n</tr>\n<tr>\n<td>: I : II : III :</td>\n</tr>\n<tr>\n<td>:---:-------:--------------:</td>\n</tr>\n<tr>\n<td>: 9e: : :</td>\n</tr>\n<tr>\n<td>: 8e: 4 ans : 3 ans :</td>\n</tr>\n<tr>\n<td>: 7e: 4 ans : 3 ans :</td>\n</tr>\n<tr>\n<td>: 6e: 3 ans : 2 ans 3 mois :</td>\n</tr>\n<tr>\n<td>: 5e: 3 ans : 2 ans 3 mois :</td>\n</tr>\n<tr>\n<td>: 4e: 3 ans : 2 ans 3 mois :</td>\n</tr>\n<tr>\n<td>: 3e: 2 ans : 1 an 6 mois :</td>\n</tr>\n<tr>\n<td>: 2e: 2 ans : 1 an 6 mois :</td>\n</tr>\n<tr>\n<td>: 1e: 1 an : 1 an :</td>\n</tr>\n<tr>\n<td>:---:-------:--------------:</td>\n</tr>\n<tr>\n<td/>\n</tr>\n<tr>\n<td>I = GRADE ET ÉCHELON : </td>\n</tr>\n<tr>\n<td>Ingénieur électronicien des systèmes de la sécurité aérienne de classe normale</td>\n</tr>\n<tr>\n<td>II = DUREE Moyenne</td>\n</tr>\n<tr>\n<td>III = DUREE Minimale</td>\n</tr>\n<tr>\n<td/>\n</tr>\n<tr>\n<td>:---:-------:--------------:</td>\n</tr>\n<tr>\n<td>: I : II : III :</td>\n</tr>\n<tr>\n<td>:---:-------:--------------:</td>\n</tr>\n<tr>\n<td>:10e: : :</td>\n</tr>\n<tr>\n<td>: 9e: 3 ans : 2 ans 3 mois :</td>\n</tr>\n<tr>\n<td>: 8e: 3 ans : 2 ans 3 mois :</td>\n</tr>\n<tr>\n<td>: 7e: 3 ans : 2 ans 3 mois :</td>\n</tr>\n<tr>\n<td>: 6e: 3 ans : 2 ans 3 mois :</td>\n</tr>\n<tr>\n<td>: 5e: 3 ans : 2 ans 3 mois :</td>\n</tr>\n<tr>\n<td>: 4e: 2 ans : 1 an 6 mois :</td>\n</tr>\n<tr>\n<td>: 3e: 2 ans : 1 an 6 mois :</td>\n</tr>\n<tr>\n<td>: 2e: 2 ans : 1 an 6 mois :</td>\n</tr>\n<tr>\n<td>: 1e: 1 an : 1 an :</td>\n</tr>\n<tr>\n<td>:---:-------:--------------:</td>\n</tr>\n</tbody>\n</table>\n<br/>"

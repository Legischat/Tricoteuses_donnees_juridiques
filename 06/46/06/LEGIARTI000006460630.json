  "BLOC_TEXTUEL": {
    "CONTENU": "<p align=\"center\">(Classement prenant effet du 1er janvier 1991)</p>\n<table align=\"center\" border=\"1\" cellpadding=\"0\" cellspacing=\"0\" width=\"680\">\n<tbody>\n<tr>\n<td width=\"302\">\n<p align=\"center\">GRADES OU EMPLOIS</p>\n</td>\n<td width=\"151\">\n<p align=\"center\">CLASSEMENT<br/>hiérarchique<br/>(indices bruts)</p>\n</td>\n<td width=\"227\">\n<p align=\"center\">OBSERVATIONS</p>\n</td>\n</tr>\n<tr>\n<td width=\"302\">\n<p align=\"center\">I. - Emplois communs aux deux exploitants publics<br/>La Poste et France Télécom</p>\n</td>\n<td width=\"151\">\n<p align=\"center\"> </p>\n</td>\n<td width=\"227\">\n<p align=\"center\"> </p>\n</td>\n</tr>\n<tr>\n<td width=\"302\">\n<p align=\"center\">A - Services administratifs</p>\n</td>\n<td width=\"151\">\n<p align=\"center\"> </p>\n</td>\n<td width=\"227\">\n<p align=\"center\"> </p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"302\">\n<p>Chef de service régional</p>\n</td>\n<td valign=\"top\" width=\"151\">\n<p align=\"center\">901-1015</p>\n</td>\n<td valign=\"top\" width=\"227\">\n<p>(a).</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"302\">\n<p>Directeur régional</p>\n</td>\n<td valign=\"top\" width=\"151\">\n<p align=\"center\">1015</p>\n</td>\n<td valign=\"top\" width=\"227\">\n<p>(a).</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"302\">\n<p>Chef de service départemental</p>\n</td>\n<td valign=\"top\" width=\"151\">\n<p align=\"center\">852-1015</p>\n</td>\n<td valign=\"top\" width=\"227\">\n<p>(a).</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"302\">\n<p>Directeur départemental</p>\n</td>\n<td valign=\"top\" width=\"151\">\n<p align=\"center\">852-1015</p>\n</td>\n<td valign=\"top\" width=\"227\"/>\n</tr>\n<tr>\n<td valign=\"top\" width=\"302\">\n<p>Directeur départemental adjoint</p>\n</td>\n<td valign=\"top\" width=\"151\">\n<p align=\"center\">841-901</p>\n</td>\n<td valign=\"top\" width=\"227\"/>\n</tr>\n<tr>\n<td valign=\"top\" width=\"302\">\n<p>Inspecteur
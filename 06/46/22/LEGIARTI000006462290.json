      "TITRE_TXT": [
        {
          "#text": "Arrêté du 13 décembre 1988 RELATIF AUX CONDITIONS D'APPLICATION AUX FONCTIONNAIRES CIVILS DU MINISTERE DE LA DEFENSE EN SERVICE A L'ETRANGER DU DECRET 67290 DU 28-03-1967 FIXANT LES MODALITES DE CALCUL DES EMOLUMENTS DES PERSONNELS DE L'ETAT ET DES ETABLISSEMENTS PUBLICS DE L'ETAT A CARACTERE ADMINISTRATIF EN SERVICE A L'ETRANGER",
          "@c_titre_court": "Arrêté du 13 décembre 1988",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000704623"
        },
        {
          "#text": "Arrêté du 13 décembre 1988 relatif aux conditions d'application aux fonctionnaires civils du ministère de la défense en service à l'étranger du décret n° 67-290 du 28 mars 1967 fixant les modalités de calcul des émoluments des personnels de l'Etat et des établissements publics de l'Etat à caractère administratif en service à l'étranger",

  "BLOC_TEXTUEL": {
    "CONTENU": "<p>Le coefficient prévu à l'article 2 du décret du 28 septembre 1983 susvisé est fixé ainsi qu'il suit :</p>\n<table>\n<tbody>\n<tr>\n<td>\n<p align=\"center\">DURÉE DES SERVICES MILITAIRES</p>\n</td>\n<td>\n<p align=\"center\">COEFFICIENT </p>\n<p align=\"center\"> </p>\n<p align=\"center\">retenu </p>\n<p align=\"center\"> </p>\n<p align=\"center\">pour le calcul </p>\n<p align=\"center\"> </p>\n<p align=\"center\">du pécule</p>\n</td>\n</tr>\n<tr>\n<td>\n<p>Moins de 20 mois de service</p>\n</td>\n<td>\n<p align=\"center\">1,6</p>\n</td>\n</tr>\n<tr>\n<td rowspan=\"2\">\n<p>A partir de 20 mois de service</p>\n</td>\n<td rowspan=\"2\">\n<p align=\"center\">2,8</p>\n</td>\n</tr>\n</tbody>\n</table>"
  },

      "TITRE_TXT": [
        {
          "#text": "Arrêté du 31 août 1987 PORTANT APPLICATION DE L'ART. 21 (3EMEMENT) DU DECRET 85384 DU 29-03-1985 PORTANT STATUT DES PRATICIENS EXERCANT LEUR ACTIVITE A TEMPS PARTIEL DANS LES ETABLISSEMENTS D'HOSPITALISATION PUBLICS",
          "@c_titre_court": "Arrêté du 31 août 1987",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000842101"
        },
        {
          "#text": "Arrêté du 31 août 1987 portant application de l'article 21 (3°) du décret n° 85-384 du 29 mars 1985 portant statut des praticiens exerçant leur activité à temps partiel dans les établissements d'hospitalisation publics.",
          "@c_titre_court": "Arrêté du 31 août 1987",
          "@debut": "1987-09-16",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006057723"
        }

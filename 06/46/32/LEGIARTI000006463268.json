  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Arrêté du 22 septembre 1987 FIXANT LES REGLES D'EQUIVALENCE DES FONCTIONS PREVUES PAR LES ART. 26 ET 48 DU DECRET 831260 DU 30-12-1983 FIXANT LES DISPOSITIONS STATUTAIRES COMMUNES AUX CORPS DE FONCTIONNAIRES DES ETABLISSEMENTS PUBLICS SCIENTIFIQUES ET TECHNOLOGIQUES AVEC CELLES DES DIRECTEURS ET CHARGES DE RECHERCHE DE L'INSTITUT NATIONAL DE LA RECHERCHE EN INFORMATIQUE ET EN AUTOMATIQUE (INRIA)",
          "@c_titre_court": "Arrêté du 22 septembre 1987",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000870590"
        },
        {
          "#text": "Arrêté du 22 septembre 1987 fixant les règles d'équivalence des fonctions prévues par les articles 26 et 48 du décret n° 83-1260 du 30 décembre 1983 fixant les dispositions statutaires communes aux corps de fonctionnaires des établissements publics scientifiques et technologiques avec celles des directeurs et chargés de recherche de l'Institut national de la recherche en informatique et en automatique",
          "@c_titre_court": "Arrêté du 22 septembre 1987",
          "@debut": "1987-10-03",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006057762"
        }
      ],
      "@cid": "JORFTEXT000000870590",
      "@date_publi": "1987-10-03",
      "@date_signature": "1987-09-22",
      "@nature": "ARRETE",
      "@nor": "RESY8700622A"
    }
  },
  "VERSIONS": {
    "VERSION": [
      {
        "LIEN_ART": {
          "@debut": "1987-10-03",

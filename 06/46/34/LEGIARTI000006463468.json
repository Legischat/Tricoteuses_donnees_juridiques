  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Services de la grande chancellerie de la Légion d'honneur.<br/>\n<br/>   Services de l'administration centrale du ministère de la justice.<br/>\n<br/>   Services déconcentrés de la protection judiciaire de la jeunesse.<br/>\n<br/>   Services déconcentrés des services judiciaires :<br/>\n<br/>   - fonctionnaires du ressort de la cour d'appel d'Amiens.<br/>\n<br/>   Services déconcentrés de l'administration pénitentiaire :<br/>\n<br/>   - siège de la direction régionale de Lille ;<br/>\n<br/>   - comité de probation et d'aide aux libérés (C.P.A.L.) de Lyon.<br/>"
  },

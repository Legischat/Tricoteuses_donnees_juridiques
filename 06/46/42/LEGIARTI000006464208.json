  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Sont considérés comme télégrammes spéciaux :<br/>\n<br/>   -les télégrammes relatifs à la sécurité de la vie humaine ;<br/>\n<br/>   -les télégrammes de presse ;<br/>\n<br/>   -les phototélégrammmes ;<br/>\n<br/>   -les télégrammes urgents du régime international ;<br/>\n<br/>   -les télégrammes illustrés ;<br/>\n<br/>   -les télégrammes à dépôt anticipé ;<br/>\n<br/>   -les télégrammes avec accusé de réception ;<br/>\n<br/>   -les télégrammes R.C.T. du régime international ;<br/>\n<br/>   -les radiotélégrammes.<br/>"
  },

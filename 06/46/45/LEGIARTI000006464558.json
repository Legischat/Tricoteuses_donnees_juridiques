        {
          "#text": "Loi n°54-781 du 2 août 1954 POSSIBILITE DE RENDRE A L'HABITATION LES PIECES ISOLEES LOUEES ACCESSOIREMENT A UN APPARTEMENT ET NON HABITEES",
          "@c_titre_court": "Loi n°54-781 du 2 août 1954",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000876732"
        },
        {
          "#text": "Loi n° 54-781 du 2 août 1954 tendant à rendre à l'habitation les pièces isolées louées accessoirement à un appartement et non habitées",
          "@c_titre_court": "Loi n° 54-781 du 2 août 1954",
          "@debut": "1954-08-05",

  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Toute personne qui, sans l'autorisation de l'expéditeur ou du destinataire, divulgue, publie ou utilise le contenu des correspondances transmises par la voie radioélectrique ou révèle leur existence est punie des peines portées à l'article 378 du code pénal.<br/>\n<br/>"
  },

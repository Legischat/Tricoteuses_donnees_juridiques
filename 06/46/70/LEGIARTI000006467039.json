  "NOTA": {
    "CONTENU": "<br/>   [*Dispositions prises par décret en Conseil d'Etat en application de l'article R.25 du code pénal.*]<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les dispositions des articles R. 45 à R. 49 sont observées dans le cas où l'infraction aurait été commise dans les eaux territoriales par tout individu faisant partie de l'équipage d'un navire quelconque, français ou étranger, sans préjudice des dispositions de l'article L. 67.<br/>\n<br/>"
  },

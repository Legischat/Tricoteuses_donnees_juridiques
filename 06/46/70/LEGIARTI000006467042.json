  "NOTA": {
    "CONTENU": "<br/>   [*Dispositions prises par décret en Conseil d'Etat en application de l'article R.25 du code pénal.*]<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Dans le cas prévu au troisième alinéa de l'article L. 81, l'auteur de la rupture ou de la détérioration est tenu, sous peine d'une amende de 1 300 à 3 000 F [*taux résultant du décret 89-989 du 29 décembre 1989*], de faire la déclaration prévue à l'article L. 72.<br/>\n<br/>"
  },

  "NOTA": {
    "CONTENU": "<br/>   [*Dispositions prises en Conseil d'Etat en exécution de l'article 45 de l'ordonnance n° 59-2 du 2 janvier 1959.*]<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Sont annexés au compte définitif de chaque exercice :<br/>\n<br/>   1° Un compte général d'exploitation appuyé de statistiques établies de manière à faire ressortir séparément les résultats pour chacune des trois branches de l'exploitation : postes, télégraphes et téléphones ;<br/>\n<br/>   2° Un compte de dépenses d'équipement imputées sur la deuxième section du budget annexe ;<br/>\n<br/>   3° Un bilan du service des postes et télécommunications ;<br/>\n<br/>   4° Un résumé du relevé établi en exécution de l'article 77 de la loi du 26 janvier 1892 et faisant connaître la situation des engagements contractés par divers à titre de fonds de concours.<br/>"
  },

      "TITRE_TXT": [
        {
          "#text": "Loi n°53-1346 du 31 décembre 1953 MODIFIE CERTAINES DISPOSITIONS DU DECRET 53960 DU 30-09-1953 REGLANT LES RAPPORTS ENTRE BAILLEURS ET LOCATAIRES",
          "@c_titre_court": "Loi n°53-1346 du 31 décembre 1953",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000874894"
        },
        {
          "#text": "Loi n° 53-1346 du 31 décembre 1953 modifiant certaines dispositions du décret n° 53-960 du 30 septembre 1953 réglant les rapports entre bailleurs et locataires, en ce qui concerne le renouvellement des baux à loyer d'immeubles ou de locaux à usage commercial, industriel ou artisanal",
          "@c_titre_court": "Loi n° 53-1346 du 31 décembre 1953",
          "@debut": "1954-01-06",
          "@fin": "2022-02-16",
          "@id_txt": "LEGITEXT000006068118"
        }
      ],
      "@cid": "JORFTEXT000000874894",
      "@date_publi": "1954-01-06",
      "@date_signature": "1953-12-31",
      "@nature": "LOI",
      "@num": "53-1346"
    }
  },

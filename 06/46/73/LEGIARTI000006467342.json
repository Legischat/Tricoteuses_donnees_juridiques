  "BLOC_TEXTUEL": {
    "CONTENU": "<p>Les durées moyenne et minimale du temps passé dans chaque échelon des différents grades sont fixées ainsi qu'il suit :</p>\n<br/>\n<table align=\"center\" border=\"1\" width=\"720\">\n<tbody>\n<tr>\n<td align=\"left\" rowspan=\"2\" valign=\"top\">\n<p align=\"center\">GRADE ET ÉCHELONS</p>\n</td>\n<td align=\"left\" colspan=\"2\" valign=\"top\">\n<p align=\"center\">DURÉE</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">Moyenne</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">Minimale</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">Médecin de l'éducation nationale<br/>de 1re classe</p>\n</td>\n<td align=\"left\" valign=\"top\"/>\n<td align=\"left\" valign=\"top\"/>\n</tr>\n<tr>\n<td align=\"left\" valign=\"top\">\n<p align=\"left\">4e échelon</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">2 ans</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">1 an 6 mois</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"top\">\n<p align=\"left\">3e échelon</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">2 ans </p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">1 an 6 mois </p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"top\">\n<p align=\"left\">2e échelon</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">2 ans</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">1 an 6 mois</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"top\">\n<p align=\"left\">1er échelon</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">2 ans </p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">1 an 6 mois </p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">Médecin de l'éducation nationale<br/>de 2e classe </p>\n</td>\n<td align=\"left\" valign=\"top\">\n<br/>\n<br/>\n</td>\n<td align=\"left\" valign=\"top\">\n<br/>\n<br/>\n</td>\n</tr>\n<tr>\n<td>10e échelon</td>\n<td>\n<p align=\"center\">2 ans</p>\n</td>\n<td>\n<p align=\"center\">1 an 6 mois </p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"top\">\n<p align=\"left\">9e échelon</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">2 ans</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">1 an 6 mois</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"top\">\n<p align=\"left\">8e échelon</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">2 ans</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">1 an 6 mois</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"top\">\n<p align=\"left\">7e échelon</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">2 ans</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">1 an 6 mois</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"top\">\n<p align=\"left\">6e échelon</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">2 ans</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">1 an 6 mois</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"top\">\n<p align=\"left\">5e échelon</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">1 an 6 mois</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\"> </p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"top\">\n<p align=\"left\">4e échelon</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">1 an 6 mois</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\"> </p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"top\">\n<p align=\"left\">3e échelon</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">1 an 6 mois</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\"> </p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"top\">\n<p align=\"left\">2e échelon</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">1 an</p>\n</td>\n<td align=\"left\" valign=\"top\"/>\n</tr>\n<tr>\n<td align=\"left\" valign=\"top\">\n<p align=\"left\">1er échelon</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">1 an</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\"> </p>\n</td>\n</tr>\n</tbody>\n</table>\n<p align=\"left\"> </p>\n<p align=\"left\"> </p>"

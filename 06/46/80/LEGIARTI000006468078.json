  "BLOC_TEXTUEL": {
    "CONTENU": "<p>La durée du temps passé dans chacun des échelons des grades mentionnés à l'article 1er est fixée comme suit :</p>\n<br/>\n<div>\n<table align=\"center\" border=\"1\">\n<tbody>\n<tr>\n<th>\n<br/>GRADES ET ÉCHELONS <br/>\n</th>\n<th>\n<br/>DURÉE <br/>\n</th>\n</tr>\n<tr>\n<td align=\"center\" colspan=\"2\">\n<br/>Educateur de 2e classe <br/>\n</td>\n</tr>\n<tr>\n<td>\n<br/>13e échelon <br/>\n</td>\n<td align=\"left\"/>\n</tr>\n<tr>\n<td>\n<br/>12e échelon <br/>\n</td>\n<td>\n<br/>4 ans <br/>\n</td>\n</tr>\n<tr>\n<td>\n<br/>11e échelon <br/>\n</td>\n<td>\n<br/>3 ans <br/>\n</td>\n</tr>\n<tr>\n<td>\n<br/>10e échelon <br/>\n</td>\n<td>\n<br/>3 ans <br/>\n</td>\n</tr>\n<tr>\n<td>\n<br/>9e échelon <br/>\n</td>\n<td>\n<br/>3 ans <br/>\n</td>\n</tr>\n<tr>\n<td>\n<br/>8e échelon <br/>\n</td>\n<td>\n<br/>2 ans <br/>\n</td>\n</tr>\n<tr>\n<td>\n<br/>7e échelon <br/>\n</td>\n<td>\n<br/>2 ans <br/>\n</td>\n</tr>\n<tr>\n<td>\n<br/>6e échelon <br/>\n</td>\n<td>\n<br/>2 ans <br/>\n</td>\n</tr>\n<tr>\n<td>\n<br/>5e échelon <br/>\n</td>\n<td>\n<br/>2 ans <br/>\n</td>\n</tr>\n<tr>\n<td>\n<br/>4e échelon <br/>\n</td>\n<td>\n<br/>2 ans <br/>\n</td>\n</tr>\n<tr>\n<td>\n<br/>3e échelon <br/>\n</td>\n<td>\n<br/>2 ans <br/>\n</td>\n</tr>\n<tr>\n<td>\n<br/>2e échelon <br/>\n</td>\n<td>\n<br/>2 ans <br/>\n</td>\n</tr>\n<tr>\n<td>\n<br/>1er échelon <br/>\n</td>\n<td>\n<br/>1 an <br/>\n</td>\n</tr>\n<tr>\n<td align=\"center\" colspan=\"2\">\n<br/>Educateur de 1re classe <br/>\n</td>\n</tr>\n<tr>\n<td>\n<br/>11e échelon <br/>\n</td>\n<td align=\"left\"/>\n</tr>\n<tr>\n<td>\n<br/>10e échelon <br/>\n</td>\n<td>\n<br/>3 ans <br/>\n</td>\n</tr>\n<tr>\n<td>\n<br/>9e échelon <br/>\n</td>\n<td>\n<br/>2 ans et 6 mois <br/>\n</td>\n</tr>\n<tr>\n<td>\n<br/>8e échelon <br/>\n</td>\n<td>\n<br/>2 ans et 6 mois <br/>\n</td>\n</tr>\n<tr>\n<td>\n<br/>7e échelon <br/>\n</td>\n<td>\n<br/>2 ans <br/>\n</td>\n</tr>\n<tr>\n<td>\n<br/>6e échelon <br/>\n</td>\n<td>\n<br/>2 ans <br/>\n</td>\n</tr>\n<tr>\n<td>\n<br/>5e échelon <br/>\n</td>\n<td>\n<br/>2 ans <br/>\n</td>\n</tr>\n<tr>\n<td>\n<br/>4e échelon <br/>\n</td>\n<td>\n<br/>2 ans <br/>\n</td>\n</tr>\n<tr>\n<td>\n<br/>3e échelon <br/>\n</td>\n<td>\n<br/>2 ans <br/>\n</td>\n</tr>\n<tr>\n<td>\n<br/>2e échelon <br/>\n</td>\n<td>\n<br/>2 ans <br/>\n</td>\n</tr>\n<tr>\n<td>\n<br/>1er échelon <br/>\n</td>\n<td>\n<br/>2 ans </td>\n</tr>\n</tbody>\n</table>\n</div>\n<p align=\"left\"> </p>"

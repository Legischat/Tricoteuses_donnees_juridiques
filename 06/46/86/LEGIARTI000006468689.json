  "BLOC_TEXTUEL": {
    "CONTENU": "<p>Les chefs de secteur des lignes de France Télécom régis par les décrets du 2 septembre 1954 et du 31 décembre 1990 susvisés sont reclassés dans le corps et le grade de chef de secteur des lignes, conformément au tableau de correspondance ci-après :</p>\n<br/>\n<table>\n<tbody>\n<tr>\n<td align=\"left\" colspan=\"2\" valign=\"middle\">\n<p align=\"center\">ANCIENNE SITUATION</p>\n</td>\n<td align=\"left\" colspan=\"2\" valign=\"middle\">\n<p align=\"center\">NOUVELLE SITUATION</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">Echelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">Ancienneté d'échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">Echelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">Ancienneté d'échelon</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<pre> </pre>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">\n<i>Chef de secteur de classe exceptionnelle</i>\n</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">\n<i/>\n</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">\n<i>Chef de secteur</i>\n</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">2e</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">Ancienneté égale à A</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">9e</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">Sans ancienneté.</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">1er</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">Ancienneté égale à A</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">8e</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">Ancienneté égale à 3A/2 + 1 an.</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<pre> </pre>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">\n<i>Chef de secteur de classe normale</i>\n</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">\n<i/>\n</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">\n<i>Chef de secteur</i>\n</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">8e</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">Ancienneté A :</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<pre> </pre>\n</td>\n<td align=\"left\" valign=\"middle\">\n<pre> </pre>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<pre> </pre>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">- égale ou supérieure à 1 an</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">8e</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">Ancienneté égale à A - 1 an.</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<pre> </pre>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">- inférieure à 1 an</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">7e</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">Ancienneté égale à A + 1 an.</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">7e</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">Ancienneté A :</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<pre> </pre>\n</td>\n<td align=\"left\" valign=\"middle\">\n<pre> </pre>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<pre> </pre>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">- égale ou supérieure à 2 ans</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">7e</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">Ancienneté égale à A - 2 ans.</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<pre> </pre>\n</td>\n<td align=\"left\" valign
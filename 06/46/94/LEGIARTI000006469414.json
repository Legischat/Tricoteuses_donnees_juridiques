  "BLOC_TEXTUEL": {
    "CONTENU": "<p>Le grade de contremaître principal comporte six échelons.</p>\n<p>La durée moyenne et la durée minimale du temps passé dans chaque échelon sont fixées ainsi qu'il suit :<br/>\n<br/>\n<br/>\n<br/>\n</p>\n<br/>\n<table>\n<tbody>\n<tr>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">\n<strong>ECHELONS</strong>\n</p>\n</td>\n<td align=\"left\" colspan=\"2\" valign=\"top\">\n<p align=\"center\">\n<strong>DUREE</strong>\n</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"top\">\n<pre> </pre>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">Maximale</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">Minimale</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"top\">\n<p align=\"justify\">5<sup>e</sup> échelon</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">4 ans</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">3 ans</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"top\">\n<p align=\"justify\">4<sup>e</sup> échelon</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">3 ans 6 mois</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">2 ans 9 mois</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"top\">\n<p align=\"justify\">3<sup>e</sup> échelon</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">3 ans 6 mois</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">2 ans 9 mois</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"top\">\n<p align=\"justify\">2<sup>e</sup> échelon</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">2 ans 6 mois</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">2 ans</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"top\">\n<p align=\"justify\">1<sup>er</sup> échelon</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">2 ans 6 mois</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">2 ans</p>\n</td>\n</tr>\n</tbody>\n</table>\n<br/>\n<br/>\n<br/>\n<br/>\n<br/>\n<br/>"
  }

        {
          "#text": "Décret n°89-528 du 28 juillet 1989 INSTITUANT UNE AIDE AUX QUOTIDIENS REGIONAUX,DEPARTEMENTAUX ET LOCAUX D'INFORMATION POLITIQUE ET GENERALE A FAIBLES RESSOURCES DE PETITES ANNONCES",
          "@c_titre_court": "Décret n°89-528 du 28 juillet 1989",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000332530"
        },
        {
          "#text": "Décret n°89-528 du 28 juillet 1989 instituant une aide aux quotidiens régionaux, départementaux et locaux d'information politique et générale à faibles ressources de petites annonces",
          "@c_titre_court": "Décret n°89-528 du 28 juillet 1989",
          "@debut": "1989-08-01",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006067188"
        }

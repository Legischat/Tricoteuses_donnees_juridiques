  "BLOC_TEXTUEL": {
    "CONTENU": "<p>Les inspecteurs divisionnaires en fonctions à la date d'application du présent décret sont reclassés conformément au tableau ci-après :</p>\n<table>\n<tbody>\n<tr>\n<td width=\"189\">\n<p align=\"center\">\n<strong>SITUATION ANCIENNE<br/>\n</strong>\n</p>\n</td>\n<td colspan=\"2\" width=\"189\">\n<p align=\"center\">\n<strong>SITUATION NOUVELLE</strong>\n<br/>\n</p>\n</td>\n</tr>\n<tr>\n<td width=\"189\">\n<p align=\"center\">Inspecteur divisionnaire<br/>bénéficiant de la bonification<br/>indiciaire</p>\n</td>\n<td width=\"189\">\n<p align=\"center\">Inspecteur divisionnaire</p>\n</td>\n<td>\n<p align=\"center\">Ancienneté dans l'échelon </p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"189\">\n<p>3e échelon</p>\n</td>\n<td valign=\"top\" width=\"189\">\n<p>4e échelon</p>\n</td>\n<td>Ancienneté maintenue dans la limite de deux ans </td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"189\">\n<p>2e échelon</p>\n</td>\n<td valign=\"top\" width=\"189\">\n<p>3e échelon</p>\n</td>\n<td>Ancienneté maintenue </td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"189\">\n<p>1er échelon</p>\n</td>\n<td valign=\"top\" width=\"189\">\n<p>2e échelon</p>\n</td>\n<td>Ancienneté maintenue.</td>\n</tr>\n</tbody>\n</table>"
  }

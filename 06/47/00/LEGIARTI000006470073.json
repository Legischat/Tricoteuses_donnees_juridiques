  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Le corps des adjoints sanitaires comporte les grades d'adjoint sanitaire, d'adjoint sanitaire principal et d'adjoint sanitaire qualifié.<br/>\n<br/>   Le nombre des emplois d'adjoint sanitaire principal ne peut excéder 30 % de l'effectif total du corps.<br/>\n<br/>   Le nombre des emplois d'adjoint sanitaire qualifié ne peut excéder 15 % de l'effectif total du corps.<br/>"
  },

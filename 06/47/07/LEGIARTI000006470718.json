  "BLOC_TEXTUEL": {
    "CONTENU": "<p>L'avancement d'échelon des professeurs d'enseignement général de l'Institut national des jeunes aveugles de la hors-classe est prononcé par décision du ministre chargé des affaires sociales et prend effet du jour où les intéressés remplissent les conditions fixées par le tableau ci-après :<br/>\n<br/>\n<br/>\n<br/>\n<br/>\n</p>\n<table>\n<tbody>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">\n<strong>ECHELONS</strong>\n</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">\n<strong>DUREE D'ECHELON</strong>\n</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">Du 1<sup>er</sup> au 2<sup>e</sup>\n</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">2 ans 6 mois</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">Du 2<sup>e</sup> au 3<sup>e</sup>\n</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">2 ans 6 mois</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">Du 3<sup>e</sup> au 4<sup>e</sup>\n</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">2 ans 6 mois</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">Du 4<sup>e</sup> au 5<sup>e</sup>\n</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">2 ans 6 mois</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">Du 5<sup>e</sup> au 6<sup>e</sup>\n</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">3 ans</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">Du 6<sup>e</sup> au 7<sup>e</sup>\n</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">3 ans</p>\n</td>\n</tr>\n</tbody>\n</table>"
  },

        {
          "#text": "Loi n°85-660 du 3 juillet 1985 RELATIVE AUX DROITS D'AUTEUR ET AUX DROITS DES ARTISTES-INTERPRETES,DES PRODUCTEURS DE PHONOGRAMMES ET DE VIDEOGRAMMES ET DES ENTREPRISES DE COMMUNICATION AUDIOVISUELLE",
          "@c_titre_court": "Loi n°85-660 du 3 juillet 1985",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000693451"
        },
        {
          "#text": "Loi n° 85-660 du 3 juillet 1985 relative aux droits d'auteur et aux droits des artistes-interprètes, des producteurs de phonogrammes et de vidéogrammes et des entreprises de communication audiovisuelle",
          "@c_titre_court": "Loi n° 85-660 du 3 juillet 1985",

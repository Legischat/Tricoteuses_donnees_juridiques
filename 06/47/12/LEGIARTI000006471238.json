  "BLOC_TEXTUEL": {
    "CONTENU": "<p>Les professeurs techniques de l'enseignement maritime de la hors-classe en fonction au 1er septembre 1996 sont reclassés, à cette même date, conformément au tableau de correspondance ci-après :</p>\n<br/>\n<br/>\n<br/>\n<table>\n<tbody>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">\n<strong>ANCIENNE SITUATION</strong>\n</p>\n</td>\n<td align=\"left\" colspan=\"2\" valign=\"middle\">\n<p align=\"center\">\n<strong>NOUVELLE SITUATION</strong>\n</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">Echelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">Echelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">ANCIENNETE CONSERVEE</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">6<sup>e</sup>\n</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">6<sup>e</sup>\n</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">Ancienneté conservée dans la limite de 3 ans</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">5<sup>e</sup> à partir de 3 ans:</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">6<sup>e</sup>\n</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">Sans ancienneté</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">5<sup>e</sup> avant 3 ans</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">5<sup>e</sup>\n</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">Ancienneté acquise</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">4<sup>e</sup>\n</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">4<sup>e</sup>\n</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">Ancienneté acquise</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">3<sup>e</sup>\n</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">3<sup>e</sup>\n</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">Ancienneté acquise</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">2<sup>e</sup>\n</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">2<sup>e</sup>\n</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">Ancienneté acquise</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">1<sup>er</sup>\n</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">1<sup>er</sup>\n</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">Ancienneté acquise</p>\n</td>\n</tr>\n</tbody>\n</table>"
  },

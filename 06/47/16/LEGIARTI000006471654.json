  "BLOC_TEXTUEL": {
    "CONTENU": "<p>La durée moyenne et la durée minimale du temps passé dans chacun des échelons du grade de chef des services d'insertion et de probation sont fixées comme suit :</p>\n<table>\n<tbody>\n<tr>\n<td rowspan=\"2\" width=\"124\">\n<p align=\"center\">ÉCHELONS</p>\n</td>\n<td colspan=\"2\" width=\"254\">\n<p align=\"center\">DURÉE</p>\n</td>\n</tr>\n<tr>\n<td width=\"127\">\n<p align=\"center\">Moyenne</p>\n</td>\n<td width=\"127\">\n<p align=\"center\">Minimale</p>\n</td>\n</tr>\n<tr>\n<td width=\"124\">\n<p>9e échelon</p>\n</td>\n<td width=\"127\">\n<p align=\"center\">-</p>\n</td>\n<td width=\"127\">\n<p align=\"center\">-</p>\n</td>\n</tr>\n<tr>\n<td width=\"124\">\n<p>8e échelon</p>\n</td>\n<td width=\"127\">\n<p align=\"center\">3 ans</p>\n</td>\n<td width=\"127\">\n<p align=\"center\">2 ans 3 mois</p>\n</td>\n</tr>\n<tr>\n<td width=\"124\">\n<p>7e échelon</p>\n</td>\n<td width=\"127\">\n<p align=\"center\">3 ans</p>\n</td>\n<td width=\"127\">\n<p align=\"center\">2 ans 3 mois</p>\n</td>\n</tr>\n<tr>\n<td width=\"124\">\n<p>6e échelon</p>\n</td>\n<td width=\"127\">\n<p align=\"center\">2 ans</p>\n</td>\n<td width=\"127\">\n<p align=\"center\">1 an 6 mois</p>\n</td>\n</tr>\n<tr>\n<td width=\"124\">\n<p>5e échelon</p>\n</td>\n<td width=\"127\">\n<p align=\"center\">2 ans</p>\n</td>\n<td width=\"127\">\n<p align=\"center\">1 an 6 mois</p>\n</td>\n</tr>\n<tr>\n<td width=\"124\">\n<p>4e échelon</p>\n</td>\n<td width=\"127\">\n<p align=\"center\">2 ans</p>\n</td>\n<td width=\"127\">\n<p align=\"center\">1 an 6 mois</p>\n</td>\n</tr>\n<tr>\n<td width=\"124\">\n<p>3e échelon</p>\n</td>\n<td width=\"127\">\n<p align=\"center\">2 ans</p>\n</td>\n<td width=\"127\">\n<p align=\"center\">1 an 6 mois</p>\n</td>\n</tr>\n<tr>\n<td width=\"124\">\n<p>2e échelon</p>\n</td>\n<td width=\"127\">\n<p align=\"center\">2 ans</p>\n</td>\n<td width=\"127\">\n<p align=\"center\">1 an 6 mois</p>\n</td>\n</tr>\n<tr>\n<td width=\"124\">\n<p>1er échelon</p>\n</td>\n<td width=\"127\">\n<p align=\"center\">2 ans</p>\n</td>\n<td width=\"127\">\n<p align=\"center\">1 an 6 mois</p>\n</td>\n</tr>\n</tbody>\n</table>"
  },

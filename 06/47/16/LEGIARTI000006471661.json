  "BLOC_TEXTUEL": {
    "CONTENU": "<p>Les chefs des services d'insertion et de production sont, à la date d'effet du présent décret, reclassés dans les conditions suivantes :</p>\n<table>\n<tbody>\n<tr>\n<td width=\"123\">\n<p align=\"center\">SITUATION<br/>actuelle</p>\n</td>\n<td width=\"123\">\n<p align=\"center\">SITUATION<br/>nouvelle</p>\n</td>\n<td rowspan=\"2\" width=\"131\">\n<p align=\"center\">ANCIENNETE<br/>conservée dans la limite de la durée de l'échelon</p>\n</td>\n</tr>\n<tr>\n<td width=\"123\">\n<p align=\"center\">Echelons</p>\n</td>\n<td width=\"123\">\n<p align=\"center\">Echelons</p>\n</td>\n</tr>\n<tr>\n<td width=\"123\">\n<p align=\"center\">Chefs des services d'insertion et de probation</p>\n</td>\n<td width=\"123\">\n<p align=\"center\">Chefs des services d'insertion et de probation</p>\n</td>\n<td width=\"131\">\n<p align=\"center\"> </p>\n</td>\n</tr>\n<tr>\n<td width=\"123\">\n<p>8e échelon</p>\n</td>\n<td width=\"123\">\n<p align=\"center\">8e échelon</p>\n</td>\n<td width=\"131\">\n<p align=\"center\">Ancienneté acquise dans la limite de 2 ans et 6 mois</p>\n</td>\n</tr>\n<tr>\n<td width=\"123\">\n<p>7e échelon</p>\n</td>\n<td width=\"123\">\n<p align=\"center\">7e échelon</p>\n</td>\n<td width=\"131\">\n<p align=\"center\">3/4 de l'ancienneté acquise</p>\n</td>\n</tr>\n<tr>\n<td width=\"123\">\n<p>6e échelon</p>\n</td>\n<td width=\"123\">\n<p align=\"center\">6e échelon</p>\n</td>\n<td width=\"131\">\n<p align=\"center\">1/2 de l'ancienneté acquise</p>\n</td>\n</tr>\n<tr>\n<td width=\"123\">\n<p>5e échelon</p>\n</td>\n<td width=\"123\">\n<p align=\"center\">5e échelon</p>\n</td>\n<td width=\"131\">\n<p align=\"center\">Ancienneté acquise</p>\n</td>\n</tr>\n<tr>\n<td width=\"123\">\n<p>4e échelon</p>\n</td>\n<td width=\"123\">\n<p align=\"center\">4e échelon</p>\n</td>\n<td width=\"131\">\n<p align=\"center\">Ancienneté acquise</p>\n</td>\n</tr>\n<tr>\n<td width=\"123\">\n<p>3e échelon</p>\n</td>\n<td width=\"123\">\n<p align=\"center\">3e échelon</p>\n</td>\n<td width=\"131\">\n<p align=\"center\">Ancienneté acquise</p>\n</td>\n</tr>\n<tr>\n<td width=\"123\">\n<p>2e échelon</p>\n</td>\n<td width=\"123\">\n<p align=\"center\">2e échelon</p>\n</td>\n<td width=\"131\">\n<p align=\"center\">Ancienneté acquise</p>\n</td>\n</tr>\n<tr>\n<td width=\"123\">\n<p>1er échelon</p>\n</td>\n<td width=\"123\">\n<p align=\"center\">1er échelon</p>\n</td>\n<td width=\"131\">\n<p align=\"center\">Ancienneté acquise</p>\n</td>\n</tr>\n</tbody>\n</table>"
  },

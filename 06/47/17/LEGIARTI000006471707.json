      "TITRE_TXT": [
        {
          "#text": "Décret n°93-1159 du 7 octobre 1993 FIXANT LES CONDITIONS DE L'INTEGRATION EXCEPTIONNELLE DES AGENTS NON TITULAIRES DE LA DIRECTION GENERALE DE LA POLICE NATIONALE DU MINISTERE DE L'INTERIEUR ET DE L'AMENAGEMENT DU TERRITOIRE DANS LE CORPS DES SECRETAIRES ADMINISTRATIFS DE POLICE",
          "@c_titre_court": "Décret n°93-1159 du 7 octobre 1993",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000882829"
        },
        {
          "#text": "Décret n°93-1159 du 7 octobre 1993 fixant les conditions de l'intégration exceptionnelle des agents non titulaires de la direction générale de la police nationale du ministère de l'intérieur et de l'aménagement du territoire dans le corps des secrétaires administratifs de police",
          "@c_titre_court": "Décret n°93-1159 du 7 octobre 1993",
          "@debut": "1993-10-14",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006067801"
        }
      ],
      "@cid": "JORFTEXT000000882829",

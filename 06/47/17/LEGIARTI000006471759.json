      "TITRE_TXT": [
        {
          "#text": "Décret n°93-1220 du 5 novembre 1993 RELATIF A L'UTILISATION DES LISTES COMPLEMENTAIRES D'ADMISSION POUR LE RECRUTEMENT PAR VOIE DE CONCOURS DES PERSONNELS APPARTENANT AUX CORPS D'INGENIEURS,DE PERSONNELS TECHNIQUES ET D'ADMINISTRATION DE LA RECHERCHE DU CENTRE NATIONAL DU MACHINISME AGRICOLE,DU GENIE RURAL,DES EAUX ET DES FORETS",
          "@c_titre_court": "Décret n°93-1220 du 5 novembre 1993",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000336426"
        },
        {
          "#text": "Décret n°93-1220 du 5 novembre 1993 relatif à l'utilisation des listes complémentaires d'admission pour le recrutement par voie de concours des personnels appartenant aux corps d'ingénieurs, de personnels techniques et d'administration de la recherche du Centre national du machinisme agricole, du génie rural, des eaux et des forêts",
          "@c_titre_court": "Décret n°93-1220 du 5 novembre 1993",
          "@debut": "1993-11-07",
          "@fin": "2005-08-25",
          "@id_txt": "LEGITEXT000006067854"
        }
      ],
      "@cid": "JORFTEXT000000336426",

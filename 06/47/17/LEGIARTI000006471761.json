        {
          "#text": "Décret n°93-1222 du 3 novembre 1993 FIXANT LES CONDITIONS EXCEPTIONNELLES D'INTEGRATION D'AGENTS NON TITULAIRES DU MINISTERE DE L'INTERIEUR DANS DES CORPS DE FONCTIONNAIRES DE CATEGORIE B",
          "@c_titre_court": "Décret n°93-1222 du 3 novembre 1993",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000881988"
        },
        {
          "#text": "Décret n°93-1222 du 3 novembre 1993 fixant les conditions exceptionnelles d'intégration d'agents non titulaires du ministère de l'intérieur dans des corps de fonctionnaires de catégorie B",
          "@c_titre_court": "Décret n°93-1222 du 3 novembre 1993",
          "@debut": "1993-11-11",

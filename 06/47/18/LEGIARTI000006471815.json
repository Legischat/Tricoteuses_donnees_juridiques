      "TITRE_TXT": [
        {
          "#text": "Décret n°93-1242 du 10 novembre 1993 FIXANT LES CONDITIONS EXCEPTIONNELLES D'INTEGRATION D'AGENTS NON TITULAIRES DE L'OFFICE NATIONAL DES FORETS DANS DES CORPS DE FONCTIONNAIRES DE CATEGORIE B DE CET ETABLISSEMENT",
          "@c_titre_court": "Décret n°93-1242 du 10 novembre 1993",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000699426"
        },
        {
          "#text": "Décret n°93-1242 du 10 novembre 1993 fixant les conditions exceptionnelles d'intégration d'agents non titulaires de l'Office national des forêts dans des corps de fonctionnaires de catégorie B de cet établissement",
          "@c_titre_court": "Décret n°93-1242 du 10 novembre 1993",
          "@debut": "1993-11-18",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006067871"
        }
      ],

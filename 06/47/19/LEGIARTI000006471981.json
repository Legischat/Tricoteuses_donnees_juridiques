        {
          "#text": "Décret n°93-1348 du 28 décembre 1993 FIXANT DES CONDITIONS EXCEPTIONNELLES D'INTEGRATION DE PERSONNELS NON TITULAIRES DE FRANCE TELECOM DANS DES CORPS DE FONCTIONNAIRES DE CET EXPLOITANT PUBLIC DU NIVEAU DE LA CATEGORIE C",
          "@c_titre_court": "Décret n°93-1348 du 28 décembre 1993",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000518201"
        },
        {
          "#text": "Décret n°93-1348 du 28 décembre 1993 fixant des conditions exceptionnelles d'intégration de personnels non titulaires de France Télécom dans des corps de fonctionnaires de cet exploitant public du niveau de la catégorie C",
          "@c_titre_court": "Décret n°93-1348 du 28 décembre 1993",
          "@debut": "1993-12-30",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006067956"
        }
      ],

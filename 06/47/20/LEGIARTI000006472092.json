  "BLOC_TEXTUEL": {
    "CONTENU": "<p>Les ingénieurs des travaux publics de l'Etat de classe normale et les ingénieurs des travaux publics de l'Etat de classe exceptionnelle sont reclassés à compter du 1er août 1993 conformément au tableau ci-après :</p>\n<table>\n<tbody>\n<tr>\n<td colspan=\"2\" width=\"194\">\n<p align=\"center\">SITUATION ANCIENNE<br/>Ingénieur des travaux publics de l'Etat</p>\n</td>\n<td colspan=\"2\" width=\"184\">\n<p align=\"center\">SITUATION NOUVELLE<br/>Ingénieur des travaux publics de l'Etat</p>\n</td>\n</tr>\n<tr>\n<td width=\"89\">\n<p align=\"center\">Echelons</p>\n</td>\n<td width=\"105\">\n<p align=\"center\">Ancienneté</p>\n</td>\n<td width=\"89\">\n<p align=\"center\">Echelons</p>\n</td>\n<td width=\"95\">\n<p align=\"center\">Ancienneté</p>\n</td>\n</tr>\n<tr>\n<td width=\"89\">\n<p align=\"center\">Echelon unique</p>\n</td>\n<td width=\"105\">\n<p>Classe exceptionnelle</p>\n</td>\n<td width=\"89\">\n<p align=\"center\">9e</p>\n</td>\n<td width=\"95\">\n<p>Ancienneté acquise dans la limite de 3 ans </p>\n</td>\n</tr>\n<tr>\n<td width=\"89\">\n<p align=\"center\">8e</p>\n</td>\n<td width=\"105\">\n<p>Classe normale</p>\n</td>\n<td width=\"89\">\n<p align=\"center\">8e</p>\n</td>\n<td width=\"95\">\n<p>Ancienneté acquise majorée de 1 an dans la limite de 4 ans </p>\n</td>\n</tr>\n<tr>\n<td width=\"89\">\n<p align=\"center\">7e</p>\n</td>\n<td width=\"105\">\n<p>Egale ou supérieure à 3 ans</p>\n</td>\n<td width=\"89\">\n<p align=\"center\">8e</p>\n</td>\n<td width=\"95\">\n<p>Ancienneté acquise diminuée de 3 ans </p>\n</td>\n</tr>\n<tr>\n<td width=\"89\">\n<p align=\"center\">7e</p>\n</td>\n<td width=\"105\">\n<p>Inférieure à 3 ans</p>\n</td>\n<td width=\"89\">\n<p align=\"center\">7e</p>\n</td>\n<td width=\"95\">\n<p>Ancienneté acquise majorée de 1 an </p>\n</td>\n</tr>\n<tr>\n<td width=\"89\">\n<p align=\"center\">6e</p>\n</td>\n<td width=\"105\">\n<p>Egale ou supérieure à 2 ans 6 mois</p>\n</td>\n<td width=\"89\">\n<p align=\"center\">7e</p>\n</td>\n<td width=\"95\">\n<p>Ancienneté acquise diminuée de 2 ans 6 mois </p>\n</td>\n</tr>\n<tr>\n<td width=\"89\">\n<p align=\"center\">6e</p>\n</td>\n<td width=\"105\">\n<p>Inférieure à 2 ans 6 mois</p>\n</td>\n<td width=\"89\">\n<p align=\"center\">6e</p>\n</td>\n<td width=\"95\">\n<p>Ancienneté acquise majorée de 1 an </p>\n</td>\n</tr>\n<tr>\n<td width=\"89\">\n<p align=\"center\">5e</p>\n</td>\n<td width=\"105\">\n<p>Egale ou supérieure à 2 ans 6 mois</p>\n</td>\n<td width=\"89\">\n<p align=\"center\">6e</p>\n</td>\n<td width=\"95\">\n<p>Ancienneté acquise diminuée de 2 ans 6 mois </p>\n</td>\n</tr>\n<tr>\n<td width=\"89\">\n<p align=\"center\">5e</p>\n</td>\n<td width=\"105\">\n<p>Inférieure à 2 ans 6 mois</p>\n</td>\n<td width=\"89\">\n<p align=\"center\">5e</p>\n</td>\n<td width=\"95\">\n<p>Ancienneté acquise majorée de 6 mois </p>\n</td>\n</tr>\n<tr>\n<td width=\"89\">\n<p align=\"center\">4e</p>\n</td>\n<td width=\"105\">\n<p>Egale ou supérieure à 2 ans 6 mois</p>\n</td>\n<td width=\"89\">\n<p align=\"center\">5e</p>\n</td>\n<td width=\"95\">\n<p>Ancienneté acquise diminuée de 2 ans 6 mois </p>\n</td>\n</tr>\n<tr>\n<td width=\"89\">\n<p align=\"center\">4e</p>\n</td>\n<td width=\"105\">\n<p>Inférieure à 2 ans 6 mois</p>\n</td>\n<td width=\"89\">\n<p align=\"center\">4e</p>\n</td>\n<td width=\"95\">\n<p>Ancienneté acquise </p>\n</td>\n</tr>\n<tr>\n<td width=\"89\">\n<p align=\"center\">3e</p>\n</td>\n<td width=\"105\"/>\n<td width=\"89\">\n<p align=\"center\">3e</p>\n</td>\n<td width=\"95\">\n<p>Ancienneté acquise</p>\n</td>\n</tr>\n<tr>\n<td width=\"89\">\n<p align=\"center\">2e</p>\n</td>\n<td width=\"105\"/>\n<td width=\"89\">\n<p align=\"center\">2e</p>\n</td>\n<td width=\"95\">\n<p>Ancienneté acquise</p>\n</td>\n</tr>\n<tr>\n<td width=\"89\">\n<p align=\"center\">1er</p>\n</td>\n<td width=\"105\"/>\n<td width=\"89\">\n<p align=\"center\">1er</p>\n</td>\n<td width=\"95\">\n<p>Ancienneté acquise</p>\n</td>\n</tr>\n</tbody>\n</table>"
  }

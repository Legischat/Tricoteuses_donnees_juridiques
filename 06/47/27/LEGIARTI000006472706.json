  "BLOC_TEXTUEL": {
    "CONTENU": "<p align=\"center\">Tableau de correspondance</p>\n<p align=\"center\">Centre d'analyse stratégique</p>\n<p align=\"center\"> </p>\n<table>\n<tbody>\n<tr>\n<td width=\"227\">\n<p align=\"center\">CATÉGORIES D'AGENTS<br/>non titulaires</p>\n</td>\n<td width=\"227\">\n<p align=\"center\">FONCTIONS</p>\n</td>\n<td width=\"227\">\n<p align=\"center\">CORPS D'INTÉGRATION</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"227\">\n<p>Agents contractuels recrutés en application de l'instruction du 9 novembre 1977 en vigueur au Centre d'analyse stratégique. </p>\n</td>\n<td valign=\"top\" width=\"227\">\n<p>Personnel administratif exerçant, sous l'autorité des agents de catégorie A, des fonctions d'application ou participant à l'encadrement d'agents chargés de fonctions d'application ou d'exécution. </p>\n</td>\n<td valign=\"top\" width=\"227\">\n<p>Corps des secrétaires administratifs d'administration centrale.</p>\n</td>\n</tr>\n</tbody>\n</table>"

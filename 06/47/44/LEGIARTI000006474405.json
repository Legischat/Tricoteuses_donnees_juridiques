  "BLOC_TEXTUEL": {
    "CONTENU": "<p>L'échelonnement indiciaire applicable à l'emploi de chef de mission de l'Office national des forêts est fixé ainsi qu'il suit :</p>\n<table>\n<tbody>\n<tr>\n<td>\n<p align=\"center\">EMPLOI ET ECHELONS</p>\n</td>\n<td>\n<p align=\"center\">INDICES BRUTS</p>\n</td>\n</tr>\n<tr>\n<td>\n<p>6e échelon</p>\n</td>\n<td>\n<p align=\"center\">1 015</p>\n</td>\n</tr>\n<tr>\n<td>\n<p>5e échelon</p>\n</td>\n<td>\n<p align=\"center\">966</p>\n</td>\n</tr>\n<tr>\n<td>\n<p>4e échelon</p>\n</td>\n<td>\n<p align=\"center\">916</p>\n</td>\n</tr>\n<tr>\n<td>\n<p>3e échelon</p>\n</td>\n<td>\n<p align=\"center\">864</p>\n</td>\n</tr>\n<tr>\n<td>\n<p>2e échelon</p>\n</td>\n<td>\n<p align=\"center\">811</p>\n</td>\n</tr>\n<tr>\n<td rowspan=\"2\">\n<p>1er échelon</p>\n</td>\n<td rowspan=\"2\">\n<p align=\"center\">759</p>\n</td>\n</tr>\n</tbody>\n</table>"
  },

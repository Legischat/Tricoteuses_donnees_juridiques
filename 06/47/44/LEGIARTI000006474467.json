  "BLOC_TEXTUEL": {
    "CONTENU": "<p>L'échelonnement indiciaire applicable aux grades du corps des techniciens des systèmes d'information et de communication du ministère de l'intérieur régi par le décret du 24 août 2000 susvisé est fixé ainsi qu'il suit :</p>\n<table>\n<tbody>\n<tr>\n<td width=\"129\">\n<p align=\"center\">GRADE</p>\n</td>\n<td width=\"129\">\n<p align=\"center\">ÉCHELONS</p>\n</td>\n<td width=\"120\">\n<p align=\"center\">INDICES BRUTS<br/>au 1er août 1996</p>\n</td>\n</tr>\n<tr>\n<td rowspan=\"7\" valign=\"top\" width=\"129\">\n<p align=\"center\">Technicien divisionnaire</p>\n</td>\n<td width=\"129\">\n<p align=\"center\">7e</p>\n</td>\n<td width=\"120\">\n<p align=\"center\">650</p>\n</td>\n</tr>\n<tr>\n<td width=\"129\">\n<p align=\"center\">6e</p>\n</td>\n<td width=\"120\">\n<p align=\"center\">619</p>\n</td>\n</tr>\n<tr>\n<td width=\"129\">\n<p align=\"center\">5e</p>\n</td>\n<td width=\"120\">\n<p align=\"center\">588</p>\n</td>\n</tr>\n<tr>\n<td width=\"129\">\n<p align=\"center\">4e</p>\n</td>\n<td width=\"120\">\n<p align=\"center\">559</p>\n</td>\n</tr>\n<tr>\n<td width=\"129\">\n<p align=\"center\">3e</p>\n</td>\n<td width=\"120\">\n<p align=\"center\">525</p>\n</td>\n</tr>\n<tr>\n<td width=\"129\">\n<p align=\"center\">2e</p>\n</td>\n<td width=\"120\">\n<p align=\"center\">492</p>\n</td>\n</tr>\n<tr>\n<td width=\"129\">\n<p align=\"center\">1er</p>\n</td>\n<td width=\"120\">\n<p align=\"center\">462</p>\n</td>\n</tr>\n<tr>\n<td rowspan=\"8\" valign=\"top\" width=\"129\">\n<p align=\"center\">Technicien principal</p>\n</td>\n<td width=\"129\">\n<p align=\"center\">8e</p>\n</td>\n<td width=\"120\">\n<p align=\"center\">618</p>\n</td>\n</tr>\n<tr>\n<td width=\"129\">\n<p align=\"center\">7e</p>\n</td>\n<td width=\"120\">\n<p align=\"center\">585</p>\n</td>\n</tr>\n<tr>\n<td width=\"129\">\n<p align=\"center\">6e</p>\n</td>\n<td width=\"120\">\n<p align=\"center\">556</p>\n</td>\n</tr>\n<tr>\n<td width=\"129\">\n<p align=\"center\">5e</p>\n</td>\n<td width=\"120\">\n<p align=\"center\">524</p>\n</td>\n</tr>\n<tr>\n<td width=\"129\">\n<p align=\"center\">4e</p>\n</td>\n<td width=\"120\">\n<p align=\"center\">502</p>\n</td>\n</tr>\n<tr>\n<td width=\"129\">\n<p align=\"center\">3e</p>\n</td>\n<td width=\"120\">\n<p align=\"center\">474</p>\n</td>\n</tr>\n<tr>\n<td width=\"129\">\n<p align=\"center\">2e</p>\n</td>\n<td width=\"120\">\n<p align=\"center\">451</p>\n</td>\n</tr>\n<tr>\n<td width=\"129\">\n<p align=\"center\">1er</p>\n</td>\n<td width=\"120\">\n<p align=\"center\">430</p>\n</td>\n</tr>\n<tr>\n<td rowspan=\"13\" valign=\"top\" width=\"129\">\n<p align=\"center\">Technicien</p>\n</td>\n<td width=\"129\">\n<p align=\"center\">13e</p>\n</td>\n<td width=\"120\">\n<p align=\"center\">582</p>\n</td>\n</tr>\n<tr>\n<td width=\"129\">\n<p align=\"center\">12e</p>\n</td>\n<td width=\"120\">\n<p align=\"center\">551</p>\n</td>\n</tr>\n<tr>\n<td width=\"129\">\n<p align=\"center\">11e</p>\n</td>\n<td width=\"120\">\n<p align=\"center\">521</p>\n</td>\n</tr>\n<tr>\n<td width=\"129\">\n<p align=\"center\">10e</p>\n</td>\n<td width=\"120\">\n<p align=\"center\">490</p>\n</td>\n</tr>\n<tr>\n<td width=\"129\">\n<p align=\"center\">9e</p>\n</td>\n<td width=\"120\">\n<p align=\"center\">464</p>\n</td>\n</tr>\n<tr>\n<td width=\"129\">\n<p align=\"center\">8e</p>\n</td>\n<td width=\"120\">\n<p align=\"center\">442</p>\n</td>\n</tr>\n<tr>\n<td width=\"129\">\n<p align=\"center\">7e</p>\n</td>\n<td width=\"120\">\n<p align=\"center\">426</p>\n</td>\n</tr>\n<tr>\n<td width=\"129\">\n<p align=\"center\">6e</p>\n</td>\n<td width=\"120\">\n<p align=\"center\">402</p>\n</td>\n</tr>\n<tr>\n<td width=\"129\">\n<p align=\"center\">5e</p>\n</td>\n<td width=\"120\">\n<p align=\"center\">385</p>\n</td>\n</tr>\n<tr>\n<td width=\"129\">\n<p align=\"center\">4e</p>\n</td>\n<td width=\"120\">\n<p align=\"center\">374</p>\n</td>\n</tr>\n<tr>\n<td width=\"129\">\n<p align=\"center\">3e</p>\n</td>\n<td width=\"120\">\n<p align=\"center\">359</p>\n</td>\n</tr>\n<tr>\n<td width=\"129\">\n<p align=\"center\">2e</p>\n</td>\n<td width=\"120\">\n<p align=\"center\">347</p>\n</td>\n</tr>\n<tr>\n<td width=\"129\">\n<p align=\"center\">1er</p>\n</td>\n<td width=\"120\">\n<p align=\"center\">337</p>\n</td>\n</tr>\n</tbody>\n</table>."

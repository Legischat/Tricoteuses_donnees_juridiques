  "BLOC_TEXTUEL": {
    "CONTENU": "<p>La durée moyenne et la durée minimale du temps passé dans chacun des échelons des grades d'infirmière et infirmier de classe normale et d'infirmière et infirmier de classe supérieure sont fixées ainsi qu'il suit :</p>\n<table align=\"center\" border=\"1\" cellpadding=\"0\" cellspacing=\"0\" width=\"378\">\n<tbody>\n<tr>\n<td rowspan=\"2\" width=\"128\">\n<p align=\"center\">GRADES<br/>et échelons</p>\n</td>\n<td colspan=\"2\" width=\"250\">\n<p align=\"center\">DUREE</p>\n</td>\n</tr>\n<tr>\n<td width=\"125\">\n<p align=\"center\">Moyenne</p>\n</td>\n<td width=\"124\">\n<p align=\"center\">Minimale</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"128\">\n<p>Infirmière et infirmier de classe supérieure</p>\n</td>\n<td colspan=\"2\" valign=\"top\" width=\"250\"/>\n</tr>\n<tr>\n<td width=\"128\">\n<p>6e échelon</p>\n</td>\n<td width=\"125\">\n<p align=\"center\">-</p>\n</td>\n<td width=\"124\">\n<p align=\"center\">-</p>\n</td>\n</tr>\n<tr>\n<td width=\"128\">\n<p>5e échelon</p>\n</td>\n<td width=\"125\">\n<p align=\"center\">4 ans</p>\n</td>\n<td width=\"124\">\n<p align=\"center\">3 ans</p>\n</td>\n</tr>\n<tr>\n<td width=\"128\">\n<p>4e échelon</p>\n</td>\n<td width=\"125\">\n<p align=\"center\">3 ans</p>\n</td>\n<td width=\"124\">\n<p align=\"center\">2 ans 3 mois</p>\n</td>\n</tr>\n<tr>\n<td width=\"128\">\n<p>3e échelon</p>\n</td>\n<td width=\"125\">\n<p align=\"center\">3 ans</p>\n</td>\n<td width=\"124\">\n<p align=\"center\">2 ans 3 mois</p>\n</td>\n</tr>\n<tr>\n<td width=\"128\">\n<p>2e échelon</p>\n</td>\n<td width=\"125\">\n<p align=\"center\">2 ans</p>\n</td>\n<td width=\"124\">\n<p align=\"center\">1 an 6 mois</p>\n</td>\n</tr>\n<tr>\n<td width=\"128\">\n<p>1er échelon</p>\n</td>\n<td width=\"125\">\n<p align=\"center\">2 ans</p>\n</td>\n<td width=\"124\">\n<p align=\"center\">2 ans</p>\n</td>\n</tr>\n<tr>\n<td width=\"128\">\n<p>Infirmière et infirmier de classe normale</p>\n</td>\n<td colspan=\"2\" width=\"250\">\n<p align=\"center\"> </p>\n</td>\n</tr>\n<tr>\n<td width=\"128\">\n<p>8e échelon</p>\n</td>\n<td width=\"125\">\n<p align=\"center\">-</p>\n</td>\n<td width=\"124\">\n<p align=\"center\">-</p>\n</td>\n</tr>\n<tr>\n<td width=\"128\">\n<p>7e échelon</p>\n</td>\n<td width=\"125\">\n<p align=\"center\">4 ans</p>\n</td>\n<td width=\"124\">\n<p align=\"center\">3 ans</p>\n</td>\n</tr>\n<tr>\n<td width=\"128\">\n<p>6e échelon</p>\n</td>\n<td width=\"125\">\n<p align=\"center\">4 ans</p>\n</td>\n<td width=\"124\">\n<p align=\"center\">3 ans</p>\n</td>\n</tr>\n<tr>\n<td width=\"128\">\n<p>5e échelon</p>\n</td>\n<td width=\"125\">\n<p align=\"center\">4 ans</p>\n</td>\n<td width=\"124\">\n<p align=\"center\">3 ans</p>\n</td>\n</tr>\n<tr>\n<td width=\"128\">\n<p>4e échelon</p>\n</td>\n<td width=\"125\">\n<p align=\"center\">3 ans</p>\n</td>\n<td width=\"124\">\n<p align=\"center\">2 ans 3 mois</p>\n</td>\n</tr>\n<tr>\n<td width=\"128\">\n<p>3e échelon</p>\n</td>\n<td width=\"125\">\n<p align=\"center\">3 ans</p>\n</td>\n<td width=\"124\">\n<p align=\"center\">2 ans 3 mois</p>\n</td>\n</tr>\n<tr>\n<td width=\"128\">\n<p>2e échelon</p>\n</td>\n<td width=\"125\">\n<p align=\"center\">2 ans</p>\n</td>\n<td width=\"124\">\n<p align=\"center\">1 an 6 mois</p>\n</td>\n</tr>\n<tr>\n<td width=\"128\">\n<p>1er échelon</p>\n</td>\n<td width=\"125\">\n<p align=\"center\">1 an</p>\n</td>\n<td width=\"124\">\n<p align=\"center\">1 an</p>\n</td>\n</tr>\n</tbody>\n</table>"
  },

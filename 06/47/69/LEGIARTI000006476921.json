  "BLOC_TEXTUEL": {
    "CONTENU": "<p>La durée moyenne et la durée minimale du temps passé dans chacun des échelons des grades mentionnés à l'article 2 ci-dessus sont fixées ainsi qu'il suit : </p>\n<br/>\n<table>\n<tbody>\n<tr>\n<td width=\"205\">\n<p align=\"center\">GRADES ET ÉCHELONS</p>\n</td>\n<td width=\"205\">\n<p align=\"center\">DURÉE MOYENNE</p>\n</td>\n<td width=\"205\">\n<p align=\"center\">DURÉE MINIMALE</p>\n</td>\n</tr>\n<tr>\n<td width=\"205\">\n<p align=\"center\">Chef technicien</p>\n</td>\n<td width=\"205\">\n<p align=\"center\"> </p>\n</td>\n<td width=\"205\">\n<p align=\"center\"> </p>\n</td>\n</tr>\n<tr>\n<td width=\"205\">\n<p>6e échelon</p>\n</td>\n<td width=\"205\">\n<p align=\"center\">-</p>\n</td>\n<td width=\"205\">\n<p align=\"center\">-</p>\n</td>\n</tr>\n<tr>\n<td width=\"205\">\n<p>5e échelon </p>\n</td>\n<td width=\"205\">\n<p align=\"center\">4 ans</p>\n</td>\n<td width=\"205\">\n<p align=\"center\">3 ans</p>\n</td>\n</tr>\n<tr>\n<td width=\"205\">\n<p>4e échelon </p>\n</td>\n<td width=\"205\">\n<p align=\"center\">4 ans</p>\n</td>\n<td width=\"205\">\n<p align=\"center\">3 ans</p>\n</td>\n</tr>\n<tr>\n<td width=\"205\">\n<p>3e échelon</p>\n</td>\n<td width=\"205\">\n<p align=\"center\">3 ans</p>\n</td>\n<td width=\"205\">\n<p align=\"center\">2 ans 3 mois</p>\n</td>\n</tr>\n<tr>\n<td width=\"205\">\n<p>2e échelon</p>\n</td>\n<td width=\"205\">\n<p align=\"center\">3 ans</p>\n</td>\n<td width=\"205\">\n<p align=\"center\">2 ans 3 mois</p>\n</td>\n</tr>\n<tr>\n<td width=\"205\">\n<p>1er échelon</p>\n</td>\n<td width=\"205\">\n<p align=\"center\">2 ans</p>\n</td>\n<td width=\"205\">\n<p align=\"center\">1 an 6 mois</p>\n</td>\n</tr>\n<tr>\n<td width=\"205\">\n<p align=\"center\">Technicien supérieur de 1re classe</p>\n</td>\n<td width=\"205\">\n<p align=\"center\"> </p>\n</td>\n<td width=\"205\">\n<p align=\"center\"> </p>\n</td>\n</tr>\n<tr>\n<td width=\"205\">\n<p>7e échelon </p>\n</td>\n<td width=\"205\">\n<p align=\"center\">-</p>\n</td>\n<td width=\"205\">\n<p align=\"center\">-</p>\n</td>\n</tr>\n<tr>\n<td width=\"205\">\n<p>6e échelon</p>\n</td>\n<td width=\"205\">\n<p align=\"center\">4 ans</p>\n</td>\n<td width=\"205\">\n<p align=\"center\">3 ans</p>\n</td>\n</tr>\n<tr>\n<td width=\"205\">\n<p>5e échelon </p>\n</td>\n<td width=\"205\">\n<p align=\"center\">4 ans</p>\n</td>\n<td width=\"205\">\n<p align=\"center\">3 ans</p>\n</td>\n</tr>\n<tr>\n<td width=\"205\">\n<p>4e échelon </p>\n</td>\n<td width=\"205\">\n<p align=\"center\">4 ans</p>\n</td>\n<td width=\"205\">\n<p align=\"center\">3 ans</p>\n</td>\n</tr>\n<tr>\n<td width=\"205\">\n<p>3e échelon</p>\n</td>\n<td width=\"205\">\n<p align=\"center\">3 ans</p>\n</td>\n<td width=\"205\">\n<p align=\"center\">2 ans 3 mois</p>\n</td>\n</tr>\n<tr>\n<td width=\"205\">\n<p>2e échelon </p>\n</td>\n<td width=\"205\">\n<p align=\"center\">3 ans</p>\n</td>\n<td width=\"205\">\n<p align=\"center\">2 ans 3 mois</p>\n</td>\n</tr>\n<tr>\n<td width=\"205\">\n<p>1er échelon </p>\n</td>\n<td width=\"205\">\n<p align=\"center\">2 ans</p>\n</td>\n<td width=\"205\">\n<p align=\"center\">1 an 6 mois</p>\n</td>\n</tr>\n<tr>\n<td width=\"205\">\n<p align=\"center\">Technicien supérieur de 2e classe</p>\n</td>\n<td width=\"205\">\n<p align=\"center\"> </p>\n</td>\n<td width=\"205\">\n<p align=\"center\"> </p>\n</td>\n</tr>\n<tr>\n<td width=\"205\">\n<p>13e échelon </p>\n</td>\n<td width=\"205\">\n<p align=\"center\">-</p>\n</td>\n<td width=\"205\">\n<p align=\"center\">-</p>\n</td>\n</tr>\n<tr>\n<td width=\"205\">\n<p>12e échelon </p>\n</td>\n<td width=\"205\">\n<p align=\"center\">4 ans</p>\n</td>\n<td width=\"205\">\n<p align=\"center\">3 ans</p>\n</td>\n</tr>\n<tr>\n<td width=\"205\">\n<p>11e échelon </p>\n</td>\n<td width=\"205\">\n<p align=\"center\">3 ans</p>\n</td>\n<td width=\"205\">\n<p align=\"center\">2 ans 3 mois</p>\n</td>\n</tr>\n<tr>\n<td width=\"205\">\n<p>10e échelon</p>\n</td>\n<td width=\"205\">\n<p align=\"center\">3 ans</p>\n</td>\n<td width=\"205\">\n<p al
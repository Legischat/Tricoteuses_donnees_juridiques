  "NOTA": {
    "CONTENU": "<br/>   NOTA : Décret 96-273 du 26 mars 1996 art. 29 : Sont abrogées au 1er août 1996 les dispositions relatives aux corps des techniciens de laboratoire régis par le décret 95-272 du 8 mars 1995.<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Le corps des aides de laboratoire des établissements d'enseignement agricole publics comprend deux grades :<br/>\n<br/>   a) Aide de laboratoire ;<br/>\n<br/>   b) Aide principal de laboratoire.<br/>"
  },

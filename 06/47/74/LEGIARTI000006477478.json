  "NOTA": {
    "CONTENU": "[*NOTA : Décret 96-273 du 26 mars 1996 art. 29 : Sont abrogées au 1er août 1996 les dispositions relatives aux corps des techniciens de laboratoire régis par le décret 95-272 du 8 mars 1995.*]<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les dispositions du décret du 2 mai 1972 susvisé sont abrogées en ce qu'elles concernent les aides de laboratoire exerçant dans les établissements d'enseignement agricole.<br/>\n<br/>"
  },

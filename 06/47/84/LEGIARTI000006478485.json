  "NOTA": {
    "CONTENU": "Loi 2001-43 2001-01-16 art. 7 : La loi 51-1082 est abrogée en tant qu'elle concerne les courtiers interprètes et conducteurs de navires.<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {

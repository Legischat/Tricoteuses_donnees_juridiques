  "BLOC_TEXTUEL": {
    "CONTENU": "<p>Les officiers de paix principaux sont reclassés conformément au tableau ci-après :</p>\n<table>\n<tbody>\n<tr>\n<td width=\"205\">\n<p align=\"center\">SITUATION <br/>ancienne</p>\n</td>\n<td width=\"205\">\n<p align=\"center\">SITUATION <br/>nouvelle</p>\n</td>\n<td width=\"205\">\n<p align=\"center\">ANCIENNETÉ</p>\n</td>\n</tr>\n<tr>\n<td width=\"205\">\n<p>Echelon exceptionnel</p>\n</td>\n<td width=\"205\">\n<p align=\"center\">Echelon exceptionnel</p>\n</td>\n<td width=\"205\">\n<p align=\"center\">Ancienneté conservée.</p>\n</td>\n</tr>\n<tr>\n<td width=\"205\">\n<p>3e échelon</p>\n</td>\n<td width=\"205\">\n<p align=\"center\">3e échelon</p>\n</td>\n<td width=\"205\">\n<p align=\"center\">Ancienneté conservée.</p>\n</td>\n</tr>\n<tr>\n<td width=\"205\">\n<p>2e échelon</p>\n</td>\n<td width=\"205\">\n<p align=\"center\">2e échelon</p>\n</td>\n<td width=\"205\">\n<p align=\"center\">Ancienneté conservée.</p>\n</td>\n</tr>\n<tr>\n<td width=\"205\">\n<p>1er échelon</p>\n</td>\n<td width=\"205\">\n<p align=\"center\">1er échelon</p>\n</td>\n<td width=\"205\">\n<p align=\"center\">Ancienneté conservée.</p>\n</td>\n</tr>\n</tbody>\n</table>"

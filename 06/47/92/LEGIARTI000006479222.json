  "BLOC_TEXTUEL": {
    "CONTENU": "<p align=\"center\">FONCTIONS EXERCÉES POUVANT OUVRIR DROIT AU VERSEMENT D'UNE NOUVELLE BONIFICATION INDICIAIRE</p>\n<p align=\"center\">  Fonctions relevant de l'armée de terre</p>\n<br/>\n<br/>\n<table border=\"1\">\n<tbody>\n<tr>\n<td align=\"center\">DÉSIGNATION DE LA FONCTION <br/>\n</td>\n<td align=\"center\">\n<p>NIVEAU </p>\n<p>des responsabilités </p>\n<p>exercées </p>\n</td>\n</tr>\n<tr>\n<td>Chef de corps de 1er niveau et assimilé. <br/>\n</td>\n<td align=\"center\"> Officier</td>\n</tr>\n<tr>\n<td>Chef de corps de 2e niveau et assimilé. <br/>\n</td>\n<td align=\"center\"> Officier</td>\n</tr>\n<tr>\n<td>Commandant d'unité élémentaire d'intervention. <br/>\n</td>\n<td align=\"center\">Officier <br/>\n</td>\n</tr>\n<tr>\n<td>Chef de section d'intervention en unité d'intervention. <br/>\n</td>\n<td align=\"center\">\n<p>  Officier</p>\n<p>  ou sous-officier</p>\n</td>\n</tr>\n<tr>\n<td>\n<p>Commandant d'unité élémentaire d'instruction ou de </p>\n<p>commandement et de soutien. </p>\n</td>\n<td align=\"center\">Officier <br/>\n</td>\n</tr>\n<tr>\n<td>Chef de section d'instruction en unité élémentaire d'instruction. <br/>\n</td>\n<td align=\"center\">\n<p>  Officier</p>\n<p>  ou sous-officier </p>\n</td>\n</tr>\n</tbody>\n</table>\n<br/>\n<br/>\n<br/>\n<br/>\n<br/>\n<br/>\n<br/>\n<br/>\n<br/>\n<br/>\n<br/>\n<br/>\n<br/>\n<br/>\n<br/>\n<br/>\n<br/>\n<br/>"
  }

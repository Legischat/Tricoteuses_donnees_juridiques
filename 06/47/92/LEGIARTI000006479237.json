  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les officiers des armes de l'armée de terre constituent un corps d'officiers de carrière dont la hiérarchie comporte les grades suivants :<br/>\n Officiers subalternes :<br/>\n  Sous-lieutenant ;<br/>\n  Lieutenant ;<br/>\n  Capitaine.<br/>\n Officiers supérieurs :<br/>\n  Commandants ;<br/>\n  Lieutenant-colonel ;<br/>\n  Colonel.<br/>\n Officiers généraux :<br/>\n  Général de brigade ;<br/>\n  Général de division.<br/>"
  },

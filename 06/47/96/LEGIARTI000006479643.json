  "BLOC_TEXTUEL": {
    "CONTENU": "<p>La durée moyenne et la durée minimum du temps passé dans chacun des échelons des grades et classes d'attachés sont fixées ainsi qu'il suit :</p>\n<br/>\n<br/>\n<br/>\n<br/>\n<table>\n<tbody>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">\n<strong>GRADES ET CLASSES</strong>\n</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">\n<strong>ECHELONS</strong>\n</p>\n</td>\n<td align=\"left\" colspan=\"2\" valign=\"middle\">\n<p align=\"center\">\n<strong>DUREE</strong>\n</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<pre> </pre>\n</td>\n<td align=\"left\" valign=\"middle\">\n<pre> </pre>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">Moyenne</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">Minimum</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">Attaché principal de 1<sup>re</sup> classe</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">2<sup>e</sup>\n</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">3 ans</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">2 ans 3 mois</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<pre> </pre>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">1<sup>er</sup>\n</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">3 ans</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">2 ans 3 mois</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">Attaché principal de 2<sup>e</sup> classe</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">6<sup>e</sup>\n</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">2 ans 6 mois</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">2 ans</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<pre> </pre>\n</td>\n<td align=\"left\" vali
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les dispositions du présent titre s'appliquent aux officiers des corps suivants :<br/>\n<br/>   Armée de terre :<br/>\n<br/>   Officiers techniciens de l'infanterie ;<br/>\n<br/>   Officiers techniciens des troupes de marine ;<br/>\n<br/>   Officiers techniciens de l'armée blindée et de la cavalerie ;<br/>\n<br/>   Officiers techniciens de l'artillerie ;<br/>\n<br/>   Officiers techniciens du train ; <br/>\n<br/>   Officiers techniciens du génie ; <br/>\n<br/>   Officiers techniciens des transmissions ;<br/>\n<br/>   Armée de l'air :<br/>\n<br/>   Officiers techniciens de l'air ;<br/>\n<br/>   Officiers techniciens mécaniciens de l'air ;<br/>\n<br/>   Officiers techniciens des bases de l'air ;<br/>\n<br/>   Marine :<br/>\n<br/>   Officiers techniciens de la marine.<br/>"
  },

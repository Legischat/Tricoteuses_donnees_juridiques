  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les officiers du cadre spécial de l'armée de terre constituent un corps d'officiers de carrière dont la hiérarchie comporte les grades suivants :<br/>\n<br/>   Officiers subalternes :<br/>\n<br/>   Sous-lieutenant ;<br/>\n<br/>   Lieutenant ;<br/>\n<br/>   Capitaine.<br/>\n<br/>   Officiers supérieurs :<br/>\n<br/>   Commandant ;<br/>\n<br/>   Lieutenant-colonel ;<br/>\n<br/>   Colonel.<br/>\n<br/>   Officiers généraux :<br/>\n<br/>   Général de brigade ;<br/>\n<br/>   Général de division.<br/>"
  },

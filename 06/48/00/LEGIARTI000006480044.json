  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les officiers de marine et les officiers spécialisés de la marine constituent deux corps d'officiers de carrière dont la hiérarchie comporte les grades suivants :<br/>\n<br/>   Officiers subalternes :<br/>\n<br/>   - Enseigne de vaisseau de 2e classe ;<br/>\n<br/>   - Enseigne de vaisseau de 1re classe ;<br/>\n<br/>   - Lieutenant de vaisseau ;<br/>\n<br/>   Officiers supérieurs :<br/>\n<br/>   - Capitaine de corvette ;<br/>\n<br/>   - Capitaine de frégate ;<br/>\n<br/>   - Capitaine de vaisseau ;<br/>\n<br/>   Officiers généraux :<br/>\n<br/>   - Contre-amiral ;<br/>\n<br/>   - Vice-amiral.<br/>"
  },

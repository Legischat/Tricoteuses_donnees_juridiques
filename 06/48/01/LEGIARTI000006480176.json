      "TITRE_TXT": [
        {
          "#text": "Décret n°89-590 du 28 août 1989 RELATIF A L'EVOLUTION DE CERTAINS LOYERS DANS L'AGGLOMERATION DE PARIS,PRIS EN APPLICATION DE L'ART. 18 DE LA LOI 89462 DU 06-07-1989 TENDANT A AMELIORER LES RAPPORTS LOCATIFS ET PORTANT MODIFICATION DE LA LOI 861290 DU 23-12-1986",
          "@c_titre_court": "Décret n°89-590 du 28 août 1989",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000885990"
        },
        {
          "#text": "Décret n°89-590 du 28 août 1989 relatif à l'évolution de certains loyers dans l'agglomération de Paris, pris en application de l'article 18 de la loi n° 89-462 du 6 juillet 1989 tendant à améliorer les rapports locatifs et portant modification de la loi n° 86-1290 du 23 décembre 1986",
          "@c_titre_court": "Décret n°89-590 du 28 août 1989",
          "@debut": "1989-08-29",
          "@fin": "2999-01-01",

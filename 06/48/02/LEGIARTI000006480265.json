  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les commissaires de l'air constituent un corps d'officiers de carrière dont la hiérarchie comporte les grades suivants :<br/>\n<br/>   Officiers subalternes :<br/>\n<br/>   Commissaire sous-lieutenant ;<br/>\n<br/>   Commissaire lieutenant ;<br/>\n<br/>   Commissaire capitaine.<br/>\n<br/>   Officiers supérieurs :<br/>\n<br/>   Commissaire commandant ;<br/>\n<br/>   Commissaire lieutenant-colonel ;<br/>\n<br/>   Commissaire colonel.<br/>\n<br/>   Officiers généraux :<br/>\n<br/>   Commissaire général de brigade aérienne ;<br/>\n<br/>   Commissaire général de division aérienne.<br/>"
  },

  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les officiers des corps techniques et administratifs des armées constituent les corps d'officiers de carrière suivants :<br/>\n<br/>   Corps technique et administratif de l'armée de terre ;<br/>\n<br/>   Corps technique et administratif de la marine ;<br/>\n<br/>   Corps technique et administratif de la gendarmerie nationale ;<br/>\n<br/>   Corps technique et administratif de l'armement ;<br/>\n<br/>   Corps technique et administratif du service de santé des armées ;<br/>\n<br/>   Corps technique et administratif du service des essences des armées.<br/>"
  },

      "TITRE_TXT": [
        {
          "#text": "Décret no 95-736 du 10 mai 1995 modifiant divers décrets portant statuts    particuliers de certains corps d'officiers des armées et services communs et    instituant un nouvel échelon de solde pour le grade de capitaine ou assimilé",
          "@c_titre_court": "Décret n°95-736 du 10 mai 1995",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000354776"
        },
        {
          "#text": "Décret n°95-736 du 10 mai 1995 modifiant divers décrets portant statuts particuliers de certains corps d'officiers des armées et services communs et instituant un nouvel échelon de solde pour le grade de capitaine ou assimilé",
          "@c_titre_court": "Décret n°95-736 du 10 mai 1995",

  "BLOC_TEXTUEL": {
    "CONTENU": "<p>La durée du temps passé dans chacun des échelons des grades régis par le présent statut est fixée ainsi qu'il suit :</p>\n<br/>\n<table align=\"center\" border=\"1\" cellpadding=\"0\" cellspacing=\"0\" width=\"378\">\n<tbody>\n<tr>\n<td width=\"307\">\n<p align=\"center\">GRADES ET ÉCHELONS</p>\n</td>\n<td width=\"307\">\n<p align=\"center\">DURÉE</p>\n</td>\n</tr>\n<tr>\n<td width=\"307\">\n<p align=\"center\">Hors classe</p>\n</td>\n<td width=\"307\">\n<p align=\"center\"> </p>\n</td>\n</tr>\n<tr>\n<td width=\"307\">\n<p>6e échelon</p>\n</td>\n<td width=\"307\">\n<p align=\"center\">3 ans</p>\n</td>\n</tr>\n<tr>\n<td width=\"307\">\n<p>5e échelon</p>\n</td>\n<td width=\"307\">\n<p align=\"center\">3 ans</p>\n</td>\n</tr>\n<tr>\n<td width=\"307\">\n<p>4e échelon</p>\n</td>\n<td width=\"307\">\n<p align=\"center\">2 ans 6 mois</p>\n</td>\n</tr>\n<tr>\n<td width=\"307\">\n<p>3e échelon</p>\n</td>\n<td width=\"307\">\n<p align=\"center\">2 ans 6 mois</p>\n</td>\n</tr>\n<tr>\n<td width=\"307\">\n<p>2e échelon</p>\n</td>\n<td width=\"307\">\n<p align=\"center\">2 ans 6 mois</p>\n</td>\n</tr>\n<tr>\n<td width=\"307\">\n<p>1er échelon</p>\n</td>\n<td width=\"307\">\n<p align=\"center\">2 ans 6 mois</p>\n</td>\n</tr>\n<tr>\n<td width=\"307\">\n<p align=\"center\">Classe normale</p>\n</td>\n<td width=\"307\">\n<p align=\"center\"> </p>\n</td>\n</tr>\n<tr>\n<td width=\"307\">\n<p>10e échelon</p>\n</td>\n<td width=\"307\">\n<p align=\"center\">4 ans 6 mois</p>\n</td>\n</tr>\n<tr>\n<td width=\"307\">\n<p>9e échelon</p>\n</td>\n<td width=\"307\">\n<p align=\"center\">4 ans</p>\n</td>\n</tr>\n<tr>\n<td width=\"307\">\n<p>8e échelon</p>\n</td>\n<td width=\"307\">\n<p align=\"center\">4 ans</p>\n</td>\n</tr>\n<tr>\n<td width=\"307\">\n<p>7e échelon</p>\n</td>\n<td width=\"307\">\n<p align=\"center\">3 ans</p>\n</td>\n</tr>\n<tr>\n<td width=\"307\">\n<p>6e échelon</p>\n</td>\n<td width=\"307\">\n<p align=\"center\">3 ans</p>\n</td>\n</tr>\n<tr>\n<td width=\"307\">\n<p>5e échelon</p>\n</td>\n<td width=\"307\">\n<p align=\"center\">3 ans</p>\n</td>\n</tr>\n<tr>\n<td width=\"307\">\n<p>4e échelon</p>\n</td>\n<td width=\"307\">\n<p align=\"center\">2 ans 6 mois</p>\n</td>\n</tr>\n<tr>\n<td width=\"307\">\n<p>3e échelon</p>\n</td>\n<td width=\"307\">\n<p align=\"center\">1 an</p>\n</td>\n</tr>\n<tr>\n<td width=\"307\">\n<p>2e échelon</p>\n</td>\n<td width=\"307\">\n<p align=\"center\">9 mois</p>\n</td>\n</tr>\n<tr>\n<td width=\"307\">\n<p>1er échelon</p>\n</td>\n<td width=\"307\">\n<p align=\"center\">3 mois</p>\n</td>\n</tr>\n</tbody>\n</table>"
  },

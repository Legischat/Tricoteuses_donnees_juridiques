  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les recettes de l'école comprennent notamment :<br/>\n<br/>   1° Les subventions annuelles de l'Etat ou de toute autre collectivité ;<br/>\n<br/>   2° Les produits de l'aliénation des biens, fonds et valeurs ;<br/>\n<br/>   3° Les revenus des biens, fonds et valeurs ;<br/>\n<br/>   4° Les dons et legs faits au profit de l'établissement ;<br/>\n<br/>   5° Le produit des emprunts ;<br/>\n<br/>   6° La rémunération des services rendus.<br/>"
  },

  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Sont supprimés au chapitre 31-90 du budget des services financiers :<br/>\n<br/>   - un emploi d'administrateur civil ;<br/>\n<br/>   - deux emplois d'administrateur de 1re classe de l'I.N.S.E.E. ;<br/>\n<br/>   - un emploi de receveur divisionnaire de la direction générale des impôts ;<br/>\n<br/>   - un emploi de directeur adjoint des douanes et droits indirects ;<br/>\n<br/>   - un emploi de trésorier principal du Trésor public.<br/>"
  },

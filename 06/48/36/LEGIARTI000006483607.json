  "NOTA": {
    "CONTENU": "<br/>  Décret 2004-978 du 17 septembre 2004 art. 18 : Le décret n° 96-1179 est abrogé le lendemain des prochaines élections au comité d'entreprise de France Télécom.<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   A compter de la mise en place du comité paritaire, le décret n° 92-451 du 21 mai 1992 est abrogé.<br/>\n<br/>"
  },

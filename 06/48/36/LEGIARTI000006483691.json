  "BLOC_TEXTUEL": {
    "CONTENU": "<p align=\"left\">Les durées moyenne et minimale du temps passé dans chacun des échelons des grades du corps des géomètres du cadastre sont fixées ainsi qu'il suit :</p>\n<table>\n<tbody>\n<tr>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">\n<strong>GRADES, ECHELONS</strong>\n</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">\n<strong>DUREE MOYENNE</strong>\n</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">\n<strong>DUREE MINIMALE</strong>\n</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">\n<i>Géomètre principal</i>\n</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<pre> </pre>\n</td>\n<td align=\"left\" valign=\"top\">\n<pre> </pre>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"top\">\n<p align=\"justify\">2e échelon</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">4 ans</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">3 ans</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"top\">\n<p align=\"justify\">1er échelon</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">3 ans</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">2 ans 6 mois</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">\n<i>Géomètre</i>\n</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<pre> </pre>\n</td>\n<td align=\"left\" valign=\"top\">\n<pre> </pre>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"top\">\n<p align=\"justify\">6e échelon</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">4 ans</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">3 ans</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"top\">\n<p align=\"justify\">5e échelon</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">3 ans</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">2 ans 3 mois</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"top\">\n<p align=\"justify\">4e échelon</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">3 ans</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">2 ans 3 mois</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"top\">\n<p align=\"justify\">3e échelon</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">3 ans</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">2 ans 3 mois</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"top\">\n<p align=\"justify\">2e échelon</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">2 ans</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">1 an 6 mois</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"top\">\n<p align=\"justify\">1er échelon</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">2 ans</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">1 an 6 mois</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">\n<i>Technicien-géomètre</i>\n</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<pre> </pre>\n</td>\n<td align=\"left\" valign=\"top\">\n<pre> </pre>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"top\">\n<p align=\"justify\">10e échelon</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">4 ans</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">3 ans</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"top\">\n<p align=\"justify\">9e échelon</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">4 ans</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">3 ans</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"top\">\n<p align=\"justify\">8e échelon</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">3 ans</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">2 ans 3 mois</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"top\">\n<p align=\"justify\">7e échelon</p>\n</td>\n<td align=\"left
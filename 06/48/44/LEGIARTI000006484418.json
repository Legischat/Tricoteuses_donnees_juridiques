  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les attachés promus attachés principaux de 2e classe sont classés conformément au tableau ci-après :<br/>\n<br/>\n<br/>  I = SITUATION ANCIENNE DANS LE GRADE D'ATTACHE (échelon)<br/>\n<br/> II = SITUATION NOUVELLE DANS LE GRADE D'ATTACHE PRINCIPAL DE 2E CLASSE<br/>\n III = Echelon<br/>\n<br/> IV = Ancienneté conservée<br/>\n<br/>\n<table>\n<tr>\n<td> :----:-----------------------:</td>\n</tr>\n<tr>\n<td> : I  :           II          :</td>\n</tr>\n<tr>\n<td> :----:---:-------------------:</td>\n</tr>\n<tr>\n<td> : I  :III:       IV          :</td>\n</tr>\n<tr>\n<td> :----:---:-------------------:</td>\n</tr>\n<tr>\n<td> : 12e: 6e: Sans ancienneté   :</td>\n</tr>\n<tr>\n<td> : 11e: 5e: 3/4 de l'anc. acq.:</td>\n</tr>\n<tr>\n<td> : 10e: 4e: 5/6 de l'anc. acq.:</td>\n</tr>\n<tr>\n<td> :  9e: 3e: 1/2 de l'anc. acq.:</td>\n</tr>\n<tr>\n<td> :    :   :   majoré de 1 an  :</td>\n</tr>\n<tr>\n<td> :  8e: 3e: 1/3 de l'anc. acq.:</td>\n</tr>\n<tr>\n<td> :  7e: 2e: 5/6 de l'anc. acq.:</td>\n</tr>\n<tr>\n<td> :  6e: 1e: Anc. acq. au-delà :</td>\n</tr>\n<tr>\n<td> :    :   :   de 1 an 6 mois  :</td>\n</tr>\n<tr>\n<td> :----:---:-------------------:</td>\n</tr>\n</table>\n<br/>"
  },

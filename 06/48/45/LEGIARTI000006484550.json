  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   La durée moyenne et la durée minimum du temps passé dans chacun des échelons des grades et classes du corps administratif supérieur des services déconcentrés du ministère de la défense sont fixées ainsi qu'il suit :<br/>\n<br/>\n Grades et classes : CHEF DE SERVICE ADMINISTRATIF DE 1RE CLASSE<br/>\n<br/>  I = ECHELONS<br/>\n<br/> II = DUREE MOYENNE<br/>\n III = DUREE MINIMUM<br/>\n<table>\n<tr>\n<td> :----:-------:--------------:</td>\n</tr>\n<tr>\n<td> : I  :   II  :      III     :</td>\n</tr>\n<tr>\n<td> :----:-------:--------------:</td>\n</tr>\n<tr>\n<td> : 5e : 3 ans : 2 ans 3 mois :</td>\n</tr>\n<tr>\n<td> : 4e : 3 ans : 2 ans 3 mois :</td>\n</tr>\n<tr>\n<td> : 3e : 2 ans : 1 an 6 mois  :</td>\n</tr>\n<tr>\n<td> : 2e : 2 ans : 1 an 6 mois  :</td>\n</tr>\n<tr>\n<td> : 1e : 2 ans : 1 an 6 mois  :</td>\n</tr>\n<tr>\n<td> :----:-------:--------------:</td>\n</tr>\n</table>\n<br/>\n<br/>\n Grades et classes : CHEF DE SERVICE ADMINISTRATIF DE 2E CLASSE<br/>\n<br/>  I = ECHELONS<br/>\n<br/> II = DUREE MOYENNE<br/>\n III = DUREE MINIMUM<br/>\n<table>\n<tr>\n<td> :----:-------:--------------:</td>\n</tr>\n<tr>\n<td> : I  :   II  :      III     :</td>\n</tr>\n<tr>\n<td> :----:-------:--------------:</td>\n</tr>\n<tr>\n<td> : 6e : 3 ans : 2 ans 3 mois :</td>\n</tr>\n<tr>\n<td> : 5e : 3 ans : 2 ans 3 mois :</td>\n</tr>\n<tr>\n<td> : 4e : 3 ans : 2 ans 3 mois :</td>\n</tr>\n<tr>\n<td> : 3e : 2 ans : 1 an 6 mois  :</td>\n</tr>\n<tr>\n<td> : 2e : 2 ans : 1 an 6 mois  :</td>\n</tr>\n<tr>\n<td> : 1e : 1 an  :    1 an      :</td>\n</tr>\n<tr>\n<td> :----:-------:--------------:</td>\n</tr>\n</table>\n<br/>\n<br/>\n Grades et classes : CHEF DE SERVICE ADMINISTRATIF<br/>\n<br/>  I = ECHELONS<br/>\n<br/> II = DUREE MOYENNE<br/>\n III = DUREE MINIMUM<br/>\n<table>\n<tr>\n<td> :-----:-------:--------------:</td>\n</tr>\n<tr>\n<td> :  I  :   II  :      III     :</td>\n</tr>\n<tr>\n<td> :-----:-------:--------------:</td>\n</tr>\n<tr>\n<td> : 11e : 4 ans :    3 ans     :</td>\n</tr>\n<tr>\n<td> : 10e : 3 ans : 2 ans 3 mois :</td>\n</tr>\n<tr>\n<td> : 9e  : 3 ans : 2 ans 3 mois :</td>\n</tr>\n<tr>\n<td> : 8e  : 3 ans : 2 ans 3 mois :</td>\n</tr>\n<tr>\n<td> : 7e  : 3 ans : 2 ans 3 mois :</td>\n</tr>\n<tr>\n<td> : 6e  : 2 ans :              :</td>\n</tr>\n<tr>\n<td> :     : 6 mois:     2 ans    :</td>\n</tr>\n<tr>\n<td> : 5e  : 2 ans : 1 an 6 mois  :</td>\n</tr>\n<tr>\n<td> : 4e  : 2 ans : 1 an 6 mois  :</td>\n</tr>\n<tr>\n<td> : 3e  : 2 ans : 1 an 6 mois  :</td>\n</tr>\n<tr>\n<td> : 2e  : 1 an  :    1 an      :</td>\n</tr>\n<tr>\n<td> : 1e  : 1 an  :    1 an      :</td>\n</tr>\n<tr>\n<td> :-----:-------:--------------:</td>\n</tr>\n</table>\n<br/>"

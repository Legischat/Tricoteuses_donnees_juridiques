        {
          "#text": "Décret n°53-960 du 30 septembre 1953 REGLANT LES RAPPORTS ENTRE BAILLEURS ET LOCATAIRES EN CE QUI CONCERNE LE RENOUVELLEMENT DES BAUX",
          "@c_titre_court": "Décret n°53-960 du 30 septembre 1953",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000675530"
        },
        {
          "#text": "Décret n°53-960 du 30 septembre 1953 réglant les rapports entre bailleurs et locataires en ce qui concerne le renouvellement des baux à loyer d'immeubles ou de locaux à usage commercial, industriel ou artisanal",
          "@c_titre_court": "Décret n°53-960 du 30 septembre 1953",
          "@debut": "1953-10-01",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006060676"
        }
      ],
      "TM": {
        "TITRE_TM": [
          {

  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   La durée moyenne et la durée minimum du temps passé dans chacun des échelons des classes de chargé de mission de l'INSEE sont fixées ainsi qu'il suit.<br/>\n<br/>\n GRADES ET CLASSES : Chargé de mission de classe exceptionnelle.<br/>\n<br/>  I = ECHELONS<br/>\n<br/> II = DUREE MOYENNE<br/>\n III = DUREE MINIMUM<br/>\n<br/>\n<table>\n<tr>\n<td> :---:----------:-------------:</td>\n</tr>\n<tr>\n<td> : I :   II     :       III   :</td>\n</tr>\n<tr>\n<td> :---:----------:-------------:</td>\n</tr>\n<tr>\n<td> : 7 :   3 ans  : 2 ans 3 mois:</td>\n</tr>\n<tr>\n<td> : 6 :   3 ans  : 2 ans 3 mois:</td>\n</tr>\n<tr>\n<td> : 5 :   3 ans  : 2 ans 3 mois:</td>\n</tr>\n<tr>\n<td> : 4 :   3 ans  : 2 ans 3 mois:</td>\n</tr>\n<tr>\n<td> : 3 :2 ans 6 ms:    2 ans    :</td>\n</tr>\n<tr>\n<td> : 2 :   2 ans  : 1 an 6 mois :</td>\n</tr>\n<tr>\n<td> : 1 :   2 ans  : 1 an 6 mois :</td>\n</tr>\n<tr>\n<td> :---:----------:-------------:</td>\n</tr>\n</table>\n<br/>\n<br/>\n<br/>\n GRADES ET CLASSES : Chargé de mission de classe normale.<br/>\n<br/>  I = ECHELONS<br/>\n<br/> II = DUREE MOYENNE<br/>\n III = DUREE MINIMUM<br/>\n<br/>\n<table>\n<tr>\n<td> :---:----------:-------------:</td>\n</tr>\n<tr>\n<td> : I :   II     :       III   :</td>\n</tr>\n<tr>\n<td> :---:----------:-------------:</td>\n</tr>\n<tr>\n<td> : 9 :   4 ans  :    3 ans    :</td>\n</tr>\n<tr>\n<td> : 8 :   3 ans  : 2 ans 3 mois:</td>\n</tr>\n<tr>\n<td> : 7 :   3 ans  : 2 ans 3 mois:</td>\n</tr>\n<tr>\n<td> : 6 :2 ans 6 ms:    2 ans    :</td>\n</tr>\n<tr>\n<td> : 5 :   2 ans  : 1 an 6 mois :</td>\n</tr>\n<tr>\n<td> : 4 :   2 ans  : 1 an 6 mois :</td>\n</tr>\n<tr>\n<td> : 3 :   2 ans  : 1 an 6 mois :</td>\n</tr>\n<tr>\n<td> : 2 :   1 an   :    1 an     :</td>\n</tr>\n<tr>\n<td> : 1 :   1 an   :    1 an     :</td>\n</tr>\n<tr>\n<td> :---:----------:-------------:</td>\n</tr>\n</table>\n<br/>"
  },

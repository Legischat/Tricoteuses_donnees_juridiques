            "@fin": "2000-09-21",
            "@id": "LEGISCTA000006093640"
          }
        ]
      },
      "@cid": "JORFTEXT000000675530",
      "@date_publi": "1953-10-01",
      "@date_signature": "1953-09-30",
      "@nature": "DECRET",
      "@num": "53-960"
    }
  },

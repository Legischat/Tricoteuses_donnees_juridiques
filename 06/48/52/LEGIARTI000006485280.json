      "TITRE_TXT": [
        {
          "#text": "Décret n°72-561 du 3 juillet 1972 MODIFIE ET COMPLETE LE D 53960 DU 30-09-1953 REGLANT LES RAPPORTS ENTRE BAILLEURS ET LOCATAIRES :",
          "@c_titre_court": "Décret n°72-561 du 3 juillet 1972",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000306770"
        },
        {
          "#text": "Décret n°72-561 du 3 juillet 1972 modifiant et complétant le décret n° 53-960 du 30 septembre 1953 réglant les rapports entre bailleurs et locataires en ce qui concerne le renouvellement des baux à loyer d'immeubles ou de locaux à usage commercial, industriel ou artisanal",
          "@c_titre_court": "Décret n°72-561 du 3 juillet 1972",
          "@debut": "1972-07-04",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006061959"
        }
      ],
      "@cid": "JORFTEXT000000306770",
      "@date_publi": "1972-07-04",

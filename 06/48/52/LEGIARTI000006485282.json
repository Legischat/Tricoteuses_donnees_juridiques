      "TITRE_TXT": [
        {
          "#text": "Décret n°65-374 du 18 mai 1965 PRIS POUR L'APPLICATION DE LA LOI 64645 DU 1 JUILLET 1964 ET INSTITUANT DANS CHAQUE DEPARTEMENT UNE COMMISSION SUR L'EXECUTION DES TRAVAUX D'EQUIPEMENT ET D'AMELIORATION",
          "@c_titre_court": "Décret n°65-374 du 18 mai 1965",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000311559"
        },
        {
          "#text": "Décret n°65-374 du 18 mai 1965 pris pour l'application de la loi n° 64-645 du 1er juillet 1964 modifiant les rapports entre bailleurs et locataires des immeubles affectés à l'hôtellerie",
          "@c_titre_court": "Décret n°65-374 du 18 mai 1965",
          "@debut": "1965-05-20",
          "@fin": "2006-10-07",
          "@id_txt": "LEGITEXT000006061271"
        }

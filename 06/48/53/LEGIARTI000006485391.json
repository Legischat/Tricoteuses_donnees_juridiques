  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les recettes de chaque institut comprennent notamment :<br/>\n<br/>   Les subventions ou contributions de l'Etat, des collectivités publiques ou des personnes privées ;<br/>\n<br/>   Les revenus des biens, fonds et valeurs ;<br/>\n<br/>   Les dons et legs faits au profit de l'établissement ;<br/>\n<br/>   Le produit de la vente des diverses publications de l'institut ;<br/>\n<br/>   Les produits de l'aliénation des biens, fonds et valeurs ;<br/>\n<br/>   Le produit des emprunts.<br/>"
  },

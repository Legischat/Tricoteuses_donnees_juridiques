  "BLOC_TEXTUEL": {
    "CONTENU": "<p>L'avancement d'échelon des inspecteurs est prononcé par arrêté du ministre chargé des affaires sociales et prend effet du jour où les intéressés remplissent les conditions fixées par le tableau ci-après :</p>\n<br/>\n<table border=\"2\" cellpadding=\"2\">\n<tbody>\n<tr>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">ECHELONS</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">DUREE MINIMALE</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"top\">\n<p align=\"justify\">8<sup>e</sup> échelon</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<pre> </pre>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"top\">\n<p align=\"justify\">7<sup>e</sup> échelon</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">3 ans</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"top\">\n<p align=\"justify\">6e échelon</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">2 ans</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"top\">\n<p align=\"justify\">5e échelon</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">2 ans</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"top\">\n<p align=\"justify\">4e échelon</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">2 ans</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"top\">\n<p align=\"justify\">3e échelon</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">2 ans</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"top\">\n<p align=\"justify\">2e échelon</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">2 ans</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"top\">\n<p align=\"justify\">1er échelon</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">2 ans</p>\n</td>\n</tr>\n</tbody>\n</table>\n<br/>"
  },

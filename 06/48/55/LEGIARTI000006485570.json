  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret n°82-716 du 10 août 1982 LES SECRETAIRES-GREFFIERS DES COURS ET TRIBUNAUX PRENNENT LE NOM DE GREFFIER,EN CONSEQUENCE,DANS TOUTE DISPOSITION REGLEMENTAIRE EN VIGUEUR,LE TERME DE \"GREFFIER\" EST SUBSTITUE A CELUI DE \"SERETAIRE-GREFFIER\"",
          "@c_titre_court": "Décret n°82-716 du 10 août 1982",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000881144"
        },
        {
          "#text": "Décret n°82-716 du 10 août 1982 modifiant le décret n° 67-472 du 20 juin 1967 portant statuts particuliers des greffiers en chef et des secrétaires-greffiers des cours et tribunaux.",
          "@c_titre_court": "Décret n°82-716 du 10 août 1982",
          "@debut": "1982-08-17",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006063868"
        }
      ],
      "@cid": "JORFTEXT000000881144",
      "@date_publi": "1982-08-17",
      "@date_signature": "1982-08-10",
      "@nature": "DECRET",
      "@num": "82-716"
    }
  },
  "VERSIONS": {
    "VERSION": [

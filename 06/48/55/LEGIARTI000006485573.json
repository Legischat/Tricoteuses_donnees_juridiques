      "TITRE_TXT": [
        {
          "#text": "Décret n°82-717 du 10 août 1982 LES SECRETAIRES-GREFFIERS DES CONSEILS DE PRUDHOMMES PRENNENT LE NOM DE GREFFIER,EN CONSEQUENCE DANS TOUTE DISPOSITION REGLEMENTAIRE EN VIGUEUR,LE TERME \"GREFFIER\" EST SUBSTITUE A CELUI DE \"SECRETAIRE-GREFFIER\"",
          "@c_titre_court": "Décret n°82-717 du 10 août 1982",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000699453"
        },
        {
          "#text": "Décret n°82-717 du 10 août 1982 modifiant le décret n° 79-1071 du 12 décembre 1979 portant statuts particuliers des greffiers en chef et des secrétaires-greffiers des conseils de prud'hommes.",
          "@c_titre_court": "Décret n°82-717 du 10 août 1982",

      "TITRE_TXT": [
        {
          "#text": "Décret n°85-1150 du 29 octobre 1985 RELATIF AUX MODALITES D'INTEGRATION DES OFFICIERS ET SOUS-OFFICIERS APPARTENANT RESPECTIVEMENT AUX CORPS DES OFFICIERS GREFFIERS,DES COMMIS GREFFIERS ET DES HUISSIERS APPARITEURS DE LA JUSTICE MILITAIRE,DANS LES CORPS DES GREFFIERS EN CHEF,DES GREFFIERS ET DES COMMIS DES COURS ET TRIBUNAUX",
          "@c_titre_court": "Décret n°85-1150 du 29 octobre 1985",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000872258"
        },
        {
          "#text": "Décret n°85-1150 du 29 octobre 1985 relatif aux modalités d'intégration des officiers et sous-officiers appartenant respectivement aux corps des officiers greffiers, des commis greffiers et des huissiers appariteurs de la justice militaire, dans les corps des greffiers en chef, des greffiers et des commis des cours et tribunaux",
          "@c_titre_court": "Décret n°85-1150 du 29 octobre 1985",
          "@debut": "1985-11-05",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006064739"
        }
      ],
      "@cid": "JORFTEXT000000872258",
      "@date_publi": "1985-11-05",

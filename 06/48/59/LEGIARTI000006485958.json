      "TITRE_TXT": [
        {
          "#text": "Décret n°86-588 du 14 mars 1986 RELATIF A LA CONTRIBUTION EXIGEE POUR LA CONSTITUTION DES DROITS A PENSION DES MILITAIRES DETACHES PREVUE PAR L'ART. 55 DE LA LOI 72662 DU 13-07-1972 PORTANT STATUT GENERAL DES MILITAIRES",
          "@c_titre_court": "Décret n°86-588 du 14 mars 1986",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000332941"
        },
        {
          "#text": "Décret n°86-588 du 14 mars 1986 relatif à la contribution exigée pour la constitution des droits à pension des militaires détachés prévue par l'article 55 de la loi n° 72-662 du 13 juillet 1972 portant statut général des militaires",
          "@c_titre_court": "Décret n°86-588 du 14 mars 1986",
          "@debut": "1986-04-01",
          "@fin": "2008-01-01",
          "@id_txt": "LEGITEXT000006065602"
        }
      ],
      "@cid": "JORFTEXT000000332941",
      "@date_publi": "1986-03-19",
      "@date_signature": "1986-03-14",
      "@nature": "DECRET",
      "@num": "86-588"
    }
  },

    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret n°79-1072 du 12 décembre 1979 MODALITES DE RECRUTEMENT D'AGENTS CONTRACTUELS DE CONSEILS DE PRUDHOMMES EN APPLICATION DE L'ARTICLE 7 DE LA LOI 79-44 DU 18 JANVIER 1979 RELATIVE AUX CONSEILS DE PRUDHOMMES ET PORTANT MODIFICATION DES DISPOSITIONS DU TITRE 1ER DU LIVRE V DU CODE DU TRAVAIL",
          "@c_titre_court": "Décret n°79-1072 du 12 décembre 1979",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000854600"
        },
        {
          "#text": "Décret n°79-1072 du 12 décembre 1979 relatif aux modalités de recrutement d'agents contractuels de conseil de prud'hommes en application de la loi n° 79-44 du 18 janvier 1979 portant modification des dispositions du titre Ier du livre V du code du travail relatives aux conseils de prud'hommes.",
          "@c_titre_court": "Décret n°79-1072 du 12 décembre 1979",
          "@debut": "1979-01-01",
          "@fin": "2999-01-01",

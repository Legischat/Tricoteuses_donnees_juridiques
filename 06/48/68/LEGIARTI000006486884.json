  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   La durée moyenne et la durée minimale du temps passé dans chaque échelon des grades et classes d'attaché de l'Office national interprofessionnel des céréales sont fixées conformément au tableau ci-dessous :<br/>\n<br/>\n I = GRADES ET ÉCHELONS : Attaché principal de 1re classe<br/>\n II = DURÉE MOYENNE<br/>\n III = DUREE MINIMALE<br/>\n<br/>\n<table>\n<tr>\n<td> :----:-------:--------------:</td>\n</tr>\n<tr>\n<td> : I  :  II   :      III     :</td>\n</tr>\n<tr>\n<td> :----:-------:--------------:</td>\n</tr>\n<tr>\n<td> : 3e : 3 ans : 2 ans 3 mois :</td>\n</tr>\n<tr>\n<td> : 2e : 2 ans : 1 an  6 mois :</td>\n</tr>\n<tr>\n<td> : 1e : 2 ans : 1 an  6 mois :</td>\n</tr>\n<tr>\n<td> :----:-------:--------------:</td>\n</tr>\n</table>\n<br/>\n<br/>\n I = GRADES ET ÉCHELONS : Attaché principal de 2e classe<br/>\n II = DURÉE MOYENNE<br/>\n III = DUREE MINIMALE<br/>\n<br/>\n<table>\n<tr>\n<td> :----:--------------:--------:</td>\n</tr>\n<tr>\n<td> : I  :      II      :  III   :</td>\n</tr>\n<tr>\n<td> :----:--------------:--------:</td>\n</tr>\n<tr>\n<td> : 5e : 3 ans :  2 ans 3 mois :</td>\n</tr>\n<tr>\n<td> : 4e : 2 ans 6 mois :  2 ans :</td>\n</tr>\n<tr>\n<td> : 3e : 2 ans 6 mois :  2 ans :</td>\n</tr>\n<tr>\n<td> : 2e : 2 ans 6 mois :  2 ans :</td>\n</tr>\n<tr>\n<td> : 1e :   1 an       :  1 an  :</td>\n</tr>\n<tr>\n<td> :----:--------------:--------:</td>\n</tr>\n</table>\n<br/>\n<br/>\n I = GRADES ET ÉCHELONS : Attaché<br/>\n II = DURÉE MOYENNE<br/>\n III = DUREE MINIMALE<br/>\n<br/>\n<table>\n<tr>\n<td> :-----:-------:--------------:</td>\n</tr>\n<tr>\n<td> :  I  :  II   :      III     :</td>\n</tr>\n<tr>\n<td> :-----:-------:--------------:</td>\n</tr>\n<tr>\n<td> : 11e : 4 ans :     3 ans    :</td>\n</tr>\n<tr>\n<td> : 10e : 3 ans : 2 ans 3 mois :</td>\n</tr>\n<tr>\n<td> :  9e : 3 ans : 2 ans 3 mois :</td>\n</tr>\n<tr>\n<td> :  8e : 3 ans : 2 ans 3 mois :</td>\n</tr>\n<tr>\n<td> :  7e : 3 ans : 2 ans 3 mois :</td>\n</tr>\n<tr>\n<td> : 6e : 2 ans 6 mois :  2 ans :</td>\n</tr>\n<tr>\n<td> :  5e : 2 ans : 1 an  6 mois :</td>\n</tr>\n<tr>\n<td> :  4e : 2 ans : 1 an  6 mois :</td>\n</tr>\n<tr>\n<td> :  3e : 2 ans : 1 an  6 mois :</td>\n</tr>\n<tr>\n<td> :  2e : 1 an  :     1 an     :</td>\n</tr>\n<tr>\n<td> :  1e : 1 an  :     1 an     :</td>\n</tr>\n<tr>\n<td> :-----:-------:--------------:</td>\n</tr>\n</table>\n<br/>"

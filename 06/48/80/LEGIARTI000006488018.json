    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret n°83-1176 du 28 décembre 1983 RENDANT OBLIGATOIRE EN APPLICATION DE L'ART. 54 DE LA LOI 82526 DU 22-06-1982 UN ACCORD DE MODERATION DES LOYERS CONCLU LE 03-10-1983 ENTRE LE 03-10-1983 ENTRE LES REPRESENTANTS DES ORGANISATIONS NATIONALES REPRESENTATIVES DES BAILLEURS ET LES REPRESENTANTS DES ORGANISATIONS NATIONALES REPRESENTATIVES DES LOCATAIRES (APPLICATION AUX LOGEMENTS DU 3EME SECTEUR)",
          "@c_titre_court": "Décret n°83-1176 du 28 décembre 1983",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000875800"
        },
        {
          "#text": "Décret n°83-1176 du 28 décembre 1983 rendant obligatoire en application de l'article 54 de la loi n° 82-526 du 22 juin 1982 un accord de modération des loyers",
          "@c_titre_court": "Décret n°83-1176 du 28 décembre 1983",

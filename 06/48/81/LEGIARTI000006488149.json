  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "LOI no 96-432 du 22 mai 1996 portant adaptation de la législation française    aux dispositions de la résolution 955 du Conseil de sécurité des Nations    unies instituant un tribunal international en vue de juger les personnes    présumées responsables d'actes de génocide ou d'autres violations graves du    droit international humanitaire commis en 1994 sur le territoire du Rwanda    et, s'agissant des citoyens rwandais, sur le territoire d'Etats voisins (1)",
          "@c_titre_court": "Loi n°96-432 du 22 mai 1996",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000742868"
        },
        {
          "#text": "Loi n° 96-432 du 22 mai 1996 portant adaptation de la législation française aux dispositions de la résolution 955 du Conseil de sécurité des Nations unies instituant un tribunal international en vue de juger les personnes présumées responsables d'actes de génocide ou d'autres violations graves du droit international humanitaire commis en 1994 sur le territoire du Rwanda et, s'agissant des citoyens rwandais, sur le territoire d'Etats voisins",

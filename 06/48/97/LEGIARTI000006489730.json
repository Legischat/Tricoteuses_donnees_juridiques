  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Sont soumis à l'obligation du visa consulaire de transit aéroportuaire les ressortissants des Etats suivants :<br/>\n<br/>   Afghanistan, Albanie, Angola, Bangladesh, Erythrée, Ethiopie, Ghana, Haïti, Irak, Iran, Liberia, Nigeria, Libye, Pakistan, Sierra Leone, Somalie, Sri Lanka, Zaïre.<br/>"
  },

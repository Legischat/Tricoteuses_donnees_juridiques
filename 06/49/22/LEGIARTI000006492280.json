      "TITRE_TXT": [
        {
          "#text": "Décret n°88-274 du 18 mars 1988 PORTANT APPLICATION DE L'ART. 41 DE LA LOI 861290 DU 23-12-1986 TENDANT A FAVORISER L'INVESTISSEMENT LOCATIF,L'ACCESSION A LA PROPRIETE DE LOGEMENTS SOCIAUX ET LE DEVELOPPEMENT DE L'OFFRE FONCIERE ET RELATIF A LA COMMISSION NATIONALE DE CONCERTATION",
          "@c_titre_court": "Décret n°88-274 du 18 mars 1988",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000315479"
        },
        {
          "#text": "Décret n°88-274 du 18 mars 1988 portant application de l'article 41 de la loi n° 86-1290 du 23 décembre 1986 tendant à favoriser l'investissement locatif, l'accession à la propriété de logements sociaux et le développement de l'offre foncière et relatif à la Commission nationale de concertation",
          "@c_titre_court": "Décret n°88-274 du 18 mars 1988",

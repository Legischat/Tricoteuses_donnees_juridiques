    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Loi du 29 novembre 1921 AUTORISANT LE CUMUL DES FONCTIONS DE GREFFIER DE JUSTICE DE PAIX ET D'HUISSIER ET REUNION DE PLUSIEURS GREFFES DANS LES MAINS D'UN MEME TITULAIRE",
          "@c_titre_court": "Loi du 29 novembre 1921",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000683992"
        },
        {
          "#text": "Loi du 29 novembre 1921 autorisant le cumul des fonctions de greffier de tribunal d'instance et d'huissier et la réunion de plusieurs greffes entre les mains d'un même titulaire.",
          "@c_titre_court": "Loi du 29 novembre 1921",
          "@debut": "1921-12-01",
          "@fin": "2007-12-22",
          "@id_txt": "LEGITEXT000006071037"
        }

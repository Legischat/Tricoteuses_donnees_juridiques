          "#text": "Loi n°51-18 du 5 janvier 1951 NOUVEAU REGIME D'AMNISTIE",
          "@c_titre_court": "Loi n°51-18 du 5 janvier 1951",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",

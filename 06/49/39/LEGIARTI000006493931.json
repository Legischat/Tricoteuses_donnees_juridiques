      "TITRE_TXT": [
        {
          "#text": "Loi n°71-1029 du 24 décembre 1971 RELATIVE A LA RECONSTITUTION DE REGISTRES OU DOCUMENTS CONSERVES DANS LES GREFFES DE TRIBUNAUX DE COMMERCE OU D'AUTRES JURIDICTIONS EN CAS DE DESTRUCTION OU DE DISPARITION TOTALE OU PARTIELLE DES ARCHIVES DE CES GREFFES",
          "@c_titre_court": "Loi n°71-1029 du 24 décembre 1971",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000874700"
        },
        {
          "#text": "Loi n° 71-1029 du 24 décembre 1971 relative à la reconstitution de registres ou documents conservés dans les greffes de tribunaux de commerce ou d'autres juridictions en cas de destruction ou de disparition totale ou partielle des archives de ces greffes (1).",
          "@c_titre_court": "Loi n° 71-1029 du 24 décembre 1971",
          "@debut": "1971-12-25",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006068391"
        }
      ],

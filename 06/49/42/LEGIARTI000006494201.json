  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Loi n°51-144 du 11 février 1951 ABROGEANT TOUTES DISPOSITIONS QUI, EN MATIERE DE DROIT COMMUN SUPPRIMENT OU LIMITENT LE DROIT QUI APPARTIENT AUX JUGES D'ACCORDER LE SURSIS AUX PEINES QU'ILS PRONONCENT ET DE FAIRE BENEFICIER LE COUPABLE DE CIRCONSTANCES ATTENUANTES",
          "@c_titre_court": "Loi n°51-144 du 11 février 1951",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000886660"
        },
        {
          "#text": "Loi n° 51-144 du 11 février 1951 abrogeant les dispositions législatives qui en matière de droit commun suppriment ou limitent le droit qui appartient aux juges d'accorder le sursis aux peines qu'ils prononcent et de faire bénéficier le coupable de circonstances atténuantes.",
          "@c_titre_court": "Loi n° 51-144 du 11 février 1951",
          "@debut": "1951-02-13",
          "@fin": "2022-02-16",
          "@id_txt": "LEGITEXT000006068086"
        }
      ],
      "@cid": "JORFTEXT000000886660",
      "@date_publi": "1951-02-13",
      "@date_signature": "1951-02-11",
      "@nature": "LOI",
      "@num": "51-144"
    }
  },
  "VERSIONS": {
    "VERSION": [
      {
        "LIEN_ART": {
          "@debut": "1951-02-13",
          "@etat": "ABROGE",
          "@fin": "2022-02-16",
          "@id": "LEGIARTI000006494201",
          "@num": "1",
          "@origine": "LEGI"
        },
        "@etat": "ABROGE"
      }
    ]
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Toutes les dispositions des lois, décrets ou ordonnances qui ont pour objet de restreindre ou de supprimer la faculté donnée aux juges par l'article 463 du code pénal de reconnaître l'existence en faveur du coupable de circonstances atténuantes ou de lui accorder le bénéfice du sursis prévu par la loi du 26 mars 1891, sont abrogées.<br/>\n<br/>"
  },

  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Le Conseil d'Etat se compose de :<br/>\n<br/>   1° Un vice-président ;<br/>\n<br/>   2° Cinq présidents de section ;<br/>\n<br/>   3° Quarante-deux conseillers d'Etat en service ordinaire ; <br/>\n<br/>   4° Douze conseillers d'Etat en service extraordinaire ;<br/>\n<br/>   5° Quarante-cinq maîtres des requêtes ;<br/>\n<br/>   6° Quarante-quatre auditeurs, dont vingt de 1ère classe et vingt-quatre de 2e classe.<br/>"
  },

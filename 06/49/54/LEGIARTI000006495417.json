  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Ordonnance n° 96-267 du 28 mars 1996 relative à l'entrée en vigueur du    nouveau code pénal dans les territoires d'outre-mer et dans la collectivité    territoriale de Mayotte ainsi qu'à l'extension et à la modification de    certaines dispositions législatives rendues nécessaires par cette entrée en vigueur",
          "@c_titre_court": "Ordonnance n° 96-267 du 28 mars 1996",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000193176"
        },
        {

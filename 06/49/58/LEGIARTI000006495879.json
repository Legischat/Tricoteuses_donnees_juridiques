  "NOTA": {
    "CONTENU": "<br/>   *Décret 90-166 1990-02-21 art. 4 : \" Dans tous les textes réglementaires, les mots : \" l'éducation surveillée \" sont remplacés par les mots : \" la protection judiciaire de la jeunesse \".<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les directions départementales de l'éducation surveillée sont dirigées par des directeurs départementaux de l'éducation surveillée qui ont autorité sur l'ensemble des établissements et autres unités éducatives du secteur public de l'éducation surveillée implantés dans un même département.<br/>\n<br/>"
  },

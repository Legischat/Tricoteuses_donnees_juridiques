    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret n°89-636 du 8 septembre 1989 PRIS POUR L'APPLICATION DE LA LOI 89378 DU 13-06-1989 RELATIF A L'ORGANISATION JUDICIAIRE EN NOUVELLE-CALEDONIE ET DES ILES WALLIS-ET-FUTUNA LE SIEGE ET LE RESSORT DE LA COUR D'APPEL,DES TRIBUNAUX DE PREMIERE INSTANCE ET DES SECTIONS DETACHEES DES TRIBUNAUX DE PREMIERE INSTANCE",
          "@c_titre_court": "Décret n°89-636 du 8 septembre 1989",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000700388"
        },
        {
          "#text": "Décret n°89-636 du 8 septembre 1989 pris pour l'application de la loi n° 89-378 du 13 juin 1989 relatif à l'organisation judiciaire en Nouvelle-Calédonie et fixant dans les territoires de la Nouvelle-Calédonie et des îles Wallis et Futuna le siège et le ressort de la cour d'appel, des tribunaux de première instance et des sections détachées des tribunaux de première instance",
          "@c_titre_court": "Décret n°89-636 du 8 septembre 1989",
          "@debut": "1989-09-09",
          "@fin": "1993-07-28",
          "@id_txt": "LEGITEXT000006067243"
        }
      ],

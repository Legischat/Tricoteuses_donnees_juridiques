  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   La cour d'appel comprend :<br/>\n<br/>   Un procureur général, chef du service judiciaire ;<br/>\n<br/>   Un président ;<br/>\n<br/>   Deux conseillers ;<br/>\n<br/>   Un substitut du procureur général ;<br/>\n<br/>   Un greffier, qui remplit les mêmes fonctions auprès du tribunal de première instance avec l'assistance de commis greffiers.<br/>"
  },

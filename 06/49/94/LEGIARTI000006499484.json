  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   La Cour de cassation comprend :<br/>\n<br/>   Le premier président ;<br/>\n<br/>   Six présidents de chambre ;<br/>\n<br/>   Quatre-vingt-cinq conseillers ;<br/>\n<br/>   Seize conseillers référendaires appartenant au second groupe du premier grade ;<br/>\n<br/>   Trente-deux conseillers référendaires appartenant au second grade ;<br/>\n<br/>   Le procureur général ;<br/>\n<br/>   Le premier avocat général ;<br/>\n<br/>   Vingt-deux avocats généraux.<br/>"
  },

      "TITRE_TXT": [
        {
          "#text": "Décret n°70-1099 du 23 novembre 1970 RELATIF A L'APPLICATION DANS LES COLLECTIVITES LOCALES ET LEURS ETABLISSEMENTS PUBLICS DES DISPOSITIONS DE L'ART. 3 DE LA LOI 702 DU 02-01- 1970 TENDANT A FACILITER L'ACCES DES OFFICIERS A DES EMPLOIS CIVILS",
          "@c_titre_court": "Décret n°70-1099 du 23 novembre 1970",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000306033"
        },
        {
          "#text": "Décret n°70-1099 du 23 novembre 1970 relatif à l'application dans les collectivités locales et leurs établissements publics des dispositions de l'article 3 de la loi n° 70-2 du 2 janvier 1970 tendant à faciliter l'accès des officiers à des emplois civils.",
          "@c_titre_court": "Décret n°70-1099 du 23 novembre 1970",
          "@debut": "1970-12-03",
          "@fin": "2007-01-01",
          "@id_txt": "LEGITEXT000006061707"
        }
      ],

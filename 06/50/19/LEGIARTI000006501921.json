        {
          "#text": "Décret n°71-631 du 28 juillet 1971 RELATIF A L'INDEMNITE DE LOGEMENT SUSCEPTIBLE D'ETRE ALLOUEE AUX INSPECTEURS PRINCIPAUX ET INSPECTEURS DE LA JEUNESSE, DES SPORTS ET DES LOISIRS.",
          "@c_titre_court": "Décret n°71-631 du 28 juillet 1971",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000335913"
        },
        {
          "#text": "Décret n°71-631 du 28 juillet 1971 portant attribution d'une indemnité de logement à certains personnels relevant du ministère chargé de la jeunesse et des sports.",
          "@c_titre_court": "Décret n°71-631 du 28 juillet 1971",
          "@debut": "1994-07-01",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006061841"
        }
      ],

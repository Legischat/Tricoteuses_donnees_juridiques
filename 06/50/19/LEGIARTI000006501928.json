  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret n°72-887 du 28 septembre 1972 FIXE LE REGIME DES INDEMNITES ALLOUEES AUX CHEFS DES SERVICES ECONOMIQUES DES ETABLISSEMENTS D'ENSEIGNEMENT RELEVANT DU MINISTERE DE L'EDUCATION NATIONALE.",
          "@c_titre_court": "Décret n°72-887 du 28 septembre 1972",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000303839"
        },
        {
          "#text": "Décret n°72-887 du 28 septembre 1972 fixant le régime des indemnités allouées aux agents comptables et gestionnaires des établissements d'enseignement.",
          "@c_titre_court": "Décret n°72-887 du 28 septembre 1972",
          "@debut": "1972-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006062000"
        }
      ],
      "TM": {
        "TITRE_TM": [
          {
            "#text": "Chapitre I : Indemnité de gestion.",
            "@debut": "1972-01-01",
            "@fin": "2999-01-01",
            "@id": "LEGISCTA000006094633"
          }
        ]
      },
      "@cid": "JORFTEXT000000303839",
      "@date_publi": "1972-10-01",
      "@date_signature": "1972-09-28",
      "@nature": "DECRET",
      "@num": "72-887"
    }
  },

  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les chirurgiens-dentistes des armées constituent un corps d'officiers de carrière dont la hiérarchie particulière comporte les grades suivants :<br/>\n<br/>   - chirurgien-dentiste ;<br/>\n<br/>   - chirurgien-dentiste principal ;<br/>\n<br/>   - chirurgien-dentiste en chef ;<br/>\n<br/>   - chirurgien-dentiste chef des services.<br/>\n<br/>   Le grade de chirurgien-dentiste chef des services comporte deux classes : la classe normale et la hors-classe.<br/>"
  },

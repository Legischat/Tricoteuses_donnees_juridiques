      "TITRE_TXT": [
        {
          "#text": "Décret n°56-585 du 12 juin 1956 PORTANT FIXATION DU SYSTEME GENERAL DE RETRIBUTION DES AGENTS DE L'ETAT OU DES PERSONNELS NON FONCTIONNAIRES ASSURANT A TITRE D'OCCUPATION ACCESSOIRE SOIT UNE TACHE D'ENSEIGNEMENT,SOIT LE FONCTIONNEMENT DE JURYS D'EXAMENS OU DE CONCOURS",
          "@c_titre_court": "Décret n°56-585 du 12 juin 1956",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000876917"
        },
        {
          "#text": "Décret n°56-585 du 12 juin 1956 portant fixation du système général de rétribution des agents de l'Etat ou des personnels non fonctionnaires assurant à titre d'occupation accessoire soit une tâche d'enseignement, soit le fonctionnement de jurys d'examens ou de concours.",
          "@c_titre_court": "Décret n°56-585 du 12 juin 1956",
          "@debut": "1956-01-01",
          "@fin": "2011-09-01",
          "@id_txt": "LEGITEXT000006060773"
        }
      ],

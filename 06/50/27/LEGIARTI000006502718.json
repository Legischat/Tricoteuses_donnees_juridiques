      "TITRE_TXT": [
        {
          "#text": "Décret n°68-536 du 23 mai 1968 FIXANT LA REMUNERATION DES PERSONNES ASSURANT LE FONCTIONNEMENT DES COURS ET CENTRES DE PERFECTIONNEMENT CONDUISANT A LA PROMOTION SOCIALE OUVERTS DANS LES ETABLISSEMENTS D'ENSEIGNEMENT PUBLICS",
          "@c_titre_court": "Décret n°68-536 du 23 mai 1968",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000336105"
        },
        {
          "#text": "Décret n°68-536 du 23 mai 1968 fixant la rémunération des personnes assurant le fonctionnement des cours et centres de perfectionnement conduisant à la promotion sociale ouverts dans des établissements d'enseignement public.",
          "@c_titre_court": "Décret n°68-536 du 23 mai 1968",
          "@debut": "1968-06-09",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006061568"
        }
      ],
      "@cid": "JORFTEXT000000336105",
      "@date_publi": "1968-06-09",

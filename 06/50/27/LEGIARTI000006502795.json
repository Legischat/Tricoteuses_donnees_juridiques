  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Le personnel de direction comprend, outre le directeur de l'Ecole nationale d'administration soumis aux dispositions relatives aux directeurs des administrations centrales et aux dispositions de l'ordonnance susvisée du 9 octobre 1945 :<br/>\n<br/>   Le directeur adjoint chargé de la recherche et de la formation permanente ;<br/>\n<br/>   Le directeur des études ;<br/>\n<br/>   Le directeur des stages ;<br/>\n<br/>   Le directeur adjoint des études ;<br/>\n<br/>   Le directeur adjoint des stages.<br/>"
  },

  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret n°60-714 du 20 juillet 1960 TENDANT A L'ATTRIBUTION A CERTAINS PERSONNELS DU GCR QUI EFFECTUENT LEUR TRAVAIL NORMAL DE NUIT UNE MAJORATION SPECIALE POUR TRAVAIL INTENSIF",
          "@c_titre_court": "Décret n°60-714 du 20 juillet 1960",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000522086"
        },
        {
          "#text": "Décret n°60-714 du 20 juillet 1960 tendant à l'attribution à certains personnels du groupement des contrôles radio-électriques qui effectuent leur travail normal de nuit une majoration spéciale pour travail intensif.",
          "@c_titre_court": "Décret n°60-714 du 20 juillet 1960",
          "@debut": "1960-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006060978"
        }
      ],
      "@cid": "JORFTEXT000000522086",
      "@date_publi": "1960-07-24",
      "@date_signature": "1960-07-20",
      "@nature": "DECRET",
      "@num": "60-714"
    }
  },
  "VERSIONS": {
    "VERSION": [
      {
        "LIEN_ART": {
          "@debut": "1960-01-01",
          "@etat": "VIGUEUR",
          "@fin": "2999-01-01",
          "@id": "LEGIARTI000006502977",
          "@num": "1",
          "@origine": "LEGI"
        },
        "@etat": "VIGUEUR"
      }
    ]
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les personnels du groupement des contrôles radio électriques qui, entre vingt et une heures et six heures, effectuent un travail intensif peuvent bénéficier d'une majoration de 0,05 NF par heure de l'indemnité horaire pour travail de nuit fixée par le décret n° 55-11 du 4 janvier 1955 susvisé.<br/>\n<br/>   Les personnels des groupements des contrôles radio-électriques sont désormais rattachés au ministère chargé de la défense. Par ailleurs, le taux de majoration spéciale pour travail intensif de nuit est désormais fixé par le décret n° 61-467 du 10 mai 1961 modifié par le décret n° 76-208 du 24 février 1976 et par l'arrêté de taux pris pour son application.<br/>"
  },

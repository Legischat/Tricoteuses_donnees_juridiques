      "TITRE_TXT": [
        {
          "#text": "Décret n°82-464 du 2 juin 1982 LES DISPOSITIONS DU DECRET 621389 DU 23-11-1962 RELATIVES A L'ATTRIBUTION D'UNE INDEMNITE DIFFERENTIELLE SONT ETENDUES AUX TECHNICIENS D'ETUDES ET DE TRAVAUX DE L'AVIATION CIVILE ET DE LA METEOROLOGIE",
          "@c_titre_court": "Décret n°82-464 du 2 juin 1982",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000879748"
        },
        {
          "#text": "Décret n°82-464 du 2 juin 1982 relatif à l'octroi d'une indemnité différentielle à certains techniciens d'études et de travaux de l'aviation civile et de la météorologie.",
          "@c_titre_court": "Décret n°82-464 du 2 juin 1982",
          "@debut": "1982-06-05",

      "TITRE_TXT": [
        {
          "#text": "Décret n°72-430 du 24 mai 1972 PORTANT ATTRIBUTION D'UNE INDEMNITE POUR TRAVAIL DOMINICAL PERMANENT A CERTAINS PERSONNELS DE SURVEILLANCE ET DE GARDIENNAGE RELEVANT DU MINISTERE DE L'EDUCATION NATIONALE",
          "@c_titre_court": "Décret n°72-430 du 24 mai 1972",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000495330"
        },
        {
          "#text": "Décret n°72-430 du 24 mai 1972 relatif à l'attribution d'une indemnité pour travail dominical permanent à certains personnels de surveillance et de gardiennage relevant du ministère de l'éducation nationale.",
          "@c_titre_court": "Décret n°72-430 du 24 mai 1972",
          "@debut": "1970-01-01",
          "@fin": "2999-01-01",

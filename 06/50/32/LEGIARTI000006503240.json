          "@id_txt": "JORFTEXT000000875907"
        },
        {
          "#text": "Décret n°77-1445 du 21 décembre 1977 portant attribution d'une indemnité spéciale forfaitaire et dégressive à certains fonctionnaires chargés des fonctions de secrétaire général d'université.",
          "@c_titre_court": "Décret n°77-1445 du 21 décembre 1977",
          "@debut": "1977-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006062613"

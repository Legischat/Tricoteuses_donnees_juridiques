        {
          "#text": "Décret n°85-1145 du 28 octobre 1985 RELATIF AUX CONDITIONS DE REMUNERATION DES PERSONNELS ENSEIGNANTS ASSOCIES OU INVITES DANS LES ETABLISSEMENTS D'ENSEIGNEMENT SUPERIEUR ET DE RECHERCHE RELEVANT DU MINISTRE DE L'EDUCATION NATIONALE",
          "@c_titre_court": "Décret n°85-1145 du 28 octobre 1985",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000690432"
        },
        {
          "#text": "Décret n°85-1145 du 28 octobre 1985 relatif aux conditions de rémunération des personnels enseignants associés ou invités dans les établissements d'enseignement supérieur et de recherche relevant du ministre de l'éducation nationale.",
          "@c_titre_court": "Décret n°85-1145 du 28 octobre 1985",

      "TITRE_TXT": [
        {
          "#text": "Décret n°68-929 du 24 octobre 1968 RELATIF A L'ATTRIBUTION DE PRIMES DE SERVICE AUX PERSONNELS DES ETABLISSEMENTS NATIONAUX DE BIENFAISANCE, DES HOPITAUX PSYCHIATRIQUES AUTONOMES ET DES INSTITUTS NATIONAUX DE JEUNES SOURDS ET DE JEUNES AVEUGLES",
          "@c_titre_court": "Décret n°68-929 du 24 octobre 1968",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000853166"
        },
        {
          "#text": "Décret n°68-929 du 24 octobre 1968 relatif à l'attribution de primes de service aux personnels des établissements nationaux de bienfaisance, des hôpitaux psychiatriques autonomes et des instituts nationaux de jeunes sourds et de jeunes aveugles.",
          "@c_titre_court": "Décret n°68-929 du 24 octobre 1968",
          "@debut": "1967-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006061594"
        }
      ],
      "@cid": "JORFTEXT000000853166",

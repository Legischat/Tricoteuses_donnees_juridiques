      "TITRE_TXT": [
        {
          "#text": "Décret n°63-1122 du 9 novembre 1963 ABROGATION DU DECRET 452346 DU 13-10-1945 PORTANT CREATION AU MINISTERE DE L'ECONOMIE NATIONALE D'UN SERVICE D'EXPERTISE ECONOMIQUE D'ETAT, DU DECRET 54167 DU 16-02-1954 ET DES ART. 2 ET 5 DU DECRET 551014 DU 01-08-1955 SUR LE STATUT PARTICULIER DES COMMISSAIRES AUX PRIX",
          "@c_titre_court": "Décret n°63-1122 du 9 novembre 1963",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000704038"
        },
        {
          "#text": "Décret n°63-1122 du 9 novembre 1963 complétant et modifiant le décret n° 55-1014 du 1er août 1955, modifié par le décret n° 59-409 du 10 mars 1959, relatif au statut particulier des commissaires aux prix.",
          "@c_titre_court": "Décret n°63-1122 du 9 novembre 1963",

  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret n°86-613 du 14 mars 1986 RELATIF A L'UTILISATION DES LISTES COMPLEMENTAIRES D'ADMISSION POUR LE RECRUTEMENT PAR VOIE DE CONCOURS DES PERSONNELS APPARTENANT AU CORPS D'INGENIEURS,DE PERSONNELS TECHNIQUES ET DE PERSONNELS ADMINISTRATIFS DE LA RECHERCHE DU CENTRE NATIONAL DE LA RECHERCHE SCIENTIFIQUE (CNRS)",
          "@c_titre_court": "Décret n°86-613 du 14 mars 1986",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000704222"
        },
        {
          "#text": "Décret n°86-613 du 14 mars 1986 relatif à l'utilisation des listes complémentaires d'admission pour le recrutement par voie de concours des personnels appartenant aux corps d'ingénieurs, de personnels techniques et de personnels administratifs de la recherche du Centre national de la recherche scientifique.",
          "@c_titre_court": "Décret n°86-613 du 14 mars 1986",
          "@debut": "1986-03-19",
          "@fin": "2005-08-25",
          "@id_txt": "LEGITEXT000006065616"
        }
      ],
      "@cid": "JORFTEXT000000704222",
      "@date_publi": "1986-03-19",
      "@date_signature": "1986-03-14",
      "@nature": "DECRET",
      "@num": "86-613"
    }
  },

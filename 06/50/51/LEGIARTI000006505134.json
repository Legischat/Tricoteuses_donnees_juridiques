  "BLOC_TEXTUEL": {
    "CONTENU": "<p>Les intéressés sont classés dans le grade d'inspecteur principal de 2e classe conformément au tableau ci-dessous.<br/>\n<br/>\n</p>\n<table align=\"center\" border=\"2\" cellpadding=\"2\">\n<tbody>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">\n<strong>SITUATION<br/>\n</strong>ancienne dans le grade d'inspecteur</p>\n</td>\n<td align=\"left\" colspan=\"2\" valign=\"middle\">\n<p align=\"center\">\n<strong>SITUATION NOUVELLE<br/>\n</strong>dans le grade d'inspecteur principal de 2e classe</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">Echelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">Echelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">Ancienneté</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">12e</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">6e</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">Sans ancienneté</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">11e</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">5e</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">3/4 de l'ancienneté acquise</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">10e</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">4e</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">5/6 de l'ancienneté acquise</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">9e</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">3e</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">1/2 de l'ancienneté acquise, majorée de 1 an</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">8e</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">3e</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">1/3 de l'ancienneté acquise</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">7e</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">2e</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">1/3 de l'ancienneté acquise</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">6e</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">1er</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">5/6 de l'ancienneté acquise au-delà de 1 an 6 mois</p>\n</td>\n</tr>\n</tbody>\n</table>\n<p>\n<br/>\n<br/>\n</p>"
  },

  "BLOC_TEXTUEL": {
    "CONTENU": "<p>Les chargés d'éducation populaire et de jeunesse de classe exceptionnelle sont reclassés dans les conditions suivantes :</p>\n<br/>\n<table align=\"center\" border=\"1\" cellpadding=\"0\" cellspacing=\"1\">\n<tbody>\n<tr>\n<td>\n<p align=\"center\">SITUATION ANCIENNE</p>\n</td>\n<td>\n<p align=\"center\">SITUATION NOUVELLE</p>\n</td>\n<td>\n<p align=\"center\">ANCIENNETE DANS L'ECHELON</p>\n</td>\n</tr>\n<tr>\n<td>\n<p>1er échelon</p>\n</td>\n<td>\n<p>1er échelon</p>\n</td>\n<td>\n<p>Ancienneté acquise.</p>\n</td>\n</tr>\n<tr>\n<td>\n<p>2e échelon</p>\n</td>\n<td>\n<p>2e échelon</p>\n</td>\n<td>\n<p>7/8 de l’ancienneté acquise.</p>\n</td>\n</tr>\n<tr>\n<td>\n<p>3e échelon :</p>\n</td>\n<td/>\n<td/>\n</tr>\n<tr>\n<td>\n<p>- avant 4 ans</p>\n</td>\n<td>\n<p>3e échelon</p>\n</td>\n<td>\n<p>Ancienneté acquise.</p>\n</td>\n</tr>\n<tr>\n<td>\n<p>- à partir de 4 ans</p>\n</td>\n<td>\n<p>4<sup>e</sup> échelon</p>\n</td>\n<td>\n<p>Sans ancienneté.</p>\n</td>\n</tr>\n<tr>\n<td>\n<p>4e échelon</p>\n</td>\n<td>\n<p>4<sup>e</sup> échelon</p>\n</td>\n<td>\n<p>Ancienneté acquise dans la limite de 4 ans.</p>\n</td>\n</tr>\n</tbody>\n</table>\n<br/>\n<br/>\n<br/>"
  },

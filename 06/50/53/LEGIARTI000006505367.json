  "NOTA": {
    "CONTENU": "<br/>   NOTA : Décret 2006-1465 du 27 novembre 2006 art. 15 : Sous réserve des dispositions de l'article 9 du présent décret, le décret n° 97-994 du 28 octobre 1997 est abrogé.<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   La durée moyenne et la durée minimale du temps passé dans chacun des échelons des grades et classes du corps sont fixées ainsi qu'il suit :<br/>\n<br/>\n I   = GRADES ET ÉCHELONS : Attaché principal de 1re classe<br/>\n II  = DUREE MOYENNE<br/>\n III = DUREE MINIMALE<br/>\n<br/>\n<table>\n<tr>\n<td> :----:-------:--------------:</td>\n</tr>\n<tr>\n<td> :  I :   II  :      III     :</td>\n</tr>\n<tr>\n<td> :----:-------:--------------:</td>\n</tr>\n<tr>\n<td> : 3e : 3 ans : 2 ans 3 mois :</td>\n</tr>\n<tr>\n<td> : 2e : 3 ans : 2 ans 3 mois :</td>\n</tr>\n<tr>\n<td> : 1e : 2 ans 6 mois : 2 ans :</td>\n</tr>\n<tr>\n<td> :----:-------:--------------:</td>\n</tr>\n</table>\n<br/>\n<br/>\n I   = GRADES ET ÉCHELONS Attaché principal de 2eme classe<br/>\n II  = DUREE MOYENNE<br/>\n III = DUREE MINIMALE<br/>\n<br/>\n<table>\n<tr>\n<td> :----:-----------:------------:</td>\n</tr>\n<tr>\n<td> :  I :     II    :    III     :</td>\n</tr>\n<tr>\n<td> :----:-----------:------------:</td>\n</tr>\n<tr>\n<td> : 5e :3 ans 6 ms : 2 ans 9 ms :</td>\n</tr>\n<tr>\n<td> : 4e :  3 ans    : 2 ans 3 ms :</td>\n</tr>\n<tr>\n<td> : 3e :  3 ans    : 2 ans 3 ms :</td>\n</tr>\n<tr>\n<td> : 2e :2 ans 6 ms : 2 ans      :</td>\n</tr>\n<tr>\n<td> : 1e :  1 an     :            :</td>\n</tr>\n<tr>\n<td> :----:-----------:------------:</td>\n</tr>\n</table>\n<br/>\n<br/>\n I   = GRADES ET ÉCHELONS : Attaché<br/>\n II  = DUREE MOYENNE<br/>\n III = DUREE MINIMALE<br/>\n<br/>\n<table>\n<tr>\n<td> :----:-----------:------------:</td>\n</tr>\n<tr>\n<td> :  I :     II    :    III     :</td>\n</tr>\n<tr>\n<td> :----:-----------:------------:</td>\n</tr>\n<tr>\n<td> : 11e: 4 ans     : 3 ans      :</td>\n</tr>\n<tr>\n<td> : 10 : 3 ans     : 2 ans 3 ms :</td>\n</tr>\n<tr>\n<td> : 9e : 3 ans     : 2 ans 3 ms :</td>\n</tr>\n<tr>\n<td> : 8e : 3 ans     : 2 ans 3 ms :</td>\n</tr>\n<tr>\n<td> : 7e : 3 ans     : 2 ans 3 ms :</td>\n</tr>\n<tr>\n<td> : 6e : 2 ans 6 ms: 2 ans      :</td>\n</tr>\n<tr>\n<td> : 5e : 2 ans     : 1 an  6 ms :</td>\n</tr>\n<tr>\n<td> : 4e : 2 ans     : 1 an  6 ms :</td>\n</tr>\n<tr>\n<td> : 3e : 2 ans     : 1 an  6 ms :</td>\n</tr>\n<tr>\n<td> : 2e : 1 an      :            :</td>\n</tr>\n<tr>\n<td> : 1e : 1 an      :            :</td>\n</tr>\n<tr>\n<td> :----:-----------:------------:</td>\n</tr>\n</table>\n<br/>"
  },

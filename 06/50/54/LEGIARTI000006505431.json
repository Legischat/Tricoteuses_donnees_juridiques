  "BLOC_TEXTUEL": {
    "CONTENU": "<p>La durée moyenne et la durée minimale du temps passé dans chacun des échelons des grades et classes du corps de délégué au permis de conduire et à la sécurité routière sont fixées conformément au tableau ci-dessous :</p>\n<table align=\"center\" border=\"1\" cellpadding=\"0\" cellspacing=\"0\">\n<tbody>\n<tr>\n<td rowspan=\"2\" width=\"132\">\n<p align=\"center\">GRADES ET CLASSES</p>\n</td>\n<td rowspan=\"2\" width=\"67\">\n<p align=\"center\">ÉCHELONS</p>\n</td>\n<td colspan=\"2\" width=\"179\">\n<p align=\"center\">DURÉE</p>\n</td>\n</tr>\n<tr>\n<td width=\"89\">\n<p align=\"center\">Moyenne</p>\n</td>\n<td width=\"90\">\n<p align=\"center\">Minimale</p>\n</td>\n</tr>\n<tr>\n<td rowspan=\"3\" valign=\"top\" width=\"132\">\n<p>Délégué principal de 1re classe</p>\n</td>\n<td width=\"67\">\n<p align=\"center\">3e</p>\n</td>\n<td width=\"89\">\n<p align=\"center\">3 ans</p>\n</td>\n<td width=\"90\">\n<p align=\"center\">2 ans 3 mois</p>\n</td>\n</tr>\n<tr>\n<td width=\"67\">\n<p align=\"center\">2e</p>\n</td>\n<td width=\"89\">\n<p align=\"center\">3 ans</p>\n</td>\n<td width=\"90\">\n<p align=\"center\">2 ans 3 mois</p>\n</td>\n</tr>\n<tr>\n<td width=\"67\">\n<p align=\"center\">1er</p>\n</td>\n<td width=\"89\">\n<p align=\"center\">2 ans 6 mois</p>\n</td>\n<td width=\"90\">\n<p align=\"center\">2 ans</p>\n</td>\n</tr>\n<tr>\n<td rowspan=\"5\" valign=\"top\" width=\"132\">\n<p>Délégué principal de 2e classe</p>\n</td>\n<td width=\"67\">\n<p align=\"center\">5e</p>\n</td>\n<td width=\"89\">\n<p align=\"center\">3 ans</p>\n</td>\n<td width=\"90\">\n<p align=\"center\">2 ans 3 mois</p>\n</td>\n</tr>\n<tr>\n<td width=\"67\">\n<p align=\"center\">4e</p>\n</td>\n<td width=\"89\">\n<p align=\"center\">2 ans 6 mois</p>\n</td>\n<td width=\"90\">\n<p align=\"center\">2 ans</p>\n</td>\n</tr>\n<tr>\n<td width=\"67\">\n<p align=\"center\">3e</p>\n</td>\n<td width=\"89\">\n<p align=\"center\">2 ans 6 mois</p>\n</td>\n<td width=\"90\">\n<p align=\"center\">2 ans</p>\n</td>\n</tr>\n<tr>\n<td width=\"67\">\n<p align=\"center\">2e</p>\n</td>\n<td width=\"89\">\n<p align=\"center\">2 ans 6 mois</p>\n</td>\n<td width=\"90\">\n<p align=\"center\">2 ans</p>\n</td>\n</tr>\n<tr>\n<td width=\"67\">\n<p align=\"center\">1er</p>\n</td>\n<td width=\"89\">\n<p align=\"center\">1 an</p>\n</td>\n<td width=\"90\">\n<p align=\"center\">1 an</p>\n</td>\n</tr>\n<tr>\n<td rowspan=\"11\" valign=\"top\" width=\"132\">\n<p>Délégué </p>\n</td>\n<td width=\"67\">\n<p align=\"center\">11e</p>\n</td>\n<td width=\"89\">\n<p align=\"center\">4 ans</p>\n</td>\n<td width=\"90\">\n<p align=\"center\">3 ans</p>\n</td>\n</tr>\n<tr>\n<td width=\"67\">\n<p align=\"center\">10e</p>\n</td>\n<td width=\"89\">\n<p align=\"center\">3 ans</p>\n</td>\n<td width=\"90\">\n<p align=\"center\">2 ans 3 mois</p>\n</td>\n</tr>\n<tr>\n<td width=\"67\">\n<p align=\"center\">9e</p>\n</td>\n<td width=\"89\">\n<p align=\"center\">3 ans</p>\n</td>\n<td width=\"90\">\n<p align=\"center\">2 ans 3 mois</p>\n</td>\n</tr>\n<tr>\n<td width=\"67\">\n<p align=\"center\">8e</p>\n</td>\n<td width=\"89\">\n<p align=\"center\">3 ans</p>\n</td>\n<td width=\"90\">\n<p align=\"center\">2 ans 3 mois</p>\n</td>\n</tr>\n<tr>\n<td width=\"67\">\n<p align=\"center\">7e</p>\n</td>\n<td width=\"89\">\n<p align=\"center\">3 ans</p>\n</td>\n<td width=\"90\">\n<p align=\"center\">2 ans 3 mois</p>\n</td>\n</tr>\n<tr>\n<td width=\"67\">\n<p align=\"center\">6e</p>\n</td>\n<td width=\"89\">\n<p align=\"center\">2 ans 6 mois</p>\n</td>\n<td width=\"90\">\n<p align=\"center\">2 ans</p>\n</td>\n</tr>\n<tr>\n<td width=\"67\">\n<p align=\"center\">5e</p>\n</td>\n<td width=\"89\">\n<p align=\"center\">2 ans</p>\n</td>\n<td width=\"90\">\n<p align=\"center\">1 an 6 mois</p>\n</td>\n</tr>\n<tr>\n<td width=\"67\">\n<p align=\"center\">4e</p>\n</td>\n<td width=\"89\">\n<p align=\"center\">2 ans</p>\n</td>\n<td width=\"90\">\n<p align=\"center\">1 an 6 mois</p>\n</td>\n</tr>\n<tr>\n<td width=\"67\">\n<p align=\"center\">3e</p>\n</td>\n<td width=\"89\">\n<p align=\"center\">2 ans</p>\n</td>\n<td width=\"90\">\n<p align=\"center\">1 an 6 mois</p>\n</td>\n</tr>\n<tr>\n<td width=\"67\">\n<p align=\"center\">2e</p>\n</td>\n<td width=\"89\">\n<p align=\"center\">1 an</p>\n</td>\n<td width=\"90\">\n<p align=\"center\">1 an</p>\n</td>\n</tr>\n<tr>\n<td width=\"67\">\n<p align=\"center\">1er</p>\n</td>\n<td width=\"89\">\n<p align=\"center\">1 an</p>\n</td>\n<td width=\"90\">\n<p align=\"center\">1 an</p>\n</td>\n</tr>\n</tbody>\n</table>"

  "NOTA": {
    "CONTENU": "<br/>   NOTA : Décret 2004-768 du 29 juillet 2004 art. 17 : Les dispositions du décret 93-515 sont abrogées en tant qu'elles concernent le corps des cadres de France Télécom.<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {

        {
          "#text": "Loi n°78-22 du 10 janvier 1978 RELATIVE A L'INFORMATION ET A LA PROTECTION DES CONSOMMATEURS DANS LE DOMAINE DE CERTAINES OPERATIONS DE CREDIT",
          "@c_titre_court": "Loi n°78-22 du 10 janvier 1978",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",

  "NOTA": {
    "CONTENU": "<p>Décret n° 2011-1667 du 29 novembre 2011, article 9-II : Les dispositions du même décret sont abrogées en tant qu'elles concernent le corps des cadres d'exploitation de France Télécom </p>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<table>\n<tbody>\n<tr>\n<td rowspan=\"2\" width=\"125\">\n<p align=\"center\">ANCIENNE SITUATION</p>\n</td>\n<td colspan=\"2\" width=\"253\">\n<p align=\"center\">NOUVELLE SITUATION</p>\n</td>\n</tr>\n<tr>\n<td width=\"128\">\n<p align=\"center\">Grade et échelon</p>\n</td>\n<td width=\"125\">\n<p align=\"center\">Ancienneté d'échelon</p>\n</td>\n</tr>\n<tr>\n<td width=\"125\">\n<p align=\"center\">Assistant(e) de service social chef</p>\n</td>\n<td colspan=\"2\" width=\"253\">\n<p align=\"center\">Technicien supérieur de La Poste ou cadre d'exploitation de France Télécom</p>\n</td>\n</tr>\n<tr>\n<td width=\"125\">\n<p>8e échelon : </p>\n</td>\n<td valign=\"top\" width=\"128\"/>\n<td valign=\"top\" width=\"125\"/>\n</tr>\n<tr>\n<td width=\"125\">\n<p>- à partir de 2 ans</p>\n</td>\n<td width=\"128\">\n<p align=\"center\">14e</p>\n</td>\n<td width=\"125\">\n<p>Sans ancienneté</p>\n</td>\n</tr>\n<tr>\n<td width=\"125\">\n<p>- avant 2 ans</p>\n</td>\n<td width=\"128\">\n<p align=\"center\">13e</p>\n</td>\n<td width=\"125\">\n<p>Ancienneté acquise </p>\n</td>\n</tr>\n<tr>\n<td width=\"125\">\n<p>7e échelon</p>\n</td>\n<td width=\"128\">\n<p align=\"center\">12e</p>\n</td>\n<td width=\"125\">\n<p>Quatre cinquièmes de l'ancienneté acquise </p>\n</td>\n</tr>\n<tr>\n<td width=\"125\">\n<p>6e échelon</p>\n</td>\n<td width=\"128\">\n<p align=\"center\">10e</p>\n</td>\n<td width=\"125\">\n<p>Deux tiers de l'ancienneté acquise</p>\n</td>\n</tr>\n<tr>\n<td width=\"125\">\n<p>5e échelon</p>\n</td>\n<td width=\"128\">\n<p align=\"center\">8e</p>\n</td>\n<td width=\"125\">\n<p>Deux tiers de l'ancienneté acquise</p>\n</td>\n</tr>\n<tr>\n<td width=\"125\">\n<p>4e échelon</p>\n</td>\n<td width=\"128\">\n<p align=\"center\">7e</p>\n</td>\n<td width=\"125\">\n<p>Trois demis de l'ancienneté acquise</p>\n</td>\n</tr>\n<tr>\n<td width=\"125\">\n<p>3e échelon</p>\n</td>\n<td width=\"128\">\n<p align=\"center\">6e</p>\n</td>\n<td width=\"125\">\n<p>Trois demis de l'ancienneté acquise </p>\n</td>\n</tr>\n<tr>\n<td width=\"125\">\n<p>2e échelon</p>\n</td>\n<td width=\"128\">\n<p align=\"center\">5e</p>\n</td>\n<td width=\"125\">\n<p>Double de l'ancienneté acquise</p>\n</td>\n</tr>\n<tr>\n<td width=\"125\">\n<p>1er échelon</p>\n</td>\n<td width=\"128\">\n<p align=\"center\">4e</p>\n</td>\n<td width=\"125\">\n<p>Ancienneté acquise</p>\n</td>\n</tr>\n</tbody>\n</table>"
  },

  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   La durée moyenne et la durée minimum du temps passé dans chacun des échelons des grades et classes mentionnés à l'article 3 ci-dessus sont fixées ainsi qu'il suit :<br/>\n<br/>\n GRADES ET CLASSES : Directeur<br/>\n I = ÉCHELONS<br/>\n II = DURÉE Moyenne<br/>\n III = DURÉE Minimum<br/>\n<br/>\n<table>\n<tr>\n<td> :---:---------:--------------:</td>\n</tr>\n<tr>\n<td> : I :    II   :      III     :</td>\n</tr>\n<tr>\n<td> :---:---------:--------------:</td>\n</tr>\n<tr>\n<td> : 6 :  3 ans  : 2 ans 6 mois :</td>\n</tr>\n<tr>\n<td> : 5 :  3 ans  : 2 ans 6 mois :</td>\n</tr>\n<tr>\n<td> : 4 :  3 ans  : 2 ans 6 mois :</td>\n</tr>\n<tr>\n<td> : 3 :  2 ans  : 1 an  6 mois :</td>\n</tr>\n<tr>\n<td> : 2 :  2 ans  : 1 an  6 mois :</td>\n</tr>\n<tr>\n<td> : 1 :  2 ans  : 1 an  6 mois :</td>\n</tr>\n<tr>\n<td> :---:---------:--------------:</td>\n</tr>\n</table>\n<br/>\n<br/>\n GRADES ET CLASSES : Délégué principal de 1re classe<br/>\n I = ÉCHELONS<br/>\n II = DURÉE Moyenne<br/>\n III = DURÉE Minimum<br/>\n<br/>\n<table>\n<tr>\n<td> :---:----------:--------------:</td>\n</tr>\n<tr>\n<td> : I :    II    :      III     :</td>\n</tr>\n<tr>\n<td> :---:----------:--------------:</td>\n</tr>\n<tr>\n<td> : 3 :  3 ans   : 2 ans 3 mois :</td>\n</tr>\n<tr>\n<td> : 2 :  3 ans   : 2 ans 3 mois :</td>\n</tr>\n<tr>\n<td> : 1 :2 ans 6 ms: 2 ans        :</td>\n</tr>\n<tr>\n<td> :---:----------:--------------:</td>\n</tr>\n</table>\n<br/>\n<br/>\n GRADES ET CLASSES : Délégué principal de 2e classe<br/>\n I = ÉCHELONS<br/>\n II = DURÉE Moyenne<br/>\n III = DURÉE Minimum<br/>\n<br/>\n<table>\n<tr>\n<td> :---:----------:--------------:</td>\n</tr>\n<tr>\n<td> : I :    II    :      III     :</td>\n</tr>\n<tr>\n<td> :---:----------:--------------:</td>\n</tr>\n<tr>\n<td> : 5 :  3 ans   : 2 ans 3 mois :</td>\n</tr>\n<tr>\n<td> : 4 :2 ans 6 ms: 2 ans        :</td>\n</tr>\n<tr>\n<td> : 3 :2 ans 6 ms: 2 ans        :</td>\n</tr>\n<tr>\n<td> : 2 :2 ans 6 ms: 2 ans        :</td>\n</tr>\n<tr>\n<td> : 1 : 1 an     : 1 an         :</td>\n</tr>\n<tr>\n<td> :---:----------:--------------:</td>\n</tr>\n</table>\n<br/>\nGRADES ET CLASSES : Délégué<br/>\n I = ÉCHELONS<br/>\n II = DURÉE Moyenne<br/>\n III = DURÉE Minimum<br/>\n<br/>\n<table>\n<tr>\n<td> :---:----------:--------------:</td>\n</tr>\n<tr>\n<td> : I :    II    :      III     :</td>\n</tr>\n<tr>\n<td> :---:----------:--------------:</td>\n</tr>\n<tr>\n<td> : 11:  4 ans   : 3 ans        :</td>\n</tr>\n<tr>\n<td> : 10:  3 ans   : 2 ans 3 mois :</td>\n</tr>\n<tr>\n<td> : 9 :  3 ans   : 2 ans 3 mois :</td>\n</tr>\n<tr>\n<td> : 8 :  3 ans   : 2 ans 3 mois :</td>\n</tr>\n<tr>\n<td> : 7 :  3 ans   : 2 ans 3 mois :</td>\n</tr>\n<tr>\n<td> : 6 :2 ans 6 ms: 2 ans        :</td>\n</tr>\n<tr>\n<td> : 5 :  2 ans   : 1 an  6 mois :</td>\n</tr>\n<tr>\n<td> : 4 :  2 ans   : 1 an  6 mois :</td>\n</tr>\n<tr>\n<td> : 3 :  2 ans   : 1 an  6 mois :</td>\n</tr>\n<tr>\n<td> : 2 :  1 an    : 1 an         :</td>\n</tr>\n<tr>\n<td> : 1 :  1 an    : 1 an         :</td>\n</tr>\n<tr>\n<td> :---:----------:--------------:</td>\n</tr>\n</table>\n<br/>"

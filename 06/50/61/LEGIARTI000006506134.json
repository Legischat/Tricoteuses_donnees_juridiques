  "BLOC_TEXTUEL": {
    "CONTENU": "La durée moyenne et la durée minimale du temps passé dans chacun des échelons des grades et classes des corps de traducteurs sont fixées ainsi qu'il suit :<br/>\n<br/>\n<br/>\n<table align=\"center\" border=\"2\" cellpadding=\"2\">\n<tbody>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">\n<strong>GRADES ET CLASSES</strong>\n</p>\n</td>\n<td align=\"left\" colspan=\"3\" valign=\"middle\">\n<p align=\"center\">\n<strong>DUREE</strong>\n</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<div align=\"center\">\n<pre> </pre>\n</div>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">Echelons</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">Moyenne</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">Minimale</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">Traducteur principal de 1re classe</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">3e</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">3 ans</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">2 ans 3 mois</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<pre> </pre>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">2e</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">2 ans</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">1 an 6 mois</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<pre> </pre>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">1er</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">2 ans</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">1 an 6 mois</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">Traducteur principal de 2e classe</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">3e</p>\n</td>\n<td ali
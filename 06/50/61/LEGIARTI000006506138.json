" valign=\"middle\">\n<p align=\"center\">5e échelon</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">\n<i>- </i>avant 1 an</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">4e échelon</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">3e échelon :</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<pre> </pre>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">\n<i>- </i>après 1 an</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">4e échelon</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">\n<i>- </i>avant 1 an</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">3e échelon</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">2e échelon :</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<pre> </pre>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">\n<i>- </i>après 1 an</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">3e échelon</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">\n<i>- </i>avant 1 an</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">2e échelon</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">1er échelon :</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<pre> </pre>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">\n<i>- </i>après 1 an</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">2e échelon</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">\n<i>- </i>avant 1 an</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">1er échelon</p>\n</td>\n</tr>\n</tbody>\n</table>\n<p>\n<br/>\n<br/>\n<br/>Les pensions des traducteurs retraités avant l'entrée en vigueur du présent décret ou
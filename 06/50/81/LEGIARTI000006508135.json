  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les ressources du centre national d'enseignement à distance comprennent notamment :<br/>\n<br/>   - les subventions allouées par l'Etat et les collectivités publiques pour le fonctionnement et l'investissement ;<br/>\n<br/>   - les versements des assujettis à la taxe d'apprentissage ;<br/>\n<br/>   - les versements au titre de la participation des employeurs au financement de la formation professionnelle continue ;<br/>\n<br/>   - les contributions privées, les dons et legs ;<br/>\n<br/>   - les droits, redevances et produits de toute nature résultant de ses activités.<br/>"
  },

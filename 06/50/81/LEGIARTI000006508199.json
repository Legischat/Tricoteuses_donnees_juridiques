  "NOTA": {
    "CONTENU": "<br/>   NOTA : Décret 88-425 du 25 avril 1988 art. 28 : Les dispositions du décret du 2 mai 1972 susvisé sont abrogées en tant qu'elles concernent les grades d'inspecteur principal et d'inspecteur divisionnaire de la répression des fraudes.<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les inspecteurs de la répression des fraudes accèdent aux différents grades et classes de leur corps par voie d'inscription au tableau d'avancement.<br/>\n<br/>"
  },

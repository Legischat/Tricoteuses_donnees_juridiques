    "CONTENU": "<br/>\n<br/>\n<br/>\n<br/>\n<br/>\n<br/>\n<br/>\n<br/>\n<br/>\n<br/>\n<br/>\n<br/>\n<br/>\n<br/>\n<br/>\n<br/>\n<br/>\n<br/>\n<br/>\n<br/>\n<br/>\n<br/>\n<br/>\n<table>\n<tbody>\n<tr>\n<td align=\"center\">\n<p>ANNÉE </p>\n<p>de versement </p>\n<p>de l'indemnité </p>\n</td>\n<td align=\"center\">\n<p>NOMBRE MINIMUM D'ANNÉES </p>\n<p> de services effectifs dans une ou plusieurs juridictions  </p>\n<p> de l'ordre judiciaire, dont doivent justifier </p>\n<p> en cette qualité les personnes mentionnées au deuxième </p>\n<p> alinéa de l'article 7 pour bénéficier de l'indemnité </p>\n<p> de renouvellement de robe d'audience</p>\n</td>\n</tr>\n<tr>\n<td align=\"center\"> 1997</td>\n<td align=\"center\"> 25 ans</td>\n</tr>\n<tr>\n<td align=\"center\"> 1998</td>\n<td align=\"center\"> 24 ans</td>\n</tr>\n<tr>\n<td align=\"center\"> 1999</td>\n<td align=\"center\">23 ans <br/>\n</td>\n</tr>\n<tr>\n<td align=\"center\"> 2000</td>\n<td align=\"center\"> 22 ans</td>\n</tr>\n<tr>\n<td align=\"center\"> 2001</td>\n<td align=\"center\">21 ans <br/>\n</td>\n</tr>\n<tr>\n<td align=\"center\"> 2002</td>\n<td align=\"center\"> 20 ans</td>\n</tr>\n</tbody>\n</table>\n<br/>"

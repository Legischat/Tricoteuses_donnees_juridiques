  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   La durée moyenne et la durée minimale du temps passé dans chacun des échelons des grades mentionnés à l'article 3 sont fixées ainsi qu'il suit :<br/>\n<br/>\n GRADES : Expert vérificateur de classe exceptionnelle<br/>\n I = ÉCHELONS<br/>\n II = DURÉE Moyenne<br/>\n III = DURÉE Minimum<br/>\n<br/>\n<br/>\n<table>\n<tr>\n<td> :---:-----------:-------------:</td>\n</tr>\n<tr>\n<td> : I :    II     :     III     :</td>\n</tr>\n<tr>\n<td> :---:-----------:-------------:</td>\n</tr>\n<tr>\n<td> :6e : 4 ans     : 3 ans       :</td>\n</tr>\n<tr>\n<td> :5e : 3 ans     : 2 ans 3 mois:</td>\n</tr>\n<tr>\n<td> :4e : 3 ans     : 2 ans 3 mois:</td>\n</tr>\n<tr>\n<td> :3e : 2 ans 6 ms: 2 ans       :</td>\n</tr>\n<tr>\n<td> :2e : 2 ans 6 ms: 2 ans       :</td>\n</tr>\n<tr>\n<td> :1e : 2 ans     : 1 an  6 mois:</td>\n</tr>\n<tr>\n<td> :---:-----------:-------------:</td>\n</tr>\n<tr>\n<td> </td>\n</tr>\n<tr>\n<td> GRADES : Expert vérificateur de classe supérieure</td>\n</tr>\n<tr>\n<td> I = ÉCHELONS</td>\n</tr>\n<tr>\n<td> II = DURÉE Moyenne</td>\n</tr>\n<tr>\n<td> III = DURÉE Minimum</td>\n</tr>\n<tr>\n<td> </td>\n</tr>\n<tr>\n<td> :---:-----------:-------------:</td>\n</tr>\n<tr>\n<td> : I :    II     :     III     :</td>\n</tr>\n<tr>\n<td> :---:-----------:-------------:</td>\n</tr>\n<tr>\n<td> :6e : 4 ans     : 3 ans       :</td>\n</tr>\n<tr>\n<td> :5e : 3 ans     : 2 ans 3 mois:</td>\n</tr>\n<tr>\n<td> :4e : 3 ans     : 2 ans 3 mois:</td>\n</tr>\n<tr>\n<td> :3e : 3 ans     : 2 ans 3 mois:</td>\n</tr>\n<tr>\n<td> :2e : 2 ans     : 1 an  6 mois:</td>\n</tr>\n<tr>\n<td> :1e : 2 ans     : 1 an  6 mois:</td>\n</tr>\n<tr>\n<td> :---:-----------:-------------:</td>\n</tr>\n</table>\n<br/>\nGRADES : Expert vérificateur de classe normale<br/>\n I = ÉCHELONS<br/>\n II = DURÉE Moyenne<br/>\n III = DURÉE Minimum<br/>\n<br/>\n<br/>\n<table>\n<tr>\n<td> :---:-----------:-------------:</td>\n</tr>\n<tr>\n<td> : I :    II     :     III     :</td>\n</tr>\n<tr>\n<td> :---:-----------:-------------:</td>\n</tr>\n<tr>\n<td> :9e : 4 ans     : 3 ans       :</td>\n</tr>\n<tr>\n<td> :8e : 3 ans     : 2 ans 3 mois:</td>\n</tr>\n<tr>\n<td> :7e : 3 ans     : 2 ans 3 mois:</td>\n</tr>\n<tr>\n<td> :6e : 3 ans     : 2 ans 3 mois:</td>\n</tr>\n<tr>\n<td> :5e : 3 ans     : 2 ans 3 mois:</td>\n</tr>\n<tr>\n<td> :4e : 3 ans     : 2 ans 3 mois:</td>\n</tr>\n<tr>\n<td> :3e : 2 ans     : 2 ans       :</td>\n</tr>\n<tr>\n<td> :2e : 2 ans     : 2 ans       :</td>\n</tr>\n<tr>\n<td> :1e : 1 an      : 1 an        :</td>\n</tr>\n<tr>\n<td> :---:-----------:-------------:</td>\n</tr>\n</table>\n<br/>"

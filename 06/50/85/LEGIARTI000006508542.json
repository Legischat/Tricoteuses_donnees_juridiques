  "BLOC_TEXTUEL": {
    "CONTENU": "<p>La durée moyenne et la durée minimale du temps passé dans chacun des échelons des grades de géomètre principal et de géomètre sont fixées ainsi qu'il suit :</p>\n<table>\n<tbody>\n<tr>\n<td>\n<p align=\"center\">GRADES </p>\n</td>\n<td>\n<p align=\"center\">ECHELONS</p>\n</td>\n<td>\n<p align=\"center\">DUREE MOYENNE</p>\n</td>\n<td>\n<p align=\"center\">DUREE MINIMALE</p>\n</td>\n</tr>\n<tr>\n<td>\n<p align=\"center\">Géomètre principal</p>\n</td>\n<td>\n<p align=\"center\">2e échelon</p>\n</td>\n<td>\n<p align=\"center\">2 ans.</p>\n</td>\n<td>\n<p align=\"center\">1 an 6 mois.</p>\n</td>\n</tr>\n<tr>\n<td>\n<pre> </pre>\n</td>\n<td>\n<p align=\"center\">1er échelon</p>\n</td>\n<td>\n<p align=\"center\">2 ans.</p>\n</td>\n<td>\n<p align=\"center\">1 an 6 mois.</p>\n</td>\n</tr>\n<tr>\n<td>\n<p align=\"center\">Géomètre</p>\n</td>\n<td>\n<p align=\"center\">5e échelon</p>\n</td>\n<td>\n<p align=\"center\">4 ans.</p>\n</td>\n<td>\n<p align=\"center\">3 ans.</p>\n</td>\n</tr>\n<tr>\n<td>\n<pre> </pre>\n</td>\n<td>\n<p align=\"center\">4e échelon</p>\n</td>\n<td>\n<p align=\"center\">3 ans.</p>\n</td>\n<td>\n<p align=\"center\">2 ans 6 mois.</p>\n</td>\n</tr>\n<tr>\n<td>\n<pre> </pre>\n</td>\n<td>\n<p align=\"center\">3e échelon</p>\n</td>\n<td>\n<p align=\"center\">3 ans.</p>\n</td>\n<td>\n<p align=\"center\">2 ans 6 mois.</p>\n</td>\n</tr>\n<tr>\n<td>\n<pre> </pre>\n</td>\n<td>\n<p align=\"center\">2e échelon</p>\n</td>\n<td>\n<p align=\"center\">2 ans.</p>\n</td>\n<td>\n<p align=\"center\">1 an 6 mois.</p>\n</td>\n</tr>\n<tr>\n<td rowspan=\"2\">\n<pre> </pre>\n</td>\n<td rowspan=\"2\">\n<p align=\"center\">1er échelon</p>\n</td>\n<td rowspan=\"2\">\n<p align=\"center\">2 ans.</p>\n</td>\n<td rowspan=\"2\">\n<p align=\"center\">1 an 6 mois.</p>\n</td>\n</tr>\n</tbody>\n</table>"

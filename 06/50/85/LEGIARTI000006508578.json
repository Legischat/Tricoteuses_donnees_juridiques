  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret n°64-23 du 8 janvier 1964 RELATIF AU STATUT PARTICULIER DES CORPS D'INGENIEURS DESSINATEURS ET SOUS-INGENIEURS DESSINATEURS ET DE DESSINATEURS DU SECRETARIAT GENERAL A L'AVIATION CIVILE",
          "@c_titre_court": "Décret n°64-23 du 8 janvier 1964",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000509644"
        },
        {
          "#text": "Décret n°64-23 du 8 janvier 1964 relatif au statut particulier des corps d'ingénieurs dessinateurs et sous-ingénieurs dessinateurs et de dessinateurs du secrétariat général à l'aviation civile (ministère des travaux publics et des transports)",
          "@c_titre_court": "Décret n°64-23 du 8 janvier 1964",
          "@debut": "1962-01-01",
          "@fin": "2007-05-03",
          "@id_txt": "LEGITEXT000006061193"
        }
      ],
      "TM": {
        "TITRE_TM": [
          {
            "#text": "Titre Ier : Corps d'ingénieurs dessinateurs et sous-ingénieurs dessinateurs de l'aviation civile",
            "@debut": "1962-01-01",
            "@fin": "1982-01-20",
            "@id": "LEGISCTA000006095181"
          }
        ],
        "TM": {
          "TITRE_TM": [
            {
              "#text": "Section III : Avancement.",
              "@debut": "1962-01-01",
              "@fin": "1982-01-20",
              "@id": "LEGISCTA000006119984"
            }
          ],
          "TM": {
            "TITRE_TM": [
              {
                "#text": "Les sous-ingénieurs dessinateurs promus au grade d'ingénieur dessinateur sont classés à l'échelon comportant un indice égal ou, à défaut, immédiatement supérieur à celui qu'ils détenaient précédemment",
                "@debut": "1973-07-01",
                "@fin": "1982-01-20",
                "@id": "LEGISCTA000006137231"
              }
            ],
            "TM": {
              "TITRE_TM": [
                {
                  "#text": "L'ancienneté acquise dans le 7e et le 8e échelon du grade de sous-ingénieur dessinateur est maintenue dans la limite de deux années à l'agent promu au 1er ou au 2e échelon du grade d'ingénieur dessinateur.",
                  "@debut": "1973-07-01",
                  "@fin": "1982-01-20",
                  "@id": "LEGISCTA000006150936"
                }
              ]
            }
          }
        }
      },

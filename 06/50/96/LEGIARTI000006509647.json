  "BLOC_TEXTUEL": {
    "CONTENU": "Les agents de la hors-classe du groupe 3 et du 11e échelon de la 1re classe du même groupe nommés dans la 2e classe du groupe 2 sont classés dans les conditions suivantes :<br/>\n<br/>\n<br/>\n<br/>\n<table>\n<tbody>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">\n<strong>SITUATION<br/>\n</strong>dans le groupe 3</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">\n<strong>SITUATION<br/>\n</strong>dans le groupe 2<br/>2e classe</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">\n<strong>ANCIENNETE<br/>\n</strong>conservée dans la limite de la durée de l'échelon</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">\n<i>Groupe 3 - Hors classe</i>\n</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<pre> </pre>\n</td>\n<td align=\"left\" valign=\"middle\">\n<pre> </pre>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">3e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">11e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">Sans ancienneté</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">2e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">10e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">Ancienneté acquise</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">1er échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">9e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">Ancienneté acquise </p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">\n<i>Groupe 3 - 1re classe</i>\n</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<pre> </pre>\n</td>\n<td align=\"left\" valign=\"middle\">\n<pre> </pre>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">11e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">10e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">Ancienneté acquise</p>\n</td>\n</tr>\n</tbody>\n</table>\n<p>\n<br/>\n<br/>\n</p>"
  },

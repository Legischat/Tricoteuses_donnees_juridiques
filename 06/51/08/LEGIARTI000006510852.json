n=\"center\">5e échelon</p>\n</td>\n</tr>\n<tr>\n<td width=\"205\">\n<p>Avant 8 mois</p>\n</td>\n<td width=\"205\">\n<p align=\"center\">4e échelon</p>\n</td>\n</tr>\n<tr>\n<td width=\"205\">\n<p>3e échelon du groupe V :</p>\n</td>\n<td width=\"205\">\n<p align=\"center\"> </p>\n</td>\n</tr>\n<tr>\n<td width=\"205\">\n<p>Après 8 mois</p>\n</td>\n<td width=\"205\">\n<p align=\"center\">4e échelon</p>\n</td>\n</tr>\n<tr>\n<td width=\"205\">\n<p>Avant 8 mois</p>\n</td>\n<td width=\"205\">\n<p align=\"center\">3e échelon</p>\n</td>\n</tr>\n<tr>\n<td width=\"205\">\n<p>2e échelon du groupe V :</p>\n</td>\n<td width=\"205\">\n<p align=\"center\"> </p>\n</td>\n</tr>\n<tr>\n<td width=\"205\">\n<p>Après 8 mois</p>\n</td>\n<td width=\"205\">\n<p align=\"center\">3e échelon</p>\n</td>\n</tr>\n<tr>\n<td width=\"205\">\n<p>Avant 8 mois</p>\n</td>\n<td width=\"205\">\n<p align=\"center\">2e échelon</p>\n</td>\n</tr>\n<tr>\n<td width=\"205\">\n<p>1er échelon du groupe V</p>\n</td>\n<td width=\"205\">\n<p align=\"center\">2e échelon</p>\n</td>\n</tr>\n</tbody>\n</table>\n<p>Les pensions des fonctionnaires retraités ou celles de leurs ayants cause sont révisées en application des dispositions ci-dessus à compter de la date d'application du présent décret aux personnels en activité.</p>"

  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les durées moyenne et minimale dans chaque échelon de la classe normale et de la classe fonctionnelle sont fixées conformément au tableau ci-après :<br/>\n<br/>\n I = GRADE : Classe normale<br/>\n II = DURÉE Moyenne<br/>\n III : DURÉE Minimale<br/>\n<br/>\n<table>\n<tr>\n<td> :---:------------:------------:</td>\n</tr>\n<tr>\n<td> : I :     II     :    III     :</td>\n</tr>\n<tr>\n<td> :---:------------:------------:</td>\n</tr>\n<tr>\n<td> :1e+:    2 ans   :1 an 6 mois :</td>\n</tr>\n<tr>\n<td> :8e :    4 ans   :    3 ans   :</td>\n</tr>\n<tr>\n<td> :7e :3 ans 6 mois:2 ans 9 mois:</td>\n</tr>\n<tr>\n<td> :6e :3 ans 6 mois:2 ans 9 mois:</td>\n</tr>\n<tr>\n<td> :5e :    3 ans   :2 ans 3 mois:</td>\n</tr>\n<tr>\n<td> :4e :    3 ans   :2 ans 3 mois:</td>\n</tr>\n<tr>\n<td> :3e :    3 ans   :2 ans 3 mois:</td>\n</tr>\n<tr>\n<td> :2e :    2 ans   :1 an 6 mois :</td>\n</tr>\n<tr>\n<td> :1er:    1 an    :     1 an   :</td>\n</tr>\n<tr>\n<td> :---:------------:------------:</td>\n</tr>\n</table>\n<br/>\n<br/>\n 1e+ = 1er échelon exceptionnel<br/>\n<br/>\n I = GRADE : Classe fonctionnelle<br/>\n II = DURÉE Moyenne<br/>\n III : DURÉE Minimale<br/>\n<br/>\n<table>\n<tr>\n<td> :---:------------:------------:</td>\n</tr>\n<tr>\n<td> : I :     II     :    III     :</td>\n</tr>\n<tr>\n<td> :---:------------:------------:</td>\n</tr>\n<tr>\n<td> :6e :    4 ans   :    3 ans   :</td>\n</tr>\n<tr>\n<td> :5e :    4 ans   :    3 ans   :</td>\n</tr>\n<tr>\n<td> :4e :    4 ans   :    3 ans   :</td>\n</tr>\n<tr>\n<td> :3e :    4 ans   :    3 ans   :</td>\n</tr>\n<tr>\n<td> :2e :    4 ans   :    3 ans   :</td>\n</tr>\n<tr>\n<td> :1e :    4 ans   :    3 ans   :</td>\n</tr>\n<tr>\n<td> :---:------------:------------:</td>\n</tr>\n</table>\n<br/>"
  },

  "BLOC_TEXTUEL": {
    "CONTENU": "<p>La durée des échelons provisoires mentionnés à l'article 2 du présent décret est fixée ainsi qu'il suit :</p>\n<table>\n<tbody>\n<tr>\n<td rowspan=\"2\" width=\"131\">\n<p align=\"center\">ECHELONS</p>\n</td>\n<td colspan=\"2\" width=\"247\">\n<p align=\"center\">DUREE</p>\n</td>\n</tr>\n<tr>\n<td width=\"124\">\n<p align=\"center\">Moyenne</p>\n</td>\n<td width=\"123\">\n<p align=\"center\">Minimale</p>\n</td>\n</tr>\n<tr>\n<td width=\"131\">\n<p>4e échelon provisoire</p>\n</td>\n<td width=\"124\">\n<p align=\"center\">2 ans</p>\n</td>\n<td width=\"123\">\n<p align=\"center\">1 an 6 mois :</p>\n</td>\n</tr>\n<tr>\n<td width=\"131\">\n<p>3e échelon provisoire</p>\n</td>\n<td width=\"124\">\n<p align=\"center\">2 ans</p>\n</td>\n<td width=\"123\">\n<p align=\"center\">1 an 6 mois :</p>\n</td>\n</tr>\n<tr>\n<td width=\"131\">\n<p>2e échelon provisoire</p>\n</td>\n<td width=\"124\">\n<p align=\"center\">2 ans</p>\n</td>\n<td width=\"123\">\n<p align=\"center\">1 an 6 mois :</p>\n</td>\n</tr>\n<tr>\n<td width=\"131\">\n<p>1er échelon provisoire</p>\n</td>\n<td width=\"124\">\n<p align=\"center\">2 ans</p>\n</td>\n<td width=\"123\">\n<p align=\"center\">1 an 6 mois :</p>\n</td>\n</tr>\n</tbody>\n</table>"

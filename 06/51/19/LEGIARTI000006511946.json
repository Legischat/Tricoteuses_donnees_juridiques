  "BLOC_TEXTUEL": {
    "CONTENU": "<p>Les instructeurs techniques sont intégrés dans le grade de professeur technique, conformément au tableau de correspondance ci-après :</p>\n<table border=\"2\" cellpadding=\"2\">\n<tbody>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">SITUATION ANCIENNE</p>\n</td>\n<td align=\"left\" colspan=\"2\" valign=\"middle\">\n<p align=\"center\">SITUATION NOUVELLE</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<pre> </pre>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">Echelons</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">Ancienneté dans l'échelon</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">\n<i>Instructeur technique</i>\n</p>\n</td>\n<td align=\"left\" colspan=\"2\" valign=\"middle\">\n<p align=\"center\">\n<i>Professeur technique</i>\n</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">11e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">10e</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">1/2 de l'ancienneté acquise dans la limite de 2 ans</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">10e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">9e</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">Ancienneté acquise minorée de 6 mois</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">9e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">8e</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">Ancienneté acquise majorée de 6 mois</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">8e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">7e</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">Ancienneté acquise</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">7e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">6e</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">Ancienneté acquise</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">6e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">5e</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">Ancienneté acquise</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">5e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">4e</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">3/5 de l'ancienneté acquise majorés de 1 an</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">4e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">4e</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">2/5 de l'ancienneté acquise</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">3e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">3e</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">Ancienneté acquise</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">2e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">2e</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">Ancienneté acquise</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">1er échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">1e</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">Sans ancienneté</p>\n</td>\n</tr>\n</tbody>\n</table>"

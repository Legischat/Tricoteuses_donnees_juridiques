  "BLOC_TEXTUEL": {
    "CONTENU": "<p>L'avancement d'échelon des professeurs de sport hors classe prend effet du jour où les intéressés remplissent les conditions fixées au tableau ci-après :</p>\n<table border=\"1\" cellpadding=\"0\">\n<tbody>\n<tr>\n<td>\n<p align=\"center\">ECHELONS</p>\n</td>\n<td>\n<p align=\"center\">DUREE D'ECHELON</p>\n</td>\n</tr>\n<tr>\n<td>\n<p>Du 1er au 2e échelon</p>\n</td>\n<td>\n<p align=\"center\">2 ans 6 mois</p>\n</td>\n</tr>\n<tr>\n<td>\n<p>Du 2e au 3e échelon</p>\n</td>\n<td>\n<p align=\"center\">2 ans 6 mois</p>\n</td>\n</tr>\n<tr>\n<td>\n<p>Du 3e au 4e échelon</p>\n</td>\n<td>\n<p align=\"center\">2 ans 6 mois</p>\n</td>\n</tr>\n<tr>\n<td>\n<p>Du 4e au 5e échelon</p>\n</td>\n<td>\n<p align=\"center\">2 ans 6 mois</p>\n</td>\n</tr>\n<tr>\n<td>\n<p>Du 5e au 6e échelon</p>\n</td>\n<td>\n<p align=\"center\">3 ans</p>\n</td>\n</tr>\n<tr>\n<td rowspan=\"2\">\n<p>Du 6e au 7e échelon</p>\n</td>\n<td rowspan=\"2\">\n<p align=\"center\">3 ans</p>\n</td>\n</tr>\n</tbody>\n</table>\n<br/>"
  },

  "BLOC_TEXTUEL": {
    "CONTENU": "<p>L'avancement d'échelon des chargés d'éducation populaire et de jeunesse hors-classe prend effet du jour où les intéressés remplissent les conditions fixées au tableau ci-dessus :</p>\n<br/>\n<table>\n<tbody>\n<tr>\n<td valign=\"top\">\n<p align=\"center\">ECHELONS</p>\n</td>\n<td valign=\"top\">\n<p align=\"center\">ANCIENNETE REQUISE</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\">\n<p>Du 1er au 2e échelon</p>\n</td>\n<td valign=\"top\">\n<p align=\"center\">2 ans</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\">\n<p>Du 2e au 3e échelon</p>\n</td>\n<td valign=\"top\">\n<p align=\"center\">3 ans</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\">\n<p>Du 3e au 4e échelon</p>\n</td>\n<td valign=\"top\">\n<p align=\"center\">3 ans</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\">\n<p>Du 4e au 5e échelon</p>\n</td>\n<td valign=\"top\">\n<p align=\"center\">3 ans</p>\n</td>\n</tr>\n<tr>\n<td rowspan=\"2\" valign=\"top\">\n<p>Du 5e au 6e échelon</p>\n</td>\n<td rowspan=\"2\" valign=\"top\">\n<p align=\"center\">3 ans</p>\n</td>\n</tr>\n</tbody>\n</table>\n<br/>"
  },

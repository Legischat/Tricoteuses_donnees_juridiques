  "BLOC_TEXTUEL": {
    "CONTENU": "<p>L'avancement d'échelon des chargés d'éducation populaire et de jeunesse de classe exceptionnelle prend effet du jour où les intéressés remplissent les conditions fixées au tableau ci-après :</p>\n<table>\n<tbody>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">ECHELONS</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">ANCIENNETE REQUISE</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">Du 1er au 2e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">3 ans</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">Du 2e au 3e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">3 ans 6 mois</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">Du 3e au 4e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">4 ans</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"left\">Du 4e au 5e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">4 ans</p>\n</td>\n</tr>\n</tbody>\n</table>"
  },

  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>\n<p> Le temps passé dans chacun des échelons des emplois mentionnés à l'article 4 est fixé comme suit :</p>\n<br/>\n<div>\n<table border=\"1\" cellpadding=\"0\">\n<tbody>\n<tr>\n<td>\n<p>ECHELONS </p>\n</td>\n<td>\n<p>DUREE DE L'ECHELON</p>\n</td>\n</tr>\n<tr>\n<td>\n<p>6e échelon</p>\n</td>\n<td align=\"center\">\n<p>3 ans</p>\n</td>\n</tr>\n<tr>\n<td>\n<p>5e échelon</p>\n</td>\n<td>\n<div align=\"center\">   </div>\n<p align=\"center\">2 ans</p>\n</td>\n</tr>\n<tr>\n<td>\n<p>4e échelon</p>\n</td>\n<td>\n<div align=\"center\">   </div>\n<p align=\"center\">18 mois</p>\n</td>\n</tr>\n<tr>\n<td>\n<p>3e échelon</p>\n</td>\n<td>\n<div align=\"center\">   </div>\n<p align=\"center\">18 mois</p>\n</td>\n</tr>\n<tr>\n<td>\n<p>2e échelon</p>\n</td>\n<td>\n<div align=\"center\">   </div>\n<p align=\"center\">18 mois</p>\n</td>\n</tr>\n<tr>\n<td>\n<p>1er échelon</p>\n</td>\n<td>\n<div align=\"center\">   </div>\n<p align=\"center\">18 mois</p>\n</td>\n</tr>\n</tbody>\n</table>\n</div>"
  },

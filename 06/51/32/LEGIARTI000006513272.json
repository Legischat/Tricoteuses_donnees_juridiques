  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les conseils de la fonction militaire sont les suivants :<br/>\n<br/>   - conseil de la fonction militaire de l'armée de terre ;<br/>\n<br/>   - conseil de la fonction militaire de la marine ;<br/>\n<br/>   - conseil de la fonction militaire de l'armée de l'air ;<br/>\n<br/>   - conseil de la fonction militaire de la gendarmerie ;<br/>\n<br/>   - conseil de la fonction militaire de la délégation générale pour l'armement ;<br/>\n<br/>   - conseil de la fonction militaire du service de santé des armées ;<br/>\n<br/>   - conseil de la fonction militaire du service des essences des armées.<br/>"
  },

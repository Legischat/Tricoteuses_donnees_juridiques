  "BLOC_TEXTUEL": {
    "CONTENU": "<p>Les inspecteurs principaux de 2e classe en fonctions à la date de publication du présent décret sont reclassés conformément au tableau de correspondance suivant :</p>\n<table>\n<tbody>\n<tr>\n<td colspan=\"2\" width=\"151\">\n<p align=\"center\">\n<strong>ANCIENNE SITUATION</strong>\n</p>\n</td>\n<td colspan=\"2\" width=\"174\">\n<p align=\"center\">\n<strong>NOUVELLE SITUATION</strong>\n</p>\n</td>\n</tr>\n<tr>\n<td width=\"57\">\n<p align=\"center\">Echelons</p>\n</td>\n<td width=\"94\">\n<p align=\"center\">Ancienneté<br/>d'échelon</p>\n</td>\n<td width=\"57\">\n<p align=\"center\">Echelons</p>\n</td>\n<td width=\"117\">\n<p align=\"center\">Ancienneté<br/>d'échelon</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"57\">\n<p>5e</p>\n</td>\n<td valign=\"top\" width=\"94\"/>\n<td valign=\"top\" width=\"57\">\n<p>6e</p>\n</td>\n<td valign=\"top\" width=\"117\">\n<p>Ancienneté acquise<br/>conservée</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"57\">\n<p>4e</p>\n</td>\n<td valign=\"top\" width=\"94\"/>\n<td valign=\"top\" width=\"57\">\n<p>5e</p>\n</td>\n<td valign=\"top\" width=\"117\">\n<p>Ancienneté acquise<br/>conservée</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"57\">\n<p>3e</p>\n</td>\n<td valign=\"top\" width=\"94\"/>\n<td valign=\"top\" width=\"57\">\n<p>4e</p>\n</td>\n<td valign=\"top\" width=\"117\">\n<p>Ancienneté acquise<br/>conservée</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"57\">\n<p>2e</p>\n</td>\n<td valign=\"top\" width=\"94\"/>\n<td valign=\"top\" width=\"57\">\n<p>3e</p>\n</td>\n<td valign=\"top\" width=\"117\">\n<p>Ancienneté acquise<br/>conservée</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"57\">\n<p>1er</p>\n</td>\n<td valign=\"top\" width=\"94\"/>\n<td valign=\"top\" width=\"57\">\n<p>2e</p>\n</td>\n<td valign=\"top\" width=\"117\">\n<p>Ancienneté acquise<br/>conservée</p>\n</td>\n</tr>\n</tbody>\n</table>\n<br/>"

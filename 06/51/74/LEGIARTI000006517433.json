  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>\n<p>Le montant de l'amende forfaitaire minorée prévue par l'article 529-7 est fixé ainsi qu'il suit : </p>\n<br/>\n<br/>\n<p>1° 22 euros pour les contraventions de la deuxième classe ; </p>\n<br/>\n<br/>\n<p>2° 45 euros pour les contraventions de la troisième classe ; </p>\n<br/>\n<br/>\n<p>3° 90 euros pour les contraventions de la quatrième classe.</p>\n<br/>"
  },

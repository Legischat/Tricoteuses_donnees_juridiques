  "NOTA": {
    "CONTENU": "<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "Le juge de l'application des peines fixe les modalités d'exécution du travail d'intérêt général.<br/>\n    Sa décision précise :<br/>\n    1° L'organisme au profit duquel le travail sera accompli ;<br/>\n    2° Le travail ou les travaux que le condamné accomplira ;<br/>\n    3° Les horaires de travail.<br/>"
  },

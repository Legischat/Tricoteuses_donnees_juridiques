  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les ressources des comités professionnels de développement économique comprennent notamment :<br/>\n<br/>   Le produit des taxes parafiscales instituées à leur profit ;<br/>\n<br/>   Des contributions consenties par les entreprises intéressées ;<br/>\n<br/>   Des rémunérations pour services rendus ;<br/>\n<br/>   Les revenus des biens et valeurs leur appartenant ;<br/>\n<br/>   Les subventions ;<br/>\n<br/>   Les dons et legs.<br/>"
  },

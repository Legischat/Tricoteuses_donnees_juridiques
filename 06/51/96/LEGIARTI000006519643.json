      "TITRE_TXT": [
        {
          "#text": "Loi du 23 décembre 1904 RELATIVE AUX FETES LEGALES TOMBANT UN DIMANCHE : AUCUN PAIEMENT EXIGIBLE NI AUCUN PROTET N'EST ADRESSE LE LENDEMAIN",
          "@c_titre_court": "Loi du 23 décembre 1904",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000314855"
        },
        {
          "#text": "Loi du 23 décembre 1904 décidant que lorsque les fêtes légales tomberont un dimanche, aucun paiement ne sera exigé et aucun protêt ne sera dressé le lendemain de ces fêtes.",
          "@c_titre_court": "Loi du 23 décembre 1904",
          "@debut": "1904-12-24",

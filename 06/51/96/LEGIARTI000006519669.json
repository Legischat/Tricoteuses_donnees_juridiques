        {
          "#text": "Loi n°51-637 du 24 mai 1951 ETENDANT AUX DEPARTEMENTS D'OUTRE-MER (DOM) LA LEGISLATION METROPOLITAINE RELATIVE AUX CHAMBRES DE COMMERCE",
          "@c_titre_court": "Loi n°51-637 du 24 mai 1951",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000517345"
        },
        {
          "#text": "Loi n°51-637 du 24 mai 1951 étendant aux départements de la Guadeloupe, de la Guyane française, de la Martinique et de la Réunion la législation métropolitaine relative aux chambres de commerce.",
          "@c_titre_court": "Loi n°51-637 du 24 mai 1951",
          "@debut": "1951-05-29",
          "@fin": "2007-03-27",

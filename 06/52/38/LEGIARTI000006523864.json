  "NOTA": {
    "CONTENU": "[*Nota : Intitulés du titre III et du chapitre III modifiés par la loi 62-899 1962-08-04 art. 3 et art. 16 (JORF 5 août 1962).<br/>\n    Article 387 du Code pénal abrogé par l'article 25 de la loi n° 81-82 du 2 février 1981.*]<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Tout capitaine, officier, maître ou homme d'équipage qui altère des marchandises faisant partie de la cargaison est puni des peines prévues à l'article 387 du Code pénal.<br/>\n<br/>"
  },

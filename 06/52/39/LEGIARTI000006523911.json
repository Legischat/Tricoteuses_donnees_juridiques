  "NOTA": {
    "CONTENU": "<br/>  .<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Toute personne qui, sur un navire français, exerce sans l'autorisation de l'administrateur des affaires maritimes et hors le cas de force majeure, soit le commandement du bâtiment, soit toute autre fonction du bord, sans satisfaire aux conditions exigées par les lois et règlements maritimes, est punie d'un emprisonnement de six jours à un an et d'une amende de 360 à 15000 francs ou de l'une de ces deux peines seulement.<br/>\n<br/>"
  },

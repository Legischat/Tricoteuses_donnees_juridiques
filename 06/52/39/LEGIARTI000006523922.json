  "NOTA": {
    "CONTENU": "<br/>  .<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Toute personne embarquée qui, à l'insu du capitaine, introduit sur un navire, en vue de les faire transporter, des marchandises non inscrites au manifeste, est punie d'une amende de 60 à 15000 francs et d'un emprisonnement de six jours à six mois, ou de l'une de ces deux peines seulement, sans préjudice du droit du capitaine de jeter à la mer, dans les conditions de l'article 23 du Code du travail maritime, les marchandises indûment chargées sur le bâtiment.<br/>\n<br/>"
  },

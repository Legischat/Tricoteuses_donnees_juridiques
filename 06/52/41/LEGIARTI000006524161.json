  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Ordonnance n°85-1184 du 13 novembre 1985 RELATIVE A L'ORIENTATION DU DEVELOPPEMENT ECONOMIQUE ET A L'AMENAGEMENT DU TERRITOIRE EN NOUVELLE-CALEDONIE ET DEPENDANCES",
          "@c_titre_court": "Ordonnance n°85-1184 du 13 novembre 1985",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000889138"
        },
        {
          "#text": "Ordonnance n°85-1184 du 13 novembre 1985 relative à l'orientation du développement économique et à l'aménagement du territoire en Nouvelle-Calédonie et dépendances",
          "@c_titre_court": "Ordonnance n°85-1184 du 13 novembre 1985",
          "@debut": "1985-11-15",
          "@fin": "1986-07-19",
          "@id_txt": "LEGITEXT000006069345"
        }
      ],
      "TM": {
        "TITRE_TM": [
          {
            "#text": "Titre II : Dispositions relatives aux groupements de droit particulier local, aux sociétés coopératives d'exploitation en commun et à la participation des collectivités territoriales et de leurs groupements au développement économique.",
            "@debut": "1985-11-15",
            "@fin": "1986-07-19",
            "@id": "LEGISCTA000006095788"
          }
        ]
      },
      "@cid": "JORFTEXT000000889138",
      "@date_publi": "1985-11-15",
      "@date_signature": "1985-11-13",
      "@nature": "ORDONNANCE",
      "@num": "85-1184"
    }
  },
  "VERSIONS": {
    "VERSION": [
      {
        "LIEN_ART": {
          "@debut": "1985-11-15",
          "@etat": "ABROGE",

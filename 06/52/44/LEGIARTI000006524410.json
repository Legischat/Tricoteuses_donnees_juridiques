  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les missions du service public de l'enseignement supérieur sont :<br/>\n<br/>   1° La formation initiale et continue ;<br/>\n<br/>   2° La recherche scientifique et technique ainsi que la valorisation de ses résultats ;<br/>\n<br/>   3° La diffusion de la culture et l'information scientifique et technique ;<br/>\n<br/>   4° La coopération internationale.<br/>"
  },

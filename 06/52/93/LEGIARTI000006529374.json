    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Loi n°59-901 du 31 juillet 1959 RELATIVE A LA REPARATION DES DOMMAGES PHYSIQUES SUBIS EN METROPOLE PAR LES PERSONNES DE NATIONALITE FRANCAISE PAR SUITE DES EVENEMENTS QUI SE DEROULENT EN ALGERIE(DU FAIT D'ATTENTATS OU DE TOUT AUTRE ACTE DE VIOLENCE)",
          "@c_titre_court": "Loi n°59-901 du 31 juillet 1959",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000693647"
        },
        {
          "#text": "Loi n° 59-901 du 31 juillet 1959 relative à la réparation des dommages physiques subis en métropole par les personnes de nationalité française, par suite des événements qui se déroulent en Algérie (1).",
          "@c_titre_court": "Loi n° 59-901 du 31 juillet 1959",
          "@debut": "1959-08-01",
          "@fin": "2017-01-01",
          "@id_txt": "LEGITEXT000006068192"
        }
      ],
      "@cid": "JORFTEXT000000693647",
      "@date_publi": "1959-08-01",

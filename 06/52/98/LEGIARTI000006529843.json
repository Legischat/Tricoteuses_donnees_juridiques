      "TITRE_TXT": [
        {
          "#text": "Loi n°59-900 du 31 juillet 1959 RELATIVE A LA REPARATION DES DOMMAGES PHYSIQUES SUBIS EN METROPOLE PAR LES PERSONNELS MILITAIRES DES FORCES ARMEES FRANCAISES PAR SUITE DES EVENEMENTS QUI SE DEROULENT EN ALGERIE",
          "@c_titre_court": "Loi n°59-900 du 31 juillet 1959",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000874444"
        },
        {
          "#text": "Loi n° 59-900 du 31 juillet 1959 relative à la réparation des dommages physiques subis en métropole par les personnels militaires des forces armées françaises par suite des événements qui se déroulent en Algérie (1).",
          "@c_titre_court": "Loi n° 59-900 du 31 juillet 1959",
          "@debut": "1950-08-01",
          "@fin": "2017-01-01",
          "@id_txt": "LEGITEXT000006068191"
        }
      ],

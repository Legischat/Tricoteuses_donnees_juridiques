      "TITRE_TXT": [
        {
          "#text": "Décret n°80-213 du 11 mars 1980 FIXATION POUR LES DEPARTEMENTS ET TERRITOIRES D'OUTRE-MER ET MAYOTTE,DES MODALITES D'APPLICATION OU D'ADAPTATION DU DECRET 64231 DU 14-03-1964 MODIFIE PORTANT REGLEMENT D'ADMINISTRATION PUBLIQUE POUR L'APPLICATION DE LA LOI 621292 DU 06-11-1962 RELATIVE A L'ELECTION DU PRESIDENT DE LA REPUBLIQUE AU SUFFRAGE UNIVERSEL",
          "@c_titre_court": "Décret n°80-213 du 11 mars 1980",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000329032"
        },
        {
          "#text": "Décret n°80-213 du 11 mars 1980 fixant, pour les départements et les territoires d'outre-mer et les collectivités territoriales de Mayotte et de Saint-Pierre-et-Miquelon , les modalités d'application ou d'adaptation du décret n° 64-231 du 14 mars 1964 modifié portant règlement d'administration publique pour l'application de la loi n° 62-1292 du 6 novembre 1962 relative à l'élection du Président de la République au suffrage universel.",
          "@c_titre_court": "Décret n°80-213 du 11 mars 1980",
          "@debut": "1980-03-22",
          "@fin": "2002-02-23",
          "@id_txt": "LEGITEXT000006063204"
        }
      ],
      "TM": {

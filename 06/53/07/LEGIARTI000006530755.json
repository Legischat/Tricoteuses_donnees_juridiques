  "NOTA": {
    "CONTENU": "<br/>   [*NOTA : Décret 59-394 1959-03-11 abrogé par art. 25 du décret 86-170 du 7 février 1986*].<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Pour l'application de l'article 18 du décret du 14 mars 1964 susvisé, les dispositions correspondant aux deux premiers alinéas de l'article R. 39 du code électoral sont celles de l'article 20 du décret du 11 mars 1959 susvisé.<br/>\n<br/>"
  },

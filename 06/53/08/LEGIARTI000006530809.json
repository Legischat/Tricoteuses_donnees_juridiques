  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   L'administration centrale du ministère de la coopération et du développement comprend [*composition*] :<br/>\n<br/>   - la direction du développement ;<br/>\n<br/>   - la direction de l'administration générale ;<br/>\n<br/>   - la délégation de l'inspection générale ;<br/>\n<br/>   - la mission militaire de coopération ;<br/>\n<br/>   - le service des affaires financières et de la coordination géographique ;<br/>\n<br/>   - le service de la communication, de l'information et de la documentation ;<br/>\n<br/>   - la cellule d'urgence et de veille, service commun au ministère des affaires étrangères et au ministère de la coopération et du développement.<br/>"
  },

      "TITRE_TXT": [
        {
          "#text": "Décret n°88-154 du 15 février 1988 PRIS POUR L'APPLICATION DES DISPOSITIONS DE L'ART. 6 DE LA LOI 871127 DU 31-12-1987 RELATIVE AU RECRUTEMENT,A LA NOMINATION ET AU RECLASSEMENT DES CONSEILLERS DU CORPS DES TRIBUNAUX ADMINISTRATIFS ET DES COURS ADMINISTRATIVES D'APPEL",
          "@c_titre_court": "Décret n°88-154 du 15 février 1988",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000314802"
        },
        {
          "#text": "Décret n°88-154 du 15 février 1988 pris pour l'application des dispositions de l'article 6 de la loi n° 87-1127 du 31 décembre 1987 relatives au recrutement, à la nomination et au reclassement de conseillers du corps des tribunaux administratifs et des cours administratives d'appel",
          "@c_titre_court": "Décret n°88-154 du 15 février 1988",

  "NOTA": {
    "CONTENU": "<br/>   [*Ministre chargé de l'enseignement supérieur précédemment appelé ministre de l'éducation nationale; ministre chargé de la culture précédemment appelé ministre de la culture; ministre chargé de la recherche précédemment appelé ministre de la recherche; cf décret 93-720 du 29 mars 1993.*]<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {

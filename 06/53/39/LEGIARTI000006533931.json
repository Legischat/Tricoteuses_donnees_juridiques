        {
          "#text": "Décret n°84-468 du 18 juin 1984 RELATIF AUX COMMISSIONS DE L'INFORMATIQUE ET DE LA BUREAUTIQUE,A LA CREATION D'UN COMITE INTERMINISTERIEL DE L'INFORMATIQUE ET DE LA BUREAUTIQUE DANS L'ADMINISTRATION ET AU COMITE RESTREINT CHARGE DE DONNER UN AVIS SUR LES PROJETS D'EQUIPEMENTS",
          "@c_titre_court": "Décret n°84-468 du 18 juin 1984",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000337260"
        },
        {
          "#text": "Décret n°84-468 du 18 juin 1984 relatif aux commissions de l'informatique et de la bureautique, à la création d'un comité interministériel de l'informatique et de la bureautique dans l'administration et au comité restreint chargé de donner un avis sur les projets d'équipements.",
          "@c_titre_court": "Décret n°84-468 du 18 juin 1984",
          "@debut": "1984-06-29",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006064509"
        }
      ],
      "TM": {
        "TITRE_TM": [
          {
            "#text": "Chapitre III : Examen par le comité restreint des projets informatiques et de bureautique des entreprises nationales et des établissements publics dotés du caractère industriel et commercial",
            "@debut": "1984-06-29",
            "@fin": "2999-01-01",
            "@id": "LEGISCTA000006096240"
          }
        ]
      },

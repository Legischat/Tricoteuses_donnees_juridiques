      "TITRE_TXT": [
        {
          "#text": "Décret du 11 mars 1908 pris pour l'exécution de la loi du 1er août 1905 sur la répression des fraudes dans la vente des marchandises et des falsifications des denrées alimentaires et des produits agricoles en ce qui concerne les graisses et huiles comestibles",
          "@c_titre_court": "Décret du 11 mars 1908",
          "@debut": "1908-03-14",
          "@fin": "2008-02-29",
          "@id_txt": "LEGITEXT000006071231"
        }
      ],
      "@cid": "LEGITEXT000006071231",

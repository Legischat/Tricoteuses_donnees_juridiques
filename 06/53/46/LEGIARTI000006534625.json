  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret du 15 avril 1912 RAP POUR L'APPLICATION DE LA LOI DU 01-08-1905 SUR LA REPRESSION DES FRAUDES, DANS LA VENTE DES MARCHANDISES ET DES FALSIFICATIONS DES DENREES ALIMENTAIRES,EN CE QUI CONCERNE LES DENREES ALIMENTAIRES ET SPECIALEMENT LES VIANDES, PRODUITS DE LA CHARCUTERIE, FRUITS, LEGUMES, POISSONS ET CONSERVES",
          "@c_titre_court": "Décret du 15 avril 1912",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000303005"
        },
        {
          "#text": "Décret du 15 avril 1912 pris pour l'application de la loi du 1er août 1905 sur la répression des fraudes dans la vente des marchandises et des falsifications de denrées alimentaires en ce qui concerne les denrées alimentaires et spécialement les viandes, produits de la charcuterie, fruits, légumes, poissons et conserves",
          "@c_titre_court": "Décret du 15 avril 1912",
          "@debut": "1912-06-29",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006071233"
        }

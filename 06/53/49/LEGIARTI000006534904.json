  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Outre le haut fonctionnaire de défense, la mission des affaires juridiques et le bureau du cabinet, l'administration centrale du ministère de l'environnement comprend :<br/>\n<br/>   - la direction des ressources humaines, des moyens et de la qualité de la vie ;<br/>\n<br/>   - la direction de l'eau ;<br/>\n<br/>   - la direction de la prévention des pollutions et des risques ;<br/>\n<br/>   - la direction de la nature et des paysages ;<br/>\n<br/>   - la direction de la recherche et des affaires économiques et internationales.<br/>"
  },

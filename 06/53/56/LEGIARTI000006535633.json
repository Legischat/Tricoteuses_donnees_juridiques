      "TITRE_TXT": [
        {
          "#text": "Arrêté du 23 septembre 1980 HOMOLOGATION D'UNE DECISION DE LA COMMISSION NATIONALE DE L'INFORMATIQUE ET DES LIBERTES FIXANT LE MONTANT DE LA REDEVANCE PERCUE A L'OCCASION DE LA DELIVRANCE DE COPIES D'INFORMATIONS NOMINATIVES FAISANT L'OBJET DE TRAITEMENTS AUTOMATISES",
          "@c_titre_court": "Arrêté du 23 septembre 1980",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000292654"
        },
        {
          "#text": "Arrêté du 23 septembre 1980 portant homologation d'une décision de la commission nationale de l'informatique et des libertés fixant le montant de la redevance perçue à l'occasion de la délivrance de copies d'informations nominatives faisant l'objet de traitements automatisés.",
          "@c_titre_court": "Arrêté du 23 septembre 1980",
          "@debut": "1980-10-12",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006071252"
        }
      ],
      "@cid": "JORFTEXT000000292654",
      "@date_publi": "1980-10-12",
      "@date_signature": "1980-09-23",
      "@nature": "ARRETE"
    }
  },
  "VERSIONS": {

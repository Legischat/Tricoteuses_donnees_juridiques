      "TITRE_TXT": [
        {
          "#text": "Arrêté du 24 juin 1987 RELATIF AUX MODALITES DE REPRESENTATION DES PERSONNELS RELEVANT DU MINISTRE DE LA DEFENSE DANS LES COMMISSIONS CONSULTATIVES DE L'ENVIRONNEMENT DES AERODROMES DONT LE MINISTERE DE LA DEFENSE EST AFFECTATAIRE",
          "@c_titre_court": "Arrêté du 24 juin 1987",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000477706"
        },
        {
          "#text": "Arrêté du 24 juin 1987 relatif aux modalités de représentation des personnels relevant du ministre de la défense dans les commissions consultatives de l'environnement des aérodromes dont le ministère de la défense est affectataire",

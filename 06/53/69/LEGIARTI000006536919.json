  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Sont destinataires de ces informations :<br/>\n<br/>   - les sections administratives du service des pensions ;<br/>\n<br/>   - la direction de la comptabilité publique et les services déconcentrés du Trésor ;<br/>\n<br/>   - le service juridique et de l'agence judiciaire du Trésor ;<br/>\n<br/>   - les recettes des impôts pour la seule confirmation ou infirmation d'une inscription au grand-livre de la dette publique ;<br/>\n<br/>   - les administrations d'origine ou gestionnaires des pensionnés pour les seules personnes relevant de leur département.<br/>"
  },

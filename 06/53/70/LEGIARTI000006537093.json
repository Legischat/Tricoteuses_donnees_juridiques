        {
          "#text": "Décret n°83-798 du 7 septembre 1983 RELATIF A LA COMMERCIALISATION DE CERTAINS FRUITS ET LEGUMES SOUMIS A DES REGLES RENDUES OBLIGATOIRES DANS LA CIRCONSCRIPTION D'UN COMITE ECONOMIQUE AGRICOLE AGREE",
          "@c_titre_court": "Décret n°83-798 du 7 septembre 1983",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000858294"
        },
        {
          "#text": "Décret n°83-798 du 7 septembre 1983 relatif à la commercialisation de certains fruits et légumes soumis à des règles rendues obligatoires dans la circonscription d'un comité économique agricole agréé",
          "@c_titre_court": "Décret n°83-798 du 7 septembre 1983",
          "@debut": "1983-09-09",
          "@fin": "2003-09-06",
          "@id_txt": "LEGITEXT000006064241"
        }
      ],

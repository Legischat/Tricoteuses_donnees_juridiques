  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les catégories d'informations nominatives enregistrées sont les suivantes :<br/>\n<br/>   Identité :<br/>\n<br/>   -nom patronymique ;<br/>\n<br/>   -nom marital ;<br/>\n<br/>   -prénom ;<br/>\n<br/>   -date de naissance ;<br/>\n<br/>   -lieu de naissance ;<br/>\n<br/>   Logement :<br/>\n<br/>   -adresse du titulaire du compte ;<br/>\n<br/>   Vie professionnelle :<br/>\n<br/>   -profession du titulaire du compte ;<br/>\n<br/>   Informations relatives au compte :<br/>\n<br/>   -numéro du compte chèque postal clôturé ;<br/>\n<br/>   -montant du débet dudit compte.<br/>"
  }

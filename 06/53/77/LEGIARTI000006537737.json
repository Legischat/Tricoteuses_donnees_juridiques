            "@fin": "2999-01-01",
            "@id": "LEGISCTA000006096364"
          }
        ]
      },
      "@cid": "JORFTEXT000000845581",
      "@date_publi": "1932-10-13",
      "@date_signature": "1932-10-07",
      "@nature": "DECRET"

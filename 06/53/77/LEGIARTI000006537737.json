    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret du 7 octobre 1932 PORTANT RAP POUR L'APPLICATION DE LA LOI DU 01-08-1905 SUR LA REPRESSION DES FRAUDES EN CE QUI CONCERNE LE CAFE,LA CHICOREE ET LE THE",
          "@c_titre_court": "Décret du 7 octobre 1932",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000845581"
        },
        {
          "#text": "Décret du 7 octobre 1932 pris pour l'application de la loi du 1er août 1905 sur la répression des fraudes dans la vente des marchandises et des falsifications des denrées alimentaires en ce qui concerne le café, la chicorée et le thé",
          "@c_titre_court": "Décret du 7 octobre 1932",
          "@debut": "1932-10-13",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006071296"
        }
      ],
      "TM": {
        "TITRE_TM": [
          {
            "#text": "Chapitre Ier : Chicorée.",

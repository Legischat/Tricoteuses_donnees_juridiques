  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les catégories d'informations nominatives enregistrées sont les suivantes :<br/>\n<br/>   - l'identité (nom, prénom) ;<br/>\n<br/>   - l'adresse ;<br/>\n<br/>   - le téléphone (facultatif) ;<br/>\n<br/>   - la formation et les diplômes ;<br/>\n<br/>   - la vie professionnelle.<br/>"

  "BLOC_TEXTUEL": {
    "CONTENU": "TERMES FAUTIFS ET IMPROPRIETES A EVITER. <br/>\n FORME IMPROPRE :<br/>\n - analyse numérique d'image.<br/>\n FORME A RETENIR :<br/>\n - voir analyse d'image numérique.<br/>\n<br/>\n FORME IMPROPRE :<br/>\n - image satellitaire.<br/>\n FORME A RETENIR :<br/>\n - voir image-satellite, image satellitale (syn.).<br/>\n<br/>\n FORME IMPROPRE :<br/>\n - rehaussement (d'image).<br/>\n FORME A RETENIR :<br/>\n - voir accentuation (d'image).<br/>\n<br/>\n FORME IMPROPRE :<br/>\n  - site-test<br/>\n FORME A RETENIR :<br/>\n - voir zone-témoin.<br/>\n<br/>\n FORME IMPROPRE :<br/>\n - sondage du limbe.<br/>\n FORME A RETENIR :<br/>\n - voir sondage au limbe.<br/>\n<br/>\n FORME IMPROPRE :<br/>\n - traitement numérique d'image.<br/>\n FORME A RETENIR :<br/>\n - voir traitement d'image numérique.<br/>\n<br/>\n FORME IMPROPRE :<br/>\n - zone-test.<br/>\n FORME A RETENIR :<br/>\n - voir polygone d'essai.<br/>"
  },

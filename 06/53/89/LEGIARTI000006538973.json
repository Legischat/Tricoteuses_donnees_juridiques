  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les informations nominatives utilisées pour ce traitement portent sur :<br/>\n<br/>   - l'identité : nom, prénoms, date et lieu de naissance, adresse ;<br/>\n<br/>   - l'aptitude médicale ;<br/>\n<br/>   - la situation au regard des obligations du service actif :<br/>\n dispense, report, préparation militaire et demandes particulières ;<br/>\n<br/>   - les modalités de sélection, d'orientation et d'affectation.<br/>"
  },

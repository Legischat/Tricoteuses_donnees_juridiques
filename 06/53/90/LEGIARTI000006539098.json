  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   La répartition des sièges à pourvoir est fixée ainsi qu'il suit :<br/>\n<br/>\n SECTION<br/>\n ASTRONOMES,<br/>\n physiciens et personnels<br/>\n assimilés<br/>\n ASTRONOMES ADJOINTS,<br/>\n physiciens adjoints et<br/>\n personnels assimilés<br/>\n<br/>\n<br/>\n Astronomie<br/>\n 3 *<br/>\n 3 *<br/>\n Sciences de la planète<br/>\n 1 **<br/>\n 2 **<br/>\n<br/>\n<br/>   * Elections au scrutin de liste à la représentation proportionnelle.<br/>\n<br/>   ** Elections au scrutin uninominal majoritaire à deux tours.<br/>\n<br/>"
  },

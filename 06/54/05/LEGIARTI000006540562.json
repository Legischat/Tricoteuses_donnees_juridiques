        {
          "#text": "Décret n°93-1169 du 11 octobre 1993 OUVRANT AUX RESSORTISSANTS DES ETATS MEMBRES DE LA COMMUNAUTE EUROPEENNE AUTRES QUE LA FRANCE L'ACCES A CERTAINS CORPS DE FONCTIONNAIRES DU MINISTERE DE L'AGRICULTURE ET DE LA PECHE",
          "@c_titre_court": "Décret n°93-1169 du 11 octobre 1993",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000335505"
        },
        {
          "#text": "Décret n°93-1169 du 11 octobre 1993 ouvrant aux ressortissants des Etats membres de la Communauté européenne autres que la France l'accès à certains corps de fonctionnaires du ministère de l'agriculture et de la pêche",
          "@c_titre_court": "Décret n°93-1169 du 11 octobre 1993",
          "@debut": "1993-10-16",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006067811"

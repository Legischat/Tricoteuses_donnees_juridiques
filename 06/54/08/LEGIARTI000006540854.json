    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret n°84-271 du 11 avril 1984 FIXANT LES CONDITIONS DE REMBOURSEMENT DES FRAIS AFFERENTS AUX CONTROLES PRESCRITS EN APPLICATION DE L'ART. 7 DE LA LOI 83660 DU 21-07-1983 RELATIVE A LA SECURITE DES CONSOMMATEURS",
          "@c_titre_court": "Décret n°84-271 du 11 avril 1984",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000701405"
        },
        {
          "#text": "Décret n°84-271 du 11 avril 1984 relatif à la fixation des conditions de remboursement des frais afférents aux contrôles prescrits en application de l'article 7 de la loi n° 83-660 du 21 juillet 1983 relative à la sécurité des consommateurs",
          "@c_titre_court": "Décret n°84-271 du 11 avril 1984",
          "@debut": "1984-04-13",
          "@fin": "1997-04-03",
          "@id_txt": "LEGITEXT000006064433"
        }
      ],

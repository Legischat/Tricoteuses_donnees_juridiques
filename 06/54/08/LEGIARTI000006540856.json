  "NOTA": {
    "CONTENU": "<p>Décret n° 2009-1484 du 3 décembre 2009, article 23 (II, 5°) : Abrogation, sous réserve de l'article 22, du décret n° 94-169 du 25 février 1994.</p>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les services déconcentrés du ministère de la jeunesse et des sports sont constitués par les directions régionales et les directions départementales de la jeunesse et des sports.<br/>\n<br/>   Les établissements publics relevant du ministre chargé de la jeunesse et des sports sont :<br/>\n les écoles et instituts nationaux de la jeunesse et des sports ;<br/>\n les centres d'éducation populaire et de sport.<br/>"
  },

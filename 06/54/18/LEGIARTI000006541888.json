  "NOTA": {
    "CONTENU": "<br/>   NOTA : Décret 2005-1677 2005-12-28 art. 361 : Spécificité d'application.<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Sont radiées d'office les mentions relatives aux décisions mentionnées à l'article 36-1-1 lorsque :<br/>\n<br/>   1° Il a été mis fin à une procédure de sauvegarde en application de l'article L. 622-12 du code de commerce ;<br/>\n<br/>   2° Il a été mis fin à une procédure de redressement en application de l'article L. 631-16 du même code ;<br/>\n<br/>   3° Il a été constaté l'achèvement de l'exécution du plan de sauvegarde ou de redressement en application de l'article L. 626-28 du même code.<br/>"
  },

        {
          "#text": "Décret n°86-451 du 14 mars 1986 PRIS EN APPLICATION DE L'ART. 16 DE L'ORDONNANCE 592 DU 02-01-1959 PORTANT LOI ORGANIQUE RELATIVE AUX LOIS DE FINANCES EN CE QUI CONCERNE LA COMPTABILISATION DES RECETTES ET DES DEPENSES DE L'ETAT",
          "@c_titre_court": "Décret n°86-451 du 14 mars 1986",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000337745"
        },
        {
          "#text": "Décret n°86-451 du 14 mars 1986 pris en application de l'article 16 de l'ordonnance n° 59-2 du 2 janvier 1959 portant loi organique relative aux lois de finances en ce qui concerne la comptabilisation des recettes et dépenses de l'Etat.",
          "@c_titre_court": "Décret n°86-451 du 14 mars 1986",
          "@debut": "1986-11-01",
          "@fin": "2016-06-17",

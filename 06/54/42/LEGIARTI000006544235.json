      "TITRE_TXT": [
        {
          "#text": "Décret n°47-1448 du 2 août 1947 RAP POUR L'APPLICATION DE LA LOI DU 1 août 1905 ET RENDANT OBLIGATOIRE UNE MARQUE SPECIALE SUR LES FRUITS, LEGUMES, SEMENCES ET PLANTS EXPORTES A L'ETRANGER (\"LABEL D'EXPORTATION\")",
          "@c_titre_court": "Décret n°47-1448 du 2 août 1947",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000673341"
        },
        {
          "#text": "Décret n°47-1448 du 2 août 1947 pris pour l'application de la loi du 1er août 1905 et rendant obligatoire une marque spéciale sur les fruits, légumes, semences et plants exportés à l'étranger",
          "@c_titre_court": "Décret n°47-1448 du 2 août 1947",
          "@debut": "1947-08-05",
          "@fin": "2016-07-01",

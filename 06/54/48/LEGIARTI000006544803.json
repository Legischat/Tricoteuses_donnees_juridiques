      "TITRE_TXT": [
        {
          "#text": "Arrêté du 3 octobre 1991 ETENDANT A L'ENSEMBLE DES FILIALES DE LA FRANCAISE DES JEUX LES DISPOSITIONS DE L'ART. 2 DU DECRET DU 09-08-1953 MODIFIE SUR LES ENTREPRISES PUBLIQUES NATIONALES ET CERTAINS ORGANISMES AYANT UN OBJET D'ORDRE ECONOMIQUE OU SOCIAL",
          "@c_titre_court": "Arrêté du 3 octobre 1991",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000298230"
        },
        {
          "#text": "Arrêté du 3 octobre 1991 étendant à l'ensemble des filiales de La Française des jeux les dispositions de l'article 2 du décret du 9 août 1953 modifié sur les entreprises publiques nationales et certains organismes ayant un objet d'ordre économique ou social",
          "@c_titre_court": "Arrêté du 3 octobre 1991",

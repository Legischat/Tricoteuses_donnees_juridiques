  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Arrêté du 27 novembre 1991 AUTORISANT LE TRAITEMENT INFORMATISE DES DOSSIERS MEDICO-ECONOMIQUES ET EPIDEMIOLOGIQUES DE L'IMMUNODEFICIENCE HUMAINE DANS LES CENTRES D'INFORMATION ET DE SOINS DE L'IMMUNODEFICIENCE HUMAINE (CISIH) ET AUTRES ETABLISSEMENTS HOSPITALIERS",
          "@c_titre_court": "Arrêté du 27 novembre 1991",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000665271"
        },
        {
          "#text": "Arrêté du 27 novembre 1991 autorisant le traitement informatisé des dossiers médico-économiques et épidémiologiques de l'immunodéficience humaine dans les centres d'information et de soins de l'immunodéficience humaine et autres établissements hospitaliers",
          "@c_titre_court": "Arrêté du 27 novembre 1991",
          "@debut": "1992-01-17",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006059907"
        }
      ],
      "@cid": "JORFTEXT000000665271",
      "@date_publi": "1992-01-17",
      "@date_signature": "1991-11-27",
      "@nature": "ARRETE",
      "@nor": "SANH9102617A"
    }
  },

        {
          "#text": "Décret n°53-1048 du 26 octobre 1953 PORTANT REGLEMENT D'ADMINISTRATION PUBLIQUE POUR L'APPLICATION DES LOIS DES 01-08-1905 ET 02-07-1935 SUR LA REPRESSION DES FRAUDES ET L'ORGANISATION DU MARCHE DU LAIT",
          "@c_titre_court": "Décret n°53-1048 du 26 octobre 1953",
          "@debut": "2999-01-01",

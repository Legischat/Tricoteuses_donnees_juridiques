      "TITRE_TXT": [
        {
          "#text": "Décret n°71-468 du 18 juin 1971 PORTANT APPLICATION AUX DOM DE L'ORDONNANCE MODIFIEE 581352 DU 27 décembre 1958 REPRIMANT CERTAINES INFRACTIONS EN MATIERE DE REGISTRE DU COMMERCE ET ETENDANT AUXDITS DEPARTEMENTS LE DECRET MODIFIE 67237 DU 23 MARS 1967 RELATIF AU REGISTRE DU COMMERCE",
          "@c_titre_court": "Décret n°71-468 du 18 juin 1971",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000875826"
        },
        {
          "#text": "Décret n°71-468 du 18 juin 1971 portant application aux départements de la Guadeloupe, de la Guyane, de la Martinique et de la Réunion de l'ordonnance modifiée n° 58-1352 du 27 décembre 1958 réprimant certaines infractions en matière de registre du commerce et étendant auxdits départements le décret modifié n° 67-237 du 23 mars 1967 relatif au registre du commerce",
          "@c_titre_court": "Décret n°71-468 du 18 juin 1971",
          "@debut": "1971-06-22",
          "@fin": "2023-01-01",

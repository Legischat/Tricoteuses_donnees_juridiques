        {
          "#text": "Décret n°85-872 du 14 août 1985 PORTANT APPLICATION DE LA LOI DU 01-08-1905 SUR LES FRAUDES ET FALSIFICATIONS EN MATIERE DE PRODUITS OU DE SERVICES EN CE QUI CONCERNE LES CONFITURES,GELEES ET MARMELADES DE FRUITS OU AUTRES PRODUITS SIMILAIRES",
          "@c_titre_court": "Décret n°85-872 du 14 août 1985",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000323153"
        },
        {
          "#text": "Décret n°85-872 du 14 août 1985 portant application de la loi du 1er août 1905 sur les fraudes et falsifications en matière de produits ou de services en ce qui concerne les confitures, gelées et marmelades de fruits et autres produits similaires",
          "@c_titre_court": "Décret n°85-872 du 14 août 1985",
          "@debut": "1985-08-20",
          "@fin": "2999-01-01",

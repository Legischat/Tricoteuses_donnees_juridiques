  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Le diplôme d'Etat supérieur de la jeunesse, de l'éducation populaire et du sport est délivré :<br/>\n<br/>   1° Soit par la voie des unités capitalisables ;<br/>\n<br/>   2° Soit par la voie de la validation des acquis de l'expérience ;<br/>\n<br/>   3° Soit par la voie d'un examen composé d'épreuves ponctuelles.<br/>"
  },

  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les ressources de l'établissement comprennent :<br/>\n<br/>   1° Les subventions, avances, fonds de concours et autres contributions attribués par l'Etat, les collectivités territoriales, les établissements publics et par toute autre personne ;<br/>\n<br/>   2° Le produit des concessions ;<br/>\n<br/>   3° Le produit des aliénations ;<br/>\n<br/>   4° Les dons et legs ;<br/>\n<br/>   5° Le produit de la gestion de son patrimoine ;<br/>\n<br/>   6° D'une manière générale, toutes les recettes autorisées par les lois et règlements.<br/>"
  }

        },
        {
          "#text": "Décret n°63-695 du 10 juillet 1963 pris pour l'application de la loi du 1er août 1905 sur la répression des fraudes en ce qui concerne les laits fermentés et le yaourt ou yoghourt",
          "@c_titre_court": "Décret n°63-695 du 10 juillet 1963",
          "@debut": "1963-07-16",
          "@fin": "1988-12-31",
          "@id_txt": "LEGITEXT000006061143"
        }
      ],

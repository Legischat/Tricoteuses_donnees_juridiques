  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret n°64-863 du 19 août 1964 PORTANT RAP ET COMPLETANT, EN CE QUI CONCERNE LES OEUFS EN COQUILLE ET LES VOLAILLES ABATTUES AINSI QUE LES FLEURS ET FEUILLAGES COUPES, LES DISPOSITIONS DU DECRET 471448 DU 2 août 1947 RENDANT OBLIGATOIRE UNE MARQUE SPECIALE SUR CERTAINS PRODUITS AGRICOLES EXPORTES A L'ETRANGER",
          "@c_titre_court": "Décret n°64-863 du 19 août 1964",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000303045"
        },
        {
          "#text": "Décret n°64-863 du 19 août 1964 complétant, en ce qui concerne les oeufs en coquille et les volailles abattues ainsi que les fleurs et feuillages coupés, les dispositions du décret n° 47-1448 du 2 août 1947 rendant obligatoire une marque spéciale sur certains produits agricoles exportés à l'étranger",
          "@c_titre_court": "Décret n°64-863 du 19 août 1964",
          "@debut": "1964-08-25",
          "@fin": "2016-07-01",
          "@id_txt": "LEGITEXT000006061228"
        }
      ],
      "@cid": "JORFTEXT000000303045",
      "@date_publi": "1964-08-25",
      "@date_signature": "1964-08-19",
      "@nature": "DECRET",
      "@num": "64-863"
    }
  },

      "TITRE_TXT": [
        {
          "#text": "Décret n°86-1400 du 31 décembre 1986 RELATIF A L'OBSERVATION DES PRIX ET DES COUTS DES TRANSPORTS ROUTIERS DE MARCHANDISES ET A L'INSTAURATION DE TARIFS DE REFERENCE A CARACTERE INDICATIF",
          "@c_titre_court": "Décret n°86-1400 du 31 décembre 1986",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000700524"
        },
        {
          "#text": "Décret n°86-1400 du 31 décembre 1986 relatif à l'observation des prix et des coûts des transports routiers de marchandises et à l'instauration de tarifs de référence à caractère indicatif",
          "@c_titre_court": "Décret n°86-1400 du 31 décembre 1986",
          "@debut": "1987-01-08",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006065371"
        }
      ],

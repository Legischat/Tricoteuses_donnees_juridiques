      "TITRE_TXT": [
        {
          "#text": "Décret n°78-1109 du 23 novembre 1978 PRIS POUR L'APPLICATION DE LA LOI DU 1 août 1905 SUR LES FRAUDES ET FALSIFICATIONS EN MATIERE DE PRODUITS OU DE SERVICES EN CE QUI CONCERNE LES JUS DE FRUITS ET CERTAINS PRODUITS SIMILAIRES",
          "@c_titre_court": "Décret n°78-1109 du 23 novembre 1978",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000519428"
        },
        {
          "#text": "Décret n°78-1109 du 23 novembre 1978 pris pour l'application de la loi du 1er août 1905 sur les fraudes et falsifications de produits ou de services en ce qui concerne les jus de fruits et certains produits similaires",
          "@c_titre_court": "Décret n°78-1109 du 23 novembre 1978",
          "@debut": "1978-11-29",
          "@fin": "2003-07-12",

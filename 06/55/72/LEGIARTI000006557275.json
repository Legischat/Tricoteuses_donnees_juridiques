  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   La direction de la recherche et de l'animation scientifique et technique comprend :<br/>\n<br/>   - la sous-direction des affaires financières et internationales ;<br/>\n<br/>   - la sous-direction du développement scientifique et technique ;<br/>\n<br/>   - le centre de prospective et de veille scientifiques et technologiques ;<br/>\n<br/>   - la mission de l'information géographique ;<br/>\n<br/>   - la mission de la recherche et de l'innovation dans les transports ;<br/>\n<br/>   - la mission de la recherche et de l'innovation en génie civil ;<br/>\n<br/>   - la mission des infrastructures et applications satellitaires.<br/>\n<br/>   Le directeur de la recherche et de l'animation scientifique et technique est assisté d'un adjoint.<br/>"
  },

        {
          "#text": "Décret n°72-200 du 13 mars 1972 réglementant le commerce et l'importation des seringues et des aiguilles destinées aux injections parentérales en vue de lutter contre l'extension de la toxicomanie",
          "@c_titre_court": "Décret n°72-200 du 13 mars 1972",
          "@debut": "1972-03-14",
          "@fin": "2003-05-27",
          "@id_txt": "LEGITEXT000006061913"
        }
      ],

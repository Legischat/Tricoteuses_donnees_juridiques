      "TITRE_TXT": [
        {
          "#text": "Décret n°88-416 du 22 avril 1988 PORTANT APPLICATION DE LA LOI DU 01-08-1905 SUR LES FRAUDES ET FALSIFICATIONS EN MATIERE DE PRODUITS OU DE SERVICE EN CE QUI CONCERNE LES RHUMS ET LES TAFIAS.",
          "@c_titre_court": "Décret n°88-416 du 22 avril 1988",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000873035"
        },
        {
          "#text": "Décret n° 88-416 du 22 avril 1988 portant application de la loi du 1er août 1905 sur les fraudes et falsifications en matière de produits ou de services en ce qui concerne les rhums d'appellation d'origine",
          "@c_titre_court": "Décret n° 88-416 du 22 avril 1988",
          "@debut": "1992-03-30",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006066586"
        },
        {
          "#text": "Décret n°88-416 du 22 avril 1988 portant application de la loi du 1er août 1905 sur les fraudes et falsifications en matière de produits ou de services en ce qui concerne les rhums et les tafias",
          "@c_titre_court": "Décret n°88-416 du 22 avril 1988",

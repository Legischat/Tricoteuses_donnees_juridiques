  "NOTA": {
    "CONTENU": "<br/>   [* Dispositions applicables dans la collectivité territoriale de Mayotte. *]<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Au siège de chaque tribunal administratif, le greffe comprend un [*composition*] greffier en chef et, s'il y a lieu, un ou plusieurs greffiers.<br/>\n<br/>   Au siège de chaque cour administrative d'appel, le greffe comprend un greffier en chef et des greffiers.<br/>\n<br/>   Le greffier en chef et les greffiers sont choisis parmi les fonctionnaires des corps des personnels de préfecture, selon le cas par le président du tribunal administratif ou le président de la cour administrative d'appel.<br/>\n<br/>   Les greffiers en chef doivent avoir au moins le grade d'attaché et les greffiers au moins celui de secrétaire administratif.<br/>"
  },

  "NOTA": {
    "CONTENU": "<br/>   [* Dispositions applicables dans la collectivité territoriale de Mayotte. *]<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Devant la cour administrative d'appel, l'Etat est dispensé de ministère d'avocat soit en demande, soit en défense, soit en intervention. Les ministres intéressés présentent devant la cour administrative d'appel les mémoires et observations produits au nom de l'Etat.<br/>\n<br/>"
  },

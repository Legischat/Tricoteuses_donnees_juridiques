  "BLOC_TEXTUEL": {
    "CONTENU": "<p>Le temps passé dans chaque échelon des différents grades est fixé ainsi qu'il suit :</p>\n<table>\n<tbody>\n<tr>\n<td width=\"189\">\n<p align=\"center\">GRADES ET ÉCHELONS</p>\n</td>\n<td width=\"189\">\n<p align=\"center\">DURÉE DES ECHELONS</p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" width=\"378\">\n<p align=\"center\">Inspecteur général</p>\n</td>\n</tr>\n<tr>\n<td width=\"189\">\n<p>4e échelon</p>\n</td>\n<td width=\"189\">\n<p align=\"center\">Sans durée</p>\n</td>\n</tr>\n<tr>\n<td width=\"189\">\n<p>3e échelon</p>\n</td>\n<td width=\"189\">\n<p align=\"center\">3 ans</p>\n</td>\n</tr>\n<tr>\n<td width=\"189\">\n<p>2e échelon</p>\n</td>\n<td width=\"189\">\n<p align=\"center\">3 ans</p>\n</td>\n</tr>\n<tr>\n<td width=\"189\">\n<p>1er échelon</p>\n</td>\n<td width=\"189\">\n<p align=\"center\">3 ans</p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" width=\"378\">\n<p align=\"center\">Inspecteur et conseiller de 1re classe</p>\n</td>\n</tr>\n<tr>\n<td width=\"189\">\n<p>7e échelon</p>\n</td>\n<td width=\"189\">\n<p align=\"center\">Sans durée</p>\n</td>\n</tr>\n<tr>\n<td width=\"189\">\n<p>6e échelon</p>\n</td>\n<td width=\"189\">\n<p align=\"center\">3 ans</p>\n</td>\n</tr>\n<tr>\n<td width=\"189\">\n<p>5e échelon</p>\n</td>\n<td width=\"189\">\n<p align=\"center\">3 ans</p>\n</td>\n</tr>\n<tr>\n<td width=\"189\">\n<p>4e échelon </p>\n</td>\n<td width=\"189\">\n<p align=\"center\">2 ans</p>\n</td>\n</tr>\n<tr>\n<td width=\"189\">\n<p>3e échelon</p>\n</td>\n<td width=\"189\">\n<p align=\"center\">2 ans</p>\n</td>\n</tr>\n<tr>\n<td width=\"189\">\n<p>2e échelon</p>\n</td>\n<td width=\"189\">\n<p align=\"center\">2 ans</p>\n</td>\n</tr>\n<tr>\n<td width=\"189\">\n<p>1er échelon</p>\n</td>\n<td width=\"189\">\n<p align=\"center\">2 ans</p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" width=\"378\">\n<p align=\"center\">Inspecteur et conseiller de 2e classe</p>\n</td>\n</tr>\n<tr>\n<td width=\"189\">\n<p>7e échelon</p>\n</td>\n<td width=\"189\">\n<p align=\"center\">Sans durée</p>\n</td>\n</tr>\n<tr>\n<td width=\"189\">\n<p>6e échelon</p>\n</td>\n<td width=\"189\">\n<p align=\"center\">2 ans</p>\n</td>\n</tr>\n<tr>\n<td width=\"189\">\n<p>5e échelon</p>\n</td>\n<td width=\"189\">\n<p align=\"center\">2 ans</p>\n</td>\n</tr>\n<tr>\n<td width=\"189\">\n<p>4e échelon</p>\n</td>\n<td width=\"189\">\n<p align=\"center\">2 ans</p>\n</td>\n</tr>\n<tr>\n<td width=\"189\">\n<p>3e échelon </p>\n</td>\n<td width=\"189\">\n<p align=\"center\">2 ans</p>\n</td>\n</tr>\n<tr>\n<td width=\"189\">\n<p>2e échelon</p>\n</td>\n<td width=\"189\">\n<p align=\"center\">2 ans</p>\n</td>\n</tr>\n<tr>\n<td width=\"189\">\n<p>1er échelon</p>\n</td>\n<td width=\"189\">\n<p align=\"center\">2 ans</p>\n</td>\n</tr>\n</tbody>\n</table>."

      "TITRE_TXT": [
        {
          "#text": "Décret n°88-683 du 6 mai 1988 RELATIF A L'UTILISATION DES MOUSSES UREE-FORMOL DANS LES LOCAUX A USAGE D'HABITATION OU DESTINES A UNE OCCUPATION HUMAINE PERMANENTE OU SEMI-PERMANENTE",
          "@c_titre_court": "Décret n°88-683 du 6 mai 1988",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000692877"
        },
        {
          "#text": "Décret n°88-683 du 6 mai 1988 relatif à l'utilisation des mousses urée-formol dans les locaux à usage d'habitation ou destinés à une occupation humaine permanente ou semi-permanente",
          "@c_titre_court": "Décret n°88-683 du 6 mai 1988",
          "@debut": "1988-05-08",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006066747"
        }
      ],

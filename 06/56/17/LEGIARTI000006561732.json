    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret n°73-784 du 9 août 1973 FIXANT LES MENTIONS DEVANT FIGURER SUR LE FORMULAIRE DETACHABLE DESTINE A FACILITER L'EXERCICE DE LA FACULTE DE RENONCIATION PREVUE PAR LA LOI 721137 DU 22 décembre 1972 RELATIVE A LA PROTECTION DES CONSOMMATEURS EN MATIERE DE DEMARCHAGE ET VENTE A DOMICILE",
          "@c_titre_court": "Décret n°73-784 du 9 août 1973",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000303605"
        },
        {
          "#text": "Décret n°73-784 du 9 août 1973 fixant les mentions devant figurer sur le formulaire détachable destiné à faciliter l'exercice de la faculté de renonciation prévue par la loi n° 72-1137 du 22 décembre 1972",
          "@c_titre_court": "Décret n°73-784 du 9 août 1973",

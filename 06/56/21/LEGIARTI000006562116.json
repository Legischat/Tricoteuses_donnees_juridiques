  "NOTA": {
    "CONTENU": "<p>Le décret n° 98-58 a été abrogé deux fois : par l'article 3 I du décret n° 2007-431 du 25 mars 2007 et par l'article 5 I du décret n° 2007-912 du 15 mai 2007.</p>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Le décret du 2 février 1939 relatif à la délivrance des cartes d'identité de commerçant pour les étrangers est abrogé.<br/>\n<br/>"
  },

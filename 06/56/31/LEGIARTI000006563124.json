        {
          "#text": "Décret n°83-50 du 26 janvier 1983 FIXANT LE REGIME DE REMUNERATION APPLICABLE AUX INSTITUTEURS NOMMES DANS CERTAINS EMPLOIS OU EXERCANT CERTAINES FONCTIONS.",
          "@c_titre_court": "Décret n°83-50 du 26 janvier 1983",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000877013"
        },
        {
          "#text": "Décret n°83-50 du 26 janvier 1983 fixant le régime de rémunération applicable aux instituteurs et professeurs des écoles nommés sur certains emplois ou exerçant certaines fonctions.",
          "@c_titre_court": "Décret n°83-50 du 26 janvier 1983",
          "@debut": "1990-09-01",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006064144"
        }

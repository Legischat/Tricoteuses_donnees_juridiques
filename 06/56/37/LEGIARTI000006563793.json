      "TITRE_TXT": [
        {
          "#text": "Décret n°64-171 du 21 février 1964 FIXANT LES MODALITES DE LA REMUNERATION SPECIALE DES PERSONNELS MEMBRES, PENSIONNAIRES ET AGENTS FRANCAIS DES GRANDS ETABLISSEMENTS D'ENSEIGNEMENT SUPERIEUR A L'ETRANGER RELEVANT DU MINISTERE DE L'EDUCATION NATIONALE",
          "@c_titre_court": "Décret n°64-171 du 21 février 1964",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000684655"
        },
        {
          "#text": "Décret n°64-171 du 21 février 1964 fixant les modalités de la rémunération spéciale des personnels, membres, pensionnaires et agents français des grands établissements d'enseignement supérieur à l'étranger relevant du ministère de l'éducation nationale.",
          "@c_titre_court": "Décret n°64-171 du 21 février 1964",
          "@debut": "1963-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006061188"
        }
      ],
      "@cid": "JORFTEXT000000684655",

      "TITRE_TXT": [
        {
          "#text": "Décret n°88-1205 du 30 décembre 1988 REGLEMENTANT LA FABRICATION ET LA VENTE DE LA MARGARINE ET DES AUTRES MELANGES DE MATIERES GRASSES QUI NE SONT PAS EXCLUSIVEMENT D'ORIGINE LAITIERE",
          "@c_titre_court": "Décret n°88-1205 du 30 décembre 1988",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000687341"
        },
        {
          "#text": "Décret n°88-1205 du 30 décembre 1988 réglementant la fabrication et la vente de la margarine et des autres mélanges de matières grasses qui ne sont pas exclusivement d'origine laitière",
          "@c_titre_court": "Décret n°88-1205 du 30 décembre 1988",
          "@debut": "1988-12-31",

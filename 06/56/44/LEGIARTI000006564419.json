  "BLOC_TEXTUEL": {
    "CONTENU": "<p>Les membres du corps des administrateurs de l'Institut national de la statistique et des études économiques sont reclassés conformément au tableau de correspondance ci-après :</p>\n<table>\n<tbody>\n<tr>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">SITUATION antérieure</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">SITUATION nouvelle</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">ANCIENNETE</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">\n<i>Administrateur de l'Institut national de la statistique et des études économiques hors classe</i>\n</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">\n<i>Administrateur de l'Institut national de la statistique et des études économiques hors classe</i>\n</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<pre> </pre>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"top\">\n<p align=\"justify\">7<sup>e</sup> échelon</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">7<sup>e</sup> échelon</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"justify\">Ancienneté conservée dans la limite de la durée de l'échelon</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"top\">\n<p align=\"justify\">6<sup>e</sup> échelon</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">6<sup>e</sup> échelon</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<pre> </pre>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"top\">\n<p align=\"justify\">5<sup>e</sup> échelon</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">5<sup>e</sup> échelon</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<pre> </pre>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"top\">\n<p align=\"justify\">4<sup>e</sup> échelon</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">4<sup>e</sup> échelon</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<pre> </pre>\n</td>\n</tr>\n<tr>\n<td align=\"lef
        {
          "#text": "Décret n°75-789 du 21 août 1975 FIXANT LE STATUT PARTICULIER DU CORPS DES MONITEURS-EDUCATEURS DES ETABLISSEMENTS NATIONAUX DE BIENFAISANCE.",
          "@c_titre_court": "Décret n°75-789 du 21 août 1975",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000335498"
        },
        {
          "#text": "Décret n°75-789 du 21 août 1975 fixant le statut particulier du corps des moniteurs-éducateurs des instituts nationaux de jeunes sourds et de l'Institut national des jeunes aveugles.",
          "@c_titre_court": "Décret n°75-789 du 21 août 1975",
          "@debut": "1998-01-08",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006062373"
        }
      ],

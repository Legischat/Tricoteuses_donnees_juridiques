    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret n°80-719 du 11 septembre 1980 MODIFIANT LE DECRET 73-264 DU 06-03-1973 RELATIF AU STATUT PARTICULIER DES INGENIEURS DES TRAVAUX GEOGRAPHIQUES ET CARTOGRAPHIQUES DE L'ETAT",
          "@c_titre_court": "Décret n°80-719 du 11 septembre 1980",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000862240"
        },
        {
          "#text": "Décret n°80-719 du 11 septembre 1980 modifiant le décret n° 73-264 du 6 mars 1973 relatif au statut particulier des ingénieurs des travaux géographiques et cartographiques de l'Etat.",
          "@c_titre_court": "Décret n°80-719 du 11 septembre 1980",
          "@debut": "1980-09-17",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006063314"
        }

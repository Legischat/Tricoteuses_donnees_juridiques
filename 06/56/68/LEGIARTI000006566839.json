  "BLOC_TEXTUEL": {
    "CONTENU": "<p>Les protes principaux adjoints en fonctions à la date d'application du présent décret sont reclassés dans le grade de prote principal, conformément au tableau de correspondance ci-après :</p>\n<br/>\n<table>\n<tbody>\n<tr>\n<td>\n<p align=\"center\">SITUATION ANCIENNE</p>\n</td>\n<td>\n<p align=\"center\">SITUATION NOUVELLE</p>\n</td>\n<td>\n<p align=\"center\">ANCIENNETÉ D'ÉCHELON </p>\n<br/>\n<p align=\"center\">conservée</p>\n</td>\n</tr>\n<tr>\n<td>\n<p>Prote principal adjoint :</p>\n</td>\n<td>\n<p>Prote principal :</p>\n</td>\n<td>\n<pre> </pre>\n</td>\n</tr>\n<tr>\n<td>\n<p>2e échelon :</p>\n</td>\n<td>\n<pre> </pre>\n</td>\n<td>\n<pre> </pre>\n</td>\n</tr>\n<tr>\n<td>\n<p>Après 2 ans</p>\n</td>\n<td>\n<p align=\"center\">2e échelon</p>\n</td>\n<td>\n<p>Ancienneté acquise diminuée de 2 ans.</p>\n</td>\n</tr>\n<tr>\n<td>\n<p>Avant 2 ans</p>\n</td>\n<td>\n<p align=\"center\">1er échelon</p>\n</td>\n<td>\n<p>Ancienneté acquise.</p>\n</td>\n</tr>\n<tr>\n<td rowspan=\"2\">\n<p>1er échelon</p>\n</td>\n<td rowspan=\"2\">\n<p align=\"center\">1er échelon</p>\n</td>\n<td rowspan=\"2\">\n<p>Sans ancienneté.</p>\n</td>\n</tr>\n</tbody>\n</table>\n<br/>"
  }
}
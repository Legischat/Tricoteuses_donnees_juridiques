        {
          "#text": "Décret n°69-444 du 14 mai 1969 FIXANT LE STATUT DU PERSONNEL ENSEIGNANT DES ECOLES NATIONALES SUPERIEURES DES MINES DE PARIS ET SAINT-ETIENNE.",
          "@c_titre_court": "Décret n°69-444 du 14 mai 1969",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",

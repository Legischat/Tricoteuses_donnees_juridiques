    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret n°88-505 du 29 avril 1988 MODIFIANT LE DECRET 69444 DU 14-05-1969 FIXANT LE STATUT DU PERSONNEL ENSEIGNANT DES ECOLES NATIONALES SUPERIEURES DES MINES DE PARIS ET DE SAINT-ETIENNE ET PORTANT EXTENSION DE SES DISPOSITIONS AU PERSONNEL ENSEIGNANT DES ECOLES NATIONALES SUPERIEURES DES TECHNIQUES INDUSTRIELLES ET DES MINES DE DOUAI ET L'ALES",
          "@c_titre_court": "Décret n°88-505 du 29 avril 1988",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000510105"
        },
        {
          "#text": "Décret n°88-505 du 29 avril 1988 modifiant le décret n° 69-444 du 14 mai 1969 fixant le statut du personnel enseignant des écoles nationales supérieures des mines de Paris et de Saint-Etienne et portant extension de ses dispositions au personnel enseignant des écoles nationales supérieures des techniques industrielles et des mines de Douai et d'Alès.",
          "@c_titre_court": "Décret n°88-505 du 29 avril 1988",
          "@debut": "1988-05-05",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006066634"
        }

  "BLOC_TEXTUEL": {
    "CONTENU": "<p>   Les instructeurs en fonctions à la date de publication du présent décret sont reclassés dans la nouvelle carrière, conformément au tableau ci-après :</p>\n<table>\n<tbody>\n<tr>\n<td align=\"center\" colspan=\"2\">ANCIENNE CARRIERE <br/>\n</td>\n<td align=\"center\" colspan=\"2\">NOUVELLE CARRIERE <br/>\n</td>\n</tr>\n<tr>\n<td align=\"center\">Echelons <br/>\n</td>\n<td align=\"center\">\n<p>Ancienneté </p>\n<p>dans l'échelon. </p>\n</td>\n<td align=\"center\">Echelons <br/>\n</td>\n<td align=\"center\">\n<p>Ancienneté dans l'échelon. </p>\n</td>\n</tr>\n<tr>\n<td align=\"center\">Stage : <br/>\n</td>\n<td align=\"center\"> </td>\n<td align=\"center\">Stage :  <br/>\n</td>\n<td align=\"center\"> </td>\n</tr>\n<tr>\n<td align=\"center\">1er échelon <br/>\n</td>\n<td align=\"center\">Moins de 1 an <br/>\n</td>\n<td align=\"center\">1er échelon <br/>\n</td>\n<td align=\"center\">Ancienneté maintenue <br/>\n</td>\n</tr>\n<tr>\n<td align=\"center\">1er échelon <br/>\n</td>\n<td align=\"center\">Plus de 1 an <br/>\n</td>\n<td align=\"center\">2e échelon <br/>\n</td>\n<td align=\"center\">Ancienneté diminuée de 1 an <br/>\n</td>\n</tr>\n<tr>\n<td align=\"center\"> 2e échelon</td>\n<td align=\"center\"> </td>\n<td align=\"center\">3e échelon <br/>\n</td>\n<td align=\"center\">Ancienneté maintenue <br/>\n</td>\n</tr>\n<tr>\n<td align=\"center\"> 3e échelon</td>\n<td align=\"center\"> </td>\n<td align=\"center\"> 4e échelon</td>\n<td align=\"center\">Ancienneté maintenue <br/>\n</td>\n</tr>\n<tr>\n<td align=\"center\"> 4e échelon</td>\n<td align=\"center\"> </td>\n<td align=\"center\"> 5e échelon</td>\n<td align=\"center\"> Ancienneté maintenue</td>\n</tr>\n<tr>\n<td align=\"center\"> 5e échelon</td>\n<td align=\"center\"> </td>\n<td align=\"center\"> 6e échelon</td>\n<td align=\"center\"> Ancienneté maintenue</td>\n</tr>\n<tr>\n<td align=\"center\">6e échelon <br/>\n</td>\n<td align=\"center\"> </td>\n<td align=\"center\">7e échelon <br/>\n</td>\n<td align=\"center\"> Ancienneté maintenue</td>\n</tr>\n<tr>\n<td align=\"center\">7e échelon <br/>\n</td>\n<td align=\"center\"> </td>\n<td align=\"center\"> 8e échelon</td>\n<td align=\"center\"> Ancienneté maintenue</td>\n</tr>\n</tbody>\n</table>\n<br/>"

      "TITRE_TXT": [
        {
          "#text": "Décret n° 2001-515 du 13 juin 2001 relatif à l'utilisation des listes complémentaires d'admission pour le recrutement par voie de concours des fonctionnaires du ministère de l'économie, des finances et de l'industrie",
          "@c_titre_court": "Décret n° 2001-515 du 13 juin 2001",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000769554"
        },
        {
          "#text": "Décret n°2001-515 du 13 juin 2001 relatif à l'utilisation des listes complémentaires d'admission pour le recrutement par voie de concours des fonctionnaires du ministère de l'économie, des finances et de l'industrie",
          "@c_titre_court": "Décret n°2001-515 du 13 juin 2001",

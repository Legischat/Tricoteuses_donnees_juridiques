  "BLOC_TEXTUEL": {
    "CONTENU": "<p align=\"center\">CENTRE NATIONAL DE LA RECHERCHE SCIENTIFIQUE</p>\n<br/>\n<table>\n<tbody>\n<tr>\n<td align=\"center\">DESIGNATION DES EMPLOIS <br/>\n</td>\n<td align=\"center\">\n<p> NIVEAU </p>\n<p>des responsabilités </p>\n<p>exercées </p>\n</td>\n<td align=\"center\">\n<p> ATTRIBUTION </p>\n<p>au 1er janvier 2000 </p>\n<p>(points) </p>\n</td>\n<td align=\"center\">EMPLOIS <br/>\n</td>\n</tr>\n<tr>\n<td align=\"left\">\n<p>Fonctions de responsabilité exercées par les ingénieurs et les personnels </p>\n<p>techniques et d'administration de la recherche au sein des unités et </p>\n<p>services du CNRS : </p>\n</td>\n<td align=\"center\"> </td>\n<td align=\"center\"> </td>\n<td align=\"center\"> </td>\n</tr>\n<tr>\n<td align=\"left\">- agent chargé de la mise en eouvre des règles d'hygiène et de sécurité <br/>\n</td>\n<td align=\"center\">  A-B</td>\n<td align=\"center\"> 20</td>\n<td align=\"center\">300  <br/>\n</td>\n</tr>\n<tr>\n<td align=\"left\">\n<p>- responsable de cellule financière et de gestion de personnel au sein des </p>\n<p> délégations du CNRS </p>\n</td>\n<td align=\"center\">  A-B</td>\n<td align=\"center\"> 20</td>\n<td align=\"center\"> 76</td>\n</tr>\n</tbody>\n</table>\n<br/>"

  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>      Fonctions exercées pouvant ouvrir droit au versement d'une nouvelle bonification indiciaire :<br/>\n<br/>   1. Vice-président ;<br/>\n<br/>   2. Président de section ;<br/>\n<br/>   3. Président adjoint de la section du contentieux ;<br/>\n<br/>   4. Président de cour administrative d'appel ;<br/>\n<br/>   5. Secrétaire général ;<br/>\n<br/>   6. Président de sous-section de la section du contentieux ;<br/>\n<br/>   7. Chef de la mission permanente d'inspection des juridictions administratives ;<br/>\n<br/>   8. Secrétaire général adjoint ;<br/>\n<br/>   9. Rapporteur général de la section du rapport et des études.<br/>"
  },

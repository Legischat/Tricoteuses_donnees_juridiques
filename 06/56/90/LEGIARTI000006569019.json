  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Fonctions exercées pouvant ouvrir droit au versement d'une nouvelle bonification indiciaire :<br/>\n<br/>   1. Président de tribunal administratif ;<br/>\n<br/>   2. Vice-président du tribunal administratif de Paris ;<br/>\n<br/>   3. Secrétaire général des tribunaux administratifs et des cours administratives d'appel ;<br/>\n<br/>   4. Président de section au tribunal administratif de Paris ;<br/>\n<br/>   5. Président de chambre de cour administrative d'appel ;<br/>\n<br/>   6. Vice-président de tribunal administratif ;<br/>\n<br/>   7. Vice-président de section au tribunal administratif de Paris.<br/>"
  },

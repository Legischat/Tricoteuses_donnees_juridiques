      "TITRE_TXT": [
        {
          "#text": "Décret n°58-560 du 28 juin 1958 AUTORISANT LA PRATIQUE DES ENCHERES DANS LES LIEUX AFFECTES A L'EXPEDITION OU A LA VENTE EN GROS DES DENREES ET PRODUITS PROVENANT DE L'AGRICULTURE ET DE LA PECHE",
          "@c_titre_court": "Décret n°58-560 du 28 juin 1958",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000685057"
        },
        {
          "#text": "Décret n°58-560 du 28 juin 1958 autorisant la pratique des enchères dans les lieux affectés à l'expédition ou à la vente en gros des denrées et produits provenant de l'agriculture et de la pêche",
          "@c_titre_court": "Décret n°58-560 du 28 juin 1958",
          "@debut": "1958-06-29",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006060836"
        }
      ],
      "@cid": "JORFTEXT000000685057",

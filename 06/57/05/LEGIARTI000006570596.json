  "NOTA": {
    "CONTENU": "<br/>   NOTA : Décret 2005-1228 du 29 septembre 2005 art. 14 : dans tous les textes statutaires et réglementaires, la référence au décret n° 70-79 du 27 janvier 1970 est remplacé par la référence au présent décret.<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les agents techniques qui bénéficient d'un avancement de grade à l'intérieur de leur corps sont classés dans leur nouveau grade conformément aux dispositions de l'article 5 du décret du 27 janvier 1970 susvisé.<br/>\n<br/>"
  },

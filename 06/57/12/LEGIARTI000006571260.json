  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Le corps des ingénieurs de police technique et scientifique comprend les grades et échelons suivants :<br/>\n<br/>   1° Ingénieur en chef de police technique et scientifique, qui comporte cinq échelons ;<br/>\n<br/>   2° Ingénieur principal de police technique et scientifique, qui comporte sept échelons ;<br/>\n<br/>   3° Ingénieur de police technique et scientifique, qui comporte dix échelons.<br/>"
  },

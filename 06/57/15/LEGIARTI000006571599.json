  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Le corps des agents techniques de l'électronique comprend deux grades :<br/>\n<br/>   - agent technique de l'électronique ;<br/>\n<br/>   - agent technique principal de l'électronique.<br/>\n<br/>   Le nombre des emplois d'agent technique principal ne peut excéder 20 p. 100 du nombre total des emplois du corps.<br/>"
  },

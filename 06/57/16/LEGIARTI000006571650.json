        {
          "#text": "Décret n°75-64 du 30 janvier 1975 RELATIF A LA QUALIFICATION, AUX BONIFICATIONS DE TEMPS D'ECHELON ET AU REGIME INDEMNITAIRE PARTICULIER DES MEDECINS ET PHARMACIENS CHIMISTES DES ARMEES",
          "@c_titre_court": "Décret n°75-64 du 30 janvier 1975",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000518494"
        },
        {
          "#text": "Décret n°75-64 du 30 janvier 1975 relatif à la qualification, aux bonifications de temps d'échelon et au régime indemnitaire particulier des médecins, des pharmaciens chimistes, des vétérinaires biologistes et des chirurgiens-dentistes des armées.",
          "@c_titre_court": "Décret n°75-64 du 30 janvier 1975",
          "@debut": "2002-01-13",
          "@fin": "2004-06-15",
          "@id_txt": "LEGITEXT000006062343"
        }
      ],
      "TM": {
        "TITRE_TM": [
          {
            "#text": "CHAPITRE II : De la bonification de temps d'échelon.",
            "@debut": "2002-01-13",
            "@fin": "2004-06-15",
            "@id": "LEGISCTA000006098039"

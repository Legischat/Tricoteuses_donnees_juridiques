      "TITRE_TXT": [
        {
          "#text": "Décret n°55-1002 du 26 juillet 1955 INDEMNITES POUR TRAVAUX DANGEREUX, INSALUBRES OU PARTICULIEREMENT PENIBLES ET PRIMES POUR SERVICES RENDUS AUX CONDUCTEURS DE CHANTIERS ET AGENTS DE TRAVAUX DES PONTS ET CHAUSSEES",
          "@c_titre_court": "Décret n°55-1002 du 26 juillet 1955",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000493181"
        },
        {
          "#text": "Décret n°55-1002 du 26 juillet 1955 relatif aux indemnités pour travaux dangereux, insalubres ou particulièrement pénibles et aux primes pour services rendus allouées aux conducteurs de chantiers et agents de travaux des ponts et chaussées.",
          "@c_titre_court": "Décret n°55-1002 du 26 juillet 1955",
          "@debut": "1955-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006060706"
        }
      ],
      "@cid": "JORFTEXT000000493181",
      "@date_publi": "1955-07-30",
      "@date_signature": "1955-07-26",
      "@nature": "DECRET",
      "@num": "55-1002"
    }

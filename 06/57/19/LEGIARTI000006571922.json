  "BLOC_TEXTUEL": {
    "CONTENU": "<p align=\"left\">Les professeurs de chaires supérieures sont rangés en six échelons.</p>\n<br/>\n<p align=\"left\">L'avancement est arrêté chaque année à la date du 1er janvier, partie au choix, partie à l'ancienneté. L'avancement a effet du premier jour du mois qui suit la date à laquelle les intéressés remplissent les conditions fixées au tableau ci-dessous :</p>\n<table align=\"center\" border=\"1\" cellpadding=\"0\" cellspacing=\"0\" width=\"680\">\n<tbody>\n<tr>\n<td width=\"227\">\n<p align=\"center\">ECHELONS</p>\n</td>\n<td width=\"227\">\n<p align=\"center\">AVANCEMENT<br/>au choix 30 %</p>\n</td>\n<td width=\"227\">\n<p align=\"center\">AVANCEMENT<br/>à l'ancienneté 70 %</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"227\">\n<p align=\"left\">Du 1er au 2e échelon</p>\n</td>\n<td valign=\"top\" width=\"227\">\n<p align=\"center\">1 an 3 mois.</p>\n</td>\n<td valign=\"top\" width=\"227\">\n<p align=\"center\">2 ans.</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"227\">\n<p align=\"left\">Du 2e au 3e échelon</p>\n</td>\n<td valign=\"top\" width=\"227\">\n<p align=\"center\">1 an 3 mois.</p>\n</td>\n<td valign=\"top\" width=\"227\">\n<p align=\"center\">2 ans.</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"227\">\n<p align=\"left\">Du 3e au 4e échelon</p>\n</td>\n<td valign=\"top\" width=\"227\">\n<p align=\"center\">1 an 3 mois.</p>\n</td>\n<td valign=\"top\" width=\"227\">\n<p align=\"center\">2 ans.</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"227\">\n<p align=\"left\">Du 4e au 5e échelon</p>\n</td>\n<td valign=\"top\" width=\"227\">\n<p align=\"center\">1 an 3 mois.</p>\n</td>\n<td valign=\"top\" width=\"227\">\n<p align=\"center\">2 ans.</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"227\">\n<p align=\"left\">Du 5e au 6e échelon</p>\n</td>\n<td valign=\"top\" width=\"227\">\n<p align=\"center\">3 ans 6 mois.</p>\n</td>\n<td valign=\"top\" width=\"227\">\n<p align=\"center\">6 ans.</p>\n</td>\n</tr>\n<tr>\n<td width=\"227\">\n<p align=\"left\"> </p>\n</td>\n<td width=\"227\">\n<p align=\"center\">8 ans 6 mois.</p>\n</td>\n<td width=\"227\">\n<p align=\"center\">14 ans.</p>\n</td>\n</tr>\n</tbody>\n</table>\n<p align=\"left\"> </p>\n<p align=\"left\"> </p>\n<p align=\"left\"> </p>\n<p align=\"left\"> </p>"
  },

      "TITRE_TXT": [
        {
          "#text": "Arrêté du 18 mai 1989 PORTANT APPLICATION DU DECRET 89222 DU 04-04-1989 FIXANT LES MODALITES DE RETRIBUTION DES PERSONNELS DES MUSEES NATIONAUX PARTICIPANT A L'ORGANISATION DE MANIFESTATIONS DANS LE CADRE DU MECENAT",
          "@c_titre_court": "Arrêté du 18 mai 1989",
          "@debut": "2999-01-01",

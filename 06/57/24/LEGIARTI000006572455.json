  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les indices de référence servant de base au calcul de la rémunération des agents contractuels des eaux et forêts ci-après désignés sont modifiés ainsi qu'il suit à compter du 1er septembre 1987 :<br/>\n<br/>\n +-----------------+----------<br/>\n<table>\n<tr>\n<td> : EMPLOIS         : INDICES  </td>\n</tr>\n<tr>\n<td> :                 :  BRUTS   </td>\n</tr>\n</table>\n<br/>\n +-----------------+----------<br/>\n<table>\n<tr>\n<td> : Secrétaire      :          </td>\n</tr>\n<tr>\n<td> : administratif : :          </td>\n</tr>\n<tr>\n<td> :  6e échelon     :   434    </td>\n</tr>\n<tr>\n<td> :  5e échelon     :   392    </td>\n</tr>\n<tr>\n<td> :  4e échelon     :   365    </td>\n</tr>\n<tr>\n<td> :  3e échelon     :   333    </td>\n</tr>\n<tr>\n<td> :  2e échelon     :   301    </td>\n</tr>\n<tr>\n<td> :  1er échelon    :   274    </td>\n</tr>\n<tr>\n<td> : Sous-ingénieur  :</td>\n</tr>\n<tr>\n<td> : contractuel :   :          </td>\n</tr>\n<tr>\n<td> :  6e échelon     :   443    </td>\n</tr>\n<tr>\n<td> :  5e échelon     :   403    </td>\n</tr>\n<tr>\n<td> :  4e échelon     :   366    </td>\n</tr>\n<tr>\n<td> :  3e échelon     :   335    </td>\n</tr>\n<tr>\n<td> :  2e échelon     :   301    </td>\n</tr>\n<tr>\n<td> :  1er échelon    :   274    </td>\n</tr>\n</table>\n<br/>\n +-----------------+----------"
  }

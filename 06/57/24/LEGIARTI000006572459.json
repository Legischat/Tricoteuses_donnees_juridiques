  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les indices de référence servant de base au calcul de la rémunération des agents contractuels ci-après du génie rural sont modifiés ainsi qu'il suit à compter du 1er septembre 1987 :<br/>\n<br/>\n +--------------+--------------<br/>\n<table>\n<tr>\n<td> : EMPLOIS      :INDICES BRUTS </td>\n</tr>\n<tr>\n<td> : Agents       :              </td>\n</tr>\n<tr>\n<td> : contractuels :              </td>\n</tr>\n<tr>\n<td> : de 2e        :              </td>\n</tr>\n<tr>\n<td> : catégorie    :Maximum : 463 </td>\n</tr>\n<tr>\n<td> :              :Minimum : 250 </td>\n</tr>\n</table>\n<br/>\n +--------------+--------------"

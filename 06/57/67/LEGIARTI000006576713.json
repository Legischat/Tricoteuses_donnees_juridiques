  "BLOC_TEXTUEL": {
    "CONTENU": "<p>Sauf les cas prévus par les articles 410,411,414,415,416 et 424, toute personne régulièrement citée qui ne comparaît pas au jour et à l'heure fixés par la citation est jugée par défaut, ainsi qu'il est dit à l'article 412.</p>\n<br/>\n<br/>"
  },

        {
          "#text": "Décret n°81-550 du 12 mai 1981 RELATIF A LA COMMUNICATION DE DOCUMENTS ET RENSEIGNEMENTS D'ORDRE ECONOMIQUE, COMMERCIAL OU TECHNIQUE A DES PERSONNES PHYSIQUES OU MORALES ETRANGERES",
          "@c_titre_court": "Décret n°81-550 du 12 mai 1981",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000703748"
        },
        {
          "#text": "Décret n°81-550 du 12 mai 1981 portant application de l'article 2 de la loi n° 68-678 du 26 juillet 1968 relative à la communication de documents et renseignements d'ordre économique, commercial ou technique à des personnes physiques ou morales étrangères",
          "@c_titre_court": "Décret n°81-550 du 12 mai 1981",
          "@debut": "1981-05-16",
          "@fin": "2022-04-01",
          "@id_txt": "LEGITEXT000006063538"
        }
      ],

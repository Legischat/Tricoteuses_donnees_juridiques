      "TITRE_TXT": [
        {
          "#text": "Décret du 12 mars 1859 PORTANT RAP POUR L'APPLICATION DE LA LOI DU 28-05-1858 SUR LES NEGOCIATIONS DES MARCHANDISES DEPOSEES DANS LES MAGASINS GENERAUX ET SUR LES VENTES PUBLIQUES",
          "@c_titre_court": "Décret du 12 mars 1859",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000844828"
        },
        {
          "#text": "Décret du 12 mars 1859 pris pour l'exécution des lois du 28 mai 1858 sur les négociations concernant les marchandises déposées dans les magasins généraux et sur les ventes publiques de marchandises en gros",
          "@c_titre_court": "Décret du 12 mars 1859",
          "@debut": "1859-03-12",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006071363"
        }
      ],
      "TM": {
        "TITRE_TM": [
          {
            "#text": "Titre I : Dispositions communes aux magasins généraux et aux ventes de salles publiques.",

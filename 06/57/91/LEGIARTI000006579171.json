      "TITRE_TXT": [
        {
          "#text": "DECRET 79-472 DU 15-06-1979 PORTANT REGLEMENT D'ADMINISTRATION PUBLIQUE POUR L'APPLICATION DE LA LOI DU 01-08-1905 SUR LES FRAUDES ET FALSIFICATIONS EN MATIERE DE PRODUITS OU DE SERVICES EN CE QUI CONCERNE LES PRODUITS DE LA PECHE.",
          "@c_titre_court": "Décret n°79-472 du 15 juin 1979",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000856331"
        },
        {
          "#text": "Décret n°79-472 du 15 juin 1979 portant règlement d'administration publique pour l'application de la loi du 1er août 1905 sur les fraudes et falsifications en matière de produits ou de services en ce qui concerne les produits de la pêche",
          "@c_titre_court": "Décret n°79-472 du 15 juin 1979",
          "@debut": "1979-06-17",
          "@fin": "2009-09-04",
          "@id_txt": "LEGITEXT000006063054"

      "TITRE_TXT": [
        {
          "#text": "Décret n°73-1101 du 28 novembre 1973 PORTANT APPLICATION DE LA LOI DU 01-08-1905 SUR LA REPRESSION DES FRAUDES DANS LA VENTE DES MARCHANDISES ET DES FALSIFICATIONS DES DENREES ALIMENTAIRES EN CE QUI CONCERNE LES ADDITIFS DESTINES A L'ALIMENTATION DES ANIMAUX",
          "@c_titre_court": "Décret n°73-1101 du 28 novembre 1973",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000875255"
        },
        {
          "#text": "Décret n°73-1101 du 28 novembre 1973 portant application de la loi du 1er août 1905 sur la répression des fraudes dans la vente des marchandises et des falsifications des denrées alimentaires, en ce qui concerne les additifs destinés à l'alimentation des animaux",
          "@c_titre_court": "Décret n°73-1101 du 28 novembre 1973",
          "@debut": "1973-12-15",
          "@fin": "2011-06-24",
          "@id_txt": "LEGITEXT000006062028"
        }
      ],
      "@cid": "JORFTEXT000000875255",

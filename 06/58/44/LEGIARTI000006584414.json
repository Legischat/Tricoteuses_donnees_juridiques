  "NOTA": {
    "CONTENU": "<br/>   Nota - Loi n° 2001-616 du 11 juillet 2001, art. 1 (compétence territoriale), art. 74 (capacité).<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Au 5° de l'article L. 522-1, les mots : \"d'autres sociétés coopératives agricoles, union de ces sociétés et sociétés d'intérêt collectif agricole\" sont remplacés par les mots : \"d'autres sociétés coopératives agricoles et unions de ces sociétés\".<br/>\n<br/>"
  },

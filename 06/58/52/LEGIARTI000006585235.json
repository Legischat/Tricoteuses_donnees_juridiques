  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>    Le régime de protection sociale des personnes salariées des professions agricoles comprend trois branches :<br/>\n<br/>   1° Les prestations familiales ;<br/>\n<br/>   2° Les assurances sociales des salariés qui font l'objet du titre IV ;<br/>\n<br/>   3° L'assurance contre les accidents du travail et les maladies professionnelles des salariés qui fait l'objet du chapitre Ier du titre V.<br/>"
  },

      "TITRE_TXT": [
        {
          "#text": "Décret n°78-278 du 9 mars 1978 PORTANT APPLICATION DE LA LOI DU 01-08-1905 SUR LES FRAUDES ET FALSIFICATIONS EN MATIERE DE PRODUITS OU DE SERVICES,EN CE QUI CONCERNE LES LAITS DE CONSERVE PARTIELLEMENT OU TOTALEMENT DESHYDRATES DESTINES A L'ALIMENTATION HUMAINE",
          "@c_titre_court": "Décret n°78-278 du 9 mars 1978",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000514387"
        },
        {
          "#text": "Décret n°78-278 du 9 mars 1978 portant application de la loi du 1er août 1905 sur les fraudes et falsifications en matière de produits ou de services en ce qui concerne les laits de conserve partiellement ou totalement déshydratés destinés à l'alimentation humaine",
          "@c_titre_court": "Décret n°78-278 du 9 mars 1978",
          "@debut": "1978-05-01",
          "@fin": "2003-12-03",

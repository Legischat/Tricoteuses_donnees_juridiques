  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Le présent décret est applicable aux denrées alimentaires et aux boissons destinées à une alimentation particulière, à l'exception des médicaments et des eaux minérales [*champ d'application*].<br/>\n<br/>"
  },

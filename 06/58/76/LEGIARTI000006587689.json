  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret n°81-574 du 15 mai 1981 PORTANT APPLICATION DE LA LOI DU 01-08-1905 SUR LES FRAUDES ET FALSIFICATIONS EN MATIERE DE PRODUITS OU DE SERVICES EN CE QUI CONCERNE LES DENREES ALIMENTAIRES ET BOISSONS DESTINEES A UNE ALIMENTATION PARTICULIERE",
          "@c_titre_court": "Décret n°81-574 du 15 mai 1981",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000701632"
        },
        {
          "#text": "Décret n°81-574 du 15 mai 1981 portant application de la loi du 1er août 1905 sur les fraudes et falsifications en matière de produits ou de services en ce qui concerne les denrées alimentaires et boissons destinées à une alimentation particulière",
          "@c_titre_court": "Décret n°81-574 du 15 mai 1981",
          "@debut": "1981-05-17",
          "@fin": "1991-08-31",
          "@id_txt": "LEGITEXT000006063540"
        }
      ],

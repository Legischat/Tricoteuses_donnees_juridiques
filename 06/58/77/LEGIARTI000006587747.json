        {
          "#text": "Décret n°81-605 du 18 mai 1981 RELATIF A L'APPLICATION DE LA LOI DU 01-08-1905 SUR LA REPRESSION DES FRAUDES EN CE QUI CONCERNE LE COMMERCE DES SEMENCES ET PLANTS DESTINES A LA PRODUCTION OU A LA MULTIPLICATION",
          "@c_titre_court": "Décret n°81-605 du 18 mai 1981",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000884260"
        },
        {
          "#text": "Décret n°81-605 du 18 mai 1981 pris pour l'application de la loi du 1er août 1905 sur la répression des fraudes en ce qui concerne le commerce des semences et plants",
          "@c_titre_court": "Décret n°81-605 du 18 mai 1981",
          "@debut": "1981-05-20",

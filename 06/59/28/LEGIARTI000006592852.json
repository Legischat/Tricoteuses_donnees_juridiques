    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret n°81-257 du 18 mars 1981 CREANT DES CENTRES DE FORMALITES DES ENTREPRISES,PERMETTANT DE SOUSCRIRE EN UN SEUL LIEU ET SUR UN SEUL DOCUMENT DES DECLARATIONS LEGALES DANS LE DOMAINE JURIDIQUE,ADMINISTRATIF,SOCIAL,FISCAL ET STATISTIQUE (GUICHET UNIQUE,SIMPLIFICATION ADMINISTRATIVE)",
          "@c_titre_court": "Décret n°81-257 du 18 mars 1981",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000684876"
        },
        {

  "BLOC_TEXTUEL": {
    "CONTENU": "<p align=\"center\">Tétanos professionnel</p>\n<table>\n<tbody>\n<tr>\n<td width=\"265\">\n<p align=\"center\">DÉSIGNATION DES MALADIES</p>\n</td>\n<td width=\"113\">\n<p align=\"center\">DÉLAI DE <br/>prise en charge</p>\n</td>\n<td width=\"265\">\n<p align=\"center\">TRAVAUX SUSCEPTIBLES DE PROVOQUER <br/>la maladie</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"top\">\n<p align=\"left\">Tétanos en dehors des cas consécutifs à un accident du travail. </p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p align=\"center\">30 jours</p>\n</td>\n<td align=\"left\" valign=\"top\">\n<p>Travaux agricoles, ainsi que tous travaux comportant un contact avec les animaux domestiques, leurs dépouilles ou leurs déjections. </p>\n</td>\n</tr>\n</tbody>\n</table>\n<p align=\"left\"> </p>\n<p align=\"left\"> </p>\n<p align=\"left\"> </p>"
  },

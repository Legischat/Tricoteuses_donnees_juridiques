  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>      Antimousses.<br/>\n<br/>   Catalyseurs.<br/>\n<br/>   Agents de clarification/adjuvants de filtration.<br/>\n<br/>   Agents décolorants.<br/>\n<br/>   Agents de lavage et de pelage/épluchage.<br/>\n<br/>   Agents de plumaison et d'épilation.<br/>\n<br/>   Résines échangeuses d'ions.<br/>\n<br/>   Agents de congélation par contact et agents de refroidissement.<br/>\n<br/>   Agents de dessiccation/antiagglomérants.<br/>\n<br/>   Enzymes.<br/>\n<br/>   Agents d'acidification, d'alcalinisation ou de neutralisation.<br/>\n<br/>   Agents de démoulage.<br/>\n<br/>   Floculants et coagulants.<br/>\n<br/>   Biocides.<br/>\n<br/>   Antitartres.<br/>\n<br/>   Solvants d'extraction.<br/>\n<br/>   Divers.<br/>"
  },

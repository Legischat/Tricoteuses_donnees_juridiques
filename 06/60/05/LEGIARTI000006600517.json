        {
          "#text": "Loi n°82-847 du 6 octobre 1982 RELATIVE A LA CREATION D'OFFICES D'INTERVENTION DANS LE SECTEUR AGRICOLE ET A L'ORGANISATION DES MARCHES",
          "@c_titre_court": "Loi n°82-847 du 6 octobre 1982",
          "@debut": "2999-01-01",

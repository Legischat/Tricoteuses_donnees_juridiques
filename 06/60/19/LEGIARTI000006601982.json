      "TITRE_TXT": [
        {
          "#text": "Décret n°81-227 du 10 mars 1981 RELATIF A L'HOMOLOGATION DES CAHIERS DE CHARGES DEFINISSANT LES CONDITIONS DE PRODUCTION DE L'AGRICULTURE N'UTILISANT PAS DE PRODUITS CHIMIQUES DE SYNTHESE (L'HOMOLOGATION ACCORDEE PAR ARRETE DU MINISTRE DE L'AGRICULTURE NE DEVIENT DEFINITIVE QU'A L'ISSUE D'UNE PERIODE PROBATOIRE ;PUBLICATION DE L'ARRETE AU JO)",
          "@c_titre_court": "Décret n°81-227 du 10 mars 1981",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000310810"
        },
        {
          "#text": "Décret n°81-227 du 10 mars 1981 relatif à l'homologation des cahiers des charges définissant les conditions de production de l'agriculture n'utilisant pas de produits chimiques de synthèse",
          "@c_titre_court": "Décret n°81-227 du 10 mars 1981",

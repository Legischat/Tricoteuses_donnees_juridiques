        {
          "#text": "Décret n°84-681 du 16 juillet 1984 RELATIF AUX MODALITES DE CALCUL DES DIFFERENCES DE PRIX DU LAIT DE CHEVRE EN FONCTION DE SA COMPOSITION ET DE SA QUALITE",
          "@c_titre_court": "Décret n°84-681 du 16 juillet 1984",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000686324"
        },
        {
          "#text": "Décret n°84-681 du 16 juillet 1984 relatif aux modalités de calcul des différences de prix du lait de chèvre en fonction de sa composition et de sa qualité, et modifiant le décret du 16 novembre 1970 ayant le même objet en ce qui concerne le lait de vache",
          "@c_titre_court": "Décret n°84-681 du 16 juillet 1984",
          "@debut": "1984-07-22",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006064580"
        }
      ],
      "@cid": "JORFTEXT000000686324",
      "@date_publi": "1984-07-22",
      "@date_signature": "1984-07-16",
      "@nature": "DECRET",
      "@num": "84-681"
    }
  },

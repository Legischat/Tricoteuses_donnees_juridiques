      "TITRE_TXT": [
        {
          "#text": "Décret n°73-89 du 19 janvier 1973 LES DECRETS 69257 DU 22-03-1969,69258 DU 22-03-1969 ET 69666 DU 14-06-1969 SONT APPLICABLES DANS LES DEPARTEMENTS DE LA MARTINIQUE,LA GUADELOUPE ET LA REUNION.(REGLEMENTATION DE LA MONTE PUBLIQUE,INSEMINATION ARTIFICIELLE,ORGANISATION ET FONCTIONNEMENT DES ETABLISSEMENTS D'ELEVAGE)",

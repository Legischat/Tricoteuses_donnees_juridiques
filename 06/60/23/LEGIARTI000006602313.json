  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret n°76-351 du 15 avril 1976 SONT APPLICABLES AUX EQUIDES LES ARTICLES 2, 3 (REGLEMENTATION PAR VOIE DE DECRETS ET D'ARRETES),7 (PEINES ENCOURUES), 10-1, 10-2, 10-3 (FONCTIONNAIRES CHARGES DU CONTROLE), ET 16 (CONSEIL SUPERIEUR DE L'ELEVAGE) DE LA LOI 661005 DU 28-12-1966",
          "@c_titre_court": "Décret n°76-351 du 15 avril 1976",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000678696"
        },
        {
          "#text": "Décret n°76-351 du 15 avril 1976 rendant applicables aux équidés les articles 2, 3, 7, 10-1, 10-2, 10-3 et 16 de la loi n° 66-1005 du 28 décembre 1966 sur l'élevage, complétée par la loi n° 72-1030 du 15 novembre 1972",
          "@c_titre_court": "Décret n°76-351 du 15 avril 1976",
          "@debut": "1976-04-22",

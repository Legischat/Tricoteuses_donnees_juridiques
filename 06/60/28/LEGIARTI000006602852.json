      "TITRE_TXT": [
        {
          "#text": "Décret n°85-1144 du 30 octobre 1985 RELATIF A L'AMELIORATION MATERIELLE DE L'EXPLOITATION AGRICOLE ET PORTANT MODIFICATION DU DECRET 8484 DU 01-02-1984 CONCERNANT L'OCTROI D'UNE INDEMNITE ANNUELLE DE DEPART AYANT LE CARACTERE D'UN COMPLEMENT DE RETRAITE AUX CHEFS D'EXPLOITATION AGRICOLE AGES CESSANT LEUR ACTIVITE",
          "@c_titre_court": "Décret n°85-1144 du 30 octobre 1985",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000324471"
        },
        {
          "#text": "Décret n°85-1144 du 30 octobre 1985 relatif à l'amélioration matérielle de l'exploitation agricole",
          "@c_titre_court": "Décret n°85-1144 du 30 octobre 1985",
          "@debut": "1990-10-07",
          "@fin": "1996-03-17",
          "@id_txt": "LEGITEXT000006064735"
        }
      ],
      "TM": {
        "TITRE_TM": [
          {
            "#text": "Titre II : Aides aux investissements pour les exploitations ne présentant pas de plan d'amélioration matérielle de l'exploitation agricole.",
            "@debut": "1985-11-01",
            "@fin": "1996-03-17",
            "@id": "LEGISCTA000006098544"
          }
        ]
      },

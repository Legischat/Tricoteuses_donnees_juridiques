        {
          "#text": "Arrêté du 7 juin 1982 INTERDICTION DE COMMERCIALISER DES ABRICOTS CONTAMINES PAR LE VIRUS DE LA SHARKA (PLUM-POX) SUR L'ENSEMBLE DU TERRITOIRE DE LA FRANCE METROPOLITAINE ET DES DEPARTEMENTS D'OUTRE-MER",
          "@c_titre_court": "Arrêté du 7 juin 1982",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000313874"
        },
        {
          "#text": "Arrêté du 7 juin 1982 relatif à l'interdiction de commercialisation des abricots contaminés par le virus de la Sharka",
          "@c_titre_court": "Arrêté du 7 juin 1982",
          "@debut": "1982-06-23",
          "@fin": "2999-01-01",

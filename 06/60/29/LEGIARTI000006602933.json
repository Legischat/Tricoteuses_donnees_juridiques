      "TITRE_TXT": [
        {
          "#text": "Arrêté du 4 mai 1982 EMPLOI DES MONO ET DIGLYCERIDES D'ACIDES GRAS,DU STEARATE DE MAGNESIUM ET DE LA STEARINE DANS CERTAINS PRODUITS DE CONFISERIE (PASTILLES ET COMPRIMES)",
          "@c_titre_court": "Arrêté du 4 mai 1982",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000489858"
        },
        {
          "#text": "Arrêté du 4 mai 1982 relatif à l'emploi des mono et diglycérides d'acides gras, du stéarate de magnésium et de la stéarine dans certains produits de confiserie",
          "@c_titre_court": "Arrêté du 4 mai 1982",

    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Arrêté du 16 novembre 1973 DES MARCHANDISES PREEMBALLEES EN VUE DE LA VENTE AU DETAIL ET DESTINEES A L'ALIMENTATION DE L'HOMME, QUI SONT DISPENSEES DE PORTER L'INDICATION DES COMPOSANTS ET DES PRODUITS D'ADDITION",
          "@c_titre_court": "Arrêté du 16 novembre 1973",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000834912"
        },
        {
          "#text": "Arrêté du 16 novembre 1973 relatif à la liste des marchandises préemballées en vue de la vente au détail et destinées à l'alimentation de l'homme, qui sont dispensées de porter l'indication des composants et des produits d'addition.",
          "@c_titre_court": "Arrêté du 16 novembre 1973",
          "@debut": "1973-11-21",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006071384"
        }
      ],
      "@cid": "JORFTEXT000000834912",
      "@date_publi": "1973-11-21",
      "@date_signature": "1973-11-16",
      "@nature": "ARRETE"

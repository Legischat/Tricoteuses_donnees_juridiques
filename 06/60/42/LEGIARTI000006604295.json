  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Trois sièges :<br/>\n<br/>   Auvergne, Bretagne, Franche-Comté, Limousin, Midi-Pyrénées et Rhône-Alpes.<br/>\n<br/>   Quatre sièges :<br/>\n<br/>   Alsace, Bourgogne, Lorraine, Nord-Pas-de-Calais, Normandie, Pays de la Loire et Poitou-Charentes.<br/>\n<br/>   Cinq sièges :<br/>\n<br/>   Centre et Corse.<br/>\n<br/>   Sept sièges :<br/>\n<br/>   Champagne-Ardenne<br/>\n<br/>   Huit sièges :<br/>\n<br/>   Languedoc-Roussillon, Picardie, Seine-et-Marne, Ile-de-France et Provence-Alpes-Côte-d'Azur.<br/>"
  },

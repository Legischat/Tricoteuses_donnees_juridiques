        {
          "#text": "Décret n°70-1056 du 16 novembre 1970 PRIS POUR L'APPLICATION DES ART. 3 ET 5 DE LA LOI 69-10 DU 03 JANVIER 1969, MODALITES DE PAIEMENT DES DIFFERENTS LAITS",
          "@c_titre_court": "Décret n°70-1056 du 16 novembre 1970",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000850403"
        },
        {
          "#text": "Décret n°70-1056 du 16 novembre 1970 pris pour l'application des articles 3 et 5 de la loi du 3 janvier 1969 et relatif au paiement à des prix différents du lait de vache en fonction de sa composition et de sa qualité",
          "@c_titre_court": "Décret n°70-1056 du 16 novembre 1970",
          "@debut": "1970-11-18",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006061701"
        }
      ],
      "@cid": "JORFTEXT000000850403",
      "@date_publi": "1970-11-18",
      "@date_signature": "1970-11-16",
      "@nature": "DECRET",
      "@num": "70-1056"
    }
  },
  "VERSIONS": {
    "VERSION": [
      {

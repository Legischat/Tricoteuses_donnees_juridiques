        {
          "#text": "Arrêté du 1 septembre 1972 REGLEMENTATION DES AGENCES MOBILIERES ET IMMOBILIERES, REPERTOIRE DES AGENTS",
          "@c_titre_court": "Arrêté du 1 septembre 1972",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000450173"
        },
        {
          "#text": "Arrêté du 1 septembre 1972 relatif aux titres admis en dépôt et fixation de leur valeur pour la constitution de la garantie financière exigée par l'article 3 (2°) de la loi n° 70-9 du 2 janvier 1970 réglementant les conditions d'exercice des activités relatives à certaines opérations sur les immeubles et fonds de commerce",
          "@c_titre_court": "Arrêté du 1 septembre 1972",
          "@debut": "1972-09-13",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006071390"
        }
      ],
      "@cid": "JORFTEXT000000450173",

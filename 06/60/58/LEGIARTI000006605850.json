      "TITRE_TXT": [
        {
          "#text": "Décret n°88-904 du 31 août 1988 FIXANT POUR 1988 LES MODALITES D'APPLICATION DE L'ART. 5 DE LA LOI 64706 DU 10-07-1964 MODIFIEE EN VUE DE FAVORISER LE DEVELOPPEMENT DE L'ASSURANCE CONTRE LES RISQUES AGRICOLES (GRELE ET TEMPETE SUR RECOLTES)",
          "@c_titre_court": "Décret n°88-904 du 31 août 1988",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000687596"
        },
        {
          "#text": "Décret n°88-904 du 31 août 1988 fixant pour 1988 les modalités d'application de l'article 5 de la loi n° 64-706 du 10 juillet 1964 modifiée en vue de favoriser le développement de l'assurance contre les risques agricoles (grêle et tempête sur récoltes)",
          "@c_titre_court": "Décret n°88-904 du 31 août 1988",
          "@debut": "1988-09-03",
          "@fin": "2999-01-01",

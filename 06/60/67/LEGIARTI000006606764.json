    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Arrêté du 16 décembre 1970 fixant les conditions auxquelles est subordonné l'agrément des laboratoires chargés d'effectuer les prélèvements et analyses en vue du paiement du lait de vache en fonction de sa composition et de sa qualité",
          "@c_titre_court": "Arrêté du 16 décembre 1970",
          "@debut": "1971-01-06",
          "@fin": "2000-10-12",
          "@id_txt": "LEGITEXT000006071427"
        }
      ],
      "@cid": "LEGITEXT000006071427",

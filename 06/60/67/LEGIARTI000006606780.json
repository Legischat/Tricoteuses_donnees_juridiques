      "TITRE_TXT": [
        {
          "#text": "Arrêté du 2 mai 1985 définissant les modalités techniques selon lesquelles sont prélevés et analysés les échantillons de laits livrés par les producteurs aux fins de la détermination de leur composition et de leur qualité",
          "@c_titre_court": "Arrêté du 2 mai 1985",
          "@debut": "1985-06-12",
          "@fin": "2013-01-01",

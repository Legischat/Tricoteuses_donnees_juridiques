  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   1° Ail.<br/>\n<br/>   2° Châtaignes et marrons.<br/>\n<br/>   3° Dattes, sauf celles conditionnées en boîtes dites \"mignonnettes\" (160 grammes), \"marseillaises\" (227 grammes) et \"géantes\" (310 grammes).<br/>\n<br/>   4° Echalotes.<br/>\n<br/>   5° Fruits secs ou séchés, avec ou sans coque, en mélange ou non, autres que les noix.<br/>\n<br/>   6° Légumes secs.<br/>\n<br/>   7° Noix.<br/>\n<br/>   8° Oignons.<br/>\n<br/>   9° Pruneaux.<br/>"
  }

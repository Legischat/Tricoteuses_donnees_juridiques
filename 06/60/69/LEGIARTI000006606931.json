  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Arrêté du 22 octobre 1979 PRETS DU CREDIT AGRICOLE MUTUEL CONSENTIS AUX VICTIMES DE SINISTRES AGRICOLES.PRETS SPECIAUX A MOYEN TERME EN APPLICATION DU DECRET 79824 DU 21-09-1979 POUR LA REPARATION DES DEGATS CAUSES AUX RECOLTES ET CULTURES NON PERENNES ACCORDES POUR UNE DUREE MAXIMALE DE QUATRE ANS AVEC UN TAUX D'INTERET DE 7%.POSSIBILITE DE PORTER LA DUREE DE CES PRETS A SEPT ANS,LE TAUX D'INTERET SERA ALORS RAMENE A 6%",
          "@c_titre_court": "Arrêté du 22 octobre 1979",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000839177"
        },
        {
          "#text": "Arrêté du 22 octobre 1979 relatif aux prêts consentis aux victimes de sinistres agricoles",

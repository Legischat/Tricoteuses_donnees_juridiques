      "TITRE_TXT": [
        {
          "#text": "Arrêté du 30 juillet 1991 FIXANT LES CARACTERISTIQUES TECHNIQUES ET SANITAIRES DES LOCAUX,INSTALLATIONS,EQUIPEMENTS ET AGENCEMENTS DES ABATTOIRS PUBLICS DONT LE FINANCEMENT PEUT FAIRE L'OBJET D'UN AGREMENT D'EMPRUNT",

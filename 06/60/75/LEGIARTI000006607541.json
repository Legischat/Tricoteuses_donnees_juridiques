      "TITRE_TXT": [
        {
          "#text": "Arrêté du 5 août 1991 RELATIF A LA MISE EN PLACE D'UNE FICHE ANNUELLE DE SYNTEHSE DES RESULTATS COMPTABLES POUR LES JEUNES AGRICULTEURS BENEFICIAIRES DES AIDES A L'INSTALLATION",
          "@c_titre_court": "Arrêté du 5 août 1991",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000325982"
        },
        {
          "#text": "Arrêté du 5 août 1991 relatif à la mise en place d'une fiche annuelle de synthèse des résultats comptables pour les jeunes agriculteurs bénéficiaires des aides à l'installation",
          "@c_titre_court": "Arrêté du 5 août 1991",

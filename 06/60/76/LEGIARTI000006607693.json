        {
          "#text": "Arrêté du 2 octobre 1978 CARACTERISTIQUES ET MODALITES D'ETABLISSEMENT DU DOCUMENT D'ACCOMPAGNEMENT DE L'ANIMAL, PREVU PAR LE DECRET 78415 DU 23 MARS 1978, SUR L'IDENTIFICATION PERMANENTE ET GENERALISEE DU CHEPTEL BOVIN",
          "@c_titre_court": "Arrêté du 2 octobre 1978",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000488279"
        },
        {
          "#text": "Arrêté du 2 octobre 1978 relatif aux caractéristiques et modalités d'établissement du document d'accompagnement de l'animal, prévu par le décret n° 78-415 du 23 mars 1978, sur l'identification permanente et généralisée du cheptel bovin",
          "@c_titre_court": "Arrêté du 2 octobre 1978",
          "@debut": "1978-12-02",
          "@fin": "2999-01-01",

      "TITRE_TXT": [
        {
          "#text": "Arrêté du 8 septembre 1966 APPLICATION DU DECRET 65763 DU 3 SEPTEMBRE 1965 RELATIF AU CAFE ET ETABLISSANT LA DESCRIPTION DES FEVES DEFECTUEUSES ET LE BAREME DE CALCUL DES DEFAUTS DES CAFES VERTS ET TORREFIES",
          "@c_titre_court": "Arrêté du 8 septembre 1966",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000626505"
        },
        {
          "#text": "Arrêté du 8 septembre 1966 relatif à l'application du décret n° 763 du 3 septembre 1965 relatif au café et établissant la description des fèves défectueuses et le barème de calcul des défauts des cafés verts et torréfiés",
          "@c_titre_court": "Arrêté du 8 septembre 1966",
          "@debut": "1966-09-08",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006071525"
        }
      ],

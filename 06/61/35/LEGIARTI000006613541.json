  "BLOC_TEXTUEL": {
    "CONTENU": "<p align=\"center\">\n<strong>Tableau établi pour l'application de l'article R. 221-67</strong>\n</p>\n<br/>\n<p align=\"center\">Composition de la commission nationale de la propriété forestière</p>\n<br/>\n<br/>\n<p>Nord - Pas-de-Calais - Picardie, région Nord - Pas-de-Calais, Picardie : 1.</p>\n<br/>\n<p>Normandie, région Haute-Normandie, Basse-Normandie : 1.</p>\n<br/>\n<p>Champagne-Ardenne, région Champagne-Ardenne : 1.</p>\n<br/>\n<p>Lorraine-Alsace, région Lorraine, Alsace : 1.</p>\n<br/>\n<p>Bretagne, région Bretagne : 1.</p>\n<br/>\n<p>Pays de la Loire, région Pays de la Loire : 1.</p>\n<br/>\n<p>Ile-de-France - Centre, région Ile-de-France, Centre : 2.</p>\n<br/>\n<p>Bourgogne, région Bourgogne : 2.</p>\n<br/>\n<p>Franche-Comté, région Franche-Comté : 1.</p>\n<br/>\n<p>Poitou-Charentes, région Poitou-Charentes : 1.</p>\n<br/>\n<p>Limousin, région Limousin : 1.</p>\n<br/>\n<p>Auvergne, région Auvergne : 1.</p>\n<br/>\n<p>Rhône-Alpes, région Rhône-Alpes : 2.</p>\n<br/>\n<p>Aquitaine, région Aquitaine : 3.</p>\n<br/>\n<p>Midi-Pyrénées, région Midi-Pyrénées : 2.</p>\n<br/>\n<p>Languedoc-Roussillon, région Languedoc-Roussillon : 1.</p>\n<br/>\n<p>Provence-Alpes-Côte d'Azur, région Provence-Alpes-Côte d'Azur :</p>\n<p>2.</p>\n<br/>\n<p>Corse, région Corse : 1.</p>\n<br/>\n<br/>\n<p>Total : 25.</p>\n<br/>"
  },

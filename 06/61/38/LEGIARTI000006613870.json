  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret n°83-974 du 8 novembre 1983 FIXANT LA LISTE DES FORETS ET TERRAINS A BOISER OU A RESTAURER APPARTENANT A L'ETAT DONT LA GESTION ET L'EQUIPEMENT SONT CONFIES A L'OFFICE NATIONAL DES FORETS (ONF).L'ONF EST EGALEMENT CHARGE DE LA GESTION ET DE L'EQUIPEMENT DANS LE DEPARTEMENT DE LA GUYANE,DES TERRAINS DU DOMAINE DE L'ETAT MENTIONNES A L'ART. D-33 DU CODE DU DOMAINE DE L'ETAT (ENVIRON 8000000 HECTARES)",
          "@c_titre_court": "Décret n°83-974 du 8 novembre 1983",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000505058"
        },
        {
          "#text": "Décret n°83-974 du 8 novembre 1983 fixant la liste des forêts et terrains à boiser ou à restaurer appartenant à l'Etat, dont la gestion et l'équipement sont confiés à l'office national des forêts",
          "@c_titre_court": "Décret n°83-974 du 8 novembre 1983",
          "@debut": "1983-11-10",
          "@fin": "1984-11-24",
          "@id_txt": "LEGITEXT000006064284"

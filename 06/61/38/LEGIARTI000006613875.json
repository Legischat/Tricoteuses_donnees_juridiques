    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret n°84-1032 du 20 novembre 1984 FIXANT LA LISTE DES FORETS ET TERRAINS A BOISER OU A RESTAURER APPARTENANT A L'ETAT,DONT LA GESTION ET L'EQUIPEMENT SONT CONFIES A L'OFFICE NATIONAL DES FORETS (ONF)",
          "@c_titre_court": "Décret n°84-1032 du 20 novembre 1984",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000884975"
        },
        {
          "#text": "Décret n°84-1032 du 20 novembre 1984 relatif à la liste des forêts et terrains à boiser ou à restaurer appartenant à l'Etat, dont la gestion et l'équipement sont confiés à l'office national des forêts",
          "@c_titre_court": "Décret n°84-1032 du 20 novembre 1984",
          "@debut": "1984-11-24",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006064301"
        }
      ],
      "@cid": "JORFTEXT000000884975",

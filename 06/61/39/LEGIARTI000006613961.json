      "TITRE_TXT": [
        {
          "#text": "Décret n°91-978 du 20 septembre 1991 FIXANT LA LISTE DES FORETS ET TERRAINS A BOISER OU A RESTAURER APPARTENANT A L'ETAT,DONT LA GESTION ET L'EQUIPEMENT SONT CONFIES A L'OFFICE NATIONAL DES FORETS",
          "@c_titre_court": "Décret n°91-978 du 20 septembre 1991",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000334792"
        },
        {
          "#text": "Décret n°91-978 du 20 septembre 1991 fixant la liste des forêts et terrains à boiser ou à restaurer appartenant à l'Etat, dont la gestion et l'équipement sont confiés à l'office national des forêts",
          "@c_titre_court": "Décret n°91-978 du 20 septembre 1991",
          "@debut": "1991-09-26",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006067756"

        {
          "#text": "Arrêté du 15 mars 1983 relatif à l'emploi des préparations enzymatiques dans la fabrication de certaines denrées et boissons destinées à l'alimentation humaine",
          "@c_titre_court": "Arrêté du 15 mars 1983",
          "@debut": "1983-04-07",
          "@fin": "1989-10-01",
          "@id_txt": "LEGITEXT000006071578"
        }
      ],
      "@cid": "LEGITEXT000006071578",
      "@date_publi": "2999-01-01",

      "TITRE_TXT": [
        {
          "#text": "Décret n°71-208 du 18 mars 1971 FIXANT LES MODALITES D'ETABLISSEMENT DES LISTES D'ASSESSEURS APPELES A SIEGER A LA COMMISSION DE CONCILIATION ET D'EXPERTISE DOUANIERE (CCED)",
          "@c_titre_court": "Décret n°71-208 du 18 mars 1971",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000513992"
        },
        {
          "#text": "Décret n°71-208 du 18 mars 1971 fixant les modalités d'établissement des listes d'assesseurs appelés à siéger à la commission de conciliation et d'expertise douanière",
          "@c_titre_court": "Décret n°71-208 du 18 mars 1971",

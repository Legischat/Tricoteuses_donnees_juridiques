      "TITRE_TXT": [
        {
          "#text": "Décret n°80-347 du 13 mai 1980 PORTANT MODIFICATION DE LA COMPOSITION DE LA COMMISSION CREEE PAR L'ART. 2 DE LA LOI DU 30-03-1928 ET CHARGEE DE DONNER UN AVIS SUR LES DEMANDES D'AUTORISATIONS SPECIALES D'IMPORTATION DES PRODUITS PETROLIERS",
          "@c_titre_court": "Décret n°80-347 du 13 mai 1980",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000878292"
        },
        {
          "#text": "Décret n°80-347 du 13 mai 1980 portant modification de la composition de la commission créée par l'article 2 de la loi du 30 mars 1928 et chargée de donner un avis sur les demandes d'autorisations spéciales d'importation des produits pétroliers",
          "@c_titre_court": "Décret n°80-347 du 13 mai 1980",
          "@debut": "1980-05-14",
          "@fin": "2999-01-01",

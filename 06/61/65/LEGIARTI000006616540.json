      "TITRE_TXT": [
        {
          "#text": "Décret n°82-1110 du 23 décembre 1982 AUTORISANT CERTAINES SOCIETES A IMPORTER ET A METTRE A LA CONSOMMATION,POUR LEUR PROPRE COMPTE ET USAGE EXCLUSIF,DIVERS PRODUITS DERIVES DU PETROLE",
          "@c_titre_court": "Décret n°82-1110 du 23 décembre 1982",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000515725"
        },
        {
          "#text": "Décret n°82-1110 du 23 décembre 1982 autorisant certaines sociétés à importer et à mettre à la consommation, pour leur propre compte et usage exclusif, divers produits dérivés du pétrole",
          "@c_titre_court": "Décret n°82-1110 du 23 décembre 1982",
          "@debut": "1982-12-28",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006063658"

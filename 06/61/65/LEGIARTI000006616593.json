        {
          "#text": "Décret n°83-541 du 24 juin 1983 ATTRIBUTION D'UNE AUTORISATION SPECIALE D'IMPORTATION,DE RECEPTION ET DE TRAITEMENT DE PETROLE BRUT,DERIVES ET RESIDUS A LA SOCIETE FRANCAISE DES PETROLES BP",
          "@c_titre_court": "Décret n°83-541 du 24 juin 1983",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000503524"
        },
        {
          "#text": "Décret n°83-541 du 24 juin 1983 relatif à l'attribution d'une autorisation spéciale d'importation, de réception et de traitement de pétrole brut, dérivés et résidus, à la société française des pétroles B.P.",
          "@c_titre_court": "Décret n°83-541 du 24 juin 1983",
          "@debut": "1983-06-30",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006064164"
        }
      ],

          "@id_txt": "JORFTEXT000000503525"
        },
        {
          "#text": "Décret n°83-545 du 24 juin 1983 relatif à l'attribution d'une autorisation spéciale d'importation, de réception et de traitement de pétrole brut, dérivés et résidus à la Société Fina France",
          "@c_titre_court": "Décret n°83-545 du 24 juin 1983",
          "@debut": "1983-06-30",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006064168"
        }
      ],

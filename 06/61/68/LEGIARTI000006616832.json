  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret n°86-1072 du 30 septembre 1986 MODIFIANT LE DECRET 821109 DU 23-12-1982 MODIFIE PORTANT ATTRIBUTION DES AUTORISATIONS SPECIALES D'IMPORTATION ET DE LIVRAISON A LA CONSOMMATION INTERIEURE DE DIFFERENTS PRODUITS DERIVES DU PETROLE (TABLEAUX I A XI) ET DU DECRET 821010 DU 23-12-1982 AUTORISANT CERTAINES SOCIETES A IMPORTER ET A METTRE A LA CONSOMMATION POUR LEUR PROPRE COMPTE ET USAGE EXCLUSIF,DIVERS PRODUITS DERIVES DU PETROLE,MODIFIE PAR LE DECRET 851347 DU 19-12-1985 ET PAR LE DECRET 86785 DU 27-06-1986",
          "@c_titre_court": "Décret n°86-1072 du 30 septembre 1986",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000869873"
        },
        {
          "#text": "Décret n°86-1072 du 30 septembre 1986 modifiant le décret n° 82-1109 du 23 décembre 1982 modifié portant attribution des autorisations spéciales d'importation et de livraison à la consommation intérieure de différents produits dérivés du pétrole (tableaux I à XI) et le décret n° 82-1110 du 23 décembre 1982 autorisant certaines sociétés à importer et à mettre à la consommation, pour leur propre compte et usage exclusif, divers produits dérivés du pétrole, modifiés par le décret n° 85-1347 du 19 décembre 1985 et par le décret n° 86-785 du 27 juin 1986",
          "@c_titre_court": "Décret n°86-1072 du 30 septembre 1986",
          "@debut": "1986-10-01",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006065214"
        }
      ],

      "TITRE_TXT": [
        {
          "#text": "Arrêté du 3 novembre 1982 DES BUREAUX DE DOUANE OU DOIVENT AVOIR LIEU,A L'IMPORTATION,LES INSPECTIONS ET CONTROLES DES DENREES ANIMALES ET D'ORIGINE ANIMALE",
          "@c_titre_court": "Arrêté du 3 novembre 1982",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000496810"
        },
        {
          "#text": "Arrêté du 3 novembre 1982 relatif à la liste des bureaux de douane où doivent avoir lieu, à l'importation, les inspections et contrôles des denrées animales et d'origine animale",
          "@c_titre_court": "Arrêté du 3 novembre 1982",
          "@debut": "1982-11-11",
          "@fin": "2999-01-01",

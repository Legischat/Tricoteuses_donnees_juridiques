      "TITRE_TXT": [
        {
          "#text": "Arrêté du 28 janvier 1984 DES BUREAUX DE DOUANE OU DOIVENT AVOIR LIEU,A L'IMPORTATION LES  INSPECTIONS ET CONTROLES DES VIANDES FRAICHES DES ANIMAUX DOMESTIQUES DE L'ESPECE PORCINE",
          "@c_titre_court": "Arrêté du 28 janvier 1984",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000865182"
        },
        {
          "#text": "Arrêté du 28 janvier 1984 fixant la liste des bureaux de douane où doivent avoir lieu, à l'importation, les inspections et contrôles des viandes fraîches des animaux domestiques de l'espèce porcine",
          "@c_titre_court": "Arrêté du 28 janvier 1984",
          "@debut": "1984-01-29",

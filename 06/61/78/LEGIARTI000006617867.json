        {
          "#text": "Arrêté du 15 juillet 1987 RELATIF AUX CONDITIONS SANITAIRES A L'IMPORTATION DE PLANTES ET PARTIES DE PLANTES HOTES DU POU DE SAN JOSE (QUADRASPIDIOTUS PERNICIOSUS COMSTOCK)",
          "@c_titre_court": "Arrêté du 15 juillet 1987",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000321808"
        },
        {
          "#text": "Arrêté du 15 juillet 1987 relatif aux conditions sanitaires à l'importation de plantes et parties de plantes hôtes du pou de San Jose (Quadraspidiotus Perniciosus Comstock)",
          "@c_titre_court": "Arrêté du 15 juillet 1987",
          "@debut": "1987-12-01",
          "@fin": "1990-12-28",
          "@id_txt": "LEGITEXT000006057822"
        }

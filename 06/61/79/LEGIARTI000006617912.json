    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Arrêté du 15 juillet 1987 RELATIF AUX CONDITIONS SANITAIRES A L'IMPORTATION DE BOIS DE FEUILLUS (CHATAIGNIER,CHENE,ERABLE,EUCALYPTUS,ORME,PEUPLIER,PLATANE)",
          "@c_titre_court": "Arrêté du 15 juillet 1987",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000682648"
        },
        {
          "#text": "Arrêté du 15 juillet 1987 relatif aux conditions sanitaires à l'importation de bois de feuillus (châtaignier, chêne, érable, eucalyptus, orme, peuplier, platane)",
          "@c_titre_court": "Arrêté du 15 juillet 1987",
          "@debut": "1987-11-01",
          "@fin": "1990-12-28",
          "@id_txt": "LEGITEXT000006057826"
        }
      ],
      "@cid": "JORFTEXT000000682648",

    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Arrêté du 26 octobre 1993 FIXANT POUR LE WHITE-SPIRIT ET LE PETROLE LAMPANT LES CONDITIONS D'EMPLOI OUVRANT DROIT A L'APPLICATION DU REGIME FISCAL PRIVILEGIE INSTITUE PAR L'ART. 265 DU CODE DES DOUANES EN MATIERE DE TAXE INTERIEURE DE CONSOMMATION",
          "@c_titre_court": "Arrêté du 26 octobre 1993",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000476620"
        },
        {
          "#text": "Arrêté du 26 octobre 1993 fixant pour le white-spirit et le pétrole lampant les conditions d'emploi ouvrant droit à l'application du régime fiscal privilégié institué par l'article 265 du code des douanes en matière de taxe intérieure de consommation",
          "@c_titre_court": "Arrêté du 26 octobre 1993",
          "@debut": "1993-11-05",
          "@fin": "2002-08-01",
          "@id_txt": "LEGITEXT000006060217"
        }
      ],

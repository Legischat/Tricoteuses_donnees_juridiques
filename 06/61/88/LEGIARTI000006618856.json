        "@typelien": "CITATION"
      },
      {
        "#text": "Arrêté 2/A 1984-01-04 art. 2 *période de référence de décembre 1983 : 8,15 F*",
        "@sens": "source",
        "@typelien": "SPEC_APPLI"
      },
      {
        "#text": "Arrêté 45/A 1983-08-30 BOCC n° 15, 31 août 1983",

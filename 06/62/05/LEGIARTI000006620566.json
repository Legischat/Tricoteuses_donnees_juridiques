      "TITRE_TXT": [
        {
          "#text": "Décret n°52-727 du 25 juin 1952 RELATIF A L'OCTROI DE L'AVAL DE L'ONIC AUX EFFETS SOUSCRITS PAR LES NEGOCIANTS EN GRAINS AGREES EN CONTRE PARTIE DE LEURS STOCKS DE CEREALES",
          "@c_titre_court": "Décret n°52-727 du 25 juin 1952",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000502654"
        },
        {
          "#text": "Décret n°52-727 du 25 juin 1952 relatif à l'octroi de l'aval de l'office national interprofessionnel des céréales aux effets souscrits par les négociants en grains agréés en contrepartie de leurs stocks de céréales détenus en application des dispositions de la loi du 15 août 1936 et des textes subséquents",
          "@c_titre_court": "Décret n°52-727 du 25 juin 1952",
          "@debut": "1952-06-26",
          "@fin": "2003-09-06",
          "@id_txt": "LEGITEXT000006060640"
        }
      ],
      "@cid": "JORFTEXT000000502654",
      "@date_publi": "1952-06-26",
      "@date_signature": "1952-06-25",
      "@nature": "DECRET",
      "@num": "52-727"
    }
  },

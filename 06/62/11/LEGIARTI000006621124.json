  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Ordonnance n°45-2675 du 2 novembre 1945 L'APPELLATION VINS D'ALSACE NE S'APPLIQUE QU'AUX VINS PROVENANT DE COMMUNES DU HAUT-RHIN ET DU BAS-RHIN COMPRISES DANS UNE AIRE DE PRODUCTION CONSACREE PAR LES USAGES LOCAUX. DELIMITATION PAR UN COMITE D'EXPERTS NOMME PAR LE MINISTRE DE L'AGRICULTURE",
          "@c_titre_court": "Ordonnance n°45-2675 du 2 novembre 1945",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000889113"
        },
        {
          "#text": "Ordonnance n° 45-2675 du 2 novembre 1945 relative à la définition des appellations d'origine des vins d'Alsace",
          "@c_titre_court": "Ordonnance n° 45-2675 du 2 novembre 1945",
          "@debut": "1945-11-04",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006069186"
        }
      ],
      "@cid": "JORFTEXT000000889113",

  "NOTA": {
    "CONTENU": "<br/>  Le décret n° 2001-1163 du 7 décembre 2001 a été abrogé par le décret n° 2003-851 du 1er septembre 2003, article 4.<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les vins ne peuvent être mis en circulation sous l'appellation d'origine contrôlée \"Muscat du Cap Corse\" sans un certificat d'agrément délivré par l'Institut national de l'origine et de la qualité dans les conditions prévues par le décret n° 2001-1163 du 7 décembre 2001.<br/>\n<br/>"
  },

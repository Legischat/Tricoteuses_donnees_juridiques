  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Arrêté du 8 décembre 1983 relatif aux prix des communications perçus par les abonnés qui mettent leur poste téléphonique ou leur poste à encaissement automatique à la disposition du public ou de leur clientèle",
          "@c_titre_court": "Arrêté du 8 décembre 1983",
          "@debut": "1984-01-01",
          "@fin": "1994-11-03",
          "@id_txt": "LEGITEXT000006071700"
        }
      ],
      "@cid": "LEGITEXT000006071700",
      "@date_publi": "2999-01-01",
      "@date_signature": "1983-12-08",
      "@nature": "ARRETE"
    }
  },
  "VERSIONS": {
    "VERSION": [
      {
        "LIEN_ART": {
          "@debut": "1984-01-01",
          "@etat": "ABROGE",
          "@fin": "1994-11-03",
          "@id": "LEGIARTI000006622934",
          "@num": "1",
          "@origine": "LEGI"
        },
        "@etat": "ABROGE"
      }
    ]
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Seuls les abonnés au téléphone qui mettent d'une manière habituelle leur poste à la disposition de leur clientèle ou du public, sans être liés avec ceux-ci par un contrat de location quelconque, sont autorisés à percevoir pour l'établissement des communications téléphoniques un prix déterminé dans les conditions fixées par les articles ci-après.<br/>\n<br/>"
  },

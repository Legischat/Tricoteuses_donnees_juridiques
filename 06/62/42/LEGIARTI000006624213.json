      "TITRE_TXT": [
        {
          "#text": "Loi n°66-400 du 18 juin 1966 SUR L'EXERCICE DE LA PECHE MARITIME ET L'EXPLOITATION DES PRODUITS DE LA MER DANS LES TERRES AUSTRALES ET ANTARCTIQUES FRANCAISES (TAAF)",
          "@c_titre_court": "Loi n°66-400 du 18 juin 1966",
          "@debut": "2999-01-01",

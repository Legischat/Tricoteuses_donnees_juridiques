      "TITRE_TXT": [
        {
          "#text": "Loi n°66-400 du 18 juin 1966 SUR L'EXERCICE DE LA PECHE MARITIME ET L'EXPLOITATION DES PRODUITS DE LA MER DANS LES TERRES AUSTRALES ET ANTARCTIQUES FRANCAISES (TAAF)",
          "@c_titre_court": "Loi n°66-400 du 18 juin 1966",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000880382"
        },
        {
          "#text": "Loi n°66-400 du 18 juin 1966 relative à l'exercice de la pêche maritime et à l'exploitation des produits de la mer dans les Terres australes et antarctiques françaises",

      "TITRE_TXT": [
        {
          "#text": "Arrêté du 10 février 1984 ET MODE DE FONCTIONNEMENT DU CONSEIL SPECIALISE POUR LE SECTEUR DES PLANTES A PARFUM DE L'OFFICE NATIONAL INTERPROFESSIONNEL DES PLANTES A PARFUM AROMATIQUES ET MEDICINALES",
          "@c_titre_court": "Arrêté du 10 février 1984",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000315873"
        },
        {
          "#text": "Arrêté du 10 février 1984 relatif à la composition et au mode de fonctionnement du conseil spécialisé pour le secteur des plantes à parfum de l'office national interprofessionnel des plantes à parfum aromatiques et médicinales",
          "@c_titre_court": "Arrêté du 10 février 1984",

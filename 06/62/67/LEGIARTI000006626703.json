        {
          "#text": "Arrêté du 15 septembre 1993 INSTITUANT UN REGIME COMMUN DE LICENCES POUR LA PECHE DANS LES ESTUAIRES ET LA PECHE DES POISSONS MIGRATEURS",
          "@c_titre_court": "Arrêté du 15 septembre 1993",
          "@debut": "2999-01-01",

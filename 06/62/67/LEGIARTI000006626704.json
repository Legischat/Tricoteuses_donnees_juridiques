        {
          "#text": "Arrêté du 15 septembre 1993 INSTITUANT UN REGIME COMMUN DE LICENCES POUR LA PECHE DANS LES ESTUAIRES ET LA PECHE DES POISSONS MIGRATEURS",
          "@c_titre_court": "Arrêté du 15 septembre 1993",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000327459"
        },
        {
          "#text": "Arrêté du 15 septembre 1993 instituant un régime commun de licences pour la pêche dans les estuaires et la pêche des poissons migrateurs le long des côtes du littoral de la mer du Nord, de la Manche et de l'océan Atlantique",
          "@c_titre_court": "Arrêté du 15 septembre 1993",
          "@debut": "2014-08-27",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000029404930"
        },
        {

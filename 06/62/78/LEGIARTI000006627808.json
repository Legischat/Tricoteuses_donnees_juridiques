  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   I. - Pour le territoire de la France métropolitaine, de la Guadeloupe et de la Martinique :<br/>\n<br/>   - essences auto et essences avion ;<br/>\n<br/>   - gazole, fioul domestique, pétrole lampant (autre que carburéacteur) ;<br/>\n<br/>   - carburéacteur ;<br/>\n<br/>   - fioul lourd.<br/>\n<br/>   II. - Pour la Guyane et la Réunion :<br/>\n<br/>   - essences auto et essences avion ;<br/>\n<br/>   - gazole, fioul domestique, pétrole lampant (autre que carburéacteur) ;<br/>\n<br/>   - carburéacteur ;<br/>\n<br/>   - fioul lourd ;<br/>\n<br/>   - gaz de pétrole liquéfié.<br/>"
  },

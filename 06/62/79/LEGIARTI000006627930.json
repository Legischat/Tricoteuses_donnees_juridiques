      "TITRE_TXT": [
        {
          "#text": "Loi n°76-646 du 16 juillet 1976 RELATIVE A LA PROSPECTION, A LA RECHERCHE ET A L'EXPLOITATION DES SUBSTANCES MINERALES NON VISEES A L'ART. 2 DU CODE MINIER ET CONTENUES DANS LES FONDS MARINS DU DOMAINE PUBLIC METROPOLITAIN",
          "@c_titre_court": "Loi n°76-646 du 16 juillet 1976",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000322731"
        },
        {
          "#text": "Loi n° 76-646 du 16 juillet 1976 relative à la prospection, à la recherche et à l'exploitation des substances minérales non visées à l'article 2 du code minier et contenues dans les fonds marins de domaine public métropolitain",
          "@c_titre_court": "Loi n° 76-646 du 16 juillet 1976",
          "@debut": "1976-07-17",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006068554"

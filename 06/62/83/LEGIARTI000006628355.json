  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Loi n°72-1152 du 23 décembre 1972 AUTORISANT LA CREATION D'ENTREPRISES EXERCANT SUR LE SOL NATIONAL UNE ACTIVITE D'INTERET EUROPEEN EN MATIERE D'ELECTRICITE, EN CONFORMITE AVEC LA LOI 46628 DU 8 AVRIL 1946 SUR LA NATIONALISATION DE L'ELECTRICITE ET DU GAZ",
          "@c_titre_court": "Loi n°72-1152 du 23 décembre 1972",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000509055"
        },
        {
          "#text": "Loi n° 72-1152 du 23 décembre 1972 autorisant la création d'entreprises exerçant sur le sol national une activité d'intérêt européen en matière d'électricité, en conformité avec la loi n° 46-628 du 8 avril 1946 sur la nationalisation de l'électricité et du gaz",
          "@c_titre_court": "Loi n° 72-1152 du 23 décembre 1972",
          "@debut": "1972-12-27",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006068428"
        }
      ],
      "@cid": "JORFTEXT000000509055",
      "@date_publi": "1972-12-27",
      "@date_signature": "1972-12-23",
      "@nature": "LOI",
      "@num": "72-1152"
    }
  },
  "VERSIONS": {
    "VERSION": [
      {
        "LIEN_ART": {
          "@debut": "1972-12-27",
          "@etat": "VIGUEUR",
          "@fin": "2999-01-01",
          "@id": "LEGIARTI000006628355",
          "@num": "1",
          "@origine": "LEGI"
        },
        "@etat": "VIGUEUR"
      }
    ]
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   La constitution de sociétés anonymes de nationalité française ayant pour objet, dans les domaines de la production nucléaire d'électricité, soit de faire construire, soit de faire construire et d'exploiter en France des prototypes à l'échelle industrielle concourant aux activités confiées à Electricité de France par la loi n° 46-628 du 8 avril 1946 sur la nationalisation de l'électricité et du gaz, peut être autorisée dans les conditions ci-après en considération de l'intérêt européen de leur activité.<br/>\n<br/>"
  },

      "TITRE_TXT": [
        {
          "#text": "Décret n°71-754 du 10 septembre 1971 PRIS POUR L'APPLICATION DE L'ART. 2 DE LA LOI 70575 DU 03-07-1970 PORTANT REFORME DU REGIME DES POUDRES ET SUBSTANCES EXPLOSIVES (SUR L'AGREMENT TECHNIQUE PREVU POUR LES ETABLISSEMENTS FABRICANT DES POUDRES)",
          "@c_titre_court": "Décret n°71-754 du 10 septembre 1971",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000336149"
        },
        {
          "#text": "Décret n°71-754 du 10 septembre 1971 pris pour l'application de l'article 2 de la loi du 3 juillet 1970 portant réforme du régime des poudres et substances explosives",
          "@c_titre_court": "Décret n°71-754 du 10 septembre 1971",

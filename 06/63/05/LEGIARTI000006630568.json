      "TITRE_TXT": [
        {
          "#text": "Décret n°80-470 du 18 juin 1980 PORTANT APPLICATION DE LA LOI 76646 DU 16-07-1976 RELATIVE A LA PROSPECTION,A LA RECHERCHE ET A L'EXPLOITATION DES SUBSTANCES MINERALES NON VISEES A L'ARTICLE 2 DU CODE MINIER,ET CONTENUES DANS LES FONDS MARINS DU DOMAINE PUBLIC METROPOLITAIN",
          "@c_titre_court": "Décret n°80-470 du 18 juin 1980",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000515780"
        },
        {
          "#text": "Décret n°80-470 du 18 juin 1980 portant application de la loi n° 76-646 du 16 juillet 1976 relative à la prospection, à la recherche et à l'exploitation des substances minérales non visées à l'article 2 du code minier et contenues dans les fonds marins du domaine public métropolitain",
          "@c_titre_court": "Décret n°80-470 du 18 juin 1980",
          "@debut": "1985-04-24",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006063263"
        }
      ],

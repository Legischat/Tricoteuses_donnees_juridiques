      "TITRE_TXT": [
        {
          "#text": "Décret n°89-637 du 6 septembre 1989 SOUMETTANT A CONTROLE LES PRODUITS VISES A L'ART. 1 DE LA LOI 74908 DU 29-10-1974 MODIFIEE RELATIVE AUX ECONOMIES D'ENERGIE",
          "@c_titre_court": "Décret n°89-637 du 6 septembre 1989",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000700389"
        },
        {
          "#text": "Décret n°89-637 du 6 septembre 1989 soumettant à contrôle les produits visés à l'article 1er de la loi n° 74-908 du 29 octobre 1974 modifiée relative aux économies d'énergie",
          "@c_titre_court": "Décret n°89-637 du 6 septembre 1989",
          "@debut": "1989-09-09",
          "@fin": "2999-01-01",

  "NOTA": {
    "CONTENU": "<br/>   NOTA : Décret 2006-648 du 2 juin 2006 art. 63 : Spécificités d'application.<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les décrets n° 79-511 du 25 juin 1979 et n° 81-374 du 15 avril 1981 approuvant le cahier des charges type, l'un des concessions de mines de substances autres que les hydrocarbures liquides ou gazeux, et l'autre des concessions de mines d'hydrocarbures liquides ou gazeux, sont abrogés.<br/>\n<br/>"
  },

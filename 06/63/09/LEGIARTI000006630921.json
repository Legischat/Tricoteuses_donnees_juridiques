  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Toute personne qui, en violation d'une interdiction prévue au IV de l'article 19, aura acquis ou détenu des armes et des munitions, quelle qu'en soit la catégorie, sera punie d'un emprisonnement de trois ans et d'une amende de 45000 euros.<br/>\n<br/>"
  },

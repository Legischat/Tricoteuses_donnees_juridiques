  "NOTA": {
    "CONTENU": "<br/>  Les décrets n° 95-694 du 3 mai 1995, art. 7, et n° 96-73 du 24 janvier 1996, art. 1, ont abrogé ou remplacé ces différents titres.<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les dispositions annexées au présent décret constituent les titres :<br/>\n<br/>   Dispositions générales ;<br/>\n<br/>   Entreprises extérieures ;<br/>\n<br/>   Personnel de l'exploitation ;<br/>\n<br/>   Registre et plans ;<br/>\n<br/>   Responsabilité et organisation en matière de sécurité ;<br/>\n<br/>   Sécurité et salubrité publiques ;<br/>\n<br/>   Surveillance administrative,<br/>\n du règlement visé à l'article 1er.<br/>"
  },

  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Colorant.<br/>\n<br/>   Conservateur.<br/>\n<br/>   Antioxygène.<br/>\n<br/>   Emulsifiant.<br/>\n<br/>   Epaississant.<br/>\n<br/>   Gélifiant.<br/>\n<br/>   Stabilisant.<br/>\n<br/>   Exhausteur de goût.<br/>\n<br/>   Acidifiant.<br/>\n<br/>   Correcteur d'acidité.<br/>\n<br/>   Antiagglomérant.<br/>\n<br/>   Amidon modifié (1).<br/>\n<br/>   Poudre à lever.<br/>\n<br/>   Agent d'enrobage.<br/>\n<br/>   Sel de fonte (2).<br/>\n<br/>   (1) L'indication du nom spécifique ou du numéro CEE n'est pas requise.<br/>\n<br/>   (2) Uniquement dans le cas des fromages fondus et des produits à base de fromage fondu.<br/>"
  },

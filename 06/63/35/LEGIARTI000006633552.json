      "TITRE_TXT": [
        {
          "#text": "Décret n°80-1091 du 24 décembre 1980 FIXANT LES CONDITIONS D'HYGIENE ET DE SECURITE AUXQUELLES DOIVENT SATISFAIRE LES TRACTEURS AGRICOLES ET FORESTIERS A ROUES",
          "@c_titre_court": "Décret n°80-1091 du 24 décembre 1980",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000304854"
        },
        {
          "#text": "Décret n°80-1091 du 24 décembre 1980 fixant les conditions d'hygiène et de sécurité auxquelles doivent satisfaire les tracteurs agricoles et forestiers à roues",
          "@c_titre_court": "Décret n°80-1091 du 24 décembre 1980",
          "@debut": "1980-12-30",
          "@fin": "2005-10-02",
          "@id_txt": "LEGITEXT000006063173"
        }
      ],

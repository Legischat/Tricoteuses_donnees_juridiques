      "TITRE_TXT": [
        {
          "#text": "Décret n°88-455 du 22 avril 1988 MODIFIANT ET COMPLETANT LE DECRET 80-1091 DU 24-12-1980 FIXANT LES CONDITIONS D'HYGIENE ET DE SECURITE AUXQUELLES DOIVENT SATISFAIRE LES TRACTEURS AGRICOLES OU FORESTIERS A ROUES AINSI QUE LES DISPOSITIONS DU DECRET 79-709 DU 07-08-1979 APPLICABLES AUX APPAREILS DE LEVAGE",
          "@c_titre_court": "Décret n°88-455 du 22 avril 1988",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000316202"
        },
        {
          "#text": "Décret n°88-455 du 22 avril 1988 modifiant et complétant le décret n° 80-1091 du 24 décembre 1980 fixant les conditions d'hygiène et de sécurité auxquelles doivent satisfaire les tracteurs agricoles ou forestiers à roues ainsi que les dispositions du décret n° 79-709 du 7 août 1979 applicables aux appareils de levage",
          "@c_titre_court": "Décret n°88-455 du 22 avril 1988",
          "@debut": "1988-04-28",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006066606"
        }
      ],
      "@cid": "JORFTEXT000000316202",

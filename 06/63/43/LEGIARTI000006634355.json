  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Arrêté du 31 mai 1979 fixant les modalités particulières de dédouanement pour la mise à la consommation des armes importées qui doivent faire l'objet d'un classement en 8e catégorie (alinéa b de l'article 1er du décret n° 73-364 du 12 mars 1973)",
          "@c_titre_court": "Arrêté du 31 mai 1979",
          "@debut": "1979-06-19",
          "@fin": "1996-08-25",
          "@id_txt": "LEGITEXT000006071901"
        }
      ],
      "@cid": "LEGITEXT000006071901",
      "@date_publi": "2999-01-01",
      "@date_signature": "1979-05-31",
      "@nature": "ARRETE"
    }

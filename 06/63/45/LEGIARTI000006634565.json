      "TITRE_TXT": [
        {
          "#text": "Arrêté du 24 octobre 1986 habilitant certaines autorités du ministère de la défense à signer les autorisations prévues par le décret du 12 mars 1973 relatif à l'application du décret du 18 avril 1939 fixant le régime des matériels de guerre, armes et munitions",
          "@c_titre_court": "Arrêté du 24 octobre 1986",
          "@debut": "1986-11-05",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006071908"
        }

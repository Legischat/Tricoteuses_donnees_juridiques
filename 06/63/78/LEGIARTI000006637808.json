  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Ce comité est composé de vingt membres, savoir :<br/>\n<br/>   Un sénateur,<br/>\n<br/>   Deux députés,<br/>\n<br/>   Quatre fonctionnaires représentant les administrations de l'agriculture, du commerce, des finances, de la santé publique,<br/>\n<br/>   Cinq représentants des groupements de producteurs,<br/>\n<br/>   Trois représentants des industries transformatrices du lait,<br/>\n<br/>   Deux représentants du commerce du lait de consommation,<br/>\n<br/>   Deux représentants du commerce des beurres,<br/>\n<br/>   Un représentant des mandataires aux halles.<br/>"
  },

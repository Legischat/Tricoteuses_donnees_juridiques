        {
          "#text": "Décret n°66-239 du 18 avril 1966 CONDITIONS D'HYGIENE, INSPECTION SANITAIRE ET QUALITATIVE",
          "@c_titre_court": "Décret n°66-239 du 18 avril 1966",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000511758"
        },
        {
          "#text": "Décret n°66-239 du 18 avril 1966 pris en ce qui concerne les abattoirs de volailles pour l'application des articles 1 et 2 de la loi n° 65-543 du 8 juillet 1965 relative aux conditions nécessaires à la modernisation du marché de la viande",
          "@c_titre_court": "Décret n°66-239 du 18 avril 1966",

  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret n°65-1177 du 31 décembre 1965 PROPHYLAXIE DE LA BRUCELLOSE BOVINE, OVINE ET CAPRINE ET REGLEMENTATION DE LA CESSION ET DE L'UTILISATION DES ANTIGENES BRUCELLIQUES",
          "@c_titre_court": "Décret n°65-1177 du 31 décembre 1965",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000669835"
        },
        {
          "#text": "Décret n°65-1177 du 31 décembre 1965 relatif à la prophylaxie de la brucellose bovine, ovine et caprine et à la réglementation de la cession et de l'utilisation des antigènes brucelliques",
          "@c_titre_court": "Décret n°65-1177 du 31 décembre 1965",
          "@debut": "1966-01-04",
          "@fin": "2003-08-07",
          "@id_txt": "LEGITEXT000006061254"
        }
      ],
      "TM": {
        "TITRE_TM": [
          {
            "#text": "Chapitre Ier : Réglementation de la prophylaxie de la brucellose bovine, ovine et caprine.",
            "@debut": "1966-01-04",
            "@fin": "2003-08-07",
            "@id": "LEGISCTA000006100710"
          }
        ]
      },
      "@cid": "JORFTEXT000000669835",
      "@date_publi": "1966-01-04",
      "@date_signature": "1965-12-31",
      "@nature": "DECRET",
      "@num": "65-1177"
    }
  },
  "VERSIONS": {
    "VERSION": [
      {
        "LIEN_ART": {
          "@debut": "1977-08-26",

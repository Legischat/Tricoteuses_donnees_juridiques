  "BLOC_TEXTUEL": {
    "CONTENU": "<p>\n<i>\n<b>CRIT</b>\n</i>\n<i>\n<b>è</b>\n</i>\n<i>\n<b>RES DE COMPOSITION DES VIANDES HACHEES EN MOYENNE JOURNALIERE</b>\n</i>\n</p>\n<br/>\n<br/>\n<table>\n<tbody>\n<tr>\n<td> </td>\n<td>TAUX de matière grasse (en %) </td>\n<td>\n<p> RAPPORT collagène sur protéines </p>\n<p>de viande (en %)</p>\n</td>\n</tr>\n<tr>\n<td>Viande hachée maigre  </td>\n<td> ≤ 7</td>\n<td> ≤ 12</td>\n</tr>\n<tr>\n<td> Viande hachée pur boeuf </td>\n<td> ≤ 20</td>\n<td> ≤ 15</td>\n</tr>\n<tr>\n<td> Viande hachée contenant du porc</td>\n<td> ≤ 30</td>\n<td> ≤ 18</td>\n</tr>\n<tr>\n<td> Viande hachée d'autres espèces</td>\n<td> ≤ 25</td>\n<td> ≤ 15</td>\n</tr>\n</tbody>\n</table>\n<br/>\n<br/>"
  },

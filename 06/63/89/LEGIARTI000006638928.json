  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Outre les conditions prévues au chapitre Ier, les animaux de boucherie doivent :<br/>\n<br/>   - provenir d'un cheptel bovin officiellement indemne de tuberculose ;<br/>\n<br/>   - provenir d'un cheptel officiellement indemne ou indemne de brucellose ;<br/>\n<br/>   - être obligatoirement conduits, sitôt arrivés en France, dans l'abattoir de destination.<br/>"
  },

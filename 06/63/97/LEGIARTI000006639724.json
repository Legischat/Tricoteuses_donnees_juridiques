  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Peut donner lieu à rédhibition tout animal de l'espèce bovine :<br/>\n<br/>   1° Soit reconnu cliniquement atteint de tuberculose ;<br/>\n<br/>   2° Soit réagissant positivement :<br/>\n<br/>   - à une intradermotuberculination simple,<br/>\n<br/>   - ou à une intradermotuberculination comparative exécutée après accord de l'acheteur.<br/>"
  },

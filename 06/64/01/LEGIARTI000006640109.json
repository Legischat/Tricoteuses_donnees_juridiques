          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000658424"
        },
        {
          "#text": "Arrêté du 3 août 1984 fixant les conditions de l'attribution et du maintien de la patente sanitaire définie à l'article 11 du décret n° 63-301 du 19 mars 1963 relatif à la prophylaxie de la tuberculose bovine",
          "@c_titre_court": "Arrêté du 3 août 1984",
          "@debut": "1984-08-21",
          "@fin": "2012-10-01",
          "@id_txt": "LEGITEXT000006072034"
        }

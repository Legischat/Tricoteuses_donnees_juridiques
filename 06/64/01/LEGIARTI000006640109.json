      "TITRE_TXT": [
        {
          "#text": "Arrêté du 3 août 1984 FIXANT LES CONDITIONS DE L'ATTRIBUTION ET DU MAINTIEN DE LA PATENTE SANITAIRE DEFINIE A L'ART. 11 DU DECRET 63301 DU 19-03-1963 RELATIF A LA PROPHYLAXIE DE LA TUBERCULOSE BOVINE",

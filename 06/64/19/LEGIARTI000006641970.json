  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Veaux de moins de 1 mois : 115, 173.<br/>\n<br/>   Veaux à l'engrais de 1 à 6 mois : 500, 750.<br/>\n<br/>   Broutards de race allaitante de moins de 12 mois : 600, 900.<br/>\n<br/>   Jeunes bovins destinés à l'engraissement de 6 à 24 mois : 650, 975.<br/>\n<br/>   Femelles d'élevage de 6 à 24 mois : 750, 1 125.<br/>\n<br/>   Femelles de plus de 24 mois : 1 400, 2 100.<br/>\n<br/>\n<br/>   Les montants de cette annexe s'appliquent à la valeur de remplacement telle que définie à l'article 1er.<br/>"
  },

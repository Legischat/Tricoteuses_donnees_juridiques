  "NOTA": {
    "CONTENU": "<br/>  <br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Le montant de la fraction de taxe d'apprentissage obligatoirement réservée au développement de l'apprentissage en application de l'article L. 118-3 est fixé à 30 p. 100 de la taxe due en raison des salaires versés pendant l'année considérée.<br/>\n<br/>   Ce pourcentage est ramené à 20 p. 100 pour la taxe due au titre de l'année 1973.<br/>"
  },

  "NOTA": {
    "CONTENU": "<br/>  <br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Tout employeur qui procède au licenciement pour motif économique d'un salarié sans lui proposer le bénéfice d'une convention de conversion en application des dispositions de l'article L. 321-5 et de l'article L. 321-5-2 doit  verser aux organismes visés à l'article L. 351-21 une contribution égale à un mois du salaire brut moyen des douze derniers mois travaillés.<br/>\n<br/>"
  },

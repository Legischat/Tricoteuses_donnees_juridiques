  "NOTA": {
    "CONTENU": "<br/>   Nota : Loi 2003-660 2003-07-21 art. 15 III : Les présentes dispositions entrent en vigueur dès l'installation d'une antenne de l'Agence nationale pour l'emploi à Mayotte et, au plus tard, le 1er janvier 2005.<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   L'Agence nationale pour l'emploi prévue à l'article L. 311-7 assure le service public du placement à Mayotte dans les conditions prévues par le code du travail applicable localement.<br/>\n<br/>"
  },

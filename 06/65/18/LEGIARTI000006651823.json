  "NOTA": {
    "CONTENU": "<br/>  <br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Sans préjudice des dispositions de la section I ci-dessus, toute personne qui, au cours de sa vie professionnelle, a été titulaire d'un contrat de travail à durée déterminée peut bénéficier d'un congé de formation dans les conditions et selon les modalités définies à la présente section.<br/>\n<br/>"
  },

  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Est puni d'une amende de trente mille francs, le fait, pour toute personne, de méconnaître les obligations prescrites au titre des opérations sur valeurs mobilières par l'article L. 342-8.<br/>\n<br/>"
  },

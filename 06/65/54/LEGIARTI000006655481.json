  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>Les prescriptions de la présente section pour l'application desquelles est prévue la procédure de la mise en demeure en application des articles L. 231-3 et L. 231-4 et le délai minimum prévu à l'article L. 231-4 pour l'exécution des mises en demeure sont fixés conformément au tableau ci-après : <br/>\n<br/>\n<table>\n<tr>\n<td>:------------------------------------------: </td>\n</tr>\n<tr>\n<td>: PRESCRIPTIONS : DELAI MINIMUM : </td>\n</tr>\n<tr>\n<td>: pour lesquelles est : d'exécution des : </td>\n</tr>\n<tr>\n<td>: prévue la mise en : mises en demeure : </td>\n</tr>\n<tr>\n<td>: demeure : : </td>\n</tr>\n<tr>\n<td>:------------------------:-----------------: </td>\n</tr>\n<tr>\n<td>: Article R. 238-3-2 : : </td>\n</tr>\n<tr>\n<td>: alinéa 1 : 1 mois : </td>\n</tr>\n<tr>\n<td>: Article R. 238-3-3, : : </td>\n</tr>\n<tr>\n<td>: alinéas 2,3,4 : 1 mois : </td>\n</tr>\n<tr>\n<td>: Article R. 238-3-9 : 1 mois : </td>\n</tr>\n<tr>\n<td>: Article R. 238-3-10, : : </td>\n</tr>\n<tr>\n<td>: alinéa 3 : 8 jours : </td>\n</tr>\n<tr>\n<td>: Article R. 238-3-11 : 8 jours : </td>\n</tr>\n<tr>\n<td>: Article R. 238-3-12 : 8 jours : </td>\n</tr>\n<tr>\n<td>: Article R. 238-3-15, : : </td>\n</tr>\n<tr>\n<td>: alinéa 2 : 1 mois : </td>\n</tr>\n<tr>\n<td>:------------------------:-----------------:</td>\n</tr>\n</table>\n<br/>"
  },

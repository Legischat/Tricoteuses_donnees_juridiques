  "NOTA": {
    "CONTENU": "<br/>   [*Nota - L'ordonnance 82-1114 du 23 décembre 1982, art. 83 : le présent article n'est plus applicable à compter du 29 décembre 1982 dans le territoire de Nouvelle-Calédonie et dépendances.*]    [*Nota - (1) taux résultant de la loi 89-469 du 10 juillet 1989.*]<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "Seront punis d'une amende de 30 à 250 F [*1*] et, en cas de récidive, d'une amende de 1 300 à 3.000 F [*1*] [*montant*] :<br/>\n a) Les auteurs d'infractions aux dispositions des articles 32, 45, 52 (par. 2), 53, 66, 67, 97, 99 (par. 3), 100 et 173 ;<br/>\n b) Les auteurs d'infractions aux dispositions des arrêtés prévus par les articles 55 et 172 ;<br/>\n c) Les employeurs, fondés de pouvoir ou leurs préposés, responsables du défaut d'affichage conforme aux dispositions de l'article 110.<br/>"
  },

  "NOTA": {
    "CONTENU": "<br/>Lettre circulaire n° 36 du 17 juillet 1986 ACOSS. <br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les embauches mentionnées aux articles 4 et 5 ouvrent droit à une exonération totale des cotisations à la charge de l'employeur pour les rémunérations afférentes à la période de trente jours suivant la date de publication de la présente ordonnance.<br/>\n<br/>"
  },

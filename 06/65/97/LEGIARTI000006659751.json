  "NOTA": {
    "CONTENU": "<br/>   [*Nota - Lettre circulaire n° 36 du 17 juillet 1986 ACOSS.*]<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   L'article 3 s'applique à compter de la date de publication de la présente ordonnance aux contrats et stages en cours à cette date et à ceux qui débuteront avant le 1er février 1987.<br/>\n<br/>   L'article 4 s'applique à compter de la date de publication de la présente ordonnance :<br/>\n<br/>   1° Aux contrats en cours à cette date, sous réserve que l'embauche ait eu lieu après le 31 mai 1986 ;<br/>\n<br/>   2° Aux embauches de jeunes qui achèveront leur formation au plus tard le 30 juin 1987 [*date limite*].<br/>"
  },

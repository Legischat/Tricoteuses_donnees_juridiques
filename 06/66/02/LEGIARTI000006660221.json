        {
          "#text": "Décret n°84-1026 du 22 novembre 1984 PRIS POUR L'APPLICATION DE L'ORDONNANCE 84198 DU 21-03-1984 RELATIVE AU REVENU DE REMPLACEMENT DES TRAVAILLEURS INVOLONTAIREMENT PRIVES D'EMPLOI",
          "@c_titre_court": "Décret n°84-1026 du 22 novembre 1984",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000699354"
        },
        {
          "#text": "Décret n°84-1026 du 22 novembre 1984 pris pour l'application de l'ordonnance n° 84-198 du 21 mars 1984 relative au revenu de remplacement des travailleurs involontairement privés d'emploi et portant modification du code du travail",
          "@c_titre_court": "Décret n°84-1026 du 22 novembre 1984",
          "@debut": "1984-11-23",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006064298"

        },
        {
          "#text": "Décret n°82-265 du 25 mars 1982  RELATIF A L'APPLICATION DU CHAPITRE 1ER DE L'ORDONNANCE N° 82-108 DU 30 JANVIER 1982 RELATIVE AUX CONTRATS DE SOLIDARITE DES COLLECTIVITES LOCALES.",
          "@c_titre_court": "Décret n°82-265 du 25 mars 1982",

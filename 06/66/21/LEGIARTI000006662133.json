    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret n°82-940 du 4 novembre 1982 LE TAUX DE LA COTISATION AU REGIME D'ASSURANCE CHOMAGE (UNEDIC) EST PORTE A 4,80% (AU LIEU DE 3,60%) SUR LES REMUNERATIONS VERSEES A PARTIR DU 06-11-1982.CE TAUX EST AINSI REPARTI: 3,48% A LA CHARGE DES ENTREPRISES (AU LIEU DE 2,76%) ET 1,32% A LA CHARGE DES SALARIES (AU LIEU DE 0,84%)",
          "@c_titre_court": "Décret n°82-940 du 4 novembre 1982",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000331503"
        },
        {
          "#text": "Décret n°82-940 du 4 novembre 1982  PORTANT APPLICATION DE L'ARTICLE L351-18 DU CODE DU TRAVAIL",

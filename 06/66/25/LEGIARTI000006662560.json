      "TITRE_TXT": [
        {
          "#text": "Décret n°83-458 du 7 juin 1983 RELATIF AU RENOUVELLEMENT DES CONTRATS PREVUS PAR L'ORDONNANCE 82204 DU 01-03-1982 RELATIVE A LA PRISE EN CHARGE PAR L'ETAT DE CERTAINES COTISATIONS DE SECURITE SOCIALE DANS LES ENTREPRISES INDUSTRIELLES DES SECTEURS DU TEXTILE ET DE L'HABILLEMENT",
          "@c_titre_court": "Décret n°83-458 du 7 juin 1983",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000314914"
        },
        {
          "#text": "Décret n°83-458 du 7 juin 1983 relatif au renouvellement des contrats *de solidarité* prévus par l'ordonnance n° 82-204 du 1er mars 1982 relative à la prise en charge par l'Etat de certaines cotisations de sécurité sociale dans les entreprises industrielles des secteurs du textile et de l'habillement.",
          "@c_titre_court": "Décret n°83-458 du 7 juin 1983",
          "@debut": "1983-06-08",
          "@fin": "2999-01-01",

  "NOTA": {
    "CONTENU": "<br/>   [*Nota - Décision du Conseil d'Etat n° 55362 du 7 décembre 1990 :<br/>\n annulation du présent décret.*]<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   En ce qui concerne l'application des dispositions du premier alinéa de l'article L. 711-12, les attributions des inspecteurs du travail sont exercées par le directeur des mines et de l'énergie sous l'autorité conjointe du ministre chargé des territoires d'outre-mer et du ministre chargé du travail.<br/>\n<br/>"
  },

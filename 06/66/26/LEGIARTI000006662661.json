  "NOTA": {
    "CONTENU": "<br/>   [*NOTA - Circulaire DH/8D/86-3 du 22 janvier 1986 : Décret abrogé sous réserve de dispositions transitoires.*]<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Sont applicables dans les départements d'outre-mer aux agents non fonctionnaires de l'Etat et de ses établissements publics administratifs ainsi qu'aux agents des collectivités locales et des autres établissements publics administratifs, en cas de perte involontaire d'emploi, les dispositions du décret du 10 novembre 1983 susvisé, sous réserve de l'article 2 ci-après.<br/>\n<br/>"
  },

  "NOTA": {
    "CONTENU": "<br/>   [*Nota - Loi 91-1405 du 31 décembre 1991 : les références aux articles L. 950-2 sont remplaçées par les articles L. 951-1.*]<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les dépenses exposées par l'employeur au-delà du coût de la formation prévue à l'article 3 sont imputables sur la participation au financement de la formation professionnelle continue dans les conditions définies à l'article L. 951-1 du code du travail.<br/>\n<br/>"
  },

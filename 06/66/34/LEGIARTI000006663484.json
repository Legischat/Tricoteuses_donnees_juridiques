      "TITRE_TXT": [
        {
          "#text": "Décret n°86-977 du 8 août 1986 FIXANT LES CONDITIONS DANS LESQUELLES LA REMUNERATION DES ASSOCIES D'UNE EXPLOITATION AGRICOLE A RESPONSABILITE LIMITEE (EARL) CONSTITUE UNE CHARGE SOCIALE",
          "@c_titre_court": "Décret n°86-977 du 8 août 1986",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000700339"
        },
        {
          "#text": "Décret n°86-977 du 8 août 1986 fixant les conditions dans lesquelles la rémunération des associés d'une exploitation agricole à responsabilité limitée constitue une charge sociale.",
          "@c_titre_court": "Décret n°86-977 du 8 août 1986",
          "@debut": "1986-08-22",
          "@fin": "1996-03-17",
          "@id_txt": "LEGITEXT000006065737"
        }
      ],
      "@cid": "JORFTEXT000000700339",

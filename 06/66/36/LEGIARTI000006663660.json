      "TITRE_TXT": [
        {
          "#text": "Décret n°86-1248 du 5 décembre 1986 FIXANT LES MODALITES D'APPLICATION AUX PERSONNELS NAVIGANTS PROFESSIONNELLES DE L'AVIATION CIVILE DU CONGE POUR LA CREATION D'ENTREPRISE ET DU CONGE SABBATIQUE PREVUES AUX ART. L122-32-12,L122-32-13,L122-32-14,L122-32-15,L122-32-16,L122-32-17,L122-32-18,L122-32-19,L122-32-20,L122-32-21,L122-32-22,L122-32-23,L122-32-24,L122-32-25,L122-32-26,L122-32-27 ET 1L22-32-28 DU CODE DU TRAVAIL",
          "@c_titre_court": "Décret n°86-1248 du 5 décembre 1986",
          "@debut": "2999-01-01",

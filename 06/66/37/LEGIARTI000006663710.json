      "TITRE_TXT": [
        {
          "#text": "Décret n°77-794 du 8 juillet 1977 RELATIF A L'ORGANISATION DU TRAVAIL A BORD DES NAVIRES ET ENGINS DOTES DE DISPOSITIFS DE NATURE A SIMPLIFIER LES CONDITIONS TECHNIQUES DE LA NAVIGATION ET DE L'EXPLOITATION",
          "@c_titre_court": "Décret n°77-794 du 8 juillet 1977",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000516071"
        },
        {
          "#text": "Décret n°77-794 du 8 juillet 1977 relatif à l'organisation du travail à bord des navires et engins dotés de dispositifs de nature à simplifier les conditions techniques de la navigation et de l'exploitation",
          "@c_titre_court": "Décret n°77-794 du 8 juillet 1977",
          "@debut": "1977-07-17",
          "@fin": "2999-01-01",

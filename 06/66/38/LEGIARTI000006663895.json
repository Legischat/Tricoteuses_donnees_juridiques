  "NOTA": {
    "CONTENU": "<br/>  <br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les travailleurs privés d'emploi qui suivent un stage de formation agréé par l'Etat ou une région au titre de la rémunération des stagiaires et qui réunissent les conditions définies au 2° de l'article R. 961-6 du code du travail perçoivent une rémunération mensuelle dont le montant est fixé à 3 877 F.<br/>\n<br/>"
  },

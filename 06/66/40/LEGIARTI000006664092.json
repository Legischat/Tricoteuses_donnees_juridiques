      "TITRE_TXT": [
        {
          "#text": "Décret n°87-994 du 10 décembre 1987 PRIS POUR L'APPLICATION DES ART. 1,2,3,4,5,6,7,8 ET 9 DE LA LOI 87549 DU 16-07-1987 RELATIVE AU REGLEMENT DE L'INDEMNISATION DES RAPATRIES",
          "@c_titre_court": "Décret n°87-994 du 10 décembre 1987",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000699638"
        },
        {
          "#text": "Décret n°87-994 du 10 décembre 1987 pris pour l'application des articles 1er à 9 de la loi n° 87-549 du 16 juillet 1987 relative au règlement de l'indemnisation des rapatriés",
          "@c_titre_court": "Décret n°87-994 du 10 décembre 1987",

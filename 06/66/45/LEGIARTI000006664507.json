      "TITRE_TXT": [
        {
          "#text": "Décret n°72-1208 du 27 décembre 1972 FIXANT LA DATE D'ENTREE EN VIGUEUR ET LES MODALITES PARTICULIERES D'APPLICATION DE LA LOI 71576 DU 16-07-1971 SUR L'APPRENTISSAGE DANS LES DEPARTEMENTS DU HAUT-RHIN, DU BAS-RHIN ET DE LA MOSELLE",
          "@c_titre_court": "Décret n°72-1208 du 27 décembre 1972",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000695977"
        },
        {
          "#text": "Décret n°72-1208 du 27 décembre 1972 fixant la date d'entrée en vigueur et les modalités particulières d'application de la loi n° 71-576 du 16 juillet 1971 sur l'apprentissage dans les départements du Haut-Rhin, du Bas-Rhin et de la Moselle",
          "@c_titre_court": "Décret n°72-1208 du 27 décembre 1972",
          "@debut": "1972-12-29",
          "@fin": "2999-01-01",

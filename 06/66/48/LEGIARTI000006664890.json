      "TITRE_TXT": [
        {
          "#text": "Décret n° 81-292 du 27 mars 1981 fixant le taux de rémunération des personnels charges de l’exécution des conventions prévues aux livres Ier et IX du code du travail dans les établissements d'enseignement et de formation professionnelle agricole",
          "@c_titre_court": "Décret n° 81-292 du 27 mars 1981",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000685114"
        },
        {
          "#text": "Décret n°81-292 du 27 mars 1981  FIXANT LE TAUX DE REMUNERATION DES PERSONNELS CHARGES DE L'EXECUTION DES CONVENTIONS PREVUES AUX LIVRES Ier *FORMATION D'APPRENTIS* ET IX DU CODE DU TRAVAIL DANS LES ETABLISSEMENTS D'ENSEIGNEMENT ET DE FORMATION PROFESSIONNELLE AGRICOLES.",
          "@c_titre_court": "Décret n°81-292 du 27 mars 1981",
          "@debut": "1981-04-02",
          "@fin": "2013-09-14",
          "@id_txt": "LEGITEXT000006063468"
        }
      ],
      "@cid": "JORFTEXT000000685114",
      "@date_publi": "1981-04-02",
      "@date_signature": "1981-03-27",
      "@nature": "DECRET",
      "@num": "81-292"
    }
  },

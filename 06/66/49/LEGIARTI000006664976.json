  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret n°75-205 du 26 mars 1975 PRIS POUR L'APPLICATION DE L'ART. 43 DE LA LOI 71575 DU 16-07-1971 PORTANT ORGANISATION DE LA FORMATION PROFESSIONNELLE CONTINUE DANS LE CADRE DE L'EDUCATION PERMANENTE AUX AGENTS CIVILS NON TITULAIRES DE L'ETAT ET DES ETABLISSEMENTS PUBLICS DE L'ETAT N'AYANT PAS LE CARACTERE INDUSTRIEL ET COMMERCIAL",
          "@c_titre_court": "Décret n°75-205 du 26 mars 1975",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000883433"
        },
        {
          "#text": "Décret n°75-205 du 26 mars 1975 pris pour l'application de l'article 43 de la loi n° 71-575 du 16 juillet 1971 portant organisation de la formation professionnelle continue dans le cadre de l'éducation permanente aux agents civils non titulaires de l'Etat et des établissements publics de l'Etat n'ayant pas le caractère industriel et commercial",
          "@c_titre_court": "Décret n°75-205 du 26 mars 1975",
          "@debut": "1975-03-30",
          "@fin": "2007-12-31",
          "@id_txt": "LEGITEXT000006062299"
        }
      ],
      "TM": {
        "TITRE_TM": [
          {
            "#text": "Titre Ier : Actions de formation organisées à l'initiative de l'administration.",
            "@debut": "1975-03-30",
            "@fin": "2007-12-31",
            "@id": "LEGISCTA000006101828"
          }
        ]
      },

  "NOTA": {
    "CONTENU": "<br/>  La présente version de cet article est en vigueur jusqu'au 1er mai 2008.<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Le chapitre II du titre III du livre V à l'exception des articles L. 532-16 à L. 532-27 est applicable dans les îles Wallis-et-Futuna. A l'article L. 532-5, les mots \" et bénéficient des dispositions des articles L. 422-2 et L. 532-23 à L. 532-27 \" sont supprimés.<br/>\n<br/>"
  },

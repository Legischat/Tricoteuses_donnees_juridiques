        {
          "#text": "Arrêté du 23 septembre 1982  RELATIF A L'APPLICATION DES DISPOSITIONS DE L'ARTICLE R. 311-1 DU CODE DU TRAVAIL CONCERNANT LE RENOUVELLEMENT DE LA DEMANDE D'EMPLOI.",
          "@c_titre_court": "Arrêté du 23 septembre 1982",
          "@debut": "1982-10-16",
          "@fin": "1987-10-23",
          "@id_txt": "LEGITEXT000006072085"

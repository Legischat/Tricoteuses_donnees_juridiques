      "TITRE_TXT": [
        {
          "#text": "Arrêté du 20 septembre 1963  RELATIF AU POURCENTAGE DE BENEFICIAIRES A EMPLOYER DANS LES ENTREPRISES ASSUJETTIES A LA LOI DU 23 NOVEMBRE 1957 SUR LE RECLASSEMENT DES TRAVAILLEURS HANDICAPES.",
          "@c_titre_court": "Arrêté du 20 septembre 1963",
          "@debut": "1964-01-01",
          "@fin": "2999-01-01",

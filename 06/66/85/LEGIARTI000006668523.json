      "TITRE_TXT": [
        {
          "#text": "Arrêté du 30 mai 1986  RELATIF AU RELEVEMENT DU SALAIRE MINIMUM DE CROISSANCE EN METROPOLE, DANS LA COLLECTIVITE TERRITORIALE DE SAINT-PIERRE-ET-MIQUELON ET DANS LES DEPARTEMENTS D'OUTRE-MER *SMIC*.",
          "@c_titre_court": "Arrêté du 30 mai 1986",

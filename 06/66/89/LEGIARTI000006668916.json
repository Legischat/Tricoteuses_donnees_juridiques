  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Arrêté du 14 mars 1988 FIXANT LE MONTANT DE LA CONTRIBUTION ANNUELLE POUVANT ETRE VERSEE PAR LES EMPLOYEURS POUR S'ACQUITTER DE L'OBLIGATION D'EMPLOI DES TRAVAILLEURS HANDICAPES,DES MUTILES DE GUERRE ET ASSIMILES",
          "@c_titre_court": "Arrêté du 14 mars 1988",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000843659"
        },
        {
          "#text": "Arrêté du 14 mars 1988 fixant le montant de la contribution annuelle pouvant être versée par les employeurs pour s'acquitter de l'obligation d'emploi des travailleurs handicapés, des mutilés de guerre et assimilés",
          "@c_titre_court": "Arrêté du 14 mars 1988",
          "@debut": "1988-03-22",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006058161"
        }
      ],
      "@cid": "JORFTEXT000000843659",
      "@date_publi": "1988-03-22",
      "@date_signature": "1988-03-14",
      "@nature": "ARRETE",
      "@nor": "ASEE8803241A"
    }
  },

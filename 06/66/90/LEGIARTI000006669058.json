    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Arrêté du 16 août 1989 FIXANT LE TAUX DE LA REDEVANCE A VERSER A L'OFFICE DES MIGRATIONS INTERNATIONALES A L'OCCASION DE L'EXAMEN MEDICAL SUBI PAR LES ETRANGERS DEMANDANT UN TITRE DE SEJOUR",
          "@c_titre_court": "Arrêté du 16 août 1989",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000480534"
        },
        {
          "#text": "Arrêté du 16 août 1989 fixant le taux de la redevance à verser à l'Office des migrations internationales à l'occasion de l'examen médical subi par les étrangers demandant un titre de séjour",
          "@c_titre_court": "Arrêté du 16 août 1989",
          "@debut": "1989-08-22",
          "@fin": "1990-08-22",
          "@id_txt": "LEGITEXT000006059131"
        }
      ],

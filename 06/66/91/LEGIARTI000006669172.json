      "TITRE_TXT": [
        {
          "#text": "Arrêté du 31 janvier 1989 PRIS POUR L'APPLICATION DE L'ART R232-8-4 DU CODE DU TRAVAIL PORTANT RECOMMANDATIONS ET INSTRUCTIONS TECHNIQUES QUE DOIVENT RESPECTER LES MEDECINS DU TRAVAIL ASSURANT LA SURVEILLANCE DES TRAVAILLEURS EXPOSES AU BRUIT",
          "@c_titre_court": "Arrêté du 31 janvier 1989",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000841598"
        },
        {
          "#text": "Arrêté du 31 janvier 1989 pris pour l'application de l'article R. 232-8-4 du code du travail portant recommandations et instructions techniques que doivent respecter les médecins du travail assurant la surveillance médicale des travailleurs exposés au bruit",
          "@c_titre_court": "Arrêté du 31 janvier 1989",
          "@debut": "1989-02-08",
          "@fin": "2016-01-24",
          "@id_txt": "LEGITEXT000006058787"

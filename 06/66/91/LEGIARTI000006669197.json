          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000328108"
        },
        {
          "#text": "Arrêté du 10 avril 1989 fixant les modalités d'application du décret n° 89-210 du 10 avril 1989 relatif aux indemnités de transport et d'hébergement de certains stagiaires de la formation professionnelle",
          "@c_titre_court": "Arrêté du 10 avril 1989",

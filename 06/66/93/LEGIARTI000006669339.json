        {
          "#text": "Arrêté du 2 octobre 1989 PORTANT APPLICATION DE L'ART. L322-7 RELATIF A L'AIDE A L'ADAPTATION DES SALARIES AUX EVOLUTIONS DE L'EMPLOI DANS LE CADRE DES ACCORDS SUR L'EMPLOI",
          "@c_titre_court": "Arrêté du 2 octobre 1989",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000505025"
        },
        {
          "#text": "Arrêté du 2 novembre 1989 portant application de l'article L. 322-7 relatif à l'aide à l'adaptation des salariés aux évolutions de l'emploi, dans le cadre des accords sur l'emploi",
          "@c_titre_court": "Arrêté du 2 novembre 1989",

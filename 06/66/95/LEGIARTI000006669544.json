      "TITRE_TXT": [
        {
          "#text": "Arrêté du 21 janvier 1991 FIXANT LE MONTANT DES REMBOURSEMENTS FORFAITAIRES DUS A L'OFFICE DES MIGRATIONS INTERNATIONALES (OMI) POUR L'INTRODUCTION OU L'ADMISSION DU SEJOUR EN FRANCE DES MEMBRES DES FAMILLES DES TRAVAILLEURS ETRANGERS",
          "@c_titre_court": "Arrêté du 21 janvier 1991",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000505972"
        },
        {
          "#text": "Arrêté du 21 janvier 1991 fixant le montant des remboursements forfaitaires dus à l'Office des migrations internationales pour l'introduction ou l'admission au séjour en France des membres des familles des travailleurs étrangers",
          "@c_titre_court": "Arrêté du 21 janvier 1991",

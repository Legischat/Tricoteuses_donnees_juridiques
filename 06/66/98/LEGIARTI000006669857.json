    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Arrêté du 29 juin 1992 RELATIF AUX MENTIONS DEVANT FIGURER SUR LA DECISION DE PRISE DE MESURES VISANT A SOUSTRAIRE UN SALARIE A UNE SITUATION DE DANGER GRAVE ET IMMINENT,SUR L'AUTORISATION OU LE REFUS D'AUTORISATION DE REPRISE DES TRAVAUX ET PRIS EN APPLICATION DE L'ARTICLE R231-12-4 DU CODE DU TRAVAIL",
          "@c_titre_court": "Arrêté du 29 juin 1992",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000506492"
        },
        {
          "#text": "Arrêté du 29 juin 1992 relatif aux mentions devant figurer sur la décision de prise de mesures visant à soustraire un salarié à une situation de danger grave et imminent, sur l'autorisation ou le refus d'autorisation de reprise des travaux et pris en application de l'article R. 231-12 du code du travail.",
          "@c_titre_court": "Arrêté du 29 juin 1992",

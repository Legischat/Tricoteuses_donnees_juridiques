      "TITRE_TXT": [
        {
          "#text": "Arrêté du 31 décembre 1975 REGIME DES CONTRATS D'ETUDES PREVUS A L'ART. 10 DU DECRET 73-563 DU 27-06-1973. (FONCTIONNAIRES MIS EN DISPONIBILITE EN VUE DE LEUR FORMATION PERSONNELLE : ET NE BENEFICIANT PAS D'AIDES FINANCIERES ACCORDEES PAR L'ETAT AUX STAGIAIRES DE FORMATION PROFESSIONNELLE)",
          "@c_titre_court": "Arrêté du 31 décembre 1975",

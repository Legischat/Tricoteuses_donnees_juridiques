  "NOTA": {
    "CONTENU": "<br/>   *Nota : Décret 92-767 du 29 juillet 1992 art. 5 II : les règles techniques et les procédures de certification de conformité restent applicables aux équipements de travail et moyens de protection qu'ils visent.<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Sont applicables aux machines et dispositifs protecteurs définis à l'article 1er ci-dessus :<br/>\n<br/>   Les articles R. 233-85 à R. 233-92, l'article R. 233-93 (alinéas 1 à 4) et R. 233-94 à R. 233-105 du code du travail ;<br/>\n<br/>   Les articles 2, 3 (alinéa 1er), 4 et 6 à 13 du décret du 15 juillet 1980 susvisé.<br/>"
  },

      "TITRE_TXT": [
        {
          "#text": "Décret n°77-949 du 17 août 1977 RELATIF AUX MESURES D'HYGIENE PARTICULIERES APPLICABLES DANS LES ETABLISSEMENTS OU LE PERSONNEL EST EXPOSE A L'ACTION DES POUSSIERES D'AMIANTE",
          "@c_titre_court": "Décret n°77-949 du 17 août 1977",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000335298"
        },
        {
          "#text": "Décret n°77-949 du 17 août 1977 relatif aux mesures particulières d'hygiène applicables dans les établissements où le personnel est exposé à l'action des poussières d'amiante.",
          "@c_titre_court": "Décret n°77-949 du 17 août 1977",

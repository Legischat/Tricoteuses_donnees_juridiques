  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret n°62-1218 du 15 octobre 1962 PORTANT RAP POUR L'EXECUTION DES DISPOSITIONS DU LIVRE II DU CODE DU TRAVAIL (TITRE 2: HYGIENE ET SECURITE DES TRAVAILLEURS) EN CE QUI CONCERNE LES MESURES PARTICULIERES DE PROTECTION RELATIVE A L'EMPLOI DES EXPLOSIFS DANS LES CHANTIERS DU BATIMENT ET DES TRAVAUX PUBLICS",
          "@c_titre_court": "Décret n°62-1218 du 15 octobre 1962",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000851846"
        },
        {
          "#text": "Décret n°62-1218 du 15 octobre 1962 portant règlement d'administration publique pour l'exécution des dispositions du livre II du code du travail (titre II : Hygiène et sécurité des travailleurs) en ce qui concerne les mesures particulières de protection relatives à l'emploi des explosifs dans les chantiers du bâtiment et des travaux publics.",
          "@c_titre_court": "Décret n°62-1218 du 15 octobre 1962",
          "@debut": "1962-11-19",
          "@fin": "1987-06-01",
          "@id_txt": "LEGITEXT000006061059"
        }
      ],

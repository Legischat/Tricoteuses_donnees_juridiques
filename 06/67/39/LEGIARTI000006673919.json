  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret n°62-1454 du 14 novembre 1962 PORTANT RAP POUR L'EXECUTION DES DISPOSITIONS DU LIVRE II DU CODE DU TRAVAIL (TITRE 2: HYGIENE ET SECURITE DES TRAVAILLEURS) EN CE QUI CONCERNE LA PROTECTION DES TRAVAILLEURS DANS LES ETABLISSEMENTS QUI METTENT EN OEUVRE DES COURANTS ELECTRIQUES",
          "@c_titre_court": "Décret n°62-1454 du 14 novembre 1962",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000852836"
        },
        {
          "#text": "Décret n°62-1454 du 14 novembre 1962 portant règlement d'administration publique pour l'exécution des dispositions du livre 2 du code du travail en ce qui concerne la protection des travailleurs dans les établissements qui mettent en oeuvre des courants électriques.",
          "@c_titre_court": "Décret n°62-1454 du 14 novembre 1962",
          "@debut": "1963-06-05",
          "@fin": "1989-01-01",
          "@id_txt": "LEGITEXT000006061075"
        }
      ],
      "TM": {
        "TITRE_TM": [
          {
            "#text": "SECTION 3 : PROTECTION DES TRAVAILLEURS CONTRE LES RISQUES DE CONTACT AVEC DES CONDUCTEURS ACTIFS OU DES PIECES CONDUCTRICES HABITUELLEMENT SOUS-TENSION",
            "@debut": "1963-06-05",
            "@fin": "1989-01-01",
            "@id": "LEGISCTA000006102458"
          }
        ],
        "TM": {
          "TITRE_TM": [
            {
              "#text": "LABORATOIRES ET PLATES-FORMES D'ESSAIS.",

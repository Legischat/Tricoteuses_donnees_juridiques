  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Toute opération comportant un risque d'exposition aux rayonnements ionisants doit être effectuée sous le contrôle d'une personne qualifiée en radioprotection désignée ou agréée par le chef d'établissement.<br/>\n<br/>"
  },

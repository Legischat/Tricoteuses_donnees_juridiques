      "TITRE_TXT": [
        {
          "#text": "Décret n°47-1386 du 24 juillet 1947 PORTANT RAP EN CE QUI CONCERNE L'UTILISATION DU COURANT ELECTRIQUE DANS LES CHANTIERS SOUTERRAINS D'AMENAGEMENT DES CHUTES D'EAU",
          "@c_titre_court": "Décret n°47-1386 du 24 juillet 1947",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000481436"
        },
        {
          "#text": "Décret n°47-1386 du 24 juillet 1947 portant règlement d'administration publique en ce qui concerne l'utilisation du courant électrique dans les chantiers souterrains d'aménagement de chutes d'eau",
          "@c_titre_court": "Décret n°47-1386 du 24 juillet 1947",
          "@debut": "1947-07-27",

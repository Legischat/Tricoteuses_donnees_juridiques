      "TITRE_TXT": [
        {
          "#text": "Décret n°69-558 du 6 juin 1969 PORTANT RAP EN CE QUI CONCERNE LES MESURES PARTICULIERES DE PROTECTION DES TRAVAILLEURS APPLICABLES AUX TRAVAUX DE DECAPAGE, DE POLISSAGE OU DE DESSABLAGE AU JET",
          "@c_titre_court": "Décret n°69-558 du 6 juin 1969",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000519896"
        },
        {
          "#text": "Décret n°69-558 du 6 juin 1969 portant règlement d'administration publique en ce qui concerne les mesures particulières de protection des travailleurs applicables aux travaux de décapage, de dépolissage ou de dessablage au jet.",
          "@c_titre_court": "Décret n°69-558 du 6 juin 1969",
          "@debut": "1970-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006061652"
        }
      ],

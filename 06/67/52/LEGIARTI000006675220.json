      "TITRE_TXT": [
        {
          "#text": "Décret n°48-1895 du 10 décembre 1948 RAP RELATIF AUX MESURES D'HYGIENE DANS LES ETABLISSEMENTS DONT LE PERSONNEL EST EXPOSE A L'INTOXICATION PAR LE BROMURE DE METHYLE",
          "@c_titre_court": "Décret n°48-1895 du 10 décembre 1948",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000686452"
        },
        {
          "#text": "Décret n°48-1895 du 10 décembre 1948 portant règlement d'administration publique en ce qui concerne les mesures particulières d'hygiène applicables dans les établissements dont le personnel est exposé à l'intoxication par le bromure de méthyle.",
          "@c_titre_court": "Décret n°48-1895 du 10 décembre 1948",
          "@debut": "1949-03-01",
          "@fin": "1988-04-27",
          "@id_txt": "LEGITEXT000006060506"
        }
      ],
      "@cid": "JORFTEXT000000686452",

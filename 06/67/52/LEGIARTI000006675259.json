        {
          "#text": "Décret n°50-1567 du 19 décembre 1950 RAP RELATIF AUX INTOXICATIONS PAR L'HYDROGENE ARSENIE",
          "@c_titre_court": "Décret n°50-1567 du 19 décembre 1950",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000300343"
        },
        {
          "#text": "Décret n°50-1567 du 19 décembre 1950 portant règlement d'administration publique en ce qui concerne les mesures particulières d'hygiène applicables dans les établissements dont le personnel est exposé aux intoxications par l'hydrogène arsénié.",
          "@c_titre_court": "Décret n°50-1567 du 19 décembre 1950",
          "@debut": "1951-03-01",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006060570"
        }
      ],

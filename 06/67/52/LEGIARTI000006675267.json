      "TITRE_TXT": [
        {
          "#text": "Décret n°74-725 du 11 juillet 1974 RELATIF AUX MESURES PARTICULIERES DE PROTECTION APPLICABLES DANS LES CHANTIERS OU ETABLISSEMENTS DANS LESQUELS DES TRAVAUX SONT EXECUTES PAR DES SCAPHANDRIERS SOUS DES PRESSIONS SUPERIEURES A LA PRESSION ATMOSPHERIQUE",
          "@c_titre_court": "Décret n°74-725 du 11 juillet 1974",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000679846"
        },
        {
          "#text": "Décret n°74-725 du 11 juillet 1974 relatif aux mesures particulières de protection applicables dans les chantiers ou établissements dans lesquels des travaux sont exécutés par des scaphandriers sous des pressions supérieures à la pression atmosphérique.",
          "@c_titre_court": "Décret n°74-725 du 11 juillet 1974",
          "@debut": "1974-08-21",
          "@fin": "1990-10-01",
          "@id_txt": "LEGITEXT000006062227"
        }
      ],
      "TM": {
        "TITRE_TM": [
          {
            "#text": "Titre 1er : Méthodes de plongée - Mélanges gazeux - Qualification professionnelle de scaphandriers.",
            "@debut": "1974-08-21",

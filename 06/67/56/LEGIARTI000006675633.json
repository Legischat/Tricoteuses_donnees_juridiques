      "TITRE_TXT": [
        {
          "#text": "Décret n° 88-1056 du 14 novembre 1988 pris pour l'exécution des dispositions du livre II du ‎code du travail (titre III: Hygiène, sécurité et conditions du travail) en ce qui concerne la ‎protection des travailleurs dans les établissements qui mettent en œuvre des courants ‎électriques",
          "@c_titre_court": "Décret n° 88-1056 du 14 novembre 1988",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000866441"
        },
        {
          "#text": "Décret n°88-1056 du 14 novembre 1988 pris pour l'exécution des dispositions du livre II du code du travail (titre III : Hygiène, sécurité et conditions du travail) en ce qui concerne la protection des travailleurs dans les établissements qui mettent en oeuvre des courants électriques",
          "@c_titre_court": "Décret n°88-1056 du 14 novembre 1988",
          "@debut": "1989-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006066314"
        }
      ],
      "TM": {
        "TITRE_TM": [
          {
            "#text": "Section IV : Protection des travailleurs contre les risques de contact avec des masses mises accidentellement sous tension (contact indirect)",
            "@debut": "1989-01-01",
            "@fin": "2999-01-01",
            "@id": "LEGISCTA000006102607"
          }
        ],
        "TM": {
          "TITRE_TM": [
            {
              "#text": "Sous-section I : Installation à courant alternatif",
              "@debut": "1989-01-01",
              "@fin": "2999-01-01",
              "@id": "LEGISCTA000006124670"
            }
          ],
          "TM": {
            "TITRE_TM": [
              {
                "#text": "B. - Protection contre les contacts indirects sans mise à la terre et sans coupure de l'alimentation",
                "@debut": "1989-01-01",
                "@fin": "2999-01-01",
                "@id": "LEGISCTA000006140316"
              }
            ],
            "TM": {
              "TITRE_TM": [
                {
                  "#text": "Double isolation ou isolation renforcée.",
                  "@debut": "1989-01-01",
                  "@fin": "2999-01-01",
                  "@id": "LEGISCTA000006154837"
                }
              ]
            }
          }
        }
      },

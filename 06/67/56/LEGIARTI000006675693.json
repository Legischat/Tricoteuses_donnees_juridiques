      "TITRE_TXT": [
        {
          "#text": "Décret n°82-727 du 19 août 1982 PORTANT EXTENSION AUX CHEFS D'ETABLISSEMENTS AGRICOLES AGISSANT COMME ENTREPRENEURS OU MAITRE D'OUVRAGES (ART. L231 DU CODE DU TRAVAIL) DES DISPOSITIONS DES DECRETS 77612 DU 09-06-1977 (COMITES D'HYGIENE ET DE SECURITE DE CHANTIER) ET 77996 DU 19-08-1977 (PLANS D'HYGIENE ET DE SECURITE,COLLEGES INTER-ENTREPRISES D'HYGIENE ET DE SECURITE,REALISATION DES VOIES ET RESEAUX DIVERS)",
          "@c_titre_court": "Décret n°82-727 du 19 août 1982",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",

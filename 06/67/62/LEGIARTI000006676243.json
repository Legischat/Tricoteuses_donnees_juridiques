        "TM": {
          "TITRE_TM": [
            {
              "#text": "EXIGENCES ESSENTIELLES EN CE QUI CONCERNE LA SECURITE ET LA SANTE APPLICABLES AUX APPAREILS ET AUX SYSTEMES DE PROTECTION DESTINES A ÊTRE UTILISES EN ATMOSPHERE EXPLOSIBLE.",
              "@debut": "1996-11-24",
              "@fin": "2016-04-20",
              "@id": "LEGISCTA000006124708"
            }
          ],
          "TM": {
            "TITRE_TM": [
              {
                "#text": "1. Exigences communes applicables aux appareils et aux systèmes de protection",
                "@debut": "1996-11-24",
                "@fin": "2016-04-20",
                "@id": "LEGISCTA000006140323"
              }
            ],
            "TM": {
              "TITRE_TM": [
                {
                  "#text": "1.4. Dangers dus à des influences perturbatrices extérieures.",

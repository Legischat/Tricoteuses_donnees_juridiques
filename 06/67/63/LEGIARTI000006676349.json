  "NOTA": {
    "CONTENU": "<br/>   NOTA : Conseil d'Etat n° 188824, 188826 du 13 novembre 1998 : le Conseil d'Etat a annulé le décret n° 97-451 du 6 mai 1997.<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Le comité examine le bilan d'activité annuel établi par écrit par le médecin de prévention en vertu de l'article 27 et le joint au rapport annuel sur l'évolution des risques professionnels et des conditions de travail mentionné à l'article 47.<br/>\n<br/>"
  },

      "TITRE_TXT": [
        {
          "#text": "Arrêté du 18 février 1981  FIXANT LA DATE D'APPLICATION DE CERTAINES DISPOSITIONS DU DECRET N° 80-544 DU 15 JUILLET 1980 RELATIF AUX REGLES GENERALES D'HYGIENE ET DE SECURITE APPLICABLES A CERTAINES MACHINES ET A CERTAINS APPAREILS UTILISES POUR LE TRAVAIL DE MATERIAUX ET DE PRODUITS.",
          "@c_titre_court": "Arrêté du 18 février 1981",
          "@debut": "1981-02-22",

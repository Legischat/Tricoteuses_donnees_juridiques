    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Arrêté du 2 avril 1981  FIXANT LES PRESCRIPTIONS TECHNIQUES NECESSAIRES A L'APPLICATION DE CERTAINES DISPOSITIONS DU DECRET N° 81-171 DU 20 FEVRIER 1981 EN CE QUI CONCERNE LES MACHINES A DEGAUCHIR POUR LE TRAVAIL SUR UNE FACE DU BOIS, DU LIEGE ET AUTRES MATIERES SIMILAIRES.",
          "@c_titre_court": "Arrêté du 2 avril 1981",
          "@debut": "1981-05-08",

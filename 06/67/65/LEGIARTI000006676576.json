  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Arrêté du 22 juin 1981 PRESCRIPTIONS TECHNIQUES NECESSAIRES A L'APPLICATION DE CERTAINES DISPOSITIONS DU DECRET 81-408 DU 15-04-1981 EN CE QUI CONCERNE LES TOUPIES VERTICALES SIMPLES DESTINEES AU TRAVAIL DU BOIS ET DES MATIERES SIMILAIRES. (CONSTRUCTIONS,BLOCAGE,FREINAGE DE L'ARBRE,PORTE-OUTILS,REALISATION DES BAGUES DE MONTAGE DES FRAISES,GUIDE DE PRECIS,PROTECTEURS POUR LES TRAVAUX A L'ARBRE)",
          "@c_titre_court": "Arrêté du 22 juin 1981",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000652585"
        },
        {
          "#text": "Arrêté du 22 juin 1981  FIXANT LES PRESCRIPTIONS TECHNIQUES NECESSAIRES A L'APPLICATION DE CERTAINES DISPOSITIONS DU DECRET N° 81-408 DU 15 AVRIL 1981 EN CE QUI CONCERNE LES TOUPIES VERTICALES SIMPLES DESTINEES AU TRAVAIL DU BOIS ET DES MATIERES SIMILAIRES",

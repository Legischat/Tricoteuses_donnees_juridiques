    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Arrêté du 30 octobre 1981  RELATIF A LA DESIGNATION DE L'INSTITUT NATIONAL DE RECHERCHE ET DE SECURITE POUR DELIVRER DES VISAS D'EXAMEN TECHNIQUE CONCERNANT CERTAINES DES CATEGORIES DE MACHINES LES PLUS DANGEREUSES ET PRECISANT LES REGLES APPLICABLES AUX DEMANDEURS DE VISAS.",
          "@c_titre_court": "Arrêté du 30 octobre 1981",
          "@debut": "1981-12-04",
          "@fin": "1989-02-10",
          "@id_txt": "LEGITEXT000006072404"
        }
      ],
      "@cid": "LEGITEXT000006072404",
      "@date_publi": "2999-01-01",
      "@date_signature": "1981-10-30",
      "@nature": "ARRETE"
    }
  },

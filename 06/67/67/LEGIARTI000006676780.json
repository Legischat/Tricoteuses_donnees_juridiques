      "TITRE_TXT": [
        {
          "#text": "Arrêté du 5 novembre 1981 MODELE DES ATTESTATIONS DE CONFORMITE PREVUES AUX ART. R233-62 ET R233-77 DU CODE DU TRAVAIL EN CE QUI CONCERNE LES MATERIELS LES PLUS DANGEREUX ET LES MACHINES LES PLUS DANGEREUSES EN SERVICE OU USAGEES",
          "@c_titre_court": "Arrêté du 5 novembre 1981",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000862328"
        },
        {
          "#text": "Arrêté du 5 novembre 1981  FIXANT LE MODELE DES ATTESTATIONS PREVUES AUX ARTICLES R. 233-62 ET R. 233-77 DU CODE DU TRAVAIL EN CE QUI CONCERNE LES MATERIELS LES PLUS DANGEREUX ET LES PROTECTEURS CONSTRUITS POUR LES MACHINES LES PLUS DANGEREUSES EN SERVICE OU USAGEES.",
          "@c_titre_court": "Arrêté du 5 novembre 1981",

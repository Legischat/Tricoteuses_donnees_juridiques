      "TITRE_TXT": [
        {
          "#text": "Arrêté du 29 juin 1982  PORTANT DEROGATION AUX PRESCRIPTIONS DU TROISIEME ALINEA DE L'ARTICLE R233-100 DU CODE DU TRAVAIL EN CE QUI CONCERNE CERTAINES CATEGORIES DE MACHINES ET D'APPAREILS PORTATIFS A MAIN NEUFS",
          "@c_titre_court": "Arrêté du 29 juin 1982",
          "@debut": "1983-01-01",
          "@fin": "1983-05-05",
          "@id_txt": "LEGITEXT000006072408"

        {
          "#text": "Arrêté du 22 février 1984 DEROGATION AUX DISPOSITIONS DU PARAG. 4 DE L'ART. 9 DU DECRET DU 14-11-1962 EN CE QUI CONCERNE L'INTERRUPTEUR DES MACHINES-OUTILS PORTATIVES A LA MAIN",
          "@c_titre_court": "Arrêté du 22 février 1984",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000655072"
        },
        {
          "#text": "Arrêté du 22 février 1984 portant dérogation aux dispositions du paragraphe 4 de l'article 9 du décret du 14 novembre 1962 *nouvellement décret 88-1056 du 14 novembre 1988* en ce qui concerne l'interrupteur des machines-outils portatives à main.",
          "@c_titre_court": "Arrêté du 22 février 1984",
          "@debut": "1989-01-01",
          "@fin": "2999-01-01",

      "TITRE_TXT": [
        {
          "#text": "Arrêté du 24 février 1984 DEROGATIONS AUX PRESCRIPTIONS DU DECRET DU 14-11-1962 RELATIF A LA PROTECTION DES TRAVAILLEURS DANS LES ETABLISSEMENTS QUI METTENT EN OEUVRE DES COURANTS ELECTRIQUES",
          "@c_titre_court": "Arrêté du 24 février 1984",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000841423"
        },
        {
          "#text": "Arrêté du 24 février 1984 portant dérogation aux prescriptions du décret du 14 novembre 1962 relatif à la protection des travailleurs dans les établissements qui mettent en oeuvre des courants électriques.",
          "@c_titre_court": "Arrêté du 24 février 1984",
          "@debut": "1989-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006072428"
        },
        {
          "#text": "Arrêté du 24 février 1984 portant dérogation aux prescriptions du décret du 14 novembre 1962 *nouvellement décret 88-1056 du 14 novembre 1988* relatif à la protection des travailleurs dans les établissements qui mettent en oeuvre des courants électriques.",

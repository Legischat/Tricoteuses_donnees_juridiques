    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Arrêté du 12 mars 1982 HABILITATION D'ORGANISMES POUR EFFECTUER DES EXAMENS PREALABLES A L'HOMOLOGATION DE CERTAINES MACHINES LES PLUS DANGEREUSES ET REGLES APPLICABLES AUX DEMANDEURS D'HOMOLOGATIONS",
          "@c_titre_court": "Arrêté du 12 mars 1982",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000859521"
        },
        {
          "#text": "Arrêté du 12 mars 1982 concernant l'habilitation d'organismes pour effectuer des examens préalables à l'homologation de certaines machines les plus dangereuses et règles applicables aux demandeurs d'homologation.",
          "@c_titre_court": "Arrêté du 12 mars 1982",
          "@debut": "1982-04-14",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006072448"
        }
      ],

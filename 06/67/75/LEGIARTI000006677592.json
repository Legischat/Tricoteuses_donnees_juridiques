    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Arrêté du 8 juillet 1985 relatif au remboursement des frais de transport et de séjour nécessités par les examens médicaux prévus par le décret n° 82-397 du 11 mai 1982 relatif à l'organisation et au fonctionnement des services médicaux du travail en agriculture.",
          "@c_titre_court": "Arrêté du 8 juillet 1985",
          "@debut": "1985-07-19",
          "@fin": "2013-04-04",
          "@id_txt": "LEGITEXT000006072504"
        }
      ],
      "@cid": "LEGITEXT000006072504",
      "@date_publi": "2999-01-01",
      "@date_signature": "1985-07-08",
      "@nature": "ARRETE"
    }
  },

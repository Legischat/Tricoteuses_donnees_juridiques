    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Arrêté du 19 août 1985 DESIGNANT L'INSTITUT NATIONAL DE RECHERCHE ET DE SECURITE ET LE LABORATOIRE NATIONAL D'ESSAIS (LNE) POUR DELIVRER DES VISAS D'EXAMEN TECHNIQUE CONCERNANT CERTAINES CATEGORIES DE MACHINES LES PLUS DANGEREUSES ET PRECISANT LES REGLES APPLICABLES AUX DEMANDEURS DE VISAS",
          "@c_titre_court": "Arrêté du 19 août 1985",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000874845"
        },
        {
          "#text": "Arrêté du 19 août 1985 désignant l'Institut national de recherche et de sécurité et le Laboratoire national d'essais pour délivrer des visas d'examen technique concernant certaines des catégories de machines les plus dangereuses et précisant les règles applicables aux demandeurs de visas.",
          "@c_titre_court": "Arrêté du 19 août 1985",
          "@debut": "1985-09-07",

  "NOTA": {
    "CONTENU": "<br/>   [*NOTA - Arrêté du 30 septembre 1987 : confirme le présent arrêté.*]<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les contrôles prévus à l'article 19 du décret n° 67-228 du 15 mars 1967 sont effectués selon les méthodes élaborées par le service central de protection contre les rayonnements ionisants et données en annexe au présent arrêté.<br/>\n<br/>"
  },

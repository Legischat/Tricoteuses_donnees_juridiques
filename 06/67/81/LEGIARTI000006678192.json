      "TITRE_TXT": [
        {
          "#text": "Arrêté du 24 avril 1968 OCTROI AU COMMISSARIAT A L'ENERGIE ATOMIQUE DE DEROGATIONS A CERTAINES DISPOSITIONS DU DECRET 67-228 DU 15 MARS 1967",
          "@c_titre_court": "Arrêté du 24 avril 1968",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000481815"
        },
        {
          "#text": "Arrêté du 24 avril 1968 accordant au commissariat à l'énergie atomique des dérogations à certaines dispositions du décret du 15 mars 1967 relatif à la protection des travailleurs contre les dangers des rayonnements ionisants.",
          "@c_titre_court": "Arrêté du 24 avril 1968",
          "@debut": "1968-06-08",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006072582"
        }
      ],

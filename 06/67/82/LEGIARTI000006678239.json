      "TITRE_TXT": [
        {
          "#text": "Arrêté du 6 avril 1972 LA VALIDITE DE L'ARRETE DU 19-01-1967 RELATIF AU CHARGEMENT PNEUMATIQUE ET AU TIR SANS BOURRAGE DE CERTAINS EXPLOSIFS EST PROROGEE JUSQU'AU 22-01-1977",
          "@c_titre_court": "Arrêté du 6 avril 1972",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000453651"
        },
        {
          "#text": "Arrêté du 6 avril 1972 relatif au chargement pneumatique et tir sans bourrage de certains explosifs.",

  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Arrêté du 11 octobre 1977 MESURES GENERALES DE SECURITE APPLICABLES AUX FLUIDES, DECHETS RADIOACTIFS ET COMBUSTIBLES IRRADIES OU NON DANS LES INSTALLATIONS NUCLEAIRES DE BASE",
          "@c_titre_court": "Arrêté du 11 octobre 1977",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000832146"
        },
        {
          "#text": "Arrêté du 11 octobre 1977 pris en application de l'article 40 du décret n° 75-306 du 28 avril 1975 relatif à la protection des travailleurs contre les dangers des rayonnements ionisants dans les installations nucléaires de base, fixant les mesures générales de sécurité applicables aux fluides, déchets radioactifs et combustibles irradiés ou non dans les installations nucléaires de base.",
          "@c_titre_court": "Arrêté du 11 octobre 1977",
          "@debut": "1978-03-14",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006072599"
        }
      ],
      "@cid": "JORFTEXT000000832146",
      "@date_publi": "1978-03-14",
      "@date_signature": "1977-10-11",
      "@nature": "ARRETE"
    }
  },

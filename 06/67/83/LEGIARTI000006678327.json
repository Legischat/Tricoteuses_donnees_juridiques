          "@debut": "1978-03-14",
          "@fin": "2003-04-02",
          "@id_txt": "LEGITEXT000006072601"
        }
      ],
      "TM": {
        "TITRE_TM": [
          {
            "#text": "Chapitre IV : Installations spécialisées de stockage des déchets radioactifs (au sens de l'article 2 du décret du 11 décembre 1963 modifié).",

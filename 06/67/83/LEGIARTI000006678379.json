      "TITRE_TXT": [
        {
          "#text": "Arrêté du 1 mars 1986 fixant les modalités d'application des articles 2, 5 et 6 du décret n° 86-269 du 13 février 1986 relatif à la protection des travailleurs exposés au benzène.",
          "@c_titre_court": "Arrêté du 1 mars 1986",
          "@debut": "1986-03-14",
          "@fin": "2009-12-18",
          "@id_txt": "LEGITEXT000006072608"
        }
      ],
      "TM": {
        "TITRE_TM": [
          {
            "#text": "Section I : Conditions de dérogation à l'interdiction d'emploi de dissolvants ou diluants renfermant plus de 0,2 p. 100 de benzène.",

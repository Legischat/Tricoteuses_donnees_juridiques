        {
          "#text": "Arrêté du 25 avril 1988 PRIS POUR L'APPLICATION DE L'ART. R233-104-1 DU CODE DU TRAVAIL ET RELATIF A L'INFORMATION SUR LE BRUIT EMIS PAR LES MACHINES ET APPAREILS",
          "@c_titre_court": "Arrêté du 25 avril 1988",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000843652"
        },
        {
          "#text": "Arrêté du 25 avril 1988 pris pour l'application de l'article R. 233-104-1 du code du travail et relatif à l'information sur le bruit émis par les machines et appareils",
          "@c_titre_court": "Arrêté du 25 avril 1988",

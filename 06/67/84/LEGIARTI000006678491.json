      "TITRE_TXT": [
        {
          "#text": "Arrêté du 22 avril 1988 PRIS POUR L'APPLICATION DES ART. R232-8-1 ET R232-8-7 DU CODE DU TRAVAIL RELATIF AU MESURAGE DU BRUIT ET PORTANT MODALITES DE L'AGREMENT DES ORGANISMES DE CONTROLE DU BRUIT",
          "@c_titre_court": "Arrêté du 22 avril 1988",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000480435"
        },
        {
          "#text": "Arrêté du 22 avril 1988 pris pour l'application des articles R. 232-8-1 et R. 232-8-7 relatif au mesurage du bruit et portant modalités de l'agrément des organismes de contrôle du bruit",
          "@c_titre_court": "Arrêté du 22 avril 1988",
          "@debut": "1988-05-10",

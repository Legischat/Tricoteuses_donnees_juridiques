      "TITRE_TXT": [
        {
          "#text": "Arrêté du 10 juillet 1987 RELATIF AUX CONDITIONS DE DELIVRANCE DU PERMIS DE TIR PREVU PAR LE DECRET 87231 DU 17-03-1987 CONCERNANT LES PRESCRIPTIONS PARTICULIERES DE PROTECTION RELATIVES A L'EMPLOI D'EXPLOSIFS DANS LES TRAVAUX DU BATIMENT,LES TRAVAUX PUBLICS ET LES TRAVAUX AGRICOLES",
          "@c_titre_court": "Arrêté du 10 juillet 1987",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000660610"
        },
        {
          "#text": "Arrêté du 10 juillet 1987 relatif aux conditions de délivrance du permis de tir prévu par le décret n° 87-231 du 27 mars 1987 concernant les prescriptions particulières de protection relatives à l'emploi des explosifs dans les travaux du bâtiment, les travaux publics et les travaux agricoles",
          "@c_titre_court": "Arrêté du 10 juillet 1987",

  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Arrêté du 24 janvier 1989 DESIGNANT L'INSTITUT NATIONAL DE RECHERCHE ET DE SECURITE ET LE LABORATOIRE NATIONAL D'ESSAIS POUR DELIVRER DES ATTESTATIONS D'EXAMEN DE TYPE CONCERNANT CERTAINES CATEGORIES DE MACHINES LES PLUS DANGEREUSES ET PRECISANT LES REGLES APPLICABLES AUX DEMANDEURS D'ATTESTATION",
          "@c_titre_court": "Arrêté du 24 janvier 1989",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000295720"
        },
        {
          "#text": "Arrêté du 24 janvier 1989 désignant l'Institut national de recherche et de sécurité et le Laboratoire national d'essais pour délivrer des attestations d'examen de type concernant certaines catégories de machines les plus dangereuses et précisant les règles applicables aux demandeurs d'attestation",
          "@c_titre_court": "Arrêté du 24 janvier 1989",
          "@debut": "1989-02-10",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006058790"
        }
      ],
      "@cid": "JORFTEXT000000295720",
      "@date_publi": "1989-02-10",
      "@date_signature": "1989-01-24",
      "@nature": "ARRETE",
      "@nor": "TEFT8903104A"
    }
  },

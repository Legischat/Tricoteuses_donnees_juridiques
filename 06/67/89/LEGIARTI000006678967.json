    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Arrêté du 13 septembre 1989 FIXANT LES ESSAIS ET MESURES RELATIFS A LA CONFORMITE DES CHARIOTS DE MANUTENTION AUTOMOTEURS ET DE LEURS EQUIPEMENTS ET RENDANT OBLIGATOIRE UNE NORME SPECIFIANT CES ESSAIS ET MESURES ET LEURS RESULTATS",
          "@c_titre_court": "Arrêté du 13 septembre 1989",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000667220"
        },
        {
          "#text": "Arrêté du 13 septembre 1989 fixant les essais et mesures relatifs à la conformité des chariots de manutention automoteurs et de leurs équipements et rendant obligatoire une norme spécifiant ces essais et mesures et leurs résultats",
          "@c_titre_court": "Arrêté du 13 septembre 1989",
          "@debut": "1989-09-24",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006059190"
        }

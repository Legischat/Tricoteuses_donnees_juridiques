        {
          "#text": "Arrêté du 24 mars 1981  RELATIF A LA DATE D'APPLICATION DE CERTAINES DISPOSITIONS DU CODE DU TRAVAIL RELATIVES AUX MACHINES ET APPAREILS DANGEREUX UTILISES EN AGRICULTURE.",
          "@c_titre_court": "Arrêté du 24 mars 1981",
          "@debut": "1981-03-31",
          "@fin": "2999-01-01",

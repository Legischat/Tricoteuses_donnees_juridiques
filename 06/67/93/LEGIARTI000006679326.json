    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Arrêté du 18 décembre 1992 relatif à la norme dont le respect est réputé permettre de satisfaire aux exigences du système d'assurance qualité des fabricants de certains équipements de protection individuelle.",
          "@c_titre_court": "Arrêté du 18 décembre 1992",
          "@debut": "1993-01-01",

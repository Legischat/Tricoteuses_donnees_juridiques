  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Arrêté du 11 décembre 1992 fixant les conditions d'aménagement des véhicules    sur piste utilisés dans les travaux souterrains pour le transport ou la mise    en oeuvre de produits explosifs à front des chantiers (Explosifs, première    partie, 1A, art. 64)",
          "@c_titre_court": "Arrêté du 11 décembre 1992",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000543795"
        },
        {
          "#text": "Arrêté du 11 décembre 1992 fixant les conditions d'aménagement des véhicules sur piste utilisés dans les travaux souterrains pour le transport ou la mise en oeuvre de produits explosifs à front des chantiers (Explosifs, première partie, 1 A, art. 64)",
          "@c_titre_court": "Arrêté du 11 décembre 1992",

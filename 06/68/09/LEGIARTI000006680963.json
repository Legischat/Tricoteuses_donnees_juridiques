  "NOTA": {
    "CONTENU": "<br/>   [*Nota : Code de la famille et de l'aide sociale 230 : les dispositions du présent article du code sont applicables à l'union territoriale des associations familiales de Mayotte.<br/>\n<br/>   Code de la famille et de l'aide sociale 255 : dans le cadre de l'application du présent article à la collectivité territoriale de Mayotte, les mots :<br/>\n \"département\" sont remplacés par \"collectivité territoriale\" ;<br/>\n \"président du conseil général\" sont remplacés par \"représentant du Gouvernement\" ;<br/>\n \"représentant de l'Etat dans le département\" sont remplacés par \"représentant du Gouvernement\".*]<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Il peut être créé :<br/>\n<br/>   Dans chaque département, une fédération départementale dite Union départementale des associations familiales, composée comme il est prévu à l'article 4 ;<br/>\n<br/>   Au niveau national, une fédération dite Union nationale des associations familiales, composée comme il est prévu à l'article 5.<br/>"
  },

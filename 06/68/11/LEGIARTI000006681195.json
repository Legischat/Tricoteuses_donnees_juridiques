  "NOTA": {
    "CONTENU": "<br/>   [*Nota : Code de la famille et de l'aide sociale 255 : dans le cadre de l'application du présent article à la collectivité territoriale de Mayotte, les mots :<br/>\n \"département\" sont remplacés par \"collectivité territoriale\" ;<br/>\n \"président du conseil général\" sont remplacés par \"représentant du Gouvernement\" ;<br/>\n \"représentant de l'Etat dans le département\" sont remplacés par \"représentant du Gouvernement\".*]<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Un décret en Conseil d'Etat détermine les conditions dans lesquelles le service de l'aide sociale à l'enfance d'un département accède aux demandes de renseignements relatives à une famille ou à un mineur formulées par le service de l'aide sociale à l'enfance d'un autre département pour l'accomplissement de ses missions.<br/>\n<br/>"
  },

  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   L'assurance maladie et maternité est régie par les dispositions suivantes du code de la sécurité sociale :<br/>\n<br/>   - L. 161-1 à L. 161-5 ;<br/>\n<br/>   - L. 161-8, L. 161-12 à L. 161-15 et L. 162-2 ;<br/>\n<br/>   - L. 162-3 et L. 162-4 ;<br/>\n<br/>   - L. 162-29 et L. 162-30 ;<br/>\n<br/>   - L. 174-4 ;<br/>\n<br/>   - L. 217-1 ;<br/>\n<br/>   - L. 311-5 ;<br/>\n<br/>   - L. 311-9 sous réserve des dispositions de l'article 9-4 ci-dessous ;<br/>\n<br/>   - L. 313-1 à L. 313-3 ;<br/>\n<br/>   - L. 315-1 ;<br/>\n<br/>   - L. 321-1 ;<br/>\n<br/>   - L. 322-1 à L. 322-6 sous réserve des dispositions de l'article 9-5 ci-dessous ;<br/>\n<br/>    - L. 323-1 à L. 323-5 sous réserve des dispositions de l'article 9-6 ci-dessous ;<br/>\n<br/>    - L. 324-1 ;<br/>\n<br/>    - L. 331-1 à L. 331-7 ;<br/>\n<br/>    - L. 332-1 et L. 332-2 ;<br/>\n<br/>    - L. 371-1 à L. 371-3 et L. 371-5 à L. 371-7 ;<br/>\n<br/>    - L. 374-1 ;<br/>\n<br/>    - L. 375-1 ;<br/>\n<br/>    - L. 376-1 à L. 376-3 ;<br/>\n<br/>    - L. 377-1 à L. 377-5.<br/>"
  },

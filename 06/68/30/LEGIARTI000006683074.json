  "NOTA": {
    "CONTENU": "<br/>   Nota - Décision n° 76180, Conseil d'Etat 25 janvier 1993 JORF du 7 novembre 1995 : annule l'article 12 du décret n° 85-1458 du 30 décembre 1985.<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les établissements sociaux visés à l'article 185 du code de la famille et de l'aide sociale qui ont une activité annexe de production et de commercialisation appliquent les règles mentionnées aux articles 11 et 12 du décret n° 77-1546 du 31 décembre 1977 modifié.<br/>\n<br/>"
  },

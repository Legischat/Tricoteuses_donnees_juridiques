  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret n°86-510 du 14 mars 1986 PORTANT APPLICATION DE L'AL. 2 DE L'ART. 167 DU CODE DE LA FAMILLE ET DE L'AIDE SOCIALE ET FIXANT LES MODALITES SELON LESQUELLES LES TRAVAILLEURS HANDICAPES ADMIS DANS LES CENTRES D'AIDE PAR LE TRAVAIL PEUVENT ETRE AUTORISES A EXERCER UNE ACTIVITE A L'EXTERIEUR DE L'ETABLISSEMENT",
          "@c_titre_court": "Décret n°86-510 du 14 mars 1986",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000692515"
        },
        {
          "#text": "Décret n°86-510 du 14 mars 1986 portant application du deuxième alinéa de l'article 167 du code de la famille et de l'aide sociale et fixant les modalités selon lesquelles les travailleurs handicapés admis dans les centres d'aide par le travail peuvent être autorisés à exercer une activité à l'extérieur de l'établissement",
          "@c_titre_court": "Décret n°86-510 du 14 mars 1986",
          "@debut": "1986-03-16",
          "@fin": "2004-10-26",
          "@id_txt": "LEGITEXT000006065559"
        }
      ],

          "@origine": "LEGI"
        },
        "@etat": "ABROGE"
      }
    ]
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les dispositions des décrets du 28 décembre 1977 et du 31 décembre 1977 susvisés demeurent applicables aux centres d'aide par le travail dans le cas où des travailleurs handicapés exercent une activité extérieure dans les conditions définies par le présent décret.<br/>\n<br/>"
  },

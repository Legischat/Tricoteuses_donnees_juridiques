  "NOTA": {
    "CONTENU": "<br/>  Loi 2004-806 2004-08-09 art. 124 II : les présentes dispositions entrent en vigueur à la proclamation des résultats des élections ordinales de 2005.<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Le Conseil national de l'ordre des pharmaciens statue en appel sur les décisions des conseils régionaux de la section A et celles des conseils centraux des sections B, C, D, E, G et H en matière d'inscription dans le délai de trois mois à dater du jour où l'appel a été formé.<br/>\n<br/>"
  },

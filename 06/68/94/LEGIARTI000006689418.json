  "NOTA": {
    "CONTENU": "<br/>  Ordonnance 2003-850 2003-09-04 art. 25 : les dispositions du présent article sont applicables à la collectivité départementale de Mayotte.<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Peuvent exercer la profession de psychomotricien et porter le titre de psychomotricien, accompagné ou non d'un qualificatif, les personnes titulaires du diplôme mentionné à l'article L. 4332-3 ou titulaires de l'autorisation prévue à l'article L. 4332-4 et dont les diplômes, certificats, titres ou autorisation ont été enregistrés conformément au premier alinéa de l'article L. 4333-1.<br/>\n<br/>"
  },

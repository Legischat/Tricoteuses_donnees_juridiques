  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Sont applicables à Mayotte, sous réserve des dispositions des articles L. 4412-2 à L. 4412-6, les dispositions suivantes du livre II de la présente partie :<br/>\n<br/>   1° Le titre Ier, à l'exception des articles L. 4211-2, L. 4211-3, L. 4211-8, L. 4212-1, L. 4212-6 et L. 4212-7 ;<br/>\n<br/>   2° Le titre II, à l'exception des articles L. 4221-3, L. 4221-11, L. 4221-15, L. 4222-1 à L. 4222-4 et L. 4222-7 ;<br/>\n<br/>   3° Le titre III, à l'exception des articles L. 4232-3 à L. 4232-9, L. 4232-15, L. 4234-1 et L. 4234-3 ;<br/>\n<br/>   4° Le titre IV, à l'exception de l'article L. 4241-9.<br/>"
  },

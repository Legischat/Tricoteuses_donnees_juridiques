  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Est puni de 3 750 Euros d'amende le fait, pour un pharmacien :<br/>\n<br/>   1° De ne pas exercer personnellement sa profession ;<br/>\n<br/>   2° De ne pas disposer, pour l'exercice de sa profession, du nombre de pharmaciens qui doivent l'assister en raison de l'importance de son chiffre d'affaires.<br/>"
  },

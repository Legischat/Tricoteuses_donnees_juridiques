  "NOTA": {
    "CONTENU": "<br/>   [*Nota : Code de la santé publique L. 556 : sanction pénale.*]<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   La publicité pour les produits autres que les médicaments présentés comme favorisant le diagnostic, la prévention ou le traitement des maladies, des affections relevant de la pathologie chirurgicale et des dérèglements physiologiques, le diagnostic ou la modification de l'état physique ou physiologique, la restauration, la correction ou la modification des fonctions organiques est soumise aux dispositions des articles L. 551-1 (premier alinéa), L. 551-5 et L. 551-6.<br/>\n<br/>"
  },

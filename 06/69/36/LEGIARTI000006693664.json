  "NOTA": {
    "CONTENU": "<br/>   [*Nota : Ordonnance 92-1070 du 1er octobre 1992 art. 46 : le présent article du code de la santé publique, en vigueur au 7 avril 1992, s'applique à la collectivité territoriale de Mayotte.*]<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Tout débit, étalage ou distribution de médicaments est interdit sur la voie publique, dans les foires ou marchés, à toute personne, même munie du diplôme de pharmacien.<br/>\n<br/>"
  },

  "NOTA": {
    "CONTENU": "<br/>   *Nota : Ordonnance 92-1070 du 1er octobre 1992 art. 51 : le présent article du code de la santé publique, en vigueur au 7 avril 1992, s'applique à la collectivité territoriale de Mayotte.*<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {

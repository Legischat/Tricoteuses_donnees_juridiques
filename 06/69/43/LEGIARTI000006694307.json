  "NOTA": {
    "CONTENU": "<br/>  <br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Le fait d'utiliser sciemment ou de distribuer des produits sanguins sans qu'il ait été procédé aux analyses biologiques et aux tests de dépistage de maladies transmissibles requis en application de l'article L. 666-4 est puni d'un emprisonnement de deux ans et d'une amende de 500 000 F.<br/>\n<br/>"
  },

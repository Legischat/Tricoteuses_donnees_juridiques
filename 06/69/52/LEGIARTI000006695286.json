  "NOTA": {
    "CONTENU": "<br/>   Nota : Décret 59-805 du 4 juillet 1959 : remplace l'article L. 807 par des dispositions reglementaires.<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les modalités de désignation des membres, l'organisation et le fonctionnement des commissions paritaires font l'objet d'arrêtés concertés des ministres de la santé publique et de la population, de l'intérieur et des finances et des affaires économiques.<br/>\n<br/>"
  },

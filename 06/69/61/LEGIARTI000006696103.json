  "NOTA": {
    "CONTENU": "<br/>   *Nota - Décret 76-769 du 9 août 1976 : date d'entrée en vigueur.*<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   L'Etat peut consentir une aide financière aux collectivités locales et à leurs établissements publics n'ayant pas le caractère industriel et commercial, dans les conditions prévues à l'article L. 323-9 du code du travail.<br/>\n<br/>"
  },

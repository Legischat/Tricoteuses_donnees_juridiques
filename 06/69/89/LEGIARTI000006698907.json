  "NOTA": {
    "CONTENU": "<br/>   Nota : Décret 2002-254 2002-02-22 art. 30 : Le décret n° 94-604 est abrogé toutefois, celles de ces dispositions qui sont nécessaires aux besoins du transfert mentionné au deuxième alinéa de l'article 24 sont maintenues en vigueur jusqu'à la publication de l'arrêté opérant ce transfert.<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les opérations financières et comptables de l'office sont effectuées conformément aux dispositions des décrets du 10 décembre 1953 et du 29 décembre 1962 susvisés.<br/>\n<br/>"
  },

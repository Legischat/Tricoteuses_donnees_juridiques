    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret n°95-648 du 9 mai 1995 RELATIF AUX CONDITIONS TECHNIQUES DE FONCTIONNEMENT AUXQUELLES DOIVENT SATISFAIRE LES ETABLISSEMENTS DE SANTE POUR ETRE AUTORISES A METTRE EN OEUVRE L'ACTIVITE DE SOINS ACCUEIL ET TRAITEMENT DES URGENCES ET MODIFIANT LE CODE DE LA SANTE PUBLIQUE (TROISIEME PARTIE: DECRETS)",
          "@c_titre_court": "Décret n°95-648 du 9 mai 1995",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000512359"
        },
        {
          "#text": "Décret n°95-648 du 9 mai 1995 relatif aux conditions techniques de fonctionnement auxquelles doivent satisfaire les établissements de santé pour être autorisés à mettre en oeuvre l'activité de soins Accueil et traitement des urgences et modifiant le code de la santé publique (troisième partie : Décrets)",
          "@c_titre_court": "Décret n°95-648 du 9 mai 1995",
          "@debut": "1995-05-10",
          "@fin": "2005-07-26",

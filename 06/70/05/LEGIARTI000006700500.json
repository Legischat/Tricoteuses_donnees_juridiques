  "NOTA": {
    "CONTENU": "<br/>Décret 96-741 du 21 août 1996, art. 4 : Ces dispositions entrent en vigueur à compter de la rentrée scolaire de l'année 1996-1997. <br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   A compter de la date de publication du présent décret, l'appellation \"diplôme d'Etat de laborantin d'analyses médicales\" est remplacée par l'appellation \"diplôme d'Etat de technicien en analyses biomédicales\" dans tout acte administratif en comportant la mention.<br/>\n<br/>"
  },

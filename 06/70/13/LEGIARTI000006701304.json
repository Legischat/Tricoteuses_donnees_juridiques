  "NOTA": {
    "CONTENU": "<br/>   [*Nota - (1) taux résultant de la loi 89-469 du 10 juillet 1989.*]<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Toute personne qui, par dénomination, emblèmes ou tout autre moyen, tend à faire croire faussement qu'elle est titulaire de l'agrément prévu à l'article 1er et à l'article 5 ci-dessus sera punie d'une amende de 3000 à 6000 F [*montant (1)*]. En cas de récidive, l'amende sera portée à 12000 F.<br/>\n<br/>"
  },

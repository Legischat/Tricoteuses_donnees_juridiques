  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret n°73-502 du 21 mai 1973 RELATIF AUX INFRACTIONS A CERTAINES DISPOSITIONS DU TITRE 1ER DU LIVRE 1ER DU CODE DE LA SANTE PUBLIQUE. LES DISPOSITIONS DE L'ART. L45 REPRIMANT LES INFRACTIONS A L'ART. L10 DU MEME CODE SONT ABROGEES",
          "@c_titre_court": "Décret n°73-502 du 21 mai 1973",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000307028"
        },
        {
          "#text": "Décret n°73-502 du 21 mai 1973  RELATIF AUX INFRACTIONS A CERTAINES DISPOSITIONS DU TITRE 1 DU LIVRE 1 DU CODE DE LA SANTE PUBLIQUE.",

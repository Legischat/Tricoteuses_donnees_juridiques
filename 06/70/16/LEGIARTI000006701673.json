        {
          "#text": "Décret n°87-944 du 25 novembre 1987 RELATIF A L'EXERCICE D'UNE ACTIVITE LIBERALE PAR LES PRATICIENS HOSPITALIERS A TEMPS PLEIN DANS LES ETABLISSEMENTS D'HOSPITALISATION PUBLICS",
          "@c_titre_court": "Décret n°87-944 du 25 novembre 1987",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000696714"
        },
        {
          "#text": "Décret n°87-944 du 25 novembre 1987 relatif à l'exercice d'une activité libérale par les praticiens hospitaliers à temps plein dans les établissements d'hospitalisation publics",
          "@c_titre_court": "Décret n°87-944 du 25 novembre 1987",
          "@debut": "1987-11-26",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006066248"

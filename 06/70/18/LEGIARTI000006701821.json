  "NOTA": {
    "CONTENU": "<br/>   [*Nota : Décret 91-987 1991-09-26 art. 1 : dérogation au présent décret.*]<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Le directeur départemental apporte son concours au commissaire de la République pour la mise en oeuvre de la procédure d'opposition, d'injonction et de fermeture ainsi que de la surveillance des établissements [*institutions sociales et médico-sociales*] mentionnés par la loi n° 75-535 du 30 juin 1975 et par le code de la famille et de l'aide sociale susvisés.<br/>\n<br/>"
  },

  "NOTA": {
    "CONTENU": "<br/>   [*Nota : Décret 91-987 1991-09-26 art. 1 : dérogation au présent décret.*]<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Le directeur départemental [*attribution*] est habilité à donner son avis sur les projets préparés par les services de l'Etat et ayant des incidences, au plan sanitaire et social, sur les conditions de vie des populations, notamment en matière d'aménagement du territoire, d'urbanisme, de logement, de transport et d'éducation.<br/>\n<br/>"
  },

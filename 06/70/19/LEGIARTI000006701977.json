  "NOTA": {
    "CONTENU": "<br/>   Nota : Décret 92-443 1992-05-15 art. 4 : les dispositions du présent décret sont abrogées à l'exception des dispositions concernant l'assistance publique-hôpitaux de Paris, les hospices civils de Lyon et l'assistance publique de Marseille.<br/>\n<br/>   Décret 92-1098 1992-10-02 art. 3 2° : les dispositions du présent décret sont abrogées en tant qu'elles concernent l'Assistance publique-hôpitaux de Paris.<br/>\n<br/>   Décret 92-1099 1992-10-02 art. 3 : les dispositions du présent décret sont abrogées en ce qu'elles concernent les hospices civils de Lyon et l'Assistance publique de Marseille.<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "Les décrets n° 60-550 du 7 juin 1960 et n° 62-794 du 9 juillet 1962 modifiés sont abrogés.<br/>\n<br/>"
  },

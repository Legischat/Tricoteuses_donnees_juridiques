  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Le Comité national pour l'évaluation médicale comprend :<br/>\n<br/>   - le président de l'Académie nationale de médecine ;<br/>\n<br/>   - le président de l'ordre national des médecins ;<br/>\n<br/>   - le président de la conférence des doyens des facultés de médecine ;<br/>\n<br/>   - le président de la Caisse nationale d'assurance maladie des travailleurs salariés ;<br/>\n<br/>   - le président de la conférence des présidents des commissions médicales d'établissements des centres hospitalo-universitaires ;<br/>\n<br/>   - le président de la conférence des présidents des commissions médicales d'établissements des hôpitaux généraux ;<br/>\n<br/>   - le président de l'Union nationale d'associations de formation médicale continue ;<br/>\n<br/>   - les présidents des syndicats médicaux français les plus représentatifs ;<br/>\n<br/>   Chacun des membres du comité national désigne un suppléant.<br/>"
  },

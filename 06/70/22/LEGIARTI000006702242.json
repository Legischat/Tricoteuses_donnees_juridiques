      "TITRE_TXT": [
        {
          "#text": "Décret n°88-347 du 11 avril 1988 FIXANT LES CONDITIONS D'INTEGRATION DANS LA FONCTION PUBLIQUE HOSPITALIERE DES FONCTIONNAIRES ET STAGIAIRES DES COLLECTIVITES TERRITORIALES QUI EXERCENT UNE ACTIVITE DE LUTTE CONTRE LES MALADIES MENTALES",
          "@c_titre_court": "Décret n°88-347 du 11 avril 1988",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000872562"
        },
        {
          "#text": "Décret n°88-347 du 11 avril 1988 fixant les conditions d'intégration dans la fonction publique hospitalière des fonctionnaires et stagiaires des collectivités territoriales qui exercent une activité de lutte contre les maladies mentales",
          "@c_titre_court": "Décret n°88-347 du 11 avril 1988",
          "@debut": "1988-04-13",
          "@fin": "2999-01-01",

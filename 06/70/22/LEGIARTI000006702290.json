  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret n°88-404 du 20 avril 1988 FIXANT LES CONDITIONS DE FORMATION OU D'EXPERIENCE PROFESSIONNELLE A REMPLIR PAR LES PERSONNES DEMANDANT A FAIRE L'OBJET DE LA DECISION ADMINISTRATIVE PREVUE A L'ART. L510-8-2 DU CODE DE LA SANTE PUBLIQUE ET DETERMINANT LES MODALITES DE CETTE DECISION ADMINISTRATIVE",
          "@c_titre_court": "Décret n°88-404 du 20 avril 1988",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000315970"
        },
        {
          "#text": "Décret n°88-404 du 20 avril 1988 fixant les conditions de formation ou d'expérience professionnelle à remplir par les personnes demandant à faire l'objet de la décision administrative prévue à l'article L. 510-8-2 du code de la santé publique et déterminant les modalités de cette décision administrative",
          "@c_titre_court": "Décret n°88-404 du 20 avril 1988",
          "@debut": "1988-04-22",
          "@fin": "2004-08-08",
          "@id_txt": "LEGITEXT000006066578"
        }
      ],

    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret n°88-59 du 18 janvier 1988 portant application des articles L. 162-8 et L. 162-9 du code de la santé publique et relatif aux établissements publics d'hospitalisation tenus de pratiquer des interruptions volontaires de grossesse *IVG*.",
          "@c_titre_court": "Décret n°88-59 du 18 janvier 1988",
          "@debut": "1988-01-20",
          "@fin": "2002-05-05",
          "@id_txt": "LEGITEXT000006072689"
        }
      ],

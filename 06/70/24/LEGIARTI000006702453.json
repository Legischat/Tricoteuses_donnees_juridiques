      "TITRE_TXT": [
        {
          "#text": "Décret n°88-165 du 19 février 1988 PRIS POUR L'APPLICATION DE L'ART. 89 DE LA LOI 8633 DU 09-01-1986 PORTANT DISPOSITIONS STATUTAIRES RELATIVES A LA FONCTION PUBLIQUE HOSPITALIERE ET RELATIF AU CONGE SPECIAL DES PERSONNELS DE DIRECTION DES ETABLISSEMENTS MENTIONNES A L'ART. 2 DE LADITE LOI",
          "@c_titre_court": "Décret n°88-165 du 19 février 1988",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000684429"
        },
        {
          "#text": "Décret n°88-165 du 19 février 1988 pris pour l'application de l'article 89 de la loi n° 86-33 du 9 janvier 1986 portant dispositions statutaires relatives à la fonction publique hospitalière et relatif au congé spécial des personnels de direction des établissements mentionnés à l'article 2 de ladite loi",
          "@c_titre_court": "Décret n°88-165 du 19 février 1988",

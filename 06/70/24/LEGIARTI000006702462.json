      "TITRE_TXT": [
        {
          "#text": "Décret n°88-166 du 19 février 1988 ANT POUR 1988 DES CONGES SPECIAUX A CERTAINS PERSONNELS DE DIRECTION DES ETABLISSEMENTS MENTIONNES A L'ART. 2 DE LA LOI 8633 DU 09-01-1986 MODIFIEE PORTANT DISPOSITIONS STATUTAIRES RELATIVES A LA FONCTION PUBLIQUE HOSPITALIERE",
          "@c_titre_court": "Décret n°88-166 du 19 février 1988",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000871612"
        },
        {
          "#text": "Décret n°88-166 du 19 février 1988 accordant pour 1988 des congés spéciaux à certains personnels de direction des établissements mentionnés à l'article 2 de la loi n° 86-33 du 9 janvier 1986 modifiée portant dispositions statutaires relatives à la fonction publique hospitalière",
          "@c_titre_court": "Décret n°88-166 du 19 février 1988",
          "@debut": "1988-02-20",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006066430"
        }
      ],

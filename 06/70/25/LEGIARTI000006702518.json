      "TITRE_TXT": [
        {
          "#text": "Décret n°88-163 du 19 février 1988 PORTANT STATUT PARTICULIER DES GRADES ET EMPLOIS DES PERSONNELS DE DIRECTION DES ETABLISSEMENTS MENTIONNES A L'ART. 2 (1EREMENT,2EMEMENT ET 3EMEMENT) DE LA LOI 8633 DU 09-01-1986 PORTANT DISPOSITIONS STATUTAIRES RELATIVES A LA FONCTION PUBLIQUE HOSPITALIERE",
          "@c_titre_court": "Décret n°88-163 du 19 février 1988",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000315025"
        },
        {
          "#text": "Décret n°88-163 du 19 février 1988 portant statut particulier des grades et emplois des personnels de direction des établissements mentionnés à l'article 2 (1°, 2° et 3°) de la loi n° 86-33 du 9 janvier 1986 portant dispositions statutaires relatives à la fonction publique hospitalière",
          "@c_titre_court": "Décret n°88-163 du 19 février 1988",

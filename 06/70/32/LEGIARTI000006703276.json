  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret n°88-225 du 10 mars 1988 PRIS POUR L'APPLICATION DES ART. 20-1 ET 20-2 DE LA LOI 701318 DU 31-12-1970 PORTANT REFORME HOSPITALIERE ET RELATIF A LA NOMINATION AUX FONCTIONS DE CHEF DE SERVICE DANS LES ETABLISSEMENTS D'HOSPITALISATION PUBLICS",
          "@c_titre_court": "Décret n°88-225 du 10 mars 1988",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000508893"
        },
        {
          "#text": "Décret n°88-225 du 10 mars 1988 pris pour l'application des articles 20-1 et 20-2 de la loi du 31 décembre 1970 portant réforme hospitalière et relatif à la nomination aux fonctions de chef de service dans les établissements d'hospitalisation publics",
          "@c_titre_court": "Décret n°88-225 du 10 mars 1988",
          "@debut": "1988-03-11",
          "@fin": "1992-08-23",
          "@id_txt": "LEGITEXT000006066457"
        }
      ],

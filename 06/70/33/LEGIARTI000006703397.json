    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret n°88-280 du 24 mars 1988 PRIS POUR L'APPLICATION DU 7EMEMENT DE L'ART. L761-11 DU CODE DE LA SANTE PUBLIQUE RELATIF AUX CONDITIONS DANS LESQUELLES LES MEDECINS SPECIALISTES QUALIFIES EN ANATOMIE ET CYTOLOGIE PATHOLOGIQUES PEUVENT EFFECTUER LES ACTES DE CETTE DISCIPLINE EN DEHORS DES LABORATOIRES D'ANALYSES DE BIOLOGIE MEDICALE",
          "@c_titre_court": "Décret n°88-280 du 24 mars 1988",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000315480"
        },
        {
          "#text": "Décret n°88-280 du 24 mars 1988 pris pour l'application du 7° de l'article L. 761-11 du code de la santé publique relatif aux conditions dans lesquelles les médecins spécialistes qualifiés en anatomie et cytologie pathologiques peuvent effectuer les actes de cette discipline en dehors des laboratoires d'analyses de biologie médicale",
          "@c_titre_court": "Décret n°88-280 du 24 mars 1988",
          "@debut": "1988-03-26",
          "@fin": "2005-07-26",
          "@id_txt": "LEGITEXT000006066500"
        }
      ],
      "@cid": "JORFTEXT000000315480",
      "@date_publi": "1988-03-26",
      "@date_signature": "1988-03-24",
      "@nature": "DECRET",
      "@nor": "ASEP8800393D",
      "@num": "88-280"
    }
  },

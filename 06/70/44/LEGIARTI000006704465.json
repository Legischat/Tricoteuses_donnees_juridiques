        {
          "#text": "Décret n°89-175 du 14 mars 1989 RELATIF AUX CONDITIONS DE RECLASSEMENT DES AGENTS DES ETABLISSEMENTS POUR ADULTES HANDICAPES OU INADAPTES ET DES CENTRES D'HEBERGEMENT ET DE READAPTATION SOCIALE EN APPLICATION DE L'ART. 127 DE LA LOI 8633 DU 09-01-1986",
          "@c_titre_court": "Décret n°89-175 du 14 mars 1989",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000684457"
        },
        {
          "#text": "Décret n°89-175 du 14 mars 1989 relatif aux conditions de reclassement des agents des établissements pour adultes handicapés ou inadaptés et des centres d'hébergement et de réadaptation sociale en application de l'article 127 de la loi n° 86-33 du 9 janvier 1986",
          "@c_titre_court": "Décret n°89-175 du 14 mars 1989",
          "@debut": "1989-03-18",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006067006"

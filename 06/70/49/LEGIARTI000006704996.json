  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Toute personne qui enfreint l'une des interdictions prescrites par les articles 65 ou 71 de la présente loi est passible d'un emprisonnement de six mois à deux ans et d'une amende de 2.000 F à 100.000 F.<br/>\n<br/>"
  },

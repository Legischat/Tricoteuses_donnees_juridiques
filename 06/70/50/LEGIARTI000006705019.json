        {
          "#text": "Décret n°80-793 du 1 octobre 1980 RELATIF A LA NOMINATION ET A L'AVANCEMENT DU PERSONNEL DE DIRECTION DES ETABLISSEMENTS SOCIAUX MENTIONNES A L'ART. L792 (4EMEMENT ET 5EMEMENT) DU CODE DE LA SANTE PUBLIQUE",
          "@c_titre_court": "Décret n°80-793 du 1 octobre 1980",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000503003"
        },
        {
          "#text": "Décret n°80-793 du 1 octobre 1980 relatif à la nomination et à l'avancement du personnel de direction des établissements sociaux mentionnés à l'article L. 792 (4° et 5°) du code de la santé publique.",
          "@c_titre_court": "Décret n°80-793 du 1 octobre 1980",
          "@debut": "1980-10-08",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006063325"
        }
      ],
      "TM": {
        "TITRE_TM": [
          {
            "#text": "Section III : Personnel de direction des établissements pour mineurs inadaptés et des foyers de l'enfance.",

  "NOTA": {
    "CONTENU": "<br/>   [*Nota : les annexes du présent décret ne sont pas reproduites.*]<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Un arrêté du ministre chargé de la santé, pris après avis du Conseil supérieur d'hygiène publique de France [*autorités compétentes*], définit :<br/>\n<br/>   1° Les règles d'hygiène applicables au forage, aux installations, aux dispositifs de conditionnement et aux récipients ;<br/>\n<br/>   2° Les méthodes de gazéification et de correction de la qualité des eaux conditionnées.<br/>"
  },

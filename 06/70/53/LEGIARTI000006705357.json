  "BLOC_TEXTUEL": {
    "CONTENU": "<p>A compter du 1er janvier 2002, les techniciens de laboratoire de classe supérieure sont reclassés dans le grade de technicien de laboratoire de classe supérieure, selon le tableau de correspondance qui suit :</p>\n<table>\n<tbody>\n<tr>\n<td>\n<p align=\"center\">SITUATION ANTERIEURE</p>\n</td>\n<td colspan=\"2\">\n<p align=\"center\">SITUATION NOUVELLE</p>\n</td>\n</tr>\n<tr>\n<td>\n<p align=\"center\">Technicien de laboratoire de classe supérieure</p>\n</td>\n<td colspan=\"2\">\n<p align=\"center\">Technicien de laboratoire de classe supérieure</p>\n</td>\n</tr>\n<tr>\n<td>\n<p align=\"center\">Echelons</p>\n</td>\n<td>\n<p align=\"center\">Echelons</p>\n</td>\n<td>\n<p align=\"center\">Ancienneté conservée </p>\n</td>\n</tr>\n<tr>\n<td>\n<p align=\"center\">5e : </p>\n<p>a) 7 ans d'ancienneté et plus: </p>\n<p>b) Moins de 7 ans</p>\n</td>\n<td>\n<p align=\"center\">6e </p>\n<p align=\"center\"> </p>\n<p align=\"center\">5e</p>\n</td>\n<td>\n<p align=\"center\">Sans ancienneté </p>\n<p align=\"center\"> </p>\n<p align=\"center\">½ de l'ancienneté acquise plus 6 mois</p>\n</td>\n</tr>\n<tr>\n<td>\n<p align=\"center\">4e </p>\n</td>\n<td>\n<p align=\"center\">4e </p>\n</td>\n<td>\n<p align=\"center\">3/4de l'ancienneté acquise </p>\n</td>\n</tr>\n<tr>\n<td>\n<p align=\"center\">3e </p>\n</td>\n<td>\n<p align=\"center\">3e </p>\n</td>\n<td>\n<p align=\"center\">Ancienneté acquise</p>\n</td>\n</tr>\n<tr>\n<td>\n<p align=\"center\">2e </p>\n</td>\n<td>\n<p align=\"center\">2e </p>\n</td>\n<td>\n<p align=\"center\">2/3 de l'ancienneté acquise</p>\n</td>\n</tr>\n<tr>\n<td rowspan=\"2\">\n<p align=\"center\">1er </p>\n</td>\n<td rowspan=\"2\">\n<p align=\"center\">1er </p>\n</td>\n<td rowspan=\"2\">\n<p align=\"center\">2/3 de l'ancienneté acquise</p>\n</td>\n</tr>\n</tbody>\n</table>"
  },

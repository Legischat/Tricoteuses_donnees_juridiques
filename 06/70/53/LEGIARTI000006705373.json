  "NOTA": {
    "CONTENU": "<br/>   [*Nota : Décret 89-613 du 1er septembre 1989 art. 65 : les agents stagiaires et titulaires mentionnés à l'article 57 et reclassés à la date d'effet du présent décret, bénéficient d'une bonification d'ancienneté de six mois.*]<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {

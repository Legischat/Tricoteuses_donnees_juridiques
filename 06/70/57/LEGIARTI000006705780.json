      "TITRE_TXT": [
        {
          "#text": "Décret n°85-1295 du 4 décembre 1985 FIXANT LA COMPOSITION ET LES REGLES DE FONCTIONNEMENT DES CONSEILS DE DISCIPLINE DES PRATICIENS HOSPITALIERS ET DES PRATICIENS EXERCANT LEUR ACTIVITE A TEMPS PARTIEL DANS LES ETABLISSEMENTS D'HOSPITALISATION PUBLICS REGIS PAR LES DECRETS 84131 DU 24-02-1984 (ART. 66) ET 85384 DU 29-03-1985 (ART. 45)",
          "@c_titre_court": "Décret n°85-1295 du 4 décembre 1985",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000866628"
        },
        {
          "#text": "Décret n°85-1295 du 4 décembre 1985 fixant la composition et les règles de fonctionnement des conseils de discipline des praticiens hospitaliers et des praticiens exerçant leur activité à temps partiel dans les établissements d'hospitalisation publics régis par les décrets n° 84-131 du 24 février 1984 et n° 85-384 du 29 mars 1985.",
          "@c_titre_court": "Décret n°85-1295 du 4 décembre 1985",
          "@debut": "1985-12-08",
          "@fin": "2005-07-26",
          "@id_txt": "LEGITEXT000006064775"

  "BLOC_TEXTUEL": {
    "CONTENU": "<p>Les sages-femmes sont reclassées, à compter du 1er janvier 2002, selon le tableau de correspondance qui suit :</p>\n<br/>\n<table>\n<tbody>\n<tr>\n<td>\n<p align=\"center\">SITUATION ANTÉRIEURE </p>\n<br/>\n<p align=\"center\">Sage-femme</p>\n</td>\n<td>\n<pre> </pre>\n</td>\n<td>\n<p align=\"center\">SITUATION NOUVELLE </p>\n<br/>\n<p align=\"center\">Sage-femme de classe normale</p>\n</td>\n<td>\n<pre> </pre>\n</td>\n<td>\n<p align=\"center\">SITUATION NOUVELLE </p>\n<br/>\n<p align=\"center\">Sage-femme de classe supérieure</p>\n</td>\n</tr>\n<tr>\n<td>\n<pre> </pre>\n</td>\n<td>\n<p align=\"center\">Échelons</p>\n</td>\n<td>\n<p align=\"center\">Ancienneté conservée dans la limite de la durée moyenne de l'échelon</p>\n</td>\n<td>\n<p align=\"center\">Échelons</p>\n</td>\n<td>\n<p align=\"center\">Ancienneté conservée dans la limite de la durée moyenne de l'échelon</p>\n</td>\n</tr>\n<tr>\n<td>\n<p>9e échelon :</p>\n</td>\n<td>\n<pre> </pre>\n</td>\n<td>\n<pre> </pre>\n</td>\n<td>\n<pre> </pre>\n</td>\n<td>\n<pre> </pre>\n</td>\n</tr>\n<tr>\n<td>\n<p>- 9 ans d'ancienneté et plus</p>\n</td>\n<td>\n<pre> </pre>\n</td>\n<td>\n<pre> </pre>\n</td>\n<td>\n<p align=\"center\">6e</p>\n</td>\n<td>\n<p>Ancienneté acquise au-delà de 9 ans</p>\n</td>\n</tr>\n<tr>\n<td>\n<p>- moins de 9 ans</p>\n</td>\n<td>\n<pre> </pre>\n</td>\n<td>\n<pre> </pre>\n</td>\n<td>\n<p align=\"center\">5e </p>\n</td>\n<td>\n<p>1/3 de l'ancienneté acquise</p>\n</td>\n</tr>\n<tr>\n<td>\n<p>8e échelon</p>\n</td>\n<td>\n<pre> </pre>\n</td>\n<td>\n<pre> </pre>\n</td>\n<td>\n<p align=\"center\">4e </p>\n</td>\n<td>\n<p>3/4 de l'ancienneté acquise</p>\n</td>\n</tr>\n<tr>\n<td>\n<p>7e échelon</p>\n</td>\n<td>\n<pre> </pre>\n</td>\n<td>\n<pre> </pre>\n</td>\n<td>\n<p align=\"center\">3e </p>\n</td>\n<td>\n<p>Ancienneté acquise</p>\n</td>\n</tr>\n<tr>\n<td>\n<p>6e échelon</p>\n</td>\n<td>\n<pre> </pre>\n</td>\n<td>\n<pre> </pre>\n</td>\n<td>\n<p align=\"center\">2e </p>\n</td>\n<td>\n<p>Ancienneté acquise</p>\n</td>\n</tr>\n<tr>\n<td>\n<p>5e échelon</p>\n</td>\n<td>\n<pre> </pre>\n</td>\n<td>\n<pre> </pre>\n</td>\n<td>\n<p align=\"center\">1er </p>\n</td>\n<td>\n<p>Ancienneté acquise</p>\n</td>\n</tr>\n<tr>\n<td>\n<p>4e échelon</p>\n</td>\n<td>\n<p align=\"center\">4e</p>\n</td>\n<td>\n<p>3/2 de l'ancienneté acquise</p>\n</td>\n<td>\n<pre> </pre>\n</td>\n<td>\n<pre> </pre>\n</td>\n</tr>\n<tr>\n<td>\n<p>3e échelon</p>\n</td>\n<td>\n<p align=\"center\">3e</p>\n</td>\n<td>\n<p>1/2 de l'ancienneté acquise + 1 an</p>\n</td>\n<td>\n<pre> </pre>\n</td>\n<td>\n<pre> </pre>\n</td>\n</tr>\n</tbody>\n</table>\n<br/>\n<br/>"
  },

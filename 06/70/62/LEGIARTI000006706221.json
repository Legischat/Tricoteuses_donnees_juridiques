  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret n°77-219 du 7 mars 1977 RELATIF A LA QUALIFICATION PROFESSIONNELLE DES RESPONSABLES DE LA FABRICATION, DU CONDITIONNEMENT, DE L'IMPORTATION, DES CONTROLES DE QUALITE, DE LA DETENTION ET DE LA SURVEILLANCE DES STOCKS DE MATIERES PREMIERES ET DE PRODUITS FINIS EN CE QUI CONCERNE LES PRODUITS COSMETIQUES ET LES PRODUITS D'HYGIENE CORPORELLE",
          "@c_titre_court": "Décret n°77-219 du 7 mars 1977",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000328836"
        },
        {
          "#text": "Décret n°77-219 du 7 mars 1977 relatif à la qualification professionnelle des responsables de la fabrication, du conditionnement, de l'importation, des contrôles de qualité, de la détention et de la surveillance des stocks de matières premières et de produits finis en ce qui concerne les produits cosmétiques et les produits d'hygiène corporelle",
          "@c_titre_court": "Décret n°77-219 du 7 mars 1977",
          "@debut": "1977-03-10",
          "@fin": "2000-06-27",
          "@id_txt": "LEGITEXT000006062647"

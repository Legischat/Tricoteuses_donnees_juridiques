  "NOTA": {
    "CONTENU": "<br/>(1) taux résultant de la loi 89-469 du 10 juillet 1989. <br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<p>Celles des infractions aux dispositions du présent décret qui ne peuvent donner lieu à l'application des sanctions prévues à l'article 7 de la loi susvisée du 28 décembre 1967 seront passibles d'un emprisonnement de dix jours à un mois et d'une amende de 3.000 à 6.000 F ou de l'une de ces deux peines seulement.</p>\n<br/>\n<br/>"
  },

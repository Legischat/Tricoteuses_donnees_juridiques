    "CONTENU": "<p align=\"left\">Les durées moyenne et minimale dans chaque échelon sont fixées conformément au tableau ci-après :</p>\n<table align=\"center\" border=\"1\" cellpadding=\"0\">\n<tbody>\n<tr>\n<td>\n<p align=\"center\">GRADE</p>\n</td>\n<td colspan=\"2\">\n<p align=\"center\">DURÉE</p>\n</td>\n</tr>\n<tr>\n<td>\n<pre> </pre>\n</td>\n<td>\n<p align=\"center\">Moyenne </p>\n</td>\n<td>\n<p align=\"center\">Minimale </p>\n</td>\n</tr>\n<tr>\n<td>\n<p align=\"center\">Classe supérieure </p>\n</td>\n<td>\n<pre> </pre>\n</td>\n<td>\n<pre> </pre>\n</td>\n</tr>\n<tr>\n<td>\n<p>6e échelon....................................... </p>\n</td>\n<td>\n<p align=\"center\">3 ans 6 mois</p>\n</td>\n<td>\n<p align=\"center\">2 ans 7 mois et 15 jours</p>\n</td>\n</tr>\n<tr>\n<td>\n<p>5e échelon....................................... </p>\n</td>\n<td>\n<p align=\"center\">3 ans</p>\n</td>\n<td>\n<p align=\"center\">2 ans 3 mois</p>\n</td>\n</tr>\n<tr>\n<td>\n<p>4e échelon....................................... </p>\n</td>\n<td>\n<p align=\"center\">3 ans</p>\n</td>\n<td>\n<p align=\"center\">2 ans 3 mois</p>\n</td>\n</tr>\n<tr>\n<td>\n<p>3e échelon....................................... </p>\n</td>\n<td>\n<p align=\"center\">2 ans</p>\n</td>\n<td>\n<p align=\"center\">1 an 6 mois</p>\n</td>\n</tr>\n<tr>\n<td>\n<p>2e échelon....................................... </p>\n</td>\n<td>\n<p align=\"center\">2 ans</p>\n</td>\n<td>\n<p align=\"center\">1 an 6 mois</p>\n</td>\n</tr>\n<tr>\n<td>\n<p>1er échelon ...................................... </p>\n</td>\n<td>\n<p align=\"center\">2 ans</p>\n</td>\n<td>\n<p align=\"center\">1 an 6 mois</p>\n</td>\n</tr>\n<tr>\n<td>\n<p align=\"center\">Classe normale </p>\n</td>\n<td>\n<pre> </pre>\n</td>\n<td>\n<pre> </pre>\n</td>\n</tr>\n<tr>\n<td>\n<p>7e échelon....................................... </p>\n</td>\n<td>\n<p align=\"center\">4 ans</p>\n</td>\n<td>\n<p align=\"center\">3 ans</p>\n</td>\n</tr>\n<tr>\n<td>\n<p>6e échelon....................................... </p>\n</td>\n<td>\n<p align=\"center\">4 ans</p>\n</td>\n<td>\n<p align=\"center\">3 ans</p>\n</td>\n</tr>\n<tr>\n<td>\n<p>5e échelon....................................... </p>\n</td>\n<td>\n<p align=\"center\">4 ans</p>\n</td>\n<td>\n<p align=\"center\">3 ans</p>\n</td>\n</tr>\n<tr>\n<td>\n<p>4e échelon....................................... </p>\n</td>\n<td>\n<p align=\"center\">3 ans</p>\n</td>\n<td>\n<p align=\"center\">2 ans 3 mois</p>\n</td>\n</tr>\n<tr>\n<td>\n<p>3e échelon....................................... </p>\n</td>\n<td>\n<p align=\"center\">3 ans</p>\n</td>\n<td>\n<p align=\"center\">2 ans 3 mois</p>\n</td>\n</tr>\n<tr>\n<td>\n<p>2e échelon....................................... </p>\n</td>\n<td>\n<p align=\"center\">2 ans</p>\n</td>\n<td>\n<p align=\"center\">1 an 6 mois</p>\n</td>\n</tr>\n<tr>\n<td rowspan=\"2\">\n<p>1er échelon ..................................... </p>\n</td>\n<td rowspan=\"2\">\n<p align=\"center\">1 an</p>\n</td>\n<td rowspan=\"2\">\n<p align=\"center\">1 an</p>\n</td>\n</tr>\n</tbody>\n</table>"

    "CONTENU": "Situation dans l'emploi de recrutement ou de promotion.<br/>\n        GROUPE III.<br/>\n =================================<br/>\n SITUATION  :   SITUATION NOUVELLE<br/>\n ANCIENNE   :      ANCIENNETE<br/>\n DANS LE    :      CONSERVEE DANS<br/>\n GROUPE I   :      L'ECHELON<br/>\n ---------------------------------<br/>\n 1 éch      :  1 éch<br/>\n<br/>\n<table>\n<tr>\n<td>            : Ancienneté acquise</td>\n</tr>\n<tr>\n<td>            : Ancienneté acquise</td>\n</tr>\n<tr>\n<td> -----------:---------------------</td>\n</tr>\n<tr>\n<td> 3 éch      :  3 éch</td>\n</tr>\n<tr>\n<td>            : Ancienneté acquise</td>\n</tr>\n<tr>\n<td> -----------:---------------------</td>\n</tr>\n<tr>\n<td> 4 éch      :</td>\n</tr>\n<tr>\n<td> Avt 3 ans  :  4 éch</td>\n</tr>\n<tr>\n<td>            : Ancienneté acquise</td>\n</tr>\n<tr>\n<td> -----------:---------------------</td>\n</tr>\n<tr>\n<td> Apr 3 ans  :</td>\n</tr>\n<tr>\n<td> et avt     :</td>\n</tr>\n<tr>\n<td> 7 ans      :  5 éch</td>\n</tr>\n<tr>\n<td>            : Ancienneté acquise</td>\n</tr>\n<tr>\n<td>            : au-delà de 3 ans</td>\n</tr>\n<tr>\n<td> -----------:---------------------</td>\n</tr>\n<tr>\n<td> Apr 7 ans  :</td>\n</tr>\n<tr>\n<td> et avt     :</td>\n</tr>\n<tr>\n<td> 11 ans     :  6 éch</td>\n</tr>\n<tr>\n<td>            : Ancienneté acquise</td>\n</tr>\n<tr>\n<td>            : au-delà de 7 ans</td>\n</tr>\n<tr>\n<td> -----------:---------------------</td>\n</tr>\n<tr>\n<td> Apr 11 ans :</td>\n</tr>\n<tr>\n<td> et avt     :</td>\n</tr>\n<tr>\n<td> 15 ans     :  7 éch</td>\n</tr>\n<tr>\n<td>            : Ancienneté acquise</td>\n</tr>\n<tr>\n<td>            : au-delà de 11 ans</td>\n</tr>\n<tr>\n<td> -----------:---------------------</td>\n</tr>\n<tr>\n<td> Apr 15 ans :</td>\n</tr>\n<tr>\n<td>            :  8 éch</td>\n</tr>\n<tr>\n<td>            : Ancienneté acquise</td>\n</tr>\n<tr>\n<td>            : au-delà de 15 ans</td>\n</tr>\n</table>\n<br/>\n -----------:---------------
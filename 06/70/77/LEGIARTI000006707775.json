  "NOTA": {
    "CONTENU": "<br/>  La loi n° 70-1318 a été abrogée par l'article 7 III de la loi n° 91-1406 du 31 décembre 1991.<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les secrétaires généraux des syndicats interhospitaliers nommés conformément aux dispositions de l'article 9 de la loi modifiée n° 70-1318 du 31 décembre 1970 sont choisis parmi les personnels de direction des établissements membres des syndicats en considération de l'importance des établissements et de l'activité des syndicats.<br/>\n<br/>"
  },

        {
          "#text": "Décret n°85-493 du 9 mai 1985 MODIFIANT CERTAINES DISPOSITIONS DU DECRET 69662 DU 13-06-1969 RELATIF A LA NOMINATION ET A L'AVANCEMENT DU PERSONNEL DE DIRECTION DES ETABLISSEMENTS ENUMERES A L'ART. L792 (1,2,3) DU CODE DE LA SANTE PUBLIQUE",
          "@c_titre_court": "Décret n°85-493 du 9 mai 1985",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000333371"
        },
        {
          "#text": "Décret n°85-493 du 9 mai 1985 modifiant certaines dispositions du décret n° 69-662 du 13 juin 1969 relatif à la nomination et à l'avancement du personnel de direction des établissements énumérés à l'article L. 792 (1°, 2°, et 3°) du code de la santé publique",
          "@c_titre_court": "Décret n°85-493 du 9 mai 1985",
          "@debut": "1985-05-10",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006065016"
        }

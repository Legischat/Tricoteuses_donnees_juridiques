      "TITRE_TXT": [
        {
          "#text": "Décret n°68-97 du 10 janvier 1968 RELATIF AU RECRUTEMENT ET A L'AVANCEMENT DES PERSONNELS D'ENCADREMENT ET D'EXECUTION DES SERVICES DE PHARMACIE, DE LABORATOIRE ET D'ELECTROCARDIOLOGIE DANS LES ETABLISSEMENTS D'HOSPITALISATION, DE SOINS ET DE CURE PUBLICS",
          "@c_titre_court": "Décret n°68-97 du 10 janvier 1968",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000334282"
        },
        {
          "#text": "Décret n°68-97 du 10 janvier 1968 relatif au recrutement et à l'avancement des personnels d'encadrement et d'exécution des services de pharmacie, de laboratoire et d'électroradiologie dans les établissements d'hospitalisation, de soins ou de cure publics.",
          "@c_titre_court": "Décret n°68-97 du 10 janvier 1968",
          "@debut": "1968-01-30",
          "@fin": "2999-01-01",

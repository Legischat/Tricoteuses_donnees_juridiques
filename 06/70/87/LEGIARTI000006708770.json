        {
          "#text": "Décret n°74-431 du 14 mai 1974 ABROGEANT CERTAINES DISPOSITIONS DU CODE DE LA SANTE PUBLIQUE ET FIXANT LES CONDITIONS DE LA COOPERATION DU SERVICE DE SANTE DES ARMEES ET DU SERVICE PUBLIC HOSPITALIER",
          "@c_titre_court": "Décret n°74-431 du 14 mai 1974",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000703459"
        },
        {
          "#text": "Décret n°74-431 du 14 mai 1974 abrogeant certaines dispositions du code de la santé publique et fixant les conditions de la coopération du service de santé des armées et du service public hospitalier.",
          "@c_titre_court": "Décret n°74-431 du 14 mai 1974",
          "@debut": "1974-05-16",
          "@fin": "2005-07-26",
          "@id_txt": "LEGITEXT000006062192"
        }
      ],

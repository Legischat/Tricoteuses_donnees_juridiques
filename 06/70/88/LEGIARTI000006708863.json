          "@id_txt": "LEGITEXT000006062183"
        }
      ],
      "TM": {
        "TITRE_TM": [
          {
            "#text": "II - DISPOSITIONS PARTICULIERES AUX CONVENTIONS CONCERNANT L'ENSEIGNEMENT DE LA BIOLOGIE DANS LES LABORATOIRES HOSPITALIERS DE BIOLOGIE",

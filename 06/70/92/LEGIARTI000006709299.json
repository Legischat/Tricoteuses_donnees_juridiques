        {
          "#text": "Décret n°65-804 du 22 septembre 1965 CENTRES DE SOINS, D'ENSEIGNEMENT ET DE RECHERCHE DENTAIRE,",
          "@c_titre_court": "Décret n°65-804 du 22 septembre 1965",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000496114"
        },
        {
          "#text": "Décret n°65-804 du 22 septembre 1965 relatif aux conventions à conclure entre, d'une part, les facultés de médecine, les facultés mixtes de médecine et de pharmacie et, d'autre part, les centres hospitaliers régionaux en vue de déterminer les modalités de fonctionnement des centres de soins, d'enseignement et de recherche dentaires au règlement intérieur de ces centres.",
          "@c_titre_court": "Décret n°65-804 du 22 septembre 1965",
          "@debut": "1965-09-23",
          "@fin": "2005-07-26",
          "@id_txt": "LEGITEXT000006061313"
        }
      ],

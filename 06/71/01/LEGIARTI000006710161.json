  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les sanctions disciplinaires susceptibles d'être appliquées aux agents contractuels sont les suivantes :<br/>\n<br/>   1° L'avertissement ;<br/>\n<br/>   2° Le blâme ;<br/>\n<br/>   3° L'exclusion temporaire des fonctions avec retenue de traitement pour une durée maximale d'un mois ;<br/>\n<br/>   4° Le licenciement, sans préavis ni indemnité de licenciement.<br/>"
  },

  "BLOC_TEXTUEL": {
    "CONTENU": "<p>L'ancienneté moyenne pour accéder à l'échelon supérieur de chacun des grades du corps des agents chefs est ainsi fixée :</p>\n<br/>\n<table>\n<tbody>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">\n<strong>ÉCHELON</strong>\n</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">\n<strong>ANCIENNETÉ MOYENNE</strong>\n</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">\n<i>Agents chefs de classe exceptionnelle</i>\n</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<pre> </pre>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">7e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">-</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">6e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">4 ans</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">5e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">3 ans</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">4e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">3 ans</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">3e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">2 ans 6 mois</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">2e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">2 ans 6 mois</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">1er échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">2 ans</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">\n<i>Agents chefs de 1re catégorie</i>\n</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<pre> </pre>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">8e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">-</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">7e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">4 ans</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">6e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">3 ans</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">5e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">3 ans</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">4e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">2 ans 6 mois</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">3e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">2 ans</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">2e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">2 ans</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">1er échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">1 an 6 mois</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">\n<i>Agents chefs de 2e catégorie</i>\n</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<pre> </pre>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">13e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">-</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">12e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">4 ans</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">11e échelon</p>\n</td>\n<td align=\"
  "BLOC_TEXTUEL": {
    "CONTENU": "<p>Les agents appartenant au corps des agents d'entretien qualifiés sont intégrés dans le corps des personnels ouvriers régis par le présent décret et sont reclassés dans ce corps conformément au tableau suivant :<br/>\n</p>\n<table>\n<tbody>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">\n<strong>ANCIENNE SITUATION</strong>\n</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">\n<strong>NOUVELLE SITUATION</strong>\n</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">Agent d'entretien qualifié</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">Agent d'entretien qualifié</p>\n</td>\n</tr>\n</tbody>\n</table>"
  },

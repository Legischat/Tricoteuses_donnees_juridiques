      "TITRE_TXT": [
        {
          "#text": "Décret n°91-59 du 11 janvier 1991 FIXANT LES INDEMNITES DE STAGE ALLOUEES AUX ELEVES DIRECTEURS DE 3EME ET 4EME CLASSES DES ETABLISSEMENTS MENTIONNES A L'ARTICLE 2 (1EREMENT,2EMEMENT,3EMEMENT) DE LA LOI 8633 DU 09-01-1986",
          "@c_titre_court": "Décret n°91-59 du 11 janvier 1991",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000866476"
        },
        {
          "#text": "Décret n°91-59 du 11 janvier 1991 fixant les indemnités de stage allouées aux élèves directeurs de 3e et 4e classe des établissements mentionnés à l'article 2 (1°, 2° et 3°) de la loi n° 86-33 du 9 janvier 1986",
          "@c_titre_court": "Décret n°91-59 du 11 janvier 1991",
          "@debut": "1991-01-17",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006067672"
        }
      ],
      "@cid": "JORFTEXT000000866476",

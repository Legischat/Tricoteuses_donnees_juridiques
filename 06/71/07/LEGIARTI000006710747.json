  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Sont régis par les dispositions du présent décret les personnels de l'Assistance publique-hôpitaux de Paris constituant les corps suivants :<br/>\n<br/>   Catégorie B :<br/>\n<br/>   Le corps des agents techniques de coordination ;<br/>\n<br/>   Catégorie C :<br/>\n<br/>   a) Le corps des agents techniques ;<br/>\n<br/>   b) Le corps des ouvriers d'état ;<br/>\n<br/>   c) Le corps des ouvriers professionnels ;<br/>\n<br/>   d) Le corps des blanchisseurs ouvriers d'état ;<br/>\n<br/>   e) Le corps des blanchisseurs ouvriers professionnels ;<br/>\n<br/>   f) Le corps des conducteurs ambulanciers.<br/>"
  },

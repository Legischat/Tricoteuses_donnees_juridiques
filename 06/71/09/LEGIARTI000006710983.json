      "TITRE_TXT": [
        {
          "#text": "Décret n°91-333 du 2 avril 1991 RELATIF AU RATTACHEMENT PAR VOIE DE FONDS DE CONCOURS AU BUDGET DE LA SOLIDARITE,DE LA SANTE ET DE LA PROTECTION SOCIALE DU PRODUIT DES REMBOURSEMENTS DE CERTAINS FRAIS DE MISE EN OEUVRE DES PROGRAMMES DE VERIFICATION DE LA QUALITE DES EAUX DESTINEES A LA CONSOMMATION HUMAINE,A L'EXCLUSION DES EAUX MINERALES NATURELLES",
          "@c_titre_court": "Décret n°91-333 du 2 avril 1991",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000873556"
        },
        {
          "#text": "Décret n°91-333 du 2 avril 1991 relatif au rattachement par voie de fonds de concours au budget de la solidarité, de la santé et de la protection sociale du produit des remboursements de certains frais de mise en oeuvre des programmes de vérification de la qualité des eaux destinées à la consommation humaine, à l'exclusion des eaux minérales naturelles",
          "@c_titre_court": "Décret n°91-333 du 2 avril 1991",
          "@debut": "1991-04-05",
          "@fin": "2003-05-27",
          "@id_txt": "LEGITEXT000006067619"
        }
      ],
      "@cid": "JORFTEXT000000873556",
      "@date_publi": "1991-04-05",
      "@date_signature": "1991-04-02",
      "@nature": "DECRET",
      "@nor": "SANG9100246D",
      "@num": "91-333"
    }
  },

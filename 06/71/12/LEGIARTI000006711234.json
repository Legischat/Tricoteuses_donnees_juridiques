  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   L'ancienneté moyenne pour accéder à l'échelon supérieur de chacun des grades du corps des ingénieurs hospitaliers est ainsi fixée :<br/>\n<br/>\n Grades et échelons<br/>\n Ingénieur en chef de 1re catégorie :<br/>\n Hors classe<br/>\n<table>\n<tr>\n<td> :-----------------------------:</td>\n</tr>\n<tr>\n<td> : GRADES ET :   ANCIENNETE    :</td>\n</tr>\n<tr>\n<td> :  ECHELONS :     MOYENNE     :</td>\n</tr>\n<tr>\n<td> :-----------:-----------------:</td>\n</tr>\n<tr>\n<td> :    3e     :        -        :</td>\n</tr>\n<tr>\n<td> :    2e     :      3 ans      :</td>\n</tr>\n<tr>\n<td> :    1er    :      2 ans      :</td>\n</tr>\n<tr>\n<td> :-----------------------------:</td>\n</tr>\n</table>\n<br/>\n<br/>\n 1re classe<br/>\n<table>\n<tr>\n<td> :-----------------------------:</td>\n</tr>\n<tr>\n<td> : GRADES ET :   ANCIENNETE    :</td>\n</tr>\n<tr>\n<td> :  ECHELONS :     MOYENNE     :</td>\n</tr>\n<tr>\n<td> :-----------:-----------------:</td>\n</tr>\n<tr>\n<td> :    4e     :        -        :</td>\n</tr>\n<tr>\n<td> :    3e     :   2 ans 6 mois  :</td>\n</tr>\n<tr>\n<td> :    2e     :   2 ans 6 mois  :</td>\n</tr>\n<tr>\n<td> :    1er    :      2 ans      :</td>\n</tr>\n<tr>\n<td> :-----------------------------:</td>\n</tr>\n</table>\n<br/>\n<br/>\n 2e classe<br/>\n<table>\n<tr>\n<td> :-----------------------------:</td>\n</tr>\n<tr>\n<td> : GRADES ET :   ANCIENNETE    :</td>\n</tr>\n<tr>\n<td> :  ECHELONS :     MOYENNE     :</td>\n</tr>\n<tr>\n<td> :-----------:-----------------:</td>\n</tr>\n<tr>\n<td> :    8e     :        -        :</td>\n</tr>\n<tr>\n<td> :    7e     :      3 ans      :</td>\n</tr>\n<tr>\n<td> :    6e     :   2 ans 6 mois  :</td>\n</tr>\n<tr>\n<td> :    5e     :   2 ans 6 mois  :</td>\n</tr>\n<tr>\n<td> :    4e     :   2 ans 6 mois  :</td>\n</tr>\n<tr>\n<td> :    3e     :      2 ans      :</td>\n</tr>\n<tr>\n<td> :    2e     :      2 ans      :</td>\n</tr>\n<tr>\n<td> :    1er    :    1 an 6 mois  :</td>\n</tr>\n<tr>\n<td> :-----------------------------:</td>\n</tr>\n</table>\n<br/>\nIngénieur en chef<br/>\n<br/>\n<table>\n<tr>\n<td> :-----------------------------:</td>\n</tr>\n<tr>\n<td> : GRADES ET :   ANCIENNETE    :</td>\n</tr>\n<tr>\n<td> :  ECHELONS :     MOYENNE     :</td>\n</tr>\n<tr>\n<td> :-----------:-----------------:</td>\n</tr>\n<tr>\n<td> :    9e     :        -        :</td>\n</tr>\n<tr>\n<td> :    8e     :      4 ans      :</td>\n</tr>\n<tr>\n<td> :    7e     :   3 ans 6 mois  :</td>\n</tr>\n<tr>\n<td> :    6e     :      3 ans      :</td>\n</tr>\n<tr>\n<td> :    5e     :   2 ans 6 mois  :</td>\n</tr>\n<tr>\n<td> :    4e     :   2 ans 6 mois  :</td>\n</tr>\n<tr>\n<td> :    3e     :   2 ans 6 mois  :</td>\n</tr>\n<tr>\n<td> :    2e     :      2 ans      :</td>\n</tr>\n<tr>\n<td> :    1er    :    1 an 6 mois  :</td>\n</tr>\n<tr>\n<td> :-----------------------------:</td>\n</tr>\n</table>\n<br/>\n<br/>\n Ingénieur subdivisionnaire<br/>\n<table>\n<tr>\n<td> :-----------------------------:</td>\n</tr>\n<tr>\n<td> : GRADES ET :   ANCIENNETE    :</td>\n</tr>\n<tr>\n<td> :  ECHELONS :     MOYENNE     :</td>\n</tr>\n<tr>\n<td> :-----------:-----------------:</td>\n</tr>\n<tr>\n<td> :   10e     :        -        :</td>\n</tr>\n<tr>\n<td> :    9e     :   3 ans 6 mois  :</td>\n</tr>\n<tr>\n<td> :    8e     :   3 ans 6 mois  :</td>\n</tr>\n<tr>\n<td> :    7e     :      3 ans      :</td>\n</tr>\n<tr>\n<td> :    6e     :      3 ans      :</td>\n</tr>\n<tr>\n<td> :    5e     :      3 ans      :</td>\n</tr>\n<tr>\n<td> :    4e     :      3 ans      :</td>\n</tr>\n<tr>\n<td> :    3e     :      3 ans      :</td>\n</tr>\n<tr>\n<td> :    2e     :   2 ans 6 mois  :</td>\n</tr>\n<tr>\n<td> :    1er    :      1 an       :</td>\n</tr>\n<tr>\n<td> :-----------------------------:</td>\n</tr>\n</table>\n<br/>"

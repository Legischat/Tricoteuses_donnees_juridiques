  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret  no 92-819 du 20 août 1992 relatif aux fonctions de chef de service,    de chef de département et de responsable d'unité fonctionnelle dans les    établissements publics de santé et modifiant le code de la santé publique    (deuxième partie: Décrets en Conseil d'Etat)",
          "@c_titre_court": "Décret n°92-819 du 20 août 1992",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000177128"
        },
        {
          "#text": "Décret n°92-819 du 20 août 1992 relatif aux fonctions de chef de service, de chef de département et de responsable d'unité fonctionnelle dans les établissements publics de santé et modifiant le code de la santé publique (deuxième partie : Décrets en Conseil d'Etat)",
          "@c_titre_court": "Décret n°92-819 du 20 août 1992",

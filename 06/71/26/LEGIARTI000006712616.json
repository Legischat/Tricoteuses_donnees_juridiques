  "BLOC_TEXTUEL": {
    "CONTENU": "<p>Les pharmaciens inspecteurs principaux sont reclassés conformément au tableau ci-après :</p>\n<table border=\"2\" cellpadding=\"2\">\n<tbody>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">SITUATION <br/>\n<br/>ancienne</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">SITUATION <br/>\n<br/>nouvelle</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">ANCIENNETE <br/>\n<br/>conservée <br/>\n<br/>(dans la limite de la durée de l'échelon)</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">\n<i>Pharmacien inspecteur principal</i>\n</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">\n<i>Pharmacien inspecteur <br/>\n<br/>en chef</i>\n</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<pre> </pre>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">5e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">3e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">Ancienneté acquise.</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">4e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">3e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">Sans ancienneté.</p>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<pre> </pre>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">\n<i>Pharmacien inspecteur</i>\n</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<pre> </pre>\n</td>\n</tr>\n<tr>\n<td align=\"left\" valign=\"middle\">\n<p align=\"justify\">3e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">6e échelon</p>\n</td>\n<td align=\"left\" valign=\"middle\">\n<p align=\"center\">Ancienneté acquise.</p>\n</td>\n</tr>\n</tbody>\n</table>"
  },

      "TITRE_TXT": [
        {
          "#text": "Décret n°54-65 du 16 janvier 1954 PORTANT RAP POUR L'APPLICATION DES DISPOSITIONS DE L'ART. 2 DE LA LOI DU 21- 07-1952 RELATIVES AUX ETABLISSEMENTS AGREES EN VUE DE LA PREPARATION DES PRODUITS SANGUINS",
          "@c_titre_court": "Décret n°54-65 du 16 janvier 1954",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000673176"
        },
        {
          "#text": "Décret n°54-65 du 16 janvier 1954 portant règlement d'administration publique pour l'application du livre VI du code de la santé publique concernant l'utilisation thérapeutique du sang humain, de son plasma et de leurs dérivés",

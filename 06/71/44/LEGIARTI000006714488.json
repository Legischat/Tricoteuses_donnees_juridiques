    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Arrêté du 6 février 1981 fixant la liste des diplômes, certificats et autres titres de praticien de l'art dentaire délivrés par les Etats membres de la Communauté économique européenne, visée à l'article L. 356-2 (2°) du code de la santé publique.",
          "@c_titre_court": "Arrêté du 6 février 1981",
          "@debut": "1981-03-06",
          "@fin": "2009-08-01",
          "@id_txt": "LEGITEXT000006072720"
        }
      ],
      "@cid": "LEGITEXT000006072720",
      "@date_publi": "2999-01-01",
      "@date_signature": "1981-02-06",
      "@nature": "ARRETE"
    }
  },

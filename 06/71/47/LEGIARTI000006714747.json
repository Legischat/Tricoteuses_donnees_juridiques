  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Arrêté du 18 novembre 1991 RELATIF A LA COMPOSITION DU DOSSIER ET AUX MODALITES D'ORGANISATION DE L'EPREUVE D'APTITUDE ET DU STAGE D'ADAPTATION PREVUES,POUR LES ERGOTHERAPEUTES,PAR LE DECRET 911010 DU 02-10-1991 MODIFIANT LE DECRET 861195 DU 21-11-1986 FIXANT LES CATEGORIES DE PERSONNES HABILITEES A EFFECTUER DES ACTES PROFESSIONNELS EN ERGOTHERAPIE",
          "@c_titre_court": "Arrêté du 18 novembre 1991",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000864990"
        },
        {
          "#text": "Arrêté du 18 novembre 1991 relatif à la composition du dossier et aux modalités d'organisation de l'épreuve d'aptitude et du stage d'adaptation prévues, pour les ergothérapeutes, par le décret n° 91-1010 du 2 octobre 1991 modifiant le décret n° 86-1195 du 21 novembre 1986 fixant les catégories de personnes habilitées à effectuer des actes professionnels en ergothérapie",
          "@c_titre_court": "Arrêté du 18 novembre 1991",
          "@debut": "1991-11-23",
          "@fin": "2010-03-29",
          "@id_txt": "LEGITEXT000006059824"
        }
      ],

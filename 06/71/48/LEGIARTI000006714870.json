  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Arrêté du 2 octobre 1991 RELATIF A LA COMPOSITION DU DOSSIER ET AUX MODALITES D'ORGANISATION DE L'EPREUVE D'APTITUDE ET DU STAGE D'ADAPTATION PREVUES POUR LES PSYCHOMOTRICIENS,PAR LE DECRET 911011 DU 02-10-1991 MODIFIANT LE DECRET 88659 DU 06-05-1988 RELATIF A L'ACCOMPLISSEMENT DE CERTAINS ACTES DE REEDUCATION PSYCHOMOTRICE",
          "@c_titre_court": "Arrêté du 2 octobre 1991",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000476360"
        },
        {
          "#text": "Arrêté du 2 octobre 1991 relatif à la composition du dossier et aux modalités d'organisation de l'épreuve d'aptitude et du stage d'adaptation prévues, pour les psychomotriciens, par le décret n° 91-1011 du 2 octobre 1991 modifiant le décret n° 88-659 du 6 mai 1988 relatif à l'accomplissement de certains actes de rééducation psychomotrice",
          "@c_titre_court": "Arrêté du 2 octobre 1991",
          "@debut": "1991-10-04",
          "@fin": "2010-04-03",
          "@id_txt": "LEGITEXT000006059776"

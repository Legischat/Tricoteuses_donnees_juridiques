    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Arrêté du 2 octobre 1991 RELATIF A LA COMPOSITION DU DOSSIER ET AUX MODALITES D'ORGANISATION DE L'EPREUVE D'APTITUDE ET DU STAGE D'ADAPTATION PREVUES POUR LES PEDICURES-PODOLOGUES,PAR LE DECRET 911012 DU 02-10-1991 PRIS POUR L'APPLICATION DE L'ART. L510-8-BIS DU CODE DE LA SANTE PUBLIQUE",
          "@c_titre_court": "Arrêté du 2 octobre 1991",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000846873"
        },
        {
          "#text": "Arrêté du 2 octobre 1991 relatif à la composition du dossier et aux modalités d'organisation de l'épreuve d'aptitude et du stage d'adaptation prévues, pour les pédicures-podologues, par le décret n° 91-1012 du 2 octobre 1991 pris pour l'application de l'article L. 510-8 bis du code de la santé publique",
          "@c_titre_court": "Arrêté du 2 octobre 1991",

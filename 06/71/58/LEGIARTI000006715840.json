  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les directeurs doivent remplir les conditions suivantes :<br/>\n<br/>   - être âgé de trente ans au moins ;<br/>\n<br/>   - être titulaire d'un titre visé à l'article L. 474-1 ou L. 477 du code de la santé publique ;<br/>\n<br/>   - être titulaire de l'un des diplômes suivants :<br/>\n<br/>      - certificat cadre infirmier ;<br/>\n<br/>      - certificat d'aptitude aux fonctions d'infirmier surveillant ;<br/>\n<br/>      - certificat d'aptitude aux fonctions d'infirmier moniteur ;<br/>\n<br/>      - certificat d'aptitude aux fonctions d'infirmier cadre de santé publique ;<br/>\n<br/>      - certificat de cadre infirmier de secteur psychiatrique ;<br/>\n<br/>      - certificat de moniteur de formation professionnelle du personnel soignant de secteur psychiatrique ;<br/>"
  },

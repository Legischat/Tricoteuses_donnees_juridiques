      "TITRE_TXT": [
        {
          "#text": "Arrêté du 9 janvier 1978 relatif aux conditions dans lesquelles les emplois du personnel secondaire des services médicaux peuvent être créés dans les centres hospitaliers spécialisés en psychiatrie et dans les services psychiatriques des centres hospitaliers généraux",
          "@c_titre_court": "Arrêté du 9 janvier 1978",
          "@debut": "1978-01-24",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006072829"
        }

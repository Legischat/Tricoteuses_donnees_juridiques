        {
          "#text": "Arrêté du 11 mars 1988 RELATIF AUX MODALITES DE DEPOT DE CANDIDATURE POUR LA NOMINATION AUX FONCTIONS DE CHEF DE SERVICE DANS LES ETABLISSEMENTS D'HOSPITALISATION PUBLICS VISES AU TITRE V DU DECRET 88225 DU 10-03-1988",
          "@c_titre_court": "Arrêté du 11 mars 1988",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000472442"
        },
        {
          "#text": "Arrêté du 11 mars 1988 relatif aux modalités de dépôt de candidature pour la nomination aux fonctions de chef de service dans les établissements d'hospitalisation publics visés au titre V du décret n° 88-225 du 10 mars 1988",
          "@c_titre_court": "Arrêté du 11 mars 1988",
          "@debut": "1988-03-20",

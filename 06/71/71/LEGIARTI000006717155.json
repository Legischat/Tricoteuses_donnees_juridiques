      "TITRE_TXT": [
        {
          "#text": "Arrêté du 10 mars 1988 RELATIF A LA MISE EN PLACE DE LA JURIDICTION DISCIPLINAIRE NATIONALE COMPETENTE A L'EGARD DES PERSONNELS ENSEIGNANTS ET HOSPITALIERS DES CENTRES DE SOINS,D'ENSEIGNEMENT ET DE RECHERCHE DENTAIRES DES CENTRES HOSPITALIERS ET UNIVERSITAIRES",
          "@c_titre_court": "Arrêté du 10 mars 1988",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000297469"
        },
        {
          "#text": "Arrêté du 10 mars 1988 relatif à la mise en place de la Juridiction disciplinaire nationale compétente à l'égard des personnels enseignants et hospitaliers des centres de soins, d'enseignement et de recherche dentaires des centres hospitaliers et universitaires",
          "@c_titre_court": "Arrêté du 10 mars 1988",
          "@debut": "1988-03-20",
          "@fin": "1991-10-05",
          "@id_txt": "LEGITEXT000006058154"

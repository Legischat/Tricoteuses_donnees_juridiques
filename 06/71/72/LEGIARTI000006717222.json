      "TITRE_TXT": [
        {
          "#text": "Arrêté du 11 avril 1988 FIXANT LES CORRESPONDANCES ENTRE LES EMPLOIS DE LA FONCTION PUBLIQUE TERRITORIALE ET LES EMPLOIS DE LA FONCTION PUBLIQUE HOSPITALIERE POUR L'APPLICATION DU DECRET 88347 DU 11-04-1988",

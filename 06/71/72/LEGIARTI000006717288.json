      "TITRE_TXT": [
        {
          "#text": "Arrêté du 29 mars 1988 RELATIF AUX MODALITES DE DEPOT DE CANDIDATURE POUR LA NOMINATION AUX FONCTIONS DE CHEF DE SERVICE DANS LES ETABLISSEMENTS D'HOSPITALISATION PUBLICS VISES AUX TITRES II ET III DU DECRET 88225 DU 10-03-1988",
          "@c_titre_court": "Arrêté du 29 mars 1988",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000476990"
        },
        {
          "#text": "Arrêté du 29 mars 1988 relatif aux modalités de dépôt de candidature pour la nomination aux fonctions de chef de service dans les établissements d'hospitalisation publics visés aux titres II et III du décret n° 88-225 du 10 mars 1988",
          "@c_titre_court": "Arrêté du 29 mars 1988",
          "@debut": "1988-04-20",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006058235"
        }

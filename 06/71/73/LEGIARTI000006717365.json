    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Arrêté du 6 septembre 1977 CORRESPONDANCES ENTRE LES EMPLOIS DES ETABLISSEMENTS RELEVANT DES SERVICES PARISIENS DE L'AIDE SOCIALE A L'ENFANCE ET LES EMPLOIS DU LIVRE IX DU CODE DE LA SANTE PUBLIQUE EN VUE DE L'APPLICATION DU DECRET 77-795 DU 8 JUILLET 1977. (SPU)",
          "@c_titre_court": "Arrêté du 6 septembre 1977",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000666286"
        },
        {
          "#text": "Arrêté du 6 septembre 1977 fixant les correspondances entre les emplois des établissements relevant des services parisiens de l'aide sociale à l'enfance et les emplois du livre IX du code de la santé publique en vue de l'application du décret n° 77-795 du 8 juillet 1977",
          "@c_titre_court": "Arrêté du 6 septembre 1977",
          "@debut": "1977-10-11",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006072850"
        }
      ],
      "@cid": "JORFTEXT000000666286",
      "@date_publi": "1977-10-11",
      "@date_signature": "1977-09-06",
      "@nature": "ARRETE"
    }
  },

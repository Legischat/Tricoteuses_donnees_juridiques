    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Arrêté du 23 novembre 1982 MODALITES DE CALCUL DES INDEMNITES SUSCEPTIBLES D'ETRE ACCORDEES AUX AGENTS TITULAIRES DES ETABLISSEMENTS D'HOSPITALISATION PUBLICS ET DE CERTAINS ETABLISSEMENTS A CARACTERE SOCIAL QUI EXERCENT LEURS FONCTIONS A TEMPS PARTIEL",
          "@c_titre_court": "Arrêté du 23 novembre 1982",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000323923"
        },
        {
          "#text": "Arrêté du 23 novembre 1982 fixant les modalités de calcul des indemnités susceptibles d'être accordées aux agents titulaires des établissements d'hospitalisation publics et de certains établissements à caractère social qui exercent leurs fonctions à temps partiel",
          "@c_titre_court": "Arrêté du 23 novembre 1982",
          "@debut": "1982-11-27",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006072878"
        }
      ],
      "@cid": "JORFTEXT000000323923",

      "TITRE_TXT": [
        {
          "#text": "Arrêté du 10 juillet 1989 RELATIF A LA DEFINITION DES PROCEDURES ADMINISTRATIVES FIXEES PAR LES ART. 4,5,15,16 ET 17 DU DECRET 893 DU 03-01-1989 CONCERNANT LES EAUX DESTINEES A LA CONSOMMATION HUMAINE,A L'EXCLUSION DES EAUX MINERALES",
          "@c_titre_court": "Arrêté du 10 juillet 1989",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000667491"
        },
        {
          "#text": "Arrêté du 10 juillet 1989 relatif à la définition des procédures administratives fixées par les articles 4, 5, 15, 16 et 17 du décret n° 89-3 du 3 janvier 1989 concernant les eaux destinées à la consommation humaine, à l'exclusion des eaux minérales",
          "@c_titre_court": "Arrêté du 10 juillet 1989",
          "@debut": "1989-07-29",
          "@fin": "1998-04-28",
          "@id_txt": "LEGITEXT000006059080"
        }

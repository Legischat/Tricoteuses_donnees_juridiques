      "TITRE_TXT": [
        {
          "#text": "Arrêté du 15 octobre 1985 FIXANT LES CONDITIONS DE PRISE EN CHARGE ET D'IMPUTATION DES FRAIS DE CHANGEMENT DE RESIDENCE DES PRATICIENS A TEMPS PLEIN DES ETABLISSEMENTS D'HOSPITALISATION PUBLICS",
          "@c_titre_court": "Arrêté du 15 octobre 1985",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000655986"
        },
        {
          "#text": "Arrêté du 15 octobre 1985 fixant les conditions de prise en charge et d'imputation des frais de changement de résidence des praticiens à temps plein des établissements d'hospitalisation publics.",

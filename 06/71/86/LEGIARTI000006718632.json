  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Arrêté du 11 août 1989 FIXANT LE TAUX DE LA CONTRIBUTION FINANCIERE DUE A L'ECOLE NATIONALE DE LA SANTE PUBLIQUE PAR LES ETABLISSEMENTS ENUMERES A L'ART. 2 (1EREMENT,2EMEMENT ET 3EMEMENT) DU TITRE IV DU STATUT GENERAL DES FONCTIONNAIRES DE L'ETAT ET DES COLLECTIVITES TERRITORIALES",
          "@c_titre_court": "Arrêté du 11 août 1989",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000847099"
        },
        {
          "#text": "Arrêté du 11 août 1989 fixant le taux de la contribution financière due à l'Ecole nationale de la santé publique par les établissements énumérés à l'article 2 (1°, 2° et 3°) du titre IV du statut général des fonctionnaires de l'Etat et des collectivités territoriales",
          "@c_titre_court": "Arrêté du 11 août 1989",
          "@debut": "1989-08-24",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006059133"
        }
      ],
      "@cid": "JORFTEXT000000847099",
      "@date_publi": "1989-08-24",
      "@date_signature": "1989-08-11",
      "@nature": "ARRETE",
      "@nor": "SPSH8901741A"
    }
  },

      "TITRE_TXT": [
        {
          "#text": "Arrêté du 5 décembre 1989 RELATIF A L'ELECTION COMPLEMENTAIRE DES MEMBRES DE LA JURIDICTION DISCIPLINAIRE PREVUE A L'ART. 5 DE L'ORDONNANCE 581373 DU 30-12-1958 (ODONTOLOGIE)",
          "@c_titre_court": "Arrêté du 5 décembre 1989",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000684920"
        },
        {
          "#text": "Arrêté du 5 décembre 1989 relatif à l'élection complémentaire des membres de la juridiction disciplinaire prévue à l'article 5 de l'ordonnance n° 58-1373 du 30 décembre 1958 (odontologie)",
          "@c_titre_court": "Arrêté du 5 décembre 1989",

    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Arrêté du 3 septembre 1964 relatif au classement et à l'échelonnement indiciaires des personnels des services agricoles, des services ouvriers, des parcs automobiles et du service intérieur des établissements d'hospitalisation, de soins ou de cure publics.",
          "@c_titre_court": "Arrêté du 3 septembre 1964",
          "@debut": "1964-09-12",
          "@fin": "1974-05-23",
          "@id_txt": "LEGITEXT000006072909"
        }
      ],
      "@cid": "LEGITEXT000006072909",

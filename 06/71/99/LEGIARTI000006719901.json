  "BLOC_TEXTUEL": {
    "CONTENU": "Emplois : adjoints des cadres hospitaliers :<br/>\n<br/>\n ETABLISSEMENTS DE PLUS DE 3000 LITS<br/>\n ===========================<br/>\n ECHELON : INDICES : DUREE<br/>\n<br/>\n<table>\n<tr>\n<td>         :   BRUTS : MOYENNE</td>\n</tr>\n<tr>\n<td>         :         :</td>\n</tr>\n<tr>\n<td> 9 éch   :   430   : 2 ans</td>\n</tr>\n<tr>\n<td> 8 éch   :   390   : 2 ans</td>\n</tr>\n<tr>\n<td> 7 éch   :   365   : 2 ans</td>\n</tr>\n<tr>\n<td> 6 éch   :   340   : 2 ans</td>\n</tr>\n<tr>\n<td> 5 éch   :   315   : 2 ans</td>\n</tr>\n<tr>\n<td> 4 éch   :   290   : 2 ans</td>\n</tr>\n<tr>\n<td> 3 éch   :   265   : 2 ans</td>\n</tr>\n<tr>\n<td> 2 éch   :   240   : 2 ans</td>\n</tr>\n<tr>\n<td> 1 éch   :   210   : 2 ans</td>\n</tr>\n<tr>\n<td> =========================</td>\n</tr>\n<tr>\n<td> </td>\n</tr>\n<tr>\n<td> ETABLISSEMENTS DE 2001 à 3000 LITS</td>\n</tr>\n<tr>\n<td> ===========================</td>\n</tr>\n<tr>\n<td> ECHELON : INDICES : DUREE</td>\n</tr>\n<tr>\n<td>         :   BRUTS : MOYENNE</td>\n</tr>\n<tr>\n<td> --------:---------:--------</td>\n</tr>\n<tr>\n<td> Echelon :         :</td>\n</tr>\n<tr>\n<td> except  :         :</td>\n</tr>\n<tr>\n<td> Après   :         :</td>\n</tr>\n<tr>\n<td>  2 ans  :         :</td>\n</tr>\n<tr>\n<td>  (6)    :   455   :</td>\n</tr>\n<tr>\n<td>         :         :</td>\n</tr>\n<tr>\n<td> Avant   :         :</td>\n</tr>\n<tr>\n<td>  2 ans  :         :</td>\n</tr>\n<tr>\n<td>  (6)    :   430   :</td>\n</tr>\n<tr>\n<td>         :         :</td>\n</tr>\n</table>\n<br/>\n 8 éch   :   390   : 2 ans 7 éch   :   365   : 2 ans 6 éch   :   340   : 2 ans 5 éch   :   315   : 2 ans 4 éch   :   290   : 2 ans 3 éch   :   265   : 2 ans 2 éch   :   240   : 2 ans 1 éch   :   210   : 2 ans ==========================AUTRES ETABLISSEMENTS<br/>\n ===========================<br/>\n ECHELON : INDICES : DUREE<br/>\n<br/>\n<table>\n<tr>\n<td>         :   BRUTS : MOYENNE</td>\n</tr>\n<tr>\n<td>         :         :</td>\n</tr>\n</table>\n<br/>\n 8 éch   :   390   : 2 ans 7 éch   :   365   : 2 ans 6 éch   :   340   : 2 ans 5 éch   :   315   : 2 ans 4 éch   :   290   : 2 ans 3 éch   :   265   : 2 ans 2 éch   :   240   : 2 ans 1 éch   :   210   : 2 ans ==========================   (5) Indice 455 accessible à deux agents.<br/>\n    (6) Echelon exceptionnel 455-430 accessible à deux agents.<br/>\n    (7) Indice 430 accessible à deux agents dans les établissements de plus de 1000 lits et à un agent dans les établissements de moins de 1000 lits.<br/>"

        {
          "#text": "Arrêté du 31 octobre 1972 MODALITES DES CONCOURS OUVRANT L'ACCES A L'EMPLOI D'ADJOINT DES CADRES HOSPITALIERS",
          "@c_titre_court": "Arrêté du 31 octobre 1972",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000487884"
        },
        {
          "#text": "Arrêté du 31 octobre 1972 fixant les modalités des concours ouvrant l'accès à divers emplois des établissements d'hospitalisation, de soins ou de cure publics. Adjoint des cadres hospitaliers",
          "@c_titre_court": "Arrêté du 31 octobre 1972",
          "@debut": "1972-11-19",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006072939"
        }
      ],

      "TITRE_TXT": [
        {
          "#text": "Arrêté du 24 décembre 1980 INDEMNITES DE STAGE SUSCEPTIBLES D'ETRE ALLOUEES AUX AGENTS DES ETABLISSEMENTS VISES A L'ART. L792 DU CODE DE LA SANTE PUBLIQUE",
          "@c_titre_court": "Arrêté du 24 décembre 1980",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000837020"
        },
        {
          "#text": "Arrêté du 24 décembre 1980 relatif aux indemnités de stage susceptibles d'être allouées aux agents des établissements visés à l'article L. 792 du code de la santé publique.",
          "@c_titre_court": "Arrêté du 24 décembre 1980",
          "@debut": "1981-01-24",
          "@fin": "2999-01-01",

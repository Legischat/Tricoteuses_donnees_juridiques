  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Arrêté du 24 décembre 1980 INDEMNITES ALLOUEES AUX AGENTS DES ETABLISSEMENTS VISES A L'ART. L792 DU CODE DE LA SANTE PUBLIQUE (ETABLISSEMENTS D'HOSPITALISATION ET HOSPICES PUBLICS,MAISONS DE RETRAITE PUBLIQUES,ETABLISSEMENTS POUR MINEURS INADAPTES ET RELEVANT DES SERVICES DEPARTEMENTAUX DE L'AIDE SOCIALE A L'ENFANCE) EFFECTUANT UN STAGE DE FORMATION A L'ECOLE NATIONALE DE LA SANTE PUBLIQUE",
          "@c_titre_court": "Arrêté du 24 décembre 1980",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000287965"
        },
        {
          "#text": "Arrêté du 24 décembre 1980 relatif aux indemnités allouées aux agents des établissements visés à l'article L. 792 du code de la santé publique effectuant un stage de formation à l'école nationale de la santé publique.",
          "@c_titre_court": "Arrêté du 24 décembre 1980",

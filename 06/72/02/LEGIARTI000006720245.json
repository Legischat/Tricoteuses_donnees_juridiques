      "TITRE_TXT": [
        {
          "#text": "Arrêté du 21 novembre 1974 MODIFICATION DES ART. 1ER ET 2 DE L'ARRETE DU 27 NOVEMBRE 1970. (ART. 1 ET 2, LES MANIPULATEURS D'ELECTRORADIOLOGIE)",
          "@c_titre_court": "Arrêté du 21 novembre 1974",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000311183"
        },
        {
          "#text": "Arrêté du 21 novembre 1974 fixant la liste des titres, diplômes ou qualifications ouvrant accès aux concours sur épreuves pour le recrutement des manipulateurs d'électroradiologie et à l'échelon exceptionnel de l'emploi de manipulateur d'électroradiologie dans les établissements relevant du Livre IX du code de la santé publique.",
          "@c_titre_court": "Arrêté du 21 novembre 1974",
          "@debut": "1974-12-04",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006072966"
        }
      ],
      "@cid": "JORFTEXT000000311183",
      "@date_publi": "1974-12-04",
      "@date_signature": "1974-11-21",
      "@nature": "ARRETE"
    }

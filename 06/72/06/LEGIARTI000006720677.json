  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Arrêté du 18 mars 1981 PRIMES ET INDEMNITES DU PERSONNEL RELEVANT DU LIVRE IX DU CODE DE LA SANTE PUBLIQUE DONT LES TAUX ET LES MONTANTS SONT DETERMINES PAR DES TEXTES APPLICABLES AUX AGENTS DE L'ETAT (PRIMES D'INSTALLATION,DE TECHNICITE, INDEMNITES DE RESPONSABILITE,HORAIRE DE NUIT,POUR TRAVAUX DANGEREUX,DE TECHNICITE POUR CONDUITE DE VEHICULES,DE CHAUSSURE ET DE VETEMENT DE TRAVAIL)",
          "@c_titre_court": "Arrêté du 18 mars 1981",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000859693"
        },
        {
          "#text": "Arrêté du 18 mars 1981 relatif aux primes et indemnités du personnel relevant du livre IX du code de la santé publique dont les taux et les montants sont déterminés par des textes applicables aux agents de l'Etat.",
          "@c_titre_court": "Arrêté du 18 mars 1981",
          "@debut": "1981-04-10",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006073000"
        }
      ],
      "@cid": "JORFTEXT000000859693",
      "@date_publi": "1981-04-10",
      "@date_signature": "1981-03-18",
      "@nature": "ARRETE"
    }
  },
  "VERSIONS": {
    "VERSION": [

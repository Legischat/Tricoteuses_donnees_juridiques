      "TITRE_TXT": [
        {
          "#text": "Arrêté du 19 mars 1981 INDEMNITES DU PERSONNEL RELEVANT DU TITRE IX DU CODE DE LA SANTE PUBLIQUE DONT LES MONTANTS SONT DETERMINES PAR DES TEXTES APPLICABLES AUX AGENTS COMMUNAUX:INDEMNITES POUR UTILISATION D'OUTILLAGE PERSONNEL ET POUR LES PERSONNELS EFFECTUANT LES TOILETTES MORTUAIRES OU LES MISES EN BIERE",
          "@c_titre_court": "Arrêté du 19 mars 1981",
          "@debut": "2999-01-01",

    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Arrêté du 10 septembre 1959 fixant les modalités du concours ouvrant l'accès aux emplois de sténodactylographe et d'agent de bureau des établissements d'hospitalisation, de soins ou de cure publics.",
          "@c_titre_court": "Arrêté du 10 septembre 1959",
          "@debut": "1959-09-16",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006073024"
        }
      ],

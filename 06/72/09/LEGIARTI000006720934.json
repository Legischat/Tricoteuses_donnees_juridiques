  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Arrêté du 19 juillet 1976 MODALITES DES CONCOURS SUR EPREUVES ET DES EXAMENS PROFESSIONNELS OUVRANT L'ACCES A L'EMPLOI D'INGENIEUR SUBDIVISIONNAIRE DES ETABLISSEMENTS RELEVANT DU LIVRE IX DU CODE DE LA SANTE PUBLIQUE. (SPU)",
          "@c_titre_court": "Arrêté du 19 juillet 1976",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000861815"
        },
        {
          "#text": "Arrêté du 19 juillet 1976 fixant les modalités des concours sur épreuves techniques et des examens professionnels ouvrant l'accès à l'emploi d'ingénieur subdivisionnaire des établissements relevant du livre IX du code de la santé publique.",
          "@c_titre_court": "Arrêté du 19 juillet 1976",
          "@debut": "1976-08-13",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006073029"
        }
      ],
      "@cid": "JORFTEXT000000861815",
      "@date_publi": "1976-08-13",
      "@date_signature": "1976-07-19",
      "@nature": "ARRETE"
    }
  },

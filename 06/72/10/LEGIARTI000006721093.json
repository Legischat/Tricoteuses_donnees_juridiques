      "TITRE_TXT": [
        {
          "#text": "Arrêté du 7 janvier 1965 DES DIPLOMES OU BREVETS DE SPECIALISATIONS PREVUS POUR L'ACCES AU GRADE ET A L'EMPLOI D'INFIRMIER (E) SPECIALISE (E)",
          "@c_titre_court": "Arrêté du 7 janvier 1965",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000439388"
        },
        {
          "#text": "Arrêté du 7 janvier 1965 fixant la liste des diplômes ou brevets de spécialisation prévus pour l'accès au grade et à l'emploi d'infirmier et infirmière spécialisés.",
          "@c_titre_court": "Arrêté du 7 janvier 1965",
          "@debut": "1965-01-19",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006073051"
        }

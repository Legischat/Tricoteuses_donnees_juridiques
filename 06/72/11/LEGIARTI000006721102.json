    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Arrêté du 10 avril 1970 relatif aux modalités de l'examen probatoire pour l'accès aux fonctions d'élève infirmier et élève infirmière dans les hôpitaux psychiatriques départementaux et interdépartementaux ainsi que dans les quartiers psychiatriques des hôpitaux et hospices publics.",
          "@c_titre_court": "Arrêté du 10 avril 1970",
          "@debut": "1970-04-21",
          "@fin": "1992-03-25",
          "@id_txt": "LEGITEXT000006073052"
        }
      ],
      "@cid": "LEGITEXT000006073052",
      "@date_publi": "2999-01-01",
      "@date_signature": "1970-04-10",
      "@nature": "ARRETE"
    }
  },

  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Arrêté du 22 novembre 1985 fixant la liste des diplômes permettant l'accès au concours externe d'admission à la session de formation théorique et pratique des directeurs de 4e classe organisée par l'Ecole nationale de la santé publique.",
          "@c_titre_court": "Arrêté du 22 novembre 1985",
          "@debut": "1985-12-07",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006073077"
        }
      ],
      "@cid": "LEGITEXT000006073077",

    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Arrêté du 4 mars 1988 FIXANT LA LISTE DES EMPLOIS DE DIRECTEUR GENERAL DES CENTRES HOSPITALIERS REGIONAUX AYANT ACCES A L'ECHELON FONCTIONNEL PREVU A L'ART. 2 DU DECRET 88163 DU 19-02-1988",
          "@c_titre_court": "Arrêté du 4 mars 1988",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000664027"
        },
        {
          "#text": "Arrêté du 4 mars 1988 fixant la liste des emplois de directeur général des centres hospitaliers régionaux ayant accès à l'échelon fonctionnel prévu à l'article 2 du décret 88-163 du 19 février 1988",
          "@c_titre_court": "Arrêté du 4 mars 1988",
          "@debut": "1988-03-15",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006058131"
        }
      ],

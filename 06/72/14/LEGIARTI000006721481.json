      "TITRE_TXT": [
        {
          "#text": "Arrêté du 20 mars 1973 fixant la liste des spécialités médicales et des spécialités chirurgicales mentionnées aux articles 1er et 3 du décret n° 72-1079 du 6 décembre 1972 relatif à la commission médicale consultative des établissements d'hospitalisation publics.",
          "@c_titre_court": "Arrêté du 20 mars 1973",
          "@debut": "1973-04-07",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006073098"
        }
      ],
      "@cid": "LEGITEXT000006073098",
      "@date_publi": "2999-01-01",
      "@date_signature": "1973-03-20",
      "@nature": "ARRETE"
    }

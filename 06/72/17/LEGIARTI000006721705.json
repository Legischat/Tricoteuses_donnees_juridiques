      "TITRE_TXT": [
        {
          "#text": "Arrêté du 16 octobre 1972 DOSSIER JUSTIFICATIF A PRODUIRE A L'APPUI D'UNE DEMANDE DE CREATION OU D'EXTENSION D'UN ETABLISSEMENT SANITAIRE PRIVE COMPORTANT DES MOYENS D'HOSPITALISATION",
          "@c_titre_court": "Arrêté du 16 octobre 1972",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000484018"
        },
        {
          "#text": "Arrêté du 16 octobre 1972 relatif au dossier justificatif à produire à l'appui d'une demande de création ou d'extension d'un établissement sanitaire privé comportant des moyens d'hospitalisation.",
          "@c_titre_court": "Arrêté du 16 octobre 1972",

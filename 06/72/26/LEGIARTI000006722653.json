  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret n°80-987 du 3 décembre 1980 FIXANT LES CATEGORIES DE PERSONNES HABILITEES A EFFECTUER CERTAINS ACTES DE PRELEVEMENT EN VUE D'ANALYSES DE BIOLOGIE MEDICALE",
          "@c_titre_court": "Décret n°80-987 du 3 décembre 1980",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000307645"
        },
        {
          "#text": "Décret n°80-987 du 3 décembre 1980 fixant les catégories de personnes habilitées à effectuer certains actes de prélèvement en vue d'analyses de biologie médicale",
          "@c_titre_court": "Décret n°80-987 du 3 décembre 1980",
          "@debut": "1980-12-09",
          "@fin": "2005-07-26",
          "@id_txt": "LEGITEXT000006063375"
        }
      ],
      "@cid": "JORFTEXT000000307645",
      "@date_publi": "1980-12-09",
      "@date_signature": "1980-12-03",
      "@nature": "DECRET",
      "@num": "80-987"
    }
  },

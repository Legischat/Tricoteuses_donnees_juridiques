  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret n°80-1097 du 24 décembre 1980 FIXANT LES CONDITIONS DANS LESQUELLES LE DIPLOME D'ETAT DE DOCTEUR EN PHARMACIE SE SUBSTITUE AU DIPLOME D'ETAT DE PHARMACIEN AINSI QUE LES DISPOSITIONS TRANSITOIRES S'APPLIQUANT AUX ETUDIANTS EN PHARMACIE EN COURS D'ETUDES",
          "@c_titre_court": "Décret n°80-1097 du 24 décembre 1980",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000305087"
        },
        {
          "#text": "Décret n°80-1097 du 24 décembre 1980 fixant les conditions dans lesquelles le diplôme d'Etat de docteur en pharmacie se substitue au diplôme d'Etat de pharmacien ainsi que les dispositions transitoires s'appliquant aux étudiants en pharmacie en cours d'études",
          "@c_titre_court": "Décret n°80-1097 du 24 décembre 1980",
          "@debut": "1980-12-31",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006063175"
        }
      ],
      "@cid": "JORFTEXT000000305087",
      "@date_publi": "1980-12-31",

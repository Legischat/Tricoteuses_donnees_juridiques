      "TITRE_TXT": [
        {
          "#text": "Décret no 2000-262 du 22 mars 2000 pris pour l'application de l'article 20 de la loi no 99-223 du 23 mars 1999 relative à la protection de la santé des sportifs et à la lutte contre le dopage, et relatif à l'agrément et à l'assermentation des fonctionnaires du ministère de la jeunesse et des sports et des médecins chargés des contrôles",
          "@c_titre_court": "Décret n°2000-262 du 22 mars 2000",
          "@debut": "2999-01-01",

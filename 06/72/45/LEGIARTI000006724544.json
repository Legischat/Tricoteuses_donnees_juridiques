  "BLOC_TEXTUEL": {
    "CONTENU": "<p>L'application des dispositions de l'article L. 16 définies à l'article 8 ci-dessus intervient conformément au tableau suivant en ce qui concerne le grade de pharmacien inspecteur principal :</p>\n<table>\n<tbody>\n<tr>\n<td width=\"189\">\n<p align=\"center\">SITUATION ANCIENNE</p>\n</td>\n<td width=\"189\">\n<p align=\"center\">SITUATION NOUVELLE<br/>par assimilation</p>\n</td>\n</tr>\n<tr>\n<td width=\"189\">\n<p align=\"center\">Grades et échelons</p>\n</td>\n<td width=\"189\">\n<p align=\"center\">Grades et échelons</p>\n</td>\n</tr>\n<tr>\n<td width=\"189\">\n<p align=\"center\">Pharmacien inspecteur principal</p>\n</td>\n<td width=\"189\">\n<p align=\"center\">Pharmacien inspecteur en chef de santé publique</p>\n</td>\n</tr>\n<tr>\n<td width=\"189\">\n<p>5e échelon</p>\n</td>\n<td width=\"189\">\n<p align=\"center\">3e échelon</p>\n</td>\n</tr>\n<tr>\n<td width=\"189\">\n<p>4e échelon</p>\n</td>\n<td width=\"189\">\n<p align=\"center\">3e échelon</p>\n</td>\n</tr>\n<tr>\n<td width=\"189\">\n<p align=\"center\"> </p>\n</td>\n<td width=\"189\">\n<p align=\"center\">Pharmacien inspecteur de santé publique</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"189\">\n<p>3e échelon</p>\n</td>\n<td valign=\"top\" width=\"189\">\n<p align=\"center\">6e échelon</p>\n</td>\n</tr>\n</tbody>\n</table>"
  },

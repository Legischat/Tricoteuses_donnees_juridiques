  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret n°83-872 du 30 septembre 1983 FIXANT LES CONDITIONS D'APPLICATION DES ART. 5 A 7 DE LA LOI 83607 DU 08-07-1983 PORTANT DIVERSES DISPOSITIONS RELATIVES A LA FISCALITE DES ENTREPRISES ET A L'EPARGNE INDUSTRIELLE",
          "@c_titre_court": "Décret n°83-872 du 30 septembre 1983",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000860396"
        },
        {
          "#text": "Décret n°83-872 du 30 septembre 1983 fixant les conditions d'application des articles 5 à 7 de la loi n° 83-607 du 8 juillet 1983 portant diverses dispositions relatives à la fiscalité des entreprises et à l'épargne industrielle",
          "@c_titre_court": "Décret n°83-872 du 30 septembre 1983",
          "@debut": "1983-10-02",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006064264"
        }
      ],
      "@cid": "JORFTEXT000000860396",

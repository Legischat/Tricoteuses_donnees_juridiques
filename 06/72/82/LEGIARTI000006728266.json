        {
          "#text": "Décret n°64-1347 du 30 décembre 1964 CAMEROUN, NOUVELLE-CALEDONIE, INDOCHINE, REUNION, GUADELOUPE, MARTINIQUE, GUYANE, OCEANIE, MADAGASCAR, COMORES, SOMALIS, TOGO, NOUVELLES-HEBRIDES, WALLIS ET FUTUNA",
          "@c_titre_court": "Décret n°64-1347 du 30 décembre 1964",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000508933"
        },
        {
          "#text": "Décret n°64-1347 du 30 décembre 1964 relatif au changement de dénomination de la nouvelle unité monétaire instituée par l'ordonnance n° 58-1341 du 27 décembre 1958 et introduite par décret n° 62-1093 du 14 septembre 1962 dans les départements de la Guadeloupe, de la Guyane et de la Martinique",
          "@c_titre_court": "Décret n°64-1347 du 30 décembre 1964",
          "@debut": "1964-12-31",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006061179"
        }
      ],

        {
          "#text": "Décret n°65-16 du 9 janvier 1965 AUTORISATION DE FABRICATION DE PIECES DE 10 FRS ET DE PIECES DE DEMI-FRANC ET PREVOYANT LA DEMONETISATION DES PIECES DE 50 CENTIMES",
          "@c_titre_court": "Décret n°65-16 du 9 janvier 1965",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000310581"
        },
        {
          "#text": "Décret n°65-16 du 9 janvier 1965 autorisant la fabrication de pièces de 10 F et de pièces de demi-franc et prévoyant la démonétisation des pièces de 50 centimes",
          "@c_titre_court": "Décret n°65-16 du 9 janvier 1965",
          "@debut": "1965-01-12",
          "@fin": "2999-01-01",

      "TITRE_TXT": [
        {
          "#text": "Décret n°66-586 du 3 août 1966 autorisant la démonétisation des pièces de 5 AF en alliage d'aluminium, de 50 AF en bronze d'aluminium et de 100 AF en cupro-nickel",
          "@c_titre_court": "Décret n°66-586 du 3 août 1966",

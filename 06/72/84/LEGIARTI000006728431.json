  "BLOC_TEXTUEL": {
    "CONTENU": "<p>Les billets de la Banque de France de :</p>\n<br/>\n<p>500 anciens francs, type 1953 ;</p>\n<br/>\n<p>1.000 anciens francs, type 1945 ;</p>\n<br/>\n<p>1.000 anciens francs, type 1953 ;</p>\n<br/>\n<p>5.000 anciens francs, type 1949 ;</p>\n<br/>\n<p>5.000 anciens francs, type 1957 ;</p>\n<br/>\n<p>10.000 anciens francs, type 1945 ;</p>\n<br/>\n<p>5 nouveaux francs, type 1959 ;</p>\n<br/>\n<p>10 nouveaux francs, type 1959 ;</p>\n<br/>\n<p>50 nouveaux francs, type 1959, cesseront d'avoir cours légal et pouvoir libératoire à dater du 1er avril 1968.</p>"
  },

      "TITRE_TXT": [
        {
          "#text": "Arrêté du 15 février 1989 FIXANT LES TAUX DE L'INDEMNITE SPECIALE ATTRIBUEE AUX MEDECINS INSPECTEURS DE LA SANTE,AUX MEDECINS DE LA SANTE PUBLIQUE ET AUX MEDECINS CONTRACTUELS DE SANTE SCOLAIRE",
          "@c_titre_court": "Arrêté du 15 février 1989",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000301647"
        },
        {
          "#text": "Arrêté du 15 février 1989 fixant les taux de l'indemnité spéciale attribuée aux médecins inspecteurs de la santé, aux médecins de la santé publique et aux médecins contractuels de santé scolaire",
          "@c_titre_court": "Arrêté du 15 février 1989",
          "@debut": "1989-01-01",

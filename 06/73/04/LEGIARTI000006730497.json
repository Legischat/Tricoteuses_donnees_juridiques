  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les orientations cliniques de l'internat en odontologie sont les suivantes :<br/>\n<br/>   - pédodontie ;<br/>\n<br/>   - orthopédie dento-faciale ;<br/>\n<br/>   - parodontologie ;<br/>\n<br/>   - chirurgie buccale, pathologie et thérapeutique ;<br/>\n<br/>   - odontologie conservatrice et endodontie ;<br/>\n<br/>   - prothèse.<br/>\n<br/>   Les disciplines suivantes : biologie, anatomie, radiologie, occlusodontie, matériaux, anesthésiologie, épidémiologie, prévention et santé publique font partie intégrante des six orientations cliniques ci-dessus définies.<br/>"
  },

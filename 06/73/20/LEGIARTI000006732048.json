      "TITRE_TXT": [
        {
          "#text": "Arrêté du 26 novembre 1982 PROTOCOLES ET NORMES APPLICABLES AUX ESSAIS DE TOLERANCE CUTANEE OU MUQUEUSE REALISES SUR LES PRODUITS COSMETIQUES ET LES PRODUITS D'HYGIENE CORPORELLE",
          "@c_titre_court": "Arrêté du 26 novembre 1982",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000674269"
        },
        {
          "#text": "Arrêté du 26 novembre 1982 relatif aux protocoles et normes applicables aux essais de tolérance cutanée ou muqueuse réalisés sur les produits cosmétiques et les produits d'hygiène corporelle",
          "@c_titre_court": "Arrêté du 26 novembre 1982",
          "@debut": "1983-01-06",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006073180"
        }
      ],

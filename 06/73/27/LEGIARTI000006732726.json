      "TITRE_TXT": [
        {
          "#text": "Décret n°84-36 du 16 janvier 1984 RELEVANT LE PLAFOND DU CHIFFRE D'AFFAIRES DES ENTREPRISES POUVANT BENEFICIER DE PAIEMENTS A TITRE D'AVANCE PAR LE CREDIT D'EQUIPEMENT DES PETITES ET MOYENNES ENTREPRISES (CEPME)",
          "@c_titre_court": "Décret n°84-36 du 16 janvier 1984",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000698826"
        },
        {
          "#text": "Décret n°84-36 du 16 janvier 1984 relevant le plafond du chiffre d'affaires des entreprises pouvant bénéficier de paiements à titre d'avance par le crédit d'équipement des petites et moyennes entreprises",
          "@c_titre_court": "Décret n°84-36 du 16 janvier 1984",
          "@debut": "1984-01-18",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006064469"
        }
      ],
      "@cid": "JORFTEXT000000698826",
      "@date_publi": "1984-01-18",
      "@date_signature": "1984-01-16",
      "@nature": "DECRET",
      "@num": "84-36"
    }
  },

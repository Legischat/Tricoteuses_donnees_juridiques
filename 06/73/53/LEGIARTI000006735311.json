  "NOTA": {
    "CONTENU": "<br/>     article non codifié par le décret n° 2005-368 du 19 avril 2005 relatif au code rural.<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   La caisse qui apprécie l'inaptitude au travail est chargée du contrôle du montant des revenus professionnels prévu selon le cas à l'article R. 352-2, dernier alinéa, à l'article D. 634-2 ou à l'article 71 (1) (§ 3-III, dernier alinéa) du décret n° 50-1225 du 21 septembre 1950, ainsi que du respect des dispositions prévues à l'article L. 732-36 du code rural.<br/>\n<br/>"
  },

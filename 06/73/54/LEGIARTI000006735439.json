  "NOTA": {
    "CONTENU": "<br/>  Décret 2004-1225 2004-11-17 art. 7 : les dispositions du présent article entrent en vigueur à compter de la nomination du président du comité économique des produits de santé.<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Pour l'exercice de ses missions, le comité peut entendre :<br/>\n<br/>   a) Le directeur de l'Agence française de sécurité sanitaire des produits de santé ou son représentant ;<br/>\n<br/>   b) Le président du collège de la Haute Autorité de santé ou son représentant ;<br/>\n<br/>   c) Le président de la Commission de la transparence mentionnée à l'article R. 163-15 ou son représentant ;<br/>\n<br/>   d) Le président de la commission mentionnée à l'article L. 165-1 ou son représentant ;<br/>\n<br/>   e) Le président de la commission prévue à l'article R. 5054 du code de la santé publique ou son représentant,<br/>\n ainsi que toute personne qualifiée.<br/>"
  },

      "TITRE_TXT": [
        {
          "#text": "Décret n°85-68 du 22 janvier 1985 RELATIF A LA TRANSFORMATION D'UN LIVRET D'EPARGNE DU TRAVAILLEUR MANUEL (LETM) EN UN LIVRET D'EPARGNE-ENTREPRISE (LEE),EN APPLICATION DE L'ART. 1 DE LA LOI 84578 DU 09-07-1984 SUR LE DEVELOPPEMENT DE L'INITIATIVE ECONOMIQUE",
          "@c_titre_court": "Décret n°85-68 du 22 janvier 1985",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000689001"
        },
        {
          "#text": "Décret n°85-68 du 22 janvier 1985 relatif à la transformation d'un livret d'épargne du travailleur manuel en un livret d'épargne entreprise, en application de l'article 1er de la loi n° 84-578 du 9 juillet 1984 sur le développement de l'initiative économique",
          "@c_titre_court": "Décret n°85-68 du 22 janvier 1985",
          "@debut": "1985-01-23",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006065068"
        }

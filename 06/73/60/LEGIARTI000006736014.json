  "NOTA": {
    "CONTENU": "<br/>  voir décret n° 86-1005 du 27 aôut 1986, modalités d'application-dispositions transitoires.<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les billets de la Banque de France de 100 F Corneille (type 1964), 50 F Racine (type 1962), 10 F Berlioz (type 1972) et 10 F Voltaire (type 1963) cesseront d'avoir cours légal et pouvoir libératoire à dater du 15 septembre 1986.<br/>\n<br/>"
  },

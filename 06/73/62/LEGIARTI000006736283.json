  "NOTA": {
    "CONTENU": "<br/>   [*Nota - Code de la sécurité sociale D613-5 et D623-3 :<br/>\n dispositions applicables au régime d'assurance maladie et maternité et d'assurance vieillesse des non-salariés non-agricoles.*]<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>      Seul l'agent comptable a qualité pour recevoir et détenir les titres de propriété et les titres de créance. Il en assure la conservation sous sa responsabilité pécuniaire. <br/>\n<br/>"
  },

  "NOTA": {
    "CONTENU": "<br/>   [*Nota - Code de la sécurité sociale D613-5 et D623-3 :<br/>\n dispositions applicables au régime d'assurance maladie et maternité et d'assurance vieillesse des non-salariés non-agricoles.*]<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>      Les comptes annuels comprennent : <br/>\n<br/>   1°) la balance générale des comptes à la clôture de l'exercice ; <br/>\n<br/>   2°) le compte de résultats ; <br/>\n<br/>   3°) le bilan et les annexes. <br/>"
  },

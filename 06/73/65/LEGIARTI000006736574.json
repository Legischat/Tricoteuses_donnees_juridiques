  "NOTA": {
    "CONTENU": "<br/>   Code de la sécurité sociale D753-1 : dispositions applicables dans les DOM.<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>Pour l'octroi au conjoint survivant, en cas d'inaptitude, d'une pension de veuve ou de veuf prévue à l'article L. 357-10, il est fait application de l'article L. 351-7, ainsi que de l'article R. 351-21.<br/>\n<br/>"
  },

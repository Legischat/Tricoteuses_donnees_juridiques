  "BLOC_TEXTUEL": {
    "CONTENU": "<p>Le montant de l'indemnité en capital mentionnée à l'article L. 434-1 est fixé selon le barème suivant :</p>\n<br/>\n<table align=\"center\" border=\"1\" cellpadding=\"0\" cellspacing=\"0\" width=\"378\">\n<tbody>\n<tr>\n<td width=\"209\">\n<p align=\"center\">TAUX D'INCAPACITÉ PERMANENTE (en pourcentage)</p>\n</td>\n<td width=\"169\">\n<p align=\"center\">MONTANT DE L'INDEMNITÉ (en euros)</p>\n</td>\n</tr>\n<tr>\n<td width=\"209\">\n<p align=\"center\">1</p>\n</td>\n<td width=\"169\">\n<p align=\"center\">342,94</p>\n</td>\n</tr>\n<tr>\n<td width=\"209\">\n<p align=\"center\">2</p>\n</td>\n<td width=\"169\">\n<p align=\"center\">557,34</p>\n</td>\n</tr>\n<tr>\n<td width=\"209\">\n<p align=\"center\">3</p>\n</td>\n<td width=\"169\">\n<p align=\"center\">814,41</p>\n</td>\n</tr>\n<tr>\n<td width=\"209\">\n<p align=\"center\">4</p>\n</td>\n<td width=\"169\">\n<p align=\"center\">1 285,37</p>\n</td>\n</tr>\n<tr>\n<td width=\"209\">\n<p align=\"center\">5</p>\n</td>\n<td width=\"169\">\n<p align=\"center\">1 628,31</p>\n</td>\n</tr>\n<tr>\n<td width=\"209\">\n<p align=\"center\">6</p>\n</td>\n<td width=\"169\">\n<p align=\"center\">2 013,92</p>\n</td>\n</tr>\n<tr>\n<td width=\"209\">\n<p align=\"center\">7</p>\n</td>\n<td width=\"169\">\n<p align=\"center\">2 442,21</p>\n</td>\n</tr>\n<tr>\n<td width=\"209\">\n<p align=\"center\">8</p>\n</td>\n<td width=\"169\">\n<p align=\"center\">2 913,69</p>\n</td>\n</tr>\n<tr>\n<td width=\"209\">\n<p align=\"center\">9</p>\n</td>\n<td width=\"169\">\n<p align=\"center\">3 427,84</p>\n</td>\n</tr>\n</tbody>\n</table>"
  },

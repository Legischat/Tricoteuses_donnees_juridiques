  "NOTA": {
    "CONTENU": "<br/>Code de la sécurité sociale D843-2 : l'article D583-1 est applicable aux aides à l'emploi pour la garde des jeunes enfants. <br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>Tout imprimé de demande de prestations familiales fait mention de la possibilité pour les organismes débiteurs de prestations familiales d'effectuer les vérifications et contrôles prévus par l'article L. 583-3 sur l'exactitude des déclarations faites aux organismes débiteurs de prestations familiales par les allocataires pour l'attribution desdites prestations.<br/>\n<br/>"
  },

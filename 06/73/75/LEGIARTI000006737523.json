  "NOTA": {
    "CONTENU": "<br/>   *Nota : Code de la sécurité sociale D612-10 : dérogation. <br/>\n<br/>   D612-11 : date d'effet.*<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les personnes qui bénéficient de l'un des avantages énumérés au 2° de l'article D. 612-10 ci-après sont exonérées du versement des cotisations d'assurance maladie dès qu'elles sont titulaires de cet avantage.<br/>\n<br/>"
  },

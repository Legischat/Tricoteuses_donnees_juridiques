  "NOTA": {
    "CONTENU": "<br/>  Décret 2004-791 2004-07-29 art. 2 : les présentes dispositions sont applicables aux pensions prenant effet postérieurement au 31 décembre 2003.<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   A défaut de déclaration de la reprise d'activité, le service de la pension est suspendu, à titre conservatoire, jusqu'à ce que la déclaration soit effectuée par l'assuré.<br/>\n<br/>"
  },

  "NOTA": {
    "CONTENU": "<br/>Code de la sécurité sociale D712-8 : champ d'application. <br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>Par dérogation à l'article D. 712-2, le fonctionnaire détaché sur un emploi permanent d'un département, d'une commune ou d'un de leurs établissements publics n'ayant pas le caractère industriel ou commercial reste soumis au régime spécial de sécurité sociale des fonctionnaires, institué par le présent chapitre.<br/>\n<br/>"
  },

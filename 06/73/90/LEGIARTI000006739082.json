  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les modalités de remboursement par le régime des expatriés des frais afférents au personnel et à la gestion des locaux sont fixés par la convention prévue à l'article 21 de la loi n° 84-604 du 13 juillet 1984.<br/>\n<br/>"
  },

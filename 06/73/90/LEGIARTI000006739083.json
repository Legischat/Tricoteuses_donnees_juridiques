  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>Sont applicables à la Caisse des Français de l'étranger les dispositions des articles D. 253-2, D. 253-3, D. 253-5 à D. 253-14, D. 253-17 à D. 253-28, D. 253-31 à D. 253-34, D. 253-42, D. 253-43, D. 253-45, D. 253-47, D. 253-48, D. 253-50, D. 253-51, D. 253-53, D. 253-54, D. 253-56, D. 253-59 à D. 253-64, D. 253-66 à D. 253-83.<br/>\n<br/>"
  },

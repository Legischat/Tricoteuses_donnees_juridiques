  "NOTA": {
    "CONTENU": "<br/>   Nota : Loi 2003-1199 2003-12-18 art. 12 VI : les dispositions du présent article s'appliquent pour la première fois à la détermination des contributions dues au plus tard le 1er décembre 2004.<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   La contribution est recouvrée et contrôlée en application des dispositions prévues au 3° de l'article L. 225-1-1 et des articles L. 138-20 à L. 138-23. Les modalités particulières de recouvrement de la contribution, notamment les majorations, les pénalités, les taxations provisionnelles ou forfaitaires, sont précisées par décret en Conseil d'Etat.<br/>\n<br/>"
  },

  "NOTA": {
    "CONTENU": "<br/>   Nota : Loi 2000-1207 2000-12-13 art. 66 II A : le présent article est applicable à la collectivité territoriale de Saint-Pierre-et-Miquelon sous réserve des adaptations suivantes : à l'article L. 381-28, les mots \"caisse primaire d'assurance maladie\" sont remplacés par les mots \"caisse de prévoyance sociale\".<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les bénéficiaires mentionnés à l'article L. 381-27 sont affiliés à une caisse primaire d'assurance maladie.<br/>\n<br/>"
  },

  "BLOC_TEXTUEL": {
    "CONTENU": "<p align=\"center\">\n<strong>TETANOS PROFESSIONNEL.</strong>\n</p>\n<p>\n<br/>\n<br/>Date de création : 18 juillet 1936. </p>Dernière mise à jour : 1er janvier 1947. <br/>\n<table align=\"center\" border=\"1\" cellpadding=\"0\" cellspacing=\"0\" width=\"605\">\n<tbody>\n<tr>\n<td width=\"205\">\n<p align=\"center\">DÉSIGNATION DE LA MALADIE</p>\n</td>\n<td width=\"67\">\n<p align=\"center\">DÉLAI DE prise en charge</p>\n</td>\n<td width=\"330\">\n<p align=\"center\">LISTE LIMITATIVE DES TRAVAUX SUSCEPTIBLES DE provoquer cette maladie</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"205\">\n<p>Tétanos en dehors des cas consécutifs à un accident du travail.</p>\n</td>\n<td valign=\"top\" width=\"67\">\n<p align=\"center\">30 jours</p>\n</td>\n<td valign=\"top\" width=\"330\">\n<p>Travaux effectués dans les égouts.</p>\n</td>\n</tr>\n</tbody>\n</table>"
  },

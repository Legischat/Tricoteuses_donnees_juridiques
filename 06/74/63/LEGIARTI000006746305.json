  "BLOC_TEXTUEL": {
    "CONTENU": "<p align=\"center\">\n<strong>\n<br/>Cancer bronchique primitif provoqué par l'inhalation de poussières ou de vapeurs renfermant des arseno-pyrites aurifères</strong>\n</p>\n<br/>\n<br/>\n<p>\n<br/>\n<br/>\n<br/>\n<br/>\n<br/>\n<br/>\n</p>\n<table align=\"center\" border=\"1\" cellpadding=\"0\" cellspacing=\"0\" width=\"605\">\n<tbody>\n<tr>\n<td width=\"242\">\n<p align=\"center\">DÉSIGNATION DE LA MALADIE</p>\n</td>\n<td width=\"81\">\n<p align=\"center\">DÉLAI DE<br/>prise en charge</p>\n</td>\n<td width=\"282\">\n<p align=\"center\">LISTE LIMITATIVE DES TRAVAUX SUSCEPTIBLES de provoquer cette maladie</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"242\">\n<p>Cancer bronchique primitif.</p>\n</td>\n<td valign=\"top\" width=\"81\">\n<p align=\"center\">40 ans (sous réserve d'une durée d'exposition de 10 ans)</p>\n</td>\n<td valign=\"top\" width=\"282\">\n<p>Travaux d'extraction au fond dans les mines de minerais renfermant des arseno-pyrites aurifères. Travaux de concassage et de broyage effectués à sec de minerais renfermant des arseno-pyrites aurifères.</p>\n</td>\n</tr>\n</tbody>\n</table>\n<br/>"
  },

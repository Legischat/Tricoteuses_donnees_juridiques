  "BLOC_TEXTUEL": {
    "CONTENU": "<p align=\"center\">\n<strong>\n<br/>CANCERS PROVOQUES PAR LES OPERATIONS DE GRILLAGE DES MATTES DE NICKEL</strong>\n</p>\n<br/>\n<br/>\n<p>\n<br/>\n<br/>\n<br/>\n</p>\n<table align=\"center\" border=\"1\" cellpadding=\"0\" cellspacing=\"0\" width=\"605\">\n<tbody>\n<tr>\n<td width=\"246\">\n<p align=\"center\">DÉSIGNATION DE LA MALADIE</p>\n</td>\n<td width=\"76\">\n<p align=\"center\">DÉLAI de prise en charge</p>\n</td>\n<td width=\"284\">\n<p align=\"center\">LISTE LIMITATIVE DES TRAVAUX SUSCEPTIBLES de provoquer ces maladies</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"246\">\n<p>Cancer primitif de l'ethmoïde et des sinus de la face.</p>\n</td>\n<td valign=\"top\" width=\"76\">\n<p align=\"center\">40 ans</p>\n</td>\n<td valign=\"top\" width=\"284\">\n<p>Opérations de grillage de mattes de nickel.</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"246\">\n<p>Cancer bronchique primitif.</p>\n</td>\n<td valign=\"top\" width=\"76\">\n<p align=\"center\"> </p>\n</td>\n<td valign=\"top\" width=\"284\"/>\n</tr>\n</tbody>\n</table>"
  },

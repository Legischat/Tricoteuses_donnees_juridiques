  "BLOC_TEXTUEL": {
    "CONTENU": "<p align=\"center\">\n<strong>\n<br/>Affections consécutives au travail au fond dans les mines de fer</strong>\n</p>\n<br/>\n<br/>\n<p>\n<br/>\n<br/>\n<br/>\n</p>\n<table align=\"center\" border=\"1\" cellpadding=\"0\" cellspacing=\"0\" width=\"605\">\n<tbody>\n<tr>\n<td width=\"246\">\n<p align=\"center\">DÉSIGNATION DES MALADIES</p>\n</td>\n<td width=\"76\">\n<p align=\"center\">DÉLAI de prise en charge</p>\n</td>\n<td width=\"284\">\n<p align=\"center\">LISTE LIMITATIVE DES TRAVAUX SUSCEPTIBLES de provoquer cette maladie</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"246\">\n<p>Cancer bronchopulmonaire primitif.</p>\n</td>\n<td valign=\"top\" width=\"76\">\n<p align=\"center\">40 ans (sous réserve d'une durée d'exposition de 10 ans)</p>\n</td>\n<td valign=\"top\" width=\"284\">\n<p>Travaux effectués au fond dans les mines de fer.</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"246\">\n<p>Emphysème : objectivé par des signes tomodensitométriques et des altérations fonctionnelles de type obstructif ou, lorsqu'elles existent, par des constatations anatomopathologiques.</p>\n</td>\n<td valign=\"top\" width=\"76\">\n<p align=\"center\">15 ans (sous réserve d'une durée d'exposition de 10 ans)</p>\n</td>\n<td valign=\"top\" width=\"284\"/>\n</tr>\n</tbody>\n</table>"
  },

  "BLOC_TEXTUEL": {
    "CONTENU": "<p align=\"center\">\n<br/>\n<strong>LESIONS CHRONIQUES DU MENISQUE</strong>\n</p>\n<br/>\n<br/>\n<br/>\n<br/>\n<table align=\"center\" border=\"1\" cellpadding=\"0\" cellspacing=\"0\">\n<tbody>\n<tr>\n<td width=\"246\">\n<p align=\"center\">DÉSIGNATION DES MALADIES</p>\n</td>\n<td width=\"76\">\n<p align=\"center\">DÉLAI de prise en charge</p>\n</td>\n<td width=\"284\">\n<p align=\"center\">LISTE LIMITATIVE DES TRAVAUX SUSCEPTIBLES de provoquer ces maladies</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"246\">\n<p>Lésions chroniques du ménisque à caractère dégénératif, confirmées par examens complémentaires ou au cours de l'intervention curative, ainsi que leurs complications : fissuration ou rupture du ménisque.</p>\n</td>\n<td valign=\"top\" width=\"76\">\n<p align=\"center\">2 ans</p>\n</td>\n<td valign=\"top\" width=\"284\">\n<p>Travaux comportant des efforts ou des ports de charges exécutés habituellement en position agenouillée ou accroupie.</p>\n</td>\n</tr>\n</tbody>\n</table>\n<br/>"
  },

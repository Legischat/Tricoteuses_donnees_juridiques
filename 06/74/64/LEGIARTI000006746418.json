  "BLOC_TEXTUEL": {
    "CONTENU": "<p align=\"center\">\n<br/>\n<strong>Lésions chroniques du segment antérieur de l'oeil provoquées par l'exposition à des particules en circulation dans les puits de mine de charbon</strong>\n</p>\n<br/>\n<br/>\n<p>\n<br/>\n<br/>\n</p>\n<table align=\"center\" border=\"1\" cellpadding=\"0\" cellspacing=\"0\" width=\"605\">\n<tbody>\n<tr>\n<td width=\"246\">\n<p align=\"center\">DÉSIGNATION DE LA MALADIE</p>\n</td>\n<td width=\"76\">\n<p align=\"center\">DÉLAI de prise en charge</p>\n</td>\n<td width=\"284\">\n<p align=\"center\">LISTE LIMITATIVE DES TRAVAUX SUSCEPTIBLES de provoquer ces maladies</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"246\">\n<p>Conjonctivite chronique ou blépharoconjonctivite chronique.</p>\n</td>\n<td valign=\"top\" width=\"76\">\n<p align=\"center\">90 jours sous réserve d'une durée d'exposition de 2 ans</p>\n</td>\n<td valign=\"top\" width=\"284\">\n<p>Travaux dans les puits de retour d'air des mines de charbon.</p>\n</td>\n</tr>\n</tbody>\n</table>"
  },

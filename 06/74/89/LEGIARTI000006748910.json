  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   La caisse nationale d'assurance vieillesse gère les fonds ci-après : <br/>\n<br/>   1°) le fonds national d'assurance vieillesse ; <br/>\n<br/>   2°) le fonds national d'assurance veuvage ; <br/>\n<br/>   3°) le fonds national d'action sanitaire et sociale ; <br/>\n<br/>   4°) le fonds national de gestion administrative. <br/>"
  },

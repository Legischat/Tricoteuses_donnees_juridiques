  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   La caisse nationale de l'assurance maladie des travailleurs salariés gère les fonds énumérés ci-après :<br/>\n<br/>   1°) le Fonds national de l'assurance maladie ;<br/>\n<br/>   2°) le Fonds national des accidents du travail ;<br/>\n<br/>   3°) le Fonds national de prévention des accidents du travail et des maladies professionnelles ;<br/>\n<br/>   4°) le Fonds national d'action sanitaire et sociale ;<br/>\n<br/>   5°) le Fonds national de prévention, d'éducation et d'information sanitaires ;<br/>\n<br/>   6°) le Fonds national du contrôle médical ;<br/>\n<br/>   7°) le Fonds national de la gestion administrative.<br/>"
  },

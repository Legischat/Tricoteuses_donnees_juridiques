    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Arrêté du 9 novembre 1962 A COMPTER DU 01-01-1963, L'UNITE MONETAIRE FRANCAISE INSTITUEE PAR L'ORDONNANCE 58-1341 DU 27-12-1958 CESSERA D'ETRE DESIGNEE PAR LE TERME \"NOUVEAU FRANC\"",
          "@c_titre_court": "Arrêté du 9 novembre 1962",
          "@debut": "2999-01-01",

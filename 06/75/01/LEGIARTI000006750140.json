  "BLOC_TEXTUEL": {
    "CONTENU": "<p align=\"center\">\n<br/>\n<strong>Affections provoquées par les amines aromatiques, leurs sels et leurs dérivés notamment hydroxylés, halogénés, nitrés, nitrosés et sulfonés</strong>\n</p>\n<br/>\n<br/>\n<br/>\n<br/>\n<table align=\"center\" border=\"1\" cellpadding=\"0\" cellspacing=\"0\" width=\"605\">\n<tbody>\n<tr>\n<td width=\"242\">\n<p align=\"center\">DÉSIGNATION DES MALADIES</p>\n</td>\n<td width=\"81\">\n<p align=\"center\">DÉLAI DE prise en charge</p>\n</td>\n<td width=\"282\">\n<p align=\"center\">LISTE INDICATIVE DES PRINCIPAUX TRAVAUX susceptibles de provoquer ces maladies</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"242\">\n<p>Troubles neurologiques à type de somnolence, narcose, coma.</p>\n</td>\n<td valign=\"top\" width=\"81\">\n<p align=\"center\">3 jours</p>\n</td>\n<td rowspan=\"4\" valign=\"top\" width=\"282\">\n<p>Préparation, emploi, manipulation des amines aromatiques, de leurs sels, de leurs dérivés notamment hydroxylés, halogénés, nitrosés, nitrés et sulfonés.</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"242\">\n<p>Cyanose, subictère.</p>\n</td>\n<td valign=\"top\" width=\"81\">\n<p align=\"center\">10 jours</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"242\">\n<p>Hémoglobinurie lorsque ces maladies comportent une hémolyse et une méthémoglobinémie (en dehors des cas considérés comme accidents du travail).</p>\n</td>\n<td valign=\"top\" width=\"81\">\n<p align=\"center\">10 jours</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"242\">\n<p>Dermites irritatives.</p>\n</td>\n<td valign=\"top\" width=\"81\">\n<p align=\"center\">7 jours</p>\n</td>\n</tr>\n</tbody>\n</table>"
  },

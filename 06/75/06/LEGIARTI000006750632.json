  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>Les taux servant au calcul de l'allocation de soutien familial sont fixés, en pourcentage de la base mensuelle de calcul des allocations familiales déterminée en application de l'article L. 551-1 à : <br/>\n<br/>1°) 30 % pour l'enfant mentionné au 1° de l'article L. 523-3 ; <br/>\n<br/>2°) 22,5 % pour l'enfant mentionné au 2° de l'article L. 523-3.<br/>"
  },

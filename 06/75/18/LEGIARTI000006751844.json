      "TITRE_TXT": [
        {
          "#text": "Arrêté du 3 août 1987 FIXANT LA VALEUR DES TITRES DE L'EMPRUNT D'ETAT 7% 1973,REMIS EN REGLEMENT DES OBLIGATIONS ASSIMILABLES A CELLES DE L'EMPRUNT D'ETAT JANVIER 1987 EMISES EN août 1987",
          "@c_titre_court": "Arrêté du 3 août 1987",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000475273"
        },
        {
          "#text": "Arrêté du 3 août 1987 fixant la valeur d'échange des titres de l'emprunt d'Etat 7 p. 100 1973 remis en règlement des obligations assimilables à celles de l'emprunt d'Etat Janvier 1987 émises en août 1987",
          "@c_titre_court": "Arrêté du 3 août 1987",

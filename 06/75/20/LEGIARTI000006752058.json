  "NOTA": {
    "CONTENU": "<br/>   [*Nota - Code de la sécurité sociale D758-3 : dispositions applicables dans les DOM.*]<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>L'affiliation des assurés prend effet à compter du premier jour du trimestre civil qui suit la date à laquelle sont remplies les conditions d'assujettissement définies aux articles R. 721-13 et R. 721-58 au régime d'assurance vieillesse institué par l'article L. 721-1, ou à partir de cette date si celle-ci se situe le premier jour d'un trimestre civil     .<br/>\n<br/>"
  },

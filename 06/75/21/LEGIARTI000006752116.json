  "NOTA": {
    "CONTENU": "<br/>   [*Nota : Décret 91-307 du 25 mars 1991 art. 1 : le présent article du code de la sécurité sociale est applicable à Saint-Pierre-et-Miquelon.*]<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>Les personnes affiliées au régime de l'assurance personnelle ont droit et ouvrent droit aux prestations en nature de l'assurance maladie et maternité du régime général de sécurité sociale à compter du premier jour du mois civil qui suit la date d'effet de leur affiliation     . <br/>\n<br/>Toutefois, les personnes mentionnées aux articles L. 741-2 et L. 741-3 du présent code et à l'article 45 de la loi du 1er décembre 1988 ont droit et ouvrent droit auxdites prestations dès la date d'effet de leur affiliation.<br/>"
  },

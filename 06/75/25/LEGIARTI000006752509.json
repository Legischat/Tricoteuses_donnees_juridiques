  "NOTA": {
    "CONTENU": "<br/>  <br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>      Les personnes mentionnées à l'article L. 311-5 ou à l'article 77 du décret n° 50-1225 du 21 septembre 1950 qui adhèrent à l'assurance personnelle avant la fin de la période de maintien de leurs droits ou à l'expiration de cette période peuvent voir leurs cotisations prises en charge par l'aide sociale sans que soient mises en jeu les règles relatives à l'obligation alimentaire. <br/>\n<br/>"
  },

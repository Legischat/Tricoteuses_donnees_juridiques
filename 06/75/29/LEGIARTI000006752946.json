  "NOTA": {
    "CONTENU": "<br/>   [*Nota - Code de la sécurité sociale D758-3 : dispositions applicables dans les DOM.*]<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>A défaut de règlement dans le délai de quinze jours à partir de la mise en demeure     , le directeur de la caisse peut peut délivrer une contrainte dans les conditions fixées par l'article L. 244-9 et la section 2 du chapitre III du titre III du livre Ier.<br/>\n<br/>"
  },

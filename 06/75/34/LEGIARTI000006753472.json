  "NOTA": {
    "CONTENU": "<br/>  <br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   L'allocation de garde d'enfant à domicile est attribuée pour la garde d'au moins un enfant à charge de moins de six ans.<br/>\n<br/>   Elle est due au montant défini au I de l'article L. 842-2 pour la garde d'au moins un enfant âgé de moins de trois ans.<br/>\n<br/>   Elle est due au montant réduit prévu au III de l'article L. 842-2 pour la garde d'au moins un enfant âgé de plus de trois ans et de moins de six ans.<br/>"
  },

  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>Il n'est pas tenu compte de l'allocation de solidarité aux personnes âgées pour l'application des plafonds de ressources institués pour les différents régimes mentionnés à l'article L. 621-2 et pour le calcul des avantages garantis par les régimes complémentaires mentionnés à l'article L. 921-1.<br/>\n<br/>"
  },

  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Arrêté du 21 mars 1983 LE CREDIT D'EQUIPEMENT DES PETITES ET MOYENNES ENTREPRISES (CEPME) EST AUTORISE A EMETTRE UN EMPRUNT DE 1500000000FRS REPRESENTES PAR 300000 OBLIGATIONS D'UNE VALEUR DE 5000FRS",
          "@c_titre_court": "Arrêté du 21 mars 1983",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000496621"
        },
        {
          "#text": "Arrêté du 21 mars 1983 relatif à l'émission d'un emprunt par le crédit d'équipement des petites et moyennes entreprises",
          "@c_titre_court": "Arrêté du 21 mars 1983",

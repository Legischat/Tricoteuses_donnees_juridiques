          "#text": "Loi n°65-883 du 20 octobre 1965 ASSURES VOLONTAIRES",
          "@c_titre_court": "Loi n°65-883 du 20 octobre 1965",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000691972"
        },
        {
          "#text": "Loi n° 65-883 du 20 octobre 1965 RELATIVE A L'ADMISSION A L'ASSURANCE VOLONTAIRE DU CONJOINT OU DU MEMBRE DE LA FAMILLE DU GRAND INVALIDE REMPLISSANT OU AYANT REMPLI BENEVOLEMENT AUPRES DE CE DERNIER LE ROLE DE \" TIERCE PERSONNE \".",
          "@c_titre_court": "Loi n° 65-883 du 20 octobre 1965",
          "@debut": "1965-10-21",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006068260"
        }
      ],

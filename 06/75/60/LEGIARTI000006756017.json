  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Loi n°72-1203 du 23 décembre 1972 PROLONGEANT L'AGE LIMITE D'OUVERTURE DU DROIT AUX PRESTATIONS FAMILIALES ET AUX PRESTATIONS D'ASSURANCE MALADIE EN FAVEUR DES ENFANTS A LA RECHERCHE D'UN EMPLOI A L'ISSUE DE LEUR SCOLARITE OBLIGATOIRE",
          "@c_titre_court": "Loi n°72-1203 du 23 décembre 1972",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000684276"
        },
        {
          "#text": "Loi n° 72-1203 du 23 décembre 1972 prolongeant l'âge limite d'ouverture du droit aux prestations d'assurance maladie et aux prestations familiales en faveur des enfants à la recherche d'un emploi à l'issue de leur scolarité obligatoire.",
          "@c_titre_court": "Loi n° 72-1203 du 23 décembre 1972",
          "@debut": "1972-12-29",
          "@fin": "2022-02-16",
          "@id_txt": "LEGITEXT000006068433"
        }
      ],

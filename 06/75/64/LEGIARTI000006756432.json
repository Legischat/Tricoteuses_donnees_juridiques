  "NOTA": {
    "CONTENU": "<br/>    [*Nota : loi 88-1088 du 1er décembre 1988 art. 52 : les dispositions du présent article sont applicables jusqu'au 30 juin 1992.*]<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les dispositions du code du travail relatives à la durée du travail, au travail de nuit, au repos hebdomadaire, aux jours fériés, à la sécurité du travail et au travail des femmes, des enfants et des jeunes travailleurs sont applicables aux personnes mentionnées à l'article 48.<br/>\n<br/>"
  },

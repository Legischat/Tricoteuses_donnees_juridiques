  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   I. - modificateur.<br/>\n<br/>   II. - modificateur.<br/>\n<br/>   III. - modificateur.<br/>\n<br/>   IV. - modificateur.<br/>\n<br/>   V. - modificateur.<br/>\n<br/>   VI. - modificateur.<br/>\n<br/>   VII. - modificateur.<br/>\n<br/>   VIII. - La majoration de l'aide à la famille pour l'emploi d'une assistante maternelle agréée n'est pas soumise à l'impôt sur le revenu.<br/>\n<br/>   IX. - Les dispositions du présent article entreront en vigueur le 1er janvier 1992 pour les périodes d'emploi postérieures à cette date.<br/>"
  },

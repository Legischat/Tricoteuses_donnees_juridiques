      "TITRE_TXT": [
        {
          "#text": "Loi n°60-793 du 2 août 1960 RELATIVE A L'ACCESSION DES MEMBRES DU CADRE DE L'ENSEIGNEMENT FRANCAIS A L'ETRANGER AU REGIME DE L'ASSURANCE VOLONTAIRE POUR LE RISQUE VIEILLESSE",
          "@c_titre_court": "Loi n°60-793 du 2 août 1960",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000508776"
        },
        {
          "#text": "Loi n° 60-793 du 2 août 1960 relative à l'accession des membres du cadre auxiliaire de l'enseignement français à l'étranger au régime de l'assurance volontaire pour le risque vieillesse (1).",
          "@c_titre_court": "Loi n° 60-793 du 2 août 1960",
          "@debut": "1960-08-04",
          "@fin": "2022-02-16",
          "@id_txt": "LEGITEXT000006068203"

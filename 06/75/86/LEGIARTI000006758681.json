        {
          "#text": "Loi n°61-1312 du 6 décembre 1961 TENDANT A ACCORDER LE BENEFICE DE LA LEGISLATION DES ACCIDENTS DU TRAVAIL AUX MEMBRES BENEVOLES DES ORGANISMES SOCIAUX",
          "@c_titre_court": "Loi n°61-1312 du 6 décembre 1961",
          "@debut": "2999-01-01",

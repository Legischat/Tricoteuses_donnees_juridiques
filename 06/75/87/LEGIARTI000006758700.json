      "TITRE_TXT": [
        {
          "#text": "Arrêté du 31 décembre 1990 ANT LA GARANTIE DE L'ETAT AUX EMPRUNTS OBLIGATAIRES PTT ET AUX BONS D'EPARGNE PTT EMIS LE 31-12-1990",
          "@c_titre_court": "Arrêté du 31 décembre 1990",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000864753"
        },
        {
          "#text": "Arrêté du 31 décembre 1990 accordant la garantie de l'Etat aux emprunts obligataires P.T.T. et aux bons d'épargne P.T.T. émis avant le 31 décembre 1990",
          "@c_titre_court": "Arrêté du 31 décembre 1990",
          "@debut": "1991-01-18",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006059506"
        }
      ],

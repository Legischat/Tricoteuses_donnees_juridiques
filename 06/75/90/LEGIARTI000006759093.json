  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Loi n°77-441 du 27 avril 1977 PORTANT DEROGATION,EN CE QUI CONCERNE CERTAINS MARINS DES DEPARTEMENTS D'OUTRE-MER ET DU TERRITOIRE DE LA POLYNESIE FRANCAISE,A DIVERSES DISPOSITIONS DU CODE DES PENSIONS DE RETRAITE DES MARINS ET DU DECRET-LOI DU 17-06-1938",
          "@c_titre_court": "Loi n°77-441 du 27 avril 1977",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000333074"
        },
        {
          "#text": "Loi n° 77-441 du 27 avril 1977 portant dérogations, en ce qui concerne certains marins des départements d'outre-mer et du territoire d'outre-mer de la Polynésie française, à diverses dispositions du code des pensions de retraite des marins et du décret-loi du 17 juin 1938 (1).",
          "@c_titre_court": "Loi n° 77-441 du 27 avril 1977",
          "@debut": "1977-04-28",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006068582"
        }

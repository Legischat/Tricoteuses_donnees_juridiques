        {
          "#text": "Ordonnance n° 67-709 du 21 août 1967 PORTANT GENERALISATION DES ASSURANCES SOCIALES VOLONTAIRES POUR LA COUVERTURE DU RISQUE MALADIE ET DES CHARGES DE LA MATERNITE.",
          "@c_titre_court": "Ordonnance n° 67-709 du 21 août 1967",
          "@debut": "1967-08-22",

        "TM": {
          "TITRE_TM": [
            {
              "#text": "DISPOSITIONS SPECIALES RELATIVES A L'ACCESSION AU REGIME DE L'ASSURANCE VOLONTAIRE VIEILLESSE DES SALARIES DE NATIONALITE FRANCAISE EXERCANT OU AYANT EXERCE A L'ETRANGER UNE ACTIVITE PROFESSIONNELLE SALARIEE.",

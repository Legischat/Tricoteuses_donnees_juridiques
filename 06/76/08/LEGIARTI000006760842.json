    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret n°80-418 du 5 juin 1980 RELATIF A L'APPLICATION DE LA LEGISLATION DU TRAVAIL AUX PERSONNES VISEES A L'ART. L416-7EME DU CODE DE LA SECURITE SOCIALE (SALARIES D'ENTREPRISE QUI SIEGENT A DES ORGANISMES TRAITANT DES PROBLEMES D'EMPLOI OU DE FORMATION PROFESSIONNELLE OU QUI PARTICIPENT A UN JURY D'EXAMEN), A L'EXCEPTION DES PERSONNES QUI BENEFICIENT DU REGIME RESERVE AUX MEMBRES BENEVOLES DES ORGANISMES SOCIAUX ENUMERES A L'ART. 2 DU DECRET 63380 DU 08-04-1963.(L'ART. L416-7EME DU CODE DE LA SECURITE SOCIALE EST ISSU DE L'ART. 13-I DE LA LOI 78754 DU 17-07-1978)",
          "@c_titre_court": "Décret n°80-418 du 5 juin 1980",

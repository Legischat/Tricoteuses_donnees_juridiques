        {
          "#text": "Décret n°69-132 du 6 février 1969  RELATIF A LA SUPPRESSION DE LA PARTICIPATION AUX FRAIS SERVANT DE BASE AU CALCUL DES PRESTATIONS EN NATURE DE L'ASSURANCE MALADIE DES ASSURES ATTEINTS D'UNE DES AFFECTIONS  MENTIONNEES AUX 3° ET 4° DE L'ARTICLE L. 286-1 (PAR. I) DU CODE DE LA SECURITE SOCIALE.",
          "@c_titre_court": "Décret n°69-132 du 6 février 1969",
          "@debut": "1969-02-07",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006061613"
        }
      ],

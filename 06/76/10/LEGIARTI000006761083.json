          "@id_txt": "JORFTEXT000000330826"
        },
        {
          "#text": "Décret n°67-803 du 20 septembre 1967  PORTANT FIXATION DES TAUX DES COTISATIONS DES ASSURANCES SOCIALES ET DES ALLOCATIONS FAMILIALES DU REGIME GENERAL DE LA SECURITE SOCIALE.",
          "@c_titre_court": "Décret n°67-803 du 20 septembre 1967",

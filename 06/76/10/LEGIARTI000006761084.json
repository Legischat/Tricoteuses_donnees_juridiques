      "TITRE_TXT": [
        {
          "#text": "Décret n°67-803 du 20 septembre 1967 LE TAUX DE LA COTISATION DES ASSURANCES SOCIALES AFFERENTE AUX RISQUES MALADIE, MATERNITE INVALIDITE ET DECES EST FIXEE A 15 %, SOIT 11,50 % A LA CHARGE DE L'EMPLOYEUR ET 3,50 % A LA CHARGE DU SALARIE OU ASSIMILE (A COMPTER DU 01-10-1967)",
          "@c_titre_court": "Décret n°67-803 du 20 septembre 1967",

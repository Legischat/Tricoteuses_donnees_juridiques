    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret n°50-133 du 20 janvier 1950 COORDINATION AVEC LES REGIMES DE PENSIONS MILITAIRES ET CIVILES ET DE RETRAITES DES AGENTS DES COLLECTIVITES LOCALES (FONCTIONNAIRES)",
          "@c_titre_court": "Décret n°50-133 du 20 janvier 1950",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000848459"
        },
        {
          "#text": "Décret n°50-133 du 20 janvier 1950  RELATIF AUX REGLES DE COORDINATION APPLICABLES, EN CE QUI CONCERNE L'ASSURANCE VIEILLESSE, AUX BENEFICIAIRES DES REGIMES DE RETRAITES INSTITUES PAR LES LOIS DES 14 AVRIL 1924, 20 SEPTEMBRE 1948, 29 JUIN 1927, 21 MARS 1928 ET 2 AOUT 1949 ET AUX TRIBUTAIRES DE LA CAISSE NATIONALE DE RETRAITES DES AGENTS DES COLLECTIVITES LOCALES.",
          "@c_titre_court": "Décret n°50-133 du 20 janvier 1950",
          "@debut": "1950-01-29",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006060559"
        }
      ],
      "@cid": "JORFTEXT000000848459",
      "@date_publi": "1950-01-29",
      "@date_signature": "1950-01-20",
      "@nature": "DECRET",
      "@num": "50-133"
    }
  },

      "TITRE_TXT": [
        {
          "#text": "Décret n°81-311 du 3 avril 1981 LES CONDITIONS D'EXONERATION DES COTISATIONS D'ASSURANCE MALADIE ET MATERNITE,ASSISES SUR LES ALLOCATIONS DE GARANTIE DE RESSOURCES ET SUR LES AVANTAGES DE RETRAITE (ART. L3-2 (AL. 2) DU CODE DE LA SECURITE SOCIALE) SERVIS AUX RESSORTISSANTS DE CERTAINS REGIMES SPECIAUX (FIXES PAR RAP (AL. 3) AUTRES QUE CEUX DES CLERCS ET EMPLOYES DE NOTAIRES,ET INDUSTRIES ELECTRIQUES ET GAZIERES) SONT CELLES FIXEES PAR LE DECRET 80298 DU 24-04-1980 (REGIME GENERAL)",
          "@c_titre_court": "Décret n°81-311 du 3 avril 1981",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000503255"
        },
        {
          "#text": "Décret n°81-311 du 3 avril 1981  FIXANT POUR CERTAINS REGIMES *SPECIAUX* MENTIONNES A L'ARTICLE L. 3 DU CODE DE LA SECURITE SOCIALE LES CONDITIONS D'EXONERATION DES COTISATIONS D'ASSURANCE MALADIE ASSISES SUR LES AVANTAGES DE RETRAITE SERVIS A LEURS RESSORTISSANTS.",
          "@c_titre_court": "Décret n°81-311 du 3 avril 1981",

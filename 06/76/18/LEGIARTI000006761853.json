  "BLOC_TEXTUEL": {
    "CONTENU": "<p>Les dispositions du présent décret sont applicables aux assurés ayant appartenu aux régimes agricole et non agricole des assurances sociales âgés de moins de soixante ans au 1er avril 1946.</p>\n<br/>\n<br/>\n<br/>"
  },

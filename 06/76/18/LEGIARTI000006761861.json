          "@id_txt": "JORFTEXT000000318349"
        },
        {
          "#text": "Décret n°51-820 du 27 juin 1951 relatif à la détermination des droits à l'assurance vieillesse des assurés ayant appartenu aux régimes agricole et non agricole des assurances sociales",
          "@c_titre_court": "Décret n°51-820 du 27 juin 1951",
          "@debut": "1951-06-29",

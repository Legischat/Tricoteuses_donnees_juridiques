  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret n°66-1058 du 30 décembre 1966  PORTANT APPLICATION DE LA LOI N° 65-883 DU 20 OCTOBRE 1965, RELATIVE A L'ADMISSION A L'ASSURANCE VOLONTAIRE DU CONJOINT OU DU MEMBRE DE LA FAMILLE DU GRAND INVALIDE REMPLISSANT OU AYANT REMPLI BENEVOLEMENT AUPRES DE CE DERNIER LE ROLE DE \"TIERCE PERSONNE\".",
          "@c_titre_court": "Décret n°66-1058 du 30 décembre 1966",
          "@debut": "1966-12-31",
          "@fin": "1980-07-17",
          "@id_txt": "LEGITEXT000006073381"
        }
      ],
      "TM": {
        "TITRE_TM": [
          {
            "#text": "CHAPITRE I : DISPOSITIONS RELATIVES A L'ACCESSION A L'ASSURANCE SOCIALE VOLONTAIRE DU CONJOINT OU DU MEMBRE DE LA FAMILLE DU GRAND INVALIDE QUI REMPLIT BENEVOLEMENT AUPRES DE LUI LE ROLE DE \"TIERCE PERSONNE\".",
            "@debut": "1966-12-31",
            "@fin": "1980-07-17",
            "@id": "LEGISCTA000006106532"
          }
        ]
      },
      "@cid": "LEGITEXT000006073381",

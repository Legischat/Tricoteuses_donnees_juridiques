        {
          "#text": "Décret n°72-977 du 27 octobre 1972  DETERMINANT LES MODALITES D'APPLICATION DE L'ARTICLE 73 DE LA LOI DE FINANCES POUR 1972 RELATIF AU REGIME D'ASSURANCE MALADIE, MATERNITE ET INVALIDITE (SOINS) DES MARINS EN ACTIVITE OU RETRAITES DU COMMERCE, DE LA PECHE ET DE LA PLAISANCE.",
          "@c_titre_court": "Décret n°72-977 du 27 octobre 1972",
          "@debut": "1972-10-28",
          "@fin": "1985-12-21",
          "@id_txt": "LEGITEXT000006062010"
        }
      ],

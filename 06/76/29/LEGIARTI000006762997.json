  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret n°82-444 du 28 mai 1982 RELATIF AU RECOUVREMENT DES COTISATIONS D'ASSURANCE MALADIE, MATERNITE, INVALIDITE, DECES, ASSISES SUR LES REVENUS DESTINES A INDEMNISER L'ABSENCE TOTALE OU PARTIELLE D'EMPLOI DES SALARIES RELEVANT DU REGIME GENERAL DE LA SECURITE SOCIALE ET DU REGIME DES ASSURANCES SOCIALES AGRICOLES A COMPTER DU 01-06-1982",
          "@c_titre_court": "Décret n°82-444 du 28 mai 1982",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000880482"
        },

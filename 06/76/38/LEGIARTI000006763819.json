  "NOTA": {
    "CONTENU": "<br/>   [*Nota - article annulé par décision du Conseil d'Etat n° 50673 du 26 septembre 1986 (syndicat national des industries pharmaceutiques).*]<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les entreprises [*pharmaceutiques - définition*] mentionnées au premier alinéa de l'article 3 de la loi du 19 janvier 1983 susvisée s'entendent de celles titulaires d'une autorisation de mise sur le marché pour une ou des spécialités inscrites sur la liste des médicaments remboursables aux assurés sociaux ou sur la liste des médicaments agréés à l'usage des collectivités.<br/>\n<br/>"
  },

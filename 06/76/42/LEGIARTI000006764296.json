  "BLOC_TEXTUEL": {
    "CONTENU": "Le montant de la cotisation prévue à l'article 1123 (1°, a) du code rural est fixé comme suit :<br/>\n<br/>\n ========================================<br/>\n<table>\n<tr>\n<td> :  REVENU CADASTRAL :      MONTANT     :</td>\n</tr>\n<tr>\n<td> : DE L'EXPLOITATION : de la cotisation :</td>\n</tr>\n<tr>\n<td> :-------------------:------------------:</td>\n</tr>\n<tr>\n<td> :                   :       Francs     :</td>\n</tr>\n<tr>\n<td> : Plus de 17.520 F  :        860       :</td>\n</tr>\n<tr>\n<td> : De 6.617,01       :                  :</td>\n</tr>\n<tr>\n<td> : à 17.520 F        :        610       :</td>\n</tr>\n<tr>\n<td> : De 2.920,01       :                  :</td>\n</tr>\n<tr>\n<td> : à 6.617 F         :        460       :</td>\n</tr>\n<tr>\n<td> : De 1.526,01       :                  :</td>\n</tr>\n<tr>\n<td> : à 2.920 F         :        375       :</td>\n</tr>\n<tr>\n<td> : Au plus égal      :                  :</td>\n</tr>\n<tr>\n<td> : à 1.526 F         :        340       :</td>\n</tr>\n<tr>\n<td> :                   :                  :</td>\n</tr>\n</table>\n<br/>\n ========================================"
  },

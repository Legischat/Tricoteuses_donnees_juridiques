  "NOTA": {
    "CONTENU": "<br/>   [*Nota : Décret 92-1354 du 24 décembre 1992 art. 2 4° : La date du 1er janvier 1993 est différée pour certaines dispositions du présent article.*]<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   La Caisse autonome nationale de la sécurité sociale dans les mines gère les fonds énumérés ci-après :<br/>\n<br/>   1° Le Fonds national de l'assurance vieillesse et invalidité ;<br/>\n<br/>   2° Le Fonds national de l'assurance maladie, maternité et décès ;<br/>\n<br/>   3° Le Fonds national des accidents du travail et des maladies professionnelles ;<br/>\n<br/>   4° Le Fonds minier des prestations familiales ;<br/>\n<br/>   5° Le Fonds national de l'action sanitaire et sociale ;<br/>\n<br/>   6° Le Fonds national de la gestion administrative.<br/>\n<br/>   Chaque fonds doit être équilibré en recettes et en dépenses.<br/>"
  },

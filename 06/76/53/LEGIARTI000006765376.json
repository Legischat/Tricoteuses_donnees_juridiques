  "NOTA": {
    "CONTENU": "<br/>   NOTA : L'ordonnance 2000-916 du 19 septembre 2000 est entrée en vigueur au 1er janvier 2002. Elle substitue l'euro au franc.<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Désignation : pièces de 500 F en argent de qualité courante :<br/>\n<br/>   Diamètre (en millimètres) : 31.<br/>\n<br/>   Composition :<br/>\n<br/>   - titre droit : argent 900, cuivre 100.<br/>\n<br/>   - tolérance (en millièmes) : plus ou moins 5.<br/>\n<br/>   Poids :<br/>\n<br/>   - poids droit : 15 grammes.<br/>\n<br/>   - tolérance (en millièmes) : plus ou moins 10.<br/>\n<br/>   Tranche lisse.<br/>"
  }

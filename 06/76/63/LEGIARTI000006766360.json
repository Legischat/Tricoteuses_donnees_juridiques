        {
          "#text": "Décret n°84-84 du 1 février 1984 CONCERNANT L'OCTROI D'UNE INDEMNITE ANNUELLE DE DEPART ET D'UNE INDEMNITE VIAGERE DE DEPART AYANT LE CARACTERE D'UN COMPLEMENT DE RETRAITE AUX CHEFS D'EXPLOITATION AGRICOLE AGES CESSANT LEUR ACTIVITE",
          "@c_titre_court": "Décret n°84-84 du 1 février 1984",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000328141"
        },
        {
          "#text": "Décret n°84-84 du 1 février 1984 concernant l'octroi d'une indemnité annuelle de départ et d'une indemnité viagère de départ ayant le caractère d'un complément de retraite aux chefs d'exploitation agricole âgés cessant leur activité.",
          "@c_titre_court": "Décret n°84-84 du 1 février 1984",
          "@debut": "1984-02-01",
          "@fin": "2999-01-01",

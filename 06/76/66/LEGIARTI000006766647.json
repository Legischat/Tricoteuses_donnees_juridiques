  "NOTA": {
    "CONTENU": "<br/>   NOTA : L'ordonnance 2000-916 du 19 septembre 2000 est entrée en vigueur au 1er janvier 2002. Elle substitue l'euro au franc.<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Désignation : pièces de 100 F en argent de qualité épreuve.<br/>\n<br/>   Diamètre (en millimètres) : 37.<br/>\n<br/>   Composition :<br/>\n<br/>   - titre droit : argent 900, cuivre 100.<br/>\n<br/>   - tolérance (en millièmes) : plus ou moins 5.<br/>\n<br/>   Masse : 22,20 grammes.<br/>\n<br/>   - tolérance (en millièmes) : plus ou moins 6.<br/>\n<br/>   Tranche lisse.<br/>"
  }

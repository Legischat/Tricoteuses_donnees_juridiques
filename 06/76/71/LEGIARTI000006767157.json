  "BLOC_TEXTUEL": {
    "CONTENU": "Le montant de la cotisation prévue à l'article 1123, 1° a du code rural est fixé comme suit :<br/>\n ---------------------------------<br/>\n<table>\n<tr>\n<td> : REVENU CADASTRAL : MONTANT    :</td>\n</tr>\n<tr>\n<td> :      DE          : DE LA      :</td>\n</tr>\n<tr>\n<td> : L'EXPLOITATION   : COTISATION :</td>\n</tr>\n<tr>\n<td> :                  : (en        :</td>\n</tr>\n<tr>\n<td> :                  :    francs) :</td>\n</tr>\n<tr>\n<td> :------------------:------------:</td>\n</tr>\n<tr>\n<td> : Plus de 19.272 F :    1.080   :</td>\n</tr>\n<tr>\n<td> : De 7.279,01 F à  :            :</td>\n</tr>\n<tr>\n<td> : 19.272 F         :      725   :</td>\n</tr>\n<tr>\n<td> : De 3.212,01 F à  :            :</td>\n</tr>\n<tr>\n<td> : 7.279 F          :      545   :</td>\n</tr>\n<tr>\n<td> : De 1.679,01 F à  :            :</td>\n</tr>\n<tr>\n<td> : 3.212 F          :      385   :</td>\n</tr>\n<tr>\n<td> : Au plus égal à   :            :</td>\n</tr>\n<tr>\n<td> : 1.679 F          :      350   :</td>\n</tr>\n</table>\n<br/>\n ---------------------------------"

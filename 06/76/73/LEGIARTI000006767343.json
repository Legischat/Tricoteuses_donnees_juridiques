    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret n°75-725 du 6 août 1975 PORTANT SUPPRESSION DES FORCLUSIONS OPPOSABLES A L'ACCUEIL DES DEMANDES DE CERTAINS TITRES PREVUS PAR LE CODE DES PENSIONS MILITAIRES D'INVALIDITE ET DES VICTIMES DE GUERRE",
          "@c_titre_court": "Décret n°75-725 du 6 août 1975",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000875985"
        },
        {
          "#text": "Décret n°75-725 du 6 août 1975  portant suppression des forclusions opposables à l'accueil des demandes de certains titres prévus par le code des pensions militaires d'invalidité et des victimes de la guerre.",
          "@c_titre_court": "Décret n°75-725 du 6 août 1975",

  "NOTA": {
    "CONTENU": "<br/>   NOTA : L'ordonnance 2000-916 du 19 septembre 2000 est entrée en vigueur au 1er janvier 2002. Elle substitue l'euro au franc.<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Désignation : pièce de 5 F commémorative.<br/>\n<br/>   Diamètre (en millimètres) : 29.<br/>\n<br/>   Composition :<br/>\n<br/>   - couches extérieures : nickel pur.<br/>\n<br/>   - couches intérieures : cupro-nickel.<br/>\n<br/>   Masse : 10 grammes.<br/>\n<br/>   - tolérance (en millièmes) : plus ou moins 30.<br/>\n<br/>   Tranche cannelée.<br/>"
  }

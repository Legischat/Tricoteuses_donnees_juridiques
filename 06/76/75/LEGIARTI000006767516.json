        {
          "#text": "Décret n°46-1428 du 12 juin 1946 prévoyant des mesures transitoires pour l'application dans les départements du Haut-Rhin, du Bas-Rhin et de la Moselle du nouveau régime de sécurité sociale.",
          "@c_titre_court": "Décret n°46-1428 du 12 juin 1946",
          "@debut": "1946-06-14",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006060442"
        }
      ],

    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret n°84-639 du 13 juillet 1984 DETERMINANT LES MODALITES D'APPLICATION DE LA LOI 741094 DU 24-12-1974 EN CE QUI CONCERNE LA COMPENSATION INSTITUEE AU TITRE DE L'ASSURANCE MALADIE ENTRE LE REGIME GENERAL ET LE REGIME DE SECURITE SOCIALE DE LA BANQUE DE FRANCE (BDF)",
          "@c_titre_court": "Décret n°84-639 du 13 juillet 1984",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000701781"
        },
        {
          "#text": "Décret n°84-639 du 13 juillet 1984 déterminant les modalités d'application de la loi n° 74-1094 du 24 décembre 1974 en ce qui concerne la compensation instituée au titre de l'assurance maladie entre le régime général et le régime de sécurité sociale de la Banque de France.",
          "@c_titre_court": "Décret n°84-639 du 13 juillet 1984",
          "@debut": "1984-07-21",
          "@fin": "1985-12-21",
          "@id_txt": "LEGITEXT000006064566"
        }
      ],

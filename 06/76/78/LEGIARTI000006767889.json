  "NOTA": {
    "CONTENU": "<br/>   NOTA : L'ordonnance 2000-916 du 19 septembre 2000 est entrée en vigueur au 1er janvier 2002. Elle substitue l'euro au franc.<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Désignation : Pièce de 100 F d'usage courant en argent.<br/>\n<br/>   Diamètre (en millimètres) : 31.<br/>\n<br/>   Composition :<br/>\n<br/>   titre droit : argent 900, cuivre 900.<br/>\n<br/>   tolérance (en millièmes) : plus ou moins 5.<br/>\n<br/>   Masse :<br/>\n<br/>   masse (en grammes) : 15.<br/>\n<br/>   tolérance (en millièmes) : plus ou moins 20.<br/>\n<br/>   Tranche : lisse.<br/>"
  }

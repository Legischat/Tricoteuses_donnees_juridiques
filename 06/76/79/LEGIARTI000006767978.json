        {
          "#text": "Décret n°51-318 du 28 février 1951 PORTANT RAP POUR L'APPLICATION DE LA LOI 50879 DU 29-07-1950 ETENDANT L'ORDONNANCE 452454 DU 19-10-1945 AUX INVALIDES DE GUERRE, AUX VEUVES ET ORPHELINS DE GUERRE",
          "@c_titre_court": "Décret n°51-318 du 28 février 1951",
          "@debut": "2999-01-01",

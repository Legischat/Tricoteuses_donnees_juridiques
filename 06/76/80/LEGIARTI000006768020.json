    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret n°52-16 du 5 janvier 1952 RELATIF AU VERSEMENT DE LA COTISATION DE SECURITE SOCIALE A LA CHARGE DES OUVRIERS DE L'ETAT RETRAITES OU DE LEURS VEUVES, BENEFICIAIRES DES REGIMES DE SECURITE SOCIALE INSTITUES PAR LES DECRETS DU 28-06-1947 ET DU 19-02-1948",
          "@c_titre_court": "Décret n°52-16 du 5 janvier 1952",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000886280"
        },
        {
          "#text": "Décret n°52-16 du 5 janvier 1952 relatif au versement de la cotisation de sécurité sociale à la charge des ouvriers de l'Etat retraités ou de leurs veuves, bénéficiaires des régimes de sécurité sociale institués par les décrets du 28 juin 1947 et du 19 février 1948.",
          "@c_titre_court": "Décret n°52-16 du 5 janvier 1952",
          "@debut": "1952-01-06",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006060631"
        }
      ],
      "@cid": "JORFTEXT000000886280",
      "@date_publi": "1952-01-06",

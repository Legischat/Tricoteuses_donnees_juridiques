        {
          "#text": "Décret n°50-1080 du 17 août 1950 TRAVAILLEURS GARANTIS PARTIELLEMENT PAR UNE ORGANISATION SPECIALE",
          "@c_titre_court": "Décret n°50-1080 du 17 août 1950",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000489028"
        },
        {
          "#text": "Décret n°50-1080 du 17 août 1950 relatif à la situation, au regard des législations de sécurité sociale, des travailleurs exerçant simultanément une activité relevant d'une organisation spéciale et une activité accessoire relevant de l'organisation générale de la sécurité sociale",
          "@c_titre_court": "Décret n°50-1080 du 17 août 1950",
          "@debut": "1950-09-02",
          "@fin": "1985-12-21",
          "@id_txt": "LEGITEXT000006060550"
        }
      ],
      "@cid": "JORFTEXT000000489028",

          "@id_txt": "JORFTEXT000000885001"
        },
        {
          "#text": "Décret n°85-209 du 14 février 1985 relatif à l'assurance volontaire des mères de famille et des femmes chargées de famille de nationalité française résidant à l'étranger.",
          "@c_titre_court": "Décret n°85-209 du 14 février 1985",
          "@debut": "1985-01-01",
          "@fin": "1985-12-21",
          "@id_txt": "LEGITEXT000006064890"
        }

  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret n°56-511 du 24 mai 1956 AGENTS DES DEPARTEMENTS, DES COMMUNES ET DES ETABLISSEMENTS PUBLICS N'AYANT PAS LE CARACTERE INDUSTRIEL OU COMMERCIAL : MODALITES PARTICULIERES DU SERVICE DES PRESTATIONS D'ACCIDENTS DU TRAVAIL",
          "@c_titre_court": "Décret n°56-511 du 24 mai 1956",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000876657"
        },
        {
          "#text": "Décret n°56-511 du 24 mai 1956 fixant les modalités particulières du service des prestations d'accidents du travail par les départements, les communes et leurs établissements publics n'ayant pas le caractère industriel ou commercial en ce qui concerne leurs agents bénéficiaires de la loi n° 46-2426 du 30 octobre 1946 modifiée.",
          "@c_titre_court": "Décret n°56-511 du 24 mai 1956",
          "@debut": "1956-05-29",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006060772"
        }
      ],
      "@cid": "JORFTEXT000000876657",
      "@date_publi": "1956-05-29",
      "@date_signature": "1956-05-24",
      "@nature": "DECRET",
      "@num": "56-511"
    }
  },
  "VERSIONS": {
    "VERSION": [
      {
        "LIEN_ART": {
          "@debut": "1956-05-29",
          "@etat": "VIGUEUR",

        },
        {
          "#text": "Décret n°76-506 du 26 mai 1976 déterminant les modalités d'application de la loi n° 74-1094 du 24 décembre 1974 en ce qui concerne la compensation instituée au titre de l'assurance maladie entre le régime général et le régime spécial des militaires de carrière.",
          "@c_titre_court": "Décret n°76-506 du 26 mai 1976",
          "@debut": "1976-06-10",
          "@fin": "1985-12-21",
          "@id_txt": "LEGITEXT000006062501"
        }
      ],

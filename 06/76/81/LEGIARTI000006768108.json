        },
        {
          "#text": "Décret n°78-467 du 22 mars 1978 fixant les modalités d'application de la loi n° 77-1454 du 29 décembre 1977 instituant une compensation entre le régime de sécurité sociale des travailleurs salariés du commerce et de l'industrie et le régime des salariés agricoles pour les rentes de l'assurance contre les accidents du travail et les maladies professionnelles.",
          "@c_titre_court": "Décret n°78-467 du 22 mars 1978",
          "@debut": "1978-04-01",
          "@fin": "1985-12-21",
          "@id_txt": "LEGITEXT000006062876"
        }
      ],
      "@cid": "JORFTEXT000000864140",

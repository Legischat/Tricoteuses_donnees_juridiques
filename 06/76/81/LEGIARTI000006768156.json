  "NOTA": {
    "CONTENU": "<br/>   NOTA : L'ordonnance 2000-916 du 19 septembre 2000 est entrée en vigueur au 1er janvier 2002. Elle substitue l'euro au franc.<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Désignation : pièce de 100 F en or de qualité Belle Epreuve.<br/>\n<br/>   Diamètre (en millimètres) : 22.<br/>\n<br/>   Composition :<br/>\n<br/>    Titre droit : or 920, argent 40, cuivre 40.<br/>\n<br/>    Tolérance (en millièmes) : plus ou moins 3.<br/>\n<br/>   Masse :<br/>\n<br/>    Masse (en grammes) : 8,45.<br/>\n<br/>    Tolérance (en millièmes) : plus ou moins 3.<br/>\n<br/>   Tranche : lisse.<br/>"
  }

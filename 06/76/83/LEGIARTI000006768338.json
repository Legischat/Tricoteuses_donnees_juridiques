    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret n°85-38 du 10 janvier 1985 RELATIF A L'ORGANISATION DE LA SECURITE SOCIALE ET FIXANT LES MODALITES D'APPLICATION AUX CAISSES DU REGIME D'ASSURANCE MALADIE ET MATERNITE DES TRAVAILLEURS NON SALARIES DES PROFESSIONS NON AGRICOLES DES ART. 10 ET 11 DE LA LOI 842 DU 02-01-1984",
          "@c_titre_court": "Décret n°85-38 du 10 janvier 1985",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000699924"
        },
        {
          "#text": "Décret n°85-38 du 10 janvier 1985 modifiant le décret n° 60-452 du 12 mai 1960 relatif à l'organisation et au fonctionnement de la sécurité sociale, et fixant les modalités d'application aux caisses du régime d'assurance maladie et maternité des travailleurs non-salariés des professions non-agricoles des articles 10 et 11 de la loi n° 84-2 du 2 janvier 1984 portant diverses mesures d'ordre social.",
          "@c_titre_court": "Décret n°85-38 du 10 janvier 1985",
          "@debut": "1985-01-11",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006064971"
        }
      ],

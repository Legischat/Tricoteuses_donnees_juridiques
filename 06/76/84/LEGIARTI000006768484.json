        {
          "#text": "Décret n°85-293 du 1 mars 1985 PRIS POUR L'APPLICATION DES DISPOSITIONS DE LA LOI 84604 DU 13-07-1984 RELATIVES A LA GENERALISATION DE L'ACCES AUX ASSURANCES VOLONTAIRES,AU SEJOUR TEMPORAIRE EN FRANCE DES ASSURES VOLONTAIRES ET A LA PARTICIPATION DES EMPLOYEURS",
          "@c_titre_court": "Décret n°85-293 du 1 mars 1985",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000334238"
        },
        {
          "#text": "Décret n°85-293 du 1 mars 1985 pris pour l'application des dispositions de la loi n° 84-604 du 13 juillet 1984, relatives à la généralisation de l'accès aux assurances volontaires, au séjour temporaire en France des assurés volontaires et à la participation des employeurs",
          "@c_titre_court": "Décret n°85-293 du 1 mars 1985",
          "@debut": "1985-01-01",
          "@fin": "2002-04-21",
          "@id_txt": "LEGITEXT000006064934"
        }
      ],
      "TM": {

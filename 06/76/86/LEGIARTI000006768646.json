      "TITRE_TXT": [
        {
          "#text": "Décret n°80-1098 du 30 décembre 1980 PORTANT FIXATION DU MONTANT DE L'ALLOCATION VEUVAGE ET DU PLAFOND DE RESSOURCES OPPOSABLES AUX CONJOINTS SURVIVANTS,AINSI QUE DU TAUX DE LA COTISATION DE L'ASSURANCE VEUVAGE",
          "@c_titre_court": "Décret n°80-1098 du 30 décembre 1980",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000861526"
        },
        {
          "#text": "Décret n°80-1098 du 30 décembre 1980 portant fixation des montants de l'allocation de veuvage et du plafond de ressources opposables aux conjoints survivants, ainsi que du taux de la cotisation à l'assurance veuvage.",
          "@c_titre_court": "Décret n°80-1098 du 30 décembre 1980",

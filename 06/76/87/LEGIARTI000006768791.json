  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret n°85-1530 du 31 décembre 1985 MODIFIANT LE DECRET DU 17-06-1938 RELATIF A LA REORGANISATION ET A L'UNIFICATION DU REGIME D'ASSURANCE DES MARINS EN CE QUI CONCERNE L'EXONERATION DES CHARGES RESULTANT DES ART. 79 A 86 DU CODE DU TRAVAIL MARITIME ET LES EXONERATIONS DE CONTRIBUTIONS PATRONALES A LA CAISSE NATIONALE DE PREVOYANCE",
          "@c_titre_court": "Décret n°85-1530 du 31 décembre 1985",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000699011"
        },
        {
          "#text": "Décret n°85-1530 du 31 décembre 1985 modifiant le décret du 17 juin 1938 relatif à la réorganisation et à l'unification du régime d'assurance des marins en ce qui concerne l'exonération des charges résultant des articles 79 à 86 du code du travail maritime et les exonérations de contributions patronales à la caisse générale de prévoyance.",
          "@c_titre_court": "Décret n°85-1530 du 31 décembre 1985",
          "@debut": "1986-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006064859"
        }
      ],

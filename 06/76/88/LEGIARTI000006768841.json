  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret n°65-60 du 22 janvier 1965 A TITRE PROVISOIRE IL POURRA ETRE DEROGE AUX DISPOSITIONS DE L'ART. L182 (AL. 2) DU CODE DE LA SECURITE SOCIALE AINSI QU'A CELLES DES ART. 92 (PAR. 1) 154 ET 161 (PAR. 1) DU DECRET 46-1378 DU 08-06-1946 EN VUE DE SIMPLIFIER ET D'ACCELERER LES MOUVEMENTS DE FONDS ENTRE LES ORGANISMES DE LA SECURITE SOCIALE",
          "@c_titre_court": "Décret n°65-60 du 22 janvier 1965",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000303763"
        },
        {
          "#text": "Décret n°65-60 du 22 janvier 1965 autorisant des dérogations temporaires à certaines dispositions d'ordre financier du code de la sécurité sociale ainsi que du décret n° 46-1378 du 8 juin 1946.",
          "@c_titre_court": "Décret n°65-60 du 22 janvier 1965",
          "@debut": "1965-01-28",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006061286"
        }
      ],
      "@cid": "JORFTEXT000000303763",
      "@date_publi": "1965-01-28",
      "@date_signature": "1965-01-22",
      "@nature": "DECRET",
      "@num": "65-60"
    }
  },

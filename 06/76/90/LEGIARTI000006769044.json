        {
          "#text": "Décret n°86-558 du 14 mars 1986 RELATIF A L'EXTENSION A CERTAINES CATEGORIES DE CHOMEURS DE L'ALLOCATION DE LOGEMENT PREVUE AU TITRE III DU LIVRE VIII DU CODE DE LA SECURITE SOCIALE",
          "@c_titre_court": "Décret n°86-558 du 14 mars 1986",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000704110"
        },
        {
          "#text": "Décret n°86-558 du 14 mars 1986 relatif à l'extension à certaines catégories de chômeurs de l'allocation de logement prévue au titre III du livre VIII du code de logement prévue au titre III du livre VIII du code de la sécurité sociale",
          "@c_titre_court": "Décret n°86-558 du 14 mars 1986",
          "@debut": "1986-03-18",

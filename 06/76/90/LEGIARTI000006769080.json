      "TITRE_TXT": [
        {
          "#text": "Décret n°86-100 du 23 janvier 1986 FIXANT LES MODALITES D'APPLICATION DE L'ART. 78 DE LA LOI 851403 DU 30-12-1985 INSTITUANT UNE COMPENSATION SPECIFIQUE ENTRE LES REGIMES SPECIAUX D'ASSURANCE VIEILLESSE",
          "@c_titre_court": "Décret n°86-100 du 23 janvier 1986",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000683018"
        },
        {
          "#text": "Décret n°86-100 du 23 janvier 1986 fixant les modalités d'application de l'article 78 de la loi n° 85-1403 du 30 décembre 1985 instituant une compensation spécifique entre les régimes spéciaux d'assurance vieillesse.",
          "@c_titre_court": "Décret n°86-100 du 23 janvier 1986",

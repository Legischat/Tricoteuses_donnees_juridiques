      "TITRE_TXT": [
        {
          "#text": "Décret n°86-150 du 30 janvier 1986 RELATIF A LA REVALORISATION DE LA BASE MENSUELLE DE CALCUL DES ALLOCATIONS FAMILIALES A COMPTER DU 01-01-1986 ET A COMPTER DU 01-07-1986 ET PORTANT MODIFICATION DES TAUX DE CALCUL DES ALLOCATIONS FAMILIALES DES FAMILLES NOMBREUSES ET DE L'ALLOCATION PARENTALE D'EDUCATION DU 01-01-1986",
          "@c_titre_court": "Décret n°86-150 du 30 janvier 1986",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000518125"
        },
        {
          "#text": "Décret n°86-150 du 30 janvier 1986 relatif à la revalorisation de la base mensuelle de calcul *assiette* des allocations familiales à compter du 1er janvier 1986 et à compter du 1er juillet 1986 et portant modification des taux de calcul des allocations familiales des familles nombreuses et de l'allocation parentale d'éducation au 1er janvier 1986.",
          "@c_titre_court": "Décret n°86-150 du 30 janvier 1986",
          "@debut": "1986-02-02",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006065389"

  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret n°86-596 du 14 mars 1986 RELATIF AU FINANCEMENT DU REGIME DE PROTECTION SOCIALE DES PERSONNES NON SALARIEES DES PROFESSIONS AGRICOLES POUR 1986 AINSI QU'A CERTAINES DISPOSITIONS D'ORDRE PERMANENT",
          "@c_titre_court": "Décret n°86-596 du 14 mars 1986",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000522584"
        },
        {
          "#text": "Décret n°86-596 du 14 mars 1986 relatif au financement du régime de protection sociale des personnes non-salariées des professions agricoles pour 1986, ainsi qu'à certaines dispositions d'ordre permanent",
          "@c_titre_court": "Décret n°86-596 du 14 mars 1986",
          "@debut": "1986-03-19",
          "@fin": "2005-04-22",
          "@id_txt": "LEGITEXT000006065607"
        }
      ],
      "TM": {
        "TITRE_TM": [
          {
            "#text": "CHAPITRE IV : Dispositions permanentes.",

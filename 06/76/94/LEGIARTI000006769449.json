  "NOTA": {
    "CONTENU": "<br/>   [*Nota : Décret 86-783 du 27 juin 1986 art. 3 : champ d'application de l'art. 2.*]<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<p>A la place du taux annuel de majoration ou de revalorisation mentionné à l'article R. 481-10 du code de la sécurité sociale, on retiendra pour l'application au 1er janvier 1987 de l'article R. 481-11 du même code le taux résultant de la majoration ou de la revalorisation de 1,1% qui a prix effet au 1er janvier 1986.</p>\n<br/>\n<br/>"
  },

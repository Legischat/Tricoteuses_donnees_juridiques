  "NOTA": {
    "CONTENU": "<br/>[  Décret 86-1100 du 9 octobre 1986 art. 4 : champ d'application.<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<p>A la place du taux annuel de majoration ou de revalorisation mentionné à l'article R. 481-10 du code de la sécurité sociale, on retiendra, pour l'application au 1er janvier 1987 de l'article R. 481-11 du même code, le taux résultant de la majoration ou de la revalorisation de 1,1 p. 100 qui a pris effet au 1er janvier 1986 et de la majoration ou revalorisation qui prendra effet au 1er octobre 1986.</p>\n<br/>\n<br/>"
  },

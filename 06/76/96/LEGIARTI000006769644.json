      "TITRE_TXT": [
        {
          "#text": "Décret n°86-1182 du 5 novembre 1986 FIXANT LE MONTANT DU SALAIRE PREVU AUX ART. L19 (DERNIER AL.),L20 (AL. 5),L54 (AL. 6) ET L57 (AL. 1) DU CODE DES PENSIONS MILITAIRES D'INVALIDITE ET DES VICTIMES DE GUERRE CONCERNANT LES ENFANTS ET ORPHELINS ATTEINTS D'UNE INFIRMITE INCURABLE",
          "@c_titre_court": "Décret n°86-1182 du 5 novembre 1986",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000867118"
        },
        {
          "#text": "Décret n°86-1182 du 5 novembre 1986 fixant le montant du salaire prévu aux articles L. 19, L. 20, L. 54 et L. 57 du code des pensions militaires d'invalidité et des victimes de guerre concernant les enfants et orphelins atteints d'une infirmité incurable",
          "@c_titre_court": "Décret n°86-1182 du 5 novembre 1986",
          "@debut": "1986-11-11",
          "@fin": "2999-01-01",

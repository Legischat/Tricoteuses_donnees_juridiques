      "TITRE_TXT": [
        {
          "#text": "Décret n°79-707 du 8 août 1979 MODALITES D'APPLICATION DE L'ART. 1143-2 DU CODE RURAL ET RELATIF AUX PROCEDURES DE RECOUVREMENT DES COTISATIONS ET DES REMBOURSEMENTS DUS AU TITRE DES REGIMES DE PROTECTION SOCIALE AGRICOLE.(CONTRAINTE,OPPOSITION ENTRE LES MAINS DE TIERS DETENTEURS,PROCEDURE SOMMAIRE)",
          "@c_titre_court": "Décret n°79-707 du 8 août 1979",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000518856"
        },
        {
          "#text": "Décret n°79-707 du 8 août 1979 fixant les modalités d'application des articles 1143-2 et 1143-8 du code rural et relatif aux procédures de recouvrement des cotisations, des majorations et pénalités de retard et des remboursements dus au titre des régimes de protection sociale agricole",
          "@c_titre_court": "Décret n°79-707 du 8 août 1979",
          "@debut": "2000-01-01",

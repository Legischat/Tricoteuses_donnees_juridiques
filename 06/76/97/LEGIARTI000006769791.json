        {
          "#text": "Décret n°72-154 du 24 février 1972 RELATIF AUX CONGES EN CAS DE MALADIE, DE MATERNITE ET D'ACCIDENTS DU TRAVAIL DONT PEUVENT BENEFICIER CERTAINS PERSONNELS OUVRIERS DE L'ETAT MENSUALISES",
          "@c_titre_court": "Décret n°72-154 du 24 février 1972",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000510954"
        },
        {
          "#text": "Décret n°72-154 du 24 février 1972 relatif aux congés en cas de maladie, de maternité et d'accidents du travail dont peuvent bénéficier certains personnels ouvriers de l'Etat mensualisés.",
          "@c_titre_court": "Décret n°72-154 du 24 février 1972",
          "@debut": "1972-02-28",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006061905"
        }
      ],

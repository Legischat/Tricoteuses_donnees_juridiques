        {
          "#text": "Décret n°76-1282 du 29 décembre 1976 RELATIF AU RECOUVREMENT PAR LES CAISSES DE MUTUALITE SOCIALE AGRICOLE DES COTISATIONS ASSISES SUR LES SALAIRES",
          "@c_titre_court": "Décret n°76-1282 du 29 décembre 1976",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000853345"
        },
        {
          "#text": "Décret n°76-1282 du 29 décembre 1976 relatif au recouvrement par les caisses de mutualité sociale agricole des cotisations assises sur les salaires",
          "@c_titre_court": "Décret n°76-1282 du 29 décembre 1976",
          "@debut": "1976-12-31",

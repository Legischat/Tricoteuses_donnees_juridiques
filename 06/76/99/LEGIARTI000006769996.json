      "TITRE_TXT": [
        {
          "#text": "Décret n°87-85 du 9 février 1987 RELATIF A LA PERIODICITE,AU RECOUVREMENT DES COTISATIONS ET AUX MAJORATIONS DE RETARD,AINSI QU'A LA MODIFICATION DE CERTAINES DISPOSITIONS DU REGIME DE PROTECTION SOCIALE DES PERSONNES NON SALARIEES AGRICOLES DANS LES DEPARTEMENTS D'OUTRE-MER",
          "@c_titre_court": "Décret n°87-85 du 9 février 1987",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000333181"
        },
        {
          "#text": "Décret n°87-85 du 9 février 1987 relatif à la périodicité, au recouvrement des cotisations et aux majorations de retard ainsi qu'à la modification de certaines dispositions du régime de protection sociale des personnes non-salariées agricoles dans les départements d'outre-mer",
          "@c_titre_court": "Décret n°87-85 du 9 février 1987",
          "@debut": "1987-02-11",
          "@fin": "2005-04-22",

      "TITRE_TXT": [
        {
          "#text": "Décret n°70-380 du 4 mai 1970 PRIS POUR L'APPLICATION DE LA LOI 67558 DU 12-07-1967 RELATIVE A L'EXTENSION AUX DOM DES ASSURANCES MALADIE, INVALIDITE ET MATERNITE DES EXPLOITANTS AGRICOLES ET DES MEMBRES NON SALARIES DE LEUR FAMILLE",
          "@c_titre_court": "Décret n°70-380 du 4 mai 1970",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000303810"
        },
        {
          "#text": "Décret n°70-380 du 4 mai 1970 pour l'application de la loi n° 67-558 du 12 juillet 1967 portant extension aux départements d'outre-mer des assurances maladie, invalidité, maternité des exploitants agricoles et des membres non-salariés de leur famille.",
          "@c_titre_court": "Décret n°70-380 du 4 mai 1970",
          "@debut": "1970-05-06",
          "@fin": "2005-04-22",
          "@id_txt": "LEGITEXT000006061744"

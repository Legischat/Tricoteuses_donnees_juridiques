      "TITRE_TXT": [
        {
          "#text": "Décret n°87-664 du 13 août 1987 PORTANT MAJORATION EXCEPTIONNELLE POUR 1987 DES COTISATIONS D'ASSURANCE MALADIE,INVALIDITE ET MATERNITE AINSI QUE DES COTISATIONS D'ASSURANCE VIEILLESSE DU REGIME DE PROTECTION SOCIALE DES PERSONNES NON SALARIEES",
          "@c_titre_court": "Décret n°87-664 du 13 août 1987",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000333672"
        },
        {
          "#text": "Décret n°87-664 du 13 août 1987 portant majoration exceptionnelle pour 1987 des cotisations d'assurance maladie, invalidité et maternité ainsi que des cotisations d'assurance vieillesse du régime de protection sociale des personnes non-salariées des professions agricoles",
          "@c_titre_court": "Décret n°87-664 du 13 août 1987",
          "@debut": "1987-08-14",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006066120"

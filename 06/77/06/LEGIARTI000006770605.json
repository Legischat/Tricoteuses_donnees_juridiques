      "TITRE_TXT": [
        {
          "#text": "Décret n°79-535 du 3 juillet 1979 RELATIF A L'ASSURANCE VIEILLESSE DES MERES DE FAMILLE ET DES FEMMES RESIDANT DANS LES DEPARTEMENTS D'OUTRE-MER, QUI ONT LA CHARGE D'UN ENFANT HANDICAPE OU D'UN ADULTE HANDICAPE",
          "@c_titre_court": "Décret n°79-535 du 3 juillet 1979",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000516653"
        },
        {
          "#text": "Décret n°79-535 du 3 juillet 1979 relatif à l'assurance vieillesse des mères de famille et des femmes résidant dans les départements d'outre-mer, qui ont la charge d'un enfant handicapé ou d'un adulte handicapé.",
          "@c_titre_court": "Décret n°79-535 du 3 juillet 1979",
          "@debut": "1978-07-01",
          "@fin": "1985-12-21",
          "@id_txt": "LEGITEXT000006063064"
        }
      ],
      "@cid": "JORFTEXT000000516653",

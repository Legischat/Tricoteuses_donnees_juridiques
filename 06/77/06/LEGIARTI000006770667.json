      "TITRE_TXT": [
        {
          "#text": "Décret n°60-58 du 11 janvier 1960 RELATIF AU REGIME DE SECURITE SOCIALE DES AGENTS PERMANENTS DES DEPARTEMENTS,COMMUNES ET DE LEURS ETABLISSEMENTS PUBLICS N'AYANT PAS LE CARACTERE INDUSTRIEL OU COMMERCIAL",
          "@c_titre_court": "Décret n°60-58 du 11 janvier 1960",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000874302"
        },
        {
          "#text": "Décret n°60-58 du 11 janvier 1960 relatif au régime de sécurité sociale des agents permanents des départements, des communes et de leurs établissements publics n'ayant pas le caractère industriel ou commercial",
          "@c_titre_court": "Décret n°60-58 du 11 janvier 1960",
          "@debut": "1960-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006060971"
        }
      ],

  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret n°88-113 du 3 février 1988 PORTANT CREATION D'UN FONDS D'ACTION SOCIALE A LA CAISSE AUTONOME MUTUELLE DE RETRAITES DES AGENTS DES CHEMINS DE FER SECONDAIRES D'INTERET GENERAL,DES CHEMINS DE FER D'INTERET LOCAL ET DES TRAMWAYS (CAMR)",
          "@c_titre_court": "Décret n°88-113 du 3 février 1988",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000501175"
        },
        {
          "#text": "Décret n°88-113 du 3 février 1988 portant création d'un fonds d'action sociale à la caisse autonome mutuelle de retraites des agents des chemins de fer secondaires d'intérêt général, des chemins de fer d'intérêt local et des tramways",
          "@c_titre_court": "Décret n°88-113 du 3 février 1988",
          "@debut": "1988-02-04",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006066352"
        }
      ],
      "@cid": "JORFTEXT000000501175",
      "@date_publi": "1988-02-04",
      "@date_signature": "1988-02-03",
      "@nature": "DECRET",
      "@nor": "TRST8700286D",
      "@num": "88-113"
    }
  },

        {
          "#text": "Décret n°80-928 du 24 novembre 1980 pris pour l'application des dispositions de l'article 1003-7-1-III du code rural relatives aux conditions de maintien de certaines personnes aux régimes de protection sociale des membres non salariés des professions agricoles",
          "@c_titre_court": "Décret n°80-928 du 24 novembre 1980",
          "@debut": "1981-01-01",
          "@fin": "2005-04-22",
          "@id_txt": "LEGITEXT000006063358"
        }
      ],
      "@cid": "JORFTEXT000000503709",

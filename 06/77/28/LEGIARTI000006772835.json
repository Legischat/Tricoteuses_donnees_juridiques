    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret n°76-554 du 17 juin 1976 RELATIF AUX INDEMNITES ET VACATIONS SUSCEPTIBLES D'ETRE ALLOUEES AUX FONCTIONNAIRES RETRAITES APPELES A ASSURER LE SECRETARIAT DES COMMISSIONS DE PREMIERE INSTANCE DU CONTENTIEUX GENERAL DE LA SECURITE SOCIALE",
          "@c_titre_court": "Décret n°76-554 du 17 juin 1976",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000856064"
        },
        {
          "#text": "Décret n°76-554 du 17 juin 1976 relatif aux indemnités et vacations susceptibles d'être allouées aux fonctionnaires retraités appelés à assurer le secrétariat des commissions de première instance du contentieux général de la sécurité sociale.",
          "@c_titre_court": "Décret n°76-554 du 17 juin 1976",
          "@debut": "1974-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006062504"
        }
      ],
      "@cid": "JORFTEXT000000856064",
      "@date_publi": "1976-06-26",
      "@date_signature": "1976-06-17",
      "@nature": "DECRET",
      "@num": "76-554"
    }
  },

        {
          "#text": "Décret n°76-992 du 2 novembre 1976 relatif à l'application de la législation sur les accidents du travail agricole aux élèves des établissements d'enseignement technique et de formation professionnelle agricoles du Haut-Rhin, du Bas-Rhin et de la Moselle.",
          "@c_titre_court": "Décret n°76-992 du 2 novembre 1976",
          "@debut": "1976-11-01",
          "@fin": "2005-04-22",
          "@id_txt": "LEGITEXT000006062550"
        }
      ],
      "@cid": "JORFTEXT000000307556",
      "@date_publi": "1976-11-03",

      "TITRE_TXT": [
        {
          "#text": "Décret n°65-746 du 2 septembre 1965 PORTANT APPLICATION DES DISPOSITIONS DE LA LOI 641330 DU 26-12-1964 AUX TRAVAILLEURS NON SALARIES AFFILIES AU REGIME D'ASSURANCE VIEILLESSE PREVU PAR LE TITRE III DE L'ARRETE DU MINISTRE DE L'ALGERIE EN DATE DU 30-12-1957",
          "@c_titre_court": "Décret n°65-746 du 2 septembre 1965",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000849722"
        },
        {
          "#text": "Décret n°65-746 du 2 septembre 1965 portant application des dispositions de la loi n° 64-1330 du 26 décembre 1964 aux travailleurs non salariés affiliés au régime d'assurance vieillesse prévu par le titre III de l'arrêté du ministre de l'Algérie en date du 30 décembre 1957.",
          "@c_titre_court": "Décret n°65-746 du 2 septembre 1965",

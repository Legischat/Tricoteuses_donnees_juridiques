  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret n°65-744 du 2 septembre 1965 PORTANT APPLICATION DES DISPOSITIONS DE LA LOI 641330 DU 26-12-1964 AUX TRAVAILLEURS NON SALARIES DONT L'ACTIVITE PROFESSIONNELLE RELEVAIT DU REGIME D'ASSURANCE VIEILLESSE DES PROFESSIONS ARTISANALES PREVU PAR L'ART. 1ER DE L'ARRETE DU MINISTRE DE L'ALGERIE EN DATE DU 30-12-1957",
          "@c_titre_court": "Décret n°65-744 du 2 septembre 1965",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000849487"
        },
        {
          "#text": "Décret n°65-744 du 2 septembre 1965 portant application des dispositions de la loi n° 64-1330 du 26 décembre 1964 aux travailleurs non salariés dont l'activité professionnelle relevait du régime d'assurance vieillesse des professions artisanales prévu par l'article 1er de l'arrêté du ministre de l'Algérie en date du 30 décembre 1957.",
          "@c_titre_court": "Décret n°65-744 du 2 septembre 1965",
          "@debut": "1965-09-04",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006061301"
        }
      ],
      "@cid": "JORFTEXT000000849487",
      "@date_publi": "1965-09-04",
      "@date_signature": "1965-09-02",
      "@nature": "DECRET",
      "@num": "65-744"
    }
  },

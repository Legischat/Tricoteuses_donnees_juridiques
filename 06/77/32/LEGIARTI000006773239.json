          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000317886"
        },
        {
          "#text": "Décret n°51-721 du 8 juin 1951 portant règlement d'administration publique pour l'application de la loi du 12 juillet 1937 instituant une caisse de retraite et de prévoyance des clercs et employés de notaires",
          "@c_titre_court": "Décret n°51-721 du 8 juin 1951",

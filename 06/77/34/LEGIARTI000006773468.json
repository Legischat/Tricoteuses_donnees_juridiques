  "NOTA": {
    "CONTENU": "<br/>   [*Nota : décret 89-39 du 26 janvier 1989 art. 14 : les dispositions du présent décret sont applicables aux départements d'outre-mer (DOM).*]<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   A défaut d'intervention avant le 15 février 1989 [*date limite*] des décisions conjointes du préfet et du président du conseil général mentionnées aux articles 1er et 2, il sera fait application des dispositions de l'article 39 de la loi du 1er décembre 1988 susvisée.<br/>\n<br/>"
  },

        {
          "#text": "Décret n°88-1115 du 12 décembre 1988 RELATIF A L'ORGANISATION DU MANDATEMENT DE L'ALLOCATION DE REVENU MINIMUM D'INSERTION A UN ORGANISME AGREE POUR SON REVERSEMENT AU BENEFICIAIRE",
          "@c_titre_court": "Décret n°88-1115 du 12 décembre 1988",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000312644"
        },
        {
          "#text": "Décret n°88-1115 du 12 décembre 1988 relatif à l'organisation du mandatement de l'allocation de revenu minimum d'insertion à un organisme agréé pour son reversement au bénéficiaire",
          "@c_titre_court": "Décret n°88-1115 du 12 décembre 1988",
          "@debut": "1988-12-13",
          "@fin": "2004-10-26",
          "@id_txt": "LEGITEXT000006066345"
        }
      ],
      "TM": {

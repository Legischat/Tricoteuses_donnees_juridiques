  "NOTA": {
    "CONTENU": "<br/>   [*NOTA : Décret 50-1225 du 21 septembre 1950 art. 67 :<br/>\n Dérogation.*]<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   A titre transitoire, la durée de quinze années d'assurance [*délai*] prévue au dernier alinéa du paragraphe 1er de l'article 8 modifié ci-dessus du décret du 30 octobre 1935 est réduite :<br/>\n<br/>   A treize ans si l'entrée en jouissance de la pension est fixée à une date antérieure au 1er janvier 1953 ;<br/>\n<br/>   A quatorze ans si l'entrée en jouissance de la pension est fixée à une date postérieure au 31 décembre 1952 et antérieure au 1er janvier 1955.<br/>"
  },

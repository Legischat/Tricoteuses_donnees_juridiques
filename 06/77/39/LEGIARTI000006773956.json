  "NOTA": {
    "CONTENU": "<br/>   [*Nota - Décret 90-161 du 19 février 1990 art. 1 : le titre II du décret du 21 septembre 1950 est remplacé, pour l'application des dispositions de l'article 1038 du code rural aux salariés agricoles concernés, par les présentes dispositions.*]<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Pour l'application des articles R. 351-6, R. 351-7, R. 351-25, R. 351-27, R. 351-32, R. 351-37-3, R. 351-37-4, R. 351-37-8 et R. 356-7 du code de la sécurité sociale aux salariés agricoles, la référence au \" régime des assurances sociales agricoles \" est substituée à la référence au \" régime général de sécurité sociale \" ou au \" régime général \".<br/>\n<br/>"
  },

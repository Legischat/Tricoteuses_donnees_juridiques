  "NOTA": {
    "CONTENU": "<br/>   [*Nota : décret 89-40 du 26 janvier 1989 art. 17 : les dispositions du présent décret sont applicables aux départements d'outre-mer (DOM).*]<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Il est fait application des dispositions de l'article 39 de la loi du 1er décembre 1988 susvisée :<br/>\n<br/>   1° Si la décision conjointe du préfet et du président du conseil général mentionnée à l'article 2 n'est pas intervenue avant le 1er mars 1989 ;<br/>\n<br/>   2° Si le programme pour l'année 1989 n'est pas arrêté avant le 31 mai 1989.<br/>"
  },

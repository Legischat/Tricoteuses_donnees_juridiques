  "NOTA": {
    "CONTENU": "<br/>   [*Nota : décret 89-73 du 3 février 1989 art. 8 : les dispositions du présent décret sont applicables aux départements d'outre-mer.*]<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les fonctions prévues ci-dessus sont exercées à titre gratuit.<br/>\n<br/>   Aucun paiement ni aucun remboursement ne peut être exigé du demandeur, à quelque titre que ce soit, par l'organisme à l'occasion de l'exercice de ses fonctions.<br/>"
  },

      "TITRE_TXT": [
        {
          "#text": "Décret n°89-341 du 29 mai 1989 CONCERNANT L'OCTROI D'UNE INDEMNITE ANNUELLE D'ATTENTE AU PROFIT DE CERTAINES CATEGORIES D'AGRICULTEURS APPELES A CESSER LEUR ACTIVITE",
          "@c_titre_court": "Décret n°89-341 du 29 mai 1989",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000885251"
        },
        {
          "#text": "Décret n°89-341 du 29 mai 1989 concernant l'octroi d'une indemnité annuelle d'attente au profit de certaines catégories d'agriculteurs appelés à cesser leur activité",
          "@c_titre_court": "Décret n°89-341 du 29 mai 1989",
          "@debut": "1989-05-30",

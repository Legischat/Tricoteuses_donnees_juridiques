      "TITRE_TXT": [
        {
          "#text": "Décret n°80-269 du 14 avril 1980 FIXANT LES TAUX ET LES MODALITES DE RECOUVREMENT DES CONTRIBUTIONS EXCEPTIONNELLES ET UNIQUES PERCUES AU PROFIT DE L'ASSURANCE MALADIE DU REGIME GENERAL DE LA SECURITE SOCIALE ET A LA CHARGE DES PHARMACIENS D'OFFICINE ET DES ENTREPRISES EXPLOITANTS DES SPECIALITES PHARMACEUTIQUES REMBOURSABLES",
          "@c_titre_court": "Décret n°80-269 du 14 avril 1980",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000338154"
        },
        {
          "#text": "Décret n°80-269 du 14 avril 1980 fixant les taux et les modalités de recouvrement des contributions exceptionnelles et uniques perçues au profit de l'assurance maladie du régime général de la sécurité sociale et à la charge des pharmaciens d'officine et des entreprises exploitant des spécialités pharmaceutiques remboursables.",
          "@c_titre_court": "Décret n°80-269 du 14 avril 1980",
          "@debut": "1980-04-15",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006063219"
        }
      ],

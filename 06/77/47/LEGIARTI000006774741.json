    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret n°89-944 du 22 décembre 1989 MODIFIANT LE DECRET 851144 DU 30-10-1985 RELATIF A L'AMELIORATION MATERIELLE DE L'EXPLOITATION AGRICOLE ET PORTANT MODIFICATION DU DECRET DU 01-02-1984 CONCERNANT L'OCTROI D'UNE INDEMNITE ANNUELLE DE DEPART AYANT LE CARACTERE D'UN COMPLEMENT DE RETRAITE AUX CHEFS D'EXPLOITATION AGRICOLE AGES CESSANT LEUR ACTIVITE",
          "@c_titre_court": "Décret n°89-944 du 22 décembre 1989",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000698441"
        },
        {
          "#text": "Décret n°89-944 du 22 décembre 1989 modifiant le décret n° 85-1144 du 30 octobre 1985 relatif à l'amélioration matérielle de l'exploitation agricole et portant modification du décret du 1er février 1984 concernant l'octroi d'une indemnité annuelle de départ ayant le caractère d'un complément de retraite aux chefs d'exploitation agricole âgés cessant leur activité",
          "@c_titre_court": "Décret n°89-944 du 22 décembre 1989",

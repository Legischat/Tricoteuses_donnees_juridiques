      "TITRE_TXT": [
        {
          "#text": "Décret n°89-245 du 13 avril 1989 fixant à compter du 1er janvier 1989 le montant du salaire prévu aux articles L. 19, L. 20, L. 54 et L. 57 du code des pensions militaires d'invalidité et des victimes de la guerre concernant les enfants et orphelins atteints d'une infirmité incurable",
          "@c_titre_court": "Décret n°89-245 du 13 avril 1989",

      "TITRE_TXT": [
        {
          "#text": "Décret n°88-182 du 18 février 1988 FIXANT LE MONTANT DU SALAIRE PREVU AUX ART. L19,L20,L54 ET L57 DU CODE DES PENSIONS MILITAIRES D'INVALIDITE ET DES VICTIMES DE LA GUERRE CONCERNANT LES ENFANTS ET ORPHELINS ATTEINTS D'UNE INFIRMITE INCURABLE",
          "@c_titre_court": "Décret n°88-182 du 18 février 1988",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000315017"
        },
        {
          "#text": "Décret n°88-182 du 18 février 1988 fixant le montant du salaire prévu aux articles L. 19, L. 20, L. 54 et L. 57 du code des pensions militaires d'invalidité et des victimes de la guerre concernant les enfants et orphelins atteints d'une infirmité incurable",
          "@c_titre_court": "Décret n°88-182 du 18 février 1988",

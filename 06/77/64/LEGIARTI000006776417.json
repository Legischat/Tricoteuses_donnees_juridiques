  "NOTA": {
    "CONTENU": "<br/>   [*Nota :Décret 92-187 du 27 février 1992 art. 25, art. 27 : champ d'application.*]<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les terres exploitées en faire-valoir direct et libérées peuvent également :<br/>\n<br/>   1° Etre affectées au boisement, en cas d'impossibilité de reprise pour un usage agricole, dans les conditions du décret du 6 décembre 1991 susvisé ;<br/>\n<br/>   2° Etre apportées à un groupement forestier ou incluses dans le périmètre d'une association foncière pastorale ou d'une association foncière agricole donnant à bail.<br/>"
  },

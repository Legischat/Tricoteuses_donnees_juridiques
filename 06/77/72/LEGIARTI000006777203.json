      "TITRE_TXT": [
        {
          "#text": "Décret n°93-1216 du 4 novembre 1993 RELATIF AU GUIDE-BAREME APPLICABLE POUR L'ATTRIBUTION DE DIVERSES PRESTATIONS AUX PERSONNES HANDICAPEES ET MODIFIANT LE CODE DE LA FAMILLE ET DE L'AIDE SOCIALE,LE CODE DE LA SECURITE SOCIALE (DEUXIEME PARTIE: DECRETS EN CONSEIL D'ETAT) ET LE DECRET 771549 DU 31-12-1977",
          "@c_titre_court": "Décret n°93-1216 du 4 novembre 1993",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000517921"
        },
        {
          "#text": "Décret n°93-1216 du 4 novembre 1993 relatif au guide-barème applicable pour l'attribution de diverses prestations aux personnes handicapées et modifiant le code de la famille et de l'aide sociale, le code de la sécurité sociale (deuxième partie : Décrets en Conseil d'Etat) et le décret n° 77-1549 du 31 décembre 1977.",
          "@c_titre_court": "Décret n°93-1216 du 4 novembre 1993",
          "@debut": "1993-12-01",
          "@fin": "2004-10-26",

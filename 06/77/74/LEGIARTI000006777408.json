      "TITRE_TXT": [
        {
          "#text": "Décret no 94-690 du 9 août 1994 relatif au calcul des cotisations sociales    dues au régime de protection sociale des personnes non salariées des    professions agricoles et assises sur les revenus mentionnés à l'article    1003-12 du code rural",
          "@c_titre_court": "Décret n°94-690 du 9 août 1994",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000530688"
        },
        {
          "#text": "Décret n°94-690 du 9 août 1994 relatif au calcul des cotisations sociales dues au régime de protection sociale des personnes non salariées des professions agricoles et assises sur les revenus mentionnés à l'article 1003-12 du code rural",
          "@c_titre_court": "Décret n°94-690 du 9 août 1994",

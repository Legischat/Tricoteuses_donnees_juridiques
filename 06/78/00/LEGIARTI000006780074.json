      "TITRE_TXT": [
        {
          "#text": "Décret n°68-30 du 3 janvier 1968 SUPPRIMANT LE COMITE DE BOURSE DE VALEURS ET FIXANT LES ATTRIBUTIONS DE LA COMMISSION DES OPERATIONS DE BOURSES (COB) INSTITUEE PAR L'ORDONNANCE 67833 DU 28-09-1967",
          "@c_titre_court": "Décret n°68-30 du 3 janvier 1968",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000335856"
        },
        {
          "#text": "Décret n°68-30 du 3 janvier 1968 supprimant le comité des bourses de valeurs et fixant certaines attributions de la commission des opérations de bourse instituée par l'ordonnance n° 67-833 du 28 septembre 1967",
          "@c_titre_court": "Décret n°68-30 du 3 janvier 1968",
          "@debut": "1968-01-13",
          "@fin": "2003-11-23",
          "@id_txt": "LEGITEXT000006061536"
        }
      ],
      "@cid": "JORFTEXT000000335856",

        {
          "#text": "Arrêté du 13 juillet 1978 MODALITES DE LIQUIDATION ET D'IMPUTATION DES COTISATIONS D'ASSURANCE VIEILLESSE DES MERES ET DES FEMMES AYANT AU FOYER UN HANDICAPE",
          "@c_titre_court": "Arrêté du 13 juillet 1978",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000285684"
        },
        {
          "#text": "Arrêté du 13 juillet 1978 relatif aux modalités de liquidation et d'imputation des cotisations d'assurance vieillesse des mères et des femmes ayant au foyer un handicapé.",
          "@c_titre_court": "Arrêté du 13 juillet 1978",

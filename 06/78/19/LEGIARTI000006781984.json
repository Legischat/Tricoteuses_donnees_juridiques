  "NOTA": {
    "CONTENU": "<br/>   [*Nota : Arrêté du 28 décembre 1987 article 1 : dispositions applicables aux sportifs professionnels.*]<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Des arrêtés du ministre chargé de la sécurité sociale et du ministre chargé de l'économie et des finances fixent les conditions particulières d'application du présent arrêté aux risques professionnels des dockers maritimes, des industries du bâtiment et des travaux publics et des sportifs professionnels.<br/>\n<br/>"
  },

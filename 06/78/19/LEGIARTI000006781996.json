    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Arrêté du 16 décembre 1976  FIXANT LA COTISATION DUE POUR L'ALIMENTATION DU FONDS COMMUN VISE A L'ARTICLE L. 491 DU CODE DE LA SECURITE SOCIALE *FINANCEMENT*, PAR LES ETABLISSEMENTS OU COLLECTIVITES GERANT LA TOTALITE DU RISQUE \"ACCIDENTS DU TRAVAIL\".",
          "@c_titre_court": "Arrêté du 16 décembre 1976",
          "@debut": "1976-12-26",
          "@fin": "1982-12-29",
          "@id_txt": "LEGITEXT000006073460"
        }

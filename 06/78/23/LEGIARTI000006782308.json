        {
          "#text": "Arrêté du 8 août 1966  PORTANT APPLICATION DE L'ARTICLE 15 DU DECRET N° 66-104 DU 18 FEVRIER 1966, CONTROLE DE LA FREQUENTATION ET DE L'ASSIDUITE SCOLAIRE ET SANCTIONS QUE COMPORTENT, AU REGARD DU VERSEMENT DES PRESTATIONS FAMILIALES, LES MANQUEMENTS A L'OBLIGATION SCOLAIRE DES ENFANTS SANS DOMICILE FIXE.",
          "@c_titre_court": "Arrêté du 8 août 1966",
          "@debut": "1966-08-19",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006073487"
        }
      ],

      "TITRE_TXT": [
        {
          "#text": "Arrêté du 3 février 1976  RELATIF AUX MODALITES DE FINANCEMENT DES PRETS AUX JEUNES MENAGES ACCORDES PAR LES CAISSES D'ALLOCATIONS FAMILIALES ET LES UNIONS REGIONALES DE SOCIETES DE SECOURS MINIERES.",
          "@c_titre_court": "Arrêté du 3 février 1976",
          "@debut": "1976-02-05",
          "@fin": "1993-02-06",
          "@id_txt": "LEGITEXT000006073493"
        }
      ],

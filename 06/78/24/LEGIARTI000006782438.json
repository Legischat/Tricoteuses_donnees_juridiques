      "TITRE_TXT": [
        {
          "#text": "Arrêté du 13 août 1982  DU 13 AOUT 1982 FIXANT LES PLAFONDS DE LOYERS A PRENDRE EN CONSIDERATION POUR LE CALCUL DE L'ALLOCATION DE LOGEMENT AUX PERSONNES AGEES, AUX INFIRMES ET AUX JEUNES TRAVAILLEURS.",
          "@c_titre_court": "Arrêté du 13 août 1982",
          "@debut": "1982-07-01",
          "@fin": "2007-09-01",
          "@id_txt": "LEGITEXT000006073505"
        }
      ],
      "@cid": "LEGITEXT000006073505",

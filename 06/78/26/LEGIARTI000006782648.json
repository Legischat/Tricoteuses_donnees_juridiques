  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les salaires forfaitaires servant de base au calcul [*assiette*] des contributions des armateurs, des cotisations et des pensions des marins du commerce, de la pêche et de la plaisance sont modifiés en application de l'article L. 42 du code des pensions de retraite des marins, et pour compter du 1er novembre 1983, conformément au tableau ci-après :<br/>\n<br/>\n<br/>\n ========================================<br/>\n<table>\n<tr>\n<td> :      :     SALAIRES FORFAITAIRES     :</td>\n</tr>\n<tr>\n<td> :      :      (base de calcul des      :</td>\n</tr>\n<tr>\n<td> :      :  contributions, cotisations   :</td>\n</tr>\n<tr>\n<td> :      :          et pensions)         :</td>\n</tr>\n<tr>\n<td> :      :-------------------------------:</td>\n</tr>\n<tr>\n<td> :      :     Par an     :   Par mois   :</td>\n</tr>\n<tr>\n<td> :      :----------------:--------------:</td>\n</tr>\n<tr>\n<td> :      :     Francs     :    Francs    :</td>\n</tr>\n<tr>\n<td> :      :                :              :</td>\n</tr>\n<tr>\n<td> :  1   :    37.172,89   :    3.097,74  :</td>\n</tr>\n<tr>\n<td> :  2   :    48.405,11   :    4.033,76  :</td>\n</tr>\n<tr>\n<td> :  3   :    59.637,18   :    4.969,77  :</td>\n</tr>\n<tr>\n<td> :  4   :    66.706,75   :    5.558,90  :</td>\n</tr>\n<tr>\n<td> :  5   :    71.794,31   :    5.982,86  :</td>\n</tr>\n<tr>\n<td> :  6   :    74.595,76   :    6.216,31  :</td>\n</tr>\n<tr>\n<td> :  7   :    79.781,62   :    6.648,47  :</td>\n</tr>\n<tr>\n<td> :  8   :    84.439,82   :    7.036,65  :</td>\n</tr>\n<tr>\n<td> :  9   :    88.650,45   :    7.387,54  :</td>\n</tr>\n<tr>\n<td> : 10   :    94.764,65   :    7.897,05  :</td>\n</tr>\n<tr>\n<td> : 11   :   105.954,14   :    8.829,51  :</td>\n</tr>\n<tr>\n<td> : 12   :   113.291,61   :    9.440,97  :</td>\n</tr>\n<tr>\n<td> : 13   :   123.282,23   :   10.273,52  :</td>\n</tr>\n<tr>\n<td> : 14   :   133.272,98   :   11.106,08  :</td>\n</tr>\n<tr>\n<td> : 15   :   144.353,81   :   12.029,48  :</
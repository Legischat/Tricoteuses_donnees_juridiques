      "TITRE_TXT": [
        {
          "#text": "Arrêté du 8 juin 1984 REVALORISATION DES PRESTATIONS DES REGIMES D'ASSURANCE VIEILLESSE DES TRAVAILLEURS NON SALARIES DES PROFESSIONS ARTISANALES,INDUSTRIELLES ET COMMERCIALES AU 01-01-1984 ET AU 01-07-1984",
          "@c_titre_court": "Arrêté du 8 juin 1984",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000846678"
        },
        {
          "#text": "Arrêté du 8 juin 1984 relatif à la revalorisation des prestations des régimes d'assurance vieillesse des travailleurs non-salariés des professions artisanales, industrielles et commerciales.",
          "@c_titre_court": "Arrêté du 8 juin 1984",

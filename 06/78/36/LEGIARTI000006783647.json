  "NOTA": {
    "CONTENU": "<br/>     les dispositions de l'article 1 du décret n° 70-1001 du 23 octobre 1970 ont été abrogées par l'article 4 du décret n° 2005-368 du 19 avril 2005.<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Le seuil prévu à l'article 1er (1) du décret du 23 octobre 1970 susvisé est fixé à 200 F.<br/>\n<br/>"

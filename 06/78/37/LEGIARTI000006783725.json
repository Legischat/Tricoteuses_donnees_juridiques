  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Arrêté du 11 septembre 1985 fixant les plafonds de loyers à prendre en considération pour le calcul de l'allocation de logement visée à l'article L. 510 du code de la sécurité sociale et de l'allocation de logement aux personnes âgées, aux infirmes et aux jeunes travailleurs.",
          "@c_titre_court": "Arrêté du 11 septembre 1985",
          "@debut": "1985-07-01",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006073753"
        }

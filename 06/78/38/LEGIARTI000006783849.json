      "TITRE_TXT": [
        {
          "#text": "Arrêté du 3 juillet 1972 DETERMINATION DES MOUVEMENTS DE FONDS QUI DOIVENT ETRE OPERES ENTRE LES CAISSES D'ALLOCATION DE VIEILLESSE DES PROFESSIONS ARTISANALES ET LA CAISSE NATIONALE DE COMPENSATION",
          "@c_titre_court": "Arrêté du 3 juillet 1972",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000452681"
        },
        {
          "#text": "Arrêté du 3 juillet 1972 relatif à la détermination des mouvements de fonds qui doivent être opérés entre les caisses d'allocation de vieillesse des professions artisanales et la caisse nationale de compensation.",
          "@c_titre_court": "Arrêté du 3 juillet 1972",
          "@debut": "1972-07-26",
          "@fin": "2999-01-01",

  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Arrêté du 6 mars 1986 fixant pour 1984 les soldes de la compensation en matière d'assurance contre les accidents du travail et les maladies professionnelles visée aux articles L. 134-7 à L. 134-11 du code de la sécurité sociale",
          "@c_titre_court": "Arrêté du 6 mars 1986",
          "@debut": "1986-03-19",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006073796"
        }
      ],
      "@cid": "LEGITEXT000006073796",

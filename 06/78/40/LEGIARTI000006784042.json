  "BLOC_TEXTUEL": {
    "CONTENU": "<p>Les salaires forfaitaires servant de base au calcul des contributions des armateurs, des cotisations et des pensions des marins du commerce, de la pêche et de la plaisance sont modifiés en application de l'article L. 42 du code des pensions de retraite des marins, et pour compter du 1er janvier 1986, conformément au tableau ci-après :</p>\n<br/>\n<p>----------------------------------</p>\n<br/>\n<table>\n<tbody>\n<tr>\n<td>: : SALAIRES :</td>\n</tr>\n<tr>\n<td>: : FORFAITAIRES :</td>\n</tr>\n<tr>\n<td>: : (base de calcul :</td>\n</tr>\n<tr>\n<td>: CATEGORIES : des :</td>\n</tr>\n<tr>\n<td>: : contributions, :</td>\n</tr>\n<tr>\n<td>: : cotisations et :</td>\n</tr>\n<tr>\n<td>: : pensions) :</td>\n</tr>\n<tr>\n<td>: :-------------------:</td>\n</tr>\n<tr>\n<td>: : Par an :</td>\n</tr>\n<tr>\n<td>:------------:-------------------:</td>\n</tr>\n<tr>\n<td>: 1 : 47.826,96 :</td>\n</tr>\n<tr>\n<td>: 2 : 60.092,82 :</td>\n</tr>\n<tr>\n<td>: 3 : 72.358,52 :</td>\n</tr>\n<tr>\n<td>: 4 : 80.078,68 :</td>\n</tr>\n<tr>\n<td>: 5 : 85.634,42 :</td>\n</tr>\n<tr>\n<td>: 6 : 88.693,67 :</td>\n</tr>\n<tr>\n<td>: 7 : 94.356,75 :</td>\n</tr>\n<tr>\n<td>: 8 : 99.443,62 :</td>\n</tr>\n<tr>\n<td>: 9 : 104.041,74 :</td>\n</tr>\n<tr>\n<td>: 10 : 110.718,60 :</td>\n</tr>\n<tr>\n<td>: 11 : 122.937,80 :</td>\n</tr>\n<tr>\n<td>: 12 : 130.950,50 :</td>\n</tr>\n<tr>\n<td>: 13 : 141.860,51 :</td>\n</tr>\n<tr>\n<td>: 14 : 152.770,66 :</td>\n</tr>\n<tr>\n<td>: 15 : 164.871,20 :</td>\n</tr>\n<tr>\n<td>: 16 : 177.688,36 :</td>\n</tr>\n<tr>\n<td>: 17 : 193.351,48 :</td>\n</tr>\n<tr>\n<td>: 18 : 213.328,50 :</td>\n</tr>\n<tr>\n<td>: 19 : 235.079,87 :</td>\n</tr>\n<tr>\n<td>: 20 : 258.539,83 :</td>\n</tr>\n</tbody>\n</table>\n<p>--------------------------------------------------------------------</p>\n<br/>\n<table>\n<tbody>\n<tr>\n<td>: : SALAIRES :</td>\n</tr>\n<tr>\n<td>: : FORFAITAIRES :</td>\n</tr>\n<tr>\n<td>: : (base de calcul :</td>\n</tr>\n<tr>\n<td>: CATEGORIES : des :</td>\n
      "TITRE_TXT": [
        {
          "#text": "Arrêté du 15 mars 1984 CONDITIONS DANS LESQUELLES CERTAINES FORMATIONS DE LA RESISTANCE PEUVENT OBTENIR LA DECLARATION SPECIALE INSTITUEE PAR LE DECRET 84150 DU 01-03-1984 (FORCES FRANCAISES COMBATTANTES,FORCES FRANCAISES DE L'INTERIEUR ET DE LA RESISTANCE CLANDESTINE)",
          "@c_titre_court": "Arrêté du 15 mars 1984",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000837852"
        },
        {
          "#text": "Arrêté du 15 mars 1984 fixant les conditions dans lesquelles certaines formations de la Résistance peuvent obtenir la déclaration spéciale instituée par le décret n° 84-150 du 1er mars 1984",
          "@c_titre_court": "Arrêté du 15 mars 1984",
          "@debut": "1984-03-21",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006073831"
        }
      ],

    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Arrêté du 3 avril 1991 ETABLISSANT LA LISTE DES AGENCES SPECIALISEES PREVUE AUX ART. 7 ET 10 DU DECRET 9179 DU 22-01-1991 RELATIF AUX BILLETS DE TRESORERIE ET AUTRES TITRES DE CREANCES NEGOCIABLES",
          "@c_titre_court": "Arrêté du 3 avril 1991",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000507162"
        },
        {
          "#text": "Arrêté du 3 avril 1991 établissant la liste des agences spécialisées prévue aux articles 7 et 10 du décret n° 91-79 du 22 janvier 1991 relatif aux billets de trésorerie et autres titres de créances négociables",
          "@c_titre_court": "Arrêté du 3 avril 1991",
          "@debut": "1991-04-12",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006059572"
        }
      ],
      "@cid": "JORFTEXT000000507162",
      "@date_publi": "1991-04-12",
      "@date_signature": "1991-04-03",
      "@nature": "ARRETE",

  "BLOC_TEXTUEL": {
    "CONTENU": "Liste des périodes de suspension de l'activité de navigant considérées comme valables pour la retraite établie en application des dispositions du paragraphe 1 de l'article R. 426-13 du code de l'aviation civile et du décret n° 84-470 du 18 juin 1984.<br/>\n<br/>\n<table>\n<tr>\n<td> :--------------------------------:</td>\n</tr>\n<tr>\n<td> :             PERIODE            :</td>\n</tr>\n<tr>\n<td> :--------------------------------:</td>\n</tr>\n<tr>\n<td> : 1. Rappel ou maintien sous     :</td>\n</tr>\n<tr>\n<td> :    les drapeaux                :</td>\n</tr>\n<tr>\n<td> :--------------------------------:</td>\n</tr>\n<tr>\n<td> :           REFERENCE            :</td>\n</tr>\n<tr>\n<td> :--------------------------------:</td>\n</tr>\n<tr>\n<td> :  L. 122-21 du code du travail  :</td>\n</tr>\n<tr>\n<td> :                                :</td>\n</tr>\n<tr>\n<td>   </td>\n</tr>\n<tr>\n<td> :--------------------------------:</td>\n</tr>\n<tr>\n<td> :             PERIODE            :</td>\n</tr>\n<tr>\n<td> :--------------------------------:</td>\n</tr>\n<tr>\n<td> : 2. Inaptitude médicale         :</td>\n</tr>\n<tr>\n<td> :    temporaire pour maternité   :</td>\n</tr>\n<tr>\n<td> :   (après épuisement des droits :</td>\n</tr>\n<tr>\n<td> :     à rémunération)            :</td>\n</tr>\n<tr>\n<td> :--------------------------------:</td>\n</tr>\n<tr>\n<td> :           REFERENCE            :</td>\n</tr>\n<tr>\n<td> :--------------------------------:</td>\n</tr>\n<tr>\n<td> : L. 122-25-2 du code du travail :</td>\n</tr>\n<tr>\n<td> :                                :</td>\n</tr>\n<tr>\n<td>   </td>\n</tr>\n<tr>\n<td> :--------------------------------:</td>\n</tr>\n<tr>\n<td> :             PERIODE            :</td>\n</tr>\n<tr>\n<td> :--------------------------------:</td>\n</tr>\n<tr>\n<td> :  3. Congé légal de maternité   :</td>\n</tr>\n<tr>\n<td> :     ou d'adoption              :</td>\n</tr>\n<tr>\n<td> :--------------------------------:</td>\n</tr>\n<tr>\n<td> :           REFERENCE            :</td>\n</tr>\n<tr>\n<td> :--------------------------------:</td>\n</tr>\n<tr>\n<td> : L. 122-26 du code du travail   :</td>\n</tr>\n<tr>\n<td> :                                :</td>\n</tr>\n</table>\n<br/>\n<br/>\n<table>\n<tr>\n<td>:--------------------------------:</td>\n</tr>\n<tr>\n<td> :             PERIODE            :</td>\n</tr>\n<tr>\n<td> :--------------------------------:</td>\n</tr>\n<tr>\n<td> : 4. Congé parental d'éducation  :</td>\n</tr>\n<tr>\n<td> :    ou travail à mi-temps après :</td>\n</tr>\n<tr>\n<td> :    naissance ou adoption       :</td>\n</tr>\n<tr>\n<td> :--------------------------------:</td>\n</tr>\n<tr>\n<td> :           REFERENCE            :</td>\n</tr>\n<tr>\n<td> :--------------------------------:</td>\n</tr>\n<tr>\n<td> : L. 122-28-1 du code du travail :</td>\n</tr>\n<tr>\n<td> :                                :</td>\n</tr>\n<tr>\n<td>   </td>\n</tr>\n<tr>\n<td> :--------------------------------:</td>\n</tr>\n<tr>\n<td> :             PERIODE            :</td>\n</tr>\n<tr>\n<td> :--------------------------------:</td>\n</tr>\n<tr>\n<td> : 5. Suspension du contrat de    :</td>\n</tr>\n<tr>\n<td> :    travail pendant la durée    :</td>\n</tr>\n<tr>\n<td> :    d'un arrêt de travail,      :</td>\n</tr>\n<tr>\n<td> :    provoqué par un accident    :</td>\n</tr>\n<tr>\n<td> :    du travail                  :</td>\n</tr>\n<tr>\n<td> :--------------------------------:</td>\n</tr>\n<tr>\n<td> :           REFERENCE            :</td>\n</tr>\n<tr>\n<td> :--------------------------------:</td>\n</tr>\n<tr>\n<td> : L. 122-32-1 du code du travail :</td>\n</tr>\n<tr>\n<td> :                                :</td>\n</tr>\n<tr>\n<td>   </td>\n</tr>\n<tr>\n<td> :--------------------------------:</td>\n</tr>\n<tr>\n<td> :             PERIODE            :</td>\n</tr>\n<tr>\n<td> :--------------------------------:</td>\n</tr>\n<tr>\n<td> :  6. Congé en vue de favoriser  :</td>\n</tr>\n<tr>\n<td> :     la formation des cadres    :</td>\n</tr>\n<tr>\n<td> :     et animateurs de la        :</td>\n</tr>\n<tr>\n<td> :     jeunesse                   :</td>\n</tr>\n<tr>\n<td> :--------------------------------:</td>\n</tr>\n<tr>\n<td> :           REFERENCE            :</td>\n</tr>\n<tr>\n<td> :--------------------------------:</td>\n</tr>\n<tr>\n<td> : L. 225-1 du code du travail    :</td>\n</tr>\n<tr>\n<td> :                                :</td>\n</tr>\n</table>\n<br/>\n<br/>\n<table>\n<tr>\n<td>:--------------------------------:</td>\n</tr>\n<tr>\n<td> :             PERIODE            :</td>\n</tr>\n<tr>\n<td> :--------------------------------:</td>\n</tr>\n<tr>\n<td> : 7. Congé d'éducation ouvrière  :</td>\n</tr>\n<tr>\n<td> :--------------------------------:</td>\n</tr>\n<tr>\n<td> :           REFERENCE            :</td>\n</tr>\n<tr>\n<td> :--------------------------------:</td>\n</tr>\n<tr>\n<td> : L. 451-1 du code du travail    :</td>\n</tr>\n<tr>\n<td> :                                :</td>\n</tr>\n<tr>\n<td>   </td>\n</tr>\n<tr>\n<td> :--------------------------------:</td>\n</tr>\n<tr>\n<td> :             PERIODE            :</td>\n</tr>\n<tr>\n<td> :--------------------------------:</td>\n</tr>\n<tr>\n<td> : 8. Congé de formation non      :</td>\n</tr>\n<tr>\n<td> :    rémunéré                    :</td>\n</tr>\n<tr>\n<td> :--------------------------------:</td>\n</tr>\n<tr>\n<td> :           REFERENCE            :</td>\n</tr>\n<tr>\n<td> :--------------------------------:</td>\n</tr>\n<tr>\n<td> : L. 900-2, points 2, 3, 4 et 5  :</td>\n</tr>\n<tr>\n<td> :                                :</td>\n</tr>\n<tr>\n<td>   </td>\n</tr>\n<tr>\n<td> :--------------------------------:</td>\n</tr>\n<tr>\n<td> :             PERIODE            :</td>\n</tr>\n<tr>\n<td> :--------------------------------:</td>\n</tr>\n<tr>\n<td> :  9. Exercice des fonctions de  :</td>\n</tr>\n<tr>\n<td> :     juré                       :</td>\n</tr>\n<tr>\n<td> :--------------------------------:</td>\n</tr>\n<tr>\n<td> :           REFERENCE            :</td>\n</tr>\n<tr>\n<td> :--------------------------------:</td>\n</tr>\n<tr>\n<td> :    Article 267 du code de      :</td>\n</tr>\n<tr>\n<td> :     procédure pénale           :</td>\n</tr>\n<tr>\n<td> :                                :</td>\n</tr>\n</table>\n<br/>\n<br/>\n<table>\n<tr>\n<td>:--------------------------------:</td>\n</tr>\n<tr>\n<td> :             PERIODE            :</td>\n</tr>\n<tr>\n<td> :--------------------------------:</td>\n</tr>\n<tr>\n<td> : 10. Congé d'enseignement       :</td>\n</tr>\n<tr>\n<td> :--------------------------------:</td>\n</tr>\n<tr>\n<td> :           REFERENCE            :</td>\n</tr>\n<tr>\n<td> :--------------------------------:</td>\n</tr>\n<tr>\n<td> : L. 931-13-1 du code du travail :</td>\n</tr>\n<tr>\n<td> :                                :</td>\n</tr>\n<tr>\n<td>   </td>\n</tr>\n<tr>\n<td> :--------------------------------:</td>\n</tr>\n<tr>\n<td> :             PERIODE            :</td>\n</tr>\n<tr>\n<td> :--------------------------------:</td>\n</tr>\n<tr>\n<td> : 11. Congé pour raisons         :</td>\n</tr>\n<tr>\n<td> :     médicales sans traitement  :</td>\n</tr>\n<tr>\n<td> :     pour les agents ayant      :</td>\n</tr>\n<tr>\n<td> :     épuisé leurs droits à      :</td>\n</tr>\n<tr>\n<td> :     congés de maladie          :</td>\n</tr>\n<tr>\n<td> :--------------------------------:</td>\n</tr>\n<tr>\n<td> :           REFERENCE            :</td>\n</tr>\n<tr>\n<td> :--------------------------------:</td>\n</tr>\n<tr>\n<td> : Décret n° 49-1378 du 3 octobre :</td>\n</tr>\n<tr>\n<td> :  1949, article 22              :</td>\n</tr>\n<tr>\n<td> :                                :</td>\n</tr>\n<tr>\n<td>   </td>\n</tr>\n<tr>\n<td> :--------------------------------:</td>\n</tr>\n<tr>\n<td> :             PERIODE            :</td>\n</tr>\n<tr>\n<td> :--------------------------------:</td>\n</tr>\n<tr>\n<td> : 12. Congé sans traitement pour :</td>\n</tr>\n<tr>\n<td> :      maternité ou adoption     :</td>\n</tr>\n<tr>\n<td> :--------------------------------:</td>\n</tr>\n<tr>\n<td> :           REFERENCE            :</td>\n</tr>\n<tr>\n<td> :--------------------------------:</td>\n</tr>\n<tr>\n<td> : Décret n° 80-552 du 15 juillet :</td>\n</tr>\n<tr>\n<td> :  1980 modifié, article 14      :</td>\n</tr>\n<tr>\n<td> :                                :</td>\n</tr>\n<tr>\n<td>   </td>\n</tr>\n<tr>\n<td> :--------------------------------:</td>\n</tr>\n<tr>\n<td> :             PERIODE            :</td>\n</tr>\n<tr>\n<td> :--------------------------------:</td>\n</tr>\n<tr>\n<td> :       13. Congé parental       :</td>\n</tr>\n<tr>\n<td> :                                :</td>\n</tr>\n<tr>\n<td> :--------------------------------:</td>\n</tr>\n<tr>\n<td> :           REFERENCE            :</td>\n</tr>\n<tr>\n<td> :--------------------------------:</td>\n</tr>\n<tr>\n<td> : Décret n° 80-552 du 15 juillet :</td>\n</tr>\n<tr>\n<td> :  1980 modifié, article 11      :</td>\n</tr>\n<tr>\n<td> :                                :</td>\n</tr>\n</table>\n<br/>"

    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Arrêté du 8 octobre 1986 fixant les plafonds de loyers à prendre en considération pour le calcul de l'allocation de logement prévue au titre IV du livre V du code de la sécurité sociale et de l'allocation de logement prévue au titre III du livre VIII du code de la sécurité sociale",
          "@c_titre_court": "Arrêté du 8 octobre 1986",
          "@debut": "1986-10-09",

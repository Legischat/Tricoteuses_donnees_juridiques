  "NOTA": {
    "CONTENU": "<br/>   [*NOTA : Arrêté du 3 octobre 1983 art. 9 bis : Champ d'application du présent arrêté.*]<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Le montant annuel de la rémunération des correspondants habilités auprès de la caisse est fixé dans les conditions prévues aux cinq premiers alinéas de l'article 2 du présent arrêté, soit par application du taux d'évolution sans affectation du correctif à la rémunération desdits correspondants au cours de l'année précédente.<br/>\n<br/>"
  },

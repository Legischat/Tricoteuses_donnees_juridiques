    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Arrêté du 27 août 1974 MODALITES D'APPLICATION DU D. 72-154 DU 24-02-1972 RELATIF AUX CONGES EN CAS DE MALADIE, DE MATERNITE ET D'ACCIDENTS DU TRAVAIL DONT PEUVENT BENEFICIER CERTAINS PERSONNELS OUVRIERS DE L'ETAT MENSUALISES, AFFILIES A UN REGIME SPECIAL DE RETRAITE",
          "@c_titre_court": "Arrêté du 27 août 1974",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000308040"
        },
        {
          "#text": "Arrêté du 27 août 1974 fixant les modalités d'application du décret n° 72-154 du 24 février 1972 relatif aux congés en cas de maladie, de maternité et d'accidents du travail dont peuvent bénéficier certains personnels ouvriers de l'Etat mensualisés, affiliés à un régime spécial de retraite.",
          "@c_titre_court": "Arrêté du 27 août 1974",
          "@debut": "1974-09-19",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006073900"
        }
      ],
      "@cid": "JORFTEXT000000308040",

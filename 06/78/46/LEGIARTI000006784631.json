      "TITRE_TXT": [
        {
          "#text": "Arrêté du 30 décembre 1986 PORTANT FIXATION DES TAUX DES COTISATIONS DE REGIME DE L'ASSURANCE OBLIGATOIRE DES SALARIES AGRICOLES CONTRE LES ACCIDENTS DU TRAVAIL ET LES MALADIES PROFESSIONNELLES POUR 1987 ET DE LA PART DES RESSOURCES AFFECTEES A CHAQUE CATEGORIE DE CHARGES DE CE REGIME",
          "@c_titre_court": "Arrêté du 30 décembre 1986",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000498026"
        },
        {
          "#text": "Arrêté du 30 décembre 1986 portant fixation des taux de cotisations du régime de l'assurance obligatoire des salariés agricoles contre les accidents du travail et les maladies professionnelles pour 1987 et de la part des ressources affectées à chaque catégorie de charges de ce régime",
          "@c_titre_court": "Arrêté du 30 décembre 1986",
          "@debut": "1987-01-01",

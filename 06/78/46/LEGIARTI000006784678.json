      "TITRE_TXT": [
        {
          "#text": "Arrêté du 24 décembre 1986 relatif à l'ouverture anticipée du droit à pension de retraite pour certains anciens ouvriers d'ardoisières de Maine-et-Loire titulaires de rentes d'accidents du travail ou de maladies professionnelles",
          "@c_titre_court": "Arrêté du 24 décembre 1986",
          "@debut": "1987-01-21",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006073920"

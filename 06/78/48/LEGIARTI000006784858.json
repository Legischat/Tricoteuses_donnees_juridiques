      "TITRE_TXT": [
        {
          "#text": "Arrêté du 30 juin 1987 RELATIF A L'AMENAGEMENT DES COTISATIONS VERSEES A LA CAISSE GENERALE DE PREVOYANCE PAR LES PENSIONNES DE L'ETABLISSEMENT NATIONAL DES INVALIDES DE LA MARINE (ENIM)",
          "@c_titre_court": "Arrêté du 30 juin 1987",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000472418"
        },
        {
          "#text": "Arrêté du 30 juin 1987 relatif à l'aménagement des cotisations versées à la caisse générale de prévoyance par les pensionnés de l'Etablissement national des invalides de la marine",
          "@c_titre_court": "Arrêté du 30 juin 1987",

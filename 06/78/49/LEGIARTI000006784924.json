  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Arrêté du 23 octobre 1984 FIXANT LA NATURE ET LA PERIODICITE DES INFORMATIONS TRANSMISES AUX CAISSES CHARGEES DU VERSEMENT DE LA DOTATION GLOBALE POUR LES JOURNEES D'HOSPITALISATION POSTERIEURES AU 31-12-1984",
          "@c_titre_court": "Arrêté du 23 octobre 1984",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000677883"
        },
        {
          "#text": "Arrêté du 23 octobre 1984 modifiant l'arrêté du 25 octobre 1983 portant application des articles 27 et 46 du décret n° 83-744 du 11 août 1983 et fixant la nature et la périodicité des informations transmises aux caisses chargées du versement de la dotation globale pour les journées d'hospitalisation postérieures au 31 décembre 1984",
          "@c_titre_court": "Arrêté du 23 octobre 1984",
          "@debut": "1984-11-07",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006073939"
        }

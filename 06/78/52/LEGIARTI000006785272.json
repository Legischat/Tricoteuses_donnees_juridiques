    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Arrêté du 3 février 1988 PRIS EN APPLICATION DE L'ART. 3 DU DECRET 88113 DU 03-02-1988 PORTANT CREATION D'UN FONDS D'ACTION SOCIALE A LA CAISSE AUTONOME MUTUELLE DE RETRAITES DES AGENTS DE CHEMIN DE FER SECONDAIRE D'INTERET GENERAL,DES CHEMINS DE FER D'INTERET LOCAL ET DES TRAMWAYS (CAMR)",
          "@c_titre_court": "Arrêté du 3 février 1988",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000844589"
        },
        {
          "#text": "Arrêté du 3 février 1988 pris en application de l'article 3 du décret n° 88-113 du 3 février 1988 portant création d'un fonds d'action sociale à la caisse autonome mutuelle de retraites des agents des chemins de fer secondaires d'intérêt général, des chemins de fer d'intérêt local et des tramways",
          "@c_titre_court": "Arrêté du 3 février 1988",
          "@debut": "1988-01-01",

      "TITRE_TXT": [
        {
          "#text": "Arrêté du 23 décembre 1987 FIXANT POUR L'ANNEE 1988 LE MONTANT MAXIMUM DE PENSION ET LE MONTANT DES COTISATIONS DU REGIME D'ASSURANCE VIEILLESSE DES MINISTRES DES CULTES ET MEMBRES DES CONGREGATIONS ET COLLECTIVITES RELIGIEUSES",
          "@c_titre_court": "Arrêté du 23 décembre 1987",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000863742"
        },
        {
          "#text": "Arrêté du 23 décembre 1987 fixant pour l'année 1988 le montant maximum de pension et le montant des cotisations du régime d'assurance vieillesse des ministres des cultes et membres des congrégations et collectivités religieuses",
          "@c_titre_court": "Arrêté du 23 décembre 1987",

    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Arrêté du 6 mai 1988 PORTANT APPLICATION DES ART. R623-2,R623-3,R623-4,R623-5,R623-6,R623-7,R623-8 ET R623-9 RELATIFS A L'ORGANISATION FINANCIERE DES REGIMES D'ASSURANCE VIEILLESSE DES TRAVAILLEURS NON SALARIEES DES PROFESSIONS NON AGRICOLES ET DU REGIME DES AVOCATS",
          "@c_titre_court": "Arrêté du 6 mai 1988",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000843662"
        },
        {
          "#text": "Arrêté du 6 mai 1988 portant application des articles R. 623-2 à R. 623-9 relatif à l'organisation financière des régimes d'assurance vieillesse des travailleurs non salariés des professions non agricoles et du régime des avocats",
          "@c_titre_court": "Arrêté du 6 mai 1988",
          "@debut": "1988-05-08",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006058336"
        }

      "TITRE_TXT": [
        {
          "#text": "Arrêté du 2 novembre 1976 fixant le taux des cotisations dues pour l'application de la législation sur les accidents du travail agricole aux élèves des établissements privés d'enseignement technique et de formation professionnelle agricoles",
          "@c_titre_court": "Arrêté du 2 novembre 1976",
          "@debut": "1976-11-01",

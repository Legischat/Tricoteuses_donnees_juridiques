        {
          "#text": "Arrêté du 3 novembre 1976 CENTRE NATIONAL D'ETUDES SUPERIEURES DE SECURITE SOCIALE",
          "@c_titre_court": "Arrêté du 3 novembre 1976",
          "@debut": "2999-01-01",

  "NOTA": {
    "CONTENU": "<br/>   Arrêté du 29 décembre 1988 art. 2 : Les présentes dispositions sont applicables aux cotisations assises sur les traitements versés à compter du 1er janvier 1989.<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {

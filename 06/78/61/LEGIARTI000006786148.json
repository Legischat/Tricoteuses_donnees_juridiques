    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Arrêté du 7 octobre 1988 FIXANT LE GAIN ANNUEL MINIMUM SUSCEPTIBLE D'ETRE DECLARE PAR LES EXPLOITANTS AGRICOLES QUI CONTRACTENT POUR LES MEMBRES DE LEUR FAMILLE ET POUR EUX-MEMES UNE ASSURANCE COMPLEMENTAIRE CONTRE LES ACCIDENTS DU TRAVAIL ET LES MALADIES PROFESSIONNELLES",
          "@c_titre_court": "Arrêté du 7 octobre 1988",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000846372"
        },
        {
          "#text": "Arrêté du 7 octobre 1988 fixant le gain annuel minimum susceptible d'être déclaré par les exploitants agricoles qui contractent, pour les membres de leur famille et pour eux-mêmes, une assurance complémentaire contre les accidents du travail et les maladies professionnelles",
          "@c_titre_court": "Arrêté du 7 octobre 1988",

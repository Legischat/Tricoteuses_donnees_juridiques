      "TITRE_TXT": [
        {
          "#text": "Arrêté du 3 février 1989 FIXANT POUR 1987 LES SOLDES DE LA COMPENSATION EN MATIERE D'ASSURANCE CONTRE LES ACCIDENTS DU TRAVAIL ET LES MALADIES PROFESSIONNELLES VISEE AUX ART. L134-7,L134-8,L134-9,L134-10 ET L134-11 DU CODE DE LA SECURITE SOCIALE",
          "@c_titre_court": "Arrêté du 3 février 1989",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000300630"
        },
        {
          "#text": "Arrêté du 3 février 1989 fixant pour 1987 les soldes de la compensation en matière d'assurance contre les accidents du travail et les maladies professionnelles visée aux articles L. 134-7 à L. 134-11 du code de la sécurité sociale",
          "@c_titre_court": "Arrêté du 3 février 1989",
          "@debut": "1989-02-16",
          "@fin": "1989-12-31",

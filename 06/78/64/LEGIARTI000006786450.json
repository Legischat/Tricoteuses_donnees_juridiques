    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Arrêté du 16 mars 1989 PORTANT APPLICATION DE L'ART. 20 DU DECRET 87788 DU 28-09-1987 ET FIXANT L'ASSIETTE DE COTISATION AU REGIME DE L'INSTITUTION DE RETRAITE COMPLEMENTAIRE DES AGENTS NON TITULAIRES DE L'ETAT ET DES COLLECTIVITES PUBLIQUES DES ASSISTANTS DES HOPITAUX",
          "@c_titre_court": "Arrêté du 16 mars 1989",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000684346"
        },
        {
          "#text": "Arrêté du 16 mars 1989 portant application de l'article 20 du décret n° 87-788 du 28 septembre 1987 et fixant l'assiette de cotisation au régime de l'institution de retraite complémentaire des agents non titulaires de l'Etat et des collectivités publiques des assistants des hôpitaux",
          "@c_titre_court": "Arrêté du 16 mars 1989",
          "@debut": "1989-03-25",
          "@fin": "1996-07-01",
          "@id_txt": "LEGITEXT000006058873"

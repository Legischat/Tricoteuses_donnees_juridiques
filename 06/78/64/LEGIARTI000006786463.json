      "TITRE_TXT": [
        {
          "#text": "Arrêté du 10 avril 1989 PORTANT FIXATION DE L'ASSIETTE FORFAITAIRE DES COTISATIONS SOCIALES DUES POUR LES FORMATEURS OCCASIONNELS AU REGIME DE PROTECTION SOCIALE DES SALARIES DES PROFESSIONS AGRICOLES",
          "@c_titre_court": "Arrêté du 10 avril 1989",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000498778"
        },
        {
          "#text": "Arrêté du 10 avril 1989 portant fixation de l'assiette forfaitaire des cotisations sociales dues pour les formateurs occasionnels au régime de protection sociale des salariés des professions agricoles",

    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Arrêté du 29 décembre 1989 PORTANT FIXATION DES TAUX DE COTISATIONS DU REGIME DE L'ASSURANCE OBLIGATOIRE DES SALARIES AGRICOLES CONTRE LES ACCIDENTS DU TRAVAIL ET LES MALADIES PROFESSIONNELLES POUR 1990 ET DE LA PART DES RESSOURCES AFFECTEES A CHAQUE CATEGORIE DE CHARGES DE CE REGIME",
          "@c_titre_court": "Arrêté du 29 décembre 1989",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000339743"
        },
        {
          "#text": "Arrêté du 29 décembre 1989 portant fixation des taux de cotisations du régime de l'assurance obligatoire des salariés agricoles contre les accidents du travail et les maladies professionnelles pour 1990 et de la part des ressources affectées à chaque catégorie de charges de ce régime",
          "@c_titre_court": "Arrêté du 29 décembre 1989",
          "@debut": "1990-01-01",

  "NOTA": {
    "CONTENU": "<br/>Arrêté du 29 janvier 1991 art. 4 : les dispositions de l'article 7 sont applicables au comité interdépartemental des prestations sociales agricoles. <br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les propositions du comité résultent d'un vote de tous les membres présents ayant voix délibérative.<br/>\n<br/>   La voix du président est prépondérante en cas d'égalité des suffrages exprimés.<br/>"
  },

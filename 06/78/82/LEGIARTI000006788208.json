  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Arrêté du 22 octobre 1991 DETERMINANT LES MODALITES DE CALCUL DES COTISATIONS D'ASSURANCE VOLONTAIRE VIEILLESSE DUES AU TITRE D'UNE ACTIVITE AGRICOLE NON SALARIEE EXERCEE HORS DU TERRITOIRE FRANCAIS PAR LES PERSONNES BENEFICIAIRES DE LA LOI 65-555 DU 10-07-1965",
          "@c_titre_court": "Arrêté du 22 octobre 1991",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000326942"
        },
        {
          "#text": "Arrêté du 22 octobre 1991 déterminant les modalités de calcul des cotisations d'assurance volontaire vieillesse dues au titre d'une activité agricole non salariée exercée hors du territoire français par les personnes bénéficiaires de la loi n° 65-555 du 10 juillet 1965.",
          "@c_titre_court": "Arrêté du 22 octobre 1991",
          "@debut": "1991-10-25",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006059800"
        }
      ],
      "@cid": "JORFTEXT000000326942",

  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les salaires forfaitaires servant de base au calcul des contributions des armateurs, des cotisations et des pensions des marins du commerce, de la pêche et de la plaisance sont modifiés en application de l'article L. 42 du code des pensions de retraite des marins et pour compter des 1er janvier et 1er juillet 1992, conformément aux tableaux ci-après :<br/>\n<br/>\nBase de calcul des contributions, cotisations et pensions applicable au 1er janvier 1992<br/>\n<br/>\n SALAIRES FORFAITAIRES (base de calcul des contributions, cotisations et pensions) :<br/>\n *******************************<br/>\n<br/>\n<table>\n<tr>\n<td> : Ca :  Par an    :  Par mois :</td>\n</tr>\n<tr>\n<td> :  1 :  57 907,55 :  4 825,63 :</td>\n</tr>\n<tr>\n<td> :  2 :  72 018,63 :  6 001,55 :</td>\n</tr>\n<tr>\n<td> :  3 :  86 129,50 :  7 177,46 :</td>\n</tr>\n<tr>\n<td> :  4 :  95 011,02 :  7 917,59 :</td>\n</tr>\n<tr>\n<td> :  5 : 101 402,55 :  8 450,21 :</td>\n</tr>\n<tr>\n<td> :  6 : 104 922,00 :  8 743,50 :</td>\n</tr>\n<tr>\n<td> :  7 : 111 436,99 :  9 286,42 :</td>\n</tr>\n<tr>\n<td> :  8 : 117 289,12 :  9 774,09 :</td>\n</tr>\n<tr>\n<td> :  9 : 122 578,95 : 10 214,91 :</td>\n</tr>\n<tr>\n<td> : 10 : 130 260,22 : 10 855,02 :</td>\n</tr>\n<tr>\n<td> : 11 : 144 317,61 : 12 026,47 :</td>\n</tr>\n<tr>\n<td> : 12 : 153 353,67 : 12 794,64 :</td>\n</tr>\n<tr>\n<td> : 13 : 166 086,91 : 13 840,58 :</td>\n</tr>\n<tr>\n<td> : 14 : 178 638,33 : 14 886,53 :</td>\n</tr>\n<tr>\n<td> : 15 : 192 559,20 : 16 046,60 :</td>\n</tr>\n<tr>\n<td> : 16 : 207 304,49 : 17 275,37 :</td>\n</tr>\n<tr>\n<td> : 17 : 225 323,85 : 18 776,99 :</td>\n</tr>\n<tr>\n<td> : 18 : 248 306,09 : 20 692,17 :</td>\n</tr>\n<tr>\n<td> : 19 : 273 329,59 : 22 777,47 :</td>\n</tr>\n<tr>\n<td> : 20 : 300 318,72 : 25 026,56 :</td>\n</tr>\n</table>\n<br/>\n *******************************Base de calcul des contributions, cotisations et pensions applicable au 1er juillet 1992<br/>\n<br/>\n SALAIRES FORFAITAIRES (base de calcul des contributions, cotisations et pensions) :<br/>\n *******************************<br/>\n<br/>\n<table>\n<tr>\n<td> : Ca :  Par an    :  Par mois :</td>\n</tr>\n<tr>\n<td> :  1 :  58 949,88 :  4 912,49 :</td>\n</tr>\n<tr>\n<td> :  2 :  73 314,96 :  6 109,58 :</td>\n</tr>\n<tr>\n<td> :  3 :  87 679,83 :  7 306,65 :</td>\n</tr>\n<tr>\n<td> :  4 :  96 721,22 :  8 060,10 :</td>\n</tr>\n<tr>\n<td> :  5 : 103 227,79 :  8 602,31 :</td>\n</tr>\n<tr>\n<td> :  6 : 106 810,60 :  8 900,88 :</td>\n</tr>\n<tr>\n<td> :  7 : 113 442,85 :  9 453,57 :</td>\n</tr>\n<tr>\n<td> :  8 : 119 400,32 :  9 950,03 :</td>\n</tr>\n<tr>\n<td> :  9 : 124 785,37 : 10 398,78 :</td>\n</tr>\n<tr>\n<td> : 10 : 132 604,90 : 11 050,41 :</td>\n</tr>\n<tr>\n<td> : 11 : 146 915,33 : 12 242,94 :</td>\n</tr>\n<tr>\n<td> : 12 : 156 299,31 : 13 024,94 :</td>\n</tr>\n<tr>\n<td> : 13 : 169 076,47 : 14 089,70 :</td>\n</tr>\n<tr>\n<td> : 14 : 181 853,82 : 15 154,48 :</td>\n</tr>\n<tr>\n<td> : 15 : 196 025,26 : 16 335,44 :</td>\n</tr>\n<tr>\n<td> : 16 : 211 035,97 : 17 586,33 :</td>\n</tr>\n<tr>\n<td> : 17 : 229 379,68 : 19 114,97 :</td>\n</tr>\n<tr>\n<td> : 18 : 252 775,60 : 21 064,63 :</td>\n</tr>\n<tr>\n<td> : 19 : 278 249,52 : 23 187,46 :</td>\n</tr>\n<tr>\n<td> : 20 : 305 724,46 : 25 477,04 :</td>\n</tr>\n</table>\n<br/>\n *******************************"

  "NOTA": {
    "CONTENU": "<br/>   [*Nota : Arrêté du 30 juillet 1993 art. 3 : dérogation.*]<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Le montant de la cotisation horaire due au titre des accidents du travail et des maladies professionnelles par les personnes visées à l'article 1er est égal au montant de la cotisation due au titre des accidents du travail et des maladies professionnelles pour les stagiaires de la formation professionnelle continue non rémunérés ou rémunérés par l'Etat en application de l'arrêté du 24 janvier 1980 susvisé.<br/>\n<br/>"
  },

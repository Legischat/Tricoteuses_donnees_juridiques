  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les salaires forfaitaires servant de base au calcul des contributions des armateurs, des cotisations et des pensions des marins du commerce, de la pêche et de la plaisance sont modifiés, pour compter du 1er juillet 1995, conformément au tableau ci-joint :<br/>\n<br/>   (A) : CATEGORIES.<br/>\n !-----!--------------------------!<br/>\n !     !  SALAIRES FORFAITAIRES   !<br/>\n !     !       (en francs)        !<br/>\n ! (A) !--------------------------!<br/>\n !     !  Par an      ! Par jour  !<br/>\n !-----!--------------!-----------!<br/>\n !  1  !   61.949,69  !  172,08   !<br/>\n !  2  !   77.045,76  !  214,02   !<br/>\n !  3  !   92.141,63  !  255,95   !<br/>\n !  4  !  101.643,12  !  282,34   !<br/>\n !  5  !  108.480,78  !  301,34   !<br/>\n !  6  !  112.245,92  !  311,79   !<br/>\n !  7  !  119.215,66  !  331,15   !<br/>\n !  8  !  125.476,29  !  348,55   !<br/>\n !  9  !  131.135,37  !  364,26   !<br/>\n ! 10  !  139.352,81  !  387,09   !<br/>\n ! 11  !  154.391,47  !  428,87   !<br/>\n ! 12  !  164.252,97  !  456,26   !<br/>\n ! 13  !  177.680,32  !  493,56   !<br/>\n ! 14  !  191.107,89  !  530,86   !<br/>\n ! 15  !  206.000,48  !  572,22   !<br/>\n ! 16  !  221.775,04  !  616,04   !<br/>\n ! 17  !  241.052,22  !  669,59   !<br/>\n ! 18  !  265.638,69  !  737,89   !<br/>\n ! 19  !  292.408,91  !  812,25   !<br/>\n ! 20  !  321.281,98  !  892,45   !<br/>\n !-----!--------------!-----------!<br/>"
  },

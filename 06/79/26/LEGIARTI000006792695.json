  "NOTA": {
    "CONTENU": "<br/>   Nota : Code de la mutualité R311-23 : non application du présent titre aux caisses autonomes mutualistes.<br/>\n<br/>   Nota : Ce texte n'a pas été à ce jour abrogé, mais il est devenu sans objet depuis l'abrogation des dispositions législatives correspondantes.<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les articles R. 311-7, R. 311-10, R. 311-12 à R. 311-14 et R. 311-18 à R. 311-22 constituent le règlement de la caisse mutualiste de garantie mentionné au 5° de l'article L. 311-7.<br/>\n<br/>"
  },

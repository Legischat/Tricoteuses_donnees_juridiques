  "NOTA": {
    "CONTENU": "<br/>  Loi 2006-64 2006-01-23 art. 29 III : le II de l'article 29 s'applique aux contrats souscrits six mois à compter de la publication de la présente loi et, pour les autres contrats, lors de la conclusion du premier avenant consécutif à l'échéance de ce même délai.<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>Les entreprises d'assurance doivent insérer dans les contrats mentionnés à l'article L. 126-2 une clause étendant leur garantie aux dommages mentionnés audit article.<br/>\n<br/>"
  },

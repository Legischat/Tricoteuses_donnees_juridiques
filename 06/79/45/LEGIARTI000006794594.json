  "NOTA": {
    "CONTENU": "<br/>  La date d'entrée en vigueur de l'ordonnance 2004-637 2004-07-01 a été modifiée par l'ordonnance 2005-727 2005-06-30 art. 3.<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les combattants volontaires de la Résistance bénéficient d'un grade d'assimilation attribué par l'autorité militaire, sur proposition de la commission nationale, compte tenu des fonctions effectivement exercées et des services rendus au cours de la lutte clandestine, dans le cadre des mouvements ou des unités organiques de la Résistance.<br/>\n<br/>"
  },

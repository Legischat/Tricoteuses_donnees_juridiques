  "NOTA": {
    "CONTENU": "<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>Les articles L. 423-3 à L. 423-13, L. 423-15, L. 423-17 à L. 423-22, L. 423-27 à L. 423-33 et L. 423-35 s'appliquent aux assistants maternels et aux assistants familiaux employés par des personnes morales de droit public. <br/>\n<br/>Lorsque les assistants familiaux sont employés par le département, les indemnités mentionnées à l'article L. 423-30 sont fixées par délibération du conseil général.<br/>"
  },

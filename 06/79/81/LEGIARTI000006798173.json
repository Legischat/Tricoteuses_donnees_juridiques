  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les dispositions de l'article L. 322-26-1 sont applicables en cas de dissolution non motivée par un retrait d'agrément d'une société mutuelle d'assurance ou d'une union de sociétés mutuelles d'assurance.<br/>\n<br/>"
  },

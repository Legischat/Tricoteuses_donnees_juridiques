  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Sont exclues de l'application du présent titre les opérations d'assurance afférentes :<br/>\n<br/>   - aux accidents du travail et aux maladies professionnelles ;<br/>\n<br/>   Sont en outre exclus de l'application du présent chapitre les risques des travaux de bâtiment faisant l'objet d'une obligation d'assurance.<br/>"
  },

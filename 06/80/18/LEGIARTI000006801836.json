        "TM": {
          "TITRE_TM": [
            {
              "#text": "Livre 6 : Don et utilisation des éléments et produits du corps humain",
              "@debut": "1994-10-11",
              "@fin": "2003-05-27",
              "@id": "LEGISCTA000006128475"
            }
          ],
          "TM": {
            "TITRE_TM": [
              {
                "#text": "Titre 1 : Principes généraux applicables au don et à l'utilisation des éléments et produits du corps humain",
                "@debut": "1997-10-12",
                "@fin": "2003-05-27",
                "@id": "LEGISCTA000006142915"
              }
            ],
            "TM": {
              "TITRE_TM": [
                {
                  "#text": "Chapitre 2 : Des règles de sécurité sanitaire applicables à tout prélèvement d'éléments ou toute collecte de produits du corps humain et à leur utilisation à des fins thérapeutiques, à l'exception des gamètes humains provenant de dons, du sang et de ses composants et de leurs dérivés, ainsi que des réactifs",
                  "@debut": "1997-10-12",
                  "@fin": "2003-05-27",
                  "@id": "LEGISCTA000006157809"
                }
              ]
            }
          }
        }
      },
      "@cid": "LEGITEXT000006072665",

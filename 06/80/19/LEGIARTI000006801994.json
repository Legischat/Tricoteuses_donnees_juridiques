  "NOTA": {
    "CONTENU": "<br/>    (1) : L'article 706-13 du code de procédure pénale a été abrogé par la loi n° 90-589 du 6 juillet 1990 art. 17.<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les indemnités allouées en application des articles 706-3 à 706-14 du code de procédure pénale (1) par la commission instituée par l'article 706-4 de ce code sont versées par le fonds de garantie des victimes des actes de terrorisme et d'autres infractions.<br/>\n<br/>"
  },

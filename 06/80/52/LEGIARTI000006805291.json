  "NOTA": {
    "CONTENU": "<br/>   *Nota : (1) voir l'article 131-13 du code pénal.*<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   L'employeur qui aura contrevenu aux dispositions des articles R. 513-11 à R. 513-14 sera puni des peines prévues pour les contraventions de la quatrième classe *(1) montant*.<br/>\n<br/>   En cas d'infraction aux dispositions de l'article R. 513-11, l'amende pourra être prononcée autant de fois qu'il y aura d'irrégularités.<br/>"
  },

  "NOTA": {
    "CONTENU": "<br/>[(1) voir l'article 131-13 du code pénal. ]<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Sans préjudice de l'application de l'article L. 122-30 (alinéa 1er), est passible des peines d'amende prévues pour les contraventions de la 5° classe, en première infraction et en récidive, l'employeur qui contrevient aux dispositions des articles L. 122-25 à L. 122-28-4 et aux dispositions des articles R. 122-9 à R. 122-11.<br/>\n<br/>"
  },

  "NOTA": {
    "CONTENU": "<br/>  <br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les dispositions des articles R. 232-2 à R232-2-3 ne sont applicable qu'au cas où le travail est effectué dans les locaux de l'exploitation, de l'entreprise ou de l'établissement agricole ou à proximité de ceux-ci et, si ce n'est pas le cas, lorsque les salariés y prennent et finissent leur travail de façon habituelle.<br/>\n<br/>"
  },

  "NOTA": {
    "CONTENU": "<br/>  <br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Le tableau ci-après détermine les prescriptions du présent chapitre qui donne lieu à l'application de la procédure de mise en demeure prévue à l'article L. 231-4, ainsi que le délai minimum d'exécution :<br/>\n<br/>   Article R. 233-1 : huit jours ;<br/>\n<br/>   Article R. 233-1-2 : huit jours ;<br/>\n<br/>   Article R. 233-2 (alinéa 2) : huit jours ;<br/>\n<br/>   Article R. 233-6 (alinéas 3 et 4) : trois mois ;<br/>\n<br/>   Article R. 233-43 (alinéa 2) : huit jours.<br/>\n<br/>   Article R. 233-46 (alinéa 2 et 3) : 1 mois.<br/>"
  },

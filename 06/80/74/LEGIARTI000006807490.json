  "NOTA": {
    "CONTENU": "<br/>  <br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>    Les bâtiments doivent satisfaire aux exigences des articles R. 232-2 à R. 232-2-5 en ce qui concerne les installations sanitaires et à celles de l'article R. 232-10-1 pour le local de restauration.<br/>\n<br/>    Toutefois, les dispositions de l'article R. 232-12-9 s'appliquent à la construction et à l'aménagement des bâtiments.<br/>"
  },

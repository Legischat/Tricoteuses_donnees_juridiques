  "NOTA": {
    "CONTENU": "<br/>  <br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>    Principes généraux de prévention :<br/>\n<br/>   L'employeur est tenu de réduire le bruit au niveau le plus bas raisonnablement possible compte tenu de l'état des techniques.<br/>\n<br/>   L'exposition au bruit doit demeurer à un niveau compatible avec la santé des travailleurs, notamment avec la protection de l'ouïe.<br/>"
  },

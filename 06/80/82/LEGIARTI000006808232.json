  "NOTA": {
    "CONTENU": "<br/>  <br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les infractions aux articles L. 212-5, L. 212-5-1, L. 212-6 et L. 212-7 sont punies d'une amende de 1.300 F à 3.000 F. Les dispositions de l'article L. 260-1 leur sont applicables. Les contraventions donneront lieu à autant d'amendes qu'il y a d'ouvriers indûment employés.<br/>\n<br/>"
  },

  "NOTA": {
    "CONTENU": "<br/>   *Nota - Code du travail R311-6-4 : dispositions applicables aux demandes de renouvellement de conventions.*<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>    La liste des demandeurs d'emploi est tenue par l'agence nationale pour l'emploi *ANPE*.<br/>\n<br/>    Les personnes qui y sont inscrites, en application des articles L. 311-2 et L. 311-5, sont réparties dans des catégories déterminées par arrêté du ministre chargé de l'emploi, en fonction de l'objet de leur demande et de leur situation au regard de l'emploi.<br/>"
  },

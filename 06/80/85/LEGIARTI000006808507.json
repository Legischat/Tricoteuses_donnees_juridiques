  "NOTA": {
    "CONTENU": "<br/>   *Nota - Code du travail R311-6-4 : dispositions applicables aux demandes de renouvellement de conventions.*<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>    Pour maintenir leur inscription, les demandeurs d'emploi sont tenus de renouveler périodiquement leur demande, selon des modalités fixées par arrêté du ministre de l'emploi et qui tiennent compte de la catégorie dans laquelle ils ont été inscrits.<br/>\n<br/>"
  },

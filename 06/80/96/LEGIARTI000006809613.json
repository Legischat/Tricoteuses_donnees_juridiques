  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les cartes de travailleur étranger sont de quatre types :<br/>\n<br/>   a) Carte temporaire ;<br/>\n<br/>   b) Carte ordinaire à validité limitée ;<br/>\n<br/>   c) Carte ordinaire à validité permanente ;<br/>\n<br/>   d) Carte permanente pour toutes professions salariées.<br/>"
  },

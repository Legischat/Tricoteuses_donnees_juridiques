  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Chacune des commissions régionales de conciliation comprend :<br/>\n<br/>   - Le directeur des affaires maritimes ou son représentant, président ;<br/>\n<br/>   - Six représentants des armateurs, respectivement, pour la navigation de commerce et pour la pêche maritime ;<br/>\n<br/>   - Six représentants des personnels navigants respectivement pour la navigation de commerce et pour la pêche maritime.<br/>"
  },

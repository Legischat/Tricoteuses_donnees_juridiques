  "NOTA": {
    "CONTENU": "<br/>   *Nota - Le décret 73-563 du 27 juin 1973, codifié à la présente section, a été abrogé par le décret 85-607 du 14 juin 1985 art. 30.*<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les fonctionnaires ont la possibilité de demander une mise en disponibilité :<br/>\n<br/>   a) Pour effectuer des études ou recherches présentant un intérêt général en application de l'article 24 (alinéa b) du décret n° 59-309 du 14 février 1959 ;<br/>\n<br/>   b) Pour convenances personnelles en application de l'article 24 (alinéa b) du décret susvisé du 14 février 1959 afin de parfaire leur formation personnelle ou de participer en qualité d'éducateur à des actions de formation professionnelle continue.<br/>"
  },

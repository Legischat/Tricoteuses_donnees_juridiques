  "NOTA": {
    "CONTENU": "<br/>\n<br/>\n<br/>\n<br/>\n<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les démolitions de constructions existantes doivent être précédées de la délivrance d'un permis de démolir lorsque la construction relève d'une protection particulière définie par décret en Conseil d'Etat ou est située dans une commune ou partie de commune où le conseil municipal a décidé d'instaurer le permis de démolir.<br/>\n<br/>"
  },

  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>        Les dispositions du présent titre sont applicables :<br/>\n<br/>        a) Dans les communes dotées d'un plan d'occupation des sols rendu public ou approuvé ;<br/>\n<br/>        b) Dans les périmètres sensibles institués en application de l'article L. 142-1 ;<br/>\n<br/>        c) Dans les zones d'environnement protégé instituées en application de l'article L. 143-1 ;<br/>\n<br/>        d) Dans les communes figurant sur la liste dressée à cet effet par décision de l'autorité administrative.<br/>"
  },

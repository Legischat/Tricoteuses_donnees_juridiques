  "BLOC_TEXTUEL": {
    "CONTENU": "<p>Les articles L. 410-1, L. 421-1 à L. 421-8, L. 422-1 à L. 422-7, L. 423-1, L. 424-1 à L. 424-9, L. 425-1 à L. 425-3, L. 425-5, L. 425-7 à L. 425-10, L. 426-1, L. 431-1 à L. 434-1, L. 441-1 à L. 445-1, L. 451-1 à L. 452-1, L. 461-1 à L. 463-1 et L. 471-1 à L. 471-3 sont applicables à Mayotte, sous réserve des dispositions ci-après.</p>\n<br/>\n<br/>"
  },

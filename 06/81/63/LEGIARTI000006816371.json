  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Sont admises en représentation des provisions techniques correspondant aux branches mentionnées aux 20, 21, 22, 24, 25 de l'article R. 321-1 :<br/>\n<br/>   - les avances sur contrats ;<br/>\n<br/>   - les primes ou cotisations restant à recouvrer, de trois mois de date au plus, jusqu'à concurrence de 90 % de leur montant.<br/>"
  },

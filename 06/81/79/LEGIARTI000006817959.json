  "NOTA": {
    "CONTENU": "<br/>   NOTA : Loi 2006-1772 2006-12-31 art. 101 III : Spécificités d'application.<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Le propriétaire ou son mandataire adresse au maire de la commune un plan de division préalablement à toute division de terrain en vue de l'implantation de bâtiments qui ne constitue pas un lotissement au sens de l'article R. 315-1 (alinéas 1 et 2) ou qui n'est pas une des divisions visées à l'article R. 315-2.<br/>\n<br/>"
  },

  "NOTA": {
    "CONTENU": "<br/>   NOTA : Loi 2006-1772 2006-12-31 art. 101 III : Spécificités d'application.<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les dispositions des articles 5-2, 26-1, 26-2, 26-3 du décret n° 58-1463 du 31 décembre 1958 relatif aux plans d'urbanisme, modifié, et les textes pris pour leur application cessent d'être applicables dès que le plan local d'urbanisme est rendu public ou dès que des coefficients provisoires d'occupation du sol, mentionnés à l'article L. 124-3 sont fixés.<br/>\n<br/>"
  },

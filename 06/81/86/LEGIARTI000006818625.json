  "NOTA": {
    "CONTENU": "<br/>   NOTA : Loi 2006-1772 2006-12-31 art. 101 III : Spécificités d'application.<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Si, au cours de l'instruction du dossier, il s'avère que le délai retenu pour l'application de l'article R. 315-15 doit être majoré en application de l'article R. 315-19, l'autorité compétente pour statuer fait connaître au demandeur par une lettre rectificative la date avant laquelle la décision devra, en conséquence, lui être notifiée.<br/>\n<br/>"
  },

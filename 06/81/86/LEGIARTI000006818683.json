  "NOTA": {
    "CONTENU": "<br/>   NOTA : Loi 2006-1772 2006-12-31 art. 101 III : Spécificités d'application.<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Sous réserve de l'application de l'article R. 315-33, aucune mutation entre vifs ou location concernant des terrains bâtis ou non bâtis compris dans un lotissement ne peut être effectuée avant l'intervention de l'arrêté autorisant le lotissement et l'exécution des prescriptions imposées au lotisseur par ledit arrêté.<br/>\n<br/>"
  },

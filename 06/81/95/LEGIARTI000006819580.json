  "NOTA": {
    "CONTENU": "<br/>   NOTA : Loi 2006-1772 2006-12-31 art. 101 III : Spécificités d'application.<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Sans préjudice de l'application de l'article L. 160-1 ou de l'article L. 480-4, sera puni de l'amende prévue pour les contraventions de la cinquième classe, toute personne qui aura enfreint les dispositions des articles R. 442-1 à R. 442-7 et R. 442-10 ou qui n'aura pas respecté les conditions auxquelles les autorisations délivrées auront été subordonnées.<br/>\n<br/>"
  },

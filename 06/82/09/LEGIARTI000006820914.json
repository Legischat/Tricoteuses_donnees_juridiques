      "TITRE_TXT": [
        {
          "#text": "Loi n°62-904 du 4 août 1962 INSTITUANT UNE SERVITUDE SUR LES FONDS PRIVES POUR LA POSE DES CANALISATIONS PUBLIQUES D'EAU OU D'ASSAINISSEMENT",
          "@c_titre_court": "Loi n°62-904 du 4 août 1962",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000313971"
        },
        {
          "#text": "Loi n°62-904 du 4 août 1962 instituant une Servitudes sur les fonds privés pour la pose de canalisations publiques d'eau ou d'assainissement",
          "@c_titre_court": "Loi n°62-904 du 4 août 1962",
          "@debut": "1962-08-07",
          "@fin": "1992-11-12",
          "@id_txt": "LEGITEXT000006068224"
        }

    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret n°84-226 du 29 mars 1984 RELATIF A L'AUTORISATION D'EDIFIER DES CLOTURES ET A L'AUTORISATION D'INSTALLATION ET TRAVAUX DIVERS",
          "@c_titre_court": "Décret n°84-226 du 29 mars 1984",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000701235"
        },
        {
          "#text": "Décret n°84-226 du 29 mars 1984 modifiant le code de l'urbanisme et relatif à l'autorisation d'édifier des clôtures et à l'autorisation d'installation et travaux divers.",
          "@c_titre_court": "Décret n°84-226 du 29 mars 1984",
          "@debut": "1984-04-01",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006064408"
        }
      ],
      "@cid": "JORFTEXT000000701235",

      "TITRE_TXT": [
        {
          "#text": "Décret n°84-711 du 17 juillet 1984 PRIS POUR L'APPLICATION DE L'ART. 95 DE LA LOI 838 DU 07-01-1983 MODIFIEE ET RELATIF AU FINANCEMENT DE L'ETABLISSEMENT ET DE LA MISE EN OEUVRE DES DOCUMENTS D'URBANISME DANS LES DEPARTEMENTS D'OUTRE-MER",
          "@c_titre_court": "Décret n°84-711 du 17 juillet 1984",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000327885"
        },
        {
          "#text": "Décret n°84-711 du 17 juillet 1984 pris pour l'application de l'article 95 de la loi n° 83-8 du  7 janvier 1983 modifiée et relatif au financement de l'établissement et de la mise en oeuvre des documents d'urbanisme dans les départements d'outre-mer et modifiant le décret n° 83-1122 du  22 décembre 1983.",
          "@c_titre_court": "Décret n°84-711 du 17 juillet 1984",
          "@debut": "1984-07-25",

      "TITRE_TXT": [
        {
          "#text": "Décret n°86-516 du 14 mars 1986 MODIFIANT LE CODE DE L'URBANISME ET RELATIF AU DROIT DE PREEMPTION URBAIN,AUX ZONES D'AMENAGEMENT DIFFERE (ZAD),AUX ESPACES NATURELS SENSIBLES DES DEPARTEMENTS ET AU CONTROLE DE CERTAINES DIVISIONS FONCIERES",
          "@c_titre_court": "Décret n°86-516 du 14 mars 1986",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000867862"
        },
        {
          "#text": "Décret n°86-516 du 14 mars 1986 modifiant le code de l'urbanisme et relatif au droit de préemption urbain, aux zones d'aménagement différé, aux espaces naturels sensibles des départements et au contrôle de certaines divisions foncières.",
          "@c_titre_court": "Décret n°86-516 du 14 mars 1986",
          "@debut": "1986-03-16",
          "@fin": "2999-01-01",

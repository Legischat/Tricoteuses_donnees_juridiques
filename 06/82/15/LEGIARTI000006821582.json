    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret n°86-517 du 14 mars 1986 MODIFIANT LE CODE DE L'URBANISME ET RELATIF AUX ZONES D'AMENAGEMENT CONCERTE (ZAC),AUX ASSOCIATIONS FONCIERES URBAINES ET AUX PARTICIPATIONS A LA REALISATION D'EQUIPEMENTS PUBLICS",
          "@c_titre_court": "Décret n°86-517 du 14 mars 1986",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000692518"
        },
        {
          "#text": "Décret n°86-517 du 14 mars 1986 modifiant le code de l'urbanisme et relatif aux zones d'aménagement concerté, aux associations foncières urbaines et aux participations à la réalisation d'équipements publics.",
          "@c_titre_court": "Décret n°86-517 du 14 mars 1986",
          "@debut": "1986-03-16",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006065564"
        }

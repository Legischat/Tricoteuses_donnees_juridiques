        {
          "#text": "Décret n°64-153 du 15 février 1964 PRIS POUR L'APPLICATION DE LA LOI 62904 DU 04-08-1962 INSTITUANT UNE SERVITUDE SUR LES FONDS PRIVES POUR LA POSE DES CANALISATIONS PUBLIQUES D'EAU OU D'ASSAINISSEMENT",
          "@c_titre_court": "Décret n°64-153 du 15 février 1964",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000330705"
        },
        {
          "#text": "Décret n°64-153 du 15 février 1964 relatif à l'application de la loi n° 62-904 du 4 août 1962 instituant une servitude sur les fonds privés pour la pose des canalisations publiques d'eau ou d'assainissement.",
          "@c_titre_court": "Décret n°64-153 du 15 février 1964",
          "@debut": "1964-02-20",
          "@fin": "1992-12-12",
          "@id_txt": "LEGITEXT000006061187"
        }
      ],

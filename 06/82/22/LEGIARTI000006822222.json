  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les emplois suivants du service d'architecture des bâtiments civils et des palais nationaux sont supprimés :<br/>\n<br/>   Inspecteur aux grands travaux et inspecteur à l'entretien ;<br/>\n<br/>   Sous-inspecteur aux grands travaux et sous-inspecteur à l'entretien ;<br/>\n<br/>   Conducteur à l'entretien et aux grands travaux ;<br/>\n<br/>   Dessinateur ;<br/>\n<br/>   Surveillant de travaux ;<br/>\n<br/>   Gardien du bureau des agences ;<br/>\n<br/>   Gardien de chantier ;<br/>\n<br/>   Gardien fontainier ;<br/>\n<br/>   Charretier.<br/>"
  },

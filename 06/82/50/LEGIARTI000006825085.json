  "NOTA": {
    "CONTENU": "Loi 2002-1575 2002-12-30 finances art. 80 II : les présentes dispositions s'appliquent aux comptes d'épargne-logement ouverts à compter du 12 décembre 2002.<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les bénéficiaires d'un prêt d'épargne-logement reçoivent de l'Etat, lors de la réalisation du prêt, une prime d'épargne dont le montant est fixé compte-tenu de leur effort d'épargne.<br/>\n<br/>"
  },

          "@id_txt": "JORFTEXT000000687777"
        },
        {
          "#text": "Décret n°81-150 du 16 février 1981 portant création d'un prêt finançant des travaux tendant à économiser l'énergie.",
          "@c_titre_court": "Décret n°81-150 du 16 février 1981",

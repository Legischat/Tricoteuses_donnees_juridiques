    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Arrêté du 13 mars 1986 relatif à l'application dans les départements d'outre-mer des dispositions relatives aux logements destinés à l'accession à la propriété construits à l'aide de primes à la construction convertibles en bonifications d'intérêt, de prêts spéciaux du Crédit foncier de France et de subventions complémentaires de l'Etat",
          "@c_titre_court": "Arrêté du 13 mars 1986",
          "@debut": "1990-01-26",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006074126"
        }
      ],
      "TM": {

  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   \"Le prix de référence est majoré selon les dispositions de l'arrêté du 5 juillet 1983 modifié relatif au financement des opérations de logements neufs à usage locatif ou en accession à la propriété aidées par l'Etat et bénéficiant du label haute performance énergétique ou du label solaire. \"<br/>\n<br/>"
  },
  "LIENS": {
    "LIEN": [
      {
        "#text": "Les valeurs Cv, Bv et Gv figurant à l'annexe IX de l'arrêté du 26 mars 1985 susvisés et applicables :",
        "@sens": "source",
        "@typelien": "SPEC_APPLI"
      },
      {
        "#text": "- jusqu'au 30 juin 1989",
        "@sens": "source",
        "@typelien": "SPEC_APPLI"
      },
      {
        "#text": "- à partir du 1er juillet 1989",
        "@sens": "source",
        "@typelien": "SPEC_APPLI"
      },
      {
        "#text": "Arrêté 1983-07-05",
        "@sens": "source",
        "@typelien": "CITATION"
      },
      {
        "#text": "Arrêté 1989-03-21 art. 1er :",
        "@sens": "source",
        "@typelien": "SPEC_APPLI"
      },
      {
        "#text": "Arrêté 1989-03-21 art. 2 2° JORF 9 avril 1989",

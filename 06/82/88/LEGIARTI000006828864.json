  "BLOC_TEXTUEL": {
    "CONTENU": "Cette majoration prend en compte de manière forfaitaire les coûts relatifs au relogement des occupants, comprenant :<br/>\n    Les frais de déménagement non couverts par la prime de déménagement ou d'autres aides publiques ;<br/>\n    Le loyer différentiel supporté par l'organisme pendant la durée du relogement ;<br/>\n    Les indemnités versées aux occupants à titre de remboursement des équipements installés par eux-mêmes ;<br/>\n    L'action socio-éducative d'accompagnement.<br/>\n    g = 12.245 F en zone I.<br/>\n    g = 10.730 F en zone II.<br/>\n    g = 9.820 F en zone III.<br/>"
  },
  "LIENS": {
    "LIEN": [
      {
        "#text": "Les valeurs Co, de To et des garages figurant à l'article 4 de l'arrêté du 24 février 1978 susvisé et applicables :",
        "@sens": "source",
        "@typelien": "SPEC_APPLI"
      },
      {
        "#text": "- jusqu'au 30 juin 1989",
        "@sens": "source",
        "@typelien": "SPEC_APPLI"
      },
      {
        "#text": "- à partir du 1er juillet 1989",
        "@sens": "source",
        "@typelien": "SPEC_APPLI"
      },
      {
        "#text": "Arrêté 1989-03-21 annexe III JORF 9 avril 1989",
        "@sens": "source",
        "@typelien": "MODIFICATION"
      },
      {
        "#text": "Arrêté 1989-03-21 art. 1er :",
        "@sens": "source",
        "@typelien": "SPEC_APPLI"
      },
      {
        "#text": "Arrêté 1996-06-10 art. 17 JORF 20 juin 1996 en vigueur le 1er juillet 1996",
        "@sens": "source",
        "@typelien": "ABROGATION"
      },
      {
        "#text": "sont données en annexe du présent arrêté ainsi que la majoration g relative au coût de relogement figurant dans l'annexe VIII de l'arrêté susvisé",
        "@sens": "source",
        "@typelien": "SPEC_APPLI"
      }
    ]
  }

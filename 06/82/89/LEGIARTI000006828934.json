      "TITRE_TXT": [
        {
          "#text": "Arrêté du 29 août 1972 PARTICIPATION DES EMPLOYEURS A L'EFFORT DE CONSTRUCTION",
          "@c_titre_court": "Arrêté du 29 août 1972",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000450166"
        },
        {
          "#text": "Arrêté du 29 août 1972 fixant la liste des organismes admis en application de l'article 1er (2°-b et c) du décret n° 66-826 du 7 novembre 1966 modifié à recevoir des versements au titre de la participation des employeurs et limites dans lesquelles les sommes recueillies par les organismes collecteurs doivent être affectées à la construction de logements.",
          "@c_titre_court": "Arrêté du 29 août 1972",
          "@debut": "1972-09-10",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006074164"
        }
      ],
      "@cid": "JORFTEXT000000450166",
      "@date_publi": "1972-09-10",

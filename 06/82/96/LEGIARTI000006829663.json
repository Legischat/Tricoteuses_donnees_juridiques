          "#text": "Arrêté du 20 novembre 1979 CONDITIONS D'ATTRIBUTION DES PRIMES A L'AMELIORATION DE L'HABITAT",
          "@c_titre_court": "Arrêté du 20 novembre 1979",
          "@debut": "2999-01-01",

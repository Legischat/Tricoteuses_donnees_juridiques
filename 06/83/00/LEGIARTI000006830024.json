  "NOTA": {
    "CONTENU": "<br/>   (1) Ce dispositif d'essai fait l'objet d'un dessin annexé au présent arrêté. Ce dessin pourra être consulté auprès des directions départementales de la protection civile et des directions départementales de l'équipement.<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Le dispositif d'essai (1) comprend :<br/>\n<br/>   a) Une source de chaleur rayonnante (radiateur) ;<br/>\n<br/>   b) Un chariot mobile porte-éprouvette ;<br/>\n<br/>   c) Un départementales de l'équipement.<br/>\n ventilateur ;<br/>\n<br/>   d) Deux dispositifs d'inflammation ;<br/>\n<br/>   e) Un dispositif de mesure des températures.<br/>"
  },

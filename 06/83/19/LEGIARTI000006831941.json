  "NOTA": {
    "CONTENU": "<br/>   NOTA : Arrêté 2001-07-30 art. 8 : les dispositions de l'arrêté du 30 juillet 2001 sont applicables à compter des prestations dues au titre du mois de juillet 2001.<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Pour l'application de l'article R. 351-61 :<br/>\n<br/>   - le coefficient multiplicateur CM est fixé à 67 954 du 1er juillet 2001 au 31 décembre 2001 et à 10 359,52 à compter du 1er janvier 2002 ;<br/>\n<br/>   - le coefficient r est fixé à 6 176 du 1er juillet 2001 au 31 décembre 2001 et à 941,53 à compter du 1er janvier 2002.<br/>"
  },

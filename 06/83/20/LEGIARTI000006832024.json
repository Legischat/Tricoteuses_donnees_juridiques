  "NOTA": {
    "CONTENU": "<br/>   NOTA : Arrêté du 23 décembre 2002 - Article 14 : Les dispositions du présent article sont applicables pour les prestations dues à compter du mois de juillet 2002.<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   1° Le montant prévu au 1 du I de l'article R. 351-7-1 est fixé à 6 300 euros.<br/>\n<br/>   2° Le coefficient prévu au 2 du I du même article est fixé à 13.<br/>"
  },

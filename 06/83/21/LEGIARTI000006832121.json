  "BLOC_TEXTUEL": {
    "CONTENU": "A compter du 1er juillet 1984, le montant forfaitaire des charges est fixé comme suit : <br/>\n<br/>\n<table>\n<tr>\n<td> :=============================================================:</td>\n</tr>\n<tr>\n<td> :                             :   LOGEMENT     :  LOGEMENT    :</td>\n</tr>\n<tr>\n<td> :                             :    disposant   : ne disposant :</td>\n</tr>\n<tr>\n<td> :       DESIGNATION           : d'un ascenseur :   pas d'un   :</td>\n</tr>\n<tr>\n<td> :                             :                :  ascenseur   :</td>\n</tr>\n<tr>\n<td> :-----------------------------:----------------:--------------:</td>\n</tr>\n<tr>\n<td> :                             :     Francs     :    Francs    :</td>\n</tr>\n<tr>\n<td> : Bénéficiaire isolé          :      362       :     244      :</td>\n</tr>\n<tr>\n<td> :                             :                :              :</td>\n</tr>\n<tr>\n<td> : Ménage sans personne à      :                :              :</td>\n</tr>\n<tr>\n<td> :  charge ...                 :      362       :     244      :</td>\n</tr>\n<tr>\n<td> :                             :                :              :</td>\n</tr>\n<tr>\n<td> : Bénéficiaire isolé ou       :                :              :</td>\n</tr>\n<tr>\n<td> :  ménage ayant une personne  :                :              :</td>\n</tr>\n<tr>\n<td> :  à charge ...               :      435       :     297      :</td>\n</tr>\n<tr>\n<td> :                             :                :              :</td>\n</tr>\n<tr>\n<td> : Par personne supplémentaire :                :              :</td>\n</tr>\n<tr>\n<td> :  à charge ...               :       73       :      53      :</td>\n</tr>\n<tr>\n<td> :                             :                :              :</td>\n</tr>\n<tr>\n<td> :=============================================================:</td>\n</tr>\n</table>\n<br/>"

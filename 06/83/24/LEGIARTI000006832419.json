  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   TABLEAU I : PLAFONDS DE PRIX FIXES EN APPLICATION DE L'ARTICLE R. 443-34 DU CODE DE LA CONSTRUCTION ET DE L'HABITATION (CCH) ET APPLICABLES LORSQUE L'OPERATION RELEVE DU CHAMP DE L'ARTICLE 278 SEXIES DU CODE GENERAL DES IMPOTS (EN EUROS/M2)<br/>\n<br/>   ZONE GEOGRAPHIQUE / PRIX PLAFOND<br/>\n<br/>   Zone A : 3 491 <br/>\n<br/>   Zone B1 : 2 382 <br/>\n<br/>   Zone B2 : 2 010 <br/>\n<br/>   Zone C : 1 777.<br/>\n<br/>   TABLEAU II : PLAFONDS DE PRIX FIXES EN APPLICATION DE L'ARTICLE R. 443-34 DU CODE DE LA CONSTRUCTION ET DE L'HABITATION (CCH) LORSQUE L'OPERATION NE RELEVE PAS DU CHAMP DE L'ARTICLE 278 SEXIES DU CODE GENERAL DES IMPOTS (EN EUROS/M2)<br/>\n<br/>   ZONE GEOGRAPHIQUE / PRIX PLAFOND<br/>\n<br/>   Zone A : 3 958 <br/>\n<br/>   Zone B1 : 2 700 <br/>\n<br/>   Zone B2 : 2 278 <br/>\n<br/>   Zone C : 2 014.<br/>"

  "BLOC_TEXTUEL": {
    "CONTENU": "TEXTES DE RÉFÉRENCE<br/>\n VALEUR (en francs)<br/>\n CONVERSION (en euros)<br/>\n<br/>\n Arrêté du 13 mars 1986 modifié relatif aux caractéristiques techniques et de prix de revient des logements locatifs sociaux dans les départements d'outre-mer.<br/>\n 158 776 ; 24 205 <br/>\n 5 045 ; 769 <br/>\n 154 332 ; 23 528 <br/>\n 4 903 ; 747 <br/>\n 164 544 ; 25 085 <br/>\n 5 231 ; 797 <br/>\n 123 386 ; 18 810 <br/>\n 3 922 ; 598 <br/>\n 127 179 ; 19 388 <br/>\n 4 042 ; 616 <br/>\n 127 874 ; 19 494 <br/>\n 4 064 ; 620 <br/>\n 3 000 ; 457 <br/>\n 698 ; 106 <br/>\n 727 ; 111 <br/>\n<br/>\n Arrêté du 20 février 1996 modifié relatif aux prêts aidés par l'Etat et aux subventions de l'Etat aux organismes réalisant des logements locatifs sociaux et très sociaux dans les départements d'outre-mer.<br/>\n 120 614 ; 18 387 <br/>\n 3 834 ; 584 <br/>\n 124 321 ; 18 953 <br/>\n 3 951 ; 602 <br/>\n 125 001 ; 19 056 <br/>\n 3 973 ; 606 <br/>\n 40 000 ; 6 098 <br/>\n 698 ; 106 <br/>\n 727 ; 111 <br/>"

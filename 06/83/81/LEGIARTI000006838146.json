  "BLOC_TEXTUEL": {
    "CONTENU": "<p>Les périodes d'ouverture générale doivent être comprises entre les dates énoncées au tableau suivant :</p>\n<table align=\"center\" border=\"1\" cellpadding=\"0\" cellspacing=\"0\">\n<tbody>\n<tr>\n<td width=\"353\">\n<p align=\"center\">Départements appartenant aux régions suivantes</p>\n</td>\n<td width=\"132\">\n<p align=\"center\">Date d'ouverture générale au plus tôt le</p>\n</td>\n<td width=\"129\">\n<p align=\"center\">Date de clôture générale au plus tard le</p>\n</td>\n</tr>\n<tr>\n<td width=\"353\">\n<p>Corse</p>\n</td>\n<td width=\"132\">\n<p align=\"center\">Premier dimanche de septembre</p>\n</td>\n<td width=\"129\">\n<p align=\"center\">Dernier jour de février</p>\n</td>\n</tr>\n<tr>\n<td width=\"353\">\n<p>Languedoc-Roussillon, Provence-Alpes-Côte d'Azur, Poitou-Charentes, Limousin, Aquitaine, Midi-Pyrénées, Franche-Comté, Auvergne, Rhône-Alpes</p>\n</td>\n<td width=\"132\">\n<p align=\"center\">Deuxième dimanche de septembre</p>\n</td>\n<td width=\"129\">\n<p align=\"center\">Dernier jour de février</p>\n</td>\n</tr>\n<tr>\n<td width=\"353\">\n<p>Pays de la Loire et départements de la Côte-d'Or, d'Indre-et-Loire et de Saône-et-Loire</p>\n</td>\n<td width=\"132\">\n<p align=\"center\">Troisième dimanche de septembre</p>\n</td>\n<td width=\"129\">\n<p align=\"center\">Dernier jour de février</p>\n</td>\n</tr>\n<tr>\n<td width=\"353\">\n<p>Nord, Picardie, Ile-de-France, Centre (sauf l'Indre-et-Loire), Haute-Normandie, Basse-Normandie, Bretagne, Champagne-Ardenne, Lorraine (sauf la Moselle), Bourgogne (sauf la Côte-d'Or et la Saône-et-Loire)</p>\n</td>\n<td width=\"132\">\n<p align=\"center\">Quatrième dimanche de septembre</p>\n</td>\n<td width=\"129\">\n<p align=\"center\">Dernier jour de février</p>\n</td>\n</tr>\n</tbody>\n</table>"
  },

  "BLOC_TEXTUEL": {
    "CONTENU": "<p>Dans le département de la Réunion, les périodes de chasse doivent être comprises entre les dates suivantes :</p>\n<div>\n<table border=\"1\" cellpadding=\"4\" cellspacing=\"1\">\n<thead>\n<tr>\n<th align=\"center\" bgcolor=\"#efeff7\" width=\"195\">\n<br/>\n<font size=\"2\"> </font>\n</th>\n<th align=\"center\" bgcolor=\"#efeff7\" width=\"130\">\n<br/>\n<font size=\"2\">DATE D'OUVERTURE SPÉCIFIQUE au plus tôt le</font>\n</th>\n<th align=\"center\" bgcolor=\"#efeff7\" width=\"130\">\n<br/>\n<font size=\"2\">DATE DE CLÔTURE SPÉCIFIQUE au plus tard le</font>\n</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td align=\"left\">\n<br/>Gibier à poil</td>\n<td align=\"center\">\n<br/>1<sup>er</sup> juin</td>\n<td align=\"center\">\n<br/>15 octobre</td>\n</tr>\n<tr>\n<td align=\"left\">\n<br/>Tangue</td>\n<td align=\"center\">\n<br/>15 février</td>\n<td align=\"center\">\n<br/>15 avril</td>\n</tr>\n<tr>\n<td align=\"left\">\n<br/>Cerf</td>\n<td align=\"center\">\n<br/>1<sup>er</sup> juin</td>\n<td align=\"center\">\n<br/>1<sup>er</sup> décembre</td>\n</tr>\n<tr>\n<td align=\"left\">\n<br/>Gibier à plume</td>\n<td align=\"center\">\n<br/>1<sup>er</sup> juin</td>\n<td align=\"center\">\n<br/>15 août</td>\n</tr>\n<tr>\n<td align=\"left\">\n<br/>Merle</td>\n<td align=\"center\">\n<br/>1<sup>er</sup> juillet</td>\n<td align=\"center\">\n<br/>15 août</td>\n</tr>\n</tbody>\n</table>\n</div>"
  },

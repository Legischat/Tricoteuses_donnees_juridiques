  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Le préfet coordonnateur pour l'élaboration du plan de gêne pour chaque aérodrome est le suivant :<br/>\n<br/>   1° Le préfet du Val-d'Oise pour Paris - Charles-de-Gaulle ;<br/>\n<br/>   2° Le préfet du Val-de-Marne pour Paris-Orly ;<br/>\n<br/>   3° Le préfet du Rhône pour Lyon-Satolas ;<br/>\n<br/>   4° Le préfet des Alpes-Maritimes pour Nice-Côte d'Azur ;<br/>\n<br/>   5° Le préfet des Bouches-du-Rhône pour Marseille-Provence ;<br/>\n<br/>   6° Le préfet de la Haute-Garonne pour Toulouse-Blagnac ;<br/>\n<br/>   7° Le préfet du Haut-Rhin pour Mulhouse-Bâle ;<br/>\n<br/>   8° Le préfet de la Gironde pour Bordeaux-Mérignac ;<br/>\n<br/>   9° Le préfet du Bas-Rhin pour Strasbourg-Entzheim.<br/>"
  },

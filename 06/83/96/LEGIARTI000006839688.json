        {
          "#text": "Loi n°85-677 du 5 juillet 1985 TENDANT A L'AMELIORATION DE LA SITUATION DES VICTIMES D'ACCIDENTS DE LA CIRCULATION ET A L'ACCELERATION DES PROCEDURES D'INDEMNISATION",
          "@c_titre_court": "Loi n°85-677 du 5 juillet 1985",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000693454"
        },
        {
          "#text": "Loi n° 85-677 du 5 juillet 1985 tendant à l'amélioration de la situation des victimes d'accidents de la circulation et à l'accélération des procédures d'indemnisation",
          "@c_titre_court": "Loi n° 85-677 du 5 juillet 1985",

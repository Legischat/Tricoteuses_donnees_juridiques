  "NOTA": {
    "CONTENU": "<br/>  Loi 2001-616 2001-07-11 art. 75 : Dans tous les textes législatifs et réglementaires en vigueur à Mayotte, la référence à la \" collectivité territoriale de Mayotte \" est remplacée par la référence à \" Mayotte \", et la référence à la \" collectivité territoriale \" est remplacée par la référence à la \" collectivité départementale \".<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   I. à XI - (paragraphes modificateurs).<br/>\n<br/>   XII. - Les dispositions du présent article, à l'exception des II et XI, s'appliquent sur le territoire de la collectivité territoriale de Mayotte.<br/>\n<br/>   XIII. - Les dispositions du présent article entrent en vigueur le 20 novembre 1992.<br/>"
  },

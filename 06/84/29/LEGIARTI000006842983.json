  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Le droit de port comprend :<br/>\n<br/>   Pour les navires de commerce :<br/>\n<br/>   - une taxe sur le navire et, le cas échéant, une taxe de stationnement ;<br/>\n<br/>   - une taxe sur les marchandises ;<br/>\n<br/>   - la taxe sur les passagers, mentionnée à l'article L. 211-2.<br/>\n<br/>   Pour les navires de pêche :<br/>\n<br/>   - une redevance d'équipement des ports de pêche.<br/>\n<br/>   Pour les navires de plaisance ou de sport :<br/>\n<br/>   - une redevance d'équipement des ports de plaisance.<br/>"
  },

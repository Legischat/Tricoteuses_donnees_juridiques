  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   La redevance sur les passagers n'est pas applicable :<br/>\n<br/>   1° Aux enfants âgés de moins de quatre ans ;<br/>\n<br/>   2° Aux militaires voyageant en formations constituées ;<br/>\n<br/>   3° Au personnel de bord ;<br/>\n<br/>   4° Aux agents de l'armateur voyageant pour les besoins du service et munis d'un titre de transport gratuit ;<br/>\n<br/>   5° Aux agents publics dans l'exercice de leurs missions à bord.<br/>"
  },

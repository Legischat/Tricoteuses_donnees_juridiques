  "NOTA": {
    "CONTENU": "<br/>   (1) L'aéroport de Roissy-en-France a reçu le nom d'Aéroport Charles-de-Gaulle par décret du 24 octobre 1973.<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les aérodromes suivants font partie de l'ensemble constitué par l'Aéroport de Paris :<br/>\n<br/>   Charles-de-Gaulle, Orly, Le Bourget ;<br/>\n<br/>   Chavenay-Villepreux, Chelles-le-Pin, Coulommiers-Voisins ;<br/>\n<br/>   Issy-les-Moulineaux, Lognes-Emerainville, Meaux-Esbly ;<br/>\n<br/>   Persan-Beaumont, Pontoise - Cormeilles-en-Vexin, Saint-Cyr-l'Ecole et Toussus-le-Noble.<br/>"
  },

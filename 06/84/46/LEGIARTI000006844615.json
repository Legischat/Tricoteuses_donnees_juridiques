  "NOTA": {
    "CONTENU": "<br/>  Texte de l'article 2 du décret n° 84-617 du 17 juillet 1984, et non l'article 3 (Journal officiel du 18 juillet 1984).<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Lorsqu'ils constituent des grands projets d'infrastructures tels que définis à l'article 3 du décret n° 84-617 du 17 juillet 1984 pris pour l'application de l'article 14 de la loi n° 82-1153 du 30 décembre 1982 d'orientation des transports intérieurs, les travaux de création et d'extension d'infrastructures donnent lieu à l'évaluation mentionnée à l'article 5 du même décret.<br/>\n<br/>"
  },

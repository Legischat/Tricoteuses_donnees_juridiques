        {
          "#text": "Décret n°81-1165 du 30 décembre 1981 modifiant les articles R. 213-1 et R. 213-2 du code des assurances relatifs à la cotisation d'assurance maladie instituée par l'article L. 213-1 de ce code et fixant les modalités de reversement de cette cotisation par les entreprises d'assurance à l'agence centrale des organismes de sécurité sociale",
          "@c_titre_court": "Décret n°81-1165 du 30 décembre 1981",
          "@debut": "1981-12-31",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006063409"
        }
      ],
      "@cid": "JORFTEXT000000308867",
      "@date_publi": "1981-12-31",
      "@date_signature": "1981-12-30",
      "@nature": "DECRET",
      "@num": "81-1165"
    }
  },

      },
      {
        "#text": "Décret 2000-126 2000-02-16 art. 1 : le chapitre VI est remplacé par un chapitre VI \"réservé\"",
        "@cidtexte": "JORFTEXT000000398114",
        "@datesignatexte": "2000-02-16",
        "@id": "JORFTEXT000000398114",
        "@naturetexte": "DECRET",
        "@nortexte": "EQUA0000312D",

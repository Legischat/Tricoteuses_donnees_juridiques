    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Loi n°64-1331 du 26 décembre 1964 REPRIMANT LA POLLUTION DES EAUX DE LA MER PAR LES HYDROCARBURES SANCTIONS DES INFRACTIONS AUX DISPOSITIONS DES PARAGRAPHES 1 ET 2 DE L'ARTICLE 3 DE LA CONVENTION INTERNATIONALE POUR LA PREVENTION DE LA POLLUTION DES EAUX DE LA MER PAR LES HYDROCARBURES RELATIF AUX INTERDICTIONS DE REJET A LA MER D'HYDROCARBURES OU MELANGES D'HYDROCARBURES",
          "@c_titre_court": "Loi n°64-1331 du 26 décembre 1964",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000875636"
        },
        {
          "#text": "Loi n°64-1331 du 26 décembre 1964 réprimant la pollution des eaux de la mer par les hydrocarbures",
          "@c_titre_court": "Loi n°64-1331 du 26 décembre 1964",
          "@debut": "1964-12-29",
          "@fin": "1990-06-01",
          "@id_txt": "LEGITEXT000006068241"
        }
      ],
      "@cid": "JORFTEXT000000875636",

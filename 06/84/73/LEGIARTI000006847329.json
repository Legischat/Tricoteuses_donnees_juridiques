      "TITRE_TXT": [
        {
          "#text": "Loi du 27 janvier 1902 modifiant l'article 16 de la loi du 29 juillet 1881 sur la presse, en ce qui concerne l'affichage sur les édifices et monuments ayant un caractère artistique",
          "@c_titre_court": "Loi du 27 janvier 1902",
          "@debut": "1902-01-29",
          "@fin": "2011-05-19",

  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Loi n°76-599 du 7 juillet 1976 RELATIVE A LA PREVENTION ET A LA REPRESSION DE LA POLLUTION MARINE PAR LES OPERATIONS D'IMMERSIONS EFFECTUEES PAR LES NAVIRES ET AERONEFS, ET A LA LUTTE CONTRE LA POLLUTION MARINE ACCIDENTELLE",
          "@c_titre_court": "Loi n°76-599 du 7 juillet 1976",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000699580"
        },
        {
          "#text": "Loi n° 76-599 du 7 juillet 1976 relative à la prévention et à la répression de la pollution marine par les opérations d'immersion effectuées par les navires et aéronefs, et à la lutte contre la pollution marine accidentelle",
          "@c_titre_court": "Loi n° 76-599 du 7 juillet 1976",
          "@debut": "1976-07-08",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006068549"
        }
      ],
      "TM": {
        "TITRE_TM": [
          {
            "#text": "Chapitre II : Dispositions relatives à la lutte contre la pollution marine accidentelle.",

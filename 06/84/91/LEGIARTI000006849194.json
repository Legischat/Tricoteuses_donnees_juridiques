    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Loi du 7 juillet 1881 ayant pour but de déclarer d'utilité publique et d'autoriser l'exécution par l'Etat d'un canal d'irrigation, dit Canal de Manosque, dérivé de la Durance, dans le département des Basses-Alpes.",
          "@c_titre_court": "Loi du 7 juillet 1881",
          "@debut": "1881-07-08",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006074269"
        }
      ],

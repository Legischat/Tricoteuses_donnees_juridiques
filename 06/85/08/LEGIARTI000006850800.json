  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret no 94-484 du 9 juin 1994 modifiant le décret no 77-1133 du 21    septembre 1977 pris pour l'application de la loi no 76-663 du 19 juillet 1976    relative aux installations classées pour la protection de l'environnement et    du titre Ier de la loi no 64-1245 du 16 décembre 1964 relative au régime et à    la répartition des eaux et à la lutte contre leur pollution et modifiant le    livre IV du code de l'urbanisme",
          "@c_titre_court": "Décret n°94-484 du 9 juin 1994",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000731755"
        },

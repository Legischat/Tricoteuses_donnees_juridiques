  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret n°77-1295 du 25 novembre 1977 PRIS POUR L'APPLICATION DES ARTICLES 3 ET 4 DE LA LOI 76629 DU 10 JUILLET 1976 RELATIVE A LA PROTECTION DE LA NATURE ET CONCERNANT LA PROTECTION DE LA FLORE ET DE LA FAUNE SAUVAGES DU PATRIMOINE NATUREL FRANCAIS",
          "@c_titre_court": "Décret n°77-1295 du 25 novembre 1977",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000519049"
        },
        {
          "#text": "Décret n°77-1295 du 25 novembre 1977 pris pour l'application des articles 3 et 4 de la loi n° 76-629 du 10 juillet 1976 sur la protection de la nature et concernant la protection de la flore et de la faune sauvages du patrimoine naturel français",
          "@c_titre_court": "Décret n°77-1295 du 25 novembre 1977",
          "@debut": "1982-07-07",
          "@fin": "1989-11-04",
          "@id_txt": "LEGITEXT000006062596"
        }
      ],

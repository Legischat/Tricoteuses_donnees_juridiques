    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret n°74-415 du 13 mai 1974 RELATIF AU CONTROLE DES EMISSIONS POLLUANTES DANS L'ATMOSPHERE ET A CERTAINES UTILISATIONS DE L'ENERGIE THERMIQUE",
          "@c_titre_court": "Décret n°74-415 du 13 mai 1974",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000511226"
        },
        {
          "#text": "Décret n°74-415 du 13 mai 1974 relatif au contrôle des émissions polluantes dans l'atmosphère et à certaines utilisations de l'énergie thermique",
          "@c_titre_court": "Décret n°74-415 du 13 mai 1974",
          "@debut": "1974-05-15",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006062190"
        }
      ],
      "TM": {
        "TITRE_TM": [
          {
            "#text": "TITRE 2 : Dispositions applicables aux installations fixes d'incinération, de combustion ou de chauffage.",

      "TITRE_TXT": [
        {
          "#text": "Décret n°79-264 du 30 mars 1979 PRIS POUR L'APPLICATION DE LA LOI 7629 DU 10 JUILLET 1976 (ART. 10) RELATIVE A LA PROTECTION DE LA NATURE ET CONCERNANT LE CONTROLE DES ETABLISSEMENTS OUVERTS AU PUBLIC POUR L'UTILISATION D'EQUIDES",
          "@c_titre_court": "Décret n°79-264 du 30 mars 1979",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000702661"
        },
        {
          "#text": "Décret n°79-264 du 30 mars 1979 pris pour l'application de la loi n° 76-629 du 10 juillet 1976 relative à la protection de la nature et concernant le contrôle des établissements ouverts au public pour l'utilisation d'équidés",
          "@c_titre_court": "Décret n°79-264 du 30 mars 1979",
          "@debut": "1979-04-03",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006063012"
        }
      ],

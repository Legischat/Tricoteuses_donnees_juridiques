        {
          "#text": "Décret n°77-1133 du 21 septembre 1977 PRIS POUR L'APPLICATION DE LA LOI 76663 DU 19-07-1976 RELATIVE AUX INSTALLATIONS CLASSEES POUR LA PROTECTION DE L'ENVIRONNEMENT.",
          "@c_titre_court": "Décret n°77-1133 du 21 septembre 1977",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000518520"
        },
        {
          "#text": "Décret n°77-1133 du 21 septembre 1977 pris pour l'application de la loi n° 76-663 du 19 juillet 1976 relative aux installations classées pour la protection de l'environnement",
          "@c_titre_court": "Décret n°77-1133 du 21 septembre 1977",
          "@debut": "1977-10-08",
          "@fin": "2999-01-01",

  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les ressources de l'agence comprennent notamment :<br/>\n<br/>   1° Les redevances pour services rendus ;<br/>\n<br/>   2° Le produit des taxes parafiscales instituées à son bénéfice ;<br/>\n<br/>   3° Le produit des emprunts ;<br/>\n<br/>   4° Les dons et legs ;<br/>\n<br/>   5° Les versements de l'Etat et des personnes publiques et privées ;<br/>\n<br/>   6° Les revenus des biens meubles et immeubles de l'agence et le produit de leur aliénation ;<br/>\n<br/>   7° Le produit des intérêts et du remboursement des prêts aux personnes publiques ou privées.<br/>"
  },

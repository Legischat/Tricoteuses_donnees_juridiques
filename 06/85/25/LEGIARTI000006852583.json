        {
          "#text": "Décret n°59-1081 du 31 août 1959 APPROBATION D'UN CAHIER DES CHARGES-TYPE POUR L'ENTREPRISE DE LA COLLECTE ET DE L'EVACUATION DES ORDURES MENAGERES DANS LES VILLES DE PLUS DE 10.000 HABITANTS",
          "@c_titre_court": "Décret n°59-1081 du 31 août 1959",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000854543"
        },
        {
          "#text": "Décret n°59-1081 du 31 août 1959 portant approbation d'un cahier des charges type pour l'entreprise de la collecte et de l'évacuation des ordures ménagères dans les villes de plus de 10000 habitants",
          "@c_titre_court": "Décret n°59-1081 du 31 août 1959",

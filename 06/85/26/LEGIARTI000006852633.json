        {
          "#text": "Décret n°73-218 du 23 février 1973 PORTANT APPLICATION DES ARTICLES 2 ET 6 (1E) DE LA LOI 641245 DU 16-12-64 RELATIVE AU REGIME ET A LA REPARTITION DES EAUX ET A LA LUTTE CONTRE LEUR POLLUTION",
          "@c_titre_court": "Décret n°73-218 du 23 février 1973",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000306076"
        },
        {
          "#text": "Décret n°73-218 du 23 février 1973 portant application des articles 2 et 6 (1) de la loi N. 64-1245 du 16 décembre 1964 relative au régime et à la répartition des eaux et à la lutte contre leur pollution",
          "@c_titre_court": "Décret n°73-218 du 23 février 1973",
          "@debut": "1973-03-02",
          "@fin": "1993-03-30",
          "@id_txt": "LEGITEXT000006062059"
        }
      ],

            "@fin": "1993-03-30",
            "@id": "LEGISCTA000006109217"
          }
        ],
        "TM": {
          "TITRE_TM": [
            {
              "#text": "Eaux superficielles, à l'exception des eaux de mer dans les limites territoriales",
              "@debut": "1973-03-02",
              "@fin": "1993-03-30",
              "@id": "LEGISCTA000006129384"
            }
          ]
        }
      },

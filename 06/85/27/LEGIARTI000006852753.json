        {
          "#text": "Décret n°77-1554 du 28 décembre 1977 RELATIF A L'INTERDICTION DU DEVERSEMENT DE CERTAINS PRODUITS DETERGENTS DANS LES EAUX SUPERFICIELLES,SOUTERRAINES ET DE LA MER.",
          "@c_titre_court": "Décret n°77-1554 du 28 décembre 1977",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000331299"
        },
        {
          "#text": "Décret n°77-1554 du 28 décembre 1977 relatif à l'interdiction du déversement de certains produits détergent dans les eaux superficielles, souterraines et de la mer.",
          "@c_titre_court": "Décret n°77-1554 du 28 décembre 1977",
          "@debut": "1978-01-18",
          "@fin": "1987-12-30",

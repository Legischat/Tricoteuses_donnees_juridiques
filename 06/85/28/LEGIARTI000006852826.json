        {
          "#text": "Décret n°79-517 du 30 juin 1979 PORTANT CREATION D'UNE TAXE PARAFISCALE AU PROFIT DE L'AGENCE NATIONALE POUR LA RECUPERATION ET L'ELIMINATION DES DECHETS, (ANRED), JUSQU'AU 31-12-1981",
          "@c_titre_court": "Décret n°79-517 du 30 juin 1979",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000696395"
        },
        {
          "#text": "Décret n°79-517 du 30 juin 1979 portant création d'une taxe parafiscale au profit de l'agence nationale pour la récupération et l'élimination des déchets",
          "@c_titre_court": "Décret n°79-517 du 30 juin 1979",

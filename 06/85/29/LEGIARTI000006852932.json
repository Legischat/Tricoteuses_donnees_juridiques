        {
          "#text": "Décret n°79-713 du 22 août 1979 APPLICATION DE L'ART. 4 DE LA LOI NO 76629 DU 10-07-1976 RELATIVE A LA PROTECTION DE LA NATURE",
          "@c_titre_court": "Décret n°79-713 du 22 août 1979",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000518857"
        },
        {
          "#text": "Décret n°79-713 du 22 août 1979 pris pour l'application de l'article 4 de la loi n° 76-629 du 10 juillet 1976 relative à la protection de la nature et concernant la recherche, la poursuite et l'approche, pour la prise de vues ou de son, d'animaux non domestiques",
          "@c_titre_court": "Décret n°79-713 du 22 août 1979",
          "@debut": "1979-08-25",
          "@fin": "1989-11-04",
          "@id_txt": "LEGITEXT000006063102"
        }
      ],
      "@cid": "JORFTEXT000000518857",
      "@date_publi": "1979-08-25",
      "@date_signature": "1979-08-22",
      "@nature": "DECRET",
      "@num": "79-713"
    }
  },
  "VERSIONS": {
    "VERSION": [
      {
        "LIEN_ART": {

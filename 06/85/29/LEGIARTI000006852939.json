    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret du 24 février 1939 REGLES A ADOPTER POUR DIMINUER EN CAS D'ATTAQUES AERIENNES LA VULNERABILITE DES EDIFICES ET POUR ASSURER LA PROTECTION DE LA POPULATION CIVILE CONTRE LES BOMBARDEMENTS",
          "@c_titre_court": "Décret du 24 février 1939",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000481423"
        },
        {
          "#text": "Décret du 24 février 1939 portant règlement d'administration publique sur les règles à adopter pour diminuer, en cas d'attaques aériennes, la vulnérabilité des édifices et pour assurer la protection de la population civile contre les bombardements",
          "@c_titre_court": "Décret du 24 février 1939",
          "@debut": "1939-02-28",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006074281"
        }
      ],

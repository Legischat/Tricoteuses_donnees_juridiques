    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret n°80-813 du 15 octobre 1980 RELATIF AUX INSTALLATIONS CLASSEES POUR LA PROTECTION DE L'ENVIRONNEMENT RELEVANT DU MINISTERE DE LA DEFENSE ET SOUMISES A DES REGLES DE PROTECTION DU SECRET DE LA DEFENSE NATIONALE.",
          "@c_titre_court": "Décret n°80-813 du 15 octobre 1980",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000307602"
        },
        {
          "#text": "Décret n°80-813 du 15 octobre 1980 relatif aux installations classées pour la protection de l'environnement relevant du ministre de la défense ou soumises à des règles de protection du secret de la défense nationale",
          "@c_titre_court": "Décret n°80-813 du 15 octobre 1980",
          "@debut": "1980-10-17",
          "@fin": "2007-10-16",
          "@id_txt": "LEGITEXT000006063331"
        }
      ],

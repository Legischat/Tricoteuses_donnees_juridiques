        {
          "#text": "Décret n°66-747 du 6 octobre 1966 PORTANT RAP POUR L'APPLICATION DE LA LOI 64696 DU 10-07-1964 RELATIVE A L'ORGANISATION DES ASSOCIATIONS COMMUNALES ET INTERCOMMUNALES DE CHASSE AGREEES",
          "@c_titre_court": "Décret n°66-747 du 6 octobre 1966",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000335125"
        },
        {
          "#text": "Décret n°66-747 du 6 octobre 1966 portant règlement d'administration publique pour l'application de la loi n° 64-696 du 10 juillet 1964 relative à l'organisation des associations communales et intercommunales de chasse agréées",
          "@c_titre_court": "Décret n°66-747 du 6 octobre 1966",

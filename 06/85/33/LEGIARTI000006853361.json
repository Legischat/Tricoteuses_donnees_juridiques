  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret n°61-605 du 13 juin 1961 FIXANT LES CONDITIONS D'APPLICATION DES ARTICLES 1286 ET 1381 DU CODE RURAL RELATIFS AUX SERVITUDES DEVANT PERMETTRE L'ENTRETIEN PAR ENGINS MECANIQUES DE CERTAINS CANAUX D'IRRIGATION ET DE CERTAINS EMISSAIRES D'ASSAINISSEMENT",
          "@c_titre_court": "Décret n°61-605 du 13 juin 1961",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000501843"
        },
        {
          "#text": "Décret n°61-605 du 13 juin 1961 relatif à l'application des articles 128-6 et 138-1 du code rural relatifs aux servitudes devant permettre l'entretien par engins mécaniques de certains canaux d'irrigation et émissaires d'assainissement",
          "@c_titre_court": "Décret n°61-605 du 13 juin 1961",
          "@debut": "1961-06-14",
          "@fin": "1992-12-12",
          "@id_txt": "LEGITEXT000006061034"
        }
      ],

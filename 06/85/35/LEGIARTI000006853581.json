      "TITRE_TXT": [
        {
          "#text": "Décret n°71-415 du 1 juin 1971 CIV. REGLANT LA PROCEDURE DE CLASSEMENT D'UN COURS D'EAU NON DOMANIAL EN COURS D'EAU MIXTE ET FIXANT LES CONDITIONS DE CONSTATATION DES DROITS FONDES EN TITRE AINSI QUE LES DROITS EXERCES SUR L'EAU EN APPLICATION DES ARTICLES 644 & 645 DU CODE CIVIL",
          "@c_titre_court": "Décret n°71-415 du 1 juin 1971",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000695938"
        },
        {
          "#text": "Décret n°71-415 du 1 juin 1971 relatif à la procédure de classement d'un cours d'eau non domanial en cours d'eau mixte et fixant les conditions de constatation des droits fondés en titre ainsi que des droits exercés sur l'eau par application des articles 644 et 645 du code civil",
          "@c_titre_court": "Décret n°71-415 du 1 juin 1971",
          "@debut": "1971-06-08",
          "@fin": "2007-03-23",

        {
          "#text": "Décret n°61-1195 du 31 octobre 1961 PORTANT RAP. POUR APPLICATION DE LA LOI 60708 DU 22-07-1960",
          "@c_titre_court": "Décret n°61-1195 du 31 octobre 1961",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000502739"
        },
        {
          "#text": "Décret n°61-1195 du 31 octobre 1961 portant règlement d'administration publique pour l'application de la loi n° 60-708 du 22 juillet 1960 relative à la création de parcs nationaux",
          "@c_titre_court": "Décret n°61-1195 du 31 octobre 1961",
          "@debut": "1961-11-04",
          "@fin": "1989-11-04",
          "@id_txt": "LEGITEXT000006061003"
        }
      ],
      "TM": {
        "TITRE_TM": [
          {
            "#text": "Aménagement, réglementation et gestion des parcs nationaux",

      "TITRE_TXT": [
        {
          "#text": "Décret n°69-1048 du 19 novembre 1969 FIXANT LES MODALITES DE L'ENQUETE DEVANT PRECEDER L'INTERVENTION DES DECRETS OU ARRETES PREFECTORAUX PREVUS A L'ART. 17 DE LA LOI 641245 DU 16 décembre 1964",
          "@c_titre_court": "Décret n°69-1048 du 19 novembre 1969",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000518527"
        },
        {
          "#text": "Décret n°69-1048 du 19 novembre 1969 fixant les modalités de l'enquête devant précéder l'intervention des décrets ou arrêtés préfectoraux prévus à l'article 17 de la loi n° 64-1245 du 16 décembre 1964",
          "@c_titre_court": "Décret n°69-1048 du 19 novembre 1969",
          "@debut": "1969-11-22",

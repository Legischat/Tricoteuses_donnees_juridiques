  "NOTA": {
    "CONTENU": "<br/>  La présente version de cet article est en vigueur jusqu'au 1er janvier 2008.<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les dispositions des articles 3 à 8 du présent titre s'appliquent aux usages non domestiques de l'eau et aux usages visés à l'article 14-1-2° de la loi n° 64-1245 du 16 décembre 1964 *redevances, primes*.<br/>\n<br/>"
  },

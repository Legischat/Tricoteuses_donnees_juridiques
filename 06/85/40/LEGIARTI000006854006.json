        },
        {
          "#text": "Décret du 21 février 1852 relatif à la fixation des limites des affaires maritimes *anciennement l'inscription maritime* dans les fleuves et rivières affluant à la mer, et sur le domaine public maritime",
          "@c_titre_court": "Décret du 21 février 1852",
          "@debut": "1852-02-21",
          "@fin": "2010-05-08",
          "@id_txt": "LEGITEXT000006074284"
        }
      ],

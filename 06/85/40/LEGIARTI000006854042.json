        {
          "#text": "Décret n°73-193 du 13 février 1973 COMMISSION CHARGEE DE DONNER SON AVIS SUR LES OPERATIONS DESTINEES A ATTENUER LES NUISANCES SUBIES PAR LES RIVERAINS DES AERODROMES D'ORLY ET DE ROISSY-EN-FRANCE",
          "@c_titre_court": "Décret n°73-193 du 13 février 1973",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000693624"
        },
        {
          "#text": "Décret n°73-193 du 13 février 1973 instituant une taxe parafiscale en vue d'atténuer les nuisances subies par les riverains des aérodromes d'Orly et de Roissy-en-France.",
          "@c_titre_court": "Décret n°73-193 du 13 février 1973",
          "@debut": "1973-02-27",
          "@fin": "1984-01-01",
          "@id_txt": "LEGITEXT000006062055"

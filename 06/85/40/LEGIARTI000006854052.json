        {
          "#text": "Décret n°76-721 du 23 juillet 1976 RELATIF AU MONTANT MAXIMUM DU COUT DE REALISATION DE CONSTRUCTION ET D'AMENAGEMENT ET AU MONTANT DE LA DEPENSE SUBVENTIONNABLE DE CERTAINS ETABLISSEMENTS RELEVANT DU MINISTERE DE L'EDUCATION",
          "@c_titre_court": "Décret n°76-721 du 23 juillet 1976",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000503179"
        },
        {
          "#text": "Décret n°76-721 du 23 juillet 1976 relatif au montant maximum du coût de réalisation de construction et d'aménagement et au montant de la dépense subventionnable de certains établissements relevant du ministère de l'éducation.",
          "@c_titre_court": "Décret n°76-721 du 23 juillet 1976",
          "@debut": "1976-09-01",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006062517"

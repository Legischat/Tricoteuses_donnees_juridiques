        {
          "#text": "Décret n°74-945 du 6 novembre 1974 RELATIF AUX REJETS D'EFFLUENTS RADIOACTIFS GAZEUX PROVENANT DES INSTALLATIONS NUCLEAIRES DE BASE ET DES INSTALLATIONS NUCLEAIRES IMPLANTEES SUR LE MEME SITE",
          "@c_titre_court": "Décret n°74-945 du 6 novembre 1974",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000306569"
        },
        {
          "#text": "Décret n°74-945 du 6 novembre 1974 relatif aux rejets d'effluents radioactifs gazeux provenant des installations nucléaires de base et des installations nucléaires implantées sur le même site",
          "@c_titre_court": "Décret n°74-945 du 6 novembre 1974",

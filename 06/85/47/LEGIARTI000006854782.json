      "TITRE_TXT": [
        {
          "#text": "Décret du 2 novembre 1877 relatif aux poursuites à exercer contre tout Français qui se sera rendu coupable en Belgique de délits et de contraventions en matière forestière, rurale et de pêche.",
          "@c_titre_court": "Décret du 2 novembre 1877",
          "@debut": "1877-11-02",
          "@fin": "2007-12-22",

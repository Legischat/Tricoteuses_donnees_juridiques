        {
          "#text": "Décret n°81-964 du 21 octobre 1981 n° 81-964 portant abrogation de l'article R. 373-2 du code des communes et du décret n° 59-1081 du 31 août 1959 relatif au cahier des charges type pour l'entreprise de la collecte et de l'évacuation des ordures ménagères",
          "@c_titre_court": "Décret n°81-964 du 21 octobre 1981",
          "@debut": "1981-10-27",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006063611"
        }
      ],
      "@cid": "JORFTEXT000000519654",

    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret n°82-5 du 5 janvier 1982 L'ENTREE DE TOUT NAVIRE NUCLEAIRE ETRANGER DANS LES EAUX INTERIEURES ET LES PORTS FRANCAIS EST SUBORDONNEE A UNE AUTORISATION QUI EST DEMANDEE PAR L'ETAT DU PAVILLON AU MINISTRE DES RELATIONS EXTERIEURES FRANCAIS",
          "@c_titre_court": "Décret n°82-5 du 5 janvier 1982",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000519532"
        },
        {
          "#text": "Décret n°82-5 du 5 janvier 1982 pris pour l'application de la loi n° 65-956 du 12 novembre 1965 sur la responsabilité civile des exploitants de navires nucléaires.",
          "@c_titre_court": "Décret n°82-5 du 5 janvier 1982",
          "@debut": "1982-01-07",
          "@fin": "2016-12-30",
          "@id_txt": "LEGITEXT000006063804"
        }
      ],
      "@cid": "JORFTEXT000000519532",

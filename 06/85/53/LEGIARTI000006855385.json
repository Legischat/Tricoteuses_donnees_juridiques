      "TITRE_TXT": [
        {
          "#text": "Décret n°80-923 du 21 novembre 1980 PORTANT REGLEMENT NATIONAL DE LA PUBLICITE EN AGGLOMERATION ET DETERMINANT LES CONDITIONS D'APPLICATION A CERTAINS DISPOSITIFS PUBLICITAIRES D'UN REGIME D'AUTORISATION POUR L'APPLICATION DE LA LOI 79-1150 DU 29-12-1979 RELATIVE A LA PUBLICITE, AUX ENSEIGNES ET PREENSEIGNES.",
          "@c_titre_court": "Décret n°80-923 du 21 novembre 1980",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000681810"
        },
        {
          "#text": "Décret n°80-923 du 21 novembre 1980 portant règlement national de la publicité en agglomération et déterminant les conditions d'application à certains dispositifs publicitaires d'un régime d'autorisation pour l'application de la loi n° 79-1150 du 29 décembre 1979 relative à la publicité, aux enseignes et préenseignes.",
          "@c_titre_court": "Décret n°80-923 du 21 novembre 1980",
          "@debut": "1980-11-25",
          "@fin": "2007-10-16",
          "@id_txt": "LEGITEXT000006063355"
        }
      ],

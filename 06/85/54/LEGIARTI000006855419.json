      "TITRE_TXT": [
        {
          "#text": "Décret n°80-924 du 21 novembre 1980 FIXANT LA PROCEDURE D'INSTITUTION DES ZONES DE REGLEMENTATION SPECIALE PREVUE AUX ART. 6 ET 9 DE LA LOI 7961150 DU 29-12-1979 RELATIVE A LA PUBLICITE, AUX ENSEIGNES ET PREENSEIGNES.",
          "@c_titre_court": "Décret n°80-924 du 21 novembre 1980",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000681589"
        },
        {
          "#text": "Décret n°80-924 du 21 novembre 1980 fixant la procédure d'institution des zones de réglementation spéciale prévues aux articles 6 et 9 de la loi n° 79-1150 du 29 décembre 1979 relative à la publicité aux enseignes et préenseignes",
          "@c_titre_court": "Décret n°80-924 du 21 novembre 1980",
          "@debut": "1980-11-25",
          "@fin": "2007-10-16",

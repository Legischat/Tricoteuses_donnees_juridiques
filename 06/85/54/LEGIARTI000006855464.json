      "TITRE_TXT": [
        {
          "#text": "Décret n°82-220 du 25 février 1982 SURFACE MINIMALE ET EMPLACEMENTS DE L'AFFICHAGE D'OPINION ET A LA PUBLICITE DES ASSOCIATIONS SANS BUT LUCRATIF DANS CHAQUE COMMUNE;SURFACE DE CHAQUE EMPLACEMENT AUTORISEE PAR LE MAIRE SUR LES PALISSADES DE CHANTIER DANS LE CAS OU LA PUBLICITE EST INTERDITE",
          "@c_titre_court": "Décret n°82-220 du 25 février 1982",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000332878"
        },
        {
          "#text": "Décret n°82-220 du 25 février 1982 portant application de la loi n° 79-1150 du 29 décembre 1979 relative à la publicité, aux enseignes et préenseignes en ce qui concerne la surface minimale et les emplacements de l'affichage d'opinion et des associations sans but lucratif",
          "@c_titre_court": "Décret n°82-220 du 25 février 1982",
          "@debut": "1982-03-04",
          "@fin": "2007-10-16",
          "@id_txt": "LEGITEXT000006063712"
        }
      ],
      "@cid": "JORFTEXT000000332878",
      "@date_publi": "1982-03-04",
      "@date_signature": "1982-02-25",
      "@nature": "DECRET",
      "@num": "82-220"
    }
  },

      "TITRE_TXT": [
        {
          "#text": "Décret n°82-764 du 6 septembre 1982 REGLEMENTANT L'USAGE DES VEHICULES A DES FINS ESSENTIELLEMENT PUBLICITAIRES ET PRIS EN APPLICATION DE L'ART. 14 DE LA LOI 79-1150 DU 29-12-1979 RELATIVE A LA PUBLICITE,AUX ENSEIGNES ET PREENSEIGNES.",
          "@c_titre_court": "Décret n°82-764 du 6 septembre 1982",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000883855"
        },
        {
          "#text": "Décret n°82-764 du 6 septembre 1982 réglementant l'usage de véhicules à des fins essentiellement publicitaires et pris en application de l'article 14 de la loi n° 79-1150 du 29 décembre 1979 relative à la publicité, aux enseignes et préenseignes.",
          "@c_titre_court": "Décret n°82-764 du 6 septembre 1982",
          "@debut": "1982-09-07",
          "@fin": "2007-10-16",
          "@id_txt": "LEGITEXT000006063884"
        }
      ],
      "@cid": "JORFTEXT000000883855",
      "@date_publi": "1982-09-07",
      "@date_signature": "1982-09-06",
      "@nature": "DECRET",
      "@num": "82-764"
    }
  },

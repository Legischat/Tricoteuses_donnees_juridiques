  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Aucun navire français ne peut prendre la mer sans être muni des titres de sécurité et de prévention de la pollution délivrés dans les conditions prévues au présent décret.<br/>\n<br/>"
  },

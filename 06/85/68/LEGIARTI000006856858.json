      "TITRE_TXT": [
        {
          "#text": "Décret n°85-1307 du 9 décembre 1985 FIXANT LES CONDITIONS D'AUTORISATION D'INTRODUCTION DANS LES EAUX VISEES A L'ART. 413 DU CODE RURAL DE POISSONS,DE CRUSTACES ET DE GRENOUILLES APPARTENANT A DES ESPECES QUI N'Y SONT PAS REPRESENTEES",
          "@c_titre_court": "Décret n°85-1307 du 9 décembre 1985",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000328405"
        },
        {
          "#text": "Décret n°85-1307 du 9 décembre 1985 fixant les conditions d'autorisation d'introduction dans les eaux visées à l'article 413 du code rural de poissons, de crustacés et de grenouilles appartenant à des espèces qui n'y sont pas représentées",
          "@c_titre_court": "Décret n°85-1307 du 9 décembre 1985",
          "@debut": "1986-01-01",
          "@fin": "1989-11-04",
          "@id_txt": "LEGITEXT000006064783"
        }
      ],

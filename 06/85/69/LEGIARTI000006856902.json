        {
          "#text": "Décret n°85-1370 du 20 décembre 1985 PRIS POUR L'APPLICATION DE L'ART. 404 DU CODE RURAL,FIXANT LES CONDITIONS DE L'APPLICATION DU TITRE II DU LIVRE III DU CODE RURAL AUX PLANS D'EAU NON VISES A L'ART. 402",
          "@c_titre_court": "Décret n°85-1370 du 20 décembre 1985",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000688341"
        },
        {
          "#text": "Décret n°85-1370 du 20 décembre 1985 pris pour l'application de l'article 404 du code rural, fixant les conditions de l'application du titre II du livre III du code rural aux plans d'eau non visés à l'article 402",
          "@c_titre_court": "Décret n°85-1370 du 20 décembre 1985",

      "TITRE_TXT": [
        {
          "#text": "Décret n°85-1400 du 27 décembre 1985 FIXANT LES FORMES ET LES CONDITIONS DES CONCESSIONS ET AUTORISATIONS DE PISCICULTURE ET LES MODALITES DE DECLARATION DES PLANS D'EAU EXISTANTS MENTIONNES A L'ART. 433 DU CODE RURAL",
          "@c_titre_court": "Décret n°85-1400 du 27 décembre 1985",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000508152"
        },
        {
          "#text": "Décret n°85-1400 du 27 décembre 1985 fixant les formes et les conditions des concessions et autorisations de pisciculture et les modalités de déclaration des plans d'eau existants mentionnés à l'article 433 du code rural",
          "@c_titre_court": "Décret n°85-1400 du 27 décembre 1985",
          "@debut": "1985-12-29",
          "@fin": "2005-08-05",
          "@id_txt": "LEGITEXT000006064831"
        }
      ],

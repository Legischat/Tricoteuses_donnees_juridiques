      "TITRE_TXT": [
        {
          "#text": "Décret n°86-198 du 6 février 1986 RELATIF A LA REPRESSION DE CERTAINES INFRACTIONS AU TITRE II DU LIVRE III DU CODE RURAL ET A L'EXERCICE DE LA POLICE DE LA PECHE ET DU POUVOIR DE TRANSACTION",
          "@c_titre_court": "Décret n°86-198 du 6 février 1986",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000332762"
        },
        {
          "#text": "Décret n°86-198 du 6 février 1986 relatif à la répression de certaines infractions au titre II du livre III du code rural et à l'exercice de la police de la pêche et du pouvoir de transaction.",
          "@c_titre_court": "Décret n°86-198 du 6 février 1986",
          "@debut": "1986-02-12",
          "@fin": "1989-11-04",

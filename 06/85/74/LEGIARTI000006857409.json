        {
          "#text": "Décret n°87-388 du 10 juin 1987 PRIS POUR L'APPLICATION DE L'ART. 437-10 DU CODE RURAL ET DETERMINANT LES CONDITIONS DE CLASSEMENT DES COURS D'EAU,CANAUX ET PLANS D'EAU EN DEUX CATEGORIES",
          "@c_titre_court": "Décret n°87-388 du 10 juin 1987",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000332565"
        },
        {
          "#text": "Décret n°87-388 du 10 juin 1987 pris pour l'application de l'article 437-10° du code rural et déterminant les conditions de classement des cours d'eau, canaux et plans d'eau en deux catégories",
          "@c_titre_court": "Décret n°87-388 du 10 juin 1987",
          "@debut": "1987-06-16",

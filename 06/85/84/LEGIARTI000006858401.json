    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret n°88-1063 du 25 novembre 1988 RELATIF A L'UTILISATION DU RELIQUAT DES FONDS PERCUS AU TITRE DE LA TAXE PARAFISCALE INSTITUEE POUR L'ATTENUATION DES NUISANCES PHONIQUES SUBIES PAR LES RIVERAINS DES AERODROMES D'ORLY ET CHARLES-DE-GAULLE",
          "@c_titre_court": "Décret n°88-1063 du 25 novembre 1988",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000504296"
        },
        {
          "#text": "Décret n°88-1063 du 25 novembre 1988 relatif à l'utilisation du reliquat des fonds perçus au titre de la taxe parafiscale instituée pour l'atténuation des nuisances phoniques subies par les riverains des aérodromes d'Orly et Charles-de-Gaulle",
          "@c_titre_court": "Décret n°88-1063 du 25 novembre 1988",
          "@debut": "1988-11-27",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006066320"
        }
      ],
      "@cid": "JORFTEXT000000504296",

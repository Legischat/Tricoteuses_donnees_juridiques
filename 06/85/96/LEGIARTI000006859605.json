      "TITRE_TXT": [
        {
          "#text": "Arrêté du 10 août 1976 relatif aux rejets d'effluents radioactifs gazeux provenant des installations nucléaires et aux conditions de l'enquête publique prévues par l'article 5 du décret 945 du 6 novembre 1974",
          "@c_titre_court": "Arrêté du 10 août 1976",
          "@debut": "1976-09-12",

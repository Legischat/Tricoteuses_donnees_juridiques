      "TITRE_TXT": [
        {
          "#text": "Arrêté du 10 août 1976 relatif aux conditions dans lesquelles doit être effectuée l'étude préliminaire en vue de la demande d'autorisation de rejet d'effluents radioactifs liquides provenant des installations nucléaires",
          "@c_titre_court": "Arrêté du 10 août 1976",

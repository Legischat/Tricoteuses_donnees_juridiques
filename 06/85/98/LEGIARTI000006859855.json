      "TITRE_TXT": [
        {
          "#text": "Arrêté du 13 mai 1975 CONDITIONS DANS LESQUELLES CERTAINS DEVERSEMENTS, ECOULEMENTS JETS ET DEPOTS DE NOCIVITE NEGLIGEABLE SONT EXEMPTES DE L'AUTORISATION PREVUE PAR LE DECRET 73-218 DU 23 février 1973",
          "@c_titre_court": "Arrêté du 13 mai 1975",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000833914"
        },
        {
          "#text": "Arrêté du 13 mai 1975 relatif aux conditions dans lesquelles certains déversements, jets et dépôts de nocivité négligeable sont exemptés de l'autorisation prévue par le décret n. 73-218 du 23 Février 1973 portant application des articles 2 et 6 (1.) de la loi n. 64-1245 du 16 décembre 1964",
          "@c_titre_court": "Arrêté du 13 mai 1975",
          "@debut": "1975-05-18",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006074361"
        }
      ],

      "TITRE_TXT": [
        {
          "#text": "Arrêté du 21 août 1978 CARACTERISTIQUES AUXQUELLES DOIVENT SATISFAIRE LES INSTALLATIONS FIXES OU MOBILES DES ETABLISSEMENTS PRESENTANT AU PUBLIC DES SPECIMENS VIVANTS DE LA FAUNE LOCALE OU ETRANGERE",
          "@c_titre_court": "Arrêté du 21 août 1978",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000487355"
        },
        {
          "#text": "Arrêté du 21 août 1978 fixant les caractéristiques auxquelles doivent satisfaire les installations fixes ou mobiles des établissements présentant au public des spécimens vivants de la faune locale ou étrangère",
          "@c_titre_court": "Arrêté du 21 août 1978",
          "@debut": "1978-10-14",
          "@fin": "2011-04-06",
          "@id_txt": "LEGITEXT000006074389"
        }
      ],

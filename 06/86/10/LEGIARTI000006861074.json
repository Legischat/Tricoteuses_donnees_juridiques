          "@debut": "1974-03-22",
          "@fin": "2004-07-26",
          "@id_txt": "LEGITEXT000006074437"
        }
      ],
      "TM": {
        "TITRE_TM": [
          {
            "#text": "Règles d'implantation du stockage.",

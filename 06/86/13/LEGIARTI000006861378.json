      "TITRE_TXT": [
        {
          "#text": "Arrêté du 30 juin 1975 MODALITES DE DELIVRANCE, DE VISA ET DE VALIDATION DU PERMIS DE CHASSER ET DE PROCEDURES DE VERSEMENT A L'OFFICE NATIONAL DE LA CHASSE DES REDEVANCES CYNEGETIQUES LUI REVENANT",
          "@c_titre_court": "Arrêté du 30 juin 1975",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000641994"
        },
        {
          "#text": "Arrêté du 30 juin 1975 fixant les modalités de délivrance, de visa et de validation du permis de chasser et de procédure de versement à l'office national de la chasse des redevances cynégétiques lui revenant",
          "@c_titre_court": "Arrêté du 30 juin 1975",

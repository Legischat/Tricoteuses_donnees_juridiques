          "@id_txt": "JORFTEXT000000287971"
        },
        {
          "#text": "Arrêté du 28 octobre 1975 pris en exécution des articles 3, 5, 6, 10, 11 et 15 du décret n° 75-996 du 28 octobre 1975 portant application des dispositions de l'article 14-1 de la loi du 16 décembre 1964 modifiée relative au régime et à la répartition des eaux et à la lutte contre leur pollution",
          "@c_titre_court": "Arrêté du 28 octobre 1975",
          "@debut": "1997-01-11",
          "@fin": "2008-01-01",
          "@id_txt": "LEGITEXT000006074514"
        }
      ],
      "TM": {
        "TITRE_TM": [
          {
            "#text": "Dispositions relatives aux usages non domestiques de l'eau et aux usages des abonnés occasionnant une pollution spéciale",

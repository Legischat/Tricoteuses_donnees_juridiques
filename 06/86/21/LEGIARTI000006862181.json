  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Arrêté du 27 mars 1973 REGLES DE REPARTITION DU PRODUIT DE LA TAXE PARAFISCALE INSTITUEE EN VUE D'ATTENUER LES NUISANCES SUBIES PAR LES RIVERAINS DES AERODROMES D'ORLY ET DE ROISSY-EN-FRANCE. LIMITES ET CONDITIONS DANS LESQUELLES PEUVENT ETRE EFFECTUEES LES DEPENSES",
          "@c_titre_court": "Arrêté du 27 mars 1973",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000638092"
        },
        {
          "#text": "Arrêté du 27 mars 1973 fixant les règles de répartition du produit de la taxe parafiscale instituée en vue d'atténuer les nuisances subies par les riverains des aérodromes d'Orly et de Roissy-en-France, limites et conditions dans lesquelles peuvent être effectuées les dépenses.",
          "@c_titre_court": "Arrêté du 27 mars 1973",
          "@debut": "1973-04-03",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006074545"
        }
      ],
      "@cid": "JORFTEXT000000638092",
      "@date_publi": "1973-04-03",
      "@date_signature": "1973-03-27",
      "@nature": "ARRETE"
    }
  },

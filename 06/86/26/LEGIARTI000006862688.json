  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Arrêté du 8 mai 1981 DANS LA REGION D'ILE-DE-FRANCE,LE SERVICE VISE A L'ART. 3 DU DECRET 81-481 DU 08-05-1981 (SERVICE REGIONAL CHARGE D'ASSURER LA COORDINATION DES DIFFERENTES ACTIONS DANS LE DOMAINE DE LA POLICE ET DE LA GESTION DES EAUX) EST LA DIRECTION REGIONALE DE L'EQUIPEMENT D'ILE-DE-FRANCE",
          "@c_titre_court": "Arrêté du 8 mai 1981",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000865961"
        },
        {
          "#text": "Arrêté du 8 mai 1981 relatif à l'application de l'article 3 du décret n° 81-481 du 8 mai 1981 relatif à l'organisation de l'administration dans le domaine de l'eau",
          "@c_titre_court": "Arrêté du 8 mai 1981",
          "@debut": "1981-05-13",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006074576"

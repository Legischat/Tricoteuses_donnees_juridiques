    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Arrêté du 15 janvier 1974 MODIFICATION DANS CERTAINS DEPARTEMENTS, POUR L'ANNEE 1974, DES PERIODES D'INTERDICTION SPECIFIQUE DE LA PECHE DU SAUMON ET INTERDICTION DE TOUTE PECHE DU SAUMON DANS UNE SECTION DE L'ALLIER",
          "@c_titre_court": "Arrêté du 15 janvier 1974",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000643592"
        },
        {
          "#text": "Arrêté du 15 janvier 1974 portant modification dans certains départements, pour l'année 1974, des périodes d'interdiction spécifique de la pêche du saumon et interdiction de toute pêche du saumon dans une section de l'Allier.",
          "@c_titre_court": "Arrêté du 15 janvier 1974",
          "@debut": "1974-01-18",
          "@fin": "1974-12-31",
          "@id_txt": "LEGITEXT000006074592"
        }
      ],
      "@cid": "JORFTEXT000000643592",

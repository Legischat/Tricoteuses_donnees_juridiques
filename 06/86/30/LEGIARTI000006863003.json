  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Arrêté du 11 février 1982 PROLONGATION DANS TOUS LES DEPARTEMENTS DE LA PERIODE D'INTERDICTION SPECIFIQUE DE LA PECHE DU SAUMON BECART OU SAUMON DE DESCENTE ET INTERDICTION DE LA PECHE DU SAUMON,DE CERTAINS AUTRES SALMINODES OU DE TOUS POISSONS SUR DIVERS COURS D'EAU PENDANT L'ANNEE 1982",
          "@c_titre_court": "Arrêté du 11 février 1982",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000864864"
        },
        {
          "#text": "Arrêté du 11 février 1982 prolongeant dans tous les départements la période d'interdiction spécifique de la pêche du saumon bécart ou saumon de descente et interdisant la pêche du saumon, de certains autres salmonidés ou de tous poissons sur divers cours d'eau ou sections de cours d'eau pendant l'année 1982",
          "@c_titre_court": "Arrêté du 11 février 1982",
          "@debut": "1982-03-03",
          "@fin": "1982-12-31",
          "@id_txt": "LEGITEXT000006074620"
        }
      ],
      "TM": {
        "TITRE_TM": [
          {
            "#text": "Etat des eaux dans lesquelles est interdite toute pêche des espèces désignées, par quelque mode que ce soit, pendant l'année 1982",
            "@debut": "1982-03-03",
            "@fin": "1982-12-31",
            "@id": "LEGISCTA000006110253"
          }
        ]
      },

  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Arrêté du 3 mars 1982 relatif aux règles de construction et d'installation des fosses septiques et appareils utilisés en matière d'assainissement autonome des bâtiments d'habitation",
          "@c_titre_court": "Arrêté du 3 mars 1982",
          "@debut": "1982-04-09",
          "@fin": "1996-06-08",
          "@id_txt": "LEGITEXT000006074621"
        }
      ],
      "TM": {
        "TITRE_TM": [
          {
            "#text": "Maisons d'habitation individuelles",
            "@debut": "1982-04-09",
            "@fin": "1996-06-08",
            "@id": "LEGISCTA000006110254"
          }
        ],
        "TM": {
          "TITRE_TM": [
            {
              "#text": "Caractéristiques des dispositifs mis en oeuvre dans les filières d'assainissement",
              "@debut": "1982-04-09",
              "@fin": "1996-06-08",
              "@id": "LEGISCTA000006130264"
            }
          ],
          "TM": {
            "TITRE_TM": [
              {
                "#text": "Dispositifs assurant à la fois l'épuration et l'évacuation des effluents par l'utilisation du sol",

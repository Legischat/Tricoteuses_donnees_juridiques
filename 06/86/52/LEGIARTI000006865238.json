    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Arrêté du 4 septembre 1986 PORTANT APPLICATION DANS LES ETABLISSEMENTS DU MINISTERE DE LA DEFENSE DU DECRET 79846 DU 28-09-1979 RELATIF A LA PROTECTION DES TRAVAILLEURS CONTRE LES RISQUES PARTICULIERS AUXQUELS ILS SONT SOUMIS DANS LES ETABLISSEMENTS PYROTECHNIQUES",
          "@c_titre_court": "Arrêté du 4 septembre 1986",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000682586"
        },
        {
          "#text": "Arrêté du 4 septembre 1986 portant application dans les établissements du ministère de la défense du décret n° 79-846 du 28 septembre 1979 relatif à la protection des travailleurs contre les risques particuliers auxquels ils sont soumis dans les établissements pyrotechniques",
          "@c_titre_court": "Arrêté du 4 septembre 1986",

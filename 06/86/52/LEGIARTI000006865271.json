      "TITRE_TXT": [
        {
          "#text": "Arrêté du 7 novembre 1985 relatif à la limitation des quantités de plomb et de cadmium extractibles des objets en céramique mis ou destinés à être mis au contact des denrées, produits et boissons alimentaires",
          "@c_titre_court": "Arrêté du 7 novembre 1985",
          "@debut": "1985-12-01",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006074853"
        }
      ],

      "TITRE_TXT": [
        {
          "#text": "Arrêté du 15 septembre 1986 fixant les règles techniques auxquelles doivent satisfaire au titre de la protection de l'environnement les élevages d'animaux carnassiers à fourrure",
          "@c_titre_court": "Arrêté du 15 septembre 1986",
          "@debut": "1986-11-13",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006074852"
        }
      ],
      "TM": {
        "TITRE_TM": [
          {
            "#text": "Règles techniques applicables aux élevages de carnassiers à fourrure (visons)soumis à autorisation (plus de 2000 animaux) Rubrique 58-7°.",
            "@debut": "1986-11-13",

  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Morceaux de découpe de viande bovine dont l'attendrissage est autorisé.<br/>\n<br/>   Quartier avant :<br/>\n<br/>   - Macreuse à braiser ;<br/>\n<br/>   - Basse côte ;<br/>\n<br/>   - Premier talon ;<br/>\n<br/>   - Second talon ;<br/>\n<br/>   - Veine grasse.<br/>\n<br/>   Quartier arrière :<br/>\n<br/>   - Tende de tranche ou tranche à rôtir ;<br/>\n<br/>   - Dessous de tranche ;<br/>\n<br/>   - Merlan ;<br/>\n<br/>   - Mouvant de tranche grasse ;<br/>\n<br/>   - Plat de tranche grasse ;<br/>\n<br/>   - Aiguillette baronne ;<br/>\n<br/>   - Gîte à la noix ;<br/>\n<br/>   - Rond de gîte à la noix.<br/>"
  },

      "TITRE_TXT": [
        {
          "#text": "Décret no 97-857 du 12 septembre 1997 fixant les conditions à remplir pour    l'introduction ou la circulation de certains organismes nuisibles, végétaux,    produits végétaux et autres objets pour des travaux à des fins d'essai ou à    des fins scientifiques ou pour des travaux sur les sélections variétales",
          "@c_titre_court": "Décret n°97-857 du 12 septembre 1997",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000567719"
        },
        {
          "#text": "Décret n°97-857 du 12 septembre 1997 fixant les conditions à remplir pour l'introduction ou la circulation de certains organismes nuisibles, végétaux, produits végétaux et autres objets pour des travaux à des fins d'essai ou à des fins scientifiques ou pour des travaux sur les sélections variétales",

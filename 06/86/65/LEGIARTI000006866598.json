      "TITRE_TXT": [
        {
          "#text": "Arrêté du 31 décembre 1985 portant application des dispositions du décret n° 82-1009 du 26 novembre 1982 relatif aux indemnités susceptibles d'être allouées au président, au vice-président, aux membres et aux rapporteurs de la commission des clauses abusives",
          "@c_titre_court": "Arrêté du 31 décembre 1985",
          "@debut": "1986-01-09",
          "@fin": "1989-01-01",
          "@id_txt": "LEGITEXT000006074871"

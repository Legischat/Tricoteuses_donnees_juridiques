      "TITRE_TXT": [
        {
          "#text": "Décret no 98-1143 du 15 décembre 1998 relatif aux prescriptions applicables aux établissements ou locaux recevant du public et diffusant à titre habituel de la musique amplifiée, à l'exclusion des salles dont l'activité est réservée à l'enseignement de la musique et de la danse",
          "@c_titre_court": "Décret n°98-1143 du 15 décembre 1998",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000197582"
        },
        {
          "#text": "Décret n°98-1143 du 15 décembre 1998 relatif aux prescriptions applicables aux établissements ou locaux recevant du public et diffusant à titre habituel de la musique amplifiée, à l'exclusion des salles dont l'activité est réservée à l'enseignement de la musique et de la danse",

      "TITRE_TXT": [
        {
          "#text": "Décret n°70-207 du 9 mars 1970 RELATIF AU PILOTAGE DES BATEAUX, CONVOIS ET AUTRES ENGINS FLOTTANTS FLUVIAUX QUI EFFECTUENT UNE NAVIGATION EN MER, DANS LES PORTS ET RADES, SUR LES ETANGS OU CANAUX SALES DEPENDANT DU DOMAINE PUBLIC MARITIME ET DANS LES ESTUAIRES, FLEUVES, RIVIERES ET CANAUX EN AVAL DU PREMIER OBSTACLE A LA NAVIGATION DES BATIMENTS DE MER",
          "@c_titre_court": "Décret n°70-207 du 9 mars 1970",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000851920"
        },
        {
          "#text": "Décret n°70-207 du 9 mars 1970 relatif au pilotage des bateaux, convois et autres engins flottants fluviaux qui effectuent une navigation en mer, dans les ports et rades, sur les étangs ou canaux salés dépendant du domaine public maritime et dans les estuaires, fleuves, rivières et canaux en aval du premier obstacle à la navigation des bâtiments de mer.",
          "@c_titre_court": "Décret n°70-207 du 9 mars 1970",
          "@debut": "1970-03-17",
          "@fin": "2010-11-07",
          "@id_txt": "LEGITEXT000006061726"
        }
      ],

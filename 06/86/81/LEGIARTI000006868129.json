  "BLOC_TEXTUEL": {
    "CONTENU": "<p align=\"center\">DÉNOMINATIONS DES MORCEAUX DE VIANDE DE VEAU</p>\n<table>\n<tbody>\n<tr>\n<td width=\"359\">\n<p align=\"center\">DÉNOMINATIONS<br/>obligatoires</p>\n</td>\n<td width=\"378\">\n<p align=\"center\">MENTIONS COMPLÉMENTAIRES<br/>facultatives</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"359\">\n<p align=\"left\">Filet (*).</p>\n</td>\n<td valign=\"top\" width=\"378\"/>\n</tr>\n<tr>\n<td rowspan=\"2\" valign=\"top\" width=\"359\">\n<p align=\"left\">Noix (*).</p>\n</td>\n<td valign=\"top\" width=\"378\">\n<p align=\"left\">Noix pâtissière.</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"378\">\n<p align=\"left\">Sous-noix.</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"359\">\n<p align=\"left\">Quasi (*).</p>\n</td>\n<td valign=\"top\" width=\"378\">\n<p align=\"left\"> </p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"359\">\n<p align=\"left\">Côte filet.</p>\n</td>\n<td valign=\"top\" width=\"378\">\n<p align=\"left\"> </p>\n</td>\n</tr>\n<tr>\n<td rowspan=\"2\" valign=\"top\" width=\"359\">\n<p align=\"left\">Côte.</p>\n</td>\n<td valign=\"top\" width=\"378\">\n<p align=\"left\">Côte première.</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"378\">\n<p align=\"left\">Côte seconde.</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"359\">\n<p align=\"left\">Longe.</p>\n</td>\n<td valign=\"top\" width=\"378\">\n<p align=\"left\"> </p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"359\">\n<p align=\"left\">Côte découverte.</p>\n</td>\n<td valign=\"top\" width=\"378\">\n<p align=\"left\">Bas de carré.</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"359\">\n<p align=\"left\">Collier.</p>\n</td>\n<td valign=\"top\" width=\"378\">\n<p align=\"left\">Bas de carré.</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"359\">\n<p align=\"left\">Epaule (*).</p>\n</td>\n<td valign=\"top\" width=\"378\">\n<p align=\"left\"> </p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"359\">\n<p align=\"left\">Jarret.</p>\n</td>\n<td valign=\"top\" width=\"378\">\n<p align=\"left\"> </p>\n</td>\n</tr>\n<tr>\n<td rowspan=\"2\" valign=\"top\" width=\"359\">\n<p align=\"left\">Poitrine.</p>\n</td>\n<td valign=\"top\" width=\"378\">\n<p align=\"left\">Tendron.</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"378\">\n<p align=\"left\">Flanchet.</p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" width=\"737\">\n<p align=\"left\">(*) Cette dénomination peut être complétée par le terme \"escalope\".</p>\n</td>\n</tr>\n</tbody>\n</table>\n<p align=\"left\"> </p>\n<p align=\"left\"> </p>\n<p align=\"left\"> </p>"

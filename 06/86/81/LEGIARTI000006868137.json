  "BLOC_TEXTUEL": {
    "CONTENU": "<p align=\"center\">DÉNOMINATIONS DES MORCEAUX DE VIANDE DE MOUTON ET D'AGNEAU</p>\n<table>\n<tbody>\n<tr>\n<td width=\"359\">\n<p align=\"center\">DÉNOMINATIONS<br/>obligatoires</p>\n</td>\n<td width=\"378\">\n<p align=\"center\">MENTIONS COMPLÉMENTAIRES<br/>facultatives</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"359\">\n<p align=\"left\">Gigot.</p>\n</td>\n<td valign=\"top\" width=\"378\"/>\n</tr>\n<tr>\n<td valign=\"top\" width=\"359\">\n<p align=\"left\">Gigot raccourci.</p>\n</td>\n<td valign=\"top\" width=\"378\"/>\n</tr>\n<tr>\n<td valign=\"top\" width=\"359\">\n<p align=\"left\">Selle.</p>\n</td>\n<td valign=\"top\" width=\"378\"/>\n</tr>\n<tr>\n<td valign=\"top\" width=\"359\">\n<p align=\"left\">Filet.</p>\n</td>\n<td valign=\"top\" width=\"378\"/>\n</tr>\n<tr>\n<td valign=\"top\" width=\"359\">\n<p align=\"left\">Faux filet.</p>\n</td>\n<td valign=\"top\" width=\"378\"/>\n</tr>\n<tr>\n<td valign=\"top\" width=\"359\">\n<p align=\"left\">Côte filet (1).</p>\n</td>\n<td valign=\"top\" width=\"378\">\n<p align=\"left\">\"Simple\" ou \"Double\".</p>\n</td>\n</tr>\n<tr>\n<td rowspan=\"2\" valign=\"top\" width=\"359\">\n<p align=\"left\">Côte (1).</p>\n</td>\n<td valign=\"top\" width=\"378\">\n<p align=\"left\">Côte première.</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"378\">\n<p align=\"left\">Côte seconde.</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"359\">\n<p align=\"left\">Côte découverte (1).</p>\n</td>\n<td valign=\"top\" width=\"378\">\n<p align=\"left\"> </p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"359\">\n<p align=\"left\">Carré (2).</p>\n</td>\n<td valign=\"top\" width=\"378\">\n<p align=\"left\"> </p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"359\">\n<p align=\"left\">Epaule.</p>\n</td>\n<td valign=\"top\" width=\"378\">\n<p align=\"left\"> </p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"359\">\n<p align=\"left\">Epaule semi-désossée.</p>\n</td>\n<td valign=\"top\" width=\"378\">\n<p align=\"left\"> </p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"359\">\n<p align=\"left\">Collier.</p>\n</td>\n<td valign=\"top\" width=\"378\">\n<p align=\"left\"> </p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"359\">\n<p align=\"left\">Poitrine.</p>\n</td>\n<td valign=\"top\" width=\"378\">\n<p align=\"left\">Haut de côte.</p>\n</td>\n</tr>\n<tr>\n<td colspan=\"2\" width=\"737\">\n<p align=\"left\">(1) Le remplacement du terme \"côtes\" par \"côtelettes\" est admis.</p>\n<p align=\"left\">(2) La dénomination doit être complétée par le nom des côtes, lorsque le carré n'est pas entier.</p>\n</td>\n</tr>\n</tbody>\n</table>\n<p align=\"left\"> </p>\n<p align=\"left\"> </p>\n<p align=\"left\"> </p>\n<p align=\"left\"> </p>"
  }

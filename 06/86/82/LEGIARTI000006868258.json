        {
          "#text": "Décret n°78-67 du 16 janvier 1978 PRIS POUR L'APPLICATION DES ARTICLES 10, 11 ET 38 DE LA LOI 77-2 DU 3 JANVIER 1977 ET RELATIF AUX CONDITIONS REQUISES POUR L'INSCRIPTION AU TABLEAU REGIONAL D'ARCHITECTES",
          "@c_titre_court": "Décret n°78-67 du 16 janvier 1978",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000879767"
        },
        {
          "#text": "Décret n°78-67 du 16 janvier 1978 pris pour l'application des articles 10, 11 et 38 de la loi n° 77-2 du 3 janvier 1977 sur l'architecture et relatif aux conditions requises pour l'inscription au tableau régional d'architectes.",
          "@c_titre_court": "Décret n°78-67 du 16 janvier 1978",
          "@debut": "1978-01-24",
          "@fin": "2010-01-01",
          "@id_txt": "LEGITEXT000006062903"

  "BLOC_TEXTUEL": {
    "CONTENU": "BOÎTE DE SECOURS<br/>\n DÉSIGNATION<br/>\n QUANTITÉ<br/>\n<br/>\n<br/>\n Pansements stériles prêts à l'emploi :<br/>\n<br/>   - grand format<br/>\n 1 pochette <br/>\n<br/>   - petit format<br/>\n 1 pochette <br/>\n Compresses stérilisées<br/>\n 1 boîte <br/>\n Sutures cutanées adhésives stériles<br/>\n 1 boîte <br/>\n Sparadrap adhésif<br/>\n 1 rouleau <br/>\n Antiseptique local en solution ou compresses imprégnées<br/>\n 1 flacon ou 1 boîte <br/>\n Eau oxygénée<br/>\n 1 flacon <br/>\n Tulle gras<br/>\n 1 pochette <br/>\n Bande de contention :<br/>\n<br/>   - petite largeur<br/>\n 1 bande <br/>\n<br/>   - grande largeur<br/>\n 1 bande <br/>"
  },

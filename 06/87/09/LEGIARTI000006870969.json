  "BLOC_TEXTUEL": {
    "CONTENU": "<p align=\"center\">MÉTHODES DE MESURE DE RÉFÉRENCE (ART. 16-1) </p>\n<table align=\"center\" border=\"1\" cellpadding=\"0\" cellspacing=\"0\">\n<tbody>\n<tr>\n<td width=\"183\">\n<p>Qualité de l'air ambiant :</p>\n</td>\n<td width=\"195\">\n<p align=\"center\"> </p>\n</td>\n</tr>\n<tr>\n<td width=\"183\">\n<p>CO</p>\n</td>\n<td width=\"195\">\n<p align=\"center\">NF X 43 012.</p>\n</td>\n</tr>\n<tr>\n<td width=\"183\">\n<p>SO<sub>2</sub>\n</p>\n</td>\n<td width=\"195\">\n<p align=\"center\">NF X 43 019 et NF X 43 013.</p>\n</td>\n</tr>\n<tr>\n<td width=\"183\">\n<p>NO<sub>z</sub>\n</p>\n</td>\n<td width=\"195\">\n<p align=\"center\">NF X 43 018 et NF X 43 009.</p>\n</td>\n</tr>\n<tr>\n<td width=\"183\">\n<p>Hydrocarbures totaux</p>\n</td>\n<td width=\"195\">\n<p align=\"center\">NF X 43 025.</p>\n</td>\n</tr>\n<tr>\n<td width=\"183\">\n<p>Odeurs</p>\n</td>\n<td width=\"195\">\n<p align=\"center\">NF X 43 101 à X 43 104.</p>\n</td>\n</tr>\n<tr>\n<td width=\"183\">\n<p>Poussières</p>\n</td>\n<td width=\"195\">\n<p align=\"center\">NF X 43 021 et NF X 43 023 et NF X 43 017.</p>\n</td>\n</tr>\n<tr>\n<td width=\"183\">\n<p>O<sub>3</sub>\n</p>\n</td>\n<td width=\"195\">\n<p align=\"center\">XP X 43 024.</p>\n</td>\n</tr>\n<tr>\n<td width=\"183\">\n<p>Pb</p>\n</td>\n<td width=\"195\">\n<p align=\"center\">NF X 43 026 et NF X43 027.</p>\n</td>\n</tr>\n</tbody>\n</table>"

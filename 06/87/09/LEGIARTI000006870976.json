  "BLOC_TEXTUEL": {
    "CONTENU": "<p align=\"center\">SUBSTANCES SUSCEPTIBLES D'AVOIR DES EFFETS NÉFASTES POUR L'ENVIRONNEMENT <br/>VISÉES AU 4 DU 2° DE L'ARTICLE 12 (1.2) </p>\n<p>\n<br/>\n</p>\n<table align=\"center\" border=\"1\" cellpadding=\"0\" cellspacing=\"0\">\n<tbody>\n<tr>\n<td width=\"89\">\n<p align=\"center\">N° LISTE I<br/>directive<br/>76/464/CEE</p>\n</td>\n<td width=\"289\">\n<p align=\"center\">NOMS</p>\n</td>\n</tr>\n<tr>\n<td width=\"90\">\n<p align=\"center\">14</p>\n</td>\n<td width=\"288\">\n<p>Hydrate de chloral.</p>\n</td>\n</tr>\n<tr>\n<td width=\"90\">\n<p align=\"center\">20</p>\n</td>\n<td width=\"288\">\n<p>Chlorobenzène.</p>\n</td>\n</tr>\n<tr>\n<td width=\"90\">\n<p align=\"center\">58</p>\n</td>\n<td width=\"288\">\n<p>1,1-Dichloroéthane.</p>\n</td>\n</tr>\n<tr>\n<td width=\"90\">\n<p align=\"center\">60</p>\n</td>\n<td width=\"288\">\n<p>1,1-Dichloroéthylène.</p>\n</td>\n</tr>\n<tr>\n<td width=\"90\">\n<p align=\"center\">61</p>\n</td>\n<td width=\"288\">\n<p>1,2-Dichloroéthylène.</p>\n</td>\n</tr>\n<tr>\n<td width=\"90\">\n<p align=\"center\">62</p>\n</td>\n<td width=\"288\">\n<p>Dichlorométhane.</p>\n</td>\n</tr>\n<tr>\n<td width=\"90\">\n<p align=\"center\">65</p>\n</td>\n<td width=\"288\">\n<p>1,2-Dichloropropane.</p>\n</td>\n</tr>\n<tr>\n<td width=\"90\">\n<p align=\"center\">119</p>\n</td>\n<td width=\"288\">\n<p>1,1,1-Trichloroéthane.</p>\n</td>\n</tr>\n</tbody>\n</table>"
  },

  "BLOC_TEXTUEL": {
    "CONTENU": "<p>L'échelonnement indiciaire applicable à l'emploi de chef du service de l'inspection générale de l'environnement est fixé comme suit :</p>\n<table>\n<tbody>\n<tr>\n<td width=\"227\">\n<p align=\"center\">Chef du service de l'inspection générale de l'environnement</p>\n</td>\n<td width=\"189\">\n<p align=\"center\">Indice brut</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"227\">\n<p>Echelon unique</p>\n</td>\n<td valign=\"top\" width=\"189\">\n<p align=\"center\">HED</p>\n</td>\n</tr>\n</tbody>\n</table>"

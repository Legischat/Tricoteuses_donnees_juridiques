      "TITRE_TXT": [
        {
          "#text": "Arrêté du 6 mai 1988 RELATIF AUX CONTROLES DES EMISSIONS DE GAZ POLLUANTS DES MOTEURS DIESELS EFFECTUES SUR LES VEHICULES AUTOMOBILES AVANT LEUR MISE EN CIRCULATION.",
          "@c_titre_court": "Arrêté du 6 mai 1988",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000296781"
        },
        {
          "#text": "Arrêté du 6 mai 1988 relatif au contrôle, avant la mise en circulation des véhicules automobiles, des émissions de gaz polluants et de particules polluantes provenant des moteurs à allumage par compression et des moteurs à allumage commandé fonctionnant au gaz naturel ou au gaz de pétrole liquéfié, destinés à la propulsion de ces véhicules.",

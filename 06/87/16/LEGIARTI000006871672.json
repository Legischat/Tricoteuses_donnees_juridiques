    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Arrêté du 24 novembre 1987 FIXANT LA LISTE DES COURS D'EAU ET PLANS D'EAU NON DOMANIAUX CLASSES EN 2EME CATEGORIE OU LA PECHE AUX ENGINS ET AUX FILETS PEUT ETRE PRATIQUEE PAR LES MEMBRES DES ASSOCIATIONS AGREEES DE PECHE ET DE PISCICULTURE",
          "@c_titre_court": "Arrêté du 24 novembre 1987",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000690524"
        },
        {
          "#text": "Arrêté du 24 novembre 1987 fixant la liste des cours d'eau et plans d'eau non domaniaux classés en 2e catégorie où la pêche aux engins et aux filets peut être pratiquée par les membres des associations agréées de pêche et de pisciculture",
          "@c_titre_court": "Arrêté du 24 novembre 1987",
          "@debut": "1987-12-26",
          "@fin": "2011-05-01",
          "@id_txt": "LEGITEXT000006057928"
        }
      ],

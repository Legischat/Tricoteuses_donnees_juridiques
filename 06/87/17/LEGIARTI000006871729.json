  "BLOC_TEXTUEL": {
    "CONTENU": "<p>La liste des espèces de gibier que l'on peut chasser est fixée comme suit sur le territoire du département de la Martinique :</p>\n<table>\n<tbody>\n<tr>\n<td width=\"170\">\n<p align=\"center\">TAXONOMIE</p>\n</td>\n<td width=\"170\">\n<p align=\"center\">NOM SCIENTIFIQUE</p>\n</td>\n<td width=\"170\">\n<p align=\"center\">NOM VERNACULAIRE</p>\n</td>\n<td width=\"170\">\n<p align=\"center\">SYNONYME</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"170\">\n<p align=\"center\">OISEAUX</p>\n</td>\n<td valign=\"top\" width=\"170\"/>\n<td valign=\"top\" width=\"170\"/>\n<td valign=\"top\" width=\"170\"/>\n</tr>\n<tr>\n<td valign=\"top\" width=\"170\">\n<p align=\"center\">Ansériformes</p>\n</td>\n<td valign=\"top\" width=\"170\"/>\n<td valign=\"top\" width=\"170\"/>\n<td valign=\"top\" width=\"170\"/>\n</tr>\n<tr>\n<td valign=\"top\" width=\"170\">\n<p>Anatidés.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Anas discors.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Sarcelle à ailes bleues.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Sarcelle. </p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"170\"/>\n<td valign=\"top\" width=\"170\">\n<p>Anas americana.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Canard siffleur d'Amérique.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Canard.</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"170\"/>\n<td valign=\"top\" width=\"170\">\n<p>Anas platyrhynchos.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Canard colvert.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Colvert. </p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"170\"/>\n<td valign=\"top\" width=\"170\">\n<p>Anas acuta.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Canard pilet.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Canard.</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"170\"/>\n<td valign=\"top\" width=\"170\">\n<p>Anas strepera.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Canard chipeau.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Canard. </p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"170\"/>\n<td valign=\"top\" width=\"170\">\n<p>Anas clypeata.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Canard souchet.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Canard.</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"170\"/>\n<td valign=\"top\" width=\"170\">\n<p>Anas crecca.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Sarcelle à ailes vertes.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Sarcelle. </p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"170\"/>\n<td valign=\"top\" width=\"170\">\n<p>Dendrocygna bicolor.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Dendrocygne fauve.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Canard rouge.</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"170\"/>\n<td valign=\"top\" width=\"170\">\n<p>Dendrocygna autumnalis.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Dendrocygne à ventre noir.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Canard siffleur. </p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"170\"/>\n<td valign=\"top\" width=\"170\">\n<p>Aythya collaris.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Morillon à collier.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Canard noir.</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"170\"/>\n<td valign=\"top\" width=\"170\">\n<p>Aythya affinis.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Petit morillon.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Canard noir.</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"170\">\n<p align=\"center\">Charadriiformes</p>\n</td>\n<td valign=\"top\" width=\"170\"/>\n<td valign=\"top\" width=\"170\"/>\n<td valign=\"top\" width=\"170\"/>\n</tr>\n<tr>\n<td valign=\"top\" width=\"170\">\n<p>Charadriidés.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Pluvialis dominica.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Pluvier doré d'Amérique.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Pluvier doré. </p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"170\"/>\n<td valign=\"top\" width=\"170\">\n<p>Pluvialis squatarola.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Pluvier argenté.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Pluvier grosse tête. </p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"170\"/>\n<td valign=\"top\" width=\"170\">\n<p>Arenaria interpres.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Tournepierre roux.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Pluvier des salines. </p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"170\">\n<p>Scolopacidés.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Tringa flavipes.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Petit chevalier à pattes jaunes.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Pattes jaunes, Bécasse </p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"170\"/>\n<td valign=\"top\" width=\"170\">\n<p>Tringa melanoleuca.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Grand chevalier à pattes jaunes.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Clin.</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"170\"/>\n<td valign=\"top\" width=\"170\">\n<p>Limnodromus griseus.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Bécasseau roux.</p>\n</td>\n<td valign=\"top\" width=\"170\"/>\n</tr>\n<tr>\n<td valign=\"top\" width=\"170\"/>\n<td valign=\"top\" width=\"170\">\n<p>Numenius phaeopus.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Courlis corlieu.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Bec crochu. </p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"170\"/>\n<td valign=\"top\" width=\"170\">\n<p>Capella delicata.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Bécassine des marais.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Bécassine. </p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"170\"/>\n<td valign=\"top\" width=\"170\">\n<p>Limosa haemastica.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Barge hudsonienne.</p>\n</td>\n<td valign=\"top\" width=\"170\"/>\n</tr>\n<tr>\n<td valign=\"top\" width=\"170\"/>\n<td valign=\"top\" width=\"170\">\n<p>Bartramia longicauda.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Maubèche des champs.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Poule vergène.</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"170\"/>\n<td valign=\"top\" width=\"170\">\n<p>Catoptrophorus semipalmatus.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Chevalier semi-palmé.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Ailes blanches.</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"170\"/>\n<td valign=\"top\" width=\"170\">\n<p>Micropalama himantopus.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Bécasseau à échasses.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Chevalier à pieds verts. </p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"170\"/>\n<td valign=\"top\" width=\"170\">\n<p>Calidris melanotos.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Bécasseau à poitrine cendrée.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Dos rouge.</p>\n</td>\n</tr>\n<tr>\n<td> </td>\n<td> Calidris canutus</td>\n<td>\n<p>Bécasseau maubèche.</p>\n</td>\n<td> </td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"170\">\n<p align=\"center\">Columbiformes</p>\n</td>\n<td valign=\"top\" width=\"170\"/>\n<td valign=\"top\" width=\"170\"/>\n<td valign=\"top\" width=\"170\"/>\n</tr>\n<tr>\n<td>\n<p>Columbidés.</p>\n</td>\n<td>Columbina passerina</td>\n<td>Colombe roux violet</td>\n<td>Ortolan</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"170\"/>\n<td valign=\"top\" width=\"170\">\n<p>Columba leucocephala.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Pigeon à calotte blanche.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Ramier à tête blanche. </p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"170\"/>\n<td valign=\"top\" width=\"170\">\n<p>Colomba squamosa.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Pigeon à cou rouge.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Ramier bleu ou ramier cou rouge. Bec fer.</p>\n</td>\n</tr>\n<tr>\n<td> </td>\n<td>Streptopelia decaocto</td>\n<td>Tourterelle turque</td>\n<td> </td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"170\"/>\n<td valign=\"top\" width=\"170\">\n<p>Zenaïda aurita.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Tourterelle à queue carrée</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Tourterelle.</p>\n</td>\n</tr>\n<tr>\n<td/>\n<td>Zenaïda auriculata</td>\n<td>\n<p>Colombe oreillarde.</p>\n</td>\n<td>\n<p>Tourterelle, Ortolan. </p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"170\">\n<p align=\"center\">Passériformes</p>\n</td>\n<td valign=\"top\" width=\"170\"/>\n<td valign=\"top\" width=\"170\"/>\n<td valign=\"top\" width=\"170\"/>\n</tr>\n<tr>\n<td valign=\"top\" width=\"170\">\n<p>Mimidés.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Margarops fuscus.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Moqueur grivette.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Grive fine. </p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"170\"/>\n<td valign=\"top\" width=\"170\">\n<p>Margarops fuscatus.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Moqueur corossol.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Grosse grive.</p>\n</td>\n</tr>\n</tbody>\n</table>\n<br/>\n<br/>\n<br/>"
  },

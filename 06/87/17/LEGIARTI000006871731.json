  "BLOC_TEXTUEL": {
    "CONTENU": "<p>Sont interdits sur tout le territoire du département de la Guadeloupe et en tout temps la destruction ou l'enlèvement des œufs, la destruction, la mutilation, la capture ou l'enlèvement, la naturalisation des reptiles et amphibiens d'espèces non domestiques suivantes ou, qu'ils soient vivants ou morts, leur transport, leur colportage, leur utilisation, leur mise en vente, leur vente ou leur achat :</p>\n<br/>\n<br/>\n<table align=\"center\" border=\"1\" cellpadding=\"0\" cellspacing=\"0\" width=\"680\">\n<tbody>\n<tr>\n<td width=\"170\">\n<p align=\"center\">TAXONOMIE</p>\n</td>\n<td width=\"170\">\n<p align=\"center\">NOM SCIENTIFIQUE</p>\n</td>\n<td width=\"170\">\n<p align=\"center\">NOM VERNACULAIRE</p>\n</td>\n<td width=\"170\">\n<p align=\"center\">SYNONYME</p>\n</td>\n</tr>\n<tr>\n<td width=\"170\">\n<p align=\"center\">REPTILES</p>\n</td>\n<td width=\"170\">\n<p align=\"center\"> </p>\n</td>\n<td width=\"170\">\n<p align=\"center\"> </p>\n</td>\n<td width=\"170\">\n<p align=\"center\"> </p>\n</td>\n</tr>\n<tr>\n<td width=\"170\">\n<p align=\"center\">Chéloniens</p>\n</td>\n<td width=\"170\">\n<p align=\"center\"> </p>\n</td>\n<td width=\"170\">\n<p align=\"center\"> </p>\n</td>\n<td width=\"170\">\n<p align=\"center\"> </p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"170\">\n<p>Emydidés.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Chrysemis stejneri (Decussata stejneri).</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Tortue peinte.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<br/>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"170\">\n<p>Pélomédusidés.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Pelusios castaneus.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Tortue à charnières.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<br/>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"170\">\n<p align=\"center\">Sauriens</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<br/>\n</td>\n<td valign=\"top\" width=\"170\">\n<br/>\n</td>\n<td valign=\"top\" width=\"170\">\n<br/>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"170\">\n<p>Scincidés.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Mabuya mabouya.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Mabuya.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Couleuvre bâtarde. </p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"170\">\n<p>Téiidés.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Ameiva pleei.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Ameiva.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Anolis terre. </p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"170\">\n<br/>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Gymnophtalmus plei.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Gymnophtalme de Plée.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<br/>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"170\">\n<p>Iguanidés.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Anolis wattsi.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Anolis de Saint-Martin.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<br/>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"170\">\n<br/>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Anolis gingivinus.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Anolis de Saint-Barthélémy.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<br/>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"170\">\n<br/>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Anolis marmoratus.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Anolis marbré.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<br/>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"170\">\n<br/>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Iguana delicatissima.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Iguane des Antilles.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Lézard. </p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"170\">\n<br/>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Iguana iguana.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Iguane vert.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Lézard. </p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"170\">\n<p>Gekkonidés.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Sphaerodactylus fantasticus.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Sphérodactyle bizarre.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Petit mabouya. </p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"170\">\n<br/>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Sphaerodactylus sputator.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Sphérodactyle sputator sputateur.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Petit mabouya. </p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"170\">\n<br/>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Sphaerodactylus macrolepis.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Sphérodactyle à grandes écailles.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Petit mabouya. </p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"170\">\n<br/>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Thecadactylus rapicauda.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Thécadactyle à queue épineuse.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Grand mabouya collant. </p>\n</td>\n</tr>\n<tr>\n<td width=\"170\">\n<p align=\"center\">Ophidiens</p>\n</td>\n<td width=\"170\">\n<p align=\"center\"> </p>\n</td>\n<td width=\"170\">\n<p align=\"center\"> </p>\n</td>\n<td width=\"170\">\n<p align=\"center\"> </p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"170\">\n<p>Colubridés.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Alsophis antillensis.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Couleuvre.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Couleuvre. </p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"170\">\n<br/>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Alsophis rijersmaï.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Couleuvre.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Couleuvre. </p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"170\">\n<br/>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Liophis juliae (Dromicus juliae).</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Couleuvre.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Couleuvre ou couresse. </p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"170\">\n<p>Typhlopidés.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Typhlops guadeloupensis.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Typhlops de Guadeloupe.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<br/>\n</td>\n</tr>\n<tr>\n<td width=\"170\">\n<p align=\"center\">AMPHIBIENS</p>\n</td>\n<td width=\"170\">\n<p align=\"center\"> </p>\n</td>\n<td width=\"170\">\n<p align=\"center\"> </p>\n</td>\n<td width=\"170\">\n<p align=\"center\"> </p>\n</td>\n</tr>\n<tr>\n<td width=\"170\">\n<p align=\"center\">Anoures</p>\n</td>\n<td width=\"170\">\n<p align=\"center\"> </p>\n</td>\n<td width=\"170\">\n<p align=\"center\"> </p>\n</td>\n<td width=\"170\">\n<p align=\"center\"> </p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"170\">\n<p>Leptodactylidés.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Eleutherodactylus barlegnei.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Eleutherodactyle.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Grenouille. </p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"170\">\n<br/>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Eleutherodactylus martinisensis.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Eleutherodactyle.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Grenouille. </p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"170\">\n<br/>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Eleutherodactylus pinchoni.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Eleutherodactyle.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Grenouille. </p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"170\">\n<br/>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Eleutherodactylus johnstonei.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Eleutherodactyle.</p>\n</td>\n<td valign=\"top\" width=\"170\">\n<p>Grenouille.</p>\n</td>\n</tr>\n</tbody>\n</table>\n<p align=\"left\"> </p>\n<p align=\"left\"> </p>\n<p align=\"left\"> </p>\n<p align=\"left\"> </p>\n<p align=\"left\"> </p>\n<p align=\"left\"> </p>"

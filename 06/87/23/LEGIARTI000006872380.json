  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Arrêté du 26 septembre 1980 réglementant les conditions d'hygiène applicables dans les établissements de restauration où sont préparés, servis ou distribués des aliments comportant des denrées animales ou d'origine animale",
          "@c_titre_court": "Arrêté du 26 septembre 1980",
          "@debut": "1980-11-15",
          "@fin": "1997-10-23",
          "@id_txt": "LEGITEXT000006074919"
        }
      ],
      "TM": {
        "TITRE_TM": [
          {
            "#text": "Chapitre I : Dispositions relatives à l'implantation, l'aménagement et l'équipement en matériel des locaux nécessaires à la préparation des denrées alimentaires ou d'origine alimentaire en vue de la restauration.",
            "@debut": "1980-11-15",
            "@fin": "1997-10-23",
            "@id": "LEGISCTA000006111064"
          }
        ]
      },
      "@cid": "LEGITEXT000006074919",

  "BLOC_TEXTUEL": {
    "CONTENU": "<p>Normes d'émission</p>\n<br/>\n<p>      Valeur d'émission en mg/Nm3 rapportée aux conditions définies à l'article 2 en fonction de la capacité nominale de l'installation d'incinération.</p>\n<br/>\n<br/>\n<table>\n<tbody>\n<tr>\n<td> </td>\n<td align=\"center\">\n<p>Inf</p>\n<p>1 t/h </p>\n</td>\n<td align=\"center\">\n<p>De 1 t/h à </p>\n<p>moins 3 t/h </p>\n</td>\n<td align=\"center\">\n<p>3 t/h </p>\n<p>et plus </p>\n</td>\n</tr>\n<tr>\n<td>\n<p>Vitesse verticale des gaz de </p>\n<p>combustion en sortie de cheminée </p>\n</td>\n<td align=\"center\"> > 8 m/s<br/>\n</td>\n<td align=\"center\">> 8 m/s <br/>\n</td>\n<td align=\"center\">> 12 m/s  <br/>\n</td>\n</tr>\n<tr>\n<td>Poussières totales <br/>\n</td>\n<td align=\"center\">200 <br/>\n</td>\n<td align=\"center\">100 <br/>\n</td>\n<td align=\"center\">30 <br/>\n</td>\n</tr>\n<tr>\n<td>Acide chlorhydrique (HCI) <br/>\n</td>\n<td align=\"center\">260 <br/>\n</td>\n<td align=\"center\">100 <br/>\n</td>\n<td align=\"center\">50 <br/>\n</td>\n</tr>\n<tr>\n<td>\n<p>Composés organiques exprimés </p>\n<p>en carbone total </p>\n</td>\n<td align=\"center\">20 <br/>\n</td>\n<td align=\"center\">20 <br/>\n</td>\n<td align=\"center\">20 <br/>\n</td>\n</tr>\n<tr>\n<td>Métaux lourds : Pb + Cr + Cu + Mn  <br/>\n</td>\n<td align=\"center\">- <br/>\n</td>\n<td align=\"center\">5 <br/>\n</td>\n<td align=\"center\">5 <br/>\n</td>\n</tr>\n<tr>\n<td>Nl + As <br/>\n</td>\n<td align=\"center\">- <br/>\n</td>\n<td align=\"center\">1 <br/>\n</td>\n<td align=\"center\">1 <br/>\n</td>\n</tr>\n<tr>\n<td>Cd + Hg (particulaires et gazeux) <br/>\n</td>\n<td align=\"center\">- <br/>\n</td>\n<td align=\"center\">0,2 <br/>\n</td>\n<td align=\"center\">0,2 <br/>\n</td>\n</tr>\n<tr>\n<td>Acide fluorhydrique (HF) <br/>\n</td>\n<td align=\"center\">- <br/>\n</td>\n<td align=\"center\">4 <br/>\n</td>\n<td align=\"center\">2 <br/>\n</td>\n</tr>\n<tr>\n<td>Anhydride sulfureux (SOi) <br/>\n</td>\n<td align=\"center\">- <br/>\n</td>\n<td align=\"center\">300 <br/>\n</td>\n<td align=\"center\">300 <br/>\n</td>\n</tr>\n</tbody>\n</table>\n<br/>\n<br/>"
  },

    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Arrêté du 29 octobre 1993 FIXANT POUR LA PERIODE COUVRANT LE SECOND SEMESTRE 1993 ET LE PREMIER SEMESTRE 1994 LE PLAFOND DES RESSOURCES AFFECTEES AU FINANCEMENT DU REGIME DES AIDES AU COMMERCE INSTITUE PAR L'ART. 4 DE LA LOI 891008 DU 31-12-1989",
          "@c_titre_court": "Arrêté du 29 octobre 1993",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000301270"
        },
        {
          "#text": "Arrêté du 29 octobre 1993 fixant pour la période couvrant le second semestre 1993 et le premier semestre 1994 le plafond des ressources affectées au financement du régime des aides au commerce institué par l'article 4 de la loi n° 89-1008 du 31 décembre 1989",
          "@c_titre_court": "Arrêté du 29 octobre 1993",
          "@debut": "1993-11-09",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006060221"

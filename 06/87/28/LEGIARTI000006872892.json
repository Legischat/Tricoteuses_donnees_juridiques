  "BLOC_TEXTUEL": {
    "CONTENU": "<p>L'examen pour l'obtention du brevet d'officier mécanicien de 3e classe de la marine marchande comporte des épreuves écrites, des épreuves pratiques et d'application et des épreuves orales, notées de 0 à 20.</p>\n<p>La nature, la durée et les coefficients des épreuves sont donnés dans le tableau ci-après :</p>\n<table>\n<tbody>\n<tr>\n<td width=\"378\">\n<p align=\"center\">NATURE DES ÉPREUVES</p>\n</td>\n<td width=\"151\">\n<p align=\"center\">Durée</p>\n</td>\n<td width=\"151\">\n<p align=\"center\">Coefficient</p>\n</td>\n</tr>\n<tr>\n<td width=\"378\">\n<p align=\"center\">Epreuves écrites</p>\n</td>\n<td width=\"151\">\n<p align=\"center\"> </p>\n</td>\n<td width=\"151\">\n<p align=\"center\"> </p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"378\">\n<p>Mathématiques et physique appliquées</p>\n</td>\n<td width=\"151\">\n<p align=\"center\">2 heures</p>\n</td>\n<td width=\"151\">\n<p align=\"center\">2</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"378\">\n<p>Machines</p>\n</td>\n<td width=\"151\">\n<p align=\"center\">3 heures</p>\n</td>\n<td width=\"151\">\n<p align=\"center\">4</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"378\">\n<p>Electricité</p>\n</td>\n<td width=\"151\">\n<p align=\"center\">2 heures</p>\n</td>\n<td width=\"151\">\n<p align=\"center\">3</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"378\">\n<p>Rapport technique</p>\n</td>\n<td width=\"151\">\n<p align=\"center\">2 heures</p>\n</td>\n<td width=\"151\">\n<p align=\"center\">3</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"378\">\n<p>Dessin technique</p>\n</td>\n<td width=\"151\">\n<p align=\"center\">3 heures</p>\n</td>\n<td width=\"151\">\n<p align=\"center\">3</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"378\">\n<p>Total</p>\n</td>\n<td width=\"151\">\n<p align=\"center\"> </p>\n</td>\n<td width=\"151\">\n<p align=\"center\">15</p>\n</td>\n</tr>\n<tr>\n<td width=\"378\">\n<p align=\"center\">Epreuves pratiques et d'application</p>\n</td>\n<td width=\"151\">\n<p align=\"center\"> </p>\n</td>\n<td width=\"151\">\n<p align=\"center\"> </p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"378\">\n<p>Atelier</p>\n</td>\n<td width=\"151\">\n<p align=\"center\">4 ou 8 heures</p>\n</td>\n<td width=\"151\">\n<p align=\"center\">3</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"378\">\n<p>Machines</p>\n</td>\n<td width=\"151\">\n<p align=\"center\"> </p>\n</td>\n<td width=\"151\">\n<p align=\"center\">4</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"378\">\n<p>Electricité</p>\n</td>\n<td width=\"151\">\n<p align=\"center\"> </p>\n</td>\n<td width=\"151\">\n<p align=\"center\">4</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"378\">\n<p>Lecture de plans </p>\n</td>\n<td width=\"151\">\n<p align=\"center\"> </p>\n</td>\n<td width=\"151\">\n<p align=\"center\">3</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"378\">\n<p>Automatique, informatique</p>\n</td>\n<td width=\"151\">\n<p align=\"center\"> </p>\n</td>\n<td width=\"151\">\n<p align=\"center\">3</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"378\">\n<p>Total</p>\n</td>\n<td width=\"151\">\n<p align=\"center\"> </p>\n</td>\n<td width=\"151\">\n<p align=\"center\">17</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"378\">\n<p>Simulateur machines (1)</p>\n</td>\n<td width=\"151\">\n<p align=\"center\"> </p>\n</td>\n<td width=\"151\">\n<p align=\"center\">5</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"378\">\n<p>Stage</p>\n</td>\n<td width=\"151\">\n<p align=\"center\"> </p>\n</td>\n<td width=\"151\">\n<p align=\"center\"> </p>\n</td>\n</tr>\n<tr>\n<td width=\"378\">\n<p align=\"center\">Epreuves orales</p>\n</td>\n<td width=\"151\">\n<p align=\"center\"> </p>\n</td>\n<td width=\"151\">\n<p align=\"center\"> </p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"378\">\n<p>Anglais</p>\n</td>\n<td width=\"151\">\n<p align=\"center\"> </p>\n</td>\n<td width=\"151\">\n<p align=\"center\">2</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"378\">\n<p>Electricité</p>\n</td>\n<td width=\"151\">\n<p align=\"center\"> </p>\n</td>\n<td width=\"151\">\n<p align=\"center\">3</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"378\">\n<p>Machines</p>\n</td>\n<td width=\"151\">\n<p align=\"center\"> </p>\n</td>\n<td width=\"151\">\n<p align=\"center\">3</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"378\">\n<p>Construction, sécurité</p>\n</td>\n<td width=\"151\">\n<p align=\"center\"> </p>\n</td>\n<td width=\"151\">\n<p align=\"center\">3</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"378\">\n<p>Réglementation maritime</p>\n</td>\n<td width=\"151\">\n<p align=\"center\"> </p>\n</td>\n<td width=\"151\">\n<p align=\"center\">2</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"378\">\n<p>Total</p>\n</td>\n<td width=\"151\">\n<p align=\"center\"> </p>\n</td>\n<td width=\"151\">\n<p align=\"center\">13</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"378\">\n<p>Total général</p>\n</td>\n<td width=\"151\">\n<p align=\"center\"> </p>\n</td>\n<td width=\"151\">\n<p align=\"center\">50</p>\n</td>\n</tr>\n<tr>\n<td colspan=\"3\" valign=\"top\" width=\"378\">\n<p>(1) La note prise en compte est celle attribuée à l'issue du stage.</p>\n</td>\n</tr>\n</tbody>\n</table>"
  },

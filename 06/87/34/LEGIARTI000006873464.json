  "BLOC_TEXTUEL": {
    "CONTENU": "<p>Les traitements des gardes-chefs de 1re classe du Conseil supérieur de la pêche sont fixés par référence aux indices hiérarchiques bruts suivants :</p>\n<p align=\"center\">Garde-chef de 1re classe</p>\n<table>\n<tbody>\n<tr>\n<td width=\"197\">\n<p align=\"center\">ÉCHELONS</p>\n</td>\n<td width=\"181\">\n<p align=\"center\">INDICES BRUTS<br/>A compter du 1er août 1991</p>\n</td>\n</tr>\n<tr>\n<td width=\"197\">\n<p align=\"center\">3e échelon</p>\n</td>\n<td width=\"181\">\n<p align=\"center\">449</p>\n</td>\n</tr>\n<tr>\n<td width=\"197\">\n<p align=\"center\">2e échelon</p>\n</td>\n<td width=\"181\">\n<p align=\"center\">427</p>\n</td>\n</tr>\n<tr>\n<td width=\"197\">\n<p align=\"center\">1er échelon</p>\n</td>\n<td width=\"181\">\n<p align=\"center\">396</p>\n</td>\n</tr>\n</tbody>\n</table>"
  },

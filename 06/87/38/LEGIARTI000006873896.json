  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Matériel courant de laboratoire, et notamment :<br/>\n<br/>   5.1. Tamis à ouverture de maille 0,5 mm.<br/>\n<br/>   5.2. Creusets filtrants en verre fritté G2 et G3.<br/>\n<br/>   5.3. Tubes en verre à centrifuger de 100 ml, susceptibles d'être bouchés.<br/>\n<br/>   5.4. Etuve à 37 plus ou moins 1 degré C.<br/>\n<br/>   5.5. Etuve à 100 plus ou moins 1 degré C.<br/>\n<br/>   5.6. Autoclave pouvant atteindre 130°C.<br/>\n<br/>   5.7. Broyeur de laboratoire.<br/>\n<br/>   5.8. Evaporateur rotatif.<br/>\n<br/>   5.9. Balance analytique.<br/>"
  }

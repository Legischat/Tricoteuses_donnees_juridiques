  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Arrêté du 20 septembre 1993 PORTANT APPROBATION DES MODALITES DE CONTROLE DU DISPOSITIF SELON LEQUEL LES PRODUCTEURS DE MEDICAMENTS POURVOIENT A L'ELIMINATION DES DECHETS RESULTANT DE L'ABANDON PAR LES MENAGES DES EMBALLAGES DE LEURS PRODUITS",
          "@c_titre_court": "Arrêté du 20 septembre 1993",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000688104"
        },
        {
          "#text": "Arrêté du 20 septembre 1993 portant approbation des modalités de contrôle du dispositif selon lequel les producteurs de médicaments pourvoient à l'élimination des déchets résultant de l'abandon par les ménages des emballages de leurs produits",
          "@c_titre_court": "Arrêté du 20 septembre 1993",
          "@debut": "1993-10-05",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006060140"
        }
      ],

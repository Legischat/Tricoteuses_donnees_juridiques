  "BLOC_TEXTUEL": {
    "CONTENU": "<table>\n<tbody>\n<tr>\n<td width=\"340\">\n<p align=\"center\">VITAMINES ET SELS MINÉRAUX</p>\n</td>\n<td width=\"340\">\n<p align=\"center\">APPORTS JOURNALIERS<br/>recommandés (AJR)</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"340\">\n<p>Vitamine A (µg)</p>\n</td>\n<td valign=\"top\" width=\"340\">\n<p align=\"center\">800</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"340\">\n<p>Vitamine D (µg)</p>\n</td>\n<td valign=\"top\" width=\"340\">\n<p align=\"center\">5</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"340\">\n<p>Vitamine E (mg)</p>\n</td>\n<td valign=\"top\" width=\"340\">\n<p align=\"center\">10</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"340\">\n<p>Vitamine C (mg)</p>\n</td>\n<td valign=\"top\" width=\"340\">\n<p align=\"center\">60</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"340\">\n<p>Thiamine (mg)</p>\n</td>\n<td valign=\"top\" width=\"340\">\n<p align=\"center\">1,4</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"340\">\n<p>Riboflavine (mg)</p>\n</td>\n<td valign=\"top\" width=\"340\">\n<p align=\"center\">1,6</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"340\">\n<p>Niacine (mg)</p>\n</td>\n<td valign=\"top\" width=\"340\">\n<p align=\"center\">18</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"340\">\n<p>Vitamine B6 (mg)</p>\n</td>\n<td valign=\"top\" width=\"340\">\n<p align=\"center\">2</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"340\">\n<p>Folacine (µg)</p>\n</td>\n<td valign=\"top\" width=\"340\">\n<p align=\"center\">200</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"340\">\n<p>Vitamine B12 (µg)</p>\n</td>\n<td valign=\"top\" width=\"340\">\n<p align=\"center\">1</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"340\">\n<p>Biotine (mg)</p>\n</td>\n<td valign=\"top\" width=\"340\">\n<p align=\"center\">0,15</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"340\">\n<p>Acide pantothénique (mg)</p>\n</td>\n<td valign=\"top\" width=\"340\">\n<p align=\"center\">6</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"340\">\n<p>Calcium (mg)</p>\n</td>\n<td valign=\"top\" width=\"340\">\n<p align=\"center\">800</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"340\">\n<p>Phosphore (mg)</p>\n</td>\n<td valign=\"top\" width=\"340\">\n<p align=\"center\">800</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"340\">\n<p>Fer (mg)</p>\n</td>\n<td valign=\"top\" width=\"340\">\n<p align=\"center\">14</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"340\">\n<p>Magnésium (mg)</p>\n</td>\n<td valign=\"top\" width=\"340\">\n<p align=\"center\">300</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"340\">\n<p>Zinc (mg)</p>\n</td>\n<td valign=\"top\" width=\"340\">\n<p align=\"center\">15</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"340\">\n<p>Iode (µg)</p>\n</td>\n<td valign=\"top\" width=\"340\">\n<p align=\"center\">150</p>\n</td>\n</tr>\n</tbody>\n</table>"

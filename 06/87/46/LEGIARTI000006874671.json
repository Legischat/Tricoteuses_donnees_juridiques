  "BLOC_TEXTUEL": {
    "CONTENU": "<table>\n<tbody>\n<tr>\n<td rowspan=\"2\" width=\"341\">\n<p align=\"center\">NUTRIMENTS</p>\n</td>\n<td colspan=\"2\" width=\"340\">\n<p align=\"center\">COEFFICIENTS<br/>de conversion</p>\n</td>\n</tr>\n<tr>\n<td width=\"180\">\n<p align=\"center\">kcal/g</p>\n</td>\n<td width=\"160\">\n<p align=\"center\">kJ/g</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"341\">\n<p>Glucides (à l'exception des polyols) </p>\n</td>\n<td valign=\"top\" width=\"180\">\n<p align=\"center\">4</p>\n</td>\n<td valign=\"top\" width=\"160\">\n<p align=\"center\">17</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"341\">\n<p>Polyols </p>\n</td>\n<td valign=\"top\" width=\"180\">\n<p align=\"center\">2,4</p>\n</td>\n<td valign=\"top\" width=\"160\">\n<p align=\"center\">10</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"341\">\n<p>Protéines</p>\n</td>\n<td valign=\"top\" width=\"180\">\n<p align=\"center\">4</p>\n</td>\n<td valign=\"top\" width=\"160\">\n<p align=\"center\">17</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"341\">\n<p>Lipides</p>\n</td>\n<td valign=\"top\" width=\"180\">\n<p align=\"center\">9</p>\n</td>\n<td valign=\"top\" width=\"160\">\n<p align=\"center\">37</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"341\">\n<p>Alcool (éthanol)</p>\n</td>\n<td valign=\"top\" width=\"180\">\n<p align=\"center\">7</p>\n</td>\n<td valign=\"top\" width=\"160\">\n<p align=\"center\">29</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"341\">\n<p>Acides organiques</p>\n</td>\n<td valign=\"top\" width=\"180\">\n<p align=\"center\">3</p>\n</td>\n<td valign=\"top\" width=\"160\">\n<p align=\"center\">13</p>\n</td>\n</tr>\n</tbody>\n</table>"

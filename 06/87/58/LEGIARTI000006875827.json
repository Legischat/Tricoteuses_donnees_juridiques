      },
      {
        "#text": "Décret n°80-14 du 9 janvier 1980 - art. 11 (V)",
        "@cidtexte": "JORFTEXT000000519488",
        "@datesignatexte": "1980-01-09",
        "@id": "LEGIARTI000006882968",
        "@naturetexte": "DECRET",
        "@num": "11",
        "@numtexte": "80-14",
        "@sens": "source",
        "@typelien": "SPEC_APPLI"
      },
      {
        "#text": "Les véhicules à deux roues vendus au public avant le 1er juin 1980 possédant un embrayage ou une boîte de vitesses non automatiques et répondant, par ailleurs, à la définition du cyclomoteur demeurent soumis aux dispositions du présent titre, applica",
        "@sens": "source",
        "@typelien": "SPEC_APPLI"
      }
    ]
  }

  "BLOC_TEXTUEL": {
    "CONTENU": "<p align=\"center\">LISTE DES SERVICES D'ANNONCE DES CRUES AVEC LEURS COMPÉTENCES TERRITORIALES DANS LE BASSIN ARTOIS-PICARDIE</p>\n<p align=\"center\"> </p>\n<table>\n<tbody>\n<tr>\n<td width=\"94\">\n<p align=\"center\">SOUS-BASSIN</p>\n</td>\n<td width=\"246\">\n<p align=\"center\">DOMAINE GÉOGRAPHIQUE DE COMPÉTENCE</p>\n</td>\n<td width=\"114\">\n<p align=\"center\">SERVICE ACTUEL</p>\n</td>\n<td width=\"113\">\n<p align=\"center\">SERVICE FUTUR</p>\n</td>\n<td width=\"113\">\n<p align=\"center\">DATE D'EFFET</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"94\">\n<p>Fleuves côtiers et rivières du Nord et du Pas-de-Calais.</p>\n</td>\n<td valign=\"top\" width=\"246\">\n<p>Sambre, Solre, Helpe mineure, Helpe majeure, Aa supérieure et Liane.</p>\n</td>\n<td valign=\"top\" width=\"114\">\n<p align=\"center\">DIREN<br/>Nord - Pas-de-Calais</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p align=\"center\">DIREN<br/>Nord - Pas-de-Calais</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p align=\"center\">Sans objet</p>\n</td>\n</tr>\n</tbody>\n</table>\n<br/>\n<br/>"
  }

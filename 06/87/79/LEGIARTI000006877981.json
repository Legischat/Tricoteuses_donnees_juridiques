  "BLOC_TEXTUEL": {
    "CONTENU": "<p align=\"center\">LISTE DES SERVICES D'ANNONCE DES CRUES AVEC LEURS COMPÉTENCES TERRITORIALES DANS LE BASSIN RHIN-MEUSE</p>\n<p align=\"center\"> </p>\n<table>\n<tbody>\n<tr>\n<td width=\"94\">\n<p align=\"center\">SOUS-BASSIN</p>\n</td>\n<td width=\"246\">\n<p align=\"center\">DOMAINE GÉOGRAPHIQUE DE COMPÉTENCE</p>\n</td>\n<td width=\"114\">\n<p align=\"center\">SERVICE ACTUEL</p>\n</td>\n<td width=\"113\">\n<p align=\"center\">SERVICE FUTUR</p>\n</td>\n<td width=\"113\">\n<p align=\"center\">DATE D'EFFET</p>\n</td>\n</tr>\n<tr>\n<td rowspan=\"2\" valign=\"top\" width=\"94\">\n<p>Meuse.</p>\n</td>\n<td valign=\"top\" width=\"246\">\n<p>Meuse à partir de Neufchâteau.</p>\n</td>\n<td rowspan=\"2\" valign=\"top\" width=\"114\">\n<p align=\"center\">DIREN de Lorraine</p>\n</td>\n<td rowspan=\"2\" valign=\"top\" width=\"113\">\n<p align=\"center\">DIREN de Lorraine</p>\n</td>\n<td rowspan=\"2\" valign=\"top\" width=\"113\">\n<p align=\"center\">Sans objet</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"246\">\n<p>Chiers à partir de Longwy-Semoy.</p>\n</td>\n</tr>\n<tr>\n<td rowspan=\"6\" valign=\"top\" width=\"94\">\n<p>Moselle.</p>\n</td>\n<td valign=\"top\" width=\"246\">\n<p>Moselle à partir de Remiremont.</p>\n</td>\n<td rowspan=\"6\" valign=\"top\" width=\"114\">\n<p align=\"center\">DIREN de Lorraine</p>\n</td>\n<td rowspan=\"6\" valign=\"top\" width=\"113\">\n<p align=\"center\">DIREN de Lorraine</p>\n</td>\n<td rowspan=\"6\" valign=\"top\" width=\"113\">\n<p align=\"center\">Sans objet</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"246\">\n<p>Meurthe à partir de Saint-Dié.</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"246\">\n<p>Orne à partir d'Etain.</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"246\">\n<p>Madon à partir de Mirecourt.</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"246\">\n<p>Mortagne à partir de Magnières.</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"246\">\n<p>Vezouze à partir de Blâmont.</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"94\">\n<p>Seille et Nieds.</p>\n</td>\n<td valign=\"top\" width=\"246\">\n<p>Seille, Nied allemande, Nied française et Nied réunie.</p>\n</td>\n<td valign=\"top\" width=\"114\">\n<p align=\"center\">DIREN de Lorraine</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p align=\"center\">DIREN de Lorraine</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p align=\"center\">Sans objet</p>\n</td>\n</tr>\n<tr>\n<td rowspan=\"2\" valign=\"top\" width=\"94\">\n<p>Sarre et Rhin.</p>\n</td>\n<td valign=\"top\" width=\"246\">\n<p>Partie française de la Sarre, Eichel, Blies.</p>\n</td>\n<td rowspan=\"2\" valign=\"top\" width=\"114\">\n<p align=\"center\">SN Strasbourg</p>\n</td>\n<td rowspan=\"2\" valign=\"top\" width=\"113\">\n<p align=\"center\">SN Strasbourg</p>\n</td>\n<td rowspan=\"2\" valign=\"top\" width=\"113\">\n<p align=\"center\">Sans objet</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"246\">\n<p>Partie française du Rhin.</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"94\">\n<p>Rivières du Bas-Rhin.</p>\n</td>\n<td valign=\"top\" width=\"246\">\n<p>Bruche, Giessen, Zorn, Zinsel, Model, III dans le Bas-Rhin.</p>\n</td>\n<td valign=\"top\" width=\"114\">\n<p align=\"center\">DDAF 67</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p align=\"center\">SN Strasbourg</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p align=\"center\">3 octobre 2005</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"94\">\n<p>Rivières du Haut-Rhin.</p>\n</td>\n<td valign=\"top\" width=\"246\">\n<p>Fecht, Lauch, Thur, Doller, Largue, Ill dans le Haut-Rhin.</p>\n</td>\n<td valign=\"top\" width=\"114\">\n<p align=\"center\">DDAF 68</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p align=\"center\">SN Strasbourg</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p align=\"center\">3 octobre 2005</p>\n</td>\n</tr>\n</tbody>\n</table>"

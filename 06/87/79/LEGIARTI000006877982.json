  "BLOC_TEXTUEL": {
    "CONTENU": "<p align=\"center\">LISTE DES SERVICES D'ANNONCE DES CRUES AVEC LEURS COMPÉTENCES TERRITORIALES DANS LE BASSIN RHÔNE-MÉDITERRANÉE</p>\n<p align=\"center\"> </p>\n<table>\n<tbody>\n<tr>\n<td width=\"94\">\n<p align=\"center\">SOUS-BASSIN</p>\n</td>\n<td width=\"246\">\n<p align=\"center\">DOMAINE GÉOGRAPHIQUE DE COMPÉTENCE</p>\n</td>\n<td width=\"114\">\n<p align=\"center\">SERVICE ACTUEL</p>\n</td>\n<td width=\"113\">\n<p align=\"center\">SERVICE FUTUR</p>\n</td>\n<td width=\"113\">\n<p align=\"center\">DATE D'EFFET</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"94\">\n<p>Saône amont.</p>\n</td>\n<td valign=\"top\" width=\"246\">\n<p>Saône à l'amont du confluent avec l'Ognon, Ognon.</p>\n</td>\n<td valign=\"top\" width=\"114\">\n<p align=\"center\">DDE 70</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p align=\"center\">DIREN Rhône-Alpes</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p align=\"center\">5 janvier 2006</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"94\">\n<p>Doubs.</p>\n</td>\n<td valign=\"top\" width=\"246\">\n<p>Doubs à l'amont de la Saône-et-Loire, Loue.</p>\n</td>\n<td valign=\"top\" width=\"114\">\n<p align=\"center\">DDE 25</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p align=\"center\">DIREN Rhône-Alpes</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p align=\"center\">27 juin 2006</p>\n</td>\n</tr>\n<tr>\n<td rowspan=\"4\" valign=\"top\" width=\"94\">\n<p>Rhône amont.</p>\n</td>\n<td valign=\"top\" width=\"246\">\n<p>Rhône jusqu'à la confluence avec l'Ardèche.</p>\n</td>\n<td rowspan=\"4\" valign=\"top\" width=\"114\">\n<p align=\"center\">SN Rhône Saône</p>\n</td>\n<td rowspan=\"4\" valign=\"top\" width=\"113\">\n<p align=\"center\">DIREN Rhône-Alpes</p>\n</td>\n<td rowspan=\"4\" valign=\"top\" width=\"113\">\n<p align=\"center\">17 janvier 2005</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"246\">\n<p>Saône à l'aval du confluent de l'Ognon.</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"246\">\n<p>Doubs en Saône-et-Loire.</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"246\">\n<p>Ain à partir de Pont-d'Ain.</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"94\">\n<p>Isère.</p>\n</td>\n<td valign=\"top\" width=\"246\">\n<p>Isère depuis son entrée dans le département de l'Isère et Drac à partir du confluent de la Romanche.</p>\n</td>\n<td valign=\"top\" width=\"114\">\n<p align=\"center\">DDE 38</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p align=\"center\">DDE 38</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p align=\"center\">Sans objet</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"94\">\n<p>Ardèche.</p>\n</td>\n<td valign=\"top\" width=\"246\">\n<p>Ardèche, Chassezac, Beaume, Eyrieux, Cance, Doux, Ouvèze ardéchoise.</p>\n</td>\n<td valign=\"top\" width=\"114\">\n<p align=\"center\">DDE 07</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p align=\"center\">DDE 30</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p align=\"center\">5 janvier 2006</p>\n</td>\n</tr>\n<tr>\n<td rowspan=\"3\" valign=\"top\" width=\"94\">\n<p>Rhône aval et Durance.</p>\n</td>\n<td valign=\"top\" width=\"246\">\n<p>Rhône à l'aval du confluent de l'Ardèche.</p>\n</td>\n<td rowspan=\"3\" valign=\"top\" width=\"114\">\n<p align=\"center\">DDE 84</p>\n</td>\n<td rowspan=\"3\" valign=\"top\" width=\"113\">\n<p align=\"center\">DDE 30</p>\n</td>\n<td rowspan=\"3\" valign=\"top\" width=\"113\">\n<p align=\"center\">4 juillet 2005</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"246\">\n<p>Durance à l'aval du barrage de Serre-Ponçon.</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"246\">\n<p>Aygues et Ouvèze.</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"94\">\n<p>Huveaune.</p>\n</td>\n<td valign=\"top\" width=\"246\">\n<p>Huveaune à partir de la commune d'Aubagne.</p>\n</td>\n<td valign=\"top\" width=\"114\">\n<p align=\"center\">DDE 13</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p align=\"center\">Météo-France/DIRSE</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p align=\"center\">5 janvier 2006</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"94\">\n<p>Gard.</p>\n</td>\n<td valign=\"top\" width=\"246\">\n<p>Cèze, Gardons, Vidourle, Vistre.</p>\n</td>\n<td valign=\"top\" width=\"114\">\n<p align=\"center\">DDE 30</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p align=\"center\">DDE 30</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p align=\"center\">Sans objet</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"94\">\n<p>Hérault et Orb.</p>\n</td>\n<td valign=\"top\" width=\"246\">\n<p>Hérault, Orb, Jaur.</p>\n</td>\n<td valign=\"top\" width=\"114\">\n<p align=\"center\">DDE 34</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p align=\"center\">DDE 11</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p align=\"center\">1er juillet 2005</p>\n</td>\n</tr>\n<tr>\n<td rowspan=\"3\" valign=\"top\" width=\"94\">\n<p>Aude.</p>\n</td>\n<td valign=\"top\" width=\"246\">\n<p>Aude à partir de Quillan.</p>\n</td>\n<td rowspan=\"3\" valign=\"top\" width=\"114\">\n<p align=\"center\">DDE 11</p>\n</td>\n<td rowspan=\"3\" valign=\"top\" width=\"113\">\n<p align=\"center\">DDE 11</p>\n</td>\n<td rowspan=\"3\" valign=\"top\" width=\"113\">\n<p align=\"center\">Sans objet</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"246\">\n<p>Cesse à partir de Bize.</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"246\">\n<p>Orbieu à partir de Lagrasse.</p>\n</td>\n</tr>\n<tr>\n<td rowspan=\"6\" valign=\"top\" width=\"94\">\n<p>Pyrénées-Orientales.</p>\n</td>\n<td valign=\"top\" width=\"246\">\n<p>Agly depuis Saint-Paul-de-Fenouillet.</p>\n</td>\n<td rowspan=\"6\" valign=\"top\" width=\"114\">\n<p align=\"center\">DDE 66</p>\n</td>\n<td rowspan=\"6\" valign=\"top\" width=\"113\">\n<p align=\"center\">DDE 11</p>\n</td>\n<td rowspan=\"6\" valign=\"top\" width=\"113\">\n<p align=\"center\">5 janvier 2006</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"246\">\n<p>Verdouble depuis Tautavel.</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"246\">\n<p>Tech depuis Prats-de-Mollo.</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"246\">\n<p>Têt depuis Prades.</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"246\">\n<p>Réart depuis Pollestres.</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"246\">\n<p>Canterrane depuis Ponteilla.</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"94\">\n<p>Var.</p>\n</td>\n<td valign=\"top\" width=\"246\">\n<p>Var.</p>\n</td>\n<td valign=\"top\" width=\"114\">\n<p align=\"center\">DDE 06</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p align=\"center\">Météo-France/DIRSE</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p align=\"center\">5 janvier 2006</p>\n</td>\n</tr>\n</tbody>\n</table>"
  }
}
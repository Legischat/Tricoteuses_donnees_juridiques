  "BLOC_TEXTUEL": {
    "CONTENU": "<p align=\"center\">LISTE DES SERVICES D'ANNONCE DES CRUES AVEC LEURS COMPÉTENCES TERRITORIALES DANS LE BASSIN SEINE-NORMANDIE</p>\n<p align=\"center\"> </p>\n<p align=\"center\"> </p>\n<table>\n<tbody>\n<tr>\n<td width=\"94\">\n<p align=\"center\">SOUS-BASSIN</p>\n</td>\n<td width=\"246\">\n<p align=\"center\">DOMAINE GÉOGRAPHIQUE DE COMPÉTENCE</p>\n</td>\n<td width=\"114\">\n<p align=\"center\">SERVICE ACTUEL</p>\n</td>\n<td width=\"113\">\n<p align=\"center\">SERVICE FUTUR</p>\n</td>\n<td width=\"113\">\n<p align=\"center\">DATE D'EFFET</p>\n</td>\n</tr>\n<tr>\n<td rowspan=\"2\" valign=\"top\" width=\"94\">\n<p>Haute Seine et Aube.</p>\n</td>\n<td valign=\"top\" width=\"246\">\n<p>Seine entre l'entrée du département de l'Aube et à l'amont du département de Seine-et-Marne.</p>\n</td>\n<td rowspan=\"2\" valign=\"top\" width=\"114\">\n<p align=\"center\">DDE 10</p>\n</td>\n<td rowspan=\"2\" valign=\"top\" width=\"113\">\n<p align=\"center\">DIREN<br/>Champagne-Ardenne</p>\n</td>\n<td rowspan=\"2\" valign=\"top\" width=\"113\">\n<p align=\"center\">5 juillet 2006</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"246\">\n<p>Aube à l'aval de Bar-sur-Aube.</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"94\">\n<p>Seine amont.</p>\n</td>\n<td valign=\"top\" width=\"246\">\n<p>Seine entre l'entrée dans le département de Seine-et-Marne et la confluence avec l'Yonne.</p>\n</td>\n<td valign=\"top\" width=\"114\">\n<p align=\"center\">DDE 10</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p align=\"center\">DIREN Ile-de-France</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p align=\"center\">2 novembre 2005</p>\n</td>\n</tr>\n<tr>\n<td rowspan=\"4\" valign=\"top\" width=\"94\">\n<p>Yonne amont et Loing.</p>\n</td>\n<td valign=\"top\" width=\"246\">\n<p>Yonne de Clamecy jusqu'à l'aval du pont Paul-Bert à Auxerre.</p>\n</td>\n<td rowspan=\"4\" valign=\"top\" width=\"114\">\n<p align=\"center\">DDE 58</p>\n</td>\n<td rowspan=\"4\" valign=\"top\" width=\"113\">\n<p align=\"center\">DIREN Ile-de-France</p>\n</td>\n<td rowspan=\"4\" valign=\"top\" width=\"113\">\n<p align=\"center\">2 novembre 2005</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"246\">\n<p>Loing en aval de Dammary-sur-Loing.</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"246\">\n<p>Ouanne en aval de Douchy.</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"246\">\n<p>Cure en aval de Vermenton.</p>\n</td>\n</tr>\n<tr>\n<td rowspan=\"3\" valign=\"top\" width=\"94\">\n<p>Yonne aval.</p>\n</td>\n<td valign=\"top\" width=\"246\">\n<p>Yonne en aval du pont Paul-Bert à Auxerre.</p>\n</td>\n<td rowspan=\"3\" valign=\"top\" width=\"114\">\n<p align=\"center\">SN Seine</p>\n</td>\n<td rowspan=\"3\" valign=\"top\" width=\"113\">\n<p align=\"center\">DIREN Ile-de-France</p>\n</td>\n<td rowspan=\"3\" valign=\"top\" width=\"113\">\n<p align=\"center\">2 novembre 2005</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"246\">\n<p>Serein en aval d'Isle-sur-Serein.</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"246\">\n<p>Armançon en aval d'Aisy-sur-Armançon.</p>\n</td>\n</tr>\n<tr>\n<td rowspan=\"2\" valign=\"top\" width=\"94\">\n<p>Marne amont.</p>\n</td>\n<td valign=\"top\" width=\"246\">\n<p>Marne à l'aval de Marnay-sur-Marne et à l'amont du département de l'Aisne.</p>\n</td>\n<td rowspan=\"2\" valign=\"top\" width=\"114\">\n<p align=\"center\">DDE 52</p>\n</td>\n<td rowspan=\"2\" valign=\"top\" width=\"113\">\n<p align=\"center\">DIREN<br/>Champagne-Ardenne</p>\n</td>\n<td rowspan=\"2\" valign=\"top\" width=\"113\">\n<p align=\"center\">5 juillet 2006</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"246\">\n<p>Saulx à l'aval de Montiers-sur-Saulx et Ornain à l'aval de Houdelaincourt.</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"94\">\n<p>Marne moyenne.</p>\n</td>\n<td valign=\"top\" width=\"246\">\n<p>Marne dans le département de l'Aisne.</p>\n</td>\n<td valign=\"top\" width=\"114\">\n<p align=\"center\">SN Seine</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p align=\"center\">DIREN<br/>Champagne-Ardenne</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p align=\"center\">5 juillet 2006</p>\n</td>\n</tr>\n<tr>\n<td rowspan=\"2\" valign=\"top\" width=\"94\">\n<p>Oise amont.</p>\n</td>\n<td valign=\"top\" width=\"246\">\n<p>Oise à l'aval de Hirson et en amont du département du Val-d'Oise.</p>\n</td>\n<td rowspan=\"2\" valign=\"top\" width=\"114\">\n<p align=\"center\">SN Seine</p>\n</td>\n<td rowspan=\"2\" valign=\"top\" width=\"113\">\n<p align=\"center\">SN Seine</p>\n</td>\n<td rowspan=\"2\" valign=\"top\" width=\"113\">\n<p align=\"center\">Sans objet</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"246\">\n<p>Aisne et Aire.</p>\n</td>\n</tr>\n<tr>\n<td rowspan=\"2\" valign=\"top\" width=\"94\">\n<p>Ile-de-France.</p>\n</td>\n<td valign=\"top\" width=\"246\">\n<p>Marne et Oise en Ile-de-France.</p>\n</td>\n<td rowspan=\"2\" valign=\"top\" width=\"114\">\n<p align=\"center\">DIREN Ile-de-France</p>\n</td>\n<td rowspan=\"2\" valign=\"top\" width=\"113\">\n<p align=\"center\">DIREN Ile-de-France</p>\n</td>\n<td rowspan=\"2\" valign=\"top\" width=\"113\">\n<p align=\"center\">Sans objet</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"246\">\n<p>Seine du confluent de l'Yonne au barrage de Poses.</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"94\">\n<p>Seine aval.</p>\n</td>\n<td valign=\"top\" width=\"246\">\n<p>Seine à l'aval du barrage de Poses.</p>\n</td>\n<td valign=\"top\" width=\"114\">\n<p align=\"center\">SE Seine (4e section)</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p align=\"center\">DDE 76</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p align=\"center\">5 juillet 2006</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"94\">\n<p>Eure amont.</p>\n</td>\n<td valign=\"top\" width=\"246\">\n<p>Eure de Chuisnes à Cherisy.</p>\n</td>\n<td valign=\"top\" width=\"114\">\n<p align=\"center\">DDE 28</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p align=\"center\">DDE 76</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p align=\"center\">5 juillet 2006</p>\n</td>\n</tr>\n<tr>\n<td rowspan=\"8\" valign=\"top\" width=\"94\">\n<p>Eure aval et Epte.</p>\n</td>\n<td valign=\"top\" width=\"246\">\n<p>Eure à l'aval de Cherisy.</p>\n</td>\n<td rowspan=\"8\" valign=\"top\" width=\"114\">\n<p align=\"center\">DDE 27</p>\n</td>\n<td rowspan=\"8\" valign=\"top\" width=\"113\">\n<p align=\"center\">DDE 46</p>\n</td>\n<td rowspan=\"8\" valign=\"top\" width=\"113\">\n<p align=\"center\">5 juillet 2006</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"246\">\n<p>Avre à l'aval de Saint-Christophe-sur-Avre.</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"246\">\n<p>L'Iton à l'aval de Bourth.</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"246\">\n<p>La Risle à l'aval de Rugles.</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"246\">\n<p>La Charentonne à l'aval de Notre-Dame-du-Hamel.</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"246\">\n<p>L'Andelle dans le département de l'Eure.</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"246\">\n<p>L'Epte à l'aval de Gournay-en-Bray.</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"246\">\n<p>La Guiel à l'aval de Montreuil-l'Argille.</p>\n</td>\n</tr>\n<tr>\n<td rowspan=\"3\" valign=\"top\" width=\"94\">\n<p>Orne, Dives et Toucques.</p>\n</td>\n<td valign=\"top\" width=\"246\">\n<p>L'Orne à l'aval d'Argentan.</p>\n</td>\n<td rowspan=\"3\" valign=\"top\" width=\"114\">\n<p align=\"center\">DDE 14</p>\n</td>\n<td rowspan=\"3\" valign=\"top\" width=\"113\">\n<p align=\"center\">DDE 76</p>\n</td>\n<td rowspan=\"3\" valign=\"top\" width=\"113\">\n<p align=\"center\">5 juillet 2006</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"246\">\n<p>La Dives à l'aval de Beaumais.</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"246\">\n<p>La Touques à l'aval de Mardilly.</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"94\">\n<p>Vire.</p>\n</td>\n<td valign=\"top\" width=\"246\">\n<p>La Vire à l'aval de Condé-sur-Vire.</p>\n</td>\n<td valign=\"top\" width=\"114\">\n<p align=\"center\">DDE 50</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p align=\"center\">DDE 76</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p align=\"center\">5 juillet 2006</p>\n</td>\n</tr>\n</tbody>\n</table>"

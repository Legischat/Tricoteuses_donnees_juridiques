  "BLOC_TEXTUEL": {
    "CONTENU": "<p>Dans son étude de dangers, l'exploitant doit, pour chaque installation susceptible de générer un accident présentant des effets à l'extérieur de l'établissement, renseigner le tableau suivant pour chaque phénomène dangereux identifié :</p>\n<table>\n<thead>\n<tr>\n<td width=\"150\">\n<p align=\"center\">Installation :</p>\n<p align=\"center\">Probabilité d'occurrence :</p>\n<p align=\"center\">Quantité de matière active :</p>\n<p align=\"center\">Effet redouté :</p>\n<br/>\n</td>\n<td valign=\"top\" width=\"146\">\n<p align=\"center\">ZONE</p>\n</td>\n<td width=\"157\">\n<br/>\n<p align=\"center\">NOMBRE DE PERSONNES exposées à l'extérieur de l'établissement</p>\n</td>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td valign=\"top\" width=\"150\">\n<br/>\n</td>\n<td valign=\"top\" width=\"146\">\n<p align=\"center\">Z1</p>\n</td>\n<td valign=\"top\" width=\"157\">\n<br/>\n<br/>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"150\">\n<br/>\n</td>\n<td valign=\"top\" width=\"146\">\n<p align=\"center\">Z2</p>\n</td>\n<td valign=\"top\" width=\"157\">\n<br/>\n<br/>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"150\">\n<br/>\n</td>\n<td valign=\"top\" width=\"146\">\n<p align=\"center\">Z3</p>\n</td>\n<td valign=\"top\" width=\"157\">\n<br/>\n<br/>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"150\">\n<br/>\n</td>\n<td valign=\"top\" width=\"146\">\n<p align=\"center\">Z4</p>\n</td>\n<td valign=\"top\" width=\"157\">\n<br/>\n<br/>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"150\">\n<br/>\n</td>\n<td valign=\"top\" width=\"146\">\n<p align=\"center\">Z5</p>\n</td>\n<td valign=\"top\" width=\"157\">\n<br/>\n<br/>\n</td>\n</tr>\n</tbody>\n</table>\n<br/>\n<br/>\n<br/>"
  }

      "TITRE_TXT": [
        {
          "#text": "Loi du 26 mars 1897 ayant pour objet d'autoriser des dérogations à l'article 4 de la loi du 15 juillet 1845, en ce qui concerne les clôtures et barrières de chemins de fer.",
          "@c_titre_court": "Loi du 26 mars 1897",
          "@debut": "1897-03-31",

  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Pour l'application des dispositions du code de la route dans la collectivité territoriale de Mayotte, il y a lieu de lire :<br/>\n<br/>   1° \"Représentant du Gouvernement\", à la place de \"préfet\" ;<br/>\n<br/>   2° \"Collectivité territoriale de Mayotte\", à la place de \"département\" ;<br/>\n<br/>   3° \"Représentation du Gouvernement\", à la place de \"préfecture\" ;<br/>\n<br/>   4° \"Tribunal supérieur d'appel\", à la place de \"cour d'appel\".<br/>"
  },

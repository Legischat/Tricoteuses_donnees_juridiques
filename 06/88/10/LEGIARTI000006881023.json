      "TITRE_TXT": [
        {
          "#text": "Décret n°85-636 du 25 juin 1985 FIXANT LES MODALITES SELON LESQUELLES LES ENTREPRISES APPARTENANT AUX SECTEURS D'ACTIVITE QUI SONT REPRESENTES AU CONSEIL NATIONAL DES TRANSPORTS ET AUX COMITES CONSULTATIFS DES TRANSPORTS PARTICIPENT AUX FRAIS DE FONCTIONNEMENT DE CES ORGANISMES",
          "@c_titre_court": "Décret n°85-636 du 25 juin 1985",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000310005"
        },
        {
          "#text": "Décret n°85-636 du 25 juin 1985 fixant les modalités selon lesquelles les entreprises appartenant aux secteurs d'activité qui sont représentés au Conseil national des transports et aux comités consultatifs des transports participent aux frais de fonctionnement de ces organismes.",
          "@c_titre_court": "Décret n°85-636 du 25 juin 1985",

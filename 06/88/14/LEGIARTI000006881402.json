  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret n°60-848 du 6 août 1960 PORTANT APPLICATION DE L'ART. L15 DU CODE DE LA ROUTE RELATIF A L'EXAMEN PSYCHOTECHNIQUE DES CONDUCTEURS DONT LE PERMIS A ETE ANNULE ET QUI SOLLICITENT UN NOUVEAU PERMIS - COMMISSION CHARGEE D'ETABLIR LE CERTIFICAT MEDICAL",
          "@c_titre_court": "Décret n°60-848 du 6 août 1960",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000325583"
        },
        {
          "#text": "Décret n°60-848 du 6 août 1960 portant application de l'article L. 15 code de la route relatif à l'examen psychotechnique des conducteurs dont le permis a été annulé et qui sollicitent un nouveau permis",
          "@c_titre_court": "Décret n°60-848 du 6 août 1960",
          "@debut": "1960-08-11",
          "@fin": "2001-06-01",
          "@id_txt": "LEGITEXT000006060984"
        }
      ],
      "@cid": "JORFTEXT000000325583",
      "@date_publi": "1960-08-11",
      "@date_signature": "1960-08-06",
      "@nature": "DECRET",
      "@num": "60-848"
    }
  },
  "VERSIONS": {
    "VERSION": [
      {
        "LIEN_ART": {
          "@debut": "1960-08-11",

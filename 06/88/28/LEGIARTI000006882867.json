    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Décret no 97-124 du 6 février 1997 portant extension aux territoires    d'outre-mer et à la collectivité territoriale de Mayotte de dispositions du    code de l'aviation civile (deuxième partie : Décrets en Conseil d'Etat)    relatives au régime de retraite complémentaire du personnel navigant    professionnel de l'aéronautique civile",
          "@c_titre_court": "Décret n°97-124 du 6 février 1997",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000381325"
        },
        {
          "#text": "Décret n°97-124 du 6 février 1997 portant extension aux territoires d'outre-mer et à la collectivité territoriale de Mayotte de dispositions du code de l'aviation civile (deuxième partie : Décrets en Conseil d'Etat) relatives au régime de retraite complémentaire du personnel navigant professionnel de l'aéronautique civile",

      "TITRE_TXT": [
        {
          "#text": "Arrêté du 22 décembre 1987 PRIS EN APPLICATION DE L'ART. 1 DU DECRET 871045 DU 22-12-1987 RELATIF A LA PRESENTATION DES ECRITS CONSTATANT LES CONTRATS DE GARANTIE ET DE SERVICE APRES VENTE",
          "@c_titre_court": "Arrêté du 22 décembre 1987",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000494747"
        },
        {
          "#text": "Arrêté du 22 décembre 1987 pris en application de l'article 1er du décret n° 87-1045 du 22 décembre 1987 relatif à la présentation des écrits constatant les contrats de garantie et de service après vente",
          "@c_titre_court": "Arrêté du 22 décembre 1987",
          "@debut": "1987-12-29",
          "@fin": "2999-01-01",

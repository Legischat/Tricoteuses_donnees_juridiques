            "#text": "TITRE III : DISPOSITIONS APPLICABLES AUX BATEAUX DE PLAISANCE",
            "@debut": "2008-01-01",
            "@fin": "2013-03-28",
            "@id": "LEGISCTA000006112070"
          }
        ],
        "TM": {
          "TITRE_TM": [
            {
              "#text": "Chapitre Ier : Dispositions applicables aux bateaux de plaisance d'une longueur égale ou supérieure à 20 mètres ou dont le produit de la longueur, de la largeur et du tirant d'eau est égal ou supérieur à 100 mètres cubes",
              "@debut": "2008-01-01",
              "@fin": "2013-03-28",
              "@id": "LEGISCTA000006131628"
            }
          ],

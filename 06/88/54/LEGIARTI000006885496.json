      "TITRE_TXT": [
        {
          "#text": "Arrêté du 6 mai 1988 REATIF A LA TENEUR MAXIMALE EN FORMALDEHYDE PROVENANT DE L'INJECTION DES MOUSSES UREE-FORMOL DANS LES LOCAUX A USAGE D'HABITATION OU DESTINES A UNE OCCUPATION HUMAINE PERMANENTE OU SEMI-PERMANENTE",
          "@c_titre_court": "Arrêté du 6 mai 1988",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000479694"
        },
        {
          "#text": "Arrêté du 6 mai 1988 relatif à la teneur maximale en formaldéhyde provenant de l'injection des mousses urée-formol dans les locaux à usage d'habitation ou destinés à une occupation humaine permanente ou semi-permanente",
          "@c_titre_court": "Arrêté du 6 mai 1988",
          "@debut": "1988-05-08",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006058340"
        }

    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Arrêté du 11 janvier 1989 FIXANT LA LISTE DES ADDITIFS ET PRODUITS AUTORISES POUR LA FABRICATION DES BOISSONS ALCOOLISEES A BASE DE RAISIN OU DE POMME AINSI QUE DES TRAITEMENTS DONT ELLES PEUVENT FAIRE L'OBJET",
          "@c_titre_court": "Arrêté du 11 janvier 1989",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000704737"
        },
        {
          "#text": "Arrêté du 11 janvier 1989 relatif à la liste des additifs et produits autorisés pour la fabrication des boissons alcoolisées à base de raisin ou de pomme ainsi que des traitements dont elles peuvent faire l'objet",
          "@c_titre_court": "Arrêté du 11 janvier 1989",
          "@debut": "1989-01-19",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006058744"

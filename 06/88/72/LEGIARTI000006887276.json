    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Arrêté du 20 mars 1987 PRIS POUR L'APPLICATION DE L'ART. 3 DU DECRET 87190 DU 20-03-1987 ET FIXANT LES CLASSES DE NAVIRES POUVANT ETRE IMMATRICULES DANS LE TERRITOIRE DES TERRES AUSTRALES ET ANTARCTIQUES FRANCAISES (TAAF)",
          "@c_titre_court": "Arrêté du 20 mars 1987",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000682147"
        },
        {
          "#text": "Arrêté du 20 mars 1987 pris pour l'application de l'article 3 du décret n° 87-190 du 20 mars 1987 et fixant les classes de navires pouvant être immatriculés dans le territoire des Terres australes et antarctiques françaises.",
          "@c_titre_court": "Arrêté du 20 mars 1987",
          "@debut": "1987-03-24",
          "@fin": "1995-10-27",
          "@id_txt": "LEGITEXT000006057364"

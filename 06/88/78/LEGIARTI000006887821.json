  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Le dossier de demande d'inscription d'un établissement secondaire comprend :<br/>\n<br/>   1° Un formulaire de demande d'inscription au registre des entreprises de transport public de personnes (inscription secondaire) ;<br/>\n<br/>   2° Le certificat d'inscription au registre de l'entreprise ou sa copie ;<br/>\n<br/>   3° L'extrait du registre du commerce et des sociétés relatif à l'établissement.<br/>"
  },

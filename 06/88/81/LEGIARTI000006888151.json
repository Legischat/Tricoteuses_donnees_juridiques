  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   L'échelonnement indiciaire applicable au deuxième et au troisième grade du corps des techniciens de l'aviation civile est fixé comme suit à compter du 1er décembre 1988 :<br/>\n<br/>\n<table>\n<tr>\n<td> :-----------------------------:</td>\n</tr>\n<tr>\n<td> : GRADE : Chef technicien     :</td>\n</tr>\n<tr>\n<td> :        de l'aviation civile :</td>\n</tr>\n<tr>\n<td> :-----------------------------:</td>\n</tr>\n<tr>\n<td> :  ECHELONS  : INDICES BRUTS  :</td>\n</tr>\n<tr>\n<td> :------------:----------------:</td>\n</tr>\n<tr>\n<td> :    7e      :      579       :</td>\n</tr>\n<tr>\n<td> :    6e      :      559       :</td>\n</tr>\n<tr>\n<td> :    5e      :      524       :</td>\n</tr>\n<tr>\n<td> :    4e      :      484       :</td>\n</tr>\n<tr>\n<td> :    3e      :      451       :</td>\n</tr>\n<tr>\n<td> :    2e      :      407       :</td>\n</tr>\n<tr>\n<td> :    1er     :      359       :</td>\n</tr>\n<tr>\n<td> :-----------------------------:</td>\n</tr>\n<tr>\n<td> :-----------------------------:</td>\n</tr>\n<tr>\n<td> : GRADE : Technicien supérieur:</td>\n</tr>\n<tr>\n<td> :        de l'aviation civile :</td>\n</tr>\n<tr>\n<td> :-----------------------------:</td>\n</tr>\n<tr>\n<td> :  ECHELONS  : INDICES BRUTS  :</td>\n</tr>\n<tr>\n<td> :------------:----------------:</td>\n</tr>\n<tr>\n<td> :    7e      :      533       :</td>\n</tr>\n<tr>\n<td> :    6e      :      514       :</td>\n</tr>\n<tr>\n<td> :    5e      :      487       :</td>\n</tr>\n<tr>\n<td> :    4e      :      451       :</td>\n</tr>\n<tr>\n<td> :    3e      :      417       :</td>\n</tr>\n<tr>\n<td> :    2e      :      375       :</td>\n</tr>\n<tr>\n<td> :    1er     :      324       :</td>\n</tr>\n<tr>\n<td> :-----------------------------:</td>\n</tr>\n</table>\n<br/>"
  }

  "BLOC_TEXTUEL": {
    "CONTENU": "<p>L'échelonnement indiciaire applicable aux corps des officiers contrôleurs en chef de la circulation aérienne et des officiers contrôleurs de la circulation aérienne est fixé comme suit à compter du 1er décembre 1988 :</p>\n<table>\n<tbody>\n<tr>\n<td valign=\"top\" width=\"125\">\n<p align=\"center\">GRADE ou EMPLOI</p>\n</td>\n<td width=\"131\">\n<p align=\"center\">ECHELONS</p>\n</td>\n<td width=\"122\">\n<p align=\"center\">INDICES BRUTS</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"125\">\n<p align=\"center\"> </p>\n</td>\n<td width=\"131\">\n<p align=\"center\"> </p>\n</td>\n<td width=\"122\">\n<p align=\"center\"> </p>\n</td>\n</tr>\n<tr>\n<td rowspan=\"7\" valign=\"top\" width=\"125\">\n<p align=\"center\">Officier contrôleur en chef de la circulation aérienne</p>\n</td>\n<td width=\"131\">\n<p align=\"center\">7e</p>\n</td>\n<td width=\"122\">\n<p align=\"center\">759</p>\n</td>\n</tr>\n<tr>\n<td width=\"131\">\n<p align=\"center\">6e</p>\n</td>\n<td width=\"122\">\n<p align=\"center\">729</p>\n</td>\n</tr>\n<tr>\n<td width=\"131\">\n<p align=\"center\">5e</p>\n</td>\n<td width=\"122\">\n<p align=\"center\">702</p>\n</td>\n</tr>\n<tr>\n<td width=\"131\">\n<p align=\"center\">4e</p>\n</td>\n<td width=\"122\">\n<p align=\"center\">676</p>\n</td>\n</tr>\n<tr>\n<td width=\"131\">\n<p align=\"center\">3e</p>\n</td>\n<td width=\"122\">\n<p align=\"center\">642</p>\n</td>\n</tr>\n<tr>\n<td width=\"131\">\n<p align=\"center\">2e</p>\n</td>\n<td width=\"122\">\n<p align=\"center\">619</p>\n</td>\n</tr>\n<tr>\n<td width=\"131\">\n<p align=\"center\">1er</p>\n</td>\n<td width=\"122\">\n<p align=\"center\">573</p>\n</td>\n</tr>\n<tr>\n<td rowspan=\"9\" valign=\"top\" width=\"125\">\n<p align=\"center\">Officier contrôleur principal de la circulation aérienne</p>\n</td>\n<td width=\"131\">\n<p align=\"center\">9e</p>\n</td>\n<td width=\"122\">\n<p align=\"center\">677</p>\n</td>\n</tr>\n<tr>\n<td width=\"131\">\n<p align=\"center\">8e</p>\n</td>\
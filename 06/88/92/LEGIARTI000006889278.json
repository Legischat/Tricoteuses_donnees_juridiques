      "TITRE_TXT": [
        {
          "#text": "Arrêté du 11 juillet 1973 VALEUR MARCHANDE EN DESSOUS DE LAQUELLE LES VEHICULES MIS EN FOURRIERE ET DECLARES PAR EXPERT HORS D'ETAT DE CIRCULER SERONT ENVOYES A LA DESTRUCTION. (APPLICATION DE L'ARTICLE L25-3 DU CODE DE LA ROUTE)",
          "@c_titre_court": "Arrêté du 11 juillet 1973",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000486210"
        },
        {
          "#text": "Arrêté du 11 juillet 1973 fixant la valeur marchande en dessous de laquelle les véhicules mis en fourrière et déclarés par expert hors d'état de circuler seront envoyés à la destruction (application de l'article L. 25-3 code de la route).",
          "@c_titre_court": "Arrêté du 11 juillet 1973",
          "@debut": "1973-07-20",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006075079"
        }
      ],

  "BLOC_TEXTUEL": {
    "CONTENU": "<p>La durée et le coefficient des épreuves sont fixées comme suit : </p>\n<table>\n<tbody>\n<tr>\n<td width=\"454\">\n<p align=\"center\">NATURE DES ÉPREUVES</p>\n</td>\n<td width=\"113\">\n<p align=\"center\">TEMPS<br/>accordé</p>\n</td>\n<td width=\"113\">\n<p align=\"center\">COEFFICIENT</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"454\">\n<p>Droit. - Accès au marché</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p align=\"center\">25 mm</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p align=\"center\">8</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"454\">\n<p>Gestion commerciale et financière de l'entreprise</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p align=\"center\">25 mm</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p align=\"center\">8</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"454\">\n<p>Normes et exploitation techniques. - Sécurité</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p align=\"center\">15 mm</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p align=\"center\">4</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"454\">\n<p>Durée</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p align=\"center\">65 mm</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p align=\"center\"> </p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"454\">\n<p>Total des coefficients</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p align=\"center\"> </p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p align=\"center\">20</p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"454\">\n<p>Transports internationaux (option)</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p align=\"center\">15 mm</p>\n</td>\n<td valign=\"top\" width=\"113\">\n<p align=\"center\">1</p>\n</td>\n</tr>\n</tbody>\n</table>"
  },

          {
            "#text": "2° Application du 2° de l'article R. 61 du code de la route.",
            "@debut": "1997-07-19",
            "@fin": "2023-07-07",
            "@id": "LEGISCTA000006112480"
          }
        ],
        "TM": {
          "TITRE_TM": [
            {
              "#text": "En circulation, tout véhicule à moteur ou ensemble de véhicules en mouvement doit satisfaire aux dispositions du point 1.5 de l'annexe 1 de la directive 96/53/CE, modifiée par la directive 2002/7/CE",
              "@debut": "2003-07-10",
              "@fin": "2023-07-07",
              "@id": "LEGISCTA000006131989"
            }
          ],
          "TM": {
            "TITRE_TM": [
              {
                "#text": "En circulation, tout autobus ou autocar doit satisfaire aux dispositions du point 1.5 bis de l'annexe 1 de la directive 96/53/CE, modifiée par la directive 2002/7/CE",
                "@debut": "2003-07-10",
                "@fin": "2023-07-07",
                "@id": "LEGISCTA000006145232"
              }
            ]
          }

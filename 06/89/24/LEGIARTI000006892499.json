      "TITRE_TXT": [
        {
          "#text": "Arrêté du 3 avril 1980 CERTIFICATS DE LIMITATION DE NUISANCES DESTINES AUX AVIONS A HELICES DE MASSE MAXIMALE AU DECOLLAGE INFERIEURE OU EGALE A 5700 KGS",
          "@c_titre_court": "Arrêté du 3 avril 1980",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000310861"
        },
        {
          "#text": "Arrêté du 3 avril 1980 relatif aux certificats de limitation des nuisances destinés aux avions à hélices de masse maximale au décollage inférieure ou égale à 5700 kg.",
          "@c_titre_court": "Arrêté du 3 avril 1980",
          "@debut": "1980-05-15",
          "@fin": "1987-04-09",
          "@id_txt": "LEGITEXT000006075113"
        }
      ],
      "TM": {
        "TITRE_TM": [
          {
            "#text": "Niveau maximal de bruit.",

  "BLOC_TEXTUEL": {
    "CONTENU": "<p align=\"center\">TABLEAU 1</p>\n<table>\n<tbody>\n<tr>\n<td width=\"151\">SOCIÉTÉS concessionnaires d'autoroutes</td>\n<td width=\"454\">MAJORATION EN POURCENTAGE<br/>du tarif kilométrique moyen (HT) applicable aux véhicules de la classe 1</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"151\">COFIROUTE</td>\n<td valign=\"top\" width=\"454\">1,61 %</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"151\">ATMB</td>\n<td valign=\"top\" width=\"454\">3,45 %</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"151\">SFTRF</td>\n<td valign=\"top\" width=\"454\">1,79 %</td>\n</tr>\n</tbody>\n</table>\n<p align=\"center\">TABLEAU 2</p>\n<p align=\"center\"> </p>\n<table>\n<tbody>\n<tr>\n<td rowspan=\"2\" width=\"151\">SOCIÉTÉS concessionnaires d'autoroutes</td>\n<td colspan=\"2\" width=\"454\">RAPPORTS DES TARIFS MOYENS</td>\n</tr>\n<tr>\n<td width=\"227\">Applicables aux véhicules de la classe 3 aux tarifs moyens applicables aux véhicules de la classe 1</td>\n<td width=\"227\">Applicables aux véhi­cules de la classe 4 aux tarifs moyens applicables aux véhicules de la classe 1</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"151\">COFIROUTE</td>\n<td valign=\"top\" width=\"227\">2,23</td>\n<td valign=\"top\" width=\"227\">2,95</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"151\">ATMB</td>\n<td valign=\"top\" width=\"227\">2,50</td>\n<td valign=\"top\" width=\"227\">3,21</td>\n</tr>\n<tr>\n<td valign=\"top\" width=\"151\">SFTRF</td>\n<td valign=\"top\" width=\"227\">2,94</td>\n<td valign=\"top\" width=\"227\">3,89</td>\n</tr>\n</tbody>\n</table>"

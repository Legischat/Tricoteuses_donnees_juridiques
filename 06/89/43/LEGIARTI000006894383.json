  "CONTEXTE": {
    "TEXTE": {
      "TITRE_TXT": [
        {
          "#text": "Arrêté du 30 décembre 2004 relatif aux règles générales d'attribution de l'aide instituée en faveur des commerçants et artisans par l'article 106 de la loi de finances pour 1982",
          "@c_titre_court": "Arrêté du 30 décembre 2004",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000238052"
        },
        {
          "#text": "Arrêté du 30 décembre 2004 relatif aux règles générales d'attribution de l'aide instituée en faveur des commerçants et artisans par l'article 106 de la loi de finances pour 1982.",
          "@c_titre_court": "Arrêté du 30 décembre 2004",
          "@debut": "2004-12-31",
          "@fin": "2999-01-01",
          "@id_txt": "LEGITEXT000006009039"
        }
      ],
      "TM": {
        "TITRE_TM": [
          {
            "#text": "III - Décision d'attribution de l'aide.",
            "@debut": "2004-12-31",
            "@fin": "2999-01-01",
            "@id": "LEGISCTA000006112628"
          }
        ],
        "TM": {
          "TITRE_TM": [
            {
              "#text": "L'ensemble des propositions d'attribution d'indemnités faites par chaque commission d'attribution est porté sur un procès-verbal établi après chaque séance",
              "@debut": "2007-05-12",
              "@fin": "2999-01-01",
              "@id": "LEGISCTA000006132076"
            }
          ],
          "TM": {
            "TITRE_TM": [
              {
                "#text": "Chaque procès-verbal est transmis à la Caisse nationale du régime social des indépendants, accompagné des fiches de liquidation afférentes à chaque dossier, pour vérification de la légalité des décisions prises",
                "@debut": "2007-05-12",
                "@fin": "2999-01-01",
                "@id": "LEGISCTA000006145241"
              }
            ],
            "TM": {
              "TITRE_TM": [
                {
                  "#text": "Ces fiches comportent la synthèse des pièces requises pour l'attribution de l'aide et, notamment, du questionnaire prévu à l'article précédent",
                  "@debut": "2007-05-12",
                  "@fin": "2999-01-01",
                  "@id": "LEGISCTA000006160481"
                }
              ],
              "TM": {
                "TITRE_TM": [
                  {
                    "#text": "La caisse nationale établit ensuite un récapitulatif des fiches validées qu'elle envoie, pour approbation, au ministre chargé du commerce et de l'artisanat (direction du commerce, de l'artisanat, des services et des professions libérales)",
                    "@debut": "2007-05-12",
                    "@fin": "2999-01-01",
                    "@id": "LEGISCTA000006177427"
                  }
                ],
                "TM": {
                  "TITRE_TM": [
                    {
                      "#text": "Au vu du procès-verbal de séance et après notification de l'accord du ministre, l'indemnité est mise en paiement par la caisse",
                      "@debut": "2007-05-12",
                      "@fin": "2999-01-01",
                      "@id": "LEGISCTA000006189183"
                    }
                  ]
                }
              }
            }
          }
        }
      },
      "@cid": "JORFTEXT000000238052",

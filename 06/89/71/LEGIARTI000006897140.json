  "BLOC_TEXTUEL": {
    "CONTENU": "<p>Les plafonds visés à l'article R. 318-4 sont définis par le tableau suivant : </p>\n<br/>\n<table border=\"1\" cellpadding=\"0\" cellspacing=\"1\">\n<thead>\n<tr>\n<td width=\"273\">\n<p align=\"center\">NOMBRE DE PERSONNES destinées à occuper le logement </p>\n</td>\n<td width=\"91\">\n<p align=\"center\">ZONE A (en euros) </p>\n</td>\n<td width=\"91\">\n<p align=\"center\">ZONES B ET C (en euros) </p>\n</td>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td valign=\"top\">\n<p>1 personne </p>\n</td>\n<td valign=\"top\">\n<p align=\"center\">31 250 </p>\n</td>\n<td valign=\"top\">\n<p align=\"center\">23 688 </p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\">\n<p>2 personnes </p>\n</td>\n<td valign=\"top\">\n<p align=\"center\">43 750 </p>\n</td>\n<td valign=\"top\">\n<p align=\"center\">31 588 </p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\">\n<p>3 personnes </p>\n</td>\n<td valign=\"top\">\n<p align=\"center\">50 000 </p>\n</td>\n<td valign=\"top\">\n<p align=\"center\">36 538 </p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\">\n<p>4 personnes </p>\n</td>\n<td valign=\"top\">\n<p align=\"center\">56 875 </p>\n</td>\n<td valign=\"top\">\n<p align=\"center\">40 488 </p>\n</td>\n</tr>\n<tr>\n<td valign=\"top\">\n<p>5 personnes et plus </p>\n</td>\n<td valign=\"top\">\n<p align=\"center\">64 875 </p>\n</td>\n<td valign=\"top\">\n<p align=\"center\">44 425</p>\n</td>\n</tr>\n</tbody>\n</table>\n<br/>"
  },

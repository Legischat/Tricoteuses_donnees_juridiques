  "BLOC_TEXTUEL": {
    "CONTENU": "<p>1° Le montant maximum mentionné au a du 1° de l'article R. 318-10 est défini par le tableau suivant :</p>\n<div>\n<table border=\"1\" cellpadding=\"4\" cellspacing=\"1\">\n<thead>\n<tr>\n<th align=\"center\" bgcolor=\"#efeff7\" width=\"65\"/>\n<th align=\"center\" bgcolor=\"#efeff7\" colspan=\"3\" width=\"195\">\n<br/>\n<font size=\"1\">LOGEMENT ANCIEN</font>\n</th>\n<th align=\"center\" bgcolor=\"#efeff7\" colspan=\"2\" width=\"195\">\n<br/>\n<font size=\"1\">LOGEMENT NEUF</font>\n</th>\n</tr>\n<tr>\n<th align=\"center\" bgcolor=\"#efeff7\" width=\"65\">\n<br/>\n<font size=\"1\">NOMBRE DE PERSONNES destinées à occuper le logement</font>\n</th>\n<th align=\"center\" bgcolor=\"#efeff7\" width=\"65\">\n<br/>\n<font size=\"1\">Zone A</font>\n</th>\n<th align=\"center\" bgcolor=\"#efeff7\" width=\"65\">\n<br/>\n<font size=\"1\">Zone B</font>\n</th>\n<th align=\"center\" bgcolor=\"#efeff7\" width=\"65\">\n<br/>\n<font size=\"1\">Zone C</font>\n</th>\n<th align=\"center\" bgcolor=\"#efeff7\" width=\"65\">\n<br/>\n<font size=\"1\">Zone A</font>\n</th>\n<th align=\"center\" bgcolor=\"#efeff7\" width=\"130\">\n<br/>\n<font size=\"1\">Zones B et C</font>\n</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td align=\"left\">\n<br/>1</td>\n<td align=\"center\">\n<br/>72 000</td>\n<td align=\"center\">\n<br/>44 000</td>\n<td align=\"center\">\n<br/>41 250</td>\n<td align=\"center\">\n<br/>80 000</td>\n<td align=\"center\">\n<br/>55 000</td>\n</tr>\n<tr>\n<td align=\"left\">\n<br/>2</td>\n<td align=\"center\">\n<br/>101 250</td>\n<td align=\"center\">\n<br/>66 000</td>\n<td align=\"center\">\n<br/>61 875</td>\n<td align=\"center\">\n<br/>112 500</td>\n<td align=\"center\">\n<br/>82 500</td>\n</tr>\n<tr>\n<td align=\"left\">\n<br/>3</td>\n<td align=\"center\">\n<br/>112 500</td>\n<td align=\"center\">\n<br/>76 000</td>\n<td align=\"center\">\n<br/>71 250</td>\n<td align=\"center\">\n<br/>125 000</td>\n<td align=\"center\">\n<br/>95 000</td>\n</tr>\n<tr>\n<td align=\"left\"
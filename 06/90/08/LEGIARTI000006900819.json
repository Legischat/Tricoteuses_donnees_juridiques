  "NOTA": {
    "CONTENU": "<br/>\n<br/>\n<br/>\n<p>\n<br clear=\"none\"/>\n</p>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Aucun salarié ne peut être sanctionné, licencié ou faire l'objet d'une mesure discriminatoire, directe ou indirecte, notamment en matière de rémunération, de formation, de reclassement, d'affectation, de qualification, de classification, de promotion professionnelle, de mutation ou de renouvellement de contrat pour avoir subi ou refusé de subir des agissements répétés de harcèlement moral ou pour avoir témoigné de tels agissements ou les avoir relatés.<br/>\n<br/>"
  },

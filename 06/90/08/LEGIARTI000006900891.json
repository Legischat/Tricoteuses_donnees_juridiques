  "NOTA": {
    "CONTENU": "<br/>\n<br/>\n<br/>\n<p>\n<br clear=\"none\"/>\n</p>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<p>L'employeur propose à la salariée qui occupe un poste de travail l'exposant à des risques déterminés par voie réglementaire un autre emploi compatible avec son état :</p>\n<p>1° Lorsqu'elle est en état de grossesse médicalement constaté ;</p>\n<p>2° Lorsqu'elle a accouché, compte tenu des répercussions sur sa santé ou sur l'allaitement, durant une période n'excédant pas un mois après son retour de congé postnatal.</p>"
  },

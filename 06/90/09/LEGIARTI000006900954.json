  "NOTA": {
    "CONTENU": "<br/>\n<br/>\n<br/>\n<p>\n<br clear=\"none\"/>\n</p>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Pour élever son enfant, le salarié peut, sous réserve d'en informer son employeur au moins quinze jours à l'avance, rompre son contrat de travail à l'issue du congé de maternité ou d'adoption ou, le cas échéant, deux mois après la naissance ou l'arrivée au foyer de l'enfant, sans être tenu de respecter le délai de préavis, ni de devoir de ce fait d'indemnité de rupture.<br/>\n<br/>"
  },

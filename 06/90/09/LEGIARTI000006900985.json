  "NOTA": {
    "CONTENU": "<br/>\n<br/>\n<br/>\n<p>\n<br clear=\"none\"/>\n</p>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Lorsque le salarié victime d'un accident ou d'une maladie professionnelle est titulaire d'un contrat de travail à durée déterminée, l'employeur ne peut rompre le contrat au cours des périodes de suspension du contrat que s'il justifie soit d'une faute grave de l'intéressé, soit d'un cas de force majeure.<br/>\n<br/>"
  },

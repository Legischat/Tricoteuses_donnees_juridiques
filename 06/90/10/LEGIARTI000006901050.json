  "NOTA": {
    "CONTENU": "<br/>\n<br/>\n<br/>\n<p>\n<br clear=\"none\"/>\n</p>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Lorsque l'employeur procède au licenciement pour motif économique de dix salariés ou plus dans une même période de trente jours et qu'il existe un comité d'entreprise ou des délégués du personnel dans l'entreprise, la procédure d'entretien préalable au licenciement ne s'applique pas.<br/>\n<br/>   Un décret en Conseil d'Etat détermine les modalités d'application du présent article.<br/>"
  },

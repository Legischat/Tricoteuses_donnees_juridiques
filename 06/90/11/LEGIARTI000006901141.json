  "NOTA": {
    "CONTENU": "<br/>\n<br/>\n<br/>\n<p>\n<br clear=\"none\"/>\n</p>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Si le licenciement d'un salarié survient sans que la procédure requise ait été observée, mais pour une cause réelle et sérieuse, le juge impose à l'employeur d'accomplir la procédure prévue et accorde au salarié, à la charge de l'employeur, une indemnité qui ne peut être supérieure à un mois de salaire.<br/>\n<br/>"
  },

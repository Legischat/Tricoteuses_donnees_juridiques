  "NOTA": {
    "CONTENU": "<br/>  Ordonnance 2007-329 du 12 mars 2007 art. 14 : Les dispositions de la présente ordonnance entrent en vigueur en même temps que la partie réglementaire du code du travail et au plus tard le 1er mars 2008.<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Est réputé à durée indéterminée tout contrat de travail conclu en méconnaissance des dispositions des articles L. 1242-1 à L. 1242-4, L. 1242-6 à L. 1242-8, L. 1242-12, L. 1243-11, alinéa premier, L. 1243-13, L. 1244-3 et L. 1244-4.<br/>\n<br/>"
  },

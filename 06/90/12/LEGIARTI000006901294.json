  "NOTA": {
    "CONTENU": "<br/>\n<br/>\n<br/>\n<p>\n<br clear=\"none\"/>\n</p>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>Lorsqu'une entreprise utilisatrice a recours à un salarié d'une entreprise de travail temporaire en méconnaissance des dispositions des articles L. 1251-5 à L. 1251-7, L. 1251-10 à L. 1251-12, L. 1251-30 et L. 1251-35, ce salarié peut faire valoir auprès de l'entreprise utilisatrice les droits correspondant à un contrat de travail à durée indéterminée prenant effet au premier jour de sa mission.<br/>\n<br/>"
  },

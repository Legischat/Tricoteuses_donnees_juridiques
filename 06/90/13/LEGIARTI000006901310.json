  "NOTA": {
    "CONTENU": "<br/>\n<br/>\n<br/>\n<p>\n<br clear=\"none\"/>\n</p>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<p>Pour calculer les effectifs d'une entreprise de travail temporaire, il est tenu compte :</p>\n<p>1° Des salariés permanents de cette entreprise, déterminés conformément à l'article L. 1111-2 ;</p>\n<p>2° Des salariés temporaires qui ont été liés à cette entreprise par des contrats de mission pendant une durée totale d'au moins trois mois au cours de la dernière année civile.</p>"
  },

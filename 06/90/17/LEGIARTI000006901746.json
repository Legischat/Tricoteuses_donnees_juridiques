  "NOTA": {
    "CONTENU": "<br/>\n<br/>\n<br/>\n<p>\n<br clear=\"none\"/>\n</p>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les organisations liées par une convention de branche ou, à défaut, par des accords professionnels se réunissent, une fois tous les cinq ans, pour engager une négociation sur l'institution d'un ou plusieurs plans d'épargne interentreprises ou plans d'épargne pour la retraite collectifs interentreprises lorsqu'il n'existe aucun accord conclu à ce niveau en la matière.<br/>\n<br/>"
  },

  "NOTA": {
    "CONTENU": "<br/>\n<br/>\n<br/>\n<p>\n<br clear=\"none\"/>\n</p>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Un mois après chaque élection du comité d'entreprise, l'employeur lui communique une documentation économique et financière précisant :<br/>\n<br/>   1° La forme juridique de l'entreprise et son organisation ;<br/>\n<br/>   2° Les perspectives économiques de l'entreprise telles qu'elles peuvent être envisagées ;<br/>\n<br/>   3° Le cas échéant, la position de l'entreprise au sein du groupe ;<br/>\n<br/>   4° Compte tenu des informations dont dispose l'employeur, la répartition du capital entre les actionnaires détenant plus de 10 % du capital et la position de l'entreprise dans la branche d'activité à laquelle elle appartient.<br/>"
  },

  "NOTA": {
    "CONTENU": "<br/>\n<br/>\n<br/>\n<p>\n<br clear=\"none\"/>\n</p>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Dans les entreprises disposant d'un accord d'intéressement, d'un accord de participation ou d'un plan d'épargne salariale, lorsque le comité d'entreprise n'en est pas signataire, l'employeur le consulte, avant leur prorogation ou renouvellement, sur les évolutions envisageables à leur apporter, ainsi que sur la situation de l'actionnariat salarié et sur la participation des salariés à la gestion de l'entreprise.<br/>\n<br/>"
  },

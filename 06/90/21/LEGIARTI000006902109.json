  "NOTA": {
    "CONTENU": "<br/>\n<br/>\n<br/>\n<p>\n<br clear=\"none\"/>\n</p>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Le comité central d'entreprise est composé d'un nombre égal de délégués titulaires et de suppléants, élus, pour chaque établissement, par le comité d'établissement parmi ses membres. Ce nombre est déterminé par décret en Conseil d'Etat.<br/>\n<br/>   Le nombre total des membres titulaires ne peut excéder un maximum également déterminé par décret en Conseil d'Etat.<br/>"
  },

  "NOTA": {
    "CONTENU": "<br/>\n<br/>\n<br/>\n<p>\n<br clear=\"none\"/>\n</p>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Le fait d'apporter une entrave soit à la constitution d'un comité d'entreprise, d'un comité d'établissement ou d'un comité central d'entreprise, soit à la libre désignation de leurs membres, soit à leur fonctionnement régulier, notamment par la méconnaissance des dispositions des articles L. 2324-3 à L. 2324-5 et L. 2324-8, est puni d'un emprisonnement d'un an et d'une amende de 3 750 euros.<br/>\n<br/>"
  },

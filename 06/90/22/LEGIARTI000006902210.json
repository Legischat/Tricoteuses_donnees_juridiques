  "NOTA": {
    "CONTENU": "<br/>\n<br/>\n<br/>\n<p>\n<br clear=\"none\"/>\n</p>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   On entend par participation l'influence exercée par l'organe représentant les salariés ou par les représentants des salariés sur les affaires d'une société sous les formes suivantes :<br/>\n<br/>   - soit en exerçant leur droit d'élire ou de désigner certains membres de l'organe de surveillance ou d'administration de la société ;<br/>\n<br/>   - soit en exerçant leur droit de recommander la désignation d'une partie ou de l'ensemble des membres de l'organe de surveillance ou d'administration de la société ou de s'y opposer.<br/>"
  },

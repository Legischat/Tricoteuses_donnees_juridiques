  "NOTA": {
    "CONTENU": "<br/>\n<br/>\n<br/>\n<p>\n<br clear=\"none\"/>\n</p>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>L'exercice du droit de grève ne peut justifier la rupture du contrat de travail, sauf faute lourde imputable au salarié. <br/>\n<br/>Son exercice ne peut donner lieu à aucune mesure discriminatoire telle que mentionnée à l'article L. 1132-2, notamment en matière de rémunérations et d'avantages sociaux. <br/>\n<br/>Tout licenciement prononcé en absence de faute lourde est nul de plein droit.<br/>"
  },

  "NOTA": {
    "CONTENU": "<br/>\n<br/>\n<br/>\n<p>\n<br clear=\"none\"/>\n</p>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Il est interdit à l'employeur, sous réserve des dispositions de l'article 1382 du code civil, d'imposer aux salariés des versements d'argent ou d'opérer des retenues d'argent sous la dénomination de frais ou sous toute autre dénomination pour quelque objet que ce soit, à l'occasion de l'exercice normal de leur travail dans les secteurs suivants :<br/>\n<br/>   1° Hôtels, cafés, restaurants et établissements similaires ;<br/>\n<br/>   2° Entreprises de spectacle, cercles et casinos ;<br/>\n<br/>   3° Entreprises de transport.<br/>"
  },

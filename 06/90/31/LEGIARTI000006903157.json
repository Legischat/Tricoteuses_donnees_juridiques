  "NOTA": {
    "CONTENU": "<br/>\n<br/>\n<br/>\n<p>\n<br clear=\"none\"/>\n</p>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Aucune sanction, aucune retenue de salaire ne peut être prise à l'encontre d'un travailleur ou d'un groupe de travailleurs qui se sont retirés d'une situation de travail dont ils avaient un motif raisonnable de penser qu'elle présentait un danger grave et imminent pour la vie ou pour la santé de chacun d'eux.<br/>\n<br/>"
  },

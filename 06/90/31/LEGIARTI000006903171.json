  "NOTA": {
    "CONTENU": "<br/>\n<br/>\n<br/>\n<p>\n<br clear=\"none\"/>\n</p>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>Les salariés titulaires d'un contrat de travail à durée déterminée et les salariés temporaires affectés à des postes de travail présentant des risques particuliers pour leur santé ou leur sécurité bénéficient d'une formation renforcée à la sécurité, dans les conditions prévues à l'article L. 4154-2. <br/>\n<br/>Par dérogation aux dispositions de l'article L. 4141-4, le financement de ces actions de formation est à la charge de l'entreprise utilisatrice.<br/>"
  },

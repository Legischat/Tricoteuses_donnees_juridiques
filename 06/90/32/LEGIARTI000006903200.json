  "NOTA": {
    "CONTENU": "<br/>\n<br/>\n<br/>\n<p>\n<br clear=\"none\"/>\n</p>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Il est interdit d'exposer, de mettre en vente, de vendre, d'importer, de louer, de mettre à disposition ou de céder à quelque titre que ce soit des équipements de travail et des moyens de protection qui ne répondent pas aux règles techniques du chapitre II et aux procédures de certification du chapitre III.<br/>\n<br/>"
  },

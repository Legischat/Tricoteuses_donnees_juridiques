  "NOTA": {
    "CONTENU": "<br/>  .<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les membres des anciennes professions d'avocat, d'avoué et d'agréé près les tribunaux de commerce pourront accéder aux fonctions d'avocat au Conseil d'Etat et à la Cour de cassation, d'avoué à la cour, de notaire, de commissaire-priseur, de greffier de tribunal de commerce, d'huissier de justice, de syndic, d'administrateur judiciaire et de conseil juridique.<br/>\n<br/>"
  },

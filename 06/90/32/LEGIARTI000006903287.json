  "NOTA": {
    "CONTENU": "<br/>\n<br/>\n<br/>\n<p>\n<br clear=\"none\"/>\n</p>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Un comité d'hygiène, de sécurité et des conditions de travail est constitué dans tout établissement de cinquante salariés et plus.<br/>\n<br/>   La mise en place d'un comité n'est obligatoire que si l'effectif d'au moins cinquante salariés a été atteint pendant douze mois consécutifs ou non au cours des trois années précédentes.<br/>"
  },

  "NOTA": {
    "CONTENU": "<br/>\n<br/>\n<br/>\n<p>\n<br clear=\"none\"/>\n</p>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Le fait pour un maître d'ouvrage de faire ouvrir un chantier ne disposant pas de voies et réseaux divers satisfaisant aux dispositions du décret mentionné au 7° de l'article L. 4532-18 est puni d'une amende de 22 500 euros.<br/>\n<br/>   L'interruption du travail peut être ordonnée dans les conditions prévues à l'article L. 480-2 du code de l'urbanisme.<br/>"
  },

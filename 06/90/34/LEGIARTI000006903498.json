  "BLOC_TEXTUEL": {
    "CONTENU": "<p>Les structures d'insertion par l'activité économique pouvant conclure des conventions avec l'Etat sont :</p>\n<p>1° Les entreprises d'insertion ;</p>\n<p>2° Les entreprises de travail temporaire d'insertion ;</p>\n<p>3° Les associations intermédiaires ;</p>\n<p>4° Les ateliers et chantiers d'insertion.</p>"
  },

  "NOTA": {
    "CONTENU": "<br/>\n<br/>\n<br/>\n<p>\n<br clear=\"none\"/>\n</p>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Peuvent également participer au service public de l'emploi :<br/>\n<br/>   1° Les organismes publics ou privés dont l'objet consiste en la fourniture de services relatifs au placement, à l'insertion, à la formation et à l'accompagnement des demandeurs d'emploi ;<br/>\n<br/>   2° Les organismes liés à l'Etat par une convention mentionnée à l'article L. 5132-2, relative à l'insertion par l'activité économique de personnes rencontrant des difficultés sociales et professionnelles particulières ;<br/>\n<br/>   3° Les entreprises de travail temporaire ;<br/>\n<br/>   4° Les agences de placement privées mentionnées à l'article L. 5323-1.<br/>"
  },

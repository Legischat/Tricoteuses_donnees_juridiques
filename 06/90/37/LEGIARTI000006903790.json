  "NOTA": {
    "CONTENU": "<br/>\n<br/>\n<br/>\n<p>\n<br clear=\"none\"/>\n</p>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Le fait d'exiger une rétribution, directe ou indirecte, des personnes à la recherche d'un emploi, en contrepartie de la fourniture de services de placement, en méconnaissance des dispositions de l'article L. 5321-3, est puni d'un emprisonnement de six mois et d'une amende de 3 750 euros.<br/>\n<br/>"
  },

  "NOTA": {
    "CONTENU": "<br/>\n<br/>\n<br/>\n<p>\n<br clear=\"none\"/>\n</p>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les personnes invalides mentionnées aux 2° et 3° de l'article L. 341-4 du code de la sécurité sociale, bénéficiaires à ce titre d'un avantage social lié à une incapacité totale de travail, ne peuvent être inscrites sur la liste des demandeurs d'emploi pendant la durée de leur incapacité.<br/>\n<br/>"
  },

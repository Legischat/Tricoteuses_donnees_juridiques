  "NOTA": {
    "CONTENU": "<br/>\n<br/>\n<br/>\n<p>\n<br clear=\"none\"/>\n</p>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>Sauf dans les cas prévus à l'article L. 5424-1, dans lesquels l'employeur assure lui-même la charge et la gestion de l'allocation d'assurance, tout employeur assure contre le risque de privation d'emploi tout salarié, y compris les travailleurs salariés détachés à l'étranger ainsi que les travailleurs salariés français expatriés. <br/>\n<br/>L'adhésion au régime d'assurance ne peut être refusée.<br/>"
  },

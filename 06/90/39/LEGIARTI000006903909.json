  "NOTA": {
    "CONTENU": "<br/>\n<br/>\n<br/>\n<p>\n<br clear=\"none\"/>\n</p>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les travailleurs involontairement privés d'emploi, bénéficiaires d'un revenu de remplacement, peuvent accomplir pendant une durée limitée des tâches d'intérêt général agréées par l'autorité administrative.<br/>\n<br/>   Leur indemnisation peut être complétée par une rémunération directement versée par l'organisme qui les emploie.<br/>\n<br/>   Un décret en Conseil d'Etat détermine les mesures d'application du présent article.<br/>"
  },

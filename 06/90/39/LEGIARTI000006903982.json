  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>Les compétences des régions en matière d'apprentissage et de formation professionnelle des jeunes et des adultes à la recherche d'un emploi ou d'une nouvelle orientation professionnelle sont définies par l'article L. 214-12 du code de l'éducation.<br/>\n<br/>"
  },

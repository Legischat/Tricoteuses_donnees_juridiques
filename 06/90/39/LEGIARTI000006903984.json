  "NOTA": {
    "CONTENU": "<br/>\n<br/>\n<br/>\n<p>\n<br clear=\"none\"/>\n</p>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Des conventions conclues avec les organismes collecteurs paritaires agréés au titre de la participation des employeurs de dix salariés et plus au développement de la formation professionnelle continue déterminent l'étendue et les conditions de participation des régions au financement des actions de formation définies à l'article L. 6313-1 ainsi qu'à la rémunération des bénéficiaires d'un congé individuel de formation.<br/>\n<br/>"
  },

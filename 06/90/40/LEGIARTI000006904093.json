  "NOTA": {
    "CONTENU": "<br/>\n<br/>\n<br/>\n<p>\n<br clear=\"none\"/>\n</p>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les concours financiers apportés, par l'intermédiaire d'un des organismes collecteurs de la taxe d'apprentissage, aux écoles d'enseignement technologique et professionnel qui ont bénéficié au 12 juillet 1977 d'une dérogation au titre du régime provisoire prévu par l'article L. 119-3 alors en vigueur, sont exonérés de la taxe d'apprentissage et imputés sur la fraction prévue à l'article L. 6241-2.<br/>\n<br/>"
  },

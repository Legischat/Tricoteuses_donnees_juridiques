  "NOTA": {
    "CONTENU": "<br/>\n<br/>\n<br/>\n<p>\n<br clear=\"none\"/>\n</p>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   L'organisme collecteur paritaire agréé ne peut refuser de prendre en charge le bénéficiaire du congé individuel de formation que lorsque sa demande n'est pas susceptible de se rattacher à une action de formation au sens de l'article L. 6313-1 ou lorsque les demandes de prise en charge qui lui ont été présentées ne peuvent être toutes simultanément satisfaites.<br/>\n<br/>"
  },

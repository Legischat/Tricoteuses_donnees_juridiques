  "NOTA": {
    "CONTENU": "<br/>\n<br/>\n<br/>\n<p>\n<br clear=\"none\"/>\n</p>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>Le fait de ne pas justifier des titres et qualités des personnels d'enseignement et d'encadrement employés et de la relation entre ces titres et qualités et les prestations réalisées dans le champ de la formation professionnelle, en méconnaissance des dispositions de l'article L. 6352-1, est puni d'une amende de 4 500 euros.<br/>\n<br/>"
  },

  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Sont considérés comme artistes du spectacle, notamment :<br/>\n<br/>   1° L'artiste lyrique ;<br/>\n<br/>   2° L'artiste dramatique ;<br/>\n<br/>   3° L'artiste chorégraphique ;<br/>\n<br/>   4° L'artiste de variétés ;<br/>\n<br/>   5° Le musicien ;<br/>\n<br/>   6° Le chansonnier ;<br/>\n<br/>   7° L'artiste de complément ;<br/>\n<br/>   8° Le chef d'orchestre ;<br/>\n<br/>   9° L'arrangeur-orchestrateur ;<br/>\n<br/>   l0° Le metteur en scène, pour l'exécution matérielle de sa conception artistique.<br/>"
  },

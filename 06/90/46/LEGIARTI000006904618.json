  "NOTA": {
    "CONTENU": "<br/>\n<br/>\n<br/>\n<p>\n<br clear=\"none\"/>\n</p>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>Toute agence de mannequins justifie d'une garantie financière assurant, en cas de défaillance de sa part, le paiement des salaires, de leurs accessoires et compléments, des cotisations sociales obligatoires et le versement des sommes dues au mannequin à la date de la mise en jeu de cette garantie, au titre de la rémunération définie à l'article L. 7123-6.<br/>\n<br/>"
  },

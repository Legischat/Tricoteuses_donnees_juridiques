  "NOTA": {
    "CONTENU": "<br/>\n<br/>\n<br/>\n<p>\n<br clear=\"none\"/>\n</p>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Il est interdit aux ingénieurs de prévention des directions régionales du travail, de l'emploi et de la formation professionnelle de révéler les secrets de fabrication et les procédés d'exploitation dont ils pourraient prendre connaissance dans l'exercice de leurs fonctions.<br/>\n<br/>   La méconnaissance de ces interdictions est punie conformément à l'article 226-13 du code pénal.<br/>"
  },

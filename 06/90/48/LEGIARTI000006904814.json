  "NOTA": {
    "CONTENU": "<br/>\n<br/>\n<br/>\n<p>\n<br clear=\"none\"/>\n</p>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Sont constitutives de travail illégal, dans les conditions prévues par le présent livre, les infractions suivantes :<br/>\n<br/>   1° Travail dissimulé ;<br/>\n<br/>   2° Marchandage ;<br/>\n<br/>   3° Prêt illicite de main-d'oeuvre ;<br/>\n<br/>   4° Emploi d'étranger sans titre de travail ;<br/>\n<br/>   5° Cumuls irréguliers d'emplois ;<br/>\n<br/>   6° Fraude ou fausse déclaration prévue aux articles L. 5124-1, L. 5135-1 et L. 5429-1.<br/>"
  },

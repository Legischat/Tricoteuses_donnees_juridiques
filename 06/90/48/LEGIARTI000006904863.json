  "NOTA": {
    "CONTENU": "<br/>\n<br/>\n<br/>\n<p>\n<br clear=\"none\"/>\n</p>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   La personne qui méconnaît les dispositions de l'article L. 8254-1 est tenue solidairement avec son cocontractant, sans préjudice de l'application des dispositions des articles L. 8222-1 à L. 8222-6, au paiement de la contribution spéciale prévue à l'article L. 8253-1 et de la contribution forfaitaire prévue à l'article L. 626-1 du code de l'entrée et du séjour des étrangers et du droit d'asile.<br/>\n<br/>"
  },

  "NOTA": {
    "CONTENU": "<br/>  Décret 2006-464 2006-04-20 art. 2 : les dispositions du présent article sont applicables aux assistants maternels agréés à compter du 1er janvier 2007.<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Sont dispensés de suivre la formation prévue à l'article L. 421-14 :<br/>\n<br/>   1° Les assistants familiaux ayant suivi la formation prévue à l'article L. 421-15 ;<br/>\n<br/>   2° Les assistants maternels titulaires du diplôme professionnel d'auxiliaire de puéricultrice, du certificat d'aptitude professionnelle petite enfance, ou de tout autre diplôme intervenant dans le domaine de la petite enfance homologué ou inscrit au répertoire national des certifications professionnelles au moins au niveau III.<br/>"
  },

  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Assistent à la conférence, sans voix délibérative :<br/>\n<br/>   - le directeur général de la santé ou son représentant ;<br/>\n<br/>   - le directeur de l'hospitalisation et de l'organisation des soins ou son représentant ;<br/>\n<br/>   - le directeur général de l'action sociale ou son représentant ;<br/>\n<br/>   - le directeur de la sécurité sociale ou son représentant ;<br/>\n<br/>   - le président du Haut Conseil de la santé publique ou son représentant ;<br/>\n<br/>   - le président du collège de la Haute Autorité de santé ou son représentant.<br/>"
  },

  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   La carte-lettre contient les précisions ci-après :<br/>\n<br/>   1° Nom, prénoms, date de naissance et adresse de la personne vaccinée ;<br/>\n<br/>   2° Examens médicaux et tests biologiques effectués préalablement à la vaccination ;<br/>\n<br/>   3° Date de ces examens, date de la vaccination ;<br/>\n<br/>   4° Numéro du lot du vaccin et nom du fabricant ;<br/>\n<br/>   5° Le nom et l'adresse du vaccinateur ;<br/>\n<br/>   6° Date et signature du vaccinateur.<br/>"
  },

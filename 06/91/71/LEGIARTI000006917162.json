  "NOTA": {
    "CONTENU": "<br/>   NOTA : Loi 2001-43 2001-01-16 art. 7 abroge l'ordonnance du 3 juillet 1816 en tant qu'elle concerne les courtiers interprètes et conducteurs de navires.<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   II n'est rien changé au mode actuel de nomination des agents de change (prestataires de services d'investissement), toutes les fois qu'il n'y aura pas lieu à l'application de l'article 91 de ladite loi.<br/>\n<br/>"
  },

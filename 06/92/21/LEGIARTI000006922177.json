  "NOTA": {
    "CONTENU": "<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les chambres de discipline des commissaires-priseurs comprennent, suivant le nombre des commissaires-priseurs de la compagnie :<br/>\n<br/>   Jusqu'à vingt commissaires-priseurs : cinq membres ;<br/>\n<br/>   De vingt et un à quarante commissaires-priseurs : six membres ;<br/>\n<br/>   Au-dessus de quarante commissaires-priseurs : sept membres.<br/>\n<br/>   Toutefois, la chambre de la compagnie des commissaires-priseurs de Paris compte quinze membres.<br/>"
  },

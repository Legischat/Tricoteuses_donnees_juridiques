      "TITRE_TXT": [
        {
          "#text": "Décret n°81-445 du 9 mai 1981 CONDITIONS MINIMALES D'ASSURANCE DE LA RESPONSABILITE PROFESSIONNELLE DES PERSONNES PHYSIQUES OU MORALES INSCRITES AU TABLEAU DE L'ORDRE DES EXPERTS COMPTABLES ET DES COMPTABLES AGREES OU AUTORISES A EXERCER EN FRANCE LA PROFESSION D'EXPERT COMPTABLE",
          "@c_titre_court": "Décret n°81-445 du 9 mai 1981",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000503510"
        },
        {
          "#text": "Décret n°81-445 du 7 mai 1981 pris en application de la loi n° 68-946 du 31 octobre 1968 modifiant le statut de l'ordre des experts comptables et des comptables agréés",
          "@c_titre_court": "Décret n°81-445 du 7 mai 1981",
          "@debut": "1982-01-01",

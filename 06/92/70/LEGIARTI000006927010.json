            "@id": "LEGISCTA000006113226"
          }
        ],
        "TM": {
          "TITRE_TM": [
            {
              "#text": "Conditions minimales d'assurance de la responsabilité civile professionnelle des personnes physiques ou morales inscrites au tableau de l'ordre des experts comptables agréées ou autorisées à exercer la profession d'expert comptable.",
              "@debut": "1982-01-01",
              "@fin": "1996-01-24",
              "@id": "LEGISCTA000006132671"
            }
          ]
        }
      },
      "@cid": "JORFTEXT000000503510",

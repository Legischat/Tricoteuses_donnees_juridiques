  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Sont membres de droit des comités consultatifs institués par le décret n° 85-175 du 4 février 1985 susvisé :<br/>\n<br/>   - le directeur général de l'alimentation ;<br/>\n<br/>   - le chef du service des actions vétérinaires et phytosanitaires ;<br/>\n<br/>   - le sous-directeur de la santé et de la protection animales ;<br/>\n<br/>   - le directeur général du Centre national d'études vétérinaires et alimentaires (C.N.E.V.A.) ;<br/>\n<br/>   - un représentant de l'Institut national de la recherche agronomique ;<br/>\n<br/>   - un représentant de l'Institut national de la santé et de la recherche médicale.<br/>"
  },

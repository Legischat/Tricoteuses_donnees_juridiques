  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Le service de la communication comprend :<br/>\n<br/>   - le bureau des affaires générales ;<br/>\n<br/>   - le bureau des archives ;<br/>\n<br/>   - le bureau de l'audiovisuel ;<br/>\n<br/>   - le bureau de la communication externe et des actions programmées ;<br/>\n<br/>   - le bureau de la communication interne et territoriale ;<br/>\n<br/>   - le bureau de la documentation ;<br/>\n<br/>   - le bureau des publications et de la presse.<br/>"

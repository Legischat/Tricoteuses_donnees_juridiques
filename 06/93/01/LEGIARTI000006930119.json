  "NOTA": {
    "CONTENU": "<br/>   NOTA : Décret 2005-1742 2005-12-30 art. 52 : Spécificité d'application.<br/>\n<br/>"
  },
  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Le ministre de l'intérieur et de la sécurité publique, le ministre de l'économie et des finances, le ministre de l'équipement, du logement et des transports et le secrétaire d'Etat aux collectivités locales sont chargés, chacun en ce qui le concerne, de l'exécution du présent décret, qui sera applicable aux contrats visés à l'article 1er pour lesquels la consultation sera engagée à compter du 1er septembre 1993 et qui sera publié au Journal officiel de la République française.<br/>\n<br/>"
  },

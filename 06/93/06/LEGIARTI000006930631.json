  "BLOC_TEXTUEL": {
    "CONTENU": "<p>L'échelle indiciaire applicable au corps des assistants socio-éducatifs des établissements mentionnés à l'article 2 de la loi du 9 janvier 1986 précitée est fixée conformément au tableau ci-dessous : </p>\n<table>\n<tbody>\n<tr>\n<td>\n<p align=\"center\">ECHELONS </p>\n</td>\n<td>\n<p align=\"center\">INDICES BRUTS </p>\n</td>\n</tr>\n<tr>\n<td>\n<p align=\"center\">12e échelon </p>\n</td>\n<td>\n<p align=\"center\">638 </p>\n</td>\n</tr>\n<tr>\n<td>\n<p align=\"center\">11e échelon </p>\n</td>\n<td>\n<p align=\"center\">593 </p>\n</td>\n</tr>\n<tr>\n<td>\n<p align=\"center\">10e échelon </p>\n</td>\n<td>\n<p align=\"center\">559 </p>\n</td>\n</tr>\n<tr>\n<td>\n<p align=\"center\">9e échelon </p>\n</td>\n<td>\n<p align=\"center\">527 </p>\n</td>\n</tr>\n<tr>\n<td>\n<p align=\"center\">8e échelon </p>\n</td>\n<td>\n<p align=\"center\">498 </p>\n</td>\n</tr>\n<tr>\n<td>\n<p align=\"center\">7e échelon </p>\n</td>\n<td>\n<p align=\"center\">461 </p>\n</td>\n</tr>\n<tr>\n<td>\n<p align=\"center\">6e échelon </p>\n</td>\n<td>\n<p align=\"center\">453 </p>\n</td>\n</tr>\n<tr>\n<td>\n<p align=\"center\">5e échelon </p>\n</td>\n<td>\n<p align=\"center\">422 </p>\n</td>\n</tr>\n<tr>\n<td>\n<p align=\"center\">4e échelon </p>\n</td>\n<td>\n<p align=\"center\">384 </p>\n</td>\n</tr>\n<tr>\n<td>\n<p align=\"center\">3e échelon </p>\n</td>\n<td>\n<p align=\"center\">362 </p>\n</td>\n</tr>\n<tr>\n<td>\n<p align=\"center\">2e échelon </p>\n</td>\n<td>\n<p align=\"center\">334 </p>\n</td>\n</tr>\n<tr>\n<td rowspan=\"2\">\n<p align=\"center\">1er échelon </p>\n</td>\n<td rowspan=\"2\">\n<p align=\"center\">322</p>\n</td>\n</tr>\n</tbody>\n</table>"
  },

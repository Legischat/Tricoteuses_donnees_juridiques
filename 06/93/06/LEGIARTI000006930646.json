  "BLOC_TEXTUEL": {
    "CONTENU": "<p>L'échelle indiciaire applicable au corps des moniteurs d'atelier des établissements mentionnés à l'article 2 de la loi du 9 janvier 1986 susvisée est fixée conformément au tableau ci-dessous : </p>\n<table>\n<tbody>\n<tr>\n<td width=\"224\">\n<p align=\"center\">ECHELONS</p>\n</td>\n<td width=\"224\">\n<p align=\"center\">ECHELONNEMENT <br/>indiciaire <br/>(indices bruts)</p>\n</td>\n<td width=\"224\">\n<p align=\"center\">DUREE MOYENNE</p>\n</td>\n</tr>\n<tr>\n<td width=\"224\">\n<p>10e échelon</p>\n</td>\n<td width=\"224\">\n<p align=\"center\">440</p>\n</td>\n<td width=\"224\">\n<p align=\"center\"> </p>\n</td>\n</tr>\n<tr>\n<td width=\"224\">\n<p>9e échelon</p>\n</td>\n<td width=\"224\">\n<p align=\"center\">410</p>\n</td>\n<td width=\"224\">\n<p align=\"center\">3 ans</p>\n</td>\n</tr>\n<tr>\n<td width=\"224\">\n<p>8e échelon</p>\n</td>\n<td width=\"224\">\n<p align=\"center\">381</p>\n</td>\n<td width=\"224\">\n<p align=\"center\">3 ans</p>\n</td>\n</tr>\n<tr>\n<td width=\"224\">\n<p>7e échelon</p>\n</td>\n<td width=\"224\">\n<p align=\"center\">363</p>\n</td>\n<td width=\"224\">\n<p align=\"center\">2 ans</p>\n</td>\n</tr>\n<tr>\n<td width=\"224\">\n<p>6e échelon</p>\n</td>\n<td width=\"224\">\n<p align=\"center\">349</p>\n</td>\n<td width=\"224\">\n<p align=\"center\">2 ans</p>\n</td>\n</tr>\n<tr>\n<td width=\"224\">\n<p>5e échelon</p>\n</td>\n<td width=\"224\">\n<p align=\"center\">340</p>\n</td>\n<td width=\"224\">\n<p align=\"center\">2 ans</p>\n</td>\n</tr>\n<tr>\n<td width=\"224\">\n<p>4e échelon</p>\n</td>\n<td width=\"224\">\n<p align=\"center\">321</p>\n</td>\n<td width=\"224\">\n<p align=\"center\">2 ans</p>\n</td>\n</tr>\n<tr>\n<td width=\"224\">\n<p>3e échelon</p>\n</td>\n<td width=\"224\">\n<p align=\"center\">298</p>\n</td>\n<td width=\"224\">\n<p align=\"center\">2 ans</p>\n</td>\n</tr>\n<tr>\n<td width=\"224\">\n<p>2e échelon</p>\n</td>\n<td width=\"224\">\n<p align=\"center\">281</p>\n</td>\n<td width=\"224\">\n<p align=\"center\">2 ans</p>\n</td>\n</tr>\n<tr>\n<td width=\"224\">\n<p>1er échelon</p>\n</td>\n<td width=\"224\">\n<p align=\"center\">260</p>\n</td>\n<td width=\"224\">\n<p align=\"center\">1 an</p>\n</td>\n</tr>\n</tbody>\n</table>"
  },

  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Sont également nommés membres du Conseil national des professions culturelles :<br/>\n<br/>   Deux représentants de l'Association des maires de France ;<br/>\n<br/>   Un représentant de l'Association nationale des élus régionaux ;<br/>\n<br/>   Un représentant de l'Association des présidents de conseils généraux ;<br/>\n<br/>   Un représentant de l'Association des départements de France ;<br/>\n<br/>   Un représentant du Syndicat national des agents artistiques et littéraires.<br/>"

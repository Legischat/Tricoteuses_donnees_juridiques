  "BLOC_TEXTUEL": {
    "CONTENU": "<br/>   Les catégories d'informations individuelles traitées concernent :<br/>\n<br/>   - le classement entre emploi, chômage et inactivité ;<br/>\n<br/>   - l'activité professionnelle ;<br/>\n<br/>   - la recherche d'un emploi ;<br/>\n<br/>   - la formation ;<br/>\n<br/>   - l'activité antérieure ;<br/>\n<br/>   - l'origine géographique et sociale ;<br/>\n<br/>   - la situation en mars de l'année précédente ;<br/>\n<br/>   - un calendrier d'activité.<br/>\n<br/>   Les noms et prénoms des personnes interrogées ne sont pas saisis.<br/>"
  }

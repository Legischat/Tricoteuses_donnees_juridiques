  "BLOC_TEXTUEL": {
    "CONTENU": "<p>L'échelonnement indiciaire applicable aux grades de technicien sanitaire principal et de technicien sanitaire en chef est fixé ainsi qu'il suit :</p>\n<table>\n<tbody>\n<tr>\n<td width=\"336\">\n<p align=\"center\">GRADES ET ECHELONS</p>\n</td>\n<td width=\"336\">\n<p align=\"center\">INDICES BRUTS</p>\n</td>\n</tr>\n<tr>\n<td width=\"336\">\n<p align=\"center\">Technicien en chef</p>\n</td>\n<td valign=\"top\" width=\"336\"/>\n</tr>\n<tr>\n<td width=\"336\">\n<p>7e échelon</p>\n</td>\n<td width=\"336\">\n<p align=\"center\">579</p>\n</td>\n</tr>\n<tr>\n<td width=\"336\">\n<p>6e échelon</p>\n</td>\n<td width=\"336\">\n<p align=\"center\">547</p>\n</td>\n</tr>\n<tr>\n<td width=\"336\">\n<p>5e échelon</p>\n</td>\n<td width=\"336\">\n<p align=\"center\">510</p>\n</td>\n</tr>\n<tr>\n<td width=\"336\">\n<p>4e échelon</p>\n</td>\n<td width=\"336\">\n<p align=\"center\">474</p>\n</td>\n</tr>\n<tr>\n<td width=\"336\">\n<p>3e échelon</p>\n</td>\n<td width=\"336\">\n<p align=\"center\">438</p>\n</td>\n</tr>\n<tr>\n<td width=\"336\">\n<p>2e échelon</p>\n</td>\n<td width=\"336\">\n<p align=\"center\">392</p>\n</td>\n</tr>\n<tr>\n<td width=\"336\">\n<p>1er échelon</p>\n</td>\n<td width=\"336\">\n<p align=\"center\">359</p>\n</td>\n</tr>\n<tr>\n<td width=\"336\">\n<p align=\"center\">Technicien principal</p>\n</td>\n<td width=\"336\">\n<p align=\"center\"> </p>\n</td>\n</tr>\n<tr>\n<td width=\"336\">\n<p>7e échelon</p>\n</td>\n<td width=\"336\">\n<p align=\"center\">533</p>\n</td>\n</tr>\n<tr>\n<td width=\"336\">\n<p>6e échelon</p>\n</td>\n<td width=\"336\">\n<p align=\"center\">501</p>\n</td>\n</tr>\n<tr>\n<td width=\"336\">\n<p>5e échelon</p>\n</td>\n<td width=\"336\">\n<p align=\"center\">473</p>\n</td>\n</tr>\n<tr>\n<td width=\"336\">\n<p>4e échelon</p>\n</td>\n<td width=\"336\">\n<p align=\"center\">438</p>\n</td>\n</tr>\n<tr>\n<td width=\"336\">\n<p>3e échelon</p>\n</td>\n<td width=\"336\">\n<p align=\"center\">397</p>\n</td>\n</tr>\n<tr>\n<td width=\"336\">\n<p>2e échelon</p>\n</td>\n<td width=\"336\">\n<p align=\"center\">363</p>\n</td>\n</tr>\n<tr>\n<td width=\"336\">\n<p>1er échelon</p>\n</td>\n<td width=\"336\">\n<p align=\"center\">324</p>\n</td>\n</tr>\n</tbody>\n</table>"
  }

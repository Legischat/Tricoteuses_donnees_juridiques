      "TITRE_TXT": [
        {
          "#text": "Arrêté du 21 juillet 1993 ordonnant l'opposition de mises en garde sur l'emballage et la notice d'emploi des jeux vidéo ainsi que dans les établissements mettant des jeux vidéo à la disposition du public",
          "@c_titre_court": "Arrêté du 21 juillet 1993",
          "@debut": "2999-01-01",
          "@fin": "2999-01-01",
          "@id_txt": "JORFTEXT000000712902"
        },
        {
          "#text": "Arrêté du 21 juillet 1993 ordonnant l'apposition de mises en garde sur l'emballage et la notice d'emploi des jeux vidéo ainsi que dans les établissements mettant des jeux vidéo à la disposition du public",
          "@c_titre_court": "Arrêté du 21 juillet 1993",
